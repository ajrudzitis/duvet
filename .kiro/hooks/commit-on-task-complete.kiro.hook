{
  "enabled": true,
  "name": "Commit on Task Complete",
  "description": "Automatically commits changes when a task is complete with format: [Kiro] Task $X: $TASK_DESCRIPTION",
  "version": "1",
  "when": {
    "type": "agentStop"
  },
  "then": {
    "type": "runCommand",
    "command": "git add -A && git commit -m \"[Kiro] Task completed: $KIRO_PROMPT\""
  }
}