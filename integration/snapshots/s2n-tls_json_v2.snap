            "             sect409k1   |               |   NIST K-409",
            "             sect409r1   |               |   NIST B-409",
            "             sect571k1   |               |   NIST K-571",
            "             sect571r1   |               |   NIST B-571",
            "             secp160k1   |               |",
            "             secp160r1   |               |",
            "             secp160r2   |               |",
            "             secp192k1   |               |",
