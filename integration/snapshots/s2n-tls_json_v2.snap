          ],
          "title": "Normative References"
        },
        {
          "id": "section-10.2",
          "lines": [
            "   [FIPS.180-4]",
            "              National Institute of Standards and Technology, \"Secure",
            "              Hash Standard (SHS)\", FIPS PUB 180-4, DOI",
            "              10.6028/NIST.FIPS.180-4, August 2015,",
            "              <http://nvlpubs.nist.gov/nistpubs/FIPS/",
            "              NIST.FIPS.180-4.pdf>.",
            "",
