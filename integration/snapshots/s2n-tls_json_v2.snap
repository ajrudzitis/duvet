                ],
                "status_id": 5,
                "text": "private key (32 octets):  49 af 42 ba 7f 79 94 85 2d 71 3e f2 78"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "         "
              },
