    },
    {
      "id": "4789311bbfd3d277",
      "level": "Auto",
      "line": 304,
      "quote": "|                        | +> WAIT_FLIGHT2 <--------+ | +--------+--------+ No auth |                 | Client auth |                 | |                 v |             WAIT_CERT |        Recv |       | Recv Certificate |       empty |       v | Certificate |    WAIT_CV |             |       | Recv |             v       | CertificateVerify +-> WAIT_FINISHED <---+ | Recv Finished | K_recv = application",
      "source": "tls/s2n_tls13_key_schedule.c",
      "target_path": "https://www.rfc-editor.org/rfc/rfc8446",
      "target_section": "appendix-A.2",
