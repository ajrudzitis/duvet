        {
          "id": "name-table-of-contents",
          "lines": [
            "   1.  Introduction  . . . . . . . . . . . . . . . . . . . . . . . .   2",
            "   2.  Private Keys  . . . . . . . . . . . . . . . . . . . . . . . .   2",
            "   3.  Simple 1-RTT Handshake  . . . . . . . . . . . . . . . . . . .   3",
            "   4.  Resumed 0-RTT Handshake . . . . . . . . . . . . . . . . . . .  16",
            "   5.  HelloRetryRequest . . . . . . . . . . . . . . . . . . . . . .  29",
            "   6.  Client Authentication . . . . . . . . . . . . . . . . . . . .  43",
            "   7.  Compatibility Mode  . . . . . . . . . . . . . . . . . . . . .  55",
