    },
    {
      "id": "af9a168739b5e872",
      "level": "Auto",
      "line": 196,
      "quote": "Boolean MUST be serialized as: - `0x00` if the value is `false` - `0x01` if the value is `true`",
      "source": "DynamoDbEncryption/dafny/DynamoDbEncryption/src/DynamoToStruct.dfy",
      "target_path": "specification/dynamodb-encryption-client/ddb-attribute-serialization.md",
      "target_section": "boolean",
      "type": "IMPLICATION"
    },
    {
      "id": "c3c61ded403005e1",
      "level": "Auto",
      "line": 210,
      "quote": "Binary MUST be serialized with the identity function; or more plainly, Binary Attribute Values are used as is.",
      "source": "DynamoDbEncryption/dafny/DynamoDbEncryption/src/DynamoToStruct.dfy",
      "target_path": "specification/dynamodb-encryption-client/ddb-attribute-serialization.md",
      "target_section": "binary",
      "type": "IMPLICATION"
    },
    {
      "id": "aef3bde1c6546ea8",
      "level": "Auto",
      "line": 222,
      "quote": "Null MUST be serialized as a zero-length byte string.",
      "source": "DynamoDbEncryption/dafny/DynamoDbEncryption/src/DynamoToStruct.dfy",
      "target_path": "specification/dynamodb-encryption-client/ddb-attribute-serialization.md",
