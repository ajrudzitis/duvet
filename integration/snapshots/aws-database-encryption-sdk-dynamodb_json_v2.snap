      "target_path": "specification/structured-encryption/decrypt-path-structure.md",
      "target_section": "construct-decrypted-structured-data",
      "type": "SPEC"
    },
    {
      "comment": "If the version stored in the header is 1,\nthen the input cmm and encryption context MUST be used unchanged.\n",
      "id": "ecca1c1f86878940",
      "level": "Must",
      "line": 22,
      "quote": "If the version stored in the header is 1, then the input cmm and encryption context MUST be used unchanged.",
