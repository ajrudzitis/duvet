      "type": "IMPLICATION"
    },
    {
      "id": "b8f3e365fea1d8b1",
      "level": "Auto",
      "line": 155,
      "quote": "The DynamoDB Item Encryptor MUST provide a function that adheres to [EncryptItem](./encrypt-item.md).",
      "source": "DynamoDbEncryption/dafny/DynamoDbItemEncryptor/Model/DynamoDbItemEncryptor.smithy",
      "target_path": "specification/dynamodb-encryption-client/ddb-item-encryptor.md",
      "target_section": "encryptitem",
      "type": "IMPLICATION"
    },
    {
      "id": "069ab4f1b6a727b9",
      "level": "Auto",
      "line": 164,
      "quote": "The DynamoDB Item Encryptor MUST provide a function that adheres to [DecryptItem](./decrypt-item.md).",
      "source": "DynamoDbEncryption/dafny/DynamoDbItemEncryptor/Model/DynamoDbItemEncryptor.smithy",
      "target_path": "specification/dynamodb-encryption-client/ddb-item-encryptor.md",
