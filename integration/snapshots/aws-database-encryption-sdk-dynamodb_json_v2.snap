      "target_section": "position-definition",
      "type": "SPEC"
    },
    {
      "comment": "If the position provided is negative, it's absolute value MUST be the\none-based index from the end of the list, that is, -1 refers to the last item in the list.\n",
      "id": "072fb97641bbfea4",
      "level": "Must",
