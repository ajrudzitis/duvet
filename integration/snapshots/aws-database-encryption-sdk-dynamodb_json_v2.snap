    },
    {
      "comment": "The canonical path MUST start with the UTF8 encoded table name.\n",
      "id": "b05f16fa495e018e",
      "level": "Must",
      "line": 21,
      "quote": "The canonical path MUST start with the UTF8 encoded table name.",
      "source": "compliance/specification/structured-encryption/header/canonical-path.toml",
      "target_path": "specification/structured-encryption/header.md",
      "target_section": "canonical-path",
      "type": "SPEC"
    },
    {
      "comment": "This MUST be followed by the depth of the Terminal within Structured Data.\n",
      "id": "c7e3dfe5940e0a5c",
      "level": "Must",
      "line": 27,
      "quote": "This MUST be followed by the depth of the Terminal within Structured Data.",
      "source": "compliance/specification/structured-encryption/header/canonical-path.toml",
      "target_path": "specification/structured-encryption/header.md",
      "target_section": "canonical-path",
      "type": "SPEC"
    },
    {
      "comment": "This MUST be followed by the encoding for each Structured Data in the path, including the Terminal itself.\n",
      "id": "42eb9be63a8a01a5",
      "level": "Must",
      "line": 33,
      "quote": "This MUST be followed by the encoding for each Structured Data in the path, including the Terminal itself.",
