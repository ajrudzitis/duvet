            "6206df8f7262da5d",
            "6206df8f7262da5d",
            "6206df8f7262da5d",
            "6206df8f7262da5d",
            "8123f821aa898cde",
            "b057ed326dd20f67",
            "b057ed326dd20f67",
            "b057ed326dd20f67",
            "78067de762451676",
            "78067de762451676",
            "78067de762451676",
            "78067de762451676"
          ],
          "title": "Encrypt before TransactWriteItems"
        },
        {
          "id": "decrypt-after-getitem",
          "lines": [
            [
              {
                "annotation_ids": [
                  "1aaf945dd2b65d2d",
                  "585283d9047d6578"
                ],
                "status_id": 1,
                "text": "After a [GetItem](https://docs.aws.amazon.com/amazondynamodb/latest/APIReference/API_GetItem.html)"
              }
            ],
            [
              {
                "annotation_ids": [
                  "1aaf945dd2b65d2d",
                  "585283d9047d6578"
                ],
                "status_id": 1,
                "text": "call is made to DynamoDB,"
              }
            ],
            [
              {
                "annotation_ids": [
                  "1aaf945dd2b65d2d",
                  "585283d9047d6578"
                ],
                "status_id": 1,
                "text": "the resulting response MUST be modified before"
              }
            ],
            [
              {
                "annotation_ids": [
                  "1aaf945dd2b65d2d",
                  "585283d9047d6578"
                ],
                "status_id": 1,
                "text": "being returned to the caller if there exists"
              }
            ],
            [
              {
                "annotation_ids": [
                  "1aaf945dd2b65d2d",
                  "585283d9047d6578"
                ],
                "status_id": 1,
                "text": "an Item Encryptor specified within the [DynamoDB Encryption Client Config](#dynamodb-encryption-client-configuration)"
              }
            ],
            [
              {
                "annotation_ids": [
                  "1aaf945dd2b65d2d",
                  "585283d9047d6578"
                ],
                "status_id": 1,
                "text": "with a [DynamoDB Table Name](./ddb-item-encryptor.md#dynamodb-table-name)"
              }
            ],
            [
              {
                "annotation_ids": [
                  "1aaf945dd2b65d2d",
                  "585283d9047d6578"
                ],
                "status_id": 1,
                "text": "equal to the `TableName` on the GetItem request."
              }
            ],
            "",
            [
              {
                "annotation_ids": [
                  "5fffcb638da9b5fc",
                  "bd1de3830f690dcb"
                ],
                "status_id": 1,
                "text": "The [Item Encryptor](./ddb-item-encryptor.md) MUST perform"
              }
            ],
            [
              {
                "annotation_ids": [
                  "5fffcb638da9b5fc",
                  "bd1de3830f690dcb"
                ],
                "status_id": 1,
                "text": "[Decrypt Item](./decrypt-item.md) where the input"
              }
            ],
            [
              {
                "annotation_ids": [
                  "5fffcb638da9b5fc",
                  "bd1de3830f690dcb"
                ],
                "status_id": 1,
                "text": "[DynamoDB Item](./decrypt-item.md#dynamodb-item)"
              }
            ],
            [
              {
                "annotation_ids": [
                  "5fffcb638da9b5fc",
                  "bd1de3830f690dcb"
                ],
                "status_id": 1,
                "text": "is the `Item` field in the original response"
              }
            ],
            "",
            [
              {
                "annotation_ids": [
                  "36165872812c0207",
                  "9ba191caa9c91c4b"
                ],
                "status_id": 1,
                "text": "Beacons MUST be [removed](ddb-support.md#removebeacons) from the result."
              }
            ],
            "",
            [
              {
                "annotation_ids": [
                  "f78119b66d8b1c15",
                  "c49dd02df0e9bdaa"
                ],
                "status_id": 1,
                "text": "The GetItem response's `Item` field MUST be"
              }
            ],
            [
              {
                "annotation_ids": [
                  "f78119b66d8b1c15",
                  "c49dd02df0e9bdaa"
                ],
                "status_id": 1,
                "text": "replaced by the encrypted DynamoDb Item outputted above."
              }
            ]
          ],
          "requirements": [
            "585283d9047d6578",
            "585283d9047d6578",
            "585283d9047d6578",
            "585283d9047d6578",
            "585283d9047d6578",
