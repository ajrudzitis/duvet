      "id": "bd1de3830f690dcb",
      "level": "Must",
      "line": 35,
      "quote": "The [Item Encryptor](./ddb-item-encryptor.md) MUST perform [Decrypt Item](./decrypt-item.md) where the input [DynamoDB Item](./decrypt-item.md#dynamodb-item) is the `Item` field in the original response",
      "source": "compliance/specification/dynamodb-encryption-client/ddb-sdk-integration/decrypt-after-getitem.toml",
