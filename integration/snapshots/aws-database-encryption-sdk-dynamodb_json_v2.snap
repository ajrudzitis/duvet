            ],
            "",
            [
              {
                "annotation_ids": [
                  "be7885ff4990fce0"
                ],
                "status_id": 2,
                "text": "| Attribute Value Data Type | Terminal Type ID |"
              }
            ],
            [
              {
                "annotation_ids": [
                  "be7885ff4990fce0"
                ],
                "status_id": 2,
                "text": "| ------------------------- | ---------------- |"
              }
            ],
            [
              {
                "annotation_ids": [
                  "be7885ff4990fce0"
                ],
                "status_id": 2,
                "text": "| Null (NULL)               | 0x0000           |"
              }
            ],
            [
              {
                "annotation_ids": [
                  "be7885ff4990fce0"
                ],
                "status_id": 2,
                "text": "| String (S)                | 0x0001           |"
              }
            ],
            [
              {
                "annotation_ids": [
                  "be7885ff4990fce0"
                ],
                "status_id": 2,
                "text": "| Number (N)                | 0x0002           |"
              }
            ],
            [
              {
                "annotation_ids": [
                  "be7885ff4990fce0"
                ],
                "status_id": 2,
                "text": "| Binary (B)                | 0xFFFF           |"
              }
            ],
            [
              {
                "annotation_ids": [
                  "be7885ff4990fce0"
                ],
                "status_id": 2,
                "text": "| Boolean (BOOL)            | 0x0004           |"
              }
            ],
            [
              {
                "annotation_ids": [
                  "be7885ff4990fce0"
                ],
                "status_id": 2,
                "text": "| String Set (SS)           | 0x0101           |"
              }
            ],
            [
              {
                "annotation_ids": [
                  "be7885ff4990fce0"
                ],
                "status_id": 2,
                "text": "| Number Set (NS)           | 0x0102           |"
              }
            ],
            [
              {
                "annotation_ids": [
                  "be7885ff4990fce0"
                ],
                "status_id": 2,
                "text": "| Binary Set (BS)           | 0x01FF           |"
              }
            ],
            [
              {
                "annotation_ids": [
                  "be7885ff4990fce0"
                ],
                "status_id": 2,
                "text": "| Map (M)                   | 0x0200           |"
              }
            ],
            [
              {
                "annotation_ids": [
                  "be7885ff4990fce0"
                ],
                "status_id": 2,
                "text": "| List (L)                  | 0x0300           |"
              }
            ]
          ],
          "requirements": [
            "d58b23d7dd2dde7c",
            "d58b23d7dd2dde7c"
          ],
          "title": "Type ID"
        },
        {
          "id": "value",
          "lines": [
            "Value is the actual serialization of the data held in the DynamoDB Attribute Value.",
            "The sub-headers in this section specify how each type is serialized."
          ],
          "title": "Value"
        },
        {
          "id": "null",
          "lines": [
            [
              {
                "annotation_ids": [
                  "aef3bde1c6546ea8",
                  "3ad037a329f45401"
                ],
                "status_id": 1,
                "text": "Null MUST be serialized as a zero-length byte string."
              }
            ]
          ],
          "requirements": [
            "3ad037a329f45401"
          ],
          "title": "Null"
        },
        {
          "id": "string",
          "lines": [
            [
              {
                "annotation_ids": [
                  "2af4447bd52862b2",
                  "ca1d9cc24957ad21"
                ],
                "status_id": 1,
                "text": "String MUST be serialized as UTF-8 encoded bytes."
              }
            ]
          ],
          "requirements": [
            "ca1d9cc24957ad21"
          ],
          "title": "String"
        },
        {
          "id": "number",
          "lines": [
            "Note that DynamoDB Number Attribute Values are strings.",
            "",
            [
              {
                "annotation_ids": [
                  "7c2a802831b295e3",
                  "bf27f5bd922ca899"
                ],
                "status_id": 1,
                "text": "This value MUST be normalized in the same way as DynamoDB normalizes numbers."
              }
            ],
            [
              {
                "annotation_ids": [
                  "a286aeb228c9736f",
                  "b54014c5f751dfb3"
                ],
                "status_id": 1,
                "text": "This normalized value MUST then be serialized as UTF-8 encoded bytes."
              }
            ]
          ],
          "requirements": [
            "bf27f5bd922ca899",
            "b54014c5f751dfb3"
          ],
          "title": "Number"
        },
        {
          "id": "binary",
          "lines": [
            [
              {
                "annotation_ids": [
                  "c3c61ded403005e1",
                  "f300d28acabac390"
                ],
                "status_id": 1,
                "text": "Binary MUST be serialized with the identity function;"
              }
            ],
            [
              {
                "annotation_ids": [
                  "c3c61ded403005e1",
                  "f300d28acabac390"
                ],
                "status_id": 1,
                "text": "or more plainly, Binary Attribute Values are used as is."
              }
            ]
          ],
          "requirements": [
            "f300d28acabac390",
            "f300d28acabac390"
          ],
          "title": "Binary"
        },
        {
          "id": "boolean",
          "lines": [
            [
              {
                "annotation_ids": [
                  "af9a168739b5e872",
                  "d42589fa386d965a"
                ],
                "status_id": 1,
                "text": "Boolean MUST be serialized as:"
              }
            ],
            "",
            [
              {
                "annotation_ids": [
                  "af9a168739b5e872"
                ],
                "status_id": 2,
                "text": "- `0x00` if the value is `false`"
              }
            ],
            [
              {
                "annotation_ids": [
                  "af9a168739b5e872"
                ],
                "status_id": 2,
                "text": "- `0x01` if the value is `true`"
              }
            ]
          ],
          "requirements": [
            "d42589fa386d965a"
          ],
          "title": "Boolean"
        },
        {
          "id": "set",
          "lines": [
            "A Set is a String Set, Number Set, or Binary Set.",
            "",
            [
              {
                "annotation_ids": [
                  "2252c0d2c1a4f783",
                  "e24440b5e3abe156"
                ],
                "status_id": 1,
                "text": "A Set MUST be serialized as:"
              }
            ],
            "",
            [
              {
                "annotation_ids": [
                  "2252c0d2c1a4f783"
                ],
                "status_id": 2,
                "text": "| Field       | Length   |"
              }
            ],
            [
              {
                "annotation_ids": [
                  "2252c0d2c1a4f783"
                ],
                "status_id": 2,
                "text": "| ----------- | -------- |"
              }
            ],
            [
              {
                "annotation_ids": [
                  "2252c0d2c1a4f783"
                ],
                "status_id": 2,
                "text": "| Set Count   | 4        |"
              }
            ],
            [
              {
                "annotation_ids": [
                  "2252c0d2c1a4f783"
                ],
                "status_id": 2,
                "text": "| Set Entries | Variable |"
              }
            ]
          ],
          "requirements": [
            "e24440b5e3abe156"
          ],
          "title": "Set"
        },
        {
          "id": "set-count",
          "lines": [
            [
              {
                "annotation_ids": [
                  "7536ff057d5fb5fc",
                  "0ad0e18a134899ba"
                ],
                "status_id": 1,
                "text": "Set Count MUST be a big-endian unsigned integer"
              }
            ],
            [
              {
                "annotation_ids": [
                  "7536ff057d5fb5fc",
                  "0ad0e18a134899ba"
                ],
                "status_id": 1,
                "text": "equal to the number of serialized entries in"
              }
            ],
            [
              {
                "annotation_ids": [
                  "7536ff057d5fb5fc",
                  "0ad0e18a134899ba"
                ],
                "status_id": 1,
                "text": "[Set Entries](#set-entries)."
              }
            ],
            "",
            [
              {
                "annotation_ids": [
                  "49128136b3ed13fa",
                  "18ef3b0e2a98128b"
                ],
                "status_id": 3,
                "text": "Set Count MAY be `0`,"
              }
            ],
            [
              {
                "annotation_ids": [
                  "49128136b3ed13fa",
                  "18ef3b0e2a98128b"
                ],
                "status_id": 3,
                "text": "in which case [Set Entries](#set-entries) is a zero-length byte string."
              }
            ]
          ],
          "requirements": [
            "0ad0e18a134899ba",
            "0ad0e18a134899ba",
            "0ad0e18a134899ba",
            "18ef3b0e2a98128b",
            "18ef3b0e2a98128b"
          ],
          "title": "Set Count"
        },
        {
          "id": "set-entries",
          "lines": [
            "Set Entries is a sequence of serialized entries.",
            [
              {
                "annotation_ids": [
                  "d4f78d4b58387aaf",
                  "e609874590da73c7"
                ],
                "status_id": 1,
                "text": "Each of these entries MUST be serialized as:"
              }
            ],
            "",
            [
              {
                "annotation_ids": [
                  "d4f78d4b58387aaf"
                ],
                "status_id": 2,
                "text": "| Field            | Length                               |"
              }
            ],
            [
              {
                "annotation_ids": [
                  "d4f78d4b58387aaf"
                ],
                "status_id": 2,
                "text": "| ---------------- | ------------------------------------ |"
              }
            ],
            [
              {
                "annotation_ids": [
                  "d4f78d4b58387aaf"
                ],
                "status_id": 2,
                "text": "| Set Entry Length | 4                                    |"
              }
            ],
            [
              {
                "annotation_ids": [
                  "d4f78d4b58387aaf"
                ],
                "status_id": 2,
                "text": "| Set Entry Value  | Variable. Equal to Set Entry Length. |"
              }
            ],
            "",
            "All [Set Entry Values](#set-entry-value) are the same type.",
            "",
            [
              {
                "annotation_ids": [
                  "865cb0dc5d8f07c4",
                  "2b13178737660a3a"
                ],
                "status_id": 1,
                "text": "Binary Sets MUST NOT contain duplicate entries."
              }
            ],
            [
              {
                "annotation_ids": [
                  "fa93d8c0f07bd352",
                  "63e4857f68fc307f",
                  "3c94b238eabb3001"
                ],
                "status_id": 4,
                "text": "Entries in a Binary Set MUST be ordered lexicographically by their underlying bytes in ascending order."
              }
            ],
            "",
            [
              {
                "annotation_ids": [
                  "718598c021ad5384",
                  "2ff8136ce1d50adb"
                ],
                "status_id": 1,
                "text": "Number Sets MUST NOT contain duplicate entries."
              }
            ],
            [
              {
                "annotation_ids": [
                  "77a3180d1debb8f2",
                  "4c13b0bf438fa95a",
                  "ec85af8fc1162d9a"
                ],
                "status_id": 4,
                "text": "Entries in a Number Set MUST be ordered in ascending [UTF-16 binary order](./string-ordering.md#utf-16-binary-order)."
              }
            ],
            [
              {
                "annotation_ids": [
                  "b69a9d1f22d81eab",
                  "64843780cb8018c7",
                  "ae875b2e372a6fe0"
                ],
                "status_id": 4,
                "text": "This ordering MUST be applied after normalization of the number value."
              }
            ],
            "Note that because normalized number characters are all in the ASCII range (U+0000 to U+007F),",
            "this ordering is equivalent to the [code point ordering](./string-ordering.md#code-point-order).",
            "",
            [
              {
                "annotation_ids": [
                  "d10a83bed39a74de",
                  "75c4d150c92a8787"
                ],
                "status_id": 1,
                "text": "String Sets MUST NOT contain duplicate entries."
              }
            ],
            [
              {
                "annotation_ids": [
                  "f318eabc089355f3",
                  "d9521100ae0d14f1",
                  "d7d105ee243f6eb2"
                ],
                "status_id": 4,
                "text": "Entries in a String Set MUST be ordered in ascending [UTF-16 binary order](./string-ordering.md#utf-16-binary-order)."
              }
            ],
            "Note that though the entries are sorted by UTF016 binary order,",
            "the values are serialized in the set with UTF-8 encoding."
          ],
          "requirements": [
            "e609874590da73c7",
            "2b13178737660a3a",
            "3c94b238eabb3001",
            "2ff8136ce1d50adb",
            "ec85af8fc1162d9a",
            "ae875b2e372a6fe0",
            "75c4d150c92a8787",
            "d7d105ee243f6eb2"
          ],
          "title": "Set Entries"
        },
        {
          "id": "set-entry-length",
          "lines": [
            [
              {
                "annotation_ids": [
                  "e71dcdd5e9aad58c",
                  "9cf067dc4fc0d1ef"
                ],
                "status_id": 1,
                "text": "Set Entry Length MUST be a big-endian unsigned integer"
              }
            ],
            [
              {
                "annotation_ids": [
                  "e71dcdd5e9aad58c",
                  "9cf067dc4fc0d1ef"
                ],
                "status_id": 1,
                "text": "equal to the length of [Set Entry Value](#set-entry-value)."
              }
            ]
          ],
          "requirements": [
            "9cf067dc4fc0d1ef",
            "9cf067dc4fc0d1ef"
          ],
          "title": "Set Entry Length"
        },
        {
          "id": "set-entry-value",
          "lines": [
            "In DynamoDB, Set Entry Value can only be a [Value](#value) of the following types:",
            "",
            "- [String](#string)",
            "- [Number](#number)",
            "- [Binary](#binary)"
          ],
          "title": "Set Entry Value"
        },
        {
          "id": "map-attribute",
          "lines": [
            [
              {
                "annotation_ids": [
                  "8e72a0226d20714f",
                  "ddac6353eda79b9b"
                ],
                "status_id": 1,
                "text": "Map MUST be serialized as:"
              }
            ],
            "",
            [
              {
                "annotation_ids": [
                  "8e72a0226d20714f"
                ],
                "status_id": 2,
                "text": "| Field                  | Length   |"
              }
            ],
            [
              {
                "annotation_ids": [
                  "8e72a0226d20714f"
                ],
                "status_id": 2,
                "text": "| ---------------------- | -------- |"
              }
            ],
            [
              {
                "annotation_ids": [
                  "8e72a0226d20714f"
                ],
                "status_id": 2,
                "text": "| Key Value Pair Count   | 4        |"
              }
            ],
            [
              {
                "annotation_ids": [
                  "8e72a0226d20714f"
                ],
                "status_id": 2,
                "text": "| Key Value Pair Entries | Variable |"
              }
            ]
          ],
          "requirements": [
            "ddac6353eda79b9b"
          ],
          "title": "Map Attribute"
        },
        {
          "id": "key-value-pair-count",
          "lines": [
            [
              {
                "annotation_ids": [
                  "066865a5a63dedb9",
                  "8e5dc6ebc6bafcea"
                ],
                "status_id": 1,
                "text": "Key Value Pair Count MUST be a big-endian unsigned integer"
              }
            ],
            [
              {
                "annotation_ids": [
                  "066865a5a63dedb9",
                  "8e5dc6ebc6bafcea"
                ],
                "status_id": 1,
                "text": "equal to the number of serialized key-value pairs in"
              }
            ],
            [
              {
                "annotation_ids": [
                  "066865a5a63dedb9",
                  "8e5dc6ebc6bafcea"
                ],
                "status_id": 1,
                "text": "[Key Value Pair Entries](#key-value-pair-entries)."
              }
            ],
            "",
            [
              {
                "annotation_ids": [
                  "6d845f553b4b0150",
                  "310d59b30bbb55fb"
                ],
                "status_id": 3,
                "text": "Key Value Pair Count MAY be `0`,"
              }
            ],
            [
              {
                "annotation_ids": [
                  "6d845f553b4b0150",
                  "310d59b30bbb55fb"
                ],
                "status_id": 3,
                "text": "in which case [Key Value Pair Entries](#key-value-pair-entries) is an empty bytestring."
              }
            ]
          ],
          "requirements": [
            "8e5dc6ebc6bafcea",
            "8e5dc6ebc6bafcea",
            "8e5dc6ebc6bafcea",
            "310d59b30bbb55fb",
            "310d59b30bbb55fb"
          ],
          "title": "Key Value Pair Count"
        },
        {
          "id": "key-value-pair-entries",
          "lines": [
            "Key Value Pair Entries are a sequence of",
            "key-value pair serializations.",
            [
              {
                "annotation_ids": [
                  "2ab9639a41e3adf4",
                  "0596a61e83a1b342",
                  "3e70feab7713bf73"
                ],
                "status_id": 4,
                "text": "Each key-value pair MUST be serialized as:"
              }
            ],
            "",
            [
              {
                "annotation_ids": [
                  "2ab9639a41e3adf4",
                  "0596a61e83a1b342"
                ],
                "status_id": 5,
                "text": "| Field        | Length   |"
              }
            ],
            [
              {
                "annotation_ids": [
                  "2ab9639a41e3adf4",
                  "0596a61e83a1b342"
                ],
                "status_id": 5,
                "text": "| ------------ | -------- |"
              }
            ],
            [
              {
                "annotation_ids": [
                  "2ab9639a41e3adf4",
                  "0596a61e83a1b342"
                ],
                "status_id": 5,
                "text": "| Key Type     | 2        |"
              }
            ],
            [
              {
                "annotation_ids": [
                  "2ab9639a41e3adf4",
                  "0596a61e83a1b342"
                ],
                "status_id": 5,
                "text": "| Key Length   | 4        |"
              }
            ],
            [
              {
                "annotation_ids": [
                  "2ab9639a41e3adf4",
                  "0596a61e83a1b342"
                ],
                "status_id": 5,
                "text": "| Map Key      | Variable |"
              }
            ],
            [
              {
                "annotation_ids": [
                  "2ab9639a41e3adf4",
                  "0596a61e83a1b342"
                ],
                "status_id": 5,
                "text": "| Value Type   | 2        |"
              }
            ],
            [
              {
                "annotation_ids": [
                  "2ab9639a41e3adf4",
                  "0596a61e83a1b342"
                ],
                "status_id": 5,
                "text": "| Value Length | 4        |"
              }
            ],
            [
              {
                "annotation_ids": [
                  "2ab9639a41e3adf4",
                  "0596a61e83a1b342"
                ],
                "status_id": 5,
                "text": "| Map Value    | Variable |"
              }
            ],
            "",
            [
              {
                "annotation_ids": [
                  "c78b3a4521be9c2f",
                  "394c8774e3ce9fc8",
                  "34f1dcbc2c413ae6"
                ],
                "status_id": 4,
                "text": "This sequence MUST NOT contain duplicate [Map Keys](#map-key)."
              }
            ],
            "",
            [
              {
                "annotation_ids": [
                  "ccfacbc5f48b1fdf",
                  "943da02f8f3cf532",
                  "54dd4ea2b1b1f938"
                ],
                "status_id": 4,
                "text": "Entries in a serialized Map MUST be ordered by key value,"
              }
            ],
            [
              {
                "annotation_ids": [
                  "ccfacbc5f48b1fdf",
                  "943da02f8f3cf532",
                  "54dd4ea2b1b1f938"
                ],
                "status_id": 4,
                "text": "ordered in ascending [UTF-16 binary order](./string-ordering.md#utf-16-binary-order)."
              }
            ],
            "Note that even though the values are sorted according to UTF-16 binary order,",
            "string values are actually encoded within the map as UTF-8."
          ],
          "requirements": [
            "3e70feab7713bf73",
            "34f1dcbc2c413ae6",
            "54dd4ea2b1b1f938",
            "54dd4ea2b1b1f938"
          ],
          "title": "Key Value Pair Entries"
        },
        {
          "id": "key-type",
          "lines": [
            [
              {
                "annotation_ids": [
                  "abd3f552b0c50da9",
                  "81d698722b5f7a5c"
                ],
                "status_id": 1,
                "text": "Key Type MUST be the [Type ID](#type-id) for Strings."
              }
            ]
          ],
          "requirements": [
            "81d698722b5f7a5c"
          ],
          "title": "Key Type"
        },
        {
          "id": "key-length",
          "lines": [
            [
              {
                "annotation_ids": [
                  "2bcd4d873a76295e",
                  "b96326fa54f10d15"
                ],
                "status_id": 1,
                "text": "Key Length MUST be a non-zero big-endian unsigned integer"
              }
            ],
            [
              {
                "annotation_ids": [
                  "2bcd4d873a76295e",
                  "b96326fa54f10d15"
                ],
                "status_id": 1,
                "text": "equal to the length of [Map Key](#map-key)."
              }
            ]
          ],
          "requirements": [
            "b96326fa54f10d15",
            "b96326fa54f10d15"
          ],
          "title": "Key Length"
        },
        {
          "id": "map-key",
          "lines": [
            [
              {
                "annotation_ids": [
                  "a6f8ea89cef92d3d",
                  "6688588f2bc27448"
                ],
                "status_id": 1,
                "text": "Map Key MUST be a [String Value](#string)."
              }
            ]
          ],
          "requirements": [
            "6688588f2bc27448"
          ],
          "title": "Map Key"
        },
        {
          "id": "value-type",
          "lines": [
            [
              {
                "annotation_ids": [
                  "f645b8c2d402ae5c",
                  "bd92e04ee9803ef9",
                  "6786c326ab46dc02"
                ],
                "status_id": 4,
                "text": "Value Type MUST be the [Type ID](#type-id) of the type of [Map Value](#map-value)."
              }
            ]
          ],
          "requirements": [
            "6786c326ab46dc02"
          ],
          "title": "Value Type"
        },
        {
          "id": "value-length",
          "lines": [
            [
              {
                "annotation_ids": [
                  "ce0bc7bc07bf50da",
                  "09d39438b1a0127f",
                  "843d0292923c0727"
                ],
                "status_id": 4,
                "text": "Value Length MUST be a big-endian unsigned integer"
              }
            ],
            [
              {
                "annotation_ids": [
                  "ce0bc7bc07bf50da",
                  "09d39438b1a0127f",
                  "843d0292923c0727"
                ],
                "status_id": 4,
                "text": "equal to the length of [Map Value](#map-value)."
              }
            ]
          ],
          "requirements": [
            "843d0292923c0727",
            "843d0292923c0727"
          ],
          "title": "Value Length"
        },
        {
          "id": "map-value",
          "lines": [
            [
              {
                "annotation_ids": [
                  "01a7eb4f0200f976",
                  "339ccdaa02d1654e",
                  "8377e4adccd1e2d8"
                ],
                "status_id": 4,
                "text": "Map Value MUST be a [Value](#value)."
              }
            ],
            [
              {
                "annotation_ids": [
                  "d03a3e64611cba3f",
                  "70c29f465b3b56e5",
                  "f8bb5a51ab025ef7"
                ],
                "status_id": 6,
                "text": "A Map MAY hold any DynamoDB Attribute Value data type,"
              }
            ],
            [
              {
                "annotation_ids": [
                  "d03a3e64611cba3f",
                  "70c29f465b3b56e5",
                  "f8bb5a51ab025ef7"
                ],
                "status_id": 6,
                "text": "and MAY hold values of different types."
              }
            ]
          ],
          "requirements": [
            "8377e4adccd1e2d8",
            "f8bb5a51ab025ef7",
            "f8bb5a51ab025ef7"
          ],
          "title": "Map Value"
        },
        {
          "id": "list",
          "lines": [
            [
              {
                "annotation_ids": [
                  "4bb8d9ea93e2e5fe",
                  "8b280e5acc2201ea"
                ],
                "status_id": 1,
                "text": "List MUST be serialized as:"
              }
            ],
            "",
            [
              {
                "annotation_ids": [
                  "4bb8d9ea93e2e5fe"
                ],
                "status_id": 2,
                "text": "| Field        | Length   |"
              }
            ],
            [
              {
                "annotation_ids": [
                  "4bb8d9ea93e2e5fe"
                ],
                "status_id": 2,
                "text": "| ------------ | -------- |"
              }
            ],
            [
              {
                "annotation_ids": [
                  "4bb8d9ea93e2e5fe"
                ],
                "status_id": 2,
                "text": "| List Count   | 4        |"
              }
            ],
            [
              {
                "annotation_ids": [
                  "4bb8d9ea93e2e5fe"
                ],
                "status_id": 2,
                "text": "| List Entries | Variable |"
              }
            ]
          ],
          "requirements": [
            "8b280e5acc2201ea"
          ],
          "title": "List"
        },
        {
          "id": "list-count",
          "lines": [
            [
              {
                "annotation_ids": [
                  "a0ef8474b657398b",
                  "77a7beb8919d1a70"
                ],
                "status_id": 1,
                "text": "List Count MUST be a big-endian unsigned integer"
              }
            ],
            [
              {
                "annotation_ids": [
                  "a0ef8474b657398b",
                  "77a7beb8919d1a70"
                ],
                "status_id": 1,
                "text": "equal to the number of serialized list entries in"
              }
            ],
            [
              {
                "annotation_ids": [
                  "a0ef8474b657398b",
                  "77a7beb8919d1a70"
                ],
                "status_id": 1,
                "text": "[List Entries](#list-entries)."
              }
            ],
            "",
            [
              {
                "annotation_ids": [
                  "e7122ae736ba84f6",
                  "d834a1643e4db369"
                ],
                "status_id": 3,
                "text": "List Count MAY be `0`,"
              }
            ],
            [
              {
                "annotation_ids": [
                  "e7122ae736ba84f6",
                  "d834a1643e4db369"
                ],
                "status_id": 3,
                "text": "in which case [List Entries](#list-entries) is an empty byte string."
              }
            ]
          ],
          "requirements": [
            "77a7beb8919d1a70",
            "77a7beb8919d1a70",
            "77a7beb8919d1a70",
            "d834a1643e4db369",
            "d834a1643e4db369"
          ],
          "title": "List Count"
        },
        {
          "id": "list-entries",
          "lines": [
            "List Entries is a sequence of serialized list entries.",
            [
              {
                "annotation_ids": [
                  "304cca8c2a189435",
                  "9f8ad2413e8ccf7f",
                  "0d8a55384e5071b0"
                ],
                "status_id": 4,
                "text": "Each list entry in the sequence MUST be serialized as:"
              }
            ],
            "",
            [
              {
                "annotation_ids": [
                  "304cca8c2a189435",
                  "9f8ad2413e8ccf7f"
                ],
                "status_id": 5,
                "text": "| Field             | Length                     |"
              }
            ],
            [
              {
                "annotation_ids": [
                  "304cca8c2a189435",
                  "9f8ad2413e8ccf7f"
                ],
                "status_id": 5,
                "text": "| ----------------- | -------------------------- |"
              }
            ],
            [
              {
                "annotation_ids": [
                  "304cca8c2a189435",
                  "9f8ad2413e8ccf7f"
                ],
                "status_id": 5,
                "text": "| List Entry Type   | 2                          |"
              }
            ],
            [
              {
                "annotation_ids": [
                  "304cca8c2a189435",
                  "9f8ad2413e8ccf7f"
                ],
                "status_id": 5,
                "text": "| List Entry Length | 4                          |"
              }
            ],
            [
              {
                "annotation_ids": [
                  "304cca8c2a189435",
                  "9f8ad2413e8ccf7f"
                ],
                "status_id": 5,
                "text": "| List Entry Value  | Variable. Equal to Length. |"
              }
            ],
            "",
            [
              {
                "annotation_ids": [
                  "5eec22de4a018bfd",
                  "cb189e999215b9fb",
                  "2840b03dae7dff33"
                ],
                "status_id": 4,
                "text": "The order of these serialized list entries MUST match"
              }
            ],
            [
              {
                "annotation_ids": [
                  "5eec22de4a018bfd",
                  "cb189e999215b9fb",
                  "2840b03dae7dff33"
                ],
                "status_id": 4,
                "text": "the order of the entries in the original list."
              }
            ]
          ],
          "requirements": [
            "0d8a55384e5071b0",
            "2840b03dae7dff33",
            "2840b03dae7dff33"
          ],
          "title": "List Entries"
        },
        {
          "id": "list-entry-type",
          "lines": [
            [
              {
                "annotation_ids": [
                  "70708f4573570fac",
                  "12f56244c9839419",
                  "0e67e6a9ebc5c5bc"
                ],
                "status_id": 4,
                "text": "List Entry Type MUST be the [Type ID](#type-id) of the type of [List Entry Value](#list-entry-value)."
              }
            ]
          ],
          "requirements": [
            "0e67e6a9ebc5c5bc"
          ],
          "title": "List Entry Type"
        },
        {
          "id": "list-entry-length",
          "lines": [
            [
              {
                "annotation_ids": [
                  "b1fc6ac9d8d11b25",
                  "7415052566478ad2",
                  "9689250f171023f5"
                ],
                "status_id": 4,
                "text": "List Entry Length MUST be a big-endian unsigned integer"
              }
            ],
            [
              {
                "annotation_ids": [
                  "b1fc6ac9d8d11b25",
                  "7415052566478ad2",
                  "9689250f171023f5"
                ],
                "status_id": 4,
                "text": "equal to the length of [List Entry Value](#list-entry-value)."
              }
            ]
          ],
          "requirements": [
            "9689250f171023f5",
            "9689250f171023f5"
          ],
          "title": "List Entry Length"
        },
        {
          "id": "list-entry-value",
          "lines": [
            "List Entry Value is equivalent to [Value](#value).",
            [
              {
                "annotation_ids": [
                  "46e776fe6ca73899",
                  "318b2b3fc45d6c03",
                  "5c5c8b0c2e0e82d7"
                ],
                "status_id": 6,
                "text": "A List MAY hold any DynamoDB Attribute Value data type,"
              }
            ],
            [
              {
                "annotation_ids": [
                  "46e776fe6ca73899",
                  "318b2b3fc45d6c03",
                  "5c5c8b0c2e0e82d7"
                ],
                "status_id": 6,
                "text": "and MAY hold values of different types."
              }
            ]
          ],
          "requirements": [
            "5c5c8b0c2e0e82d7",
            "5c5c8b0c2e0e82d7"
          ],
          "title": "List Entry Value"
        }
      ],
      "title": "DynamoDB Attribute Serialization"
    },
    "specification/dynamodb-encryption-client/ddb-encryption-branch-key-id-supplier.md": {
      "format": "markdown",
      "sections": [
        {
          "id": "dynamodb-encryption-branch-key-supplier",
          "lines": [],
          "title": "DynamoDb Encryption Branch Key Supplier"
        },
        {
          "id": "overview",
          "lines": [
            "Customers currently do not have the ability to specify additional key value pairs to be introduced into the encryption context.",
            "However, this creates a limitation when using the Hierarchical Keyring with BranchKeyIdSuppliers.",
            "The intention is that this option allows customers to programmatically define what branch key should be used based on",
            "information supplied at encrypt/decrypt time.",
            "As part of normal operation, the DynamoDb Item Encryptor does put information regarding the partition and sort key into",
            "the encryption context.",
            "However it is serialized in a way that is difficult for customers to use.",
            "",
            "In order to effectively use the Hierarchy Keyring's",
            "[BranchKeyIdSupplier](../../submodules/MaterialProviders/aws-encryption-sdk-specification/framework/aws-kms/aws-kms-hierarchical-keyring.md#branch-key-id-supplier) with the DynamoDbItem encryptor,",
            "we provide a static operation that takes in a simplified interface for customers to implement,",
            "and returns a BranchKeyIdSupplier that can be directly plugged into the Hierarchical Keyring configuration."
          ],
          "title": "Overview"
        },
        {
          "id": "operation",
          "lines": [
            [
              {
                "annotation_ids": [
                  "dab5c9294b1cc072",
                  "8eb92c6a0121bc43"
                ],
                "status_id": 1,
                "text": "The `CreateDynamoDbEncryptionBranchKeyIdSupplier` is an operation that MUST be vended alongside the DynamoDb Item Encryptor."
              }
            ]
          ],
          "requirements": [
            "8eb92c6a0121bc43"
          ],
          "title": "Operation"
        },
        {
          "id": "input",
          "lines": [
            [
              {
                "annotation_ids": [
                  "38112029ee8ae020",
                  "f50accb7352b8454"
                ],
                "status_id": 1,
                "text": "This operation MUST take in a [DynamoDbKeyBranchKeyIdSupplier](#dynamodbkeybranchkeyidsupplier) as input."
              }
            ]
          ],
          "requirements": [
            "f50accb7352b8454"
          ],
          "title": "Input"
        },
        {
          "id": "output",
          "lines": [
            [
              {
                "annotation_ids": [
                  "bbb1d9e92a20c07f",
                  "b44e81f455ed5809"
                ],
                "status_id": 1,
                "text": "This operation MUST output a BranchKeyIdSupplierReference."
              }
            ]
          ],
          "requirements": [
            "b44e81f455ed5809"
          ],
          "title": "Output"
        },
        {
          "id": "behavior",
          "lines": [
            "The returned implementation of `BranchKeyIdSupplier` behaves in the following way on `GetBranchKeyId`:",
            "",
            [
              {
                "annotation_ids": [
                  "129333b112b3f358",
                  "a63c6a24591dac9b"
                ],
                "status_id": 1,
                "text": "- It MUST deserialize the \"aws-crypto-partition-name\" value in the input encryption context to determine the partition name."
              }
            ],
            [
              {
                "annotation_ids": [
                  "dd9416ccfc159c36",
                  "0ea509257cb4ae5d"
                ],
                "status_id": 1,
                "text": "- If the partition name does not exist in the encryption context, this operation MUST fail."
              }
            ],
            [
              {
                "annotation_ids": [
                  "cbe501fb1472a41d",
                  "de0e139c1002c1b4"
                ],
                "status_id": 1,
                "text": "- It MUST get the serialized partition value by grabbing the `aws-crypto-attr.<partition_name>` from the encryption context."
              }
            ],
            [
              {
                "annotation_ids": [
                  "85898d791c701619",
                  "f5af275be63753cf"
                ],
                "status_id": 1,
                "text": "- If the partition value does not exist in the encryption context, this operation MUST fail."
              }
            ],
            [
              {
                "annotation_ids": [
                  "82576369bf0b089e",
                  "03927e143f39e525"
                ],
                "status_id": 1,
                "text": "- It MUST check for the existence of \"aws-crypto-sort-name\" in the input encryption context."
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "  "
              },
              {
                "annotation_ids": [
                  "0d106ac190f6e552",
                  "526243624493a8c8"
                ],
                "status_id": 1,
                "text": "- If this key exists, it MUST get the serialized sort value by grabbing the `aws-crypto.attr:<sort_name>` from the encryption context."
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "  "
              },
              {
                "annotation_ids": [
                  "53b21b05c991400a",
                  "67096a6b5f4d04f2"
                ],
                "status_id": 1,
                "text": "- If the sort value does not exist in the context, this operation MUST fail."
              }
            ],
            [
              {
                "annotation_ids": [
                  "902ff7dc05487197",
                  "77a431b6117e029d"
                ],
                "status_id": 7,
                "text": "- If the field \"aws-crypto-legend\" exists in the encryption context,"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "  "
              },
              {
                "annotation_ids": [
                  "902ff7dc05487197",
                  "77a431b6117e029d"
                ],
                "status_id": 7,
                "text": "it MUST [deserialize](./ddb-attribute-serialization.md), all values with keys beginning \"aws-crypto-attr.\","
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "  "
              },
              {
                "annotation_ids": [
                  "902ff7dc05487197",
                  "77a431b6117e029d"
                ],
                "status_id": 7,
                "text": "and create a Key with these values, using names with the \"aws-crypto-attr.\" removed."
              }
            ],
            [
              {
                "annotation_ids": [
                  "7efa38a5a0824938",
                  "cf3373e32a73ea86"
                ],
                "status_id": 7,
                "text": "- If the field \"aws-crypto-legend\" does not exist in the encryption context, it MUST [deserialize the partition (and optionally sort) value](./ddb-attribute-serialization.md), and create a Key with these values."
              }
            ],
            "- It passes this Key to the supplied DynamoDbKeyBranchKeyIdSupplier via the `GetBranchKeyIdFromDdbKey` operation.",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "  "
              },
              {
                "annotation_ids": [
                  "385e2772c6bc97b6",
                  "014c6efb0a8923ec"
                ],
                "status_id": 7,
                "text": "- If successful, the resulting string MUST be outputted by this operation."
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "  "
              },
              {
                "annotation_ids": [
                  "150112bda7c46127",
                  "fdcb7506a13f777f"
                ],
                "status_id": 7,
                "text": "- Otherwise, this operation MUST fail."
              }
            ]
          ],
          "requirements": [
            "a63c6a24591dac9b",
            "0ea509257cb4ae5d",
            "de0e139c1002c1b4",
            "f5af275be63753cf",
            "03927e143f39e525",
            "526243624493a8c8",
            "67096a6b5f4d04f2",
            "77a431b6117e029d",
            "77a431b6117e029d",
            "77a431b6117e029d",
            "cf3373e32a73ea86",
            "014c6efb0a8923ec",
            "fdcb7506a13f777f"
          ],
          "title": "Behavior"
        },
        {
          "id": "dynamodbkeybranchkeyidsupplier",
          "lines": [
            "The DynamoDb Key Branch Key Id Supplier is an interface containing the `GetBranchKeyIdFromDdbKey` operation.",
            [
              {
                "annotation_ids": [
                  "a1168a4f603c309d",
                  "c0750f19b200ef75"
                ],
                "status_id": 1,
                "text": "This operation MUST take in a DDB `Key` structure"
              }
            ],
            [
              {
                "annotation_ids": [
                  "a1168a4f603c309d",
                  "c0750f19b200ef75"
                ],
                "status_id": 1,
                "text": "(an attribute map containing the partition and sort attributes,"
              }
            ],
            [
              {
                "annotation_ids": [
                  "a1168a4f603c309d",
                  "c0750f19b200ef75"
                ],
                "status_id": 1,
                "text": "along with the values of any attributes configured as SIGN_AND_INCLUDE_IN_ENCRYPTION_CONTEXT)"
              }
            ],
            [
              {
                "annotation_ids": [
                  "a1168a4f603c309d",
                  "c0750f19b200ef75"
                ],
                "status_id": 1,
                "text": "as input."
              }
            ],
            [
              {
                "annotation_ids": [
                  "325ef8c0800bd7d9",
                  "825e494fef319ba7"
                ],
                "status_id": 1,
                "text": "This operation MUST return a branch key id (string) as output."
              }
            ]
          ],
          "requirements": [
            "c0750f19b200ef75",
            "c0750f19b200ef75",
            "c0750f19b200ef75",
            "c0750f19b200ef75",
            "825e494fef319ba7"
          ],
          "title": "DynamoDbKeyBranchKeyIdSupplier"
        }
      ],
      "title": "DynamoDb Encryption Branch Key Supplier"
    },
    "specification/dynamodb-encryption-client/ddb-get-encrypted-data-key-description.md": {
      "format": "markdown",
      "sections": [
        {
          "id": "dynamodb-get-encrypted-data-key-description",
          "lines": [],
          "title": "DynamoDb Get Encrypted Data Key Description"
        },
        {
          "id": "overview",
          "lines": [
            "Keyring's Encrypted Data Key serialization includes metadata like key provider id, key provider info, branch Key id (only Hierarchy Keyring), and the version of the branch Key (only Hierarchy Keyring). Encrypted Data Key Description operation provides a way for the customers to get these meta data. This operation will provide them with an insight of the keys the data is encrypted with."
          ],
          "title": "Overview"
        },
        {
          "id": "operation",
          "lines": [],
          "title": "Operation"
        },
        {
          "id": "input",
          "lines": [
            [
              {
                "annotation_ids": [
                  "1d082139ea58e24c",
                  "d1b0f077b48521a8"
                ],
                "status_id": 1,
                "text": "This operation MUST take in either of the following:"
              }
            ],
            "",
            [
              {
                "annotation_ids": [
                  "1d082139ea58e24c"
                ],
                "status_id": 2,
                "text": "- A binary [header](https://github.com/aws/aws-database-encryption-sdk-dynamodb/blob/main/specification/structured-encryption/header.md)"
              }
            ],
            [
              {
                "annotation_ids": [
                  "1d082139ea58e24c"
                ],
                "status_id": 2,
                "text": "- A [encrypted DynamoDB item](https://github.com/aws/aws-database-encryption-sdk-dynamodb/blob/ff9f08a355a20c81540e4ca652e09aaeffe90c4b/specification/dynamodb-encryption-client/encrypt-item.md#encrypted-dynamodb-item)"
              }
            ]
          ],
          "requirements": [
            "d1b0f077b48521a8"
          ],
          "title": "Input"
        },
        {
          "id": "output",
          "lines": [
            [
              {
                "annotation_ids": [
                  "62f9056bb1fd999e",
                  "14c4c303d618c2bb"
                ],
                "status_id": 1,
                "text": "This operation MUST return the following:"
              }
            ],
            "",
            [
              {
                "annotation_ids": [
                  "62f9056bb1fd999e"
                ],
                "status_id": 2,
                "text": "- [keyProviderId](https://github.com/aws/aws-database-encryption-sdk-dynamodb/blob/main/specification/structured-encryption/header.md#key-provider-id)"
              }
            ],
            [
              {
                "annotation_ids": [
                  "62f9056bb1fd999e"
                ],
                "status_id": 2,
                "text": "- [keyProviderInfo](https://github.com/aws/aws-database-encryption-sdk-dynamodb/blob/main/specification/structured-encryption/header.md#key-provider-information) (only for AWS Cryptographic Materials Provider Keyring)"
              }
            ],
            [
              {
                "annotation_ids": [
                  "62f9056bb1fd999e"
                ],
                "status_id": 2,
                "text": "- [branchKeyId](https://github.com/aws/aws-database-encryption-sdk-dynamodb/blob/main/specification/structured-encryption/header.md#key-provider-information) (only for hierarchy keyring)"
              }
            ],
            [
              {
                "annotation_ids": [
                  "62f9056bb1fd999e"
                ],
                "status_id": 2,
                "text": "- [branchKeyVersion](https://github.com/aws/aws-database-encryption-sdk-dynamodb/blob/main/specification/structured-encryption/header.md#key-provider-information) (only for hierarchy keyring)"
              }
            ]
          ],
          "requirements": [
            "14c4c303d618c2bb"
          ],
          "title": "Output"
        },
        {
          "id": "behavior",
          "lines": [
            [
              {
                "annotation_ids": [
                  "5fef8046c8bc6d85"
                ],
                "status_id": 8,
                "text": "- The operation MUST NEVER DECRYPT the Data Keys."
              }
            ],
            [
              {
                "annotation_ids": [
                  "6e22cd1c9b6e3764"
                ],
                "status_id": 8,
                "text": "- The operation MUST NOT access the network in any way."
              }
            ],
            [
              {
                "annotation_ids": [
                  "d1c7eb4b4a66a600",
                  "d2fcafd5e1dc1e92"
                ],
                "status_id": 7,
                "text": "- If the input is an encrypted DynamoDB item, it MUST attempt to extract \"aws_dbe_head\" attribute from the DynamoDB item to get the binary header."
              }
            ],
            [
              {
                "annotation_ids": [
                  "26d8a28206b76688",
                  "3ff3a8b82063e92d"
                ],
                "status_id": 7,
                "text": "- This operation MUST deserialize the header bytes according to the header format."
              }
            ],
            [
              {
                "annotation_ids": [
                  "60ce9fdfcce8c2ae",
                  "619c3fa6924b2277"
                ],
                "status_id": 7,
                "text": "- This operation MUST extract the Format Flavor from the deserialize header."
              },
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": " Format Flavor is used to identify the algorithm suite."
              }
            ],
            [
              {
                "annotation_ids": [
                  "2a36d54d878ad91f",
                  "6c57006e4893a57e"
                ],
                "status_id": 7,
                "text": "- This operation MUST extract the dataKeys from the deserialize header."
              }
            ],
            [
              {
                "annotation_ids": [
                  "2ea8afa8e815522e",
                  "7c04c8e2af866351",
                  "0a99e607e731dd5d"
                ],
                "status_id": 4,
                "text": "- For every Data Key in Data Keys, the operation MUST attempt to extract a description of the Data Key."
              }
            ],
            "  - If the Data Key does not belong to AWS Cryptographic Materials Provider Keyring, the operation will only return keyProviderId.",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "  "
              },
              {
                "annotation_ids": [
                  "37bcf165c3fcc0eb"
                ],
                "status_id": 9,
                "text": "- This description SHOULD be as detailed as possible, parsing but NOT decrypting the cipher-text field of the Data Key for embedded fields such as the Hierarchical Keyring’s branchKeyVersion."
              }
            ]
          ],
          "requirements": [
            "5fef8046c8bc6d85",
            "6e22cd1c9b6e3764",
            "d2fcafd5e1dc1e92",
            "3ff3a8b82063e92d",
            "619c3fa6924b2277",
            "6c57006e4893a57e",
            "0a99e607e731dd5d",
            "37bcf165c3fcc0eb"
          ],
          "title": "Behavior"
        }
      ],
      "title": "DynamoDb Get Encrypted Data Key Description"
    },
    "specification/dynamodb-encryption-client/ddb-item-conversion.md": {
      "format": "markdown",
      "sections": [
        {
          "id": "dynamodb-item-conversion",
          "lines": [],
          "title": "DynamoDB Item Conversion"
        },
        {
          "id": "version",
          "lines": [
            "1.0.0"
          ],
          "title": "Version"
        },
        {
          "id": "changelog",
          "lines": [
            "- 1.0.0",
            "",
            "  - Initial record"
          ],
          "title": "Changelog"
        },
        {
          "id": "definitions",
          "lines": [],
          "title": "Definitions"
        },
        {
          "id": "conventions-used-in-this-document",
          "lines": [
            "The key words \"MUST\", \"MUST NOT\", \"REQUIRED\", \"SHALL\", \"SHALL NOT\", \"SHOULD\", \"SHOULD NOT\", \"RECOMMENDED\", \"MAY\", and \"OPTIONAL\"",
            "in this document are to be interpreted as described in [RFC 2119](https://tools.ietf.org/html/rfc2119)."
          ],
          "title": "Conventions used in this document"
        },
        {
          "id": "overview",
          "lines": [
            "This document describes how a DynamoDB Item is converted",
            "to the Structured Encryption Library's [Structured Data](../structured-encryption/structures.md#structured-data),",
            "and vice versa.",
            "",
            "Round Trip conversion between DDB Item and Structured Data is technically lossless, but it is not identity.",
            "The conversion normalizes some values, the same way that",
            "DynamoDB PuItem followed by GetItem normalizes some values.",
            "The sets still have the same members, and the numbers still have the same values,",
            "but the members of the set might appear in a different order,",
            "and the numeric value might be formatted differently."
          ],
          "title": "Overview"
        },
        {
          "id": "convert-ddb-item-to-structured-data",
          "lines": [
            "A [Structured Data](../structured-encryption/structures.md#structured-data)",
            "converted from a DynamoDB Item has the following requirements:",
            "",
            [
              {
                "annotation_ids": [
                  "22277806836ebdb2",
                  "bf67d8c4873e5845"
                ],
                "status_id": 1,
                "text": "- MUST contain a [Structured Data Terminal](../structured-encryption/structures.md#structured-data-terminal)"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "  "
              },
              {
                "annotation_ids": [
                  "22277806836ebdb2",
                  "bf67d8c4873e5845"
                ],
                "status_id": 1,
                "text": "for each attribute on the DynamoDB Item, and no others."
              }
            ],
            "",
            [
              {
                "annotation_ids": [
                  "590492afe5ee20c8",
                  "1627802a136c1cc9"
                ],
                "status_id": 1,
                "text": "- The [Terminal Type ID](../structured-encryption/structures.md#terminal-type-id) for each attribute MUST"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "  "
              },
              {
                "annotation_ids": [
                  "590492afe5ee20c8",
                  "1627802a136c1cc9"
                ],
                "status_id": 1,
                "text": "be the [Type ID](./ddb-attribute-serialization.md#type-id) of the [serialization](./ddb-attribute-serialization.md) of this Attribute Value."
              }
            ],
            [
              {
                "annotation_ids": [
                  "b4e47f698ddc63a3",
                  "c274e430b3ac9001"
                ],
                "status_id": 1,
                "text": "- The [Terminal Value](../structured-encryption/structures.md#terminal-value) for each attribute MUST"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "  "
              },
              {
                "annotation_ids": [
                  "b4e47f698ddc63a3",
                  "c274e430b3ac9001"
                ],
                "status_id": 1,
                "text": "be the [Value](./ddb-attribute-serialization.md#type-id) of the [serialization](./ddb-attribute-serialization.md) of this Attribute Value."
              }
            ],
            [
              {
                "annotation_ids": [
                  "7f1e498ccf5e9ff0"
                ],
                "status_id": 8,
                "text": "- The Structured Data Terminal MUST be located at the top level of the Structured Data,"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "  "
              },
              {
                "annotation_ids": [
                  "7f1e498ccf5e9ff0"
                ],
                "status_id": 8,
                "text": "string indexed by the Attribute Name."
              }
            ]
          ],
          "requirements": [
            "bf67d8c4873e5845",
            "bf67d8c4873e5845",
            "1627802a136c1cc9",
            "1627802a136c1cc9",
            "c274e430b3ac9001",
            "c274e430b3ac9001",
            "7f1e498ccf5e9ff0",
            "7f1e498ccf5e9ff0"
          ],
          "title": "Convert DDB Item to Structured Data"
        },
        {
          "id": "convert-structured-data-to-ddb-item",
          "lines": [
            "In order to convert to a DynamoDB Item,",
            "[Structured Data](../structured-encryption/structures.md#structured-data)",
            "adheres to the following:",
            "",
            "- This [Structured Data Map](../structured-encryption/structures.md#structured-data-map),",
            "  if not empty,",
            [
              {
                "annotation_ids": [
                  "8311f0d8387eac87",
                  "07fae4fced7d4619"
                ],
                "status_id": 1,
                "text": "- MUST NOT have any `Key` strings that are invalid DynamoDB AttributeNames, that is, with more than 65535 characters."
              }
            ],
            "",
            "A DynamoDB Item converted from a",
            "[Structured Data](../structured-encryption/structures.md#structured-data)",
            "has the following requirements:",
            "",
            [
              {
                "annotation_ids": [
                  "5ab3870ed5b0f42d",
                  "eb73a0dd839f4667"
                ],
                "status_id": 1,
                "text": "- MUST contain an Attribute for every [Structured Data Terminal](../structured-encryption/structures.md#structured-data-terminal)"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "  "
              },
              {
                "annotation_ids": [
                  "5ab3870ed5b0f42d",
                  "eb73a0dd839f4667"
                ],
                "status_id": 1,
                "text": "on the Structured Data, and no other Attributes."
              }
            ],
            "",
            [
              {
                "annotation_ids": [
                  "c0e0b461806f37d3",
                  "d9754cd94571462b"
                ],
                "status_id": 1,
                "text": "- Each Attribute MUST be deserializable"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "  "
              },
              {
                "annotation_ids": [
                  "c0e0b461806f37d3",
                  "d9754cd94571462b"
                ],
                "status_id": 1,
                "text": "according to [the serialization scheme](./ddb-attribute-serialization.md#value)."
              }
            ]
          ],
          "requirements": [
            "07fae4fced7d4619",
            "eb73a0dd839f4667",
            "eb73a0dd839f4667",
            "d9754cd94571462b",
            "d9754cd94571462b"
          ],
          "title": "Convert Structured Data to DDB Item"
        },
        {
          "id": "duplicates",
          "lines": [
            [
              {
                "annotation_ids": [
                  "f35b33324114b7c0",
                  "cbab763b28a7b0d1",
                  "c466b776627e5c82"
                ],
                "status_id": 4,
                "text": "- Conversion from a Structured Data Map MUST fail if it has duplicate keys"
              }
            ],
            [
              {
                "annotation_ids": [
                  "55edb6661e7ccfbe",
                  "2f35fd601f241d4c"
                ],
                "status_id": 1,
                "text": "- Conversion from a Structured Data Number Set MUST fail if it has duplicate values"
              }
            ],
            [
              {
                "annotation_ids": [
                  "e02f0a1c3da2c16e",
                  "00d3ccc640d158b7"
                ],
                "status_id": 1,
                "text": "- Conversion from a Structured Data String Set MUST fail if it has duplicate values"
              }
            ],
            [
              {
                "annotation_ids": [
                  "5a3eb91da29d8091",
                  "70cd67f4de7189a9"
                ],
                "status_id": 1,
                "text": "- Conversion from a Structured Data Binary Set MUST fail if it has duplicate values"
              }
            ]
          ],
          "requirements": [
            "c466b776627e5c82",
            "2f35fd601f241d4c",
            "00d3ccc640d158b7",
            "70cd67f4de7189a9"
          ],
          "title": "Duplicates"
        }
      ],
      "title": "DynamoDB Item Conversion"
    },
    "specification/dynamodb-encryption-client/ddb-item-encryptor.md": {
      "format": "markdown",
      "sections": [
        {
          "id": "dynamodb-item-encryptor",
          "lines": [],
          "title": "DynamoDB Item Encryptor"
        },
        {
          "id": "version",
          "lines": [
            "1.0.0"
          ],
          "title": "Version"
        },
        {
          "id": "changelog",
          "lines": [
            "- 1.0.0",
            "",
            "  - Initial record"
          ],
          "title": "Changelog"
        },
        {
          "id": "definitions",
          "lines": [],
          "title": "Definitions"
        },
        {
          "id": "conventions-used-in-this-document",
          "lines": [
            "The key words \"MUST\", \"MUST NOT\", \"REQUIRED\", \"SHALL\", \"SHALL NOT\", \"SHOULD\", \"SHOULD NOT\", \"RECOMMENDED\", \"MAY\", and \"OPTIONAL\"",
            "in this document are to be interpreted as described in [RFC 2119](https://tools.ietf.org/html/rfc2119)."
          ],
          "title": "Conventions used in this document"
        },
        {
          "id": "overview",
          "lines": [
            "This document describes the behavior for the",
            "DynamoDB Item Encryptor.",
            "It is responsible for",
            "the encryption and decryption of [DynamoDB Items](https://docs.aws.amazon.com/amazondynamodb/latest/developerguide/WorkingWithItems.html)",
            "for a particular DynamoDB Table.",
            "The DynamoDB Item Encryptor is publicly exposed and",
            "is used to directly encrypt or decrypt",
            "DynamoDB Items outside of DynamoDB API calls."
          ],
          "title": "Overview"
        },
        {
          "id": "initialization",
          "lines": [
            [
              {
                "annotation_ids": [
                  "bfc5095fb7229df3",
                  "1f79ef3b53414e0f"
                ],
                "status_id": 1,
                "text": "On initialization of the DynamoDB Item Encryptor"
              }
            ],
            [
              {
                "annotation_ids": [
                  "bfc5095fb7229df3",
                  "1f79ef3b53414e0f"
                ],
                "status_id": 1,
                "text": "the caller MUST provide:"
              }
            ],
            "",
            [
              {
                "annotation_ids": [
                  "bfc5095fb7229df3"
                ],
                "status_id": 2,
                "text": "- [DynamoDB Table Name](./ddb-table-encryption-config.md#dynamodb-table-name)"
              }
            ],
            [
              {
                "annotation_ids": [
                  "bfc5095fb7229df3"
                ],
                "status_id": 2,
                "text": "- [DynamoDB Partition Key Name](./ddb-table-encryption-config.md#dynamodb-partition-key-name)"
              }
            ],
            [
              {
                "annotation_ids": [
                  "bfc5095fb7229df3"
                ],
                "status_id": 2,
                "text": "- [Attribute Actions](./ddb-table-encryption-config.md#attribute-actions)"
              }
            ],
            [
              {
                "annotation_ids": [
                  "bfc5095fb7229df3"
                ],
                "status_id": 2,
                "text": "- A [CMM](./ddb-table-encryption-config.md#cmm) or [Keyring](./ddb-table-encryption-config.md#keyring)"
              }
            ],
            "",
            [
              {
                "annotation_ids": [
                  "932f21eac306fce6",
                  "b9122885b39abfa4"
                ],
                "status_id": 3,
                "text": "The following are OPTIONAL for the DynamoDB Item Encryptor:"
              }
            ],
            "",
            [
              {
                "annotation_ids": [
                  "932f21eac306fce6"
                ],
                "status_id": 2,
                "text": "- [DynamoDB Sort Key Name](./ddb-table-encryption-config.md#dynamodb-sort-key-name)"
              }
            ],
            [
              {
                "annotation_ids": [
                  "932f21eac306fce6"
                ],
                "status_id": 2,
                "text": "- [Unauthenticated Attributes](./ddb-table-encryption-config.md#unauthenticated-attributes)"
              }
            ],
            [
              {
                "annotation_ids": [
                  "932f21eac306fce6"
                ],
                "status_id": 2,
                "text": "- [Unauthenticated Attribute Name Prefix](./ddb-table-encryption-config.md#unauthenticated-attribute-prefix)"
              }
            ],
            [
              {
                "annotation_ids": [
                  "932f21eac306fce6"
                ],
                "status_id": 2,
                "text": "- [Algorithm Suite](./ddb-table-encryption-config.md#algorithm-suite)"
              }
            ],
            [
              {
                "annotation_ids": [
                  "932f21eac306fce6"
                ],
                "status_id": 2,
                "text": "- [Legacy Config](./ddb-table-encryption-config.md#legacy-config)"
              }
            ],
            [
              {
                "annotation_ids": [
                  "932f21eac306fce6"
                ],
                "status_id": 2,
                "text": "- [Plaintext Policy](./ddb-table-encryption-config.md#plaintext-policy)"
              }
            ]
          ],
          "requirements": [
            "1f79ef3b53414e0f",
            "1f79ef3b53414e0f",
            "b9122885b39abfa4"
          ],
          "title": "Initialization"
        },
        {
          "id": "operation",
          "lines": [],
          "title": "Operation"
        },
        {
          "id": "encryptitem",
          "lines": [
            [
              {
                "annotation_ids": [
                  "b8f3e365fea1d8b1",
                  "a5782d4568028e26"
                ],
                "status_id": 1,
                "text": "The DynamoDB Item Encryptor MUST provide a function that adheres to [EncryptItem](./encrypt-item.md)."
              }
            ]
          ],
          "requirements": [
            "a5782d4568028e26"
          ],
          "title": "EncryptItem"
        },
        {
          "id": "decryptitem",
          "lines": [
            [
              {
                "annotation_ids": [
                  "069ab4f1b6a727b9",
                  "49ed4b3031955cfe"
                ],
                "status_id": 1,
                "text": "The DynamoDB Item Encryptor MUST provide a function that adheres to [DecryptItem](./decrypt-item.md)."
              }
            ]
          ],
          "requirements": [
            "49ed4b3031955cfe"
          ],
          "title": "DecryptItem"
        }
      ],
      "title": "DynamoDB Item Encryptor"
    },
    "specification/dynamodb-encryption-client/ddb-sdk-integration.md": {
      "format": "markdown",
      "sections": [
        {
          "id": "dynamodb-sdk-integration",
          "lines": [],
          "title": "DynamoDB SDK Integration"
        },
        {
          "id": "version",
          "lines": [
            "1.0.0"
          ],
          "title": "Version"
        },
        {
          "id": "changelog",
          "lines": [
            "- 1.0.0",
            "",
            "  - Initial record"
          ],
          "title": "Changelog"
        },
        {
          "id": "definitions",
          "lines": [],
          "title": "Definitions"
        },
        {
          "id": "conventions-used-in-this-document",
          "lines": [
            "The key words \"MUST\", \"MUST NOT\", \"REQUIRED\", \"SHALL\", \"SHALL NOT\", \"SHOULD\", \"SHOULD NOT\", \"RECOMMENDED\", \"MAY\", and \"OPTIONAL\"",
            "in this document are to be interpreted as described in [RFC 2119](https://tools.ietf.org/html/rfc2119)."
          ],
          "title": "Conventions used in this document"
        },
        {
          "id": "overview",
          "lines": [
            "Customers want to be able to use the",
            "AWS SDK to call the DynamoDB APIs they are familiar with,",
            "while having encryption and decryption of their items",
            "happen transparently.",
            "",
            "The AWS SDK is available in a variety of languages,",
            "and the ways to configure and construct the client in each differs.",
            "Thus, providing this behavior in each AWS SDK language",
            "will not be standardized.",
            "",
            [
              {
                "annotation_ids": [
                  "73de3285e1f82416"
                ],
                "status_id": 8,
                "text": "There MUST be some process by which"
              }
            ],
            [
              {
                "annotation_ids": [
                  "73de3285e1f82416"
                ],
                "status_id": 8,
                "text": "the customer can create this AWS SDK with"
              }
            ],
            [
              {
                "annotation_ids": [
                  "73de3285e1f82416"
                ],
                "status_id": 8,
                "text": "additional encryption behavior, which"
              }
            ],
            [
              {
                "annotation_ids": [
                  "73de3285e1f82416"
                ],
                "status_id": 8,
                "text": "this document will refer to as a [DynamoDB Encryption Client](#dynamodb-encryption-client)."
              }
            ],
            [
              {
                "annotation_ids": [
                  "a4639c8144612f2a"
                ],
                "status_id": 8,
                "text": "There is no restriction on what this process is,"
              }
            ],
            [
              {
                "annotation_ids": [
                  "a4639c8144612f2a"
                ],
                "status_id": 8,
                "text": "other than the fact that at some point the customer"
              }
            ],
            [
              {
                "annotation_ids": [
                  "a4639c8144612f2a"
                ],
                "status_id": 8,
                "text": "MUST specify a [DynamoDB Encryption Client Configuration](#dynamodb-encryption-client-configuration)."
              }
            ],
            [
              {
                "annotation_ids": [
                  "7b675e1dfd408dcb"
                ],
                "status_id": 8,
                "text": "This configuration MUST be the configuration ultimately used by"
              }
            ],
            [
              {
                "annotation_ids": [
                  "7b675e1dfd408dcb"
                ],
                "status_id": 8,
                "text": "the behaviors within the DynamoDB Encryption Client."
              }
            ],
            "",
            "For example, the AWS SDK for Java (as of 2.x) defines a",
            "[Interceptor interface](https://sdk.amazonaws.com/java/api/latest/software/amazon/awssdk/core/interceptor/ExecutionInterceptor.html)",
            "which can be used to add logic before and after API calls.",
            "In order to provide an idiomatic experience for AWS SDK for Java customers,",
            "to implement this for the Java SDK we would implement an Interceptor that",
            "requires the [DynamoDB Encryption Client Configuration](#dynamodb-encryption-client-configuration)",
            "on construction.",
            "This interceptor can then itself be use as input when building the AWS SDK client",
            "in order to create a client which performs the necessary encryption and decryption",
            "logic during API calls.",
            "",
            [
              {
                "annotation_ids": [
                  "bfb1f2c2ea8bc010"
                ],
                "status_id": 10,
                "text": "For AWS SDKs that do not support an idiomatic way to hook new"
              }
            ],
            [
              {
                "annotation_ids": [
                  "bfb1f2c2ea8bc010"
                ],
                "status_id": 10,
                "text": "behavior before and after API calls,"
              }
            ],
            [
              {
                "annotation_ids": [
                  "bfb1f2c2ea8bc010"
                ],
                "status_id": 10,
                "text": "this MAY be implemented by providing an"
              }
            ],
            [
              {
                "annotation_ids": [
                  "bfb1f2c2ea8bc010"
                ],
                "status_id": 10,
                "text": "implementation of AWS SDK APIs that wrap"
              }
            ],
            [
              {
                "annotation_ids": [
                  "bfb1f2c2ea8bc010"
                ],
                "status_id": 10,
                "text": "the relevant APIs with the necessary encryption and decryption logic."
              }
            ],
            [
              {
                "annotation_ids": [
                  "0e4cda5422eb66b5"
                ],
                "status_id": 9,
                "text": "This new implementation SHOULD be a drop-in replacement of the"
              }
            ],
            [
              {
                "annotation_ids": [
                  "0e4cda5422eb66b5"
                ],
                "status_id": 9,
                "text": "regular AWS SDK."
              }
            ]
          ],
          "requirements": [
            "73de3285e1f82416",
            "73de3285e1f82416",
            "73de3285e1f82416",
            "73de3285e1f82416",
            "a4639c8144612f2a",
            "a4639c8144612f2a",
            "a4639c8144612f2a",
            "7b675e1dfd408dcb",
            "7b675e1dfd408dcb",
            "bfb1f2c2ea8bc010",
            "bfb1f2c2ea8bc010",
            "bfb1f2c2ea8bc010",
            "bfb1f2c2ea8bc010",
            "bfb1f2c2ea8bc010",
            "0e4cda5422eb66b5",
            "0e4cda5422eb66b5"
          ],
          "title": "Overview"
        },
        {
          "id": "dynamodb-encryption-client-configuration",
          "lines": [
            [
              {
                "annotation_ids": [
                  "191b79ea628a04e3"
                ],
                "status_id": 8,
                "text": "The DynamoDB Encryption Client Configuration is a structure that"
              }
            ],
            [
              {
                "annotation_ids": [
                  "191b79ea628a04e3"
                ],
                "status_id": 8,
                "text": "the customer MUST provide in the process of creating a [DynamoDB Encryption Client](#dynamodb-encryption-client)."
              }
            ],
            "",
            [
              {
                "annotation_ids": [
                  "6e97f306295c48d1",
                  "dc58f2b15c38c8c6"
                ],
                "status_id": 1,
                "text": "The client configuration consists of the following REQUIRED field:"
              }
            ],
            "",
            [
              {
                "annotation_ids": [
                  "6e97f306295c48d1"
                ],
                "status_id": 2,
                "text": "- [DynamoDb Table Encryption Configs](#dynamodb-table-encryption-configs)"
              }
            ]
          ],
          "requirements": [
            "191b79ea628a04e3",
            "191b79ea628a04e3",
            "dc58f2b15c38c8c6"
          ],
          "title": "DynamoDB Encryption Client Configuration"
        },
        {
          "id": "dynamodb-table-encryption-configs",
          "lines": [
            [
              {
                "annotation_ids": [
                  "f240cca8aaff6d7f",
                  "ca34eb6352ab4040"
                ],
                "status_id": 1,
                "text": "A map of DynamoDb table names to a structure that MUST contain"
              }
            ],
            [
              {
                "annotation_ids": [
                  "f240cca8aaff6d7f",
                  "ca34eb6352ab4040"
                ],
                "status_id": 1,
                "text": "data as described by [DynamoDb Table Encryption Config](./ddb-table-encryption-config.md)."
              }
            ],
            "Note that this data does not need to contain the Table Name.",
            "",
            [
              {
                "annotation_ids": [
                  "0ec07b12d3a253db",
                  "5fa8e5439112c7b6"
                ],
                "status_id": 7,
                "text": "During initialization, this client MUST construct a"
              }
            ],
            [
              {
                "annotation_ids": [
                  "0ec07b12d3a253db",
                  "5fa8e5439112c7b6"
                ],
                "status_id": 7,
                "text": "[DynamoDb Item Encryptor](./ddb-table-encryption-config.md)"
              }
            ],
            [
              {
                "annotation_ids": [
                  "0ec07b12d3a253db",
                  "5fa8e5439112c7b6"
                ],
                "status_id": 7,
                "text": "per configured table, using these table encryption configs."
              }
            ]
          ],
          "requirements": [
            "ca34eb6352ab4040",
            "ca34eb6352ab4040",
            "5fa8e5439112c7b6",
            "5fa8e5439112c7b6",
            "5fa8e5439112c7b6"
          ],
          "title": "DynamoDb Table Encryption Configs"
        },
        {
          "id": "encrypted-table",
          "lines": [
            "If there exists an Item Encryptor specified within the",
            "[DynamoDB Encryption Client Config](#dynamodb-encryption-client-configuration)",
            "with a [DynamoDB Table Name](./ddb-item-encryptor.md#dynamodb-table-name)",
            "equal to a given `TableName`, that table is said to be an `Encrypted Table`."
          ],
          "title": "Encrypted Table"
        },
        {
          "id": "dynamodb-encryption-client",
          "lines": [
            "The DynamoDB Encryption Client is an AWS SDK client for DynamoDB,",
            "such that client-side encryption and decryption happens transparently during",
            "AWS SDK API calls to DynamoDB."
          ],
          "title": "DynamoDB Encryption Client"
        },
        {
          "id": "general-modification-behavior",
          "lines": [
            "If no Item Encryptor is specified for the table, the call to DynamoDB is unmodified.",
            "Otherwise:",
            "",
            "No DDB API legacy parameters (such as `AttributesToGet`) can be specified.",
            "",
            "Any Condition Expression must be checked for [validity](ddb-support.md#testconditionexpression).",
            "Any Update Expression must be checked for [validity](ddb-support.md#testupdateexpression)",
            "",
            "If data is to be written",
            "",
            "- the input data must validated",
            "- beacons must be added",
            "- the input data must be encrypted",
            "",
            "If data is being read",
            "",
            "- the output data must be decrypted",
            "- beacons must be removed",
            "",
            "For Query and Scan, more complex processing must be invoked for both input (before encryption),",
            "and output (after decryption)."
          ],
          "title": "General Modification Behavior"
        },
        {
          "id": "api-modification",
          "lines": [
            [
              {
                "annotation_ids": [
                  "371e033929becd7e"
                ],
                "status_id": 8,
                "text": "DynamoDB API calls"
              }
            ],
            [
              {
                "annotation_ids": [
                  "371e033929becd7e"
                ],
                "status_id": 8,
                "text": "MUST have the following modified behavior:"
              }
            ],
            "",
            "- [Encrypt before PutItem](#encrypt-before-putitem)",
            "- [Encrypt before BatchWriteItem](#encrypt-before-batchwriteitem)",
            "- [Encrypt before TransactWriteItems](#encrypt-before-transactwriteitems)",
            "- [Decrypt after GetItem](#decrypt-after-getitem)",
            "- [Decrypt after PutItem](#decrypt-after-putitem)",
            "- [Decrypt after UpdateItem](#decrypt-after-updateitem)",
            "- [Decrypt after DeleteItem](#decrypt-after-deleteitem)",
            "- [Decrypt after BatchGetItem](#decrypt-after-batchgetitem)",
            "- [Decrypt after Scan](#decrypt-after-scan)",
            "- [Decrypt after Query](#decrypt-after-query)",
            "- [Decrypt after TransactGetItem](#decrypt-after-transactgetitems)",
            "- [Validate before UpdateItem](#validate-before-updateitem)",
            "- [Validate before DeleteItem](#validate-before-deleteitem)",
            "- [Validate before ExecuteStatement](#validate-before-executestatement)",
            "- [Validate before BatchExecuteStatement](#validate-before-batchexecutestatement)",
            "- [Validate before ExecuteTransaction](#validate-before-executetransaction)",
            "- [Modify before Scan](#modify-before-scan)",
            "- [Modify before Query](#modify-before-query)",
            "",
            [
              {
                "annotation_ids": [
                  "bca305ca408f3ba0"
                ],
                "status_id": 8,
                "text": "The [Allowed Passthrough DynamoDB APIs](#allowed-passthrough-dynamodb-apis)"
              }
            ],
            [
              {
                "annotation_ids": [
                  "bca305ca408f3ba0"
                ],
                "status_id": 8,
                "text": "MUST NOT be modified."
              }
            ],
            "",
            [
              {
                "annotation_ids": [
                  "fff4b7fa0c865ea1"
                ],
                "status_id": 8,
                "text": "Any DynamoDB API not specified is this document either"
              }
            ],
            [
              {
                "annotation_ids": [
                  "fff4b7fa0c865ea1"
                ],
                "status_id": 8,
                "text": "MUST NOT be callable or MUST yield an error,"
              }
            ],
            [
              {
                "annotation_ids": [
                  "fff4b7fa0c865ea1"
                ],
                "status_id": 8,
                "text": "and that error SHOULD indicate that the operation"
              }
            ],
            [
              {
                "annotation_ids": [
                  "fff4b7fa0c865ea1"
                ],
                "status_id": 8,
                "text": "is not supported with DynamoDB client-side encryption."
              }
            ]
          ],
          "requirements": [
            "371e033929becd7e",
            "371e033929becd7e",
            "bca305ca408f3ba0",
            "bca305ca408f3ba0",
            "fff4b7fa0c865ea1",
            "fff4b7fa0c865ea1",
            "fff4b7fa0c865ea1",
            "fff4b7fa0c865ea1"
          ],
          "title": "API modification"
        },
        {
          "id": "encrypt-before-putitem",
          "lines": [
            "Before the [PutItem](https://docs.aws.amazon.com/amazondynamodb/latest/APIReference/API_PutItem.html)",
            "call is made to DynamoDB :",
            "",
            [
              {
                "annotation_ids": [
                  "1906041c1d62b641",
                  "ecdd1f3d3077bbc8"
                ],
                "status_id": 1,
                "text": "If the `TableName` in the request does not refer to an [encrypted-table](#encrypted-table),"
              }
            ],
            [
              {
                "annotation_ids": [
                  "1906041c1d62b641",
                  "ecdd1f3d3077bbc8"
                ],
                "status_id": 1,
                "text": "the PutItem request MUST be unchanged."
              }
            ],
            "",
            "Otherwise,",
            "",
            [
              {
                "annotation_ids": [
                  "f8522b7ddb380231",
                  "6b504878752ceee0"
                ],
                "status_id": 1,
                "text": "The PutItem request MUST NOT refer to any legacy parameters,"
              }
            ],
            [
              {
                "annotation_ids": [
                  "f8522b7ddb380231",
                  "6b504878752ceee0"
                ],
                "status_id": 1,
                "text": "specifically Expected and ConditionalOperator MUST NOT be set."
              }
            ],
            "",
            [
              {
                "annotation_ids": [
                  "784ae02ba10dcd21",
                  "b82769acd595c224"
                ],
                "status_id": 1,
                "text": "The Item MUST be [writable](ddb-support.md#writable)."
              }
            ],
            "",
            [
              {
                "annotation_ids": [
                  "d285086634027cb2",
                  "8fd5a393bfe8517a"
                ],
                "status_id": 1,
                "text": "The ConditionExpression MUST be [valid](ddb-support.md#testconditionexpression)."
              }
            ],
            "",
            [
              {
                "annotation_ids": [
                  "b867a81146eee955"
                ],
                "status_id": 8,
                "text": "Signed Beacons MUST be [added](ddb-support.md#addsignedbeacons)."
              }
            ],
            "",
            [
              {
                "annotation_ids": [
                  "fa2daf7b3327c43c"
                ],
                "status_id": 8,
                "text": "If the [Beacon Key Source](../searchable-encryption/search-config.md#beacon-key-source)"
              }
            ],
            [
              {
                "annotation_ids": [
                  "fa2daf7b3327c43c"
                ],
                "status_id": 8,
                "text": "is a [Multi Key Store](../searchable-encryption/search-config.md#multi-key-store-initialization)"
              }
            ],
            [
              {
                "annotation_ids": [
                  "fa2daf7b3327c43c"
                ],
                "status_id": 8,
                "text": "the [Beacon Key Field Name](../searchable-encryption/search-config.md#beacon-key-field-name)"
              }
            ],
            [
              {
                "annotation_ids": [
                  "fa2daf7b3327c43c"
                ],
                "status_id": 8,
                "text": "MUST be [handled](./ddb-support.md#handlebeaconkeyfieldname)."
              }
            ],
            "",
            [
              {
                "annotation_ids": [
                  "1f29c1f7089457f7"
                ],
                "status_id": 8,
                "text": "If the [Beacon Key Source](../searchable-encryption/search-config.md#beacon-key-source)"
              }
            ],
            [
              {
                "annotation_ids": [
                  "1f29c1f7089457f7"
                ],
                "status_id": 8,
                "text": "is a [Multi Key Store](../searchable-encryption/search-config.md#multi-key-store-initialization)"
              }
            ],
            [
              {
                "annotation_ids": [
                  "1f29c1f7089457f7"
                ],
                "status_id": 8,
                "text": "the [Item Encryptor](./ddb-item-encryptor.md) MUST perform"
              }
            ],
            [
              {
                "annotation_ids": [
                  "1f29c1f7089457f7"
                ],
                "status_id": 8,
                "text": "[Encrypt Item](./encrypt-item.md),"
              }
            ],
            [
              {
                "annotation_ids": [
                  "1f29c1f7089457f7"
                ],
                "status_id": 8,
                "text": "where the input [DynamoDB Item](./encrypt-item.md#dynamodb-item)"
              }
            ],
            [
              {
                "annotation_ids": [
                  "1f29c1f7089457f7"
                ],
                "status_id": 8,
                "text": "is output of [handling the beacon key field name](ddb-support.md#handlebeaconkeyfieldname) operation."
              }
            ],
            "",
            [
              {
                "annotation_ids": [
                  "638d2962f3766ef5"
                ],
                "status_id": 8,
                "text": "If the [Beacon Key Source](../searchable-encryption/search-config.md#beacon-key-source)"
              }
            ],
            [
              {
                "annotation_ids": [
                  "638d2962f3766ef5"
                ],
                "status_id": 8,
                "text": "is a [Single Key Store](../searchable-encryption/search-config.md#single-key-store-initialization)"
              }
            ],
            [
              {
                "annotation_ids": [
                  "638d2962f3766ef5"
                ],
                "status_id": 8,
                "text": "the [Item Encryptor](./ddb-item-encryptor.md) MUST perform"
              }
            ],
            [
              {
                "annotation_ids": [
                  "638d2962f3766ef5"
                ],
                "status_id": 8,
                "text": "[Encrypt Item](./encrypt-item.md),"
              }
            ],
            [
              {
                "annotation_ids": [
                  "638d2962f3766ef5"
                ],
                "status_id": 8,
                "text": "where the input [DynamoDB Item](./encrypt-item.md#dynamodb-item)"
              }
            ],
            [
              {
                "annotation_ids": [
                  "638d2962f3766ef5"
                ],
                "status_id": 8,
                "text": "is output of [adding the signed beacons](ddb-support.md#addsignedbeacons) operation."
              }
            ],
            "",
            [
              {
                "annotation_ids": [
                  "27305ee487a1eedd"
                ],
                "status_id": 8,
                "text": "If the [Beacon Key Source](../searchable-encryption/search-config.md#beacon-key-source)"
              }
            ],
            [
              {
                "annotation_ids": [
                  "27305ee487a1eedd"
                ],
                "status_id": 8,
                "text": "is a [Multi Key Store](../searchable-encryption/search-config.md#multi-key-store-initialization)"
              }
            ],
            [
              {
                "annotation_ids": [
                  "27305ee487a1eedd"
                ],
                "status_id": 8,
                "text": "and a `branch key id` was returned from [handling the beacon key field name](ddb-support.md#handlebeaconkeyfieldname)"
              }
            ],
            [
              {
                "annotation_ids": [
                  "27305ee487a1eedd"
                ],
                "status_id": 8,
                "text": "this `branch key id` MUST match the value"
              }
            ],
            [
              {
                "annotation_ids": [
                  "27305ee487a1eedd"
                ],
                "status_id": 8,
                "text": "returned from [Get beacon key id from Parsed Header](../searchable-encryption/search-config.md#get-beacon-key-id-from-parsed-header)."
              }
            ],
            "",
            [
              {
                "annotation_ids": [
                  "ffb7748c607a08e4"
                ],
                "status_id": 8,
                "text": "Encrypted Beacons MUST be [added](ddb-support.md#addencryptedbeacons)."
              }
            ],
            "",
            [
              {
                "annotation_ids": [
                  "ffbc35856e230b7e"
                ],
                "status_id": 8,
                "text": "If any of the above fails,"
              }
            ],
            [
              {
                "annotation_ids": [
                  "ffbc35856e230b7e"
                ],
                "status_id": 8,
                "text": "the client MUST NOT make a network call to DynamoDB,"
              }
            ],
            [
              {
                "annotation_ids": [
                  "ffbc35856e230b7e"
                ],
                "status_id": 8,
                "text": "and PutItem MUST yield an error."
              }
            ],
            "",
            [
              {
                "annotation_ids": [
                  "e741c61897b439d3"
                ],
                "status_id": 8,
                "text": "The PutItem request's `Item` field MUST be replaced"
              }
            ],
            [
              {
                "annotation_ids": [
                  "e741c61897b439d3"
                ],
                "status_id": 8,
                "text": "with a value that is equivalent to"
              }
            ],
            [
              {
                "annotation_ids": [
                  "e741c61897b439d3"
                ],
                "status_id": 8,
                "text": "the output of the [add encrypted beacons](ddb-support.md#addencryptedbeacons) operation"
              }
            ],
            [
              {
                "annotation_ids": [
                  "e741c61897b439d3"
                ],
                "status_id": 8,
                "text": "calculated above."
              }
            ]
          ],
          "requirements": [
            "ecdd1f3d3077bbc8",
            "ecdd1f3d3077bbc8",
            "6b504878752ceee0",
            "6b504878752ceee0",
            "b82769acd595c224",
            "8fd5a393bfe8517a",
            "b867a81146eee955",
            "fa2daf7b3327c43c",
            "fa2daf7b3327c43c",
            "fa2daf7b3327c43c",
            "fa2daf7b3327c43c",
            "1f29c1f7089457f7",
            "1f29c1f7089457f7",
            "1f29c1f7089457f7",
            "1f29c1f7089457f7",
            "1f29c1f7089457f7",
            "1f29c1f7089457f7",
            "638d2962f3766ef5",
            "638d2962f3766ef5",
            "638d2962f3766ef5",
            "638d2962f3766ef5",
            "638d2962f3766ef5",
            "638d2962f3766ef5",
            "27305ee487a1eedd",
            "27305ee487a1eedd",
            "27305ee487a1eedd",
            "27305ee487a1eedd",
            "27305ee487a1eedd",
            "ffb7748c607a08e4",
            "ffbc35856e230b7e",
            "ffbc35856e230b7e",
            "ffbc35856e230b7e",
            "e741c61897b439d3",
            "e741c61897b439d3",
            "e741c61897b439d3",
            "e741c61897b439d3"
          ],
          "title": "Encrypt before PutItem"
        },
        {
          "id": "encrypt-before-batchwriteitem",
          "lines": [
            "Before the [BatchWriteItem](https://docs.aws.amazon.com/amazondynamodb/latest/APIReference/API_BatchWriteItem.html)",
            "call is made to DynamoDB :",
            "",
            "For each table name in `RequestItems`",
            "",
            [
              {
                "annotation_ids": [
                  "c514fe2d13c55791",
                  "d48f662a1837be65"
                ],
                "status_id": 7,
                "text": "If the table name does not refer to an [encrypted-table](#encrypted-table),"
              }
            ],
            [
              {
                "annotation_ids": [
                  "c514fe2d13c55791",
                  "d48f662a1837be65"
                ],
                "status_id": 7,
                "text": "the list of operations MUST be unchanged."
              }
            ],
            "",
            "Otherwise,",
            "",
            "For each operation associated with the table name, if there is a PutRequest:",
            "",
            [
              {
                "annotation_ids": [
                  "20ce905115111c15",
                  "22befbf93a63763b"
                ],
                "status_id": 7,
                "text": "The Item MUST be [writable](ddb-support.md#writable)."
              }
            ],
            "",
            [
              {
                "annotation_ids": [
                  "1479a6504caa055a"
                ],
                "status_id": 8,
                "text": "Signed Beacons MUST be [added](ddb-support.md#addsignedbeacons)."
              }
            ],
            "",
            [
              {
                "annotation_ids": [
                  "99bfb3454672e008"
                ],
                "status_id": 8,
                "text": "If the [Beacon Key Source](../searchable-encryption/search-config.md#beacon-key-source)"
              }
            ],
            [
              {
                "annotation_ids": [
                  "99bfb3454672e008"
                ],
                "status_id": 8,
                "text": "is a [Multi Key Store](../searchable-encryption/search-config.md#multi-key-store-initialization)"
              }
            ],
            [
              {
                "annotation_ids": [
                  "99bfb3454672e008"
                ],
                "status_id": 8,
                "text": "the [Beacon Key Field Name](../searchable-encryption/search-config.md#beacon-key-field-name)"
              }
            ],
            [
              {
                "annotation_ids": [
                  "99bfb3454672e008"
                ],
                "status_id": 8,
                "text": "MUST be [handled](./ddb-support.md#handlebeaconkeyfieldname)."
              }
            ],
            "",
            [
              {
                "annotation_ids": [
                  "3fcfeacff498c892"
                ],
                "status_id": 8,
                "text": "If the [Beacon Key Source](../searchable-encryption/search-config.md#beacon-key-source)"
              }
            ],
            [
              {
                "annotation_ids": [
                  "3fcfeacff498c892"
                ],
                "status_id": 8,
                "text": "is a [Multi Key Store](../searchable-encryption/search-config.md#multi-key-store-initialization)"
              }
            ],
            [
              {
                "annotation_ids": [
                  "3fcfeacff498c892"
                ],
                "status_id": 8,
                "text": "the [Item Encryptor](./ddb-item-encryptor.md) MUST perform"
              }
            ],
            [
              {
                "annotation_ids": [
                  "3fcfeacff498c892"
                ],
                "status_id": 8,
                "text": "[Encrypt Item](./encrypt-item.md),"
              }
            ],
            [
              {
                "annotation_ids": [
                  "3fcfeacff498c892"
                ],
                "status_id": 8,
                "text": "where the input [DynamoDB Item](./encrypt-item.md#dynamodb-item)"
              }
            ],
            [
              {
                "annotation_ids": [
                  "3fcfeacff498c892"
                ],
                "status_id": 8,
                "text": "is output of [handling the beacon key field name](ddb-support.md#handlebeaconkeyfieldname) operation."
              }
            ],
            "",
            [
              {
                "annotation_ids": [
                  "56cf62f1fa2e435e"
                ],
                "status_id": 8,
                "text": "If the [Beacon Key Source](../searchable-encryption/search-config.md#beacon-key-source)"
              }
            ],
            [
              {
                "annotation_ids": [
                  "56cf62f1fa2e435e"
                ],
                "status_id": 8,
                "text": "is a [Single Key Store](../searchable-encryption/search-config.md#single-key-store-initialization)"
              }
            ],
            [
              {
                "annotation_ids": [
                  "56cf62f1fa2e435e"
                ],
                "status_id": 8,
                "text": "the [Item Encryptor](./ddb-item-encryptor.md) MUST perform"
              }
            ],
            [
              {
                "annotation_ids": [
                  "56cf62f1fa2e435e"
                ],
                "status_id": 8,
                "text": "[Encrypt Item](./encrypt-item.md),"
              }
            ],
            [
              {
                "annotation_ids": [
                  "56cf62f1fa2e435e"
                ],
                "status_id": 8,
                "text": "where the input [DynamoDB Item](./encrypt-item.md#dynamodb-item)"
              }
            ],
            [
              {
                "annotation_ids": [
                  "56cf62f1fa2e435e"
                ],
                "status_id": 8,
                "text": "is output of [adding the signed beacons](ddb-support.md#addsignedbeacons) operation."
              }
            ],
            "",
            [
              {
                "annotation_ids": [
                  "5f580a0010dbb465"
                ],
                "status_id": 8,
                "text": "If the [Beacon Key Source](../searchable-encryption/search-config.md#beacon-key-source)"
              }
            ],
            [
              {
                "annotation_ids": [
                  "5f580a0010dbb465"
                ],
                "status_id": 8,
                "text": "is a [Multi Key Store](../searchable-encryption/search-config.md#multi-key-store-initialization)"
              }
            ],
            [
              {
                "annotation_ids": [
                  "5f580a0010dbb465"
                ],
                "status_id": 8,
                "text": "and a `branch key id` was returned from [handling the beacon key field name](ddb-support.md#handlebeaconkeyfieldname)"
              }
            ],
            [
              {
                "annotation_ids": [
                  "5f580a0010dbb465"
                ],
                "status_id": 8,
                "text": "this `branch key id` MUST match the value"
              }
            ],
            [
              {
                "annotation_ids": [
                  "5f580a0010dbb465"
                ],
                "status_id": 8,
                "text": "returned from [Get beacon key id from Parsed Header](../searchable-encryption/search-config.md#get-beacon-key-id-from-parsed-header)."
              }
            ],
            "",
            [
              {
                "annotation_ids": [
                  "d981319c2acdb060"
                ],
                "status_id": 8,
                "text": "Encrypted Beacons MUST be [added](ddb-support.md#addencryptedbeacons)."
              }
            ],
            "",
            [
              {
                "annotation_ids": [
                  "42745dcb9cf3588f"
                ],
                "status_id": 8,
                "text": "If any of the above fails,"
              }
            ],
            [
              {
                "annotation_ids": [
                  "42745dcb9cf3588f"
                ],
                "status_id": 8,
                "text": "the client MUST NOT make a network call to DynamoDB,"
              }
            ],
            [
              {
                "annotation_ids": [
                  "42745dcb9cf3588f"
                ],
                "status_id": 8,
                "text": "and BatchWriteItem MUST yield an error."
              }
            ],
            "",
            [
              {
                "annotation_ids": [
                  "9dceae423a85c9f7",
                  "a29b83544d75238c"
                ],
                "status_id": 7,
                "text": "The PutRequest request's `Item` field MUST be replaced"
              }
            ],
            [
              {
                "annotation_ids": [
                  "9dceae423a85c9f7",
                  "a29b83544d75238c"
                ],
                "status_id": 7,
                "text": "with a value that is equivalent to"
              }
            ],
            [
              {
                "annotation_ids": [
                  "9dceae423a85c9f7",
                  "a29b83544d75238c"
                ],
                "status_id": 7,
                "text": "the result [Encrypted DynamoDB Item](./encrypt-item.md#encrypted-dynamodb-item)"
              }
            ],
            [
              {
                "annotation_ids": [
                  "9dceae423a85c9f7",
                  "a29b83544d75238c"
                ],
                "status_id": 7,
                "text": "calculated above."
              }
            ]
          ],
          "requirements": [
            "d48f662a1837be65",
            "d48f662a1837be65",
            "22befbf93a63763b",
            "1479a6504caa055a",
            "99bfb3454672e008",
            "99bfb3454672e008",
            "99bfb3454672e008",
            "99bfb3454672e008",
            "3fcfeacff498c892",
            "3fcfeacff498c892",
            "3fcfeacff498c892",
            "3fcfeacff498c892",
            "3fcfeacff498c892",
            "3fcfeacff498c892",
            "56cf62f1fa2e435e",
            "56cf62f1fa2e435e",
            "56cf62f1fa2e435e",
            "56cf62f1fa2e435e",
            "56cf62f1fa2e435e",
            "56cf62f1fa2e435e",
            "5f580a0010dbb465",
            "5f580a0010dbb465",
            "5f580a0010dbb465",
            "5f580a0010dbb465",
            "5f580a0010dbb465",
            "d981319c2acdb060",
            "42745dcb9cf3588f",
            "42745dcb9cf3588f",
            "42745dcb9cf3588f",
            "a29b83544d75238c",
            "a29b83544d75238c",
            "a29b83544d75238c",
            "a29b83544d75238c"
          ],
          "title": "Encrypt before BatchWriteItem"
        },
        {
          "id": "encrypt-before-transactwriteitems",
          "lines": [
            "Before the [TransactWriteItems](https://docs.aws.amazon.com/amazondynamodb/latest/APIReference/API_TransactWriteItems.html)",
            "call is made to DynamoDB, for every entry under `TransactItems`:",
            "",
            [
              {
                "annotation_ids": [
                  "e6c424da71588038",
                  "0e56a6a8dce0bb1c"
                ],
                "status_id": 7,
                "text": "To protect against a possible fifth field being added to the TransactWriteItem structure in the future,"
              }
            ],
            [
              {
                "annotation_ids": [
                  "e6c424da71588038",
                  "0e56a6a8dce0bb1c"
                ],
                "status_id": 7,
                "text": "the client MUST fail if none of the `Update`, `ConditionCheck`, `Delete` and `Put` fields are set."
              }
            ],
            "",
            [
              {
                "annotation_ids": [
                  "8a98cc0c271ee068",
                  "af649b2a4954b332"
                ],
                "status_id": 7,
                "text": "Any actions other than `Put`, MUST be unchanged."
              }
            ],
            "",
            [
              {
                "annotation_ids": [
                  "311a125bc86abca5",
                  "11d8c0bfea68e0a0"
                ],
                "status_id": 7,
                "text": "Any `Put` actions with a `TableName` that does not refer to an [encrypted-table](#encrypted-table),"
              }
            ],
            [
              {
                "annotation_ids": [
                  "311a125bc86abca5",
                  "11d8c0bfea68e0a0"
                ],
                "status_id": 7,
                "text": "MUST be unchanged."
              }
            ],
            "",
            "If there is an `Update` that refers to a `TableName` that refers to an [encrypted-table](#encrypted-table)",
            "",
            [
              {
                "annotation_ids": [
                  "bbb1a9164ca77ece",
                  "10112a3d0c0b0e3a"
                ],
                "status_id": 7,
                "text": "- The UpdateExpression of the `Update` MUST be [valid](ddb-support.md#testupdateexpression)."
              }
            ],
            [
              {
                "annotation_ids": [
                  "97beab8bf764fa37",
                  "bf9e7233f36b1c1b"
                ],
                "status_id": 7,
                "text": "- The ConditionExpression of the `Update` MUST be [valid](ddb-support.md#testconditionexpression)."
              }
            ],
            "",
            "If there is a `ConditionCheck` that refers to a `TableName` that refers to an [encrypted-table](#encrypted-table)",
            "",
            [
              {
                "annotation_ids": [
                  "4633cd5f51184d12",
                  "e208ecd88affdab5"
                ],
                "status_id": 7,
                "text": "- The ConditionExpression of the `ConditionCheck` MUST be [valid](ddb-support.md#testconditionexpression)."
              }
            ],
            "",
            "If there is a `Delete` that refers to a `TableName` that refers to an [encrypted-table](#encrypted-table)",
            "",
            [
              {
                "annotation_ids": [
                  "6576aae9795345e6",
                  "91fadb6153cc4c43"
                ],
                "status_id": 7,
                "text": "- The ConditionExpression of the `Delete` MUST be [valid](ddb-support.md#testconditionexpression)."
              }
            ],
            "",
            "If there is a `Put` that refers to a `TableName` that refers to an [encrypted-table](#encrypted-table)",
            "",
            [
              {
                "annotation_ids": [
                  "ca987f26fcbf541f",
                  "74a1a628747f8881"
                ],
                "status_id": 7,
                "text": "- The Item MUST be [writable](ddb-support.md#writable)."
              }
            ],
            [
              {
                "annotation_ids": [
                  "6c1b81f96222ddbb",
                  "2f09dab0c22ba4f0"
                ],
                "status_id": 7,
                "text": "- The ConditionExpression `Put` MUST be [valid](ddb-support.md#testconditionexpression)."
              }
            ],
            [
              {
                "annotation_ids": [
                  "6ff6d0741ecd29db"
                ],
                "status_id": 8,
                "text": "- Signed Beacons MUST be [added](ddb-support.md#addsignedbeacons)."
              }
            ],
            [
              {
                "annotation_ids": [
                  "9e63aa0dde375a75"
                ],
                "status_id": 8,
                "text": "- If the [Beacon Key Source](../searchable-encryption/search-config.md#beacon-key-source)"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "  "
              },
              {
                "annotation_ids": [
                  "9e63aa0dde375a75"
                ],
                "status_id": 8,
                "text": "is a [Multi Key Store](../searchable-encryption/search-config.md#multi-key-store-initialization)"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "  "
              },
              {
                "annotation_ids": [
                  "9e63aa0dde375a75"
                ],
                "status_id": 8,
                "text": "the [Beacon Key Field Name](../searchable-encryption/search-config.md#beacon-key-field-name)"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "  "
              },
              {
                "annotation_ids": [
                  "9e63aa0dde375a75"
                ],
                "status_id": 8,
                "text": "MUST be [handled](./ddb-support.md#handlebeaconkeyfieldname)."
              }
            ],
            [
              {
                "annotation_ids": [
                  "6358f082f972dc65"
                ],
                "status_id": 8,
                "text": "- If the [Beacon Key Source](../searchable-encryption/search-config.md#beacon-key-source)"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "  "
              },
              {
                "annotation_ids": [
                  "6358f082f972dc65"
                ],
                "status_id": 8,
                "text": "is a [Multi Key Store](../searchable-encryption/search-config.md#multi-key-store-initialization)"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "  "
              },
              {
                "annotation_ids": [
                  "6358f082f972dc65"
                ],
                "status_id": 8,
                "text": "the [Item Encryptor](./ddb-item-encryptor.md) MUST perform"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "  "
              },
              {
                "annotation_ids": [
                  "6358f082f972dc65"
                ],
                "status_id": 8,
                "text": "[Encrypt Item](./encrypt-item.md),"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "  "
              },
              {
                "annotation_ids": [
                  "6358f082f972dc65"
                ],
                "status_id": 8,
                "text": "where the input [DynamoDB Item](./encrypt-item.md#dynamodb-item)"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "  "
              },
              {
                "annotation_ids": [
                  "6358f082f972dc65"
                ],
                "status_id": 8,
                "text": "is output of [handling the beacon key field name](ddb-support.md#handlebeaconkeyfieldname) operation."
              }
            ],
            [
              {
                "annotation_ids": [
                  "b18886521b9e943b"
                ],
                "status_id": 8,
                "text": "- If the [Beacon Key Source](../searchable-encryption/search-config.md#beacon-key-source)"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "  "
              },
              {
                "annotation_ids": [
                  "b18886521b9e943b"
                ],
                "status_id": 8,
                "text": "is a [Single Key Store](../searchable-encryption/search-config.md#single-key-store-initialization)"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "  "
              },
              {
                "annotation_ids": [
                  "b18886521b9e943b"
                ],
                "status_id": 8,
                "text": "the [Item Encryptor](./ddb-item-encryptor.md) MUST perform"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "  "
              },
              {
                "annotation_ids": [
                  "b18886521b9e943b"
                ],
                "status_id": 8,
                "text": "[Encrypt Item](./encrypt-item.md),"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "  "
              },
              {
                "annotation_ids": [
                  "b18886521b9e943b"
                ],
                "status_id": 8,
                "text": "where the input [DynamoDB Item](./encrypt-item.md#dynamodb-item)"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "  "
              },
              {
                "annotation_ids": [
                  "b18886521b9e943b"
                ],
                "status_id": 8,
                "text": "is output of [adding the signed beacons](ddb-support.md#addsignedbeacons) operation."
              }
            ],
            [
              {
                "annotation_ids": [
                  "6206df8f7262da5d"
                ],
                "status_id": 8,
                "text": "- If the [Beacon Key Source](../searchable-encryption/search-config.md#beacon-key-source)"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "  "
              },
              {
                "annotation_ids": [
                  "6206df8f7262da5d"
                ],
                "status_id": 8,
                "text": "is a [Multi Key Store](../searchable-encryption/search-config.md#multi-key-store-initialization)"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "  "
              },
              {
                "annotation_ids": [
                  "6206df8f7262da5d"
                ],
                "status_id": 8,
                "text": "and a `branch key id` was returned from [handling the beacon key field name](ddb-support.md#handlebeaconkeyfieldname)"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "  "
              },
              {
                "annotation_ids": [
                  "6206df8f7262da5d"
                ],
                "status_id": 8,
                "text": "this `branch key id` MUST match the value"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "  "
              },
              {
                "annotation_ids": [
                  "6206df8f7262da5d"
                ],
                "status_id": 8,
                "text": "returned from [Get beacon key id from Parsed Header](../searchable-encryption/search-config.md#get-beacon-key-id-from-parsed-header)."
              }
            ],
            [
              {
                "annotation_ids": [
                  "8123f821aa898cde"
                ],
                "status_id": 8,
                "text": "- Encrypted Beacons MUST be [added](ddb-support.md#addencryptedbeacons)."
              }
            ],
            [
              {
                "annotation_ids": [
                  "b057ed326dd20f67"
                ],
                "status_id": 8,
                "text": "- If any of the above fails,"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "  "
              },
              {
                "annotation_ids": [
                  "b057ed326dd20f67"
                ],
                "status_id": 8,
                "text": "the client MUST NOT make a network call to DynamoDB,"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "  "
              },
              {
                "annotation_ids": [
                  "b057ed326dd20f67"
                ],
                "status_id": 8,
                "text": "and PutItem MUST yield an error."
              }
            ],
            [
              {
                "annotation_ids": [
                  "8dce7da3b7a8e278",
                  "78067de762451676"
                ],
                "status_id": 7,
                "text": "- The PutItem request's `Item` field MUST be replaced"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "  "
              },
              {
                "annotation_ids": [
                  "8dce7da3b7a8e278",
                  "78067de762451676"
                ],
                "status_id": 7,
                "text": "with a value that is equivalent to"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "  "
              },
              {
                "annotation_ids": [
                  "8dce7da3b7a8e278",
                  "78067de762451676"
                ],
                "status_id": 7,
                "text": "the result [Encrypted DynamoDB Item](./encrypt-item.md#encrypted-dynamodb-item)"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "  "
              },
              {
                "annotation_ids": [
                  "8dce7da3b7a8e278",
                  "78067de762451676"
                ],
                "status_id": 7,
                "text": "calculated above."
              }
            ]
          ],
          "requirements": [
            "0e56a6a8dce0bb1c",
            "0e56a6a8dce0bb1c",
            "af649b2a4954b332",
            "11d8c0bfea68e0a0",
            "11d8c0bfea68e0a0",
