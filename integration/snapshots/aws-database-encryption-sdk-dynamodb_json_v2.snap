    },
    {
      "comment": "This structure MUST contain the following values,\nrepresenting the deserialized form of the header of the input encrypted structure:\n",
      "id": "7921a22fed1e433c",
      "level": "Must",
      "line": 17,
      "quote": "This structure MUST contain the following values, representing the deserialized form of the header of the input encrypted structure:",
