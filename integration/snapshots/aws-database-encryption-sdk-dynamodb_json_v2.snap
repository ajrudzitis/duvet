      "target_path": "specification/structured-encryption/decrypt-path-structure.md",
      "target_section": "behavior",
      "type": "SPEC"
    },
    {
      "comment": "If any of these steps fails, this operation MUST halt and indicate a failure to the caller.\n",
      "id": "4c7b1fb700dc810c",
