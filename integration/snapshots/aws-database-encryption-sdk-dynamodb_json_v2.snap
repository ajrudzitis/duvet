      "id": "2c80890038f636e8",
      "level": "Auto",
      "line": 1003,
      "quote": "The output MUST also include a [Parsed Header](#parsed-header) that contains data that was serialized into the header included in the output DynamoDb Item.",
      "source": "DynamoDbEncryption/dafny/DynamoDbItemEncryptor/src/AwsCryptographyDbEncryptionSdkDynamoDbItemEncryptorOperations.dfy",
      "target_path": "specification/dynamodb-encryption-client/decrypt-item.md",
