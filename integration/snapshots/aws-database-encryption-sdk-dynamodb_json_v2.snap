    {
      "id": "c0e0b461806f37d3",
      "level": "Auto",
      "line": 71,
      "quote": "- Each Attribute MUST be deserializable according to [the serialization scheme](./ddb-attribute-serialization.md#value).",
      "source": "DynamoDbEncryption/dafny/DynamoDbEncryption/src/DynamoToStruct.dfy",
