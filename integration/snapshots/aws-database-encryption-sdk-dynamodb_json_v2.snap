    {
      "id": "39758a372cc637dc",
      "level": "Auto",
      "line": 71,
      "quote": "If not specified, encryption and decryption MUST behave according to `FORBID_PLAINTEXT_WRITE_FORBID_PLAINTEXT_READ`.",
      "source": "DynamoDbEncryption/dafny/DynamoDbItemEncryptor/src/Index.dfy",
