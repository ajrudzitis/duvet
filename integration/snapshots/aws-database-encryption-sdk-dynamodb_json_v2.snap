      "target_path": "specification/structured-encryption/header.md",
      "target_section": "commit-key",
      "type": "SPEC"
    },
    {
      "comment": "The Header Commitment MUST be calculated as a the first 32 bytes of an HmacSha384,\nwith the serialized partial header as the message, and the Commit Key as the key.\n",
      "id": "0dd06662921141fe",
      "level": "Must",
      "line": 20,
      "quote": "The Header Commitment MUST be calculated as a the first 32 bytes of an HmacSha384, with the serialized partial header as the message, and the Commit Key as the key.",
