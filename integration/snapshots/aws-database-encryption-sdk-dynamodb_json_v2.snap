      "target_path": "specification/dynamodb-encryption-client/decrypt-item.md",
      "target_section": "behavior",
      "type": "SPEC"
    },
    {
      "comment": "An item MUST be determined to be encrypted under the legacy format if it contains\nattributes for the material description and the signature.\n",
      "id": "c1a6b663de7c5b65",
      "level": "Must",
      "line": 10,
      "quote": "An item MUST be determined to be encrypted under the legacy format if it contains attributes for the material description and the signature.",
      "source": "compliance/specification/dynamodb-encryption-client/decrypt-item/determining-legacy-items.toml",
      "target_path": "specification/dynamodb-encryption-client/decrypt-item.md",
      "target_section": "determining-legacy-items",
      "type": "SPEC"
    },
    {
      "comment": "An item MUST be determined to be plaintext if it does not contain\nattributes with the names \"aws_dbe_head\" and \"aws_dbe_foot\".\n",
      "id": "3933c53070e82585",
      "level": "Must",
      "line": 12,
      "quote": "An item MUST be determined to be plaintext if it does not contain attributes with the names \"aws_dbe_head\" and \"aws_dbe_foot\".",
      "source": "compliance/specification/dynamodb-encryption-client/decrypt-item/determining-plaintext-items.toml",
