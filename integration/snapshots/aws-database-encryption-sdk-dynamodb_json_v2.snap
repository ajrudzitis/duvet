      "target_section": "determining-plaintext-items",
      "type": "SPEC"
    },
    {
      "comment": "The item to be encrypted MUST have an attribute named `aws_dbe_head`.\n",
      "id": "0ece7cb32f374d9f",
      "level": "Must",
      "line": 17,
      "quote": "The item to be encrypted MUST have an attribute named `aws_dbe_head`.",
