      "target_section": "retrieve-encryption-materials",
      "type": "SPEC"
    },
    {
      "comment": "- Max Plaintext Length: This field MUST be the result of the calculation `encryptedTerminalDataNum * 2 + totalEncryptedTerminalValuesSize`\n",
      "id": "2dbe9054d2de3779",
