    {
      "id": "5c07ee0103611016",
      "level": "Auto",
      "line": 397,
      "quote": "If any of the [Attribute Actions](#attribute-actions) are configured as [SIGN_AND_INCLUDE_IN_ENCRYPTION_CONTEXT](../structured-encryption/structures.md#contextandsign) then the configuration version MUST be 2; otherwise, the configuration version MUST be 1.",
      "source": "DynamoDbEncryption/dafny/DynamoDbItemEncryptor/src/AwsCryptographyDbEncryptionSdkDynamoDbItemEncryptorOperations.dfy",
