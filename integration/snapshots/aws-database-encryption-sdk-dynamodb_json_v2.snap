      "type": "IMPLICATION"
    },
    {
      "id": "2af4447bd52862b2",
      "level": "Auto",
      "line": 228,
      "quote": "String MUST be serialized as UTF-8 encoded bytes.",
      "source": "DynamoDbEncryption/dafny/DynamoDbEncryption/src/DynamoToStruct.dfy",
      "target_path": "specification/dynamodb-encryption-client/ddb-attribute-serialization.md",
