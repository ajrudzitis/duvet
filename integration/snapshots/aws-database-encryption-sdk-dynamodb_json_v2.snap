      "target_section": "decrypt-after-updateitem",
      "type": "SPEC"
    },
    {
      "comment": "The DynamoDB Encryption Client Configuration is a structure that\nthe customer MUST provide in the process of creating a [DynamoDB Encryption Client](#dynamodb-encryption-client).\n",
      "id": "191b79ea628a04e3",
      "level": "Must",
