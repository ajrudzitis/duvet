      "target_section": "construct-decrypted-structured-data",
      "type": "SPEC"
    },
    {
      "comment": "The output MUST also include a [Parsed Header](#parsed-header) that contains\ndata that was serialized into the header included in the output Structured Data.\n",
      "id": "1adee74832edfa4b",
      "level": "Must",
      "line": 63,
      "quote": "The output MUST also include a [Parsed Header](#parsed-header) that contains data that was serialized into the header included in the output Structured Data.",
