      "type": "SPEC"
    },
    {
      "comment": "If the Version Number is 2, then the base context MUST be the [version 2](./encrypt-item.md#dynamodb-item-base-context-version-2) context.\n",
      "id": "08e839a0a245dc34",
      "level": "Must",
