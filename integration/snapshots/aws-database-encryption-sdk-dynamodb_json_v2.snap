      "target_section": "encrypt-before-putitem",
      "type": "SPEC"
    },
    {
      "comment": "To protect against a possible fifth field being added to the TransactWriteItem structure in the future,\nthe client MUST fail if none of the `Update`, `ConditionCheck`, `Delete` and `Put` fields are set.\n",
      "id": "0e56a6a8dce0bb1c",
