            "8b574deeb4d0a404",
            "8b574deeb4d0a404",
            "bbcbba70148e82a0"
          ],
          "title": "Decrypt after Scan"
        },
        {
          "id": "decrypt-after-query",
          "lines": [
            "After a [Query](https://docs.aws.amazon.com/amazondynamodb/latest/APIReference/API_Query.html)",
            "call is made to DynamoDB :",
            "",
            [
              {
                "annotation_ids": [
                  "0f5e1a3d7e9d9861"
                ],
                "status_id": 8,
                "text": "For each list entry in `Items` in the response,"
              }
            ],
            [
              {
                "annotation_ids": [
                  "0f5e1a3d7e9d9861"
                ],
                "status_id": 8,
                "text": "if there exists an Item Encryptor specified within the"
              }
            ],
            [
              {
                "annotation_ids": [
                  "0f5e1a3d7e9d9861"
                ],
                "status_id": 8,
                "text": "[DynamoDB Encryption Client Config](#dynamodb-encryption-client-configuration)"
              }
            ],
            [
              {
                "annotation_ids": [
                  "0f5e1a3d7e9d9861"
                ],
                "status_id": 8,
                "text": "with a [DynamoDB Table Name](./ddb-item-encryptor.md#dynamodb-table-name)"
              }
            ],
            [
              {
                "annotation_ids": [
                  "0f5e1a3d7e9d9861"
                ],
                "status_id": 8,
                "text": "equal to the `TableName` on the request,"
              }
            ],
            [
              {
                "annotation_ids": [
                  "0f5e1a3d7e9d9861"
                ],
                "status_id": 8,
                "text": "the corresponding Item Encryptor MUST perform [Decrypt Item](./decrypt-item.md)"
              }
            ],
            [
              {
                "annotation_ids": [
                  "0f5e1a3d7e9d9861"
                ],
                "status_id": 8,
                "text": "where the input [DynamoDB Item](./decrypt-item.md#dynamodb-item)"
              }
            ],
            [
              {
                "annotation_ids": [
                  "0f5e1a3d7e9d9861"
                ],
                "status_id": 8,
                "text": "is this list entry."
              }
            ],
            "",
            [
              {
                "annotation_ids": [
                  "bfed9bd56524e137",
                  "f977202e845257b7"
                ],
                "status_id": 7,
                "text": "Each of these entries on the original response MUST be replaced"
              }
            ],
            [
              {
                "annotation_ids": [
                  "bfed9bd56524e137",
                  "f977202e845257b7"
                ],
                "status_id": 7,
                "text": "with the resulting decrypted [DynamoDB Item](./decrypt-item.md#dynamodb-item-1)."
              }
            ],
            "",
            [
              {
                "annotation_ids": [
                  "bc8c3e86dfb3082b"
                ],
                "status_id": 8,
                "text": "If any [Decrypt Item](./decrypt-item.md) fails,"
              }
            ],
            [
              {
                "annotation_ids": [
                  "bc8c3e86dfb3082b"
                ],
                "status_id": 8,
                "text": "Query MUST yield an error."
              }
            ],
            "",
            [
              {
                "annotation_ids": [
                  "9796b2bfe13a9f79",
                  "27f80c3a63cd63fb"
                ],
                "status_id": 7,
                "text": "The resulting decrypted response MUST be [filtered](ddb-support.md#queryoutputforbeacons) from the result."
              }
            ]
          ],
          "requirements": [
            "0f5e1a3d7e9d9861",
            "0f5e1a3d7e9d9861",
            "0f5e1a3d7e9d9861",
            "0f5e1a3d7e9d9861",
            "0f5e1a3d7e9d9861",
            "0f5e1a3d7e9d9861",
            "0f5e1a3d7e9d9861",
            "0f5e1a3d7e9d9861",
            "f977202e845257b7",
            "f977202e845257b7",
            "bc8c3e86dfb3082b",
            "bc8c3e86dfb3082b",
            "27f80c3a63cd63fb"
          ],
          "title": "Decrypt after Query"
        },
        {
          "id": "decrypt-after-transactgetitems",
          "lines": [
            "After a [TransactGetItems](https://docs.aws.amazon.com/amazondynamodb/latest/APIReference/API_TransactGetItems.html)",
            "call is made to DynamoDB :",
            "",
            [
              {
                "annotation_ids": [
                  "4804ffb2a9d20bce",
                  "22afa0002a505503"
                ],
                "status_id": 7,
                "text": "For each list item under each key in `Responses`,"
              }
            ],
            [
              {
                "annotation_ids": [
                  "4804ffb2a9d20bce",
                  "22afa0002a505503"
                ],
                "status_id": 7,
                "text": "if there exists an Item Encryptor specified within"
              }
            ],
            [
              {
                "annotation_ids": [
                  "4804ffb2a9d20bce",
                  "22afa0002a505503"
                ],
                "status_id": 7,
                "text": "the [DynamoDB Encryption Client Config](#dynamodb-encryption-client-configuration)"
              }
            ],
            [
              {
                "annotation_ids": [
                  "4804ffb2a9d20bce",
                  "22afa0002a505503"
                ],
                "status_id": 7,
                "text": "with a [DynamoDB Table Name](./ddb-item-encryptor.md#dynamodb-table-name)"
              }
            ],
            [
              {
                "annotation_ids": [
                  "4804ffb2a9d20bce",
                  "22afa0002a505503"
                ],
                "status_id": 7,
                "text": "equal to the key,"
              }
            ],
            [
              {
                "annotation_ids": [
                  "4804ffb2a9d20bce",
                  "22afa0002a505503"
                ],
                "status_id": 7,
                "text": "the Item Encryptor that corresponds to the key in the request"
              }
            ],
            [
              {
                "annotation_ids": [
                  "4804ffb2a9d20bce",
                  "22afa0002a505503"
                ],
                "status_id": 7,
                "text": "MUST perform [Decrypt Item](./decrypt-item.md) where the input"
              }
            ],
            [
              {
                "annotation_ids": [
                  "4804ffb2a9d20bce",
                  "22afa0002a505503"
                ],
                "status_id": 7,
                "text": "[DynamoDB Item](./decrypt-item.md#dynamodb-item) is the `Item` in the original response."
              }
            ],
            "",
            [
              {
                "annotation_ids": [
                  "cfb958ae25b09c18",
                  "063bafd5e3f395d1"
                ],
                "status_id": 7,
                "text": "Beacons MUST be [removed](ddb-support.md#removebeacons) from the result."
              }
            ],
            "",
            [
              {
                "annotation_ids": [
                  "ed82bc1ad9bb220c",
                  "437fb08ef9c5b89e"
                ],
                "status_id": 7,
                "text": "Each of these items on the original response MUST be replaced"
              }
            ],
            [
              {
                "annotation_ids": [
                  "ed82bc1ad9bb220c",
                  "437fb08ef9c5b89e"
                ],
                "status_id": 7,
                "text": "with a value that is equivalent to the resulting item."
              }
            ],
            "",
            [
              {
                "annotation_ids": [
                  "48edc57e01cf117a",
                  "920814a579e3f014"
                ],
                "status_id": 7,
                "text": "If any [Decrypt Item](./decrypt-item.md) fails,"
              }
            ],
            [
              {
                "annotation_ids": [
                  "48edc57e01cf117a",
                  "920814a579e3f014"
                ],
                "status_id": 7,
                "text": "TransactGetItems MUST yield an error."
              }
            ]
          ],
          "requirements": [
            "22afa0002a505503",
            "22afa0002a505503",
            "22afa0002a505503",
            "22afa0002a505503",
            "22afa0002a505503",
            "22afa0002a505503",
            "22afa0002a505503",
            "22afa0002a505503",
            "063bafd5e3f395d1",
            "437fb08ef9c5b89e",
            "437fb08ef9c5b89e",
            "920814a579e3f014",
            "920814a579e3f014"
          ],
          "title": "Decrypt after TransactGetItems"
        },
        {
          "id": "validate-before-updateitem",
          "lines": [
            "Before an [UpdateItem](https://docs.aws.amazon.com/amazondynamodb/latest/APIReference/API_UpdateItem.html)",
            "call is made to DynamoDB,",
            "",
            [
              {
                "annotation_ids": [
                  "a65a12b8d739dba9",
                  "c42d269883c1b60c"
                ],
                "status_id": 1,
                "text": "If the `TableName` in the request does not refer to an [encrypted-table](#encrypted-table),"
              }
            ],
            [
              {
                "annotation_ids": [
                  "a65a12b8d739dba9",
                  "c42d269883c1b60c"
                ],
                "status_id": 1,
                "text": "the UpdateItem request MUST be unchanged."
              }
            ],
            "",
            "Otherwise,",
            "",
            [
              {
                "annotation_ids": [
                  "16597af84565fec9",
                  "71127a72c9ee5cc1"
                ],
                "status_id": 1,
                "text": "The UpdateItem request MUST NOT refer to any legacy parameters,"
              }
            ],
            [
              {
                "annotation_ids": [
                  "16597af84565fec9",
                  "71127a72c9ee5cc1"
                ],
                "status_id": 1,
                "text": "specifically Expected, AttributeUpdates and ConditionalOperator MUST NOT be set."
              }
            ],
            "",
            [
              {
                "annotation_ids": [
                  "701ae110544f27f9",
                  "80e9ad44472846e5"
                ],
                "status_id": 1,
                "text": "The UpdateExpression MUST be [valid](ddb-support.md#testupdateexpression)."
              }
            ],
            "",
            [
              {
                "annotation_ids": [
                  "1acadc4070610df1",
                  "9f579bb215fa9c5a"
                ],
                "status_id": 1,
                "text": "If all of the above validation succeeds, the UpdateItem request MUST be unchanged."
              }
            ]
          ],
          "requirements": [
            "c42d269883c1b60c",
            "c42d269883c1b60c",
            "71127a72c9ee5cc1",
            "71127a72c9ee5cc1",
            "80e9ad44472846e5",
            "9f579bb215fa9c5a"
          ],
          "title": "Validate Before UpdateItem"
        },
        {
          "id": "validate-before-deleteitem",
          "lines": [
            "Before a [DeleteItem](https://docs.aws.amazon.com/amazondynamodb/latest/APIReference/API_DeleteItem.html)",
            "call is made to DynamoDB,",
            "",
            [
              {
                "annotation_ids": [
                  "3c0309c74f4c5d94",
                  "ec2d0604592eff16"
                ],
                "status_id": 1,
                "text": "If the `TableName` in the request does not refer to an [encrypted-table](#encrypted-table),"
              }
            ],
            [
              {
                "annotation_ids": [
                  "3c0309c74f4c5d94",
                  "ec2d0604592eff16"
                ],
                "status_id": 1,
                "text": "the DeleteItem request MUST be unchanged."
              }
            ],
            "",
            "Otherwise,",
            "",
            [
              {
                "annotation_ids": [
                  "1a8688aacfde5ee9",
                  "bbd30be7c12ae4cf"
                ],
                "status_id": 1,
                "text": "The DeleteItem request MUST NOT refer to any legacy parameters,"
              }
            ],
            [
              {
                "annotation_ids": [
                  "1a8688aacfde5ee9",
                  "bbd30be7c12ae4cf"
                ],
                "status_id": 1,
                "text": "specifically Expected and ConditionalOperator MUST NOT be set."
              }
            ],
            "",
            [
              {
                "annotation_ids": [
                  "66c04459fe3a084b",
                  "11fdabc22a7a70df"
                ],
                "status_id": 1,
                "text": "The ConditionExpression MUST be [valid](ddb-support.md#testconditionexpression)."
              }
            ],
            "",
            [
              {
                "annotation_ids": [
                  "ab2e43699a18d103",
                  "d7e7d3725f2b3920"
                ],
                "status_id": 1,
                "text": "If all of the above validation succeeds, the DeleteItem request MUST be unchanged."
              }
            ]
          ],
          "requirements": [
            "ec2d0604592eff16",
            "ec2d0604592eff16",
            "bbd30be7c12ae4cf",
            "bbd30be7c12ae4cf",
            "11fdabc22a7a70df",
            "d7e7d3725f2b3920"
          ],
          "title": "Validate Before DeleteItem"
        },
        {
          "id": "validate-before-executestatement",
          "lines": [
            "Before an [ExecuteStatement](https://docs.aws.amazon.com/amazondynamodb/latest/APIReference/ExecuteStatement.html)",
            "call is made to DynamoDB :",
            "",
            [
              {
                "annotation_ids": [
                  "8d1ae3ba187cae04",
                  "6a2e6ae0c00cec59"
                ],
                "status_id": 1,
                "text": "The request MUST fail, and the client make no network call to DynamoDB,"
              }
            ],
            [
              {
                "annotation_ids": [
                  "8d1ae3ba187cae04",
                  "6a2e6ae0c00cec59"
                ],
                "status_id": 1,
                "text": "if there exists an Item Encryptor"
              }
            ],
            [
              {
                "annotation_ids": [
                  "8d1ae3ba187cae04",
                  "6a2e6ae0c00cec59"
                ],
                "status_id": 1,
                "text": "specified within the [DynamoDB Encryption Client Config](#dynamodb-encryption-client-configuration)"
              }
            ],
            [
              {
                "annotation_ids": [
                  "8d1ae3ba187cae04",
                  "6a2e6ae0c00cec59"
                ],
                "status_id": 1,
                "text": "with a [DynamoDB Table Name](./ddb-item-encryptor.md#dynamodb-table-name)"
              }
            ],
            [
              {
                "annotation_ids": [
                  "8d1ae3ba187cae04",
                  "6a2e6ae0c00cec59"
                ],
                "status_id": 1,
                "text": "equal to table named in the request."
              }
            ],
            "",
            [
              {
                "annotation_ids": [
                  "00e1026b4431afa1",
                  "d65b6c86c4b33116"
                ],
                "status_id": 1,
                "text": "If no such Item Encryptor exists,"
              }
            ],
            [
              {
                "annotation_ids": [
                  "00e1026b4431afa1",
                  "d65b6c86c4b33116"
                ],
                "status_id": 1,
                "text": "there MUST NOT be any modification"
              }
            ],
            [
              {
                "annotation_ids": [
                  "00e1026b4431afa1",
                  "d65b6c86c4b33116"
                ],
                "status_id": 1,
                "text": "to the ExecuteStatement request."
              }
            ]
          ],
          "requirements": [
            "6a2e6ae0c00cec59",
            "6a2e6ae0c00cec59",
            "6a2e6ae0c00cec59",
            "6a2e6ae0c00cec59",
            "6a2e6ae0c00cec59",
            "d65b6c86c4b33116",
            "d65b6c86c4b33116",
            "d65b6c86c4b33116"
          ],
          "title": "Validate Before ExecuteStatement"
        },
        {
          "id": "validate-before-batchexecutestatement",
          "lines": [
            "Before an [BatchExecuteStatement](https://docs.aws.amazon.com/amazondynamodb/latest/APIReference/BatchExecuteStatement.html)",
            "call is made to DynamoDB :",
            "",
            [
              {
                "annotation_ids": [
                  "bb4a7f144e5050cf",
                  "c162153563f544c1"
                ],
                "status_id": 1,
                "text": "The request MUST fail, and the client make no network call to DynamoDB,"
              }
            ],
            [
              {
                "annotation_ids": [
                  "bb4a7f144e5050cf",
                  "c162153563f544c1"
                ],
                "status_id": 1,
                "text": "if there exists an Item Encryptor"
              }
            ],
            [
              {
                "annotation_ids": [
                  "bb4a7f144e5050cf",
                  "c162153563f544c1"
                ],
                "status_id": 1,
                "text": "specified within the [DynamoDB Encryption Client Config](#dynamodb-encryption-client-configuration)"
              }
            ],
            [
              {
                "annotation_ids": [
                  "bb4a7f144e5050cf",
                  "c162153563f544c1"
                ],
                "status_id": 1,
                "text": "with a [DynamoDB Table Name](./ddb-item-encryptor.md#dynamodb-table-name)"
              }
            ],
            [
              {
                "annotation_ids": [
                  "bb4a7f144e5050cf",
                  "c162153563f544c1"
                ],
                "status_id": 1,
                "text": "equal to table named in any of the `Statements` of the request."
              }
            ],
            "",
            [
              {
                "annotation_ids": [
                  "182e0eadee2e08cd",
                  "57d03c8404d8ca7e"
                ],
                "status_id": 1,
                "text": "If no such Item Encryptor exists,"
              }
            ],
            [
              {
                "annotation_ids": [
                  "182e0eadee2e08cd",
                  "57d03c8404d8ca7e"
                ],
                "status_id": 1,
                "text": "there MUST NOT be any modification"
              }
            ],
            [
              {
                "annotation_ids": [
                  "182e0eadee2e08cd",
                  "57d03c8404d8ca7e"
                ],
                "status_id": 1,
                "text": "to the BatchExecuteStatement request."
              }
            ]
          ],
          "requirements": [
            "c162153563f544c1",
            "c162153563f544c1",
            "c162153563f544c1",
            "c162153563f544c1",
            "c162153563f544c1",
            "57d03c8404d8ca7e",
            "57d03c8404d8ca7e",
            "57d03c8404d8ca7e"
          ],
          "title": "Validate Before BatchExecuteStatement"
        },
        {
          "id": "validate-before-executetransaction",
          "lines": [
            "Before an [ExecuteTransaction](https://docs.aws.amazon.com/amazondynamodb/latest/APIReference/BatchExecuteStatement.html)",
            "call is made to DynamoDB :",
            "",
            [
              {
                "annotation_ids": [
                  "d7f2b1869a313f55",
                  "727453ed2eb959f4"
                ],
                "status_id": 1,
                "text": "The request MUST fail, and the client make no network call to DynamoDB,"
              }
            ],
            [
              {
                "annotation_ids": [
                  "d7f2b1869a313f55",
                  "727453ed2eb959f4"
                ],
                "status_id": 1,
                "text": "if there exists an Item Encryptor"
              }
            ],
            [
              {
                "annotation_ids": [
                  "d7f2b1869a313f55",
                  "727453ed2eb959f4"
                ],
                "status_id": 1,
                "text": "specified within the [DynamoDB Encryption Client Config](#dynamodb-encryption-client-configuration)"
              }
            ],
            [
              {
                "annotation_ids": [
                  "d7f2b1869a313f55",
                  "727453ed2eb959f4"
                ],
                "status_id": 1,
                "text": "with a [DynamoDB Table Name](./ddb-item-encryptor.md#dynamodb-table-name)"
              }
            ],
            [
              {
                "annotation_ids": [
                  "d7f2b1869a313f55",
                  "727453ed2eb959f4"
                ],
                "status_id": 1,
                "text": "equal to table named in any of the `TransactStatements` of the request."
              }
            ],
            "",
            [
              {
                "annotation_ids": [
                  "af60ad09132aa77a",
                  "ce4bcab0c29e135b"
                ],
                "status_id": 1,
                "text": "If no such Item Encryptor exists,"
              }
            ],
            [
              {
                "annotation_ids": [
                  "af60ad09132aa77a",
                  "ce4bcab0c29e135b"
                ],
                "status_id": 1,
                "text": "there MUST NOT be any modification"
              }
            ],
            [
              {
                "annotation_ids": [
                  "af60ad09132aa77a",
                  "ce4bcab0c29e135b"
                ],
                "status_id": 1,
                "text": "to the ExecuteTransaction request."
              }
            ]
          ],
          "requirements": [
            "727453ed2eb959f4",
            "727453ed2eb959f4",
            "727453ed2eb959f4",
            "727453ed2eb959f4",
            "727453ed2eb959f4",
