            "ce4bcab0c29e135b",
            "ce4bcab0c29e135b"
          ],
          "title": "Validate Before ExecuteTransaction"
        },
        {
          "id": "modify-before-scan",
          "lines": [
            "Before the [Scan](https://docs.aws.amazon.com/amazondynamodb/latest/APIReference/API_Scan.html)",
            "call is made to DynamoDB :",
            "",
            [
              {
                "annotation_ids": [
                  "322565d274db2cbf",
                  "9c18c5c7fa93f227"
                ],
                "status_id": 1,
                "text": "If the `TableName` in the request does not refer to an [encrypted-table](#encrypted-table),"
              }
            ],
            [
              {
                "annotation_ids": [
                  "322565d274db2cbf",
                  "9c18c5c7fa93f227"
                ],
                "status_id": 1,
                "text": "the Scan request MUST be unchanged."
              }
            ],
            "",
            "Otherwise",
            "",
            [
              {
                "annotation_ids": [
                  "8b047d7a87672ce7",
                  "5226c06f9612863d"
                ],
                "status_id": 1,
                "text": "The Scan request MUST NOT refer to any legacy parameters,"
              }
            ],
            [
              {
                "annotation_ids": [
                  "8b047d7a87672ce7",
                  "5226c06f9612863d"
                ],
                "status_id": 1,
                "text": "specifically AttributesToGet, ScanFilter and ConditionalOperator MUST NOT be set."
              }
            ],
            "",
            [
              {
                "annotation_ids": [
                  "8f290a0b5f1d7613"
                ],
                "status_id": 8,
                "text": "The request MUST be [altered](./ddb-support.md#scaninputforbeacons)"
              }
            ],
            [
              {
                "annotation_ids": [
                  "8f290a0b5f1d7613"
                ],
                "status_id": 8,
                "text": "to transform any references to encrypted attributes into references to beacons."
              }
            ]
          ],
          "requirements": [
            "9c18c5c7fa93f227",
            "9c18c5c7fa93f227",
            "5226c06f9612863d",
            "5226c06f9612863d",
            "8f290a0b5f1d7613",
            "8f290a0b5f1d7613"
          ],
          "title": "Modify before Scan"
        },
        {
          "id": "modify-before-query",
          "lines": [
            "Before the [Query](https://docs.aws.amazon.com/amazondynamodb/latest/APIReference/API_Query.html)",
            "call is made to DynamoDB :",
            "",
            [
              {
                "annotation_ids": [
                  "408e31ca2f2c2c1a",
                  "85f38312857fe956"
                ],
                "status_id": 1,
                "text": "If the `TableName` in the request does not refer to an [encrypted-table](#encrypted-table),"
              }
            ],
            [
              {
                "annotation_ids": [
                  "408e31ca2f2c2c1a",
                  "85f38312857fe956"
                ],
                "status_id": 1,
                "text": "the Query request MUST be unchanged."
              }
            ],
            "",
            "Otherwise",
            "",
            [
              {
                "annotation_ids": [
                  "d7a994cf7ce6d430",
                  "06aac64091c708cc"
                ],
                "status_id": 1,
                "text": "The Query request MUST NOT refer to any legacy parameters,"
              }
            ],
            [
              {
                "annotation_ids": [
                  "d7a994cf7ce6d430",
                  "06aac64091c708cc"
                ],
                "status_id": 1,
                "text": "specifically AttributesToGet, KeyConditions, QueryFilter and ConditionalOperator MUST NOT be set."
              }
            ],
            "",
            [
              {
                "annotation_ids": [
                  "5eb725f51191d536"
                ],
                "status_id": 8,
                "text": "The request MUST be [altered](./ddb-support.md#queryinputforbeacons)"
              }
            ],
            [
              {
                "annotation_ids": [
                  "5eb725f51191d536"
                ],
                "status_id": 8,
                "text": "to transform any references to encrypted attributes into references to beacons."
              }
            ]
          ],
          "requirements": [
            "85f38312857fe956",
            "85f38312857fe956",
            "06aac64091c708cc",
            "06aac64091c708cc",
            "5eb725f51191d536",
            "5eb725f51191d536"
          ],
          "title": "Modify before Query"
        },
        {
          "id": "allowed-passthrough-dynamodb-apis",
          "lines": [
            "- CreateBackup",
            "- CreateGlobalTable",
            "- CreateTable",
            "- DeleteBackup",
            "- DeleteTable",
            "- DescribeBackup",
            "- DescribeContinuousBackups",
            "- DescribeContributorInsights",
            "- DescribeEndpoints",
            "- DescribeExport",
            "- DescribeGlobalTable",
            "- DescribeGlobalTableSettings",
            "- DescribeImport",
            "- DescribeKinesisStreamingDestination",
            "- DescribeLimits",
            "- DescribeTable",
            "- DescribeTableReplicaAutoScaling",
            "- DescribeTimeToLive",
            "- DisableKinesisStreamingDestination",
            "- EnableKinesisStreamingDestination",
            "- ExportTableToPointInTime",
            "- ImportTable",
            "- ListBackups",
            "- ListContributorInsights",
            "- ListExports",
            "- ListGlobalTables",
            "- ListImports",
            "- ListTables",
            "- ListTagsOfResource",
            "- RestoreTableFromBackup",
            "- RestoreTableToPointInTime",
            "- TagResource",
            "- UntagResource",
            "- UpdateContinuousBackups",
            "- UpdateContributorInsights",
            "- UpdateGlobalTable",
            "- UpdateGlobalTableSettings",
            "- UpdateTable",
            "- UpdateTableReplicaAutoScaling",
            "- UpdateTimeToLive"
          ],
          "title": "Allowed Passthrough DynamoDB APIs"
        }
      ],
      "title": "DynamoDB SDK Integration"
    },
    "specification/dynamodb-encryption-client/ddb-support.md": {
      "format": "markdown",
      "sections": [
        {
          "id": "dynamodb-support-layer",
          "lines": [
            "The DynamoDB Support Layer provides everything necessary to the middleware interceptors,",
            "with the exception of encryption and decryption.",
            "",
            "This document specifies the interface and high level semantics of these entry points.",
            "",
            "[DynamoDB SDK Integration](ddb-sdk-integration.md) should be specified in terms of",
            "these operations.",
            "",
            "There are two categories of support functions.",
            "",
            "The first category is for general support, used across multiple DynamoDB API transformations.",
            "",
            "- [Writable](#writable) - are the attributes in this item ok to write",
            "- [TestConditionExpression](#testconditionexpression) - Is this condition expression suitable for use",
            "- [TestUpdateExpression](#testupdateexpression) - Is this update expression suitable for use",
            "- [AddSignedBeacons](#addsignedbeacons) - Add non encrypted attributes to an item to enable searchable encryption",
            "- [GetEncryptedBeacons](#getencryptedbeacons) - Get new attributes for an item to enable searchable encryption",
            "- [RemoveBeacons](#removebeacons) - Remove all private attributes from an item,",
            "  e.g. the ones added in [AddSignedBeacons](#addsignedbeacons) and [GetEncryptedBeacons](#getencryptedbeacons)",
            "- [HandleBeaconKeyFieldName](#handlebeaconkeyfieldname) - Handle the beacon key field name for Multi Key Store configurations",
            "",
            "The second category is support for specific interceptors, where the whole input or output structure is modified.",
            "",
            "- [QueryInputForBeacons](#queryinputforbeacons)",
            "- [QueryOutputForBeacons](#queryoutputforbeacons)",
            "- [ScanInputForBeacons](#scaninputforbeacons)",
            "- [ScanOutputForBeacons](#scanoutputforbeacons)"
          ],
          "title": "DynamoDB Support Layer"
        },
        {
          "id": "writable",
          "lines": [
            [
              {
                "annotation_ids": [
                  "14b10f49ff9429f6",
                  "d3c172b530810eff"
                ],
                "status_id": 1,
                "text": "Writeable MUST reject any item containing an attribute which begins with `aws_dbe_`."
              }
            ],
            "",
            "One needn't worry about attributes with the same names as beacons or virtual fields,",
            "because elsewhere we make sure that the beacons do not overlap with configured fields,",
            "and so trying to write those fields will result in \"writing unconfigured field\" errors already."
          ],
          "requirements": [
            "d3c172b530810eff"
          ],
          "title": "Writable"
        },
        {
          "id": "testconditionexpression",
          "lines": [
            [
              {
                "annotation_ids": [
                  "40248a216c8096bd",
                  "68a8adfa763e265d"
                ],
                "status_id": 1,
                "text": "TestConditionExpression MUST fail if any operand in the condition expression is an encrypted attribute name."
              }
            ]
          ],
          "requirements": [
            "68a8adfa763e265d"
          ],
          "title": "TestConditionExpression"
        },
        {
          "id": "testupdateexpression",
          "lines": [
            [
              {
                "annotation_ids": [
                  "cb90bbd75548402b",
                  "c9fed55cd518c9ab"
                ],
                "status_id": 1,
                "text": "TestUpdateExpression MUST fail if any operand in the update expression is a signed attribute name."
              }
            ]
          ],
          "requirements": [
            "c9fed55cd518c9ab"
          ],
          "title": "TestUpdateExpression"
        },
        {
          "id": "addsignedbeacons",
          "lines": [
            "AddSignedBeacons examines an AttributeMap and modifies it to be appropriate for Searchable Encryption,",
            "returning a replacement AttributeMap.",
            "",
            [
              {
                "annotation_ids": [
                  "560bc1176664bfc5",
                  "e93b2e6cece46e85"
                ],
                "status_id": 7,
                "text": "AddSignedBeacons MUST only operate on [compound beacons](../searchable-encryption/beacons.md#compound-beacon)"
              }
            ],
            [
              {
                "annotation_ids": [
                  "560bc1176664bfc5",
                  "e93b2e6cece46e85"
                ],
                "status_id": 7,
                "text": "that do not have any [encrypted parts](../searchable-encryption/beacons.md#compound-beacon-initialization)."
              }
            ],
            "",
            [
              {
                "annotation_ids": [
                  "8439c70ff1a5b059",
                  "50d17b97f6252433"
                ],
                "status_id": 7,
                "text": "For every configured compound beacons which only contains non encrypted parts"
              }
            ],
            [
              {
                "annotation_ids": [
                  "8439c70ff1a5b059",
                  "50d17b97f6252433"
                ],
                "status_id": 7,
                "text": "that can be successfully built from the attributes in the input AttributeMap,"
              }
            ],
            [
              {
                "annotation_ids": [
                  "8439c70ff1a5b059",
                  "50d17b97f6252433"
                ],
                "status_id": 7,
                "text": "AddSignedBeacons MUST add an attribute named NAME,"
              }
            ],
            [
              {
                "annotation_ids": [
                  "8439c70ff1a5b059",
                  "50d17b97f6252433"
                ],
                "status_id": 7,
                "text": "where NAME is the name of the beacon."
              }
            ],
            [
              {
                "annotation_ids": [
                  "142c48d89484cb08",
                  "05863955fb60cf5f"
                ],
                "status_id": 7,
                "text": "The value of this attribute MUST be a string,"
              }
            ],
            [
              {
                "annotation_ids": [
                  "142c48d89484cb08",
                  "05863955fb60cf5f"
                ],
                "status_id": 7,
                "text": "and must have the value defined in [beacons](../searchable-encryption/beacons.md#beacon-value)."
              }
            ],
            "",
            [
              {
                "annotation_ids": [
                  "d8cf3891c2551257",
                  "7a2b82230db148ea"
                ],
                "status_id": 7,
                "text": "If the attribute NAME already exists,"
              }
            ],
            [
              {
                "annotation_ids": [
                  "d8cf3891c2551257",
                  "7a2b82230db148ea"
                ],
                "status_id": 7,
                "text": "if the constructed compound beacon does not match"
              }
            ],
            [
              {
                "annotation_ids": [
                  "d8cf3891c2551257",
                  "7a2b82230db148ea"
                ],
                "status_id": 7,
                "text": "the existing attribute value AddSignedBeacons MUST fail."
              }
            ],
            "",
            [
              {
                "annotation_ids": [
                  "48792fcd7f58ca6c",
                  "ff89d8c800fd3005"
                ],
                "status_id": 1,
                "text": "AddSignedBeacons MUST also add an attribute with name `aws_dbe_v_1` and whose value is a string containing a single space."
              }
            ],
            "",
            [
              {
                "annotation_ids": [
                  "44f0156a14400aa3",
                  "2ddec650114f085a"
                ],
                "status_id": 7,
                "text": "The result of AddSignedBeacons MUST be a super set of everything in the input AttributeMap."
              }
            ]
          ],
          "requirements": [
            "e93b2e6cece46e85",
            "e93b2e6cece46e85",
            "50d17b97f6252433",
            "50d17b97f6252433",
            "50d17b97f6252433",
            "50d17b97f6252433",
            "05863955fb60cf5f",
            "05863955fb60cf5f",
            "7a2b82230db148ea",
            "7a2b82230db148ea",
            "7a2b82230db148ea",
            "ff89d8c800fd3005",
            "2ddec650114f085a"
          ],
          "title": "AddSignedBeacons"
        },
        {
          "id": "getencryptedbeacons",
          "lines": [
            "GetEncryptedBeacons examines the [Encrypt Item Input](./encrypt-item.md#input)",
            "and [Encrypt Item Output](./encrypt-item.md#output).",
            "",
            [
              {
                "annotation_ids": [
                  "88a1ed99c2c873e0",
                  "b695ab20ce5ca02c"
                ],
                "status_id": 7,
                "text": "To obtain [Beacon Key Materials] GetEncryptedBeacons"
              }
            ],
            [
              {
                "annotation_ids": [
                  "88a1ed99c2c873e0",
                  "b695ab20ce5ca02c"
                ],
                "status_id": 7,
                "text": "MUST call [Get beacon key after encrypt](../searchable-encryption/search-config.md#get-beacon-key-after-encrypt)."
              }
            ],
            "",
            [
              {
                "annotation_ids": [
                  "fbae6f793b645235",
                  "88268efe292a7d62"
                ],
                "status_id": 7,
                "text": "GetEncryptedBeacons MUST NOT operate on [compound beacons](../searchable-encryption/beacons.md#compound-beacon)"
              }
            ],
            [
              {
                "annotation_ids": [
                  "fbae6f793b645235",
                  "88268efe292a7d62"
                ],
                "status_id": 7,
                "text": "that only have [signed parts](../searchable-encryption/beacons.md#compound-beacon-initialization)."
              }
            ],
            "",
            [
              {
                "annotation_ids": [
                  "e41580ed7af77318",
                  "2c898778aab3f7bd"
                ],
                "status_id": 7,
                "text": "For all other configured beacons"
              }
            ],
            [
              {
                "annotation_ids": [
                  "e41580ed7af77318",
                  "2c898778aab3f7bd"
                ],
                "status_id": 7,
                "text": "that can be successfully built from the attributes in the input AttributeMap,"
              }
            ],
            [
              {
                "annotation_ids": [
                  "e41580ed7af77318",
                  "2c898778aab3f7bd"
                ],
                "status_id": 7,
                "text": "GetEncryptedBeacons MUST add an attribute named aws_dbe_b_NAME,"
              }
            ],
            [
              {
                "annotation_ids": [
                  "e41580ed7af77318",
                  "2c898778aab3f7bd"
                ],
                "status_id": 7,
                "text": "where NAME is the name of the beacon."
              }
            ],
            [
              {
                "annotation_ids": [
                  "f7125663d006267a",
                  "fc7907bc84e35e1f"
                ],
                "status_id": 7,
                "text": "The value of this attribute MUST be a string,"
              }
            ],
            [
              {
                "annotation_ids": [
                  "f7125663d006267a",
                  "fc7907bc84e35e1f"
                ],
                "status_id": 7,
                "text": "and must have the value defined in [beacons](../searchable-encryption/beacons.md#beacon-value)"
              }
            ],
            "",
            [
              {
                "annotation_ids": [
                  "89a80aad0cc7fa3d",
                  "ffbbcf99185f28af"
                ],
                "status_id": 7,
                "text": "The result of GetEncryptedBeacons MUST NOT contain any keys"
              }
            ],
            [
              {
                "annotation_ids": [
                  "89a80aad0cc7fa3d",
                  "ffbbcf99185f28af"
                ],
                "status_id": 7,
                "text": "in the [Encrypt Item Output](./encrypt-item.md#output) AttributeMap."
              }
            ]
          ],
          "requirements": [
            "b695ab20ce5ca02c",
            "b695ab20ce5ca02c",
            "88268efe292a7d62",
            "88268efe292a7d62",
            "2c898778aab3f7bd",
            "2c898778aab3f7bd",
            "2c898778aab3f7bd",
            "2c898778aab3f7bd",
            "fc7907bc84e35e1f",
            "fc7907bc84e35e1f",
            "ffbbcf99185f28af",
            "ffbbcf99185f28af"
          ],
          "title": "GetEncryptedBeacons"
        },
        {
          "id": "removebeacons",
          "lines": [
            "RemoveBeacons examines an AttributeMap and modifies it to be appropriate for customer use,",
            "returning a replacement AttributeMap.",
            "",
            [
              {
                "annotation_ids": [
                  "bffc79caf7e4b313",
                  "a19214f171cb9f0c"
                ],
                "status_id": 1,
                "text": "RemoveBeacons MUST remove any attributes whose name begins with `aws_dbe_`,"
              }
            ],
            [
              {
                "annotation_ids": [
                  "bffc79caf7e4b313",
                  "a19214f171cb9f0c"
                ],
                "status_id": 1,
                "text": "and leave all other attributes unchanged."
              }
            ]
          ],
          "requirements": [
            "a19214f171cb9f0c",
            "a19214f171cb9f0c"
          ],
          "title": "RemoveBeacons"
        },
        {
          "id": "handlebeaconkeyfieldname",
          "lines": [
            "HandleBeaconKeyFieldName examines an AttributeMap,",
            "the [Beacon Key Source](../searchable-encryption/search-config.md#beacon-key-source)",
            "and the [Attribute Actions](./ddb-table-encryption-config.md#attribute-actions) to determine",
            "how the [Beacon Key Field Name](../searchable-encryption/search-config.md#beacon-key-field-name) should be handled.",
            "",
            [
              {
                "annotation_ids": [
                  "1b86e647d22dc73b"
                ],
                "status_id": 8,
                "text": "The [Beacon Key Source](../searchable-encryption/search-config.md#beacon-key-source)"
              }
            ],
            [
              {
                "annotation_ids": [
                  "1b86e647d22dc73b"
                ],
                "status_id": 8,
                "text": "MUST be [Multi Key Store](../searchable-encryption/search-config.md#multi-key-store-initialization)"
              }
            ],
            [
              {
                "annotation_ids": [
                  "1b86e647d22dc73b"
                ],
                "status_id": 8,
                "text": "or HandleBeaconKeyFieldName MUST fail."
              }
            ],
            "",
            [
              {
                "annotation_ids": [
                  "adee144384a465f4"
                ],
                "status_id": 8,
                "text": "If the AttributeMap does not have a key"
              }
            ],
            [
              {
                "annotation_ids": [
                  "adee144384a465f4"
                ],
                "status_id": 8,
                "text": "equal to [Beacon Key Field Name](../searchable-encryption/search-config.md#beacon-key-field-name)"
              }
            ],
            [
              {
                "annotation_ids": [
                  "adee144384a465f4"
                ],
                "status_id": 8,
                "text": "HandleBeaconKeyFieldName MUST return a `beacon key id` of None"
              }
            ],
            [
              {
                "annotation_ids": [
                  "adee144384a465f4"
                ],
                "status_id": 8,
                "text": "and the unaltered AttributeMap."
              }
            ],
            "This case is because a specific item",
            "may not have any beacons that need to be constructed.",
            "",
            [
              {
                "annotation_ids": [
                  "40bd9c785005ff82"
                ],
                "status_id": 8,
                "text": "If the AttributeMap does have a key"
              }
            ],
            [
              {
                "annotation_ids": [
                  "40bd9c785005ff82"
                ],
                "status_id": 8,
                "text": "equal to [Beacon Key Field Name](../searchable-encryption/search-config.md#beacon-key-field-name)"
              }
            ],
            [
              {
                "annotation_ids": [
                  "40bd9c785005ff82"
                ],
                "status_id": 8,
                "text": "then the `beacon key id` MUST be the value of this Attribute."
              }
            ],
            "",
            [
              {
                "annotation_ids": [
                  "5f1c3cf5e9a27305"
                ],
                "status_id": 8,
                "text": "If there is not an [Attribute Action](./ddb-table-encryption-config.md#attribute-actions)"
              }
            ],
            [
              {
                "annotation_ids": [
                  "5f1c3cf5e9a27305"
                ],
                "status_id": 8,
                "text": "configured for the [Beacon Key Field Name](../searchable-encryption/search-config.md#beacon-key-field-name)"
              }
            ],
            [
              {
                "annotation_ids": [
                  "5f1c3cf5e9a27305"
                ],
                "status_id": 8,
                "text": "HandleBeaconKeyFieldName MUST remove the [Beacon Key Field Name](../searchable-encryption/search-config.md#beacon-key-field-name)"
              }
            ],
            [
              {
                "annotation_ids": [
                  "5f1c3cf5e9a27305"
                ],
                "status_id": 8,
                "text": "from the AttributeMap and return the `beacon key id` and the altered AttributeMap."
              }
            ],
            "",
            [
              {
                "annotation_ids": [
                  "ad4f78987ca60cd1"
                ],
                "status_id": 8,
                "text": "If there is an [Attribute Action](./ddb-table-encryption-config.md#attribute-actions)"
              }
            ],
            [
              {
                "annotation_ids": [
                  "ad4f78987ca60cd1"
                ],
                "status_id": 8,
                "text": "configured for the [Beacon Key Field Name](../searchable-encryption/search-config.md#beacon-key-field-name)"
              }
            ],
            [
              {
                "annotation_ids": [
                  "ad4f78987ca60cd1"
                ],
                "status_id": 8,
                "text": "and that action is [DO_NOTHING](../structured-encryption/structures.md#do_nothing)"
              }
            ],
            [
              {
                "annotation_ids": [
                  "ad4f78987ca60cd1"
                ],
                "status_id": 8,
                "text": "HandleBeaconKeyFieldName MUST remove the [Beacon Key Field Name](../searchable-encryption/search-config.md#beacon-key-field-name)"
              }
            ],
            [
              {
                "annotation_ids": [
                  "ad4f78987ca60cd1"
                ],
                "status_id": 8,
                "text": "from the AttributeMap and return the `beacon key id` and the altered AttributeMap."
              }
            ],
            "",
            [
              {
                "annotation_ids": [
                  "976aca04b431e74c"
                ],
                "status_id": 8,
                "text": "If there is an [Attribute Action](./ddb-table-encryption-config.md#attribute-actions)"
              }
            ],
            [
              {
                "annotation_ids": [
                  "976aca04b431e74c"
                ],
                "status_id": 8,
                "text": "configured for the [Beacon Key Field Name](../searchable-encryption/search-config.md#beacon-key-field-name)"
              }
            ],
            [
              {
                "annotation_ids": [
                  "976aca04b431e74c"
                ],
                "status_id": 8,
                "text": "and that action is [SIGN_ONLY](../structured-encryption/structures.md#sign_only)"
              }
            ],
            [
              {
                "annotation_ids": [
                  "976aca04b431e74c"
                ],
                "status_id": 8,
                "text": "HandleBeaconKeyFieldName MUST return the `beacon key id`"
              }
            ],
            [
              {
                "annotation_ids": [
                  "976aca04b431e74c"
                ],
                "status_id": 8,
                "text": "and the unaltered AttributeMap."
              }
            ],
            "",
            "Having an attribute action of [ENCRYPT_AND_SIGN](../structured-encryption/structures.md#encrypt_and_sign)",
            "for the [Beacon Key Field Name](../searchable-encryption/search-config.md#beacon-key-field-name)",
            "is [not a valid configuration](../searchable-encryption/search-config.md#beacon-version-initialization)."
          ],
          "requirements": [
            "1b86e647d22dc73b",
            "1b86e647d22dc73b",
            "1b86e647d22dc73b",
            "adee144384a465f4",
            "adee144384a465f4",
            "adee144384a465f4",
            "adee144384a465f4",
            "40bd9c785005ff82",
            "40bd9c785005ff82",
            "40bd9c785005ff82",
            "5f1c3cf5e9a27305",
            "5f1c3cf5e9a27305",
            "5f1c3cf5e9a27305",
            "5f1c3cf5e9a27305",
            "ad4f78987ca60cd1",
            "ad4f78987ca60cd1",
            "ad4f78987ca60cd1",
            "ad4f78987ca60cd1",
            "ad4f78987ca60cd1",
            "976aca04b431e74c",
            "976aca04b431e74c",
            "976aca04b431e74c",
            "976aca04b431e74c",
            "976aca04b431e74c"
          ],
          "title": "HandleBeaconKeyFieldName"
        },
        {
          "id": "queryinputforbeacons",
          "lines": [
            "Transform an unencrypted [QueryInput](#queryinput) object for searchable encryption.",
            "",
            [
              {
                "annotation_ids": [
                  "cd44810c0bc4ea79"
                ],
                "status_id": 8,
                "text": "The KeyConditions property MUST NOT be defined on [QueryInput](#queryinput)."
              }
            ],
            "",
            [
              {
                "annotation_ids": [
                  "2c9a51b5b2faf72b"
                ],
                "status_id": 8,
                "text": "If the [QueryObject has encrypted values](#queryobject-has-encrypted-values)"
              }
            ],
            [
              {
                "annotation_ids": [
                  "2c9a51b5b2faf72b"
                ],
                "status_id": 8,
                "text": "then QueryInputForBeacons MUST obtain [Beacon Key Materials](../searchable-encryption/search-config.md#beacon-key-materials)"
              }
            ],
            [
              {
                "annotation_ids": [
                  "2c9a51b5b2faf72b"
                ],
                "status_id": 8,
                "text": "from [Get beacon key for query](../searchable-encryption/search-config.md#get-beacon-key-for-query)."
              }
            ],
            [
              {
                "annotation_ids": [
                  "1c7e45cc84a094be"
                ],
                "status_id": 8,
                "text": "If the [QueryObject does not have encrypted values](#queryobject-has-encrypted-values)"
              }
            ],
            [
              {
                "annotation_ids": [
                  "1c7e45cc84a094be"
                ],
                "status_id": 8,
                "text": "then QueryInputForBeacons MUST NOT attempt to obtain [Beacon Key Materials](../searchable-encryption/search-config.md#beacon-key-materials)."
              }
            ],
            "",
            [
              {
                "annotation_ids": [
                  "fbdbecd7ed62552e"
                ],
                "status_id": 8,
                "text": "For any operand in the KeyConditionExpression or FilterExpression which is a beacon name,"
              }
            ],
            [
              {
                "annotation_ids": [
                  "fbdbecd7ed62552e"
                ],
                "status_id": 8,
                "text": "the name MUST be replaced by the internal beacon name (i.e."
              },
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": " NAME replaced by aws_dbe_b_NAME)."
              }
            ],
            "",
            [
              {
                "annotation_ids": [
                  "4f1e42e558646f56"
                ],
                "status_id": 8,
                "text": "If the name is used directly in the expression, the name MUST be changed in the expression."
              }
            ],
            "For example the expression \"MyBeacon = :value\" must be changed to \"aws_dbe_b_MyBeacon = :value\".",
            "",
            [
              {
                "annotation_ids": [
                  "1a71afeeadb19dac"
                ],
                "status_id": 8,
                "text": "If the name is used indirectly through the ExpressionAttributeNames mapping,"
              }
            ],
            [
              {
                "annotation_ids": [
                  "1a71afeeadb19dac"
                ],
                "status_id": 8,
                "text": "the name MUST be changed in the ExpressionAttributeNames."
              },
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": " For example if the query is"
              }
            ],
            "\"#Beacon = :value\" and ExpressionAttributeNames holds (#Beacon = MyBeacon),",
            "the query must remain unchanged and ExpressionAttributeNames changed to (#Beacon = aws_dbe_b_MyBeacon).",
            "",
            "In this regard, each use of each operand is handled separately.",
            "",
            [
              {
                "annotation_ids": [
                  "8de4534e8914f258"
                ],
                "status_id": 8,
                "text": "Similarly, any values in ExpressionAttributeValues that are referred to by a beacon name"
              }
            ],
            [
              {
                "annotation_ids": [
                  "8de4534e8914f258"
                ],
                "status_id": 8,
                "text": "MUST be changed to the beacon value, as calculated defined in [beacons](../searchable-encryption/beacons.md#beacon-value)."
              }
            ],
            [
              {
                "annotation_ids": [
                  "dfc91053c78921f3"
                ],
                "status_id": 8,
                "text": "The [hmac key](./search-config.md#hmac-key-generation) used"
              }
            ],
            [
              {
                "annotation_ids": [
                  "dfc91053c78921f3"
                ],
                "status_id": 8,
                "text": "MUST be obtained from the [Beacon Key Materials](../searchable-encryption/search-config.md#beacon-key-materials)"
              }
            ],
            [
              {
                "annotation_ids": [
                  "dfc91053c78921f3"
                ],
                "status_id": 8,
                "text": "[HMAC Keys map](../searchable-encryption/search-config.md#hmac-keys) using the beacon name"
              }
            ],
            [
              {
                "annotation_ids": [
                  "dfc91053c78921f3"
                ],
                "status_id": 8,
                "text": "as the key."
              }
            ],
            "",
            "For example if the query is",
            "\"MyBeacon = :value\" and ExpressionAttributeValues holds (:value = banana),",
            "then the ExpressionAttributeValues must be changed to (:value = 13fd),",
            "where \"13fd\" is the calculated beacon value.",
            "",
            [
              {
                "annotation_ids": [
                  "1d46690a387f5504",
                  "fd541f18a7e40d28",
                  "ee877282c38fe245"
                ],
                "status_id": 4,
                "text": "If a single value in ExpressionAttributeValues is used in more than one context,"
              }
            ],
            [
              {
                "annotation_ids": [
                  "1d46690a387f5504",
                  "fd541f18a7e40d28",
                  "ee877282c38fe245"
                ],
                "status_id": 4,
                "text": "for example an expression of `this = :foo OR that = :foo` where `this` and `that`"
              }
            ],
            [
              {
                "annotation_ids": [
                  "1d46690a387f5504",
                  "fd541f18a7e40d28",
                  "ee877282c38fe245"
                ],
                "status_id": 4,
                "text": "are both beacons, this operation MUST fail."
              }
            ],
            "This includes the case where the KeyConditionExpression contains `this = :foo`",
            "and the FilterExpression includes `that = :foo`.",
            "This is because `:foo` can only hold one value, but the beaconization of `:foo`",
            "would be different for different beacons.",
            "",
            "Hypothetically, this operation could split `:foo` into `:foo1` and `:foo2`",
            "in this situation, but that risks leaking the connection between the two beacons and spoiling k-anonymity.",
            "Similarly, if one of the two was not a beacon, then we would be leaking the fact that",
            "this beacon came from that text."
          ],
          "requirements": [
            "cd44810c0bc4ea79",
            "2c9a51b5b2faf72b",
            "2c9a51b5b2faf72b",
            "2c9a51b5b2faf72b",
            "1c7e45cc84a094be",
            "1c7e45cc84a094be",
            "fbdbecd7ed62552e",
            "fbdbecd7ed62552e",
            "4f1e42e558646f56",
            "1a71afeeadb19dac",
            "1a71afeeadb19dac",
            "8de4534e8914f258",
            "8de4534e8914f258",
            "dfc91053c78921f3",
            "dfc91053c78921f3",
            "dfc91053c78921f3",
            "dfc91053c78921f3",
            "ee877282c38fe245",
            "ee877282c38fe245",
            "ee877282c38fe245"
          ],
          "title": "QueryInputForBeacons"
        },
        {
          "id": "queryobject-has-encrypted-values",
          "lines": [
            "Determines if a Query Object has encrypted values (ENCRYPT_AND_SIGN fields)",
            "",
            [
              {
                "annotation_ids": [
                  "c852d34ace60f2de"
                ],
                "status_id": 8,
                "text": "If there are any ExpressionAttributeValues that are referred to by"
              }
            ],
            [
              {
                "annotation_ids": [
                  "c852d34ace60f2de"
                ],
                "status_id": 8,
                "text": "a beacon name that contain encrypted values (ENCRYPT_AND_SIGN field)"
              }
            ],
            [
              {
                "annotation_ids": [
                  "c852d34ace60f2de"
                ],
                "status_id": 8,
                "text": "then QueryObject has encrypted values MUST return true."
              }
            ],
            [
              {
                "annotation_ids": [
                  "a5849f1a8d18217f"
                ],
                "status_id": 8,
                "text": "Otherwise it MUST return false."
              }
            ]
          ],
          "requirements": [
            "c852d34ace60f2de",
            "c852d34ace60f2de",
            "c852d34ace60f2de",
            "a5849f1a8d18217f"
          ],
          "title": "QueryObject has encrypted values"
        },
        {
          "id": "queryinput",
          "lines": [
            "This is the original Query request that was made by the customer."
          ],
          "title": "QueryInput"
        },
        {
          "id": "queryoutputforbeacons",
          "lines": [
            "Transform an unencrypted QueryOutput object for searchable encryption.",
            "",
            "We expect that the list of items returned will contain some extra records",
            "that matched the beacon values, but do not match the plaintext values",
            "if the customer has made a query over any encrypted fields.",
            "",
            [
              {
                "annotation_ids": [
                  "cb7fdc82b9b8464f"
                ],
                "status_id": 8,
                "text": "If the [QueryObject does not have encrypted values](#queryobject-has-encrypted-values)"
              }
            ],
            [
              {
                "annotation_ids": [
                  "cb7fdc82b9b8464f"
                ],
                "status_id": 8,
                "text": "then QueryOutputForBeacons MUST not filter the results and MUST return."
              }
            ],
            "This is because the query may not have a beacon key id filed.",
            "",
            [
              {
                "annotation_ids": [
                  "dbdfba8bf15eb35f"
                ],
                "status_id": 8,
                "text": "If the [Beacon Key Source](../searchable-encryption/search-config.md#beacon-key-source) for the configured table"
              }
            ],
            [
              {
                "annotation_ids": [
                  "dbdfba8bf15eb35f"
                ],
                "status_id": 8,
                "text": "is a [Multi Key Store](../searchable-encryption/search-config.md#multi-key-store-initialization)"
              }
            ],
            [
              {
                "annotation_ids": [
                  "dbdfba8bf15eb35f"
                ],
                "status_id": 8,
                "text": "you MUST construct an `expected beacon key id` equal to the [Beacon Key Id](../searchable-encryption/search-config.md#beacon-key-materials)"
              }
            ],
            [
              {
                "annotation_ids": [
                  "dbdfba8bf15eb35f"
                ],
                "status_id": 8,
                "text": "on materials obtained from [Get beacon key for query](../searchable-encryption/search-config.md#get-beacon-key-for-query)"
              }
            ],
            [
              {
                "annotation_ids": [
                  "dbdfba8bf15eb35f"
                ],
                "status_id": 8,
                "text": "These [Beacon Key Materials](../searchable-encryption/search-config.md#beacon-key-materials)"
              }
            ],
            [
              {
                "annotation_ids": [
                  "dbdfba8bf15eb35f"
                ],
                "status_id": 8,
                "text": "SHOULD then be discarded."
              }
            ],
            [
              {
                "annotation_ids": [
                  "fe862f54453326eb"
                ],
                "status_id": 8,
                "text": "Using the constructed `expected beacon key id`,"
              }
            ],
            [
              {
                "annotation_ids": [
                  "fe862f54453326eb"
                ],
                "status_id": 8,
                "text": "for each item the result"
              }
            ],
            [
              {
                "annotation_ids": [
                  "fe862f54453326eb"
                ],
                "status_id": 8,
                "text": "the [Get beacon key id from Parsed Header](../searchable-encryption/search-config.md#get-beacon-key-id-from-parsed-header)"
              }
            ],
            [
              {
                "annotation_ids": [
                  "fe862f54453326eb"
                ],
                "status_id": 8,
                "text": "MUST match the `expected beacon key id`."
              }
            ],
            [
              {
                "annotation_ids": [
                  "a8769df721a16395"
                ],
                "status_id": 8,
                "text": "If [Get beacon key id from Parsed Header](../searchable-encryption/search-config.md#get-beacon-key-id-from-parsed-header)"
              }
            ],
            [
              {
                "annotation_ids": [
                  "a8769df721a16395"
                ],
                "status_id": 8,
                "text": "fails or an item does not match it MUST be discarded."
              }
            ],
            "",
            [
              {
                "annotation_ids": [
                  "7d22580f2be0afea"
                ],
                "status_id": 8,
                "text": "For each item, we MUST evaluate the query expressions supplied in the QueryInput"
              }
            ],
            [
              {
                "annotation_ids": [
                  "7d22580f2be0afea"
                ],
                "status_id": 8,
                "text": "against the decrypted field values returned by the query."
              }
            ],
            "That is, we must filter the decrypted records exactly the way that",
            "the DynamoDB server would have, if the server had access to the plaintext values",
            "of the item.",
            [
              {
                "annotation_ids": [
                  "1a20ab5189a74310"
                ],
                "status_id": 8,
                "text": "Any items that do not match MUST be discarded."
              }
            ],
            "",
            "For example, imagine that the query input used the expression \"Fruit = :fruit\"",
            "with the value map containing (:fruit = banana).",
            "",
            "The actual query resolved by the server will be \"aws_dbe_b_Fruit = :fruit\"",
            "with the value map containing (:fruit = 12345).",
            "",
            "Further imagine that two records were returned, one with fruit = banana,",
            "and one with fruit = orange (but both with aws_dbe_b_Fruit = 12345).",
            "",
            "This operation must look at the field \"fruit\" and keep only the record",
            "where fruit = banana.",
            "",
            [
              {
                "annotation_ids": [
                  "89538bb0cef3da9a"
                ],
                "status_id": 8,
                "text": "The `Count` field, MUST be updated to reflect the new item count."
              }
            ],
            "",
            "In this context, the DynamoDB server has already verified that the query is",
            "well formed, and so any errors encountered during this filtering step",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "must reflect some more fundamental system error. "
              },
              {
                "annotation_ids": [
                  "d25a930d7cab33b8"
                ],
                "status_id": 8,
                "text": "For this reason,"
              }
            ],
            [
              {
                "annotation_ids": [
                  "d25a930d7cab33b8"
                ],
                "status_id": 8,
                "text": "any error encountered during filtering MUST result in a failure of the query operation."
              }
            ]
          ],
          "requirements": [
            "cb7fdc82b9b8464f",
            "cb7fdc82b9b8464f",
            "dbdfba8bf15eb35f",
            "dbdfba8bf15eb35f",
            "dbdfba8bf15eb35f",
            "dbdfba8bf15eb35f",
            "dbdfba8bf15eb35f",
            "dbdfba8bf15eb35f",
            "fe862f54453326eb",
            "fe862f54453326eb",
            "fe862f54453326eb",
            "fe862f54453326eb",
            "a8769df721a16395",
            "a8769df721a16395",
            "7d22580f2be0afea",
            "7d22580f2be0afea",
            "1a20ab5189a74310",
            "89538bb0cef3da9a",
            "d25a930d7cab33b8",
            "d25a930d7cab33b8"
          ],
          "title": "QueryOutputForBeacons"
        },
        {
          "id": "scaninputforbeacons",
          "lines": [
            "Transform an unencrypted ScanInput object for searchable encryption.",
            "",
            "The ScanInput is transformed in the same way as [QueryInputForBeacons](#queryinputforbeacons)."
          ],
          "title": "ScanInputForBeacons"
        },
        {
          "id": "scanoutputforbeacons",
          "lines": [
            "Transform an unencrypted ScanOutput object for searchable encryption.",
            "",
            "The ScanOutput is transformed in the same way as [QueryOutputForBeacons](#queryoutputforbeacons)."
          ],
          "title": "ScanOutputForBeacons"
        }
      ],
      "title": "DynamoDB Support Layer"
    },
    "specification/dynamodb-encryption-client/ddb-table-encryption-config.md": {
      "format": "markdown",
      "sections": [
        {
          "id": "dynamodb-table-encryption-config",
          "lines": [],
          "title": "DynamoDB Table Encryption Config"
        },
        {
          "id": "version",
          "lines": [
            "1.0.0"
          ],
          "title": "Version"
        },
        {
          "id": "changelog",
          "lines": [
            "- 1.0.0",
            "",
            "  - Initial record"
          ],
          "title": "Changelog"
        },
        {
          "id": "definitions",
          "lines": [],
          "title": "Definitions"
        },
        {
          "id": "conventions-used-in-this-document",
          "lines": [
            "The key words \"MUST\", \"MUST NOT\", \"REQUIRED\", \"SHALL\", \"SHALL NOT\", \"SHOULD\", \"SHOULD NOT\", \"RECOMMENDED\", \"MAY\", and \"OPTIONAL\"",
            "in this document are to be interpreted as described in [RFC 2119](https://tools.ietf.org/html/rfc2119)."
          ],
          "title": "Conventions used in this document"
        },
        {
          "id": "overview",
          "lines": [
            "This document describes a set of data used in the initialization of",
            "the [DynamoDb Item Encryptor](./ddb-item-encryptor.md) as well as the",
            "[AWS SDK integration with DDB](./ddb-sdk-integration.md).",
            "This data describes how items in a specific DynamoDb Table",
            "should be encrypted and decrypted."
          ],
          "title": "Overview"
        },
        {
          "id": "structure",
          "lines": [
            [
              {
                "annotation_ids": [
                  "cfe2626e678807f1",
                  "918f985315ed4cab"
                ],
                "status_id": 1,
                "text": "The physical [DynamoDB Table Name](#dynamodb-table-name) is REQUIRED"
              }
            ],
            [
              {
                "annotation_ids": [
                  "cfe2626e678807f1",
                  "918f985315ed4cab"
                ],
                "status_id": 1,
                "text": "to be associated with the DynamoDb Table Encryption Configuration."
              }
            ],
            "",
            [
              {
                "annotation_ids": [
                  "78814dac3763ddf7",
                  "e8429367a1d6d09b"
                ],
                "status_id": 1,
                "text": "The following are REQUIRED for DynamoDb Table Encryption Configuration:"
              }
            ],
            "",
            [
              {
                "annotation_ids": [
                  "78814dac3763ddf7"
                ],
                "status_id": 2,
                "text": "- [Logical Table Name](#logical-table-name)"
              }
            ],
            [
              {
                "annotation_ids": [
                  "78814dac3763ddf7"
                ],
                "status_id": 2,
                "text": "- [DynamoDB Partition Key Name](#dynamodb-partition-key-name)"
              }
            ],
            [
              {
                "annotation_ids": [
                  "78814dac3763ddf7"
                ],
                "status_id": 2,
                "text": "- [Attribute Actions](#attribute-actions)"
              }
            ],
            [
              {
                "annotation_ids": [
                  "78814dac3763ddf7"
                ],
                "status_id": 2,
                "text": "- A [CMM](#cmm) or [Keyring](#keyring)"
              }
            ],
            "",
            [
              {
                "annotation_ids": [
                  "5277bfb6594771b2",
                  "71d7078397bbf209"
                ],
                "status_id": 3,
                "text": "The following are OPTIONAL for DynamoDb Table Encryption Configuration:"
              }
            ],
            "",
            [
              {
                "annotation_ids": [
                  "5277bfb6594771b2"
                ],
                "status_id": 2,
                "text": "- [DynamoDB Sort Key Name](#dynamodb-sort-key-name)"
              }
            ],
            [
              {
                "annotation_ids": [
                  "5277bfb6594771b2"
                ],
                "status_id": 2,
                "text": "- [Unauthenticated Attributes](#unauthenticated-attributes)"
              }
            ],
            [
              {
                "annotation_ids": [
                  "5277bfb6594771b2"
                ],
                "status_id": 2,
                "text": "- [Unauthenticated Attribute Name Prefix](#unauthenticated-attribute-prefix)"
              }
            ],
            [
              {
                "annotation_ids": [
                  "5277bfb6594771b2"
                ],
                "status_id": 2,
                "text": "- [Algorithm Suite](#algorithm-suite)"
              }
            ],
            [
              {
                "annotation_ids": [
                  "5277bfb6594771b2"
                ],
                "status_id": 2,
                "text": "- [Legacy Config](#legacy-config)"
              }
            ],
            [
              {
                "annotation_ids": [
                  "5277bfb6594771b2"
                ],
                "status_id": 2,
                "text": "- [Plaintext Policy](#plaintext-policy)"
              }
            ],
            "- [Searchable Encryption Config](../searchable-encryption/search-config.md)",
            "",
            [
              {
                "annotation_ids": [
                  "8117849cf4c3a3be",
                  "94c42aa465320cac"
                ],
                "status_id": 7,
                "text": "A [Legacy Config](#legacy-config)"
              }
            ],
            [
              {
                "annotation_ids": [
                  "8117849cf4c3a3be",
                  "94c42aa465320cac"
                ],
                "status_id": 7,
                "text": "and a [Plaintext Policy](#plaintext-policy)"
              }
            ],
            [
              {
                "annotation_ids": [
                  "8117849cf4c3a3be",
                  "94c42aa465320cac"
                ],
                "status_id": 7,
                "text": "both specified on the same config is invalid,"
              }
            ],
            [
              {
                "annotation_ids": [
                  "8117849cf4c3a3be",
                  "94c42aa465320cac"
                ],
                "status_id": 7,
                "text": "and MUST result in an error."
              }
            ],
            "",
            [
              {
                "annotation_ids": [
                  "e60fb0a100738228"
                ],
                "status_id": 8,
                "text": "A [Searchable Encryption Config](../searchable-encryption/search-config.md)"
              }
            ],
            [
              {
                "annotation_ids": [
                  "e60fb0a100738228"
                ],
                "status_id": 8,
                "text": "and either a [Legacy Config](./ddb-table-encryption-config.md#legacy-config)"
              }
            ],
            [
              {
                "annotation_ids": [
                  "e60fb0a100738228"
                ],
                "status_id": 8,
                "text": "or a [Plaintext Policy](./ddb-table-encryption-config.md#plaintext-policy)"
              }
            ],
            [
              {
                "annotation_ids": [
                  "e60fb0a100738228"
                ],
                "status_id": 8,
                "text": "being specified on the same config is invalid,"
              }
            ],
            [
              {
                "annotation_ids": [
                  "e60fb0a100738228"
                ],
                "status_id": 8,
                "text": "and MUST result in an error."
              }
            ]
          ],
          "requirements": [
            "918f985315ed4cab",
            "918f985315ed4cab",
            "e8429367a1d6d09b",
            "71d7078397bbf209",
            "94c42aa465320cac",
            "94c42aa465320cac",
            "94c42aa465320cac",
            "94c42aa465320cac",
            "e60fb0a100738228",
            "e60fb0a100738228",
            "e60fb0a100738228",
            "e60fb0a100738228",
            "e60fb0a100738228"
          ],
          "title": "Structure"
        },
        {
          "id": "dynamodb-table-name",
          "lines": [
            "The name of the DynamoDB Table where the",
            "DynamoDB Items to be decrypted or encrypted",
            "are stored or intended to be stored.",
            "",
            [
              {
                "annotation_ids": [
                  "389b2365ae25764a",
                  "7cf8aee157214809"
                ],
                "status_id": 1,
                "text": "This Table Name MUST be a valid DynamoDB Table Name."
              }
            ],
            "",
            [
              {
                "annotation_ids": [
                  "69bd07ce96ece952",
                  "f7746618a0cad96f"
                ],
                "status_id": 3,
                "text": "If this config is being organized with other table configs in a map,"
              }
            ],
            [
              {
                "annotation_ids": [
                  "69bd07ce96ece952",
                  "f7746618a0cad96f"
                ],
                "status_id": 3,
                "text": "this value MAY exist as a key value to identify other data in this config,"
              }
            ],
            [
              {
                "annotation_ids": [
                  "69bd07ce96ece952",
                  "f7746618a0cad96f"
                ],
                "status_id": 3,
                "text": "instead of existing alongside this data in the same object."
              }
            ],
            "We specify this data instead of specifying a more complex",
            "but consistent structure in order to give us flexibility for providing the",
            "simplest customer experience.",
            "Also in the case of a restore from backup,",
            "this physical name may not match the logical name for the data stored.",
            "So a [logical table name](#logical-table-name) exists."
          ],
          "requirements": [
            "7cf8aee157214809",
            "f7746618a0cad96f",
            "f7746618a0cad96f",
            "f7746618a0cad96f"
          ],
          "title": "DynamoDB Table Name"
        },
        {
          "id": "logical-table-name",
          "lines": [
            "The logical name for the DynamoDB Table.",
            "This value can match the DynamoDB Table Name",
            "but does not need to.",
            "This name is cryptographically bound to all data stored in this table.",
            "In the case of a restore from backup",
            "the [DynamoDB Table Name](#dynamodb-table-name) can change to a new name,",
            "but this name must remain the same.",
            "",
            [
              {
                "annotation_ids": [
                  "8a8c42c92fa658ab",
                  "b4910bf6ebe7d01f",
                  "fbbe120ab833f53a"
                ],
                "status_id": 11,
                "text": "When mapping [DynamoDB Table Names](#dynamodb-table-name) to [logical table name](#logical-table-name)"
              }
            ],
            [
              {
                "annotation_ids": [
                  "8a8c42c92fa658ab",
                  "b4910bf6ebe7d01f",
                  "fbbe120ab833f53a"
                ],
                "status_id": 11,
                "text": "there MUST a one to one mapping between the two."
              }
            ],
            "The purpose of the logical name is to simplify restore type operations,",
            "not make it easier to confuse what data comes from what physical table."
          ],
          "requirements": [
            "fbbe120ab833f53a",
            "fbbe120ab833f53a"
          ],
          "title": "Logical Table Name"
        },
        {
          "id": "dynamodb-partition-key-name",
          "lines": [
            "The DynamoDB Partition Key Name is the attribute name of the partition key of the DynamoDB Table",
            "identified by the [input DynamoDB Table Name](#dynamodb-table-name).",
            "",
            [
              {
                "annotation_ids": [
                  "a238bd20b91f9d6b",
                  "4aa740c35f7c5815"
                ],
                "status_id": 1,
                "text": "This Partition Key Name MUST be a valid DynamoDB Key Schema Attribute Name"
              }
            ]
          ],
          "requirements": [
            "4aa740c35f7c5815"
          ],
          "title": "DynamoDB Partition Key Name"
        },
        {
          "id": "dynamodb-sort-key-name",
          "lines": [
            "The DynamoDB Sort Key Name is the attribute name of the sort key",
            "of the DynamoDB Table identified by the [input DynamoDB Table Name](#dynamodb-table-name).",
            "",
            [
              {
                "annotation_ids": [
                  "cae165bb472c6635",
                  "8c5065e7c3f6c7b3"
                ],
                "status_id": 1,
                "text": "This Sort Key Name MUST be a valid DynamoDB Key Schema Attribute Name"
              }
            ]
          ],
          "requirements": [
            "8c5065e7c3f6c7b3"
          ],
          "title": "DynamoDB Sort Key Name"
        },
        {
          "id": "configuration-version",
          "lines": [
            [
              {
                "annotation_ids": [
                  "5c07ee0103611016",
                  "2ba6421e44a6b3ed"
                ],
                "status_id": 1,
                "text": "If any of the [Attribute Actions](#attribute-actions) are configured as"
              }
            ],
            [
              {
                "annotation_ids": [
                  "5c07ee0103611016",
                  "2ba6421e44a6b3ed"
                ],
                "status_id": 1,
                "text": "[SIGN_AND_INCLUDE_IN_ENCRYPTION_CONTEXT](../structured-encryption/structures.md#contextandsign)"
              }
            ],
            [
              {
                "annotation_ids": [
                  "5c07ee0103611016",
                  "2ba6421e44a6b3ed"
                ],
                "status_id": 1,
                "text": "then the configuration version MUST be 2; otherwise,"
              }
            ],
            [
              {
                "annotation_ids": [
                  "5c07ee0103611016",
                  "2ba6421e44a6b3ed"
                ],
                "status_id": 1,
                "text": "the configuration version MUST be 1."
              }
            ]
          ],
          "requirements": [
            "2ba6421e44a6b3ed",
            "2ba6421e44a6b3ed",
            "2ba6421e44a6b3ed",
            "2ba6421e44a6b3ed"
          ],
          "title": "Configuration Version"
        },
        {
          "id": "key-action",
          "lines": [
            [
              {
                "annotation_ids": [
                  "0e79c0375c405918",
                  "e4c2d3959cfcec38"
                ],
                "status_id": 1,
                "text": "if the [configuration version](#configuration-version) is 2, then"
              }
            ],
            [
              {
                "annotation_ids": [
                  "0e79c0375c405918",
                  "e4c2d3959cfcec38"
                ],
                "status_id": 1,
                "text": "the key action MUST be [SIGN_AND_INCLUDE_IN_ENCRYPTION_CONTEXT](../structured-encryption/structures.md#contextandsign);"
              }
            ],
            [
              {
                "annotation_ids": [
                  "0e79c0375c405918",
                  "e4c2d3959cfcec38"
                ],
                "status_id": 1,
                "text": "otherwise, the key action MUST be [SIGN_ONLY](../structured-encryption/structures.md#signonly)."
              }
            ]
          ],
          "requirements": [
            "e4c2d3959cfcec38",
            "e4c2d3959cfcec38",
            "e4c2d3959cfcec38"
          ],
          "title": "Key Action"
        },
        {
          "id": "attribute-actions",
          "lines": [
            "Attribute Actions is a map of attribute names to",
            "[Crypto Actions](../structured-encryption/structures.md#crypto-action)",
            "that describes what Crypto Action applies to a particular attribute",
            "(if it exists) during encryption.",
            "",
            [
              {
                "annotation_ids": [
                  "2bd4f3363d22746a",
                  "14d00258ea64f189"
                ],
                "status_id": 1,
                "text": "The [Key Action](#key-action)"
              }
            ],
            [
              {
                "annotation_ids": [
                  "2bd4f3363d22746a",
                  "14d00258ea64f189"
                ],
                "status_id": 1,
                "text": "MUST be configured to the partition attribute and, if present, sort attribute."
              }
            ]
          ],
          "requirements": [
            "14d00258ea64f189",
            "14d00258ea64f189"
          ],
          "title": "Attribute Actions"
        },
        {
          "id": "cmm",
          "lines": [
            "A CMM that implements the [CMM interface](https://github.com/awslabs/aws-encryption-sdk-specification/blob/master/framework/cmm-interface.md)",
            "that is responsible for obtaining materials for encryption and decryption.",
            "",
            [
              {
                "annotation_ids": [
                  "516a64486c8c372d",
                  "e91693cf8d4755b1"
                ],
                "status_id": 1,
                "text": "If not supplied during initialization,"
              }
            ],
            [
              {
                "annotation_ids": [
                  "516a64486c8c372d",
                  "e91693cf8d4755b1"
                ],
                "status_id": 1,
                "text": "the CMM considered \"configured\" to this"
              }
            ],
            [
              {
                "annotation_ids": [
                  "516a64486c8c372d",
                  "e91693cf8d4755b1"
                ],
                "status_id": 1,
                "text": "Item Encryptor MUST be a"
              }
            ],
            [
              {
                "annotation_ids": [
                  "516a64486c8c372d",
                  "e91693cf8d4755b1"
                ],
                "status_id": 1,
                "text": "[default CMM](https://github.com/awslabs/aws-encryption-sdk-specification/blob/master/framework/default-cmm.md)"
              }
            ],
            [
              {
                "annotation_ids": [
                  "516a64486c8c372d",
                  "e91693cf8d4755b1"
                ],
                "status_id": 1,
                "text": "constructed using the [supplied keyring](#keyring) as input."
              }
            ]
          ],
          "requirements": [
            "e91693cf8d4755b1",
            "e91693cf8d4755b1",
            "e91693cf8d4755b1",
            "e91693cf8d4755b1",
            "e91693cf8d4755b1"
          ],
          "title": "CMM"
        },
        {
          "id": "keyring",
          "lines": [
            "A Keyring that implements the [keyring interface](https://github.com/awslabs/aws-encryption-sdk-specification/blob/master/framework/keyring-interface.md)."
          ],
          "title": "Keyring"
        },
        {
          "id": "unauthenticated-attributes",
          "lines": [
            [
              {
                "annotation_ids": [
                  "8a6a1b18356e7570",
                  "94312e124ccdee48"
                ],
                "status_id": 1,
                "text": "Unauthenticated Attributes MUST be a set of Attribute Names."
              }
            ],
            "With [Unauthenticated Attribute Prefix](#unauthenticated-attribute-prefix),",
            "This identifies Attributes within this table",
            "that are not authenticated during decryption."
          ],
          "requirements": [
            "94312e124ccdee48"
          ],
          "title": "Unauthenticated Attributes"
        },
        {
          "id": "unauthenticated-attribute-prefix",
          "lines": [
            [
              {
                "annotation_ids": [
                  "cececaaaee9a164a",
                  "de0c9a11d5af2d56"
                ],
                "status_id": 1,
                "text": "Unauthenticated Attribute Prefix MUST be a string."
              }
            ],
            "With [Unauthenticated Attributes](#unauthenticated-attributes),",
            "This identifies Attributes within this table",
            "that are not authenticated during decryption."
          ],
          "requirements": [
            "de0c9a11d5af2d56"
          ],
          "title": "Unauthenticated Attribute Prefix"
        },
        {
          "id": "algorithm-suite",
          "lines": [
            [
              {
                "annotation_ids": [
                  "8e23e9105e9e405e",
                  "f1e179c39691722e"
                ],
                "status_id": 12,
                "text": "The [algorithm suite](../../submodules/MaterialProviders/aws-encryption-sdk-specification/framework/algorithm-suites.md) that SHOULD be used for encryption."
              }
            ],
            "",
            [
              {
                "annotation_ids": [
                  "3d7bd66f6c63a0c0",
                  "f10e46a223f9d792",
                  "837e1c9f7ef15b2d"
                ],
                "status_id": 1,
                "text": "This algorithm suite MUST be a [Structured Encryption Library Supported algorithm suite](../../submodules/MaterialProviders/aws-encryption-sdk-specification/framework/algorithm-suites.md)."
              }
            ]
          ],
          "requirements": [
            "f1e179c39691722e",
            "837e1c9f7ef15b2d"
          ],
          "title": "Algorithm Suite"
        },
        {
          "id": "legacy-config",
          "lines": [
            "A configuration that specifies whether items written in a legacy format in this table are allowed to be decrypted,",
            "how those items should be decrypted,",
            "and whether new items should be encrypted using the legacy format.",
            "",
            [
              {
                "annotation_ids": [
                  "4318d3224df69509",
                  "b9f4869326fa3901"
                ],
                "status_id": 1,
                "text": "This config MUST contain:"
              }
            ],
            "",
            [
              {
                "annotation_ids": [
                  "4318d3224df69509"
                ],
                "status_id": 2,
                "text": "- [Legacy Encryptor](#legacy-encryptor)"
              }
            ],
            [
              {
                "annotation_ids": [
                  "4318d3224df69509"
                ],
                "status_id": 2,
                "text": "- [Attributes Flags](#attribute-flags)"
              }
            ],
            [
              {
                "annotation_ids": [
                  "4318d3224df69509"
                ],
                "status_id": 2,
                "text": "- [Legacy Policy](#legacy-policy)"
              }
            ]
          ],
          "requirements": [
            "b9f4869326fa3901"
          ],
          "title": "Legacy Config"
        },
        {
          "id": "legacy-encryptor",
          "lines": [
            "The DynamoDbEncryptor for Java."
          ],
          "title": "Legacy Encryptor"
        },
        {
          "id": "attribute-flags",
          "lines": [
            "A map of attribute names to [Crypto Actions](../structured-encryption/structures.md#crypto-action),",
            "that describes what Crypto Action applies to a particular attribute",
            "on any items written in the legacy format.",
            "",
            [
              {
                "annotation_ids": [
                  "d76a238c4a7499d3",
                  "d49da0ca436ed077"
                ],
                "status_id": 3,
                "text": "This map MAY be different from the top level [Attribute Actions](#attribute-actions)."
              }
            ]
          ],
          "requirements": [
            "d49da0ca436ed077"
          ],
          "title": "Attribute Flags"
        },
        {
          "id": "legacy-policy",
          "lines": [
            "An enum that represent three different ways in which the legacy format should be used with this table.",
            "",
            "- FORCE_LEGACY_ENCRYPT_ALLOW_LEGACY_DECRYPT: On encrypt, items are encrypted using the legacy format,",
            "  using the legacy configuration as input.",
            "  On decrypt, items written by the legacy format are attempted to be decrypted using the",
            "  legacy configuration.",
            "  All other items are attempted to be decrypted using the normal decrypt path.",
            "- FORBID_LEGACY_ENCRYPT_ALLOW_LEGACY_DECRYPT: On encrypt, items are encrypted using the normal encrypt path.",
            "  On decrypt, items written by the legacy format are attempted to be decrypted using the",
            "  legacy configuration.",
            "  All other items are attempted to be decrypted using the normal decrypt path.",
            "- FORBID_LEGACY_ENCRYPT_FORBID_LEGACY_DECRYPT: On encrypt, items are encrypted using the normal encrypt path.",
            "  On decrypt, items written by the legacy format result in a failure.",
            "  All other items are attempted to be decrypted using the normal decrypt path."
          ],
          "title": "Legacy Policy"
        },
        {
          "id": "plaintext-policy",
          "lines": [
            "An enum that indicates whether plaintext is allowed to be read or written to this table:",
            "",
            "- FORCE_PLAINTEXT_WRITE_ALLOW_PLAINTEXT_READ: On write, items are written as plaintext.",
            "  On read, plaintext items are passed-through and all other items are attempted to be decrypted.",
            "- FORBID_PLAINTEXT_WRITE_ALLOW_PLAINTEXT_READ: On write, items are encrypted.",
            "  On read, plaintext items are passed-through and all other items are attempted to be decrypted.",
            "- FORBID_PLAINTEXT_WRITE_FORBID_PLAINTEXT_READ: On write, items are encrypted.",
            "  On read, attempt to decrypt all items.",
            "",
            [
              {
                "annotation_ids": [
                  "39758a372cc637dc",
                  "68b4233f6a5b2906"
                ],
                "status_id": 7,
                "text": "If not specified, encryption and decryption MUST behave according to `FORBID_PLAINTEXT_WRITE_FORBID_PLAINTEXT_READ`."
              }
            ]
          ],
          "requirements": [
            "68b4233f6a5b2906"
          ],
          "title": "Plaintext Policy"
        }
      ],
      "title": "DynamoDB Table Encryption Config"
    },
    "specification/dynamodb-encryption-client/decrypt-item.md": {
      "format": "markdown",
      "sections": [
        {
          "id": "decrypt-item",
          "lines": [],
          "title": "Decrypt Item"
        },
        {
          "id": "version",
          "lines": [
            "1.0.0"
          ],
          "title": "Version"
        },
        {
          "id": "changelog",
          "lines": [
            "- 1.0.0",
            "",
            "  - Initial record"
          ],
          "title": "Changelog"
        },
        {
          "id": "definitions",
          "lines": [],
          "title": "Definitions"
        },
        {
          "id": "conventions-used-in-this-document",
          "lines": [
            "The key words \"MUST\", \"MUST NOT\", \"REQUIRED\", \"SHALL\", \"SHALL NOT\", \"SHOULD\", \"SHOULD NOT\", \"RECOMMENDED\", \"MAY\", and \"OPTIONAL\"",
            "in this document are to be interpreted as described in [RFC 2119](https://tools.ietf.org/html/rfc2119)."
          ],
          "title": "Conventions used in this document"
        },
        {
          "id": "overview",
          "lines": [
            "This document describes the behavior by which the [DynamoDB Item Encryptor](./ddb-item-encryptor.md)",
            "decrypts a DynamoDB Item originally encrypted via the [Encrypt Item](./encrypt-item.md) operation."
          ],
          "title": "Overview"
        },
        {
          "id": "input",
          "lines": [
            [
              {
                "annotation_ids": [
                  "8eb1111e1f1a4e9d",
                  "c3504d2d4f011dda"
                ],
                "status_id": 1,
                "text": "The following inputs to this behavior are REQUIRED:"
              }
            ],
            "",
            [
              {
                "annotation_ids": [
                  "8eb1111e1f1a4e9d"
                ],
                "status_id": 2,
                "text": "- [DynamoDb Item](#input-dynamodb-item)"
              }
            ]
          ],
          "requirements": [
            "c3504d2d4f011dda"
          ],
          "title": "Input"
        },
        {
          "id": "input-dynamodb-item",
          "lines": [
            "The DynamoDB Item is the item to be decrypted by this behavior.",
            "",
            [
              {
                "annotation_ids": [
                  "009f02d479114bed",
                  "300e653993109054"
                ],
                "status_id": 1,
                "text": "This item MUST include an Attribute with a name that matches the"
              }
            ],
            [
              {
                "annotation_ids": [
                  "009f02d479114bed",
                  "300e653993109054"
                ],
                "status_id": 1,
                "text": "[DynamoDB Partition Key Name](./ddb-table-encryption-config.md#dynamodb-partition-key-name)"
              }
            ],
            [
              {
                "annotation_ids": [
                  "009f02d479114bed",
                  "300e653993109054"
                ],
                "status_id": 1,
                "text": "configured on the [DynamoDB Item Encryptor](./ddb-item-encryptor.md)."
              }
            ],
            [
              {
                "annotation_ids": [
                  "f4738a5750859887",
                  "2dbd3b7bd23389ff"
                ],
                "status_id": 1,
                "text": "Otherwise this operation MUST yield an error."
              }
            ],
            "",
            [
              {
                "annotation_ids": [
                  "639569bfb765d42c",
                  "0c1c061161a84934"
                ],
                "status_id": 1,
                "text": "If the [DynamoDB Item Encryptor](./ddb-item-encryptor.md)"
              }
            ],
            [
              {
                "annotation_ids": [
                  "639569bfb765d42c",
                  "0c1c061161a84934"
                ],
                "status_id": 1,
                "text": "has a [DynamoDB Sort Key Name](./ddb-table-encryption-config.md#dynamodb-sort-key-name) configured,"
              }
            ],
            [
              {
                "annotation_ids": [
                  "639569bfb765d42c",
                  "0c1c061161a84934"
                ],
                "status_id": 1,
                "text": "this item MUST include an Attribute with that name."
              }
            ],
            "Otherwise this operation MUST yield an error."
          ],
          "requirements": [
            "300e653993109054",
            "300e653993109054",
            "300e653993109054",
            "2dbd3b7bd23389ff",
            "0c1c061161a84934",
            "0c1c061161a84934",
            "0c1c061161a84934"
          ],
          "title": "Input DynamoDB Item"
        },
        {
          "id": "output",
          "lines": [
            [
              {
                "annotation_ids": [
                  "d7eaee2850df9844",
                  "175f7a475b882d59"
                ],
                "status_id": 1,
                "text": "This operation MUST output the following:"
              }
            ],
            "",
            [
              {
                "annotation_ids": [
                  "d7eaee2850df9844"
                ],
                "status_id": 2,
                "text": "- [DynamoDb Item](#output-dynamodb-item)"
              }
            ],
            "",
            [
              {
                "annotation_ids": [
                  "00320a1153007f6d",
                  "48a1e26114a0ef20"
                ],
                "status_id": 1,
                "text": "This operation MUST also output a [Parsed Header](#parsed-header) if the following is true:"
              }
            ],
            "",
            [
              {
                "annotation_ids": [
                  "00320a1153007f6d"
                ],
                "status_id": 2,
                "text": "- The operation is not using a [Legacy Policy](./ddb-table-encryption-config.md#legacy-policy) that allows legacy decrypts,"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "  "
              },
              {
                "annotation_ids": [
                  "00320a1153007f6d"
                ],
                "status_id": 2,
                "text": "and the input item is a [legacy item](#determining-legacy-items)."
              }
            ],
            [
              {
                "annotation_ids": [
                  "00320a1153007f6d"
                ],
                "status_id": 2,
                "text": "- The operation is not using a [Plaintext Policy](./ddb-table-encryption-config.md#plaintext-policy) that allows plaintext reads,"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "  "
              },
              {
                "annotation_ids": [
                  "00320a1153007f6d"
                ],
                "status_id": 2,
                "text": "and the input item is a [plaintext item](#determining-plaintext-items)."
              }
            ]
          ],
          "requirements": [
            "175f7a475b882d59",
            "48a1e26114a0ef20"
          ],
          "title": "Output"
        },
        {
          "id": "output-dynamodb-item",
          "lines": [
            "The DynamoDB Item is the decryption of the [input DynamoBD Item](#input dynamodb-item)."
          ],
          "title": "Output DynamoDB Item"
        },
        {
          "id": "parsed-header",
          "lines": [
            [
              {
                "annotation_ids": [
                  "28c9c7378ba1cf48",
                  "7921a22fed1e433c"
                ],
                "status_id": 1,
                "text": "This structure MUST contain the following values,"
              }
            ],
            [
              {
                "annotation_ids": [
                  "28c9c7378ba1cf48",
                  "7921a22fed1e433c"
                ],
                "status_id": 1,
                "text": "representing the deserialized form of the header of the input encrypted structure:"
              }
            ],
            "",
            [
              {
                "annotation_ids": [
                  "28c9c7378ba1cf48"
                ],
                "status_id": 2,
                "text": "- [Algorithm Suite ID](./header.md#format-flavor): The Algorithm Suite ID associated with the Format Flavor on the header."
              }
            ],
            [
              {
                "annotation_ids": [
                  "28c9c7378ba1cf48"
                ],
                "status_id": 2,
                "text": "- [Attribute Actions](./ddb-table-encryption-config.md#attribute-actions): The Crypto Schema for each signed attribute,"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "  "
              },
              {
                "annotation_ids": [
                  "28c9c7378ba1cf48"
                ],
                "status_id": 2,
                "text": "calculated using the Crypto Legend in the header, the signature scope used for decryption, and the data in the structure,"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "  "
              },
              {
                "annotation_ids": [
                  "28c9c7378ba1cf48"
                ],
                "status_id": 2,
                "text": "converted into Attribute Actions."
              }
            ],
            [
              {
                "annotation_ids": [
                  "28c9c7378ba1cf48"
                ],
                "status_id": 2,
                "text": "- [Encrypted Data Keys](./header.md#encrypted-data-keys): The Encrypted Data Keys stored in the header."
              }
            ],
            [
              {
                "annotation_ids": [
                  "28c9c7378ba1cf48"
                ],
                "status_id": 2,
                "text": "- [Stored Encryption Context](../structured-encryption/header.md#encryption-context): The Encryption Context stored in the header."
              }
            ],
            [
              {
                "annotation_ids": [
                  "28c9c7378ba1cf48"
                ],
                "status_id": 2,
                "text": "- [Encryption Context](../structured-encryption/decrypt-structure#encryption-context): The full Encryption Context used."
              }
            ],
            [
              {
                "annotation_ids": [
                  "28c9c7378ba1cf48"
                ],
                "status_id": 2,
                "text": "- Selector Context : the AttributeMap as passed to the [Branch Key Supplier](./ddb-encryption-branch-key-id-supplier.md)"
              }
            ]
          ],
          "requirements": [
            "7921a22fed1e433c",
            "7921a22fed1e433c"
          ],
          "title": "Parsed Header"
        },
        {
          "id": "behavior",
          "lines": [
            [
              {
                "annotation_ids": [
                  "046b7cadce493aaa",
                  "ab66acb2656b4439"
                ],
                "status_id": 7,
                "text": "If a [Legacy Policy](./ddb-table-encryption-config.md#legacy-policy) of"
              }
            ],
            [
              {
                "annotation_ids": [
                  "046b7cadce493aaa",
                  "ab66acb2656b4439"
                ],
                "status_id": 7,
                "text": "`FORBID_LEGACY_ENCRYPT_FORBID_LEGACY_DECRYPT` is configured,"
              }
            ],
            [
              {
                "annotation_ids": [
                  "046b7cadce493aaa",
                  "ab66acb2656b4439"
                ],
                "status_id": 7,
                "text": "and the input item [is an item written in the legacy format](#determining-legacy-items),"
              }
            ],
            [
              {
                "annotation_ids": [
                  "046b7cadce493aaa",
                  "ab66acb2656b4439"
                ],
                "status_id": 7,
                "text": "this operation MUST fail."
              }
            ],
            "",
            [
              {
                "annotation_ids": [
                  "f3e8285467acc596",
                  "8954ccd0215aef4d"
                ],
                "status_id": 7,
                "text": "If a [Legacy Policy](./ddb-table-encryption-config.md#legacy-policy) of"
              }
            ],
            [
              {
                "annotation_ids": [
                  "f3e8285467acc596",
                  "8954ccd0215aef4d"
                ],
                "status_id": 7,
                "text": "`FORCE_LEGACY_ENCRYPT_ALLOW_LEGACY_DECRYPT` or `FORBID_LEGACY_ENCRYPT_ALLOW_LEGACY_DECRYPT` is configured,"
              }
            ],
            [
              {
                "annotation_ids": [
                  "f3e8285467acc596",
                  "8954ccd0215aef4d"
                ],
                "status_id": 7,
                "text": "and the input item [is an item written in the legacy format](#determining-legacy-items),"
              }
            ],
            [
              {
                "annotation_ids": [
                  "f3e8285467acc596",
                  "8954ccd0215aef4d"
                ],
                "status_id": 7,
                "text": "this operation MUST delegate decryption of this item to the"
              }
            ],
            [
              {
                "annotation_ids": [
                  "f3e8285467acc596",
                  "8954ccd0215aef4d"
                ],
                "status_id": 7,
                "text": "[Legacy Encryptor](./ddb-table-encryption-config.md#legacy-encryptor),"
              }
            ],
            [
              {
                "annotation_ids": [
                  "f3e8285467acc596",
                  "8954ccd0215aef4d"
                ],
                "status_id": 7,
                "text": "using the configured [Attribute Flags](./ddb-table-encryption-config.md) as input."
              }
            ],
            [
              {
                "annotation_ids": [
                  "36803997257a495f",
                  "6816aa2450e87b9f"
                ],
                "status_id": 7,
                "text": "The item returned by this operation MUST be the item outputted by the"
              }
            ],
            [
              {
                "annotation_ids": [
                  "36803997257a495f",
                  "6816aa2450e87b9f"
                ],
                "status_id": 7,
                "text": "[Legacy Encryptor](./ddb-table-encryption-config.md#legacy-encryptor)."
              }
            ],
            "Otherwise, this operations continues as follows.",
            "",
            [
              {
                "annotation_ids": [
                  "4bbdc1e891eebd59",
                  "c9a4f291eb3051c5"
                ],
                "status_id": 1,
                "text": "If a [Plaintext Policy](./ddb-table-encryption-config.md#plaintext-policy) of"
              }
            ],
            [
              {
                "annotation_ids": [
                  "4bbdc1e891eebd59",
                  "c9a4f291eb3051c5"
                ],
                "status_id": 1,
                "text": "`FORCE_PLAINTEXT_WRITE_ALLOW_PLAINTEXT_READ` or `FORBID_PLAINTEXT_WRITE_ALLOW_PLAINTEXT_READ` is specified,"
              }
            ],
            [
              {
                "annotation_ids": [
                  "4bbdc1e891eebd59",
                  "c9a4f291eb3051c5"
                ],
                "status_id": 1,
                "text": "and the input item [is a plaintext item](#determining-plaintext-items)"
              }
            ],
            [
              {
                "annotation_ids": [
                  "4bbdc1e891eebd59",
                  "c9a4f291eb3051c5"
                ],
                "status_id": 1,
                "text": "this operation MUST NOT decrypt the input item,"
              }
            ],
            [
              {
                "annotation_ids": [
                  "4bbdc1e891eebd59",
                  "c9a4f291eb3051c5"
                ],
                "status_id": 1,
                "text": "and MUST passthrough that item as the output."
              }
            ],
            "",
            "This behavior REQUIRES a [Structured Data](../structured-encryption/structures.md#structured-data)",
            "which is [converted](./ddb-item-conversion.md) from the [input DynamoDB Item](#input-dynamodb-item).",
            "",
            [
              {
                "annotation_ids": [
                  "04b6b66d85e91b18",
                  "48285b8e4f4e4fa3"
                ],
                "status_id": 7,
                "text": "This operation MUST create a"
              }
            ],
            [
              {
                "annotation_ids": [
                  "04b6b66d85e91b18",
                  "48285b8e4f4e4fa3"
                ],
                "status_id": 7,
                "text": "[Required Encryption Context CMM](https://github.com/awslabs/private-aws-encryption-sdk-specification-staging/blob/dafny-verified/framework/required-encryption-context-cmm.md)"
              }
            ],
            [
              {
                "annotation_ids": [
                  "04b6b66d85e91b18",
                  "48285b8e4f4e4fa3"
                ],
                "status_id": 7,
                "text": "with the following inputs:"
              }
            ],
            "",
            [
              {
                "annotation_ids": [
                  "04b6b66d85e91b18"
                ],
                "status_id": 13,
                "text": "- This item encryptor's [CMM](./ddb-table-encryption-config.md#cmm) as the underlying CMM."
              }
            ],
            [
              {
                "annotation_ids": [
                  "04b6b66d85e91b18"
                ],
                "status_id": 13,
                "text": "- The keys from the [DynamoDB Item Base Context](#dynamodb-item-base-context)."
              }
            ],
            "",
            [
              {
                "annotation_ids": [
                  "9936c35b675e829d",
                  "13f4e9b3a981ffa6"
                ],
                "status_id": 1,
                "text": "Given the converted [Structured Data](../structured-encryption/structures.md#structured-data),"
              }
            ],
            [
              {
                "annotation_ids": [
                  "9936c35b675e829d",
                  "13f4e9b3a981ffa6"
                ],
                "status_id": 1,
                "text": "this operation MUST delegate decryption of this data to"
              }
            ],
            [
              {
                "annotation_ids": [
                  "9936c35b675e829d",
                  "13f4e9b3a981ffa6"
                ],
                "status_id": 1,
                "text": "Structured Encryption Client's [Decrypt Structure](../structured-encryption/encrypt-structure.md),"
              }
            ],
            [
              {
                "annotation_ids": [
                  "9936c35b675e829d",
                  "13f4e9b3a981ffa6"
                ],
                "status_id": 1,
                "text": "with the following inputs:"
              }
            ],
            "",
            [
              {
                "annotation_ids": [
                  "4994a243bc17ff2e",
                  "140f6c007c50aafa"
                ],
                "status_id": 1,
                "text": "- Encrypted Structured Data MUST be the Structured Data converted above."
              }
            ],
            [
              {
                "annotation_ids": [
                  "7d1eee827e1cef95",
                  "6611315c3ecd5ee8"
                ],
                "status_id": 1,
                "text": "- Authenticate Schema MUST be a [Authenticate Schema](../structured-encryption/structures.md#crypto-schema)"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "  "
              },
              {
                "annotation_ids": [
                  "7d1eee827e1cef95",
                  "6611315c3ecd5ee8"
                ],
                "status_id": 1,
                "text": "built with the following requirements:"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "  "
              },
              {
                "annotation_ids": [
                  "763a234594e23165",
                  "ca4446080a50d26a"
                ],
                "status_id": 1,
                "text": "- For every Attribute in the [input DynamoDB Item](#input-dynamodb-item)"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "    "
              },
              {
                "annotation_ids": [
                  "763a234594e23165",
                  "ca4446080a50d26a"
                ],
                "status_id": 1,
                "text": "that is in the [signature scope](#signature-scope),"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "    "
              },
              {
                "annotation_ids": [
                  "763a234594e23165",
                  "ca4446080a50d26a"
                ],
                "status_id": 1,
                "text": "there MUST exist a [SIGN Authenticate Action](../structured-encryption/structures.md#sign)"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "    "
              },
              {
                "annotation_ids": [
                  "763a234594e23165",
                  "ca4446080a50d26a"
                ],
                "status_id": 1,
                "text": "in the Authenticate Schema,"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "    "
              },
              {
                "annotation_ids": [
                  "763a234594e23165",
                  "ca4446080a50d26a"
                ],
                "status_id": 1,
                "text": "string indexed at the top level by that attribute name."
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "  "
              },
              {
                "annotation_ids": [
                  "975f7e3cfa953d5f",
                  "261a5271e51fb8d7"
                ],
                "status_id": 1,
                "text": "- For every Attribute in the [input DynamoDB Item](#input-dynamodb-item)"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "    "
              },
              {
                "annotation_ids": [
                  "975f7e3cfa953d5f",
                  "261a5271e51fb8d7"
                ],
                "status_id": 1,
                "text": "that is not in the [signature scope](#signature-scope),"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "    "
              },
              {
                "annotation_ids": [
                  "975f7e3cfa953d5f",
                  "261a5271e51fb8d7"
                ],
                "status_id": 1,
                "text": "there MUST exist a [DO_NOT_SIGN Authenticate Action](../structured-encryption/structures.md#do_not_sign)"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "    "
              },
              {
                "annotation_ids": [
                  "975f7e3cfa953d5f",
                  "261a5271e51fb8d7"
                ],
                "status_id": 1,
                "text": "in the Authenticate Schema,"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "    "
              },
              {
                "annotation_ids": [
                  "975f7e3cfa953d5f",
                  "261a5271e51fb8d7"
                ],
                "status_id": 1,
                "text": "string indexed at the top level by that attribute name."
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "  "
              },
              {
                "annotation_ids": [
                  "84fdf0bf7d29e6a7",
                  "72bc929f5fa7572c"
                ],
                "status_id": 1,
                "text": "- The number of Authenticate Actions in the Authenticate Schema"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "    "
              },
              {
                "annotation_ids": [
                  "84fdf0bf7d29e6a7",
                  "72bc929f5fa7572c"
                ],
                "status_id": 1,
                "text": "MUST EQUAL the number of Attributes on the [input DynamoDB Item](#input-dynamodb-item)."
              }
            ],
            [
              {
                "annotation_ids": [
                  "327587ee87c46a48",
                  "e7bb4d0822e176ee"
                ],
                "status_id": 1,
                "text": "- Encryption Context MUST be the input Item's [DynamoDB Item Base Context](./encrypt-item.md#dynamodb-item-base-context)."
              }
            ],
            [
              {
                "annotation_ids": [
                  "cc110143e1ecfc74",
                  "114b512c854c7704"
                ],
                "status_id": 7,
                "text": "- CMM MUST be the CMM constructed above."
              }
            ],
            "",
            "The output to this behavior is the [conversion](./ddb-item-conversion.md)",
            "of the decrypted Structured Data determined above",
            "into the [output DynamoDB Item](./encrypt-item.md#encrypted-dynamodb-item).",
            "",
            [
              {
                "annotation_ids": [
                  "2c80890038f636e8",
                  "0f57cf5d2ba77a2f"
                ],
                "status_id": 1,
                "text": "The output MUST also include a [Parsed Header](#parsed-header) that contains"
              }
            ],
            [
              {
                "annotation_ids": [
                  "2c80890038f636e8",
                  "0f57cf5d2ba77a2f"
                ],
                "status_id": 1,
                "text": "data that was serialized into the header included in the output DynamoDb Item."
              }
            ]
          ],
          "requirements": [
            "ab66acb2656b4439",
            "ab66acb2656b4439",
            "ab66acb2656b4439",
            "ab66acb2656b4439",
            "8954ccd0215aef4d",
            "8954ccd0215aef4d",
            "8954ccd0215aef4d",
            "8954ccd0215aef4d",
            "8954ccd0215aef4d",
            "8954ccd0215aef4d",
            "6816aa2450e87b9f",
            "6816aa2450e87b9f",
            "c9a4f291eb3051c5",
            "c9a4f291eb3051c5",
            "c9a4f291eb3051c5",
            "c9a4f291eb3051c5",
            "c9a4f291eb3051c5",
            "48285b8e4f4e4fa3",
            "48285b8e4f4e4fa3",
            "48285b8e4f4e4fa3",
            "13f4e9b3a981ffa6",
            "13f4e9b3a981ffa6",
            "13f4e9b3a981ffa6",
            "13f4e9b3a981ffa6",
            "140f6c007c50aafa",
            "6611315c3ecd5ee8",
            "6611315c3ecd5ee8",
            "ca4446080a50d26a",
            "ca4446080a50d26a",
            "ca4446080a50d26a",
            "ca4446080a50d26a",
            "ca4446080a50d26a",
            "261a5271e51fb8d7",
            "261a5271e51fb8d7",
            "261a5271e51fb8d7",
            "261a5271e51fb8d7",
            "261a5271e51fb8d7",
            "72bc929f5fa7572c",
            "72bc929f5fa7572c",
            "e7bb4d0822e176ee",
            "114b512c854c7704",
            "0f57cf5d2ba77a2f",
            "0f57cf5d2ba77a2f"
          ],
          "title": "Behavior"
        },
        {
          "id": "dynamodb-item-base-context",
          "lines": [
            [
              {
                "annotation_ids": [
                  "9f53d5abf796760f",
                  "0ece7cb32f374d9f"
                ],
                "status_id": 1,
                "text": "The item to be encrypted MUST have an attribute named `aws_dbe_head`."
              }
            ],
            "",
            [
              {
                "annotation_ids": [
                  "9d814729f347175a",
                  "6d35874829ee92aa"
                ],
                "status_id": 1,
                "text": "The attribute named `aws_dbe_head` MUST be of type `B` Binary."
              }
            ],
            "",
            "The first byte of that value is the Version Number.",
            "",
            [
              {
                "annotation_ids": [
                  "1fc35fcac7d4b4b7",
                  "08e839a0a245dc34"
                ],
                "status_id": 1,
                "text": "If the Version Number is 2, then the base context MUST be the [version 2](./encrypt-item.md#dynamodb-item-base-context-version-2) context."
              }
            ],
            "",
            [
              {
                "annotation_ids": [
                  "6eee074af08df2b3",
                  "9bd8f85ce48dab47"
                ],
                "status_id": 1,
                "text": "If the Version Number is 1, the base context MUST be the [version 1](./encrypt-item.md#dynamodb-item-base-context-version-1) context."
              }
            ],
            "",
            [
              {
                "annotation_ids": [
                  "1b5b038d3d0335ce",
                  "ff2915af639e5eba"
                ],
                "status_id": 1,
                "text": "If the Version Number is not 1 or 2, the operation MUST return an error."
              }
            ]
          ],
          "requirements": [
            "0ece7cb32f374d9f",
            "6d35874829ee92aa",
            "08e839a0a245dc34",
            "9bd8f85ce48dab47",
            "ff2915af639e5eba"
          ],
          "title": "DynamoDB Item Base Context"
        },
        {
          "id": "signature-scope",
          "lines": [
            "The Signature Scope is a client-side configuration of what attributes should be",
            "included within signature calculations whenever encrypting or decrypting items.",
            "",
            [
              {
                "annotation_ids": [
                  "bc00381e4e759ee5",
                  "ed82e93166651311"
                ],
                "status_id": 1,
                "text": "An Attribute on a DynamoDB Item MUST NOT be considered as within the signature scope"
              }
            ],
            [
              {
                "annotation_ids": [
                  "bc00381e4e759ee5",
                  "ed82e93166651311"
                ],
                "status_id": 1,
                "text": "if it's Attribute Name is included in [Unauthenticated Attributes](./ddb-table-encryption-config.md#unauthenticated-attributes)"
              }
            ],
            [
              {
                "annotation_ids": [
                  "bc00381e4e759ee5",
                  "ed82e93166651311"
                ],
                "status_id": 1,
                "text": "or if it's Attribute Name begins with the prefix specified in"
              }
            ],
            [
              {
                "annotation_ids": [
                  "bc00381e4e759ee5",
                  "ed82e93166651311"
                ],
                "status_id": 1,
                "text": "[Unauthenticated Attribute Prefix](./ddb-table-encryption-config.md#unauthenticated-attribute-prefix)."
              }
            ],
            [
              {
                "annotation_ids": [
                  "8423ff3931084da7",
                  "668fbbee0d0188d3"
                ],
                "status_id": 1,
                "text": "Otherwise, Attributes MUST be considered as within the signature scope."
              }
            ],
            "",
            [
              {
                "annotation_ids": [
                  "185ef89888ebccd2",
                  "e58a6477b39bd6be",
                  "f6f82a2f0fa39ac4"
                ],
                "status_id": 11,
                "text": "If an Authenticate Action other than DO_NOTHING is configured for an attribute name included in [Unauthenticated Attributes](./ddb-table-encryption-config.md#unauthenticated-attributes)"
              }
            ],
            [
              {
                "annotation_ids": [
                  "185ef89888ebccd2",
                  "e58a6477b39bd6be",
                  "f6f82a2f0fa39ac4"
                ],
                "status_id": 11,
                "text": "or beginning with the prefix specified in [Unauthenticated Attribute Prefix](./ddb-table-encryption-config.md#unauthenticated-attribute-prefix),"
              }
            ],
            [
              {
                "annotation_ids": [
                  "185ef89888ebccd2",
                  "e58a6477b39bd6be",
                  "f6f82a2f0fa39ac4"
                ],
                "status_id": 11,
                "text": "this operation MUST yield an error."
              }
            ]
          ],
          "requirements": [
            "ed82e93166651311",
            "ed82e93166651311",
            "ed82e93166651311",
            "ed82e93166651311",
            "668fbbee0d0188d3",
            "f6f82a2f0fa39ac4",
            "f6f82a2f0fa39ac4",
            "f6f82a2f0fa39ac4"
          ],
          "title": "Signature Scope"
        },
        {
          "id": "determining-legacy-items",
          "lines": [
            [
              {
                "annotation_ids": [
                  "a772cceea5a94185",
                  "c1a6b663de7c5b65"
                ],
                "status_id": 7,
                "text": "An item MUST be determined to be encrypted under the legacy format if it contains"
              }
            ],
            [
              {
                "annotation_ids": [
                  "a772cceea5a94185",
                  "c1a6b663de7c5b65"
                ],
                "status_id": 7,
                "text": "attributes for the material description and the signature."
              }
            ],
            "These are usually \"_amzn-ddb-map-desc_\" and \"_amzn-ddb-map-sig_\" respectively,",
            "although the DynamoDbEncryptor allows callers to configure custom names for these attributes."
          ],
          "requirements": [
            "c1a6b663de7c5b65",
            "c1a6b663de7c5b65"
          ],
          "title": "Determining Legacy Items"
        },
        {
          "id": "determining-plaintext-items",
          "lines": [
            [
              {
                "annotation_ids": [
                  "3b5e084a4b9476fa",
                  "3933c53070e82585"
                ],
                "status_id": 1,
                "text": "An item MUST be determined to be plaintext if it does not contain"
              }
            ],
            [
              {
                "annotation_ids": [
                  "3b5e084a4b9476fa",
                  "3933c53070e82585"
                ],
                "status_id": 1,
                "text": "attributes with the names \"aws_dbe_head\" and \"aws_dbe_foot\"."
              }
            ],
            "",
            "Note that this does not conflict with the [legacy item](#determining-legacy-items) definition,",
            "as there is no configuration state which needs to be able to distinguish",
            "between legacy items and plaintext items."
          ],
          "requirements": [
            "3933c53070e82585",
            "3933c53070e82585"
          ],
          "title": "Determining Plaintext Items"
        }
      ],
      "title": "Decrypt Item"
    },
    "specification/dynamodb-encryption-client/encrypt-item.md": {
      "format": "markdown",
      "sections": [
        {
          "id": "encrypt-item",
          "lines": [],
          "title": "Encrypt Item"
        },
        {
          "id": "version",
          "lines": [
            "1.0.0"
          ],
          "title": "Version"
        },
        {
          "id": "changelog",
          "lines": [
            "- 1.0.0",
            "",
            "  - Initial record"
          ],
          "title": "Changelog"
        },
        {
          "id": "definitions",
          "lines": [],
          "title": "Definitions"
        },
        {
          "id": "conventions-used-in-this-document",
          "lines": [
            "The key words \"MUST\", \"MUST NOT\", \"REQUIRED\", \"SHALL\", \"SHALL NOT\", \"SHOULD\", \"SHOULD NOT\", \"RECOMMENDED\", \"MAY\", and \"OPTIONAL\"",
            "in this document are to be interpreted as described in [RFC 2119](https://tools.ietf.org/html/rfc2119)."
          ],
          "title": "Conventions used in this document"
        },
        {
          "id": "overview",
          "lines": [
            "This document describes the behavior by which the [DynamoDB Item Encryptor](./ddb-item-encryptor.md)",
            "produces an encrypted form of a DynamoDB Item for a particular DynamoDB Table."
          ],
          "title": "Overview"
        },
        {
          "id": "input",
          "lines": [
            [
              {
                "annotation_ids": [
                  "24eadd21a50e865d",
                  "9d14d06e4ee272ba"
                ],
                "status_id": 1,
                "text": "The following inputs to this behavior are REQUIRED:"
              }
            ],
            "",
            [
              {
                "annotation_ids": [
                  "24eadd21a50e865d"
                ],
                "status_id": 2,
                "text": "- DynamoDB Item"
              }
            ]
          ],
          "requirements": [
            "9d14d06e4ee272ba"
          ],
          "title": "Input"
        },
        {
          "id": "dynamodb-item",
          "lines": [
            "The DynamoDB Item is the plaintext item to be encrypted by this behavior.",
            "",
            [
              {
                "annotation_ids": [
                  "aeb5344709842c35",
                  "39b810105c154fb3"
                ],
                "status_id": 1,
                "text": "This item MUST include an Attribute with a name that matches the"
              }
            ],
            [
              {
                "annotation_ids": [
                  "aeb5344709842c35",
                  "39b810105c154fb3"
                ],
                "status_id": 1,
                "text": "[DynamoDB Partition Key Name](./ddb-table-encryption-config.md#dynamodb-partition-key-name)"
              }
            ],
            [
              {
                "annotation_ids": [
                  "aeb5344709842c35",
                  "39b810105c154fb3"
                ],
                "status_id": 1,
                "text": "configured on the [DynamoDB Item Encryptor](./ddb-item-encryptor.md)."
              }
            ],
            [
              {
                "annotation_ids": [
                  "10419e830da99c53",
                  "db249d8d5b5f88fe"
                ],
                "status_id": 1,
                "text": "Otherwise this operation MUST yield an error."
              }
            ],
            "",
            [
              {
                "annotation_ids": [
                  "d47edba2778657f0",
                  "e7aa24a9281221e0"
                ],
                "status_id": 1,
                "text": "If the [DynamoDB Item Encryptor](./ddb-item-encryptor.md)"
              }
            ],
            [
              {
                "annotation_ids": [
                  "d47edba2778657f0",
                  "e7aa24a9281221e0"
                ],
                "status_id": 1,
                "text": "has a [DynamoDB Sort Key Name](./ddb-table-encryption-config.md#dynamodb-sort-key-name) configured,"
              }
            ],
            [
              {
                "annotation_ids": [
                  "d47edba2778657f0",
                  "e7aa24a9281221e0"
                ],
                "status_id": 1,
                "text": "this item MUST include an Attribute with that name."
              }
            ],
            "Otherwise this operation MUST yield an error.",
            "",
            [
              {
                "annotation_ids": [
                  "83c56038244919a9",
                  "942944f341b18c2f"
                ],
                "status_id": 1,
                "text": "If the [DynamoDB Item Encryptor](./ddb-item-encryptor.md)"
              }
            ],
            [
              {
                "annotation_ids": [
                  "83c56038244919a9",
                  "942944f341b18c2f"
                ],
                "status_id": 1,
                "text": "has any attribute configured as"
              }
            ],
            [
              {
                "annotation_ids": [
                  "83c56038244919a9",
                  "942944f341b18c2f"
                ],
                "status_id": 1,
                "text": "[SIGN_AND_INCLUDE_IN_ENCRYPTION_CONTEXT](../structured-encryption/structures.md#contextandsign)"
              }
            ],
            [
              {
                "annotation_ids": [
                  "83c56038244919a9",
                  "942944f341b18c2f"
                ],
                "status_id": 1,
                "text": "then this item MUST include an Attribute with that name."
              }
            ]
          ],
          "requirements": [
            "39b810105c154fb3",
            "39b810105c154fb3",
            "39b810105c154fb3",
            "db249d8d5b5f88fe",
            "e7aa24a9281221e0",
            "e7aa24a9281221e0",
            "e7aa24a9281221e0",
            "942944f341b18c2f",
            "942944f341b18c2f",
            "942944f341b18c2f",
            "942944f341b18c2f"
          ],
          "title": "DynamoDB Item"
        },
        {
          "id": "output",
          "lines": [
            [
              {
                "annotation_ids": [
                  "b80e61bd4486d719"
                ],
                "status_id": 8,
                "text": "This operation MUST output the following:"
              }
            ],
            "",
            "- [Encrypted DynamoDB Item](#encrypted-dynamodb-item)",
            "",
            [
              {
                "annotation_ids": [
                  "0507bc72e00f146c"
                ],
                "status_id": 8,
                "text": "This operation MUST also output a [Parsed Header](#parsed-header) if the following is true:"
              }
            ],
            "",
            "- The operation is not using a [Legacy Policy](./ddb-table-encryption-config.md#legacy-policy) that allows legacy decrypts,",
            "  and the input item is a [legacy item](./decrypt-item.md#determining-legacy-items).",
            "- The operation is not using a [Plaintext Policy](./ddb-table-encryption-config.md#plaintext-policy) that allows plaintext reads,",
            "  and the input item is a [plaintext item](./decrypt-item.md#determining-plaintext-items)."
          ],
          "requirements": [
            "b80e61bd4486d719",
            "0507bc72e00f146c"
          ],
          "title": "Output"
        },
        {
          "id": "encrypted-dynamodb-item",
          "lines": [
            "The Encrypted DynamoDB Item is a DynamoBD Item that is",
            "the encrypted form of the [input DynamoDB Item](#dynamodb-item)."
          ],
          "title": "Encrypted DynamoDB Item"
        },
        {
          "id": "parsed-header",
          "lines": [
            [
              {
                "annotation_ids": [
                  "bc45b3ed4763a34f"
                ],
                "status_id": 8,
                "text": "This structure MUST contain the following values,"
              }
            ],
            [
              {
                "annotation_ids": [
                  "bc45b3ed4763a34f"
                ],
                "status_id": 8,
                "text": "representing the deserialized form of the header of the input encrypted structure:"
              }
            ],
            "",
            "- [Algorithm Suite ID](./header.md#format-flavor): The Algorithm Suite ID associated with the Format Flavor on the header.",
            "- [Attribute Actions](./ddb-table-encryption-config.md#attribute-actions): The Crypto Schema for each signed attribute,",
            "  calculated using the Crypto Legend in the header, the signature scope used for decryption, and the data in the structure,",
            "  converted into Attribute Actions.",
            "- [Encrypted Data Keys](./header.md#encrypted-data-keys): The Encrypted Data Keys stored in the header."
          ],
          "requirements": [
            "bc45b3ed4763a34f",
            "bc45b3ed4763a34f"
          ],
          "title": "Parsed Header"
        },
        {
          "id": "behavior",
          "lines": [
            [
              {
                "annotation_ids": [
                  "b29b2e07dffaa1c8",
                  "718d241d2696175f"
                ],
                "status_id": 7,
                "text": "If a [Legacy Policy](./ddb-table-encryption-config.md#legacy-policy) of"
              }
            ],
            [
              {
                "annotation_ids": [
                  "b29b2e07dffaa1c8",
                  "718d241d2696175f"
                ],
                "status_id": 7,
                "text": "`FORCE_LEGACY_ENCRYPT_ALLOW_LEGACY_DECRYPT` is specified,"
              }
            ],
            [
              {
                "annotation_ids": [
                  "b29b2e07dffaa1c8",
                  "718d241d2696175f"
                ],
                "status_id": 7,
                "text": "this operation MUST delegate encryption of this item to the"
              }
            ],
            [
              {
                "annotation_ids": [
                  "b29b2e07dffaa1c8",
                  "718d241d2696175f"
                ],
                "status_id": 7,
                "text": "[Legacy Encryptor](./ddb-table-encryption-config.md#legacy-encryptor),"
              }
            ],
            [
              {
                "annotation_ids": [
                  "b29b2e07dffaa1c8",
                  "718d241d2696175f"
                ],
                "status_id": 7,
                "text": "using the configured [Attribute Flags](./ddb-table-encryption-config.md) as input."
              }
            ],
            [
              {
                "annotation_ids": [
                  "4f7d37b270565080",
                  "4cd050ff5cc1c5f4"
                ],
                "status_id": 7,
                "text": "The item returned by this operation MUST be the item outputted by the"
              }
            ],
            [
              {
                "annotation_ids": [
                  "4f7d37b270565080",
                  "4cd050ff5cc1c5f4"
                ],
                "status_id": 7,
                "text": "[Legacy Encryptor](./ddb-table-encryption-config.md#legacy-encryptor)."
              }
            ],
            "Otherwise, this operations continues as follows.",
            "",
            [
              {
                "annotation_ids": [
                  "73593ea2de1412db",
                  "5dd32be041045e6f"
                ],
                "status_id": 1,
                "text": "If a [Plaintext Policy](./ddb-table-encryption-config.md#plaintext-policy) of"
              }
            ],
            [
              {
                "annotation_ids": [
                  "73593ea2de1412db",
                  "5dd32be041045e6f"
                ],
                "status_id": 1,
                "text": "`FORCE_PLAINTEXT_WRITE_ALLOW_PLAINTEXT_READ` is specified,"
              }
            ],
            [
              {
                "annotation_ids": [
                  "73593ea2de1412db",
                  "5dd32be041045e6f"
                ],
                "status_id": 1,
                "text": "this operation MUST NOT encrypt the input item,"
              }
            ],
            [
              {
                "annotation_ids": [
                  "73593ea2de1412db",
                  "5dd32be041045e6f"
                ],
                "status_id": 1,
                "text": "and MUST passthrough that item as the output."
              }
            ],
            "",
            [
              {
                "annotation_ids": [
                  "93da3749e13ab20e",
                  "bc79840d9beb01d3"
                ],
                "status_id": 1,
                "text": "The [Attributes Actions](./ddb-table-encryption-config.md#attribute-actions)"
              }
            ],
            [
              {
                "annotation_ids": [
                  "93da3749e13ab20e",
                  "bc79840d9beb01d3"
                ],
                "status_id": 1,
                "text": "configured on this Item Encryptor MUST specify a Crypto Action"
              }
            ],
            [
              {
                "annotation_ids": [
                  "93da3749e13ab20e",
                  "bc79840d9beb01d3"
                ],
                "status_id": 1,
                "text": "for every attribute in the [input DynamoDB Item](#dynamodb-item)"
              }
            ],
            [
              {
                "annotation_ids": [
                  "93da3749e13ab20e",
                  "bc79840d9beb01d3"
                ],
                "status_id": 1,
                "text": "(Attribute Actions MAY specify a Crypto Action for an attribute not"
              }
            ],
            [
              {
                "annotation_ids": [
                  "93da3749e13ab20e",
                  "bc79840d9beb01d3"
                ],
                "status_id": 1,
                "text": "in the input DynamoDB Item)."
              }
            ],
            "",
            "This behavior REQUIRES a [Structured Data](../structured-encryption/structures.md#structured-data)",
            "which is [converted](./ddb-item-conversion.md) from the [input DynamoDB Item](#dynamodb-item).",
            "",
            [
              {
                "annotation_ids": [
                  "d6dc93f1dad992be",
                  "073c6ec1ff1ef84c"
                ],
                "status_id": 7,
                "text": "This operation MUST create a"
              }
            ],
            [
              {
                "annotation_ids": [
                  "d6dc93f1dad992be",
                  "073c6ec1ff1ef84c"
                ],
                "status_id": 7,
                "text": "[Required Encryption Context CMM](https://github.com/awslabs/private-aws-encryption-sdk-specification-staging/blob/dafny-verified/framework/required-encryption-context-cmm.md)"
              }
            ],
            [
              {
                "annotation_ids": [
                  "d6dc93f1dad992be",
                  "073c6ec1ff1ef84c"
                ],
                "status_id": 7,
                "text": "with the following inputs:"
              }
            ],
            "",
            [
              {
                "annotation_ids": [
                  "d6dc93f1dad992be"
                ],
                "status_id": 13,
                "text": "- This item encryptor's [CMM](./ddb-table-encryption-config.md#cmm) as the underlying CMM."
              }
            ],
            [
              {
                "annotation_ids": [
                  "d6dc93f1dad992be"
                ],
                "status_id": 13,
                "text": "- The keys from the [DynamoDB Item Base Context](#dynamodb-item-base-context)"
              }
            ],
            "",
            [
              {
                "annotation_ids": [
                  "2cdf393f3d29bdf8",
                  "fd7f70c6f0d386fc"
                ],
                "status_id": 1,
                "text": "Given the converted [Structured Data](../structured-encryption/structures.md#structured-data),"
              }
            ],
            [
              {
                "annotation_ids": [
                  "2cdf393f3d29bdf8",
                  "fd7f70c6f0d386fc"
                ],
                "status_id": 1,
                "text": "this operation MUST delegate encryption of this data to"
              }
            ],
            [
              {
                "annotation_ids": [
                  "2cdf393f3d29bdf8",
                  "fd7f70c6f0d386fc"
                ],
                "status_id": 1,
                "text": "Structured Encryption Client's [Encrypt Structure](../structured-encryption/encrypt-structure.md),"
              }
            ],
            [
              {
                "annotation_ids": [
                  "2cdf393f3d29bdf8",
                  "fd7f70c6f0d386fc"
                ],
                "status_id": 1,
                "text": "with the following inputs:"
              }
            ],
            "",
            [
              {
                "annotation_ids": [
                  "0053ee920bb4a1e2",
                  "1ff0b5285f29bbe4"
                ],
                "status_id": 1,
                "text": "- Structured Data MUST be the Structured Data converted above."
              }
            ],
            [
              {
                "annotation_ids": [
                  "4f53b59b3af253ea",
                  "6fb9d190ac6efc8e"
                ],
                "status_id": 1,
                "text": "- Crypto Schema MUST be a [Crypto Schema](../structured-encryption/structures.md#crypto-schema)"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "  "
              },
              {
                "annotation_ids": [
                  "4f53b59b3af253ea",
                  "6fb9d190ac6efc8e"
                ],
                "status_id": 1,
                "text": "analogous to the [configured Attribute Actions](./ddb-table-encryption-config.md#attribute-actions)."
              }
            ],
            "  More specifically:",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "  "
              },
              {
                "annotation_ids": [
                  "4fc9e4d3f3d336ba",
                  "3e9656f786d88114"
                ],
                "status_id": 1,
                "text": "- For every attribute on the input Item,"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "    "
              },
              {
                "annotation_ids": [
                  "4fc9e4d3f3d336ba",
                  "3e9656f786d88114"
                ],
                "status_id": 1,
                "text": "there MUST exist a Crypto Action in the Crypto Schema"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "    "
              },
              {
                "annotation_ids": [
                  "4fc9e4d3f3d336ba",
                  "3e9656f786d88114"
                ],
                "status_id": 1,
                "text": "such that the Crypto Action indexed by that attribute name in the Crypto Schema"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "    "
              },
              {
                "annotation_ids": [
                  "4fc9e4d3f3d336ba",
                  "3e9656f786d88114"
                ],
                "status_id": 1,
                "text": "equals the Crypto Action indexed by that attribute name in the configured Attribute Actions."
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "  "
              },
              {
                "annotation_ids": [
                  "38d9941c89167edb",
                  "dcc7e4f242d02bc4"
                ],
                "status_id": 1,
                "text": "- The Crypto Schema MUST NOT contain more Crypto Actions than those specified by the previous point."
              }
            ],
            "    E.g. the Crypto Schema must not specify actions for attributes that don't exist on the item.",
            [
              {
                "annotation_ids": [
                  "a511c68ffa96d98f",
                  "93f92cf2c010b059"
                ],
                "status_id": 7,
                "text": "- If configured, the Algorithm Suite MUST be the"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "  "
              },
              {
                "annotation_ids": [
                  "a511c68ffa96d98f",
                  "93f92cf2c010b059"
                ],
                "status_id": 7,
                "text": "[Algorithm Suite configured on this Item Encryptor](./ddb-table-encryption-config.md#algorithm-suite)."
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "  "
              },
              {
                "annotation_ids": [
                  "2b6e7bccc8043198",
                  "137a020ccd202ebc"
                ],
                "status_id": 7,
                "text": "If not configured on the Item Encryptor, Algorithm Suite MUST NOT be specified."
              }
            ],
            [
              {
                "annotation_ids": [
                  "76a9bc225b5d00ad",
                  "123a301f9e3d1dab"
                ],
                "status_id": 1,
                "text": "- Encryption Context MUST be this input Item's [DynamoDB Item Base Context](#dynamodb-item-base-context)."
              }
            ],
            [
              {
                "annotation_ids": [
                  "992ac23dc251c37e",
                  "a89c397eb7fdd5ee"
                ],
                "status_id": 7,
                "text": "- The CMM MUST be the CMM created above."
              }
            ],
            "",
            "The output to this behavior is the [conversion](./ddb-item-conversion.md)",
            "of the Encrypted Structured Data determined above",
            "into the [Encrypted DynamoDB Item](#encrypted-dynamodb-item)."
          ],
          "requirements": [
            "718d241d2696175f",
            "718d241d2696175f",
            "718d241d2696175f",
            "718d241d2696175f",
            "718d241d2696175f",
            "4cd050ff5cc1c5f4",
            "4cd050ff5cc1c5f4",
            "5dd32be041045e6f",
            "5dd32be041045e6f",
            "5dd32be041045e6f",
            "5dd32be041045e6f",
            "bc79840d9beb01d3",
            "bc79840d9beb01d3",
            "bc79840d9beb01d3",
            "bc79840d9beb01d3",
            "bc79840d9beb01d3",
            "073c6ec1ff1ef84c",
            "073c6ec1ff1ef84c",
            "073c6ec1ff1ef84c",
            "fd7f70c6f0d386fc",
            "fd7f70c6f0d386fc",
            "fd7f70c6f0d386fc",
            "fd7f70c6f0d386fc",
            "1ff0b5285f29bbe4",
            "6fb9d190ac6efc8e",
            "6fb9d190ac6efc8e",
            "3e9656f786d88114",
            "3e9656f786d88114",
            "3e9656f786d88114",
            "3e9656f786d88114",
            "dcc7e4f242d02bc4",
            "93f92cf2c010b059",
            "93f92cf2c010b059",
            "137a020ccd202ebc",
            "123a301f9e3d1dab",
            "a89c397eb7fdd5ee"
          ],
          "title": "Behavior"
        },
        {
          "id": "dynamodb-item-base-context",
          "lines": [
            [
              {
                "annotation_ids": [
                  "31ff993072084cff",
                  "bfa1699acbf23b32"
                ],
                "status_id": 1,
                "text": "If the [Configuration Version](./ddb-table-encryption-config.md#configuration-version) is 2,"
              }
            ],
            [
              {
                "annotation_ids": [
                  "31ff993072084cff",
                  "bfa1699acbf23b32"
                ],
                "status_id": 1,
                "text": "then the base context MUST be the [version 2](#dynamodb-item-base-context-version-2) context;"
              }
            ],
            [
              {
                "annotation_ids": [
                  "31ff993072084cff",
                  "bfa1699acbf23b32"
                ],
                "status_id": 1,
                "text": "otherwise, the base context MUST be the [version 1](#dynamodb-item-base-context-version-1) context."
              }
            ]
          ],
          "requirements": [
            "bfa1699acbf23b32",
            "bfa1699acbf23b32",
            "bfa1699acbf23b32"
          ],
          "title": "DynamoDB Item Base Context"
        },
        {
          "id": "dynamodb-item-base-context-version-1",
          "lines": [
            "A DynamoDB Item Base Context is a map of string key-values pairs",
            "that contains information related to a particular DynamoDB Item.",
            "",
            [
              {
                "annotation_ids": [
                  "be4102704b8ccbaf",
                  "4ba772f3549d2483"
                ],
                "status_id": 1,
                "text": "The DynamoDB Item Base Context MUST contain:"
              }
            ],
            "",
            [
              {
                "annotation_ids": [
                  "be4102704b8ccbaf"
                ],
                "status_id": 2,
                "text": "- the key \"aws-crypto-table-name\" with a value equal to the configured"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "  "
              },
              {
                "annotation_ids": [
                  "be4102704b8ccbaf"
                ],
                "status_id": 2,
                "text": "[logical table name](./ddb-table-encryption-config.md#logical-table-name)."
              }
            ],
            [
              {
                "annotation_ids": [
                  "be4102704b8ccbaf"
                ],
                "status_id": 2,
                "text": "- the key \"aws-crypto-partition-name\" with a value equal to the name of the Partition Key on this item."
              }
            ],
            [
              {
                "annotation_ids": [
                  "be4102704b8ccbaf"
                ],
                "status_id": 2,
                "text": "- the [value](#base-context-value-version-1) of the Partition Key."
              }
            ],
            "",
            [
              {
                "annotation_ids": [
                  "128e6ee77204f0ca",
                  "0058fd6b726a0489"
                ],
                "status_id": 1,
                "text": "If this item has a Sort Key attribute, the DynamoDB Item Base Context MUST contain:"
              }
            ],
            "",
            [
              {
                "annotation_ids": [
                  "128e6ee77204f0ca"
                ],
                "status_id": 2,
                "text": "- the key \"aws-crypto-sort-name\" with a value equal to the [DynamoDB Sort Key Name](./ddb-table-encryption-config.md#dynamodb-sort-key-name)."
              }
            ],
            [
              {
                "annotation_ids": [
                  "128e6ee77204f0ca"
                ],
                "status_id": 2,
                "text": "- the [value](#base-context-value-version-1) of the Sort Key."
              }
            ],
            "",
            [
              {
                "annotation_ids": [
                  "705fac3e0c1fdf12",
                  "239f89755f84deee"
                ],
                "status_id": 1,
                "text": "If this item does not have a sort key attribute,"
              }
            ],
            [
              {
                "annotation_ids": [
                  "705fac3e0c1fdf12",
                  "239f89755f84deee"
                ],
                "status_id": 1,
                "text": "the DynamoDB Item Context MUST NOT contain the key `aws-crypto-sort-name`."
              }
            ]
          ],
          "requirements": [
            "4ba772f3549d2483",
            "0058fd6b726a0489",
            "239f89755f84deee",
            "239f89755f84deee"
          ],
          "title": "DynamoDB Item Base Context Version 1"
        },
        {
          "id": "dynamodb-item-base-context-version-2",
          "lines": [
            "A DynamoDB Item Base Context is a map of string key-values pairs",
            "that contains information related to a particular DynamoDB Item.",
            "",
            [
              {
                "annotation_ids": [
                  "1fb81fdd446bee1e",
                  "2b7204efe3646152"
                ],
                "status_id": 1,
                "text": "The DynamoDB Item Base Context MUST contain:"
              }
            ],
            "",
            [
              {
                "annotation_ids": [
                  "1fb81fdd446bee1e"
                ],
                "status_id": 2,
                "text": "- the key \"aws-crypto-table-name\" with a value equal to the DynamoDB Table Name of the DynamoDB Table"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "  "
              },
              {
                "annotation_ids": [
                  "1fb81fdd446bee1e"
                ],
                "status_id": 2,
                "text": "this item is stored in (or will be stored in)."
              }
            ],
            [
              {
                "annotation_ids": [
                  "1fb81fdd446bee1e"
                ],
                "status_id": 2,
                "text": "- the key \"aws-crypto-partition-name\" with a value equal to the name of the Partition Key on this item."
              }
            ],
            "",
            [
              {
                "annotation_ids": [
                  "1bca4c1d6b127182",
                  "8ff225a89b1eb07c"
                ],
                "status_id": 1,
                "text": "If this item has a Sort Key attribute, the DynamoDB Item Base Context MUST contain:"
              }
            ],
            "",
            [
              {
                "annotation_ids": [
                  "1bca4c1d6b127182"
                ],
                "status_id": 2,
                "text": "- the key \"aws-crypto-sort-name\" with a value equal to the [DynamoDB Sort Key Name](./ddb-table-encryption-config.md#dynamodb-sort-key-name)."
              }
            ],
            "",
            [
              {
                "annotation_ids": [
                  "23786baaab8ecb36",
                  "d594ce8987f00c63"
                ],
                "status_id": 1,
                "text": "If this item does not have a sort key attribute,"
              }
            ],
            [
              {
                "annotation_ids": [
                  "23786baaab8ecb36",
                  "d594ce8987f00c63"
                ],
                "status_id": 1,
                "text": "the DynamoDB Item Context MUST NOT contain the key `aws-crypto-sort-name`."
              }
            ]
          ],
          "requirements": [
            "2b7204efe3646152",
            "8ff225a89b1eb07c",
            "d594ce8987f00c63",
            "d594ce8987f00c63"
          ],
          "title": "DynamoDB Item Base Context Version 2"
        },
        {
          "id": "base-context-value-version-1",
          "lines": [
            [
              {
                "annotation_ids": [
                  "0f343b8833bc3ded"
                ],
                "status_id": 8,
                "text": "The key MUST be as per [Encryption Context Naming]"
              }
            ],
            [
              {
                "annotation_ids": [
                  "0f343b8833bc3ded"
                ],
                "status_id": 8,
                "text": "(../structured-encryption/encrypt-path-structure.md#encryption-context-naming)."
              }
            ],
            "",
            [
              {
                "annotation_ids": [
                  "000a2e00d017d1e1",
                  "290f945929a55fc3"
                ],
                "status_id": 1,
                "text": "The value MUST be the UTF8 Encoding of the"
              }
            ],
            [
              {
                "annotation_ids": [
                  "000a2e00d017d1e1",
                  "290f945929a55fc3"
                ],
                "status_id": 1,
                "text": "[Base 64 encoded](https://www.rfc-editor.org/rfc/rfc4648),"
              }
            ],
            [
              {
                "annotation_ids": [
                  "000a2e00d017d1e1",
                  "290f945929a55fc3"
                ],
                "status_id": 1,
                "text": "of the concatenation of the bytes `typeID + serializedValue`"
              }
            ],
            [
              {
                "annotation_ids": [
                  "000a2e00d017d1e1",
                  "290f945929a55fc3"
                ],
                "status_id": 1,
                "text": "where `typeId` is the attribute's [type ID](./ddb-attribute-serialization.md#type-id)"
              }
            ],
            [
              {
                "annotation_ids": [
                  "000a2e00d017d1e1",
                  "290f945929a55fc3"
                ],
                "status_id": 1,
                "text": "and `serializedValue` is the attribute's value serialized according to"
              }
            ],
            [
              {
                "annotation_ids": [
                  "000a2e00d017d1e1",
                  "290f945929a55fc3"
                ],
                "status_id": 1,
                "text": "[Attribute Value Serialization](./ddb-attribute-serialization.md#attribute-value-serialization)."
              }
            ]
          ],
          "requirements": [
            "0f343b8833bc3ded",
            "0f343b8833bc3ded",
            "290f945929a55fc3",
            "290f945929a55fc3",
            "290f945929a55fc3",
            "290f945929a55fc3",
            "290f945929a55fc3",
            "290f945929a55fc3"
          ],
          "title": "Base Context Value Version 1"
        },
        {
          "id": "base-context-value-version-2",
          "lines": [
            [
              {
                "annotation_ids": [
                  "53753699a83a4492"
                ],
                "status_id": 8,
                "text": "The key MUST be as per [Encryption Context Naming]"
              }
            ],
            [
              {
                "annotation_ids": [
                  "53753699a83a4492"
                ],
                "status_id": 8,
                "text": "(../structured-encryption/encrypt-path-structure.md#encryption-context-naming)."
              }
            ],
            "",
            [
              {
                "annotation_ids": [
                  "9b68f4ac9ec4aef5",
                  "a9f463ccab41aa5f",
                  "f4d76c81ce07c6e0"
                ],
                "status_id": 4,
                "text": "The value MUST be :"
              }
            ],
            "",
            [
              {
                "annotation_ids": [
                  "9b68f4ac9ec4aef5",
                  "a9f463ccab41aa5f"
                ],
                "status_id": 5,
                "text": "- If the type is Number or String, the unaltered (already utf8) bytes of the value"
              }
            ],
            [
              {
                "annotation_ids": [
                  "9b68f4ac9ec4aef5",
                  "a9f463ccab41aa5f"
                ],
                "status_id": 5,
                "text": "- If the type if Null, the string \"null\""
              }
            ],
            [
              {
                "annotation_ids": [
                  "9b68f4ac9ec4aef5",
                  "a9f463ccab41aa5f"
                ],
                "status_id": 5,
                "text": "- If the type is Boolean, then the string \"true\" for true and the string \"false\" for false."
              }
            ],
            [
              {
                "annotation_ids": [
                  "9b68f4ac9ec4aef5",
                  "a9f463ccab41aa5f"
                ],
                "status_id": 5,
                "text": "- Else, the value as defined in [Base Context Value Version 1](#base-context-value-version-1)"
              }
            ]
          ],
          "requirements": [
            "53753699a83a4492",
            "53753699a83a4492",
            "f4d76c81ce07c6e0"
          ],
          "title": "Base Context Value Version 2"
        }
      ],
      "title": "Encrypt Item"
    },
    "specification/dynamodb-encryption-client/string-ordering.md": {
      "format": "markdown",
      "sections": [
        {
          "id": "string-ordering",
          "lines": [],
          "title": "String Ordering"
        },
        {
          "id": "version",
          "lines": [
            "1.0.0"
          ],
          "title": "Version"
        },
        {
          "id": "changelog",
          "lines": [
            "- 1.0.0",
            "",
            "  - Initial record"
          ],
          "title": "Changelog"
        },
        {
          "id": "definitions",
          "lines": [],
          "title": "Definitions"
        },
        {
          "id": "conventions-used-in-this-document",
          "lines": [
            "The key words \"MUST\", \"MUST NOT\", \"REQUIRED\", \"SHALL\", \"SHALL NOT\", \"SHOULD\", \"SHOULD NOT\", \"RECOMMENDED\", \"MAY\", and \"OPTIONAL\"",
            "in this document are to be interpreted as described in [RFC 2119](https://tools.ietf.org/html/rfc2119)."
          ],
          "title": "Conventions used in this document"
        },
        {
          "id": "unicode",
          "lines": [
            "For the latest version see:",
            "https://www.unicode.org/versions/latest/",
            "",
            "For Version 15.0 see:",
            "https://www.unicode.org/versions/Unicode15.0.0/"
          ],
          "title": "Unicode"
        },
        {
          "id": "unicode-scalar-value",
          "lines": [
            "Any Unicode code point except [surrogate](#surrogates) code points.",
            "",
            "See [section 3.9 Unicode Encoding Forms](https://www.unicode.org/versions/Unicode15.0.0/ch03.pdf) of the Unicode specification."
          ],
          "title": "Unicode scalar value"
        },
        {
          "id": "utf-16-code-unit",
          "lines": [
            "A 16-bit value representing a Unicode code point in a UTF-16 encoding.",
            "Includes [surrogate](#surrogates) code points.",
            "",
            "See [section 3.9 Unicode Encoding Forms](https://www.unicode.org/versions/Unicode15.0.0/ch03.pdf) of the Unicode specification."
          ],
          "title": "UTF-16 code unit"
        },
        {
          "id": "surrogates",
          "lines": [
            "Unicode code points in the range U+D800 to U+DFFF.",
            "These code points are only used in UTF-16 encodings",
            "to represent Unicode values above U+FFFF.",
            "",
            "See [section 3.8 Surrogates](https://www.unicode.org/versions/Unicode15.0.0/ch03.pdf) of the Unicode specification."
          ],
          "title": "Surrogates"
        },
        {
          "id": "overview",
          "lines": [
            "There are several instances throughout this specification where an order must be",
            "imposed on an unordered data structure during serialization for the purposes of canonicalization.",
            "This means that we must clearly specify the canonical ordering wherever",
            "such serialization is required.",
            "This is especially importing when ordering strings,",
            "as different encodings may lend themselves to slightly different orderings.",
            "",
            "Wherever strings need to be ordered,",
            "this specification will require either a [code point order](#code-point-order)",
            "or a [UTF-16 binary order](#utf-16-binary-order)."
          ],
          "title": "Overview"
        },
        {
          "id": "utf-16-binary-order",
          "lines": [
            [
              {
                "annotation_ids": [
                  "1ab6d9a15a6b153d"
                ],
                "status_id": 8,
                "text": "When ordering strings,"
              }
            ],
            [
              {
                "annotation_ids": [
                  "1ab6d9a15a6b153d"
                ],
                "status_id": 8,
                "text": "these strings MUST be compared according to their UTF-16 encoding,"
              }
            ],
            [
              {
                "annotation_ids": [
                  "1ab6d9a15a6b153d"
                ],
                "status_id": 8,
                "text": "lexicographically per [UTF-16 code unit](#utf-16-code-unit)."
              }
            ],
            [
              {
                "annotation_ids": [
                  "67ee1141772d5a56"
                ],
                "status_id": 8,
                "text": "UTF-16 code units for [high or low surrogates](#surrogates) MUST be compared individually,"
              }
            ],
            [
              {
                "annotation_ids": [
                  "67ee1141772d5a56"
                ],
                "status_id": 8,
                "text": "and the [Unicode scalar value](#unicode-scalar-value) represented by a surrogate pair"
              }
            ],
            [
              {
                "annotation_ids": [
                  "67ee1141772d5a56"
                ],
                "status_id": 8,
                "text": "MUST NOT be compared."
              }
            ],
            "",
            "Note that this is not equivalent to the [code point order](#code-point-order).",
            [
              {
                "annotation_ids": [
                  "dbe569fc1100655b"
                ],
                "status_id": 8,
                "text": "Specifically, the range of characters with Unicode code point U+E000 to U+0xFFFF"
              }
            ],
            [
              {
                "annotation_ids": [
                  "dbe569fc1100655b"
                ],
                "status_id": 8,
                "text": "(code points representable by 16 bits, but after the surrogate range)"
              }
            ],
            [
              {
                "annotation_ids": [
                  "dbe569fc1100655b"
                ],
                "status_id": 8,
                "text": "MUST be considered \"greater than\" any character with a Unicode code point of U+10000 to U+10FFFF."
              }
            ],
            "",
            "As an example, consider the following two characters:",
            "",
            "| char | Unicode code point | UTF-16 encoding |",
            "| ---- | ------------------ | --------------- |",
            "| `｡`  | U+FF61             | 0xFF61          |",
            "| `𐀂`  | U+10002            | 0xD800 0xDC02   |",
            "",
            "This ordering will order `｡` _after_ `𐀂`, despite `𐀂` having a higher Unicode code point."
          ],
          "requirements": [
            "1ab6d9a15a6b153d",
            "1ab6d9a15a6b153d",
            "1ab6d9a15a6b153d",
            "67ee1141772d5a56",
            "67ee1141772d5a56",
            "67ee1141772d5a56",
            "dbe569fc1100655b",
            "dbe569fc1100655b",
            "dbe569fc1100655b"
          ],
          "title": "UTF-16 Binary Order"
        },
        {
          "id": "code-point-order",
          "lines": [
            "This is the ordering referred to in the Unicode specification as a [code point order](https://www.unicode.org/versions/Unicode15.0.0/ch05.pdf).",
            "",
            "When ordering strings,",
            "these strings are compared lexicographically per [Unicode scalar value](#unicode-scalar-value) represented by the string.",
            "This means that if a string is UTF-16 encoded,",
            "higher order Unicode characters, encoded as a surrogate pair,",
            "must be handled as the Unicode scalar value represented by that surrogate pair,",
            "instead of each surrogate code point being handled individually.",
            "",
            "Note that this is equivalent to lexicographically comparing a UTF-8 encoded string per byte.",
            "This is also equivalent to lexicographically comparing a UTF-32 encoded string per 32-bit code unit.",
            "",
            "Currently, this specification does not directly use code point order for sorting string values,",
            "but may use this ordering for new behaviors in the future."
          ],
          "title": "Code Point Order"
        }
      ],
      "title": "String Ordering"
    },
    "specification/searchable-encryption/beacons.md": {
      "format": "markdown",
      "sections": [
        {
          "id": "beacons",
          "lines": [],
          "title": "Beacons"
        },
        {
          "id": "version",
          "lines": [
            "1.0.0"
          ],
          "title": "Version"
        },
        {
          "id": "changelog",
          "lines": [],
          "title": "Changelog"
        },
        {
          "id": "overview",
          "lines": [
            "Beacons use stable hashes of plaintext values of encrypted fields",
            "to allow searches on client-side encrypted records",
            "using truncation to provide some basic privacy protections."
          ],
          "title": "Overview"
        },
        {
          "id": "definitions",
          "lines": [],
          "title": "Definitions"
        },
        {
          "id": "virtual-field",
          "lines": [
            "A [virtual field](virtual.md) is a string computed from parts of a record."
          ],
          "title": "virtual field"
        },
        {
          "id": "virtual-database-field",
          "lines": [
            "A `virtual database field` is a string computed from fields and virtual fields,",
            "from which a [compound beacon](#compound-beacon) is constructed."
          ],
          "title": "virtual database field"
        },
        {
          "id": "real-field",
          "lines": [
            "A `real field` is a field that was placed in the record by the customer,",
            "rather than being generated."
          ],
          "title": "Real Field"
        },
        {
          "id": "source-field",
          "lines": [
            "A `source field` is a [real field](#real-field) used to construct",
            "a [virtual field](#virtual-field) or [virtual database field](#virtual-database-field).",
            "",
            "Neither virtual fields nor virtual database fields are ever stored anywhere,",
            "neither encrypted nor in plaintext."
          ],
          "title": "Source Field"
        },
        {
          "id": "beacon-length",
          "lines": [
            "The `Beacon Length` is the number of bits of the hash value that is kept.",
            "",
            "If any given beacon value maps back to a unique plaintext value,",
            "attackers can be given some insight into your plaintext.",
            "",
            "An extreme example of this would be a boolean field representing",
            "\"this person is over 7 feet tall\". The resulting beacon would have value",
            "`X` 99.9% of the time and value `Y` 0.1% of the time, making it trivial",
            "to determine which value maps to which plaintext. With something this",
            "extreme, there's no way to make a safe beacon; but it can be combined",
            "with something else in a [virtual field](#virtual-field).",
            "",
            "With more evenly distributed values, such as zip code,",
            "a unique hash can still reveal that two records have the same zip code as each other,",
            "even if the exact zip code is still a mystery.",
            "To avoid being able to distinguish unique values, we truncate the hash to ensure some collisions.",
            "",
            "For a field with `X` distinct values, you should choose a beacon length `N`",
            "such that `2^N < X/2` to guarantee collisions.",
            "",
            "On the other side of the spectrum, if the beacon length is too short,",
            "then there are too many collisions and query performance begins to",
            "approach a simple scan of all the data. A reasonable lower bound is",
            "ensure that `2^N` is greater than the square root of `X`.",
            "",
            "For example, a well distributed 5-digit zip code has 100,000 distinct values.",
            "To properly anonymize this, one would use a beacon length between 9 and 16 bits.",
            "",
            "Within that range, the length is chosen based on the threat model.",
            "If you really don't need privacy protection, then choose 24 bits to avoid any performance loss.",
            "With 16 bits, on average, each beacon will map to 1.5 zip codes.",
            "Performance : you will retrieve 15 records for every 10 you actually use.",
            "Privacy : Two records with the same beacon are 66% likely to have the same zip code.",
            "For every bit below 15, you double the performance cost and double the privacy, e.g.",
            "with 14 bits you would need to retrieve 30 records from the server to get the 10 that you need,",
            "and two records with the same beacon are 33% likely to have the same zip code.",
            "",
            [
              {
                "annotation_ids": [
                  "cc66e3802d22d708",
                  "7bd524ce02742a40"
                ],
                "status_id": 1,
                "text": "A beacon length MUST be an integer between 1 and 63 inclusive,"
              }
            ],
            [
              {
                "annotation_ids": [
                  "cc66e3802d22d708",
                  "7bd524ce02742a40"
                ],
                "status_id": 1,
                "text": "indicating the number of bits in the resulting beacon."
              }
            ],
            "The beacon string will be 1/4 this length."
          ],
          "requirements": [
            "7bd524ce02742a40",
            "7bd524ce02742a40"
          ],
          "title": "Beacon Length"
        },
        {
          "id": "terminal-location",
          "lines": [
            "A terminal location designates a portion of a structured value. Defined [here](virtual.md#terminal-location)."
          ],
          "title": "Terminal Location"
        },
        {
          "id": "standard-beacon",
          "lines": [
            "The simplest form of beacon is a standard beacon.",
            "",
            "To configure a single standard beacon, you need to provide",
            "",
            "1.  A name",
            "1.  A [terminal location](virtual.md#terminal-location)",
            "1.  A [beacon length](#beacon-length)",
            "",
            "A hash is made from the value at the terminal location, and stored at",
            "at the top level of the structure with the name `aws_dbe_b_` followed by the configured name.",
            "The configured name is used as a field name in queries.",
            "",
            "To produce a standard beacon from a sequence of bytes :",
            "",
            "1. Compute the HMAC",
            "1. Truncate the HMAC, to the [beacon length](#beacon-length)",
            "1. Turn the result into a hex string.",
            "",
            "For example, the beacon for `banana` might be `4f`.",
            "",
            "Standard Beacons can only be compared for equality.",
            "It makes no sense to say that one standard beacon is less than another,",
            "or one is a substring of another.",
            "",
            "Standard beacons are strings, because compound beacons need to be strings,",
            "and customers need to be able to switch from standard to compound beacons."
          ],
          "title": "Standard Beacon"
        },
        {
          "id": "compound-beacon",
          "lines": [
            "A compound beacon is assembled from parts of a record,",
            "combining literal plaintext strings and [standard beacons](#standard-beacon)",
            "into a complex string, suitable for complex database operations.",
            "",
            "To configure a single compound beacon, you need to provide",
            "",
            "1.  A name",
            "1.  A split character",
            "1.  A list of encrypted parts",
            "1.  A list of signed parts",
            "1.  A list of constructors",
            "",
            "The `name` is used in queries and index creation as if it were a regular field.",
            "\"MyField\" in examples below. It is an error if this name is the same as a configured",
            "field, or [virtual field](virtual.md), or to attempt to write a field of this name.",
            "",
            "The `split character` separates the parts of a compound beacon.",
            "In the examples below, we assume \"`.`\".",
            "",
            "Each [encrypted part](#encrypted-part-initialization) has a name and a prefix.",
            [
              {
                "annotation_ids": [
                  "7544a30209ac3520",
                  "e7d4955a97144c6a"
                ],
                "status_id": 1,
                "text": "The name MUST be the name of a configured standard beacon."
              }
            ],
            "",
            "For example :",
            "",
            "| Beacon Name | Prefix |",
            "| ----------- | ------ |",
            "| social      | S-     |",
            "| phone       | P-     |",
            "| zipcode     | Z-     |",
            "",
            "The first row should be interpreted as a literal `S-` followed by the \"social\" standard beacon.",
            "",
            "Each [signed part](#signed-part-initialization) has a field name,",
            "a [terminal location](virtual.md#terminal-location) and a prefix.",
            "The values of these fields are stored in plaintext.",
            "",
            "| Field Name | Location  | Prefix |",
            "| ---------- | --------- | ------ |",
            "| timestamp  | timestamp | T-     |",
            "",
            "The first row should be interpreted as a literal `T-` followed by the plaintext",
            "of the \"timestamp\" field.",
            "",
            "It is an error for the configuration of a signed part to refer to",
            "an encrypted field in any way.",
            "",
            "Prefixes can be any valid string, but no prefix string can be a prefix of another prefix string.",
            "",
            "That is, you can have both \"A-\" and AB-\" as prefixes,",
            "but you can't have both \"A-\" and \"A--\"."
          ],
          "requirements": [
            "e7d4955a97144c6a"
          ],
          "title": "Compound Beacon"
        },
        {
          "id": "writing-compound-beacons",
          "lines": [
            "To write a compound beacon, one generates the [virtual database field](#virtual-database-field),",
            "via a `constructor`,",
            "and then combines the encrypted parts from the referenced [standard beacons](#standard-beacon).",
            "",
            "A single constructor has a name and an ordered list of parts.",
            "Each part can be required or optional.",
            "Every constructor must contain at least one required field.",
            "",
            "An example list of constructors might be :",
            "",
            "- Person : timestamp(required) social(optional) zipcode(required)",
            "- Location : address(required) zipcode(required)",
            "",
            "A constructor `succeeds` if all its required [source fields](#source-field) exist in the record.",
            "",
            "Each constructor is tried, in the order configured, until one succeeds.",
            "",
            "If no constructor succeeds, the beacon is not included in the record.",
            "",
            "If no constructors are configured, a default constructor is generated,",
            "which is all of the configured parts, in their configured order,",
            "signed parts followed by encrypted parts, all parts required.",
            "",
            "From the first constructor that succeeds,",
            "a [virtual database field](#virtual-database-field) is constructed.",
            "For each part, we combine the prefix with the [standard beacon](#standard-beacon)",
            "(for encrypted parts) or plaintext value (for signed parts) of the field.",
            "",
            "These parts are then joined together, in the order given in the constructor,",
            "with parts separated by the `split character`.",
            "",
            "For example, the above configuration might result in [virtual database fields](#virtual-database-field) that look like this :",
            "",
            "- T-20221225.S-123-45-6789.Z-12345",
            "- A-1234 Main Street.Z-23456",
            "",
            "These [virtual database field](#virtual-database-field) are never written to the database, or even fully assembled.",
            "But this is what the customer must imagine.",
            "",
            "Encrypted values are then replaced with the appropriate beacon. For example",
            "",
            "- T-20221225.S-abcdef.Z-7abc",
            "- A-3ab.Z-edc3",
            "",
            "Which is then stored in the database, with a field name of `aws_dbe_b_MyField`."
          ],
          "title": "Writing Compound Beacons"
        },
        {
          "id": "querying-compound-beacons",
          "lines": [
            "At query time, the customer uses MyField in a query as if it were the full",
            "[virtual database field](#virtual-database-field), for example :",
            "",
            "- MyField starts_with(\"A-\")",
            "- MyField contains(\"Z-12345\")",
            "",
            "The onus is on the customer to properly re-create the results of all of the above configuration.",
            "",
            "We might provide an API to construct a [virtual field](virtual.md) from a record,",
            "to ease this burden. Perhaps another to construct the full [virtual database field](#virtual-database-field)."
          ],
          "title": "Querying Compound Beacons"
        },
        {
          "id": "lessthancomparable",
          "lines": [
            "A value for a compound beacon in a query is `LessThanComparable` if it is composed of",
            "zero or more [signed parts](#signed-part-initialization),",
            "optionally follows by just the prefix of a [encrypted part](#encrypted-part-initialization).",
            "",
            [
              {
                "annotation_ids": [
                  "d43608fd08884cbd",
                  "3b1ed2e0030a9c5f"
                ],
                "status_id": 1,
                "text": "A Query MUST fail if it uses `<`, `<=`, `>`, or `>=` on a value that is not LessThanComparable."
              }
            ]
          ],
          "requirements": [
            "3b1ed2e0030a9c5f"
          ],
          "title": "LessThanComparable"
        },
        {
          "id": "betweencomparable",
          "lines": [
            "To determine if two values for a compound beacon in a query are `BetweenComparable`.",
            "",
            "1 Remove any leading parts common to both values",
            "1 Check if the remainder is [LessThanComparable](#lessthancomparable)",
            "",
            [
              {
                "annotation_ids": [
                  "d738ae4e3626e2c8",
                  "c575bbfdf63f59cf",
                  "47ccd63870d089ae"
                ],
                "status_id": 1,
                "text": "A Query MUST fail if it uses BETWEEN on values that are not BetweenComparable."
              }
            ]
          ],
          "requirements": [
            "47ccd63870d089ae"
          ],
          "title": "BetweenComparable"
        },
        {
          "id": "indexing-compound-beacons",
          "lines": [
            "\"MyField\" can be used in the definition of an index (other than the primary index),",
            "as if it were any other field."
          ],
          "title": "Indexing Compound Beacons"
        },
        {
          "id": "signed-beacons",
          "lines": [
            "If a compound beacon is configured with no encrypted parts (i.e. with exclusively signed parts)",
            "then it is considered a signed beacon. A signed beacon with name `NAME` follows slightly different rules.",
            "",
            [
              {
                "annotation_ids": [
                  "cd663318c59333ac",
                  "b1d7a26932d1e8b1"
                ],
                "status_id": 1,
                "text": "The beacon value MUST be stored as `NAME`, rather than the usual `aws_dbe_b_NAME`."
              }
            ],
            "",
            "This has certain implications.",
            "",
            "- `NAME` can be used as a primary table key.",
            "- `NAME` will not be stripped out of records returned from Query or GetItem.",
            "- `NAME` is allowed to appear in a record to be written.",
            "",
            [
              {
                "annotation_ids": [
                  "654aac01e8fa2688",
                  "e80cbd887915b45a"
                ],
                "status_id": 7,
                "text": "Initialization MUST fail if `NAME` is explicitly configured with an"
              }
            ],
            [
              {
                "annotation_ids": [
                  "654aac01e8fa2688",
                  "e80cbd887915b45a"
                ],
                "status_id": 7,
                "text": "[attribute actions](../dynamodb-encryption-client/ddb-item-encryptor.md#attribute-actions) or"
              }
            ],
            [
              {
                "annotation_ids": [
                  "654aac01e8fa2688",
                  "e80cbd887915b45a"
                ],
                "status_id": 7,
                "text": "[unauthenticated attributes](../dynamodb-encryption-client/ddb-item-encryptor.md#unauthenticated-attributes),"
              }
            ],
            [
              {
                "annotation_ids": [
                  "654aac01e8fa2688",
                  "e80cbd887915b45a"
                ],
                "status_id": 7,
                "text": "or begins with the [unauthenticated attribute prefix](../dynamodb-encryption-client/ddb-item-encryptor.md#unauthenticated-attribute-prefix)."
              }
            ],
            "",
            [
              {
                "annotation_ids": [
                  "b7f015eecdd5f8eb",
                  "417bce2d4ef440f0"
                ],
                "status_id": 7,
                "text": "`NAME` MUST be automatically configured with an attribute action of SIGN_ONLY."
              }
            ],
            "",
            "As mentioned in [ddb support](../dynamodb-encryption-client/ddb-support.md#addsignedbeacons),",
            "If `NAME` appears in an record to be written,",
            "and `NAME` can also be constructed from other parts of the record,",
            "then the write must fail if the constructed and supplied values are not equal."
          ],
          "requirements": [
            "b1d7a26932d1e8b1",
            "e80cbd887915b45a",
            "e80cbd887915b45a",
            "e80cbd887915b45a",
            "e80cbd887915b45a",
            "417bce2d4ef440f0"
          ],
          "title": "Signed Beacons"
        },
        {
          "id": "conventions-used-in-this-document",
          "lines": [
            "The key words \"MUST\", \"MUST NOT\", \"REQUIRED\", \"SHALL\", \"SHALL NOT\", \"SHOULD\", \"SHOULD NOT\", \"RECOMMENDED\", \"MAY\", and \"OPTIONAL\"",
            "in this document are to be interpreted as described in [RFC 2119](https://tools.ietf.org/html/rfc2119)."
          ],
          "title": "Conventions used in this document"
        },
        {
          "id": "standard-beacon-initialization",
          "lines": [
            [
              {
                "annotation_ids": [
                  "6a52ebfb30239944",
                  "d9eaca3f3fbf172c"
                ],
                "status_id": 1,
                "text": "On initialization of a Standard Beacon, the caller MUST provide:"
              }
            ],
            "",
            [
              {
                "annotation_ids": [
                  "6a52ebfb30239944"
                ],
                "status_id": 2,
                "text": "- A name -- a string"
              }
            ],
            [
              {
                "annotation_ids": [
                  "6a52ebfb30239944"
                ],
                "status_id": 2,
                "text": "- A `length` -- a [beacon length](#beacon-length)"
              }
            ],
            "",
            [
              {
                "annotation_ids": [
                  "56d1e7916ff100d3",
                  "f5b559ecdb208b16"
                ],
                "status_id": 3,
                "text": "On initialization of a Standard Beacon, the caller MAY provide:"
              }
            ],
            "",
            [
              {
                "annotation_ids": [
                  "56d1e7916ff100d3"
                ],
                "status_id": 2,
                "text": "- a [terminal location](virtual.md#terminal-location) -- a string"
              }
            ],
            "- a [beacon style](beacon-style-initialization)",
            "",
            [
              {
                "annotation_ids": [
                  "1b4fdf43555a0344",
                  "6aea41c1945d3d39"
                ],
                "status_id": 1,
                "text": "If no [terminal location](virtual.md#terminal-location) is provided,"
              }
            ],
            [
              {
                "annotation_ids": [
                  "1b4fdf43555a0344",
                  "6aea41c1945d3d39"
                ],
                "status_id": 1,
                "text": "the `name` MUST be used as the [terminal location](virtual.md#terminal-location)."
              }
            ],
            "",
            [
              {
                "annotation_ids": [
                  "3e81c0f0c439b75e",
                  "1fca7b9972e87586"
                ],
                "status_id": 1,
                "text": "Initialization MUST fail if two standard beacons are configured with the same location."
              }
            ]
          ],
          "requirements": [
            "d9eaca3f3fbf172c",
            "f5b559ecdb208b16",
            "6aea41c1945d3d39",
            "6aea41c1945d3d39",
            "1fca7b9972e87586"
          ],
          "title": "Standard Beacon Initialization"
        },
        {
          "id": "beacon-style-initialization",
          "lines": [
            [
              {
                "annotation_ids": [
                  "79f060e132e11c04",
                  "e089c0188096f233"
                ],
                "status_id": 1,
                "text": "On initialization of a Beacon Style, the caller MUST provide exactly one of"
              }
            ],
            "",
            [
              {
                "annotation_ids": [
                  "79f060e132e11c04"
                ],
                "status_id": 2,
                "text": "- a [PartOnly](#partonly-initialization)"
              }
            ],
            [
              {
                "annotation_ids": [
                  "79f060e132e11c04"
                ],
                "status_id": 2,
                "text": "- a [Shared](#shared-initialization)"
              }
            ],
            [
              {
                "annotation_ids": [
                  "79f060e132e11c04"
                ],
                "status_id": 2,
                "text": "- an [AsSet](#asset-initialization)"
              }
            ],
            [
              {
                "annotation_ids": [
                  "79f060e132e11c04"
                ],
                "status_id": 2,
                "text": "- a [SharedSet](#sharedset-initialization)"
              }
            ]
          ],
          "requirements": [
            "e089c0188096f233"
          ],
          "title": "Beacon Style Initialization"
        },
        {
          "id": "partonly-initialization",
          "lines": [
            [
              {
                "annotation_ids": [
                  "6c2083c65c660bd6",
                  "364f21bd0b1493b6"
                ],
                "status_id": 1,
                "text": "On initialization of a PartOnly, the caller MUST NOT provide any"
              }
            ],
            [
              {
                "annotation_ids": [
                  "6c2083c65c660bd6",
                  "364f21bd0b1493b6"
                ],
                "status_id": 1,
                "text": "additional parameters to the PartOnly."
              }
            ],
            "",
            [
              {
                "annotation_ids": [
                  "6ad096da4bda3d58",
                  "2d91d41626e508c6"
                ],
                "status_id": 1,
                "text": "Initialization MUST fail if the configuration does not use a PartOnly in a [compound beacon](#compound-beacon)."
              }
            ],
            "",
            [
              {
                "annotation_ids": [
                  "7bc440d50029b4f0",
                  "db6e02d922d96ce2",
                  "a4f4c11984233b9c"
                ],
                "status_id": 4,
                "text": "The Standard Beacon MUST NOT be stored in the item for a PartOnly beacon."
              }
            ],
            "",
            [
              {
                "annotation_ids": [
                  "363280f1b735648b",
                  "6ceca58e09a6b543",
                  "c384437692733f23"
                ],
                "status_id": 14,
                "text": "A query MUST fail if it tries to search on a PartOnly beacon directly."
              }
            ]
          ],
          "requirements": [
            "364f21bd0b1493b6",
            "364f21bd0b1493b6",
            "2d91d41626e508c6",
            "a4f4c11984233b9c",
            "c384437692733f23"
          ],
          "title": "PartOnly Initialization"
        },
        {
          "id": "asset-initialization",
          "lines": [
            [
              {
                "annotation_ids": [
                  "9e77f6da85b8ff66",
                  "686f6516d8c0b4ad"
                ],
                "status_id": 1,
                "text": "On initialization of as AsSet, the caller MUST NOT provide any"
              }
            ],
            [
              {
                "annotation_ids": [
                  "9e77f6da85b8ff66",
                  "686f6516d8c0b4ad"
                ],
                "status_id": 1,
                "text": "additional parameters to the AsSet."
              }
            ],
            "",
            [
              {
                "annotation_ids": [
                  "d10c531ad4415ba2",
                  "44b3fc0c9da7cb59"
                ],
                "status_id": 1,
                "text": "- initialization MUST fail if any compound beacon has an AsSet beacon as a part."
              }
            ],
            [
              {
                "annotation_ids": [
                  "d78a9d13c22efda4",
                  "70bc1075e0ac0f1f",
                  "6d3c9b4f126ee543"
                ],
                "status_id": 14,
                "text": "- Writing an item MUST fail if the item contains this beacon's attribute,"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "  "
              },
              {
                "annotation_ids": [
                  "d78a9d13c22efda4",
                  "70bc1075e0ac0f1f",
                  "6d3c9b4f126ee543"
                ],
                "status_id": 14,
                "text": "and that attribute is not of type Set."
              }
            ],
            [
              {
                "annotation_ids": [
                  "61df12f8801f2074",
                  "9e838679074fee10",
                  "f3978d2550c9fdf7"
                ],
                "status_id": 4,
                "text": "- The Standard Beacon MUST be stored in the item as a Set,"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "  "
              },
              {
                "annotation_ids": [
                  "61df12f8801f2074",
                  "9e838679074fee10",
                  "f3978d2550c9fdf7"
                ],
                "status_id": 4,
                "text": "comprised of the [beacon values](#beacon-value) of all the elements in the original Set."
              }
            ]
          ],
          "requirements": [
            "686f6516d8c0b4ad",
            "686f6516d8c0b4ad",
            "44b3fc0c9da7cb59",
            "6d3c9b4f126ee543",
            "6d3c9b4f126ee543",
            "f3978d2550c9fdf7",
            "f3978d2550c9fdf7"
          ],
          "title": "AsSet Initialization"
        },
        {
          "id": "shared-initialization",
          "lines": [
            [
              {
                "annotation_ids": [
                  "6a5172d9d984d062",
                  "aee015e9e21b9c49"
                ],
                "status_id": 1,
                "text": "On initialization of a Shared, the caller MUST provide:"
              }
            ],
            "",
            [
              {
                "annotation_ids": [
                  "6a5172d9d984d062"
                ],
                "status_id": 2,
                "text": "- other : a beacon name"
              }
            ],
            "",
            [
              {
                "annotation_ids": [
                  "0a63f2d5fbdd8fbf",
                  "85ee0eab52eaddcc"
                ],
                "status_id": 1,
                "text": "This name MUST be the name of a previously defined Standard Beacon."
              }
            ],
            "",
            [
              {
                "annotation_ids": [
                  "c44bd951b1a83522",
                  "306b1b292a8e3d36"
                ],
                "status_id": 1,
                "text": "This beacon's [length](#beacon-length) MUST be equal to the `other` beacon's [length](#beacon-length)."
              }
            ],
            "",
            [
              {
                "annotation_ids": [
                  "ea95b8732c890d87",
                  "8e99a0738692c2ba",
                  "0a1c0ebc85beacad"
                ],
                "status_id": 4,
                "text": "This beacon MUST calculate its [value](#beacon-value) as if it were the `other` beacon."
              }
            ]
          ],
          "requirements": [
            "aee015e9e21b9c49",
            "85ee0eab52eaddcc",
            "306b1b292a8e3d36",
            "0a1c0ebc85beacad"
          ],
          "title": "Shared Initialization"
        },
        {
          "id": "sharedset-initialization",
          "lines": [
            [
              {
                "annotation_ids": [
                  "6139812f1304bf0f",
                  "148c9c34e45ae987"
                ],
                "status_id": 1,
                "text": "On initialization of a SharedSet, the caller MUST provide:"
              }
            ],
            "",
            [
              {
                "annotation_ids": [
                  "6139812f1304bf0f"
                ],
                "status_id": 2,
                "text": "- other : a beacon name"
              }
            ],
            "",
            [
              {
                "annotation_ids": [
                  "301f586efbdf28f4",
                  "792b57bae88874a3",
                  "30bde832f11ee435"
                ],
                "status_id": 4,
                "text": "A SharedSet Beacon MUST behave both as [Shared](#shared-initialization) and [AsSet](#asset-initialization)."
              }
            ]
          ],
          "requirements": [
            "148c9c34e45ae987",
            "30bde832f11ee435"
          ],
          "title": "SharedSet Initialization"
        },
        {
          "id": "compound-beacon-initialization",
          "lines": [
            [
              {
                "annotation_ids": [
                  "b712aeb8a4e85a5a",
                  "76abfaed6d8c2d7f"
                ],
                "status_id": 1,
                "text": "On initialization of a Compound Beacon, the caller MUST provide:"
              }
            ],
            "",
            [
              {
                "annotation_ids": [
                  "b712aeb8a4e85a5a"
                ],
                "status_id": 2,
                "text": "- A name -- a string"
              }
            ],
            [
              {
                "annotation_ids": [
                  "b712aeb8a4e85a5a"
                ],
                "status_id": 2,
                "text": "- A split character -- a character"
              }
            ],
            "",
            [
              {
                "annotation_ids": [
                  "7e92a2c227f20eec",
                  "fe4a404cec0871ca"
                ],
                "status_id": 3,
                "text": "On initialization of a Compound Beacon, the caller MAY provide:"
              }
            ],
            "",
            [
              {
                "annotation_ids": [
                  "7e92a2c227f20eec"
                ],
                "status_id": 2,
                "text": "- A list of [encrypted parts](#encrypted-part-initialization)"
              }
            ],
            [
              {
                "annotation_ids": [
                  "7e92a2c227f20eec"
                ],
                "status_id": 2,
                "text": "- A list of [signed parts](#signed-part-initialization)"
              }
            ],
            [
              {
                "annotation_ids": [
                  "7e92a2c227f20eec"
                ],
                "status_id": 2,
                "text": "- A list of constructors"
              }
            ]
          ],
          "requirements": [
            "76abfaed6d8c2d7f",
            "fe4a404cec0871ca"
          ],
          "title": "Compound Beacon Initialization"
        },
        {
          "id": "signed-part-initialization",
          "lines": [
            [
              {
                "annotation_ids": [
                  "41d6a474be4eb16f",
                  "a5dc2cf1c7406bec"
                ],
                "status_id": 1,
                "text": "On initialization of a [signed part](#signed-part-initialization), the caller MUST provide:"
              }
            ],
            "",
            [
              {
                "annotation_ids": [
                  "41d6a474be4eb16f"
                ],
                "status_id": 2,
                "text": "- A name -- a string"
              }
            ],
            [
              {
                "annotation_ids": [
                  "41d6a474be4eb16f"
                ],
                "status_id": 2,
                "text": "- A prefix -- a string"
              }
            ],
            "",
            [
              {
                "annotation_ids": [
                  "12e720eafc453fd7",
                  "0d7813972e233aad"
                ],
                "status_id": 3,
                "text": "On initialization of a [signed parts](#signed-part-initialization), the caller MAY provide:"
              }
            ],
            "",
            [
              {
                "annotation_ids": [
                  "12e720eafc453fd7"
                ],
                "status_id": 2,
                "text": "- A [terminal location](virtual.md#terminal-location) -- a string"
              }
            ],
            "",
            [
              {
                "annotation_ids": [
                  "36d145ecad02942b",
                  "85b25261f24f33e3"
                ],
                "status_id": 1,
                "text": "If no [terminal location](virtual.md#terminal-location) is provided,"
              }
            ],
            [
              {
                "annotation_ids": [
                  "36d145ecad02942b",
                  "85b25261f24f33e3"
                ],
                "status_id": 1,
                "text": "the `name` MUST be used as the [terminal location](virtual.md#terminal-location)."
              }
            ]
          ],
          "requirements": [
            "a5dc2cf1c7406bec",
            "0d7813972e233aad",
            "85b25261f24f33e3",
            "85b25261f24f33e3"
          ],
          "title": "Signed Part Initialization"
        },
        {
          "id": "encrypted-part-initialization",
          "lines": [
            [
              {
                "annotation_ids": [
                  "730dda925d4515ee",
                  "c87c4744447a1337"
                ],
                "status_id": 1,
                "text": "On initialization of a [encrypted part](#encrypted-part-initialization), the caller MUST provide:"
              }
            ],
            "",
            [
              {
                "annotation_ids": [
                  "730dda925d4515ee"
                ],
                "status_id": 2,
                "text": "- A name -- a string, the name of a standard beacon"
              }
            ],
            [
              {
                "annotation_ids": [
                  "730dda925d4515ee"
                ],
                "status_id": 2,
                "text": "- A prefix -- a string"
              }
            ]
          ],
          "requirements": [
            "c87c4744447a1337"
          ],
          "title": "Encrypted Part Initialization"
        },
        {
          "id": "constructor-initialization",
          "lines": [
            [
              {
                "annotation_ids": [
                  "bfa1d3ec7db37f26",
                  "9428054a9b630a3d"
                ],
                "status_id": 1,
                "text": "On initialization of a constructor, the caller MUST provide:"
              }
            ],
            "",
            [
              {
                "annotation_ids": [
                  "bfa1d3ec7db37f26"
                ],
                "status_id": 2,
                "text": "- A non-empty list of [Constructor parts](#constructor-part-initialization)"
              }
            ]
          ],
          "requirements": [
            "9428054a9b630a3d"
          ],
          "title": "Constructor Initialization"
        },
        {
          "id": "constructor-part-initialization",
          "lines": [
            [
              {
                "annotation_ids": [
                  "7cd15afa74ffeeaf",
                  "1a37af0bd1122976"
                ],
                "status_id": 1,
                "text": "On initialization of a constructor part, the caller MUST provide:"
              }
            ],
            "",
            [
              {
                "annotation_ids": [
                  "7cd15afa74ffeeaf"
                ],
                "status_id": 2,
                "text": "- A name -- a string"
              }
            ],
            [
              {
                "annotation_ids": [
                  "7cd15afa74ffeeaf"
                ],
                "status_id": 2,
                "text": "- A required flag -- a boolean"
              }
            ],
            "",
            [
              {
                "annotation_ids": [
                  "bd8bedcdac660233",
                  "43438df91dc90707"
                ],
                "status_id": 1,
                "text": "This name MUST match the name of one of the [encrypted](#encrypted-part-initialization) or [signed](#signed-part-initialization) parts."
              }
            ],
            "",
            "These parts may come from these locally defined parts lists, or from the",
            "[Global Parts List](search-config.md#global-parts-list), in any combination."
          ],
          "requirements": [
            "1a37af0bd1122976",
            "43438df91dc90707"
          ],
          "title": "Constructor Part Initialization"
        },
        {
          "id": "default-construction",
          "lines": [
            [
              {
                "annotation_ids": [
                  "ca9f73c33f874ebe",
                  "c556e83b8504c083"
                ],
                "status_id": 1,
                "text": "- If no constructors are configured, a default constructor MUST be generated."
              }
            ],
            [
              {
                "annotation_ids": [
                  "d557a2122337c241",
                  "397e7557175d7399"
                ],
                "status_id": 1,
                "text": "- This default constructor MUST be all of the signed parts,"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "  "
              },
              {
                "annotation_ids": [
                  "d557a2122337c241",
                  "397e7557175d7399"
                ],
                "status_id": 1,
                "text": "followed by all the encrypted parts, all parts being required."
              }
            ],
            [
              {
                "annotation_ids": [
                  "6ea38177c048c29b",
                  "e164edbe1bd78791"
                ],
                "status_id": 1,
                "text": "- Initialization MUST fail if no constructors are configured, and no local parts are configured."
              }
            ]
          ],
          "requirements": [
            "c556e83b8504c083",
            "397e7557175d7399",
            "397e7557175d7399",
            "e164edbe1bd78791"
          ],
          "title": "Default Construction"
        },
        {
          "id": "part",
          "lines": [
            "The word `part` is used to refer to any [encrypted](#encrypted-part-initialization) or [signed](#encrypted-part-initialization) part."
          ],
          "title": "Part"
        },
        {
          "id": "initialization-failure",
          "lines": [
            [
              {
                "annotation_ids": [
                  "2c0fde33d0306b9e",
                  "22bf8b9f96c248e0"
                ],
                "status_id": 1,
                "text": "Initialization MUST fail if any `prefix` in any [part](#part) is a prefix of"
              }
            ],
            [
              {
                "annotation_ids": [
                  "2c0fde33d0306b9e",
                  "22bf8b9f96c248e0"
                ],
                "status_id": 1,
                "text": "the `prefix` of any other [part](#part)."
              }
            ],
            "",
            [
              {
                "annotation_ids": [
                  "8ebf49b1034d00cd",
                  "9cc3fed33f8f855b"
                ],
                "status_id": 1,
                "text": "Initialization MUST fail if any [signed-part](#signed-part-initialization) contains"
              }
            ],
            [
              {
                "annotation_ids": [
                  "8ebf49b1034d00cd",
                  "9cc3fed33f8f855b"
                ],
                "status_id": 1,
                "text": "anything but SIGN_ONLY fields."
              }
            ],
            "",
            [
              {
                "annotation_ids": [
                  "f2d397bce3851b6f",
                  "6131cd4ff45ac26f"
                ],
                "status_id": 1,
                "text": "Initialization MUST fail if any [constructor](#constructor-initialization) is configured with a field name"
              }
            ],
            [
              {
                "annotation_ids": [
                  "f2d397bce3851b6f",
                  "6131cd4ff45ac26f"
                ],
                "status_id": 1,
                "text": "that is not a defined [part](#part)."
              }
            ],
            "",
            [
              {
                "annotation_ids": [
                  "30690f8c0bea9866",
                  "52541f96e92aaa8b"
                ],
                "status_id": 1,
                "text": "Initialization MUST fail if any [constructor](#constructor-initialization) is configured without at least one"
              }
            ],
            [
              {
                "annotation_ids": [
                  "30690f8c0bea9866",
                  "52541f96e92aaa8b"
                ],
                "status_id": 1,
                "text": "required part."
              }
            ],
            "",
            [
              {
                "annotation_ids": [
                  "9fe83bda73ed56ba",
                  "b8b065a0e43c3c5a"
                ],
                "status_id": 1,
                "text": "Initialization MUST fail if two [constructors](#constructor-initialization) are configured"
              }
            ],
            [
              {
                "annotation_ids": [
                  "9fe83bda73ed56ba",
                  "b8b065a0e43c3c5a"
                ],
                "status_id": 1,
                "text": "with the same set of required parts."
              }
            ]
          ],
          "requirements": [
            "22bf8b9f96c248e0",
            "22bf8b9f96c248e0",
            "9cc3fed33f8f855b",
            "9cc3fed33f8f855b",
            "6131cd4ff45ac26f",
            "6131cd4ff45ac26f",
            "52541f96e92aaa8b",
            "52541f96e92aaa8b",
            "b8b065a0e43c3c5a",
            "b8b065a0e43c3c5a"
          ],
          "title": "Initialization Failure"
        },
        {
          "id": "beacon-value",
          "lines": [
            "The value for a beacon is as defined below under",
            "[value for a standard beacon](#value-for-a-standard-beacon)",
            "or [value for a compound beacon](#value-for-a-compound-beacon)."
          ],
          "title": "Beacon Value"
        },
        {
          "id": "beacon-operations",
          "lines": [
            "Both standard and compound beacons define two operations",
            "",
            "- hash - turn a plaintext record into a beacon",
            "- getPart - turn a plaintext query string into a beacon"
          ],
          "title": "Beacon Operations"
        },
        {
          "id": "basichash",
          "lines": [
            [
              {
                "annotation_ids": [
                  "ab7a8f630b144673",
                  "d9afc8330289fe7c"
                ],
                "status_id": 1,
                "text": "- basicHash MUST take an [hmac key](./search-config.md#hmac-key-generation), a [beacon length](#beacon-length) and a sequence of bytes as input."
              }
            ],
            [
              {
                "annotation_ids": [
                  "567f3e3c386b7d3d",
                  "508cbaafe387412a"
                ],
                "status_id": 1,
                "text": "- basicHash MUST produce a non-empty string as output."
              }
            ],
            [
              {
                "annotation_ids": [
                  "e8eac59f3ec4dc3a",
                  "acbc57b35389216b"
                ],
                "status_id": 1,
                "text": "- basicHash MUST calculate the [HmacSha384](https://www.ietf.org/rfc/rfc2104.txt)"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "  "
              },
              {
                "annotation_ids": [
                  "e8eac59f3ec4dc3a",
                  "acbc57b35389216b"
                ],
                "status_id": 1,
                "text": "of the input bytes and the [hmac key](./search-config.md#hmac-key-generation), and keep the first 8 bytes."
              }
            ],
            [
              {
                "annotation_ids": [
                  "bce0f634dda06e88",
                  "d7e8f3090ea5e245"
                ],
                "status_id": 1,
                "text": "- basicHash MUST return the rightmost [beacon length](#beacon-length) bits of these 8 bytes as a hexadecimal string."
              }
            ],
            [
              {
                "annotation_ids": [
                  "423c91ffd6f5f81e",
                  "070e100fd2c4e257"
                ],
                "status_id": 1,
                "text": "- the length of the returned string MUST be (`beacon length`/4) rounded up."
              }
            ]
          ],
          "requirements": [
            "d9afc8330289fe7c",
            "508cbaafe387412a",
            "acbc57b35389216b",
            "acbc57b35389216b",
            "d7e8f3090ea5e245",
            "070e100fd2c4e257"
          ],
          "title": "basicHash"
        },
        {
          "id": "string-hash",
          "lines": [
            [
              {
                "annotation_ids": [
                  "8185d7e1e3721cb3",
                  "8a6ed1e2ee65284d"
                ],
                "status_id": 1,
                "text": "- string hash MUST take a string and some [key materials](./search-config.md#get-beacon-key-materials)"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "  "
              },
              {
                "annotation_ids": [
                  "8185d7e1e3721cb3",
                  "8a6ed1e2ee65284d"
                ],
                "status_id": 1,
                "text": "as input, and produce a string as output."
              }
            ],
            [
              {
                "annotation_ids": [
                  "7e430bba657f2ddf",
                  "f034609ad73639a4"
                ],
                "status_id": 1,
                "text": "- string hash MUST return the [basic hash](#basichash) of the UTF8 representation"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "  "
              },
              {
                "annotation_ids": [
                  "7e430bba657f2ddf",
                  "f034609ad73639a4"
                ],
                "status_id": 1,
                "text": "of the input string, the HMAC key from the [key materials](./search-config.md#get-beacon-key-materials)"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "  "
              },
              {
                "annotation_ids": [
                  "7e430bba657f2ddf",
                  "f034609ad73639a4"
                ],
                "status_id": 1,
                "text": "associated with this beacon, and the beacon length associated with this beacon."
              }
            ]
          ],
          "requirements": [
            "8a6ed1e2ee65284d",
            "8a6ed1e2ee65284d",
            "f034609ad73639a4",
            "f034609ad73639a4",
            "f034609ad73639a4"
          ],
          "title": "string hash"
        },
        {
          "id": "value-for-a-standard-beacon",
          "lines": [
            [
              {
                "annotation_ids": [
                  "00862526f3ad5282",
                  "776d4ae2488566a1"
                ],
                "status_id": 1,
                "text": "- This operation MUST take an [hmac key](./search-config.md#hmac-key-generation), a record as input, and produce an optional [AttributeValue](https://docs.aws.amazon.com/amazondynamodb/latest/APIReference/API_AttributeValue.html)."
              }
            ],
            [
              {
                "annotation_ids": [
                  "eaa443fea505393f",
                  "75150aa50ce64c2b"
                ],
                "status_id": 1,
                "text": "- This operation MUST return no value if the associated field does not exist in the record"
              }
            ],
            [
              {
                "annotation_ids": [
                  "08f47b5df88f4a06",
                  "a034328298bf396e"
                ],
                "status_id": 1,
                "text": "- If this beacon is marked AsSet then this operation MUST return the"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "  "
              },
              {
                "annotation_ids": [
                  "08f47b5df88f4a06",
                  "a034328298bf396e"
                ],
                "status_id": 1,
                "text": "[set value](#value-for-a-set-standard-beacon),"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "  "
              },
              {
                "annotation_ids": [
                  "08f47b5df88f4a06",
                  "a034328298bf396e"
                ],
                "status_id": 1,
                "text": "otherwise it MUST return the [non-set value](#value-for-a-non-set-standard-beacon)"
              }
            ]
          ],
          "requirements": [
            "776d4ae2488566a1",
            "75150aa50ce64c2b",
            "a034328298bf396e",
            "a034328298bf396e",
            "a034328298bf396e"
          ],
          "title": "value for a standard beacon"
        },
        {
          "id": "value-for-a-non-set-standard-beacon",
          "lines": [
            [
              {
                "annotation_ids": [
                  "64521862c01b7a9b",
                  "0e9d46b85dcf3e7b"
                ],
                "status_id": 1,
                "text": "- This operation MUST convert the attribute value of the associated field to"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "  "
              },
              {
                "annotation_ids": [
                  "64521862c01b7a9b",
                  "0e9d46b85dcf3e7b"
                ],
                "status_id": 1,
                "text": "a sequence of bytes, as per [attribute serialization](../dynamodb-encryption-client/ddb-attribute-serialization.md)."
              }
            ],
            [
              {
                "annotation_ids": [
                  "fa2a3149f487a1bf",
                  "39bf766141e31dc4"
                ],
                "status_id": 1,
                "text": "- This operation MUST return the [basicHash](#basichash) of the resulting bytes and the configured [beacon length](#beacon-length)."
              }
            ],
            [
              {
                "annotation_ids": [
                  "dedf59b160c75f96",
                  "c97c29f3fb15a999"
                ],
                "status_id": 1,
                "text": "- The returned"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "  "
              },
              {
                "annotation_ids": [
                  "dedf59b160c75f96",
                  "c97c29f3fb15a999"
                ],
                "status_id": 1,
                "text": "[AttributeValue](https://docs.aws.amazon.com/amazondynamodb/latest/APIReference/API_AttributeValue.html)"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "  "
              },
              {
                "annotation_ids": [
                  "dedf59b160c75f96",
                  "c97c29f3fb15a999"
                ],
                "status_id": 1,
                "text": "MUST be type \"S\" String."
              }
            ]
          ],
          "requirements": [
            "0e9d46b85dcf3e7b",
            "0e9d46b85dcf3e7b",
            "39bf766141e31dc4",
            "c97c29f3fb15a999",
            "c97c29f3fb15a999",
            "c97c29f3fb15a999"
          ],
          "title": "value for a non-set standard beacon"
        },
        {
          "id": "value-for-a-set-standard-beacon",
          "lines": [
            [
              {
                "annotation_ids": [
                  "b2d04bd13289dcd8"
                ],
                "status_id": 8,
                "text": "- This operation MUST convert the value of each item in the set to"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "  "
              },
              {
                "annotation_ids": [
                  "b2d04bd13289dcd8"
                ],
                "status_id": 8,
                "text": "a sequence of bytes, as per [attribute serialization](../dynamodb-encryption-client/ddb-attribute-serialization.md)."
              }
            ],
            [
              {
                "annotation_ids": [
                  "4c5d376d329b3dea"
                ],
                "status_id": 8,
                "text": "- This operation MUST return a set containing the [basicHash](#basichash) of the resulting bytes and the configured [beacon length](#beacon-length)."
              }
            ],
            [
              {
                "annotation_ids": [
                  "3fcb408f6ba862db",
                  "2e0123036890d7c8"
                ],
                "status_id": 1,
                "text": "- The resulting set MUST NOT contain duplicates."
              }
            ],
            [
              {
                "annotation_ids": [
                  "543291ac3f2f7235",
                  "55bca381c5e14db3"
                ],
                "status_id": 1,
                "text": "- The returned"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "  "
              },
              {
                "annotation_ids": [
                  "543291ac3f2f7235",
                  "55bca381c5e14db3"
                ],
                "status_id": 1,
                "text": "[AttributeValue](https://docs.aws.amazon.com/amazondynamodb/latest/APIReference/API_AttributeValue.html)"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "  "
              },
              {
                "annotation_ids": [
                  "543291ac3f2f7235",
                  "55bca381c5e14db3"
                ],
                "status_id": 1,
                "text": "MUST be type \"SS\" StringSet."
              }
            ]
          ],
          "requirements": [
            "b2d04bd13289dcd8",
            "b2d04bd13289dcd8",
            "4c5d376d329b3dea",
            "2e0123036890d7c8",
            "55bca381c5e14db3",
            "55bca381c5e14db3",
            "55bca381c5e14db3"
          ],
          "title": "value for a set standard beacon"
        },
        {
          "id": "value-for-a-compound-beacon",
          "lines": [
            [
              {
                "annotation_ids": [
                  "bb2bc6c84d16e70b",
                  "5bcdbc84739603b4"
                ],
                "status_id": 1,
                "text": "- This operation MUST take a record as input, and produce an optional string."
              }
            ],
            [
              {
                "annotation_ids": [
                  "bcb3b202f3646150",
                  "3ef5cbbdecb91a01"
                ],
                "status_id": 1,
                "text": "- If a string is returned, it MUST NOT be empty."
              }
            ],
            [
              {
                "annotation_ids": [
                  "0fff7af548abaf06",
                  "f4fe5c318d3abd8b"
                ],
                "status_id": 1,
                "text": "- This operation MUST iterate through all constructors, in order, using the first that succeeds."
              }
            ],
            [
              {
                "annotation_ids": [
                  "69ac3ba5b8d90c89",
                  "79a19de5036b3c7f",
                  "b5e3daeeeb4ff360"
                ],
                "status_id": 4,
                "text": "- For that constructor, hash MUST join the [part value](#part-value) for each part"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "  "
              },
              {
                "annotation_ids": [
                  "69ac3ba5b8d90c89",
                  "79a19de5036b3c7f",
                  "b5e3daeeeb4ff360"
                ],
                "status_id": 4,
                "text": "on the `split character`,"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "  "
              },
              {
                "annotation_ids": [
                  "69ac3ba5b8d90c89",
                  "79a19de5036b3c7f",
                  "b5e3daeeeb4ff360"
                ],
                "status_id": 4,
                "text": "excluding parts that are not required and with a source field that is not available."
              }
            ],
            [
              {
                "annotation_ids": [
                  "4bb6263e4a4657b6",
                  "75fe126df04971de",
                  "17d7ea6b02976397"
                ],
                "status_id": 1,
                "text": "- This operation MUST fail if any plaintext value used in the construction contains the split character."
              }
            ],
            [
              {
                "annotation_ids": [
                  "50a3e7813214fc2d",
                  "071616748aaf2085"
                ],
                "status_id": 7,
                "text": "- If no constructor succeeds, this operation MUST return no value."
              }
            ]
          ],
          "requirements": [
            "5bcdbc84739603b4",
            "3ef5cbbdecb91a01",
            "f4fe5c318d3abd8b",
            "b5e3daeeeb4ff360",
            "b5e3daeeeb4ff360",
            "b5e3daeeeb4ff360",
            "17d7ea6b02976397",
            "071616748aaf2085"
          ],
          "title": "value for a compound beacon"
        },
        {
          "id": "getpart-for-a-standard-beacon",
          "lines": [
            [
              {
                "annotation_ids": [
                  "2738c08218343dee",
                  "16025dff8b34424f"
                ],
                "status_id": 1,
                "text": "- getPart MUST take an [hmac key](./search-config.md#hmac-key-generation), a sequence of bytes as input, and produce a string."
              }
            ],
            [
              {
                "annotation_ids": [
                  "662bd297f2029438",
                  "154fc0f654ef3204"
                ],
                "status_id": 1,
                "text": "- getPart MUST return the [basicHash](#basichash) of the input and the configured [beacon length](#beacon-length)."
              }
            ]
          ],
          "requirements": [
            "16025dff8b34424f",
            "154fc0f654ef3204"
          ],
          "title": "getPart for a standard beacon"
        },
        {
          "id": "getpart-for-a-compound-beacon",
          "lines": [
            [
              {
                "annotation_ids": [
                  "199eadb95e0c63e3",
                  "5ef07c874d5fcd82"
                ],
                "status_id": 1,
                "text": "- getPart MUST take a string as input and produce a string."
              }
            ],
            [
              {
                "annotation_ids": [
                  "17d2249867828528",
                  "8cfc7066fd3b7137"
                ],
                "status_id": 1,
                "text": "- The returned string MUST NOT be empty."
              }
            ],
            [
              {
                "annotation_ids": [
                  "d3aa3340861ef2e9",
                  "ad43158b1df6c801"
                ],
                "status_id": 1,
                "text": "- The string MUST be split on the `split character` into pieces."
              }
            ],
            [
              {
                "annotation_ids": [
                  "6be8698b99d25738",
                  "23fc5068afc0f1ea"
                ],
                "status_id": 1,
                "text": "- For each piece, a [part](#part) MUST be identified"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "  "
              },
              {
                "annotation_ids": [
                  "6be8698b99d25738",
                  "23fc5068afc0f1ea"
                ],
                "status_id": 1,
                "text": "by matching the prefix of a [part](#part)"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "  "
              },
              {
                "annotation_ids": [
                  "6be8698b99d25738",
                  "23fc5068afc0f1ea"
                ],
                "status_id": 1,
                "text": "to the beginning of the piece."
              }
            ],
            [
              {
                "annotation_ids": [
                  "81ce818aff764fda",
                  "cd2b205f2aa2baf1"
                ],
                "status_id": 1,
                "text": "- If no such part exists, this operation MUST fail."
              }
            ],
            [
              {
                "annotation_ids": [
                  "c9f2b05e7026e389",
                  "bf4baf102251e2a7"
                ],
                "status_id": 1,
                "text": "- The [Part Value](#part-value-calculation) MUST be calculated for each piece,"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "  "
              },
              {
                "annotation_ids": [
                  "c9f2b05e7026e389",
                  "bf4baf102251e2a7"
                ],
                "status_id": 1,
                "text": "using the prefix and length from the discovered part."
              }
            ],
            [
              {
                "annotation_ids": [
                  "233f58617dc97ea5",
                  "4dd87613bda0ceb0",
                  "679623ee5b146bf9"
                ],
                "status_id": 4,
                "text": "- The value returned MUST be these part values, joined with the `split character`."
              }
            ]
          ],
          "requirements": [
            "5ef07c874d5fcd82",
            "8cfc7066fd3b7137",
            "ad43158b1df6c801",
            "23fc5068afc0f1ea",
            "23fc5068afc0f1ea",
            "23fc5068afc0f1ea",
            "cd2b205f2aa2baf1",
            "bf4baf102251e2a7",
            "bf4baf102251e2a7",
            "679623ee5b146bf9"
          ],
          "title": "getPart for a compound beacon"
        },
        {
          "id": "part-value",
          "lines": [
            "Calculate the `plain string` :",
            "the concatenation of the prefix and the field value.",
            "",
            "The `Part Value` is the [part value calculation](#part-value-calculation) of the `plain string` and the part."
          ],
          "title": "Part Value"
        },
        {
          "id": "part-value-calculation",
          "lines": [
            [
              {
                "annotation_ids": [
                  "aef6433cde4baf7c",
                  "bab03441cf5757a1"
                ],
                "status_id": 1,
                "text": "Part Value Calculation MUST take some [key materials](./search-config.md#get-beacon-key-materials),"
              }
            ],
            [
              {
                "annotation_ids": [
                  "aef6433cde4baf7c",
                  "bab03441cf5757a1"
                ],
                "status_id": 1,
                "text": "a string (the value for which the beacon is being calculated)"
              }
            ],
            [
              {
                "annotation_ids": [
                  "aef6433cde4baf7c",
                  "bab03441cf5757a1"
                ],
                "status_id": 1,
                "text": "and a [Part](#part) as input, and return a string as output."
              }
            ],
            "",
            [
              {
                "annotation_ids": [
                  "f6d5c217bc0aeedd",
                  "7398cfc0b6359cea"
                ],
                "status_id": 1,
                "text": "If the part is a [encrypted part](#encrypted-part-initialization),"
              }
            ],
            [
              {
                "annotation_ids": [
                  "f6d5c217bc0aeedd",
                  "7398cfc0b6359cea"
                ],
                "status_id": 1,
                "text": "the part value MUST be the concatenation of the part's prefix"
              }
            ],
            [
              {
                "annotation_ids": [
                  "f6d5c217bc0aeedd",
                  "7398cfc0b6359cea"
                ],
                "status_id": 1,
                "text": "and the [string hash](#string-hash) of the input string."
              }
            ],
            "",
            [
              {
                "annotation_ids": [
                  "02368a13ecad8432",
                  "dc98efbf03b01c37"
                ],
                "status_id": 1,
                "text": "If the part is a [signed part](#signed-part-initialization),"
              }
            ],
            [
              {
                "annotation_ids": [
                  "02368a13ecad8432",
                  "dc98efbf03b01c37"
                ],
                "status_id": 1,
                "text": "the part value MUST be the concatenation of the part's prefix and the input string."
              }
            ]
          ],
          "requirements": [
            "bab03441cf5757a1",
            "bab03441cf5757a1",
            "bab03441cf5757a1",
            "7398cfc0b6359cea",
            "7398cfc0b6359cea",
            "7398cfc0b6359cea",
            "dc98efbf03b01c37",
            "dc98efbf03b01c37"
          ],
          "title": "Part Value Calculation"
        }
      ],
      "title": "Beacons"
    },
    "specification/searchable-encryption/search-config.md": {
      "format": "markdown",
      "sections": [
        {
          "id": "search-config",
          "lines": [],
          "title": "Search Config"
        },
        {
          "id": "version",
          "lines": [
            "1.0.0"
          ],
          "title": "Version"
        },
        {
          "id": "changelog",
          "lines": [],
          "title": "Changelog"
        },
        {
          "id": "overview",
          "lines": [
            "The search config holds the configuration for all of the searchable configuration functionality.",
            "",
            [
              {
                "annotation_ids": [
                  "6e53055d74e558fb",
                  "6b979a33f53e2794"
                ],
                "status_id": 1,
                "text": "The search config MUST be an optional part of the [item encryptor config](../dynamodb-encryption-client/ddb-item-encryptor.md)."
              }
            ],
            "",
            "Although [versioning](#versioning) is not yet supported, it exists in the configuration, so that the configuration will not need to change when we add versioning."
          ],
          "requirements": [
            "6b979a33f53e2794"
          ],
          "title": "Overview"
        },
        {
          "id": "initialization",
          "lines": [
            [
              {
                "annotation_ids": [
                  "91f97cb93a07be17",
                  "3d09b7c2eeef298c"
                ],
                "status_id": 1,
                "text": "On initialization of the Search Config, the caller MUST provide:"
              }
            ],
            "",
            [
              {
                "annotation_ids": [
                  "91f97cb93a07be17"
                ],
                "status_id": 2,
                "text": "- A list of [beacon versions](#beacon-version-initialization)"
              }
            ],
            [
              {
                "annotation_ids": [
                  "91f97cb93a07be17"
                ],
                "status_id": 2,
                "text": "- The [version number](#version-number) of the [beacon versions](#beacon-version-initialization) to be used for writing."
              }
            ],
            "",
            [
              {
                "annotation_ids": [
                  "26d6b9430e00aa1b",
                  "c5c086a2c8b84531"
                ],
                "status_id": 1,
                "text": "Initialization MUST fail if the length of the list of [beacon versions](#beacon-version-initialization) is not 1."
              }
            ],
            "",
            [
              {
                "annotation_ids": [
                  "0c69c1154c06f4c6",
                  "61dbaa774ab4208f"
                ],
                "status_id": 1,
                "text": "Initialization MUST fail if the [version number](#version-number) is not `1`."
              }
            ]
          ],
          "requirements": [
            "3d09b7c2eeef298c",
            "c5c086a2c8b84531",
            "61dbaa774ab4208f"
          ],
          "title": "Initialization"
        },
        {
          "id": "configured-field",
          "lines": [
            "A name refers to a configured field if it appears in the",
            "[item encryptor](../dynamodb-encryption-client/ddb-item-encryptor.md#initialization)",
            "configuration as one of the",
            "[attribute actions](../dynamodb-encryption-client/ddb-item-encryptor.md#attribute-actions) or",
            "[unauthenticated attributes](../dynamodb-encryption-client/ddb-item-encryptor.md#unauthenticated-attributes),",
            "or begins with the [unauthenticated attribute prefix](../dynamodb-encryption-client/ddb-item-encryptor.md#unauthenticated-attribute-prefix)."
          ],
          "title": "Configured Field"
        },
        {
          "id": "beacon-version-initialization",
          "lines": [
            [
              {
                "annotation_ids": [
                  "3284284ddec80e2b",
                  "216a57722cdb9796"
                ],
                "status_id": 1,
                "text": "On initialization of a Beacon Version, the caller MUST provide:"
              }
            ],
            "",
            [
              {
                "annotation_ids": [
                  "3284284ddec80e2b"
                ],
                "status_id": 2,
                "text": "- A [version number](#version number)"
              }
            ],
            [
              {
                "annotation_ids": [
                  "3284284ddec80e2b"
                ],
                "status_id": 2,
                "text": "- A [Beacon Key Source](#beacon-key-source)"
              }
            ],
            [
              {
                "annotation_ids": [
                  "3284284ddec80e2b"
                ],
                "status_id": 2,
                "text": "- A [Keystore](#keystore)"
              }
            ],
            [
              {
                "annotation_ids": [
                  "3284284ddec80e2b"
                ],
                "status_id": 2,
                "text": "- A list of [standard beacons](beacons.md#standard-beacon-initialization)"
              }
            ],
            "",
            [
              {
                "annotation_ids": [
                  "b6f75a9022434073",
                  "65aed80041cd0dbb"
                ],
                "status_id": 3,
                "text": "On initialization of the Beacon Version, the caller MAY provide:"
              }
            ],
            "",
            [
              {
                "annotation_ids": [
                  "b6f75a9022434073"
                ],
                "status_id": 2,
                "text": "- A list of [compound beacons](beacons.md#compound-beacon-initialization)"
              }
            ],
            [
              {
                "annotation_ids": [
                  "b6f75a9022434073"
                ],
                "status_id": 2,
                "text": "- A list of [virtual fields](virtual.md#virtual-field-initialization)"
              }
            ],
            "- A list of [signed parts](beacons.md#signed-part-initialization)",
            "- A list of [encrypted parts](beacons.md#encrypted-part-initialization)",
            "",
            [
              {
                "annotation_ids": [
                  "fc6b2a00d1b772b0",
                  "eab859e1628d3158"
                ],
                "status_id": 1,
                "text": "Initialization MUST fail if the [version number](#version number) is not `1`."
              }
            ],
            "",
            [
              {
                "annotation_ids": [
                  "e1ff83b9376e648a",
                  "6d1e31e54a230e96"
                ],
                "status_id": 1,
                "text": "Initialization MUST fail if at least one [standard beacon](beacons.md#standard-beacon)"
              }
            ],
            [
              {
                "annotation_ids": [
                  "e1ff83b9376e648a",
                  "6d1e31e54a230e96"
                ],
                "status_id": 1,
                "text": "is not provided."
              }
            ],
            "",
            [
              {
                "annotation_ids": [
                  "7fae549e19aa4cbc",
                  "681944187d44b0f9"
                ],
                "status_id": 1,
                "text": "Initialization MUST fail if the name of any [virtual fields](virtual.md#virtual-field) matches that"
              }
            ],
            [
              {
                "annotation_ids": [
                  "7fae549e19aa4cbc",
                  "681944187d44b0f9"
                ],
                "status_id": 1,
                "text": "of any [configured field](#configured-field)."
              }
            ],
            "",
            [
              {
                "annotation_ids": [
                  "214d0a5d1b46905d",
                  "969b7201d07c3149"
                ],
                "status_id": 7,
                "text": "Initialization MUST fail if the [beacon key source](#beacon-key-source) is a [multi key store](#multi-key-store-initialization)"
              }
            ],
            [
              {
                "annotation_ids": [
                  "214d0a5d1b46905d",
                  "969b7201d07c3149"
                ],
                "status_id": 7,
                "text": "and the name of any of the following match the [beacon key field name](#beacon-key-field-name)"
              }
            ],
            "",
            [
              {
                "annotation_ids": [
                  "214d0a5d1b46905d"
                ],
                "status_id": 13,
                "text": "- [virtual fields](virtual.md#virtual-field)"
              }
            ],
            [
              {
                "annotation_ids": [
                  "214d0a5d1b46905d"
                ],
                "status_id": 13,
                "text": "- [standard beacons](beacons.md#standard-beacon)"
              }
            ],
            [
              {
                "annotation_ids": [
                  "214d0a5d1b46905d"
                ],
                "status_id": 13,
                "text": "- [compound beacons](beacons.md#compound-beacon)"
              }
            ],
            "",
            [
              {
                "annotation_ids": [
                  "d63efff60454a78f",
                  "f5d9b1d41ba3267e"
                ],
                "status_id": 1,
                "text": "Initialization MUST fail if the [beacon key source](#beacon-key-source) is a [multi key store](#multi-key-store-initialization)"
              }
            ],
            [
              {
                "annotation_ids": [
                  "d63efff60454a78f",
                  "f5d9b1d41ba3267e"
                ],
                "status_id": 1,
                "text": "and the [beacon key field name](#beacon-key-field-name)"
              }
            ],
            [
              {
                "annotation_ids": [
                  "d63efff60454a78f",
                  "f5d9b1d41ba3267e"
                ],
                "status_id": 1,
                "text": "is a [configured field](#configured-field)"
              }
            ],
            [
              {
                "annotation_ids": [
                  "d63efff60454a78f",
                  "f5d9b1d41ba3267e"
                ],
                "status_id": 1,
                "text": "with [ENCRYPT_AND_SIGN](../structured-encryption/structures.md#encrypt_and_sign)."
              }
            ],
            "",
            [
              {
                "annotation_ids": [
                  "96d76ffcceeb45c4",
                  "847b3ed4fe60c816"
                ],
                "status_id": 1,
                "text": "Initialization MUST fail if the name of any [standard beacon](beacons.md#standard-beacon)"
              }
            ],
            [
              {
                "annotation_ids": [
                  "96d76ffcceeb45c4",
                  "847b3ed4fe60c816"
                ],
                "status_id": 1,
                "text": "matches that of any unencrypted [configured field](#configured-field)."
              }
            ],
            "",
            [
              {
                "annotation_ids": [
                  "422399b8b8d80318",
                  "8d13ebd5e512d56c"
                ],
                "status_id": 1,
                "text": "Initialization MUST fail if the name of any [compound beacon](beacons.md#compound-beacon)"
              }
            ],
            [
              {
                "annotation_ids": [
                  "422399b8b8d80318",
                  "8d13ebd5e512d56c"
                ],
                "status_id": 1,
                "text": "matches that of any unencrypted [configured field](#configured-field)."
              }
            ],
            "",
            [
              {
                "annotation_ids": [
                  "aa3058670745c31a",
                  "4eaa55ffdc4984b6"
                ],
                "status_id": 1,
                "text": "Initialization MUST fail if there is any duplicates among the names of the"
              }
            ],
            [
              {
                "annotation_ids": [
                  "aa3058670745c31a",
                  "4eaa55ffdc4984b6"
                ],
                "status_id": 1,
                "text": "[standard beacons](beacons.md#standard-beacon)"
              }
            ],
            "",
            [
              {
                "annotation_ids": [
                  "1b72e81a800a341b",
                  "78252cd2df459b81"
                ],
                "status_id": 1,
                "text": "Initialization MUST fail if there is any duplicates among the names of the"
              }
            ],
            [
              {
                "annotation_ids": [
                  "1b72e81a800a341b",
                  "78252cd2df459b81"
                ],
                "status_id": 1,
                "text": "[compound beacons](beacons.md#compound-beacon)"
              }
            ],
            "",
            [
              {
                "annotation_ids": [
                  "071274a74859a09f",
                  "11f8de310c3cd411"
                ],
                "status_id": 1,
                "text": "Initialization MUST fail if the name of a"
              }
            ],
            [
              {
                "annotation_ids": [
                  "071274a74859a09f",
                  "11f8de310c3cd411"
                ],
                "status_id": 1,
                "text": "[compound beacons](beacons.md#compound-beacon)"
              }
            ],
            [
              {
                "annotation_ids": [
                  "071274a74859a09f",
                  "11f8de310c3cd411"
                ],
                "status_id": 1,
                "text": "matches the name of a"
              }
            ],
            [
              {
                "annotation_ids": [
                  "071274a74859a09f",
                  "11f8de310c3cd411"
                ],
                "status_id": 1,
                "text": "[standard beacons](beacons.md#standard-beacon)"
              }
            ],
            "",
            "A [terminal location](virtual.md#terminal-location) is considered `signed` if",
            "the field that contains it is [SIGN_ONLY](../structured-encryption/structures.md#sign_only)",
            "or [ENCRYPT_AND_SIGN](../structured-encryption/structures.md#encrypt_and_sign).",
            "",
            "A [terminal location](virtual.md#terminal-location) is considered `encrypted` if",
            "the field that contains it is [ENCRYPT_AND_SIGN](../structured-encryption/structures.md#encrypt_and_sign).",
            "",
            "A virtual field is considered `signed` if all of its",
            "[terminal locations](virtual.md#terminal-location) are `signed` or `encrypted`.",
            "",
            "A virtual field is considered `encrypted` if any of its",
            "[terminal locations](virtual.md#terminal-location) are `encrypted`.",
            "",
            [
              {
                "annotation_ids": [
                  "773b4a72c29b93b2",
                  "9a26717369e14487"
                ],
                "status_id": 1,
                "text": "Initialization MUST fail if any [virtual field](virtual.md#virtual-field) is not signed."
              }
            ],
            "",
            [
              {
                "annotation_ids": [
                  "a59a4296769c751f",
                  "bcafa1e3781a454d"
                ],
                "status_id": 7,
                "text": "Initialization MUST fail if the [terminal location](virtual.md#terminal-location)"
              }
            ],
            [
              {
                "annotation_ids": [
                  "a59a4296769c751f",
                  "bcafa1e3781a454d"
                ],
                "status_id": 7,
                "text": "reference by a [standard beacon](beacons.md#standard-beacon) is not `encrypted`."
              }
            ],
            "",
            [
              {
                "annotation_ids": [
                  "aef8bc33e663fb50",
                  "dd15ab4a5f7b3015"
                ],
                "status_id": 1,
                "text": "Initialization MUST fail if the [terminal location](virtual.md#terminal-location)"
              }
            ],
            [
              {
                "annotation_ids": [
                  "aef8bc33e663fb50",
                  "dd15ab4a5f7b3015"
                ],
                "status_id": 1,
                "text": "reference by a [signed part](beacons.md#signed-part) is `encrypted`,"
              }
            ],
            [
              {
                "annotation_ids": [
                  "aef8bc33e663fb50",
                  "dd15ab4a5f7b3015"
                ],
                "status_id": 1,
                "text": "or is not `signed`."
              }
            ]
          ],
          "requirements": [
            "216a57722cdb9796",
            "65aed80041cd0dbb",
            "eab859e1628d3158",
            "6d1e31e54a230e96",
            "6d1e31e54a230e96",
            "681944187d44b0f9",
            "681944187d44b0f9",
            "969b7201d07c3149",
            "969b7201d07c3149",
            "f5d9b1d41ba3267e",
            "f5d9b1d41ba3267e",
            "f5d9b1d41ba3267e",
            "f5d9b1d41ba3267e",
            "847b3ed4fe60c816",
            "847b3ed4fe60c816",
            "8d13ebd5e512d56c",
            "8d13ebd5e512d56c",
            "4eaa55ffdc4984b6",
            "4eaa55ffdc4984b6",
            "78252cd2df459b81",
            "78252cd2df459b81",
            "11f8de310c3cd411",
            "11f8de310c3cd411",
            "11f8de310c3cd411",
            "11f8de310c3cd411",
            "9a26717369e14487",
            "bcafa1e3781a454d",
            "bcafa1e3781a454d",
            "dd15ab4a5f7b3015",
            "dd15ab4a5f7b3015",
            "dd15ab4a5f7b3015"
          ],
          "title": "Beacon Version Initialization"
        },
        {
          "id": "global-parts-list",
          "lines": [
            "The [signed parts](beacons.md#signed-part-initialization) and",
            "[encrypted parts](beacons.md#encrypted-part-initialization) together are known as the",
            "Global Parts List.",
            "Parts specified in a [compound beacon's](beacons.md#compound-beacon-initialization) constructor,",
            "may come from any combination of their local definitions or the Global Parts List."
          ],
          "title": "Global Parts List"
        },
        {
          "id": "version-number",
          "lines": [
            [
              {
                "annotation_ids": [
                  "ed66c34d8941426c",
                  "c33f94a973dc8e38"
                ],
                "status_id": 1,
                "text": "A version number MUST be `1`."
              }
            ],
            "",
            "In the future, when versioning is supported, other positive integers will be allowed."
          ],
          "requirements": [
            "c33f94a973dc8e38"
          ],
          "title": "Version Number"
        },
        {
          "id": "versioning",
          "lines": [
            "There are some changes that can be made to a [beacon versions](#beacon-version-initialization)",
            "such that a record written with the old version might not be retrieved by a query",
            "using the new version.",
            "",
            "If such a change is necessary, one adds another [beacon versions](#beacon-version-initialization)",
            "with the next higher [version number](#version number).",
            "",
            "When a record is written, its beacons are generated using the version designated in the [search config](#initialization).",
            [
              {
                "annotation_ids": [
                  "3a3a10a06b71d50b",
                  "6ab9febd51807b33"
                ],
                "status_id": 1,
                "text": "In addition to the configured beacons, a [version tag](#version-tag) MUST also be written."
              }
            ],
            "",
            "When a querying a database, it might be necessary to make multiple queries, one per version,",
            "to successfully find all the records.",
            "For this reason, it is recommended that one rewrite all of the records from an old version with the new version.",
            "",
            "A version can safely be removed from the [search config](#initialization)",
            "when no records exists with the associate [version tag](#version-tag)."
          ],
          "requirements": [
            "6ab9febd51807b33"
          ],
          "title": "Versioning"
        },
        {
          "id": "version-tag",
          "lines": [
            "For version `N`, the name of the version tag is `aws_dbe_vN` and the value of the tag is a single space."
          ],
          "title": "Version Tag"
        },
        {
          "id": "beacon-key-source",
          "lines": [
            [
              {
                "annotation_ids": [
                  "497508a6205d3629",
                  "46fd3d458aaf6464"
                ],
                "status_id": 1,
                "text": "On initialization of a Beacon Key Source, the caller MUST provide exactly one of"
              }
            ],
            "",
            [
              {
                "annotation_ids": [
                  "497508a6205d3629"
                ],
                "status_id": 2,
                "text": "- a [Single Key Store](#single-key-store-initialization)"
              }
            ],
            [
              {
                "annotation_ids": [
                  "497508a6205d3629"
                ],
                "status_id": 2,
                "text": "- a [Multi Key Store](#multi-key-store-initialization)"
              }
            ]
          ],
          "requirements": [
            "46fd3d458aaf6464"
          ],
          "title": "Beacon Key Source"
        },
        {
          "id": "single-key-store-initialization",
          "lines": [
            "The single key store is intended to be used",
            "when all items in a DDB table will use the same beacon key.",
            "This can also be described as single tenant.",
            "",
            [
              {
                "annotation_ids": [
                  "4529878d3461dc68",
                  "c9735634929314e7"
                ],
                "status_id": 1,
                "text": "On initialization of a Single Key Store, the caller MUST provide:"
              }
            ],
            "",
            [
              {
                "annotation_ids": [
                  "4529878d3461dc68"
                ],
                "status_id": 2,
                "text": "- [Beacon Key Id](#beacon-key-id)"
              }
            ],
            [
              {
                "annotation_ids": [
                  "4529878d3461dc68"
                ],
                "status_id": 2,
                "text": "- [cacheTTL](#cachettl)"
              }
            ]
          ],
          "requirements": [
            "c9735634929314e7"
          ],
          "title": "Single Key Store Initialization"
        },
        {
          "id": "multi-key-store-initialization",
          "lines": [
            "The multi key store is intended to be used",
            "when different items in a DDB table will use the different beacon keys.",
            "This can also be described as multi tenant.",
            "",
            [
              {
                "annotation_ids": [
                  "8a8bcd81a0d798d2",
                  "3dea00262a9a81af"
                ],
                "status_id": 1,
                "text": "On initialization of a Multi Key Store, the caller MUST provide:"
              }
            ],
            "",
            [
              {
                "annotation_ids": [
                  "8a8bcd81a0d798d2"
                ],
                "status_id": 2,
                "text": "- [Beacon Key Field Name](#beacon-key-field-name)"
              }
            ],
            [
              {
                "annotation_ids": [
                  "8a8bcd81a0d798d2"
                ],
                "status_id": 2,
                "text": "- [cacheTTL](#cachettl)"
              }
            ],
            [
              {
                "annotation_ids": [
                  "8a8bcd81a0d798d2"
                ],
                "status_id": 2,
                "text": "- [max cache size](#max-cache-size)"
              }
            ]
          ],
          "requirements": [
            "3dea00262a9a81af"
          ],
          "title": "Multi Key Store Initialization"
        },
        {
          "id": "field-descriptions",
          "lines": [],
          "title": "Field descriptions"
        },
        {
          "id": "keystore",
          "lines": [
            "A [Keystore](../../submodules/MaterialProviders/aws-encryption-sdk-specification/framework/branch-key-store.md)",
            "used to obtain the configured Beacon Key.",
            [
              {
                "annotation_ids": [
                  "0326bca8d55367e4"
                ],
                "status_id": 9,
                "text": "If being used with a Hierarchical Keyring to encrypt/decrypt items,"
              }
            ],
            [
              {
                "annotation_ids": [
                  "0326bca8d55367e4"
                ],
                "status_id": 9,
                "text": "this SHOULD be the same Keystore as configured to that Keyring."
              }
            ]
          ],
          "requirements": [
            "0326bca8d55367e4",
            "0326bca8d55367e4"
          ],
          "title": "Keystore"
        },
        {
          "id": "beacon-key-id",
          "lines": [
            "A single [Beacon Key Id](../../submodules/MaterialProviders/aws-encryption-sdk-specification/framework/branch-key-store.md)",
            "that exists in the [keystore](#keystore)."
          ],
          "title": "Beacon Key Id"
        },
        {
          "id": "beacon-key-field-name",
          "lines": [
            "A attribute name that is used to identify the beacon key id.",
            "This attribute can be passed in on the DDB item,",
            "by default it will not be stored in the table",
            "but will be stored if an attribute action of SIGN_ONLY",
            "is configured.",
            "It can be referenced in [compound beacons](./beacons.md#compound-beacon)",
            "and used to extract a beacon key id from a query."
          ],
          "title": "Beacon Key Field Name"
        },
        {
          "id": "cachettl",
          "lines": [
            "The [cacheTTL](../../submodules/MaterialProviders/aws-encryption-sdk-specification/framework/cryptographic-materials-cache.md#time-to-live-ttl)",
            "for how long a beacon key should exist locally before reauthorization."
          ],
          "title": "cacheTTL"
        },
        {
          "id": "max-cache-size",
          "lines": [
            "The [max cache size](../../submodules/MaterialProviders/aws-encryption-sdk-specification/framework/local-cryptographic-materials-cache.md#entry-capacity)",
            "that the [Key Store Cache](#key-store-cache) will be configured to."
          ],
          "title": "max cache size"
        },
        {
          "id": "key-store-cache",
          "lines": [
            [
              {
                "annotation_ids": [
                  "6a609a019a3f0d79",
                  "b5281403dd2b92f7"
                ],
                "status_id": 7,
                "text": "For a Beacon Key Source a [CMC](../../submodules/MaterialProviders/aws-encryption-sdk-specification/framework/cryptographic-materials-cache.md)"
              }
            ],
            [
              {
                "annotation_ids": [
                  "6a609a019a3f0d79",
                  "b5281403dd2b92f7"
                ],
                "status_id": 7,
                "text": "MUST be created."
              }
            ],
            [
              {
                "annotation_ids": [
                  "752691b6e158d005",
                  "5303bd8bc4afff9d"
                ],
                "status_id": 7,
                "text": "For a [Single Key Store](#single-key-store-initialization) the [Entry Capacity](../../submodules/MaterialProviders/aws-encryption-sdk-specification/framework/cryptographic-materials-cache.md#entry-capacity)"
              }
            ],
            [
              {
                "annotation_ids": [
                  "752691b6e158d005",
                  "5303bd8bc4afff9d"
                ],
                "status_id": 7,
                "text": "MUST be 1"
              }
            ],
            [
              {
                "annotation_ids": [
                  "752691b6e158d005",
                  "5303bd8bc4afff9d"
                ],
                "status_id": 7,
                "text": "For a [Multi Key Store](#multi-key-store-initialization) the [Entry Capacity](../../submodules/MaterialProviders/aws-encryption-sdk-specification/framework/cryptographic-materials-cache.md#entry-capacity)"
              }
            ],
            [
              {
                "annotation_ids": [
                  "752691b6e158d005",
                  "5303bd8bc4afff9d"
                ],
                "status_id": 7,
                "text": "MUST be key store's max cache size."
              }
            ],
            "",
            [
              {
                "annotation_ids": [
                  "f3ec773ae9ed85f1"
                ],
                "status_id": 8,
                "text": "The Key Store Cache MUST be bound to the Beacon Key Source."
              }
            ],
            "This is currently invariant because we construct the cache for each search config",
            "It is easy for beacon key ids to be unique within a single key source,",
            "this may not be true across all key sources."
          ],
          "requirements": [
            "b5281403dd2b92f7",
            "b5281403dd2b92f7",
            "5303bd8bc4afff9d",
            "5303bd8bc4afff9d",
            "5303bd8bc4afff9d",
            "5303bd8bc4afff9d",
            "f3ec773ae9ed85f1"
          ],
          "title": "Key Store Cache"
        },
        {
          "id": "beacon-keys",
          "lines": [
            "In order for [beacons](./beacons.md) to function they need materials.",
            "Beacon keys are these materials.",
            "A beacon key forms a hierarchy of HMAC keys for all searchable components.",
            [
              {
                "annotation_ids": [
                  "de5fcbe635a1dc1e",
                  "e33bcee003d9d8b5"
                ],
                "status_id": 7,
                "text": "Beacon keys MUST be obtained from the configured [Beacon Key Source](#beacon-key-source)."
              }
            ]
          ],
          "requirements": [
            "e33bcee003d9d8b5"
          ],
          "title": "Beacon Keys"
        },
        {
          "id": "get-beacon-key-after-encrypt",
          "lines": [
            "Takes a [Search Config](#search-config)",
            "and a [Parsed Header](../dynamodb-encryption-client/encrypt-item.md#parsed-header).",
            "",
            [
              {
                "annotation_ids": [
                  "8234ec8da3b8b957",
                  "c084bfae21fabc42"
                ],
                "status_id": 7,
                "text": "If the [Beacon Key Source](#beacon-key-source) is a [Single Key Store](#single-key-store-initialization)"
              }
            ],
            [
              {
                "annotation_ids": [
                  "8234ec8da3b8b957",
                  "c084bfae21fabc42"
                ],
                "status_id": 7,
                "text": "then `beacon key id` MUST be the configured [beacon key id](#beacon-key-id)"
              }
            ],
            "",
            [
              {
                "annotation_ids": [
                  "31364083a96b3162",
                  "b18de64e850cb1fa"
                ],
                "status_id": 7,
                "text": "If the [Beacon Key Source](#beacon-key-source) is a [Multi Key Store](#multi-key-store-initialization)"
              }
            ],
            [
              {
                "annotation_ids": [
                  "31364083a96b3162",
                  "b18de64e850cb1fa"
                ],
                "status_id": 7,
                "text": "then `beacon key id` MUST be obtained from [Get beacon key id from parsed header](#get-beacon-key-id-from-parsed-header)."
              }
            ],
            "",
            [
              {
                "annotation_ids": [
                  "883bdd7581369957",
                  "edd26684c6d67bf2"
                ],
                "status_id": 7,
                "text": "The `beacon key id`, [Key Store Cache](#key-store-cache), and a `KeyStore`"
              }
            ],
            [
              {
                "annotation_ids": [
                  "883bdd7581369957",
                  "edd26684c6d67bf2"
                ],
                "status_id": 7,
                "text": "MUST be passed to [Get Beacon Key Materials](#get-beacon-key-materials)"
              }
            ],
            [
              {
                "annotation_ids": [
                  "883bdd7581369957",
                  "edd26684c6d67bf2"
                ],
                "status_id": 7,
                "text": "and the result returned for Get beacon key after encrypt."
              }
            ]
          ],
          "requirements": [
            "c084bfae21fabc42",
            "c084bfae21fabc42",
            "b18de64e850cb1fa",
            "b18de64e850cb1fa",
            "edd26684c6d67bf2",
            "edd26684c6d67bf2",
            "edd26684c6d67bf2"
          ],
          "title": "Get beacon key after encrypt"
        },
        {
          "id": "get-beacon-key-id-from-parsed-header",
          "lines": [
            "Takes a [Parsed Header](../dynamodb-encryption-client/encrypt-item.md#parsed-header).",
            "",
            [
              {
                "annotation_ids": [
                  "7cf2f1a25e58ebb4",
                  "c69ffb1bd3132645"
                ],
                "status_id": 1,
                "text": "If the [Parsed Header](../dynamodb-encryption-client/encrypt-item.md#parsed-header)'s encrypted data keys"
              }
            ],
            [
              {
                "annotation_ids": [
                  "7cf2f1a25e58ebb4",
                  "c69ffb1bd3132645"
                ],
                "status_id": 1,
                "text": "do not contain only one encrypted data key"
              }
            ],
            [
              {
                "annotation_ids": [
                  "7cf2f1a25e58ebb4",
                  "c69ffb1bd3132645"
                ],
                "status_id": 1,
                "text": "this function MUST fail."
              }
            ],
            "",
            [
              {
                "annotation_ids": [
                  "fdcd49977ccb22cc",
                  "5d3bdb3c94d76f92"
                ],
                "status_id": 1,
                "text": "If this single encrypted data key's"
              }
            ],
            [
              {
                "annotation_ids": [
                  "fdcd49977ccb22cc",
                  "5d3bdb3c94d76f92"
                ],
                "status_id": 1,
                "text": "[Key Provider ID](../../submodules/MaterialProviders/aws-encryption-sdk-specification/framework/../structured-encryption/structures.md#key-provider-id)"
              }
            ],
            [
              {
                "annotation_ids": [
                  "fdcd49977ccb22cc",
                  "5d3bdb3c94d76f92"
                ],
                "status_id": 1,
                "text": "does not equal the provider ID"
              }
            ],
            [
              {
                "annotation_ids": [
                  "fdcd49977ccb22cc",
                  "5d3bdb3c94d76f92"
                ],
                "status_id": 1,
                "text": "for the [AWS KMS Hierarchical Keyring](../../submodules/MaterialProviders/aws-encryption-sdk-specification/framework/aws-kms/aws-kms-hierarchical-keyring.md#ondecrypt)"
              }
            ],
            [
              {
                "annotation_ids": [
                  "fdcd49977ccb22cc",
                  "5d3bdb3c94d76f92"
                ],
                "status_id": 1,
                "text": "this function MUST fail."
              }
            ],
            "",
            [
              {
                "annotation_ids": [
                  "8da88417fd8ebd70",
                  "f29b57477022d789"
                ],
                "status_id": 1,
                "text": "This function MUST return the [Key Provider Information](../../submodules/MaterialProviders/aws-encryption-sdk-specification/framework/../structured-encryption/structures.md#key-provider-id)."
              }
            ]
          ],
          "requirements": [
            "c69ffb1bd3132645",
            "c69ffb1bd3132645",
            "c69ffb1bd3132645",
            "5d3bdb3c94d76f92",
            "5d3bdb3c94d76f92",
            "5d3bdb3c94d76f92",
            "5d3bdb3c94d76f92",
            "5d3bdb3c94d76f92",
            "f29b57477022d789"
          ],
          "title": "Get beacon key id from Parsed Header"
        },
        {
          "id": "get-beacon-key-for-query",
          "lines": [
            "Takes a [Search Config](#search-config) and a Query Object",
            "",
            [
              {
                "annotation_ids": [
                  "23b46b285f97ba2c",
                  "37601005f427339a"
                ],
                "status_id": 1,
                "text": "If the [Beacon Key Source](#beacon-key-source) is a [Single Key Store](#single-key-store-initialization)"
              }
            ],
            [
              {
                "annotation_ids": [
                  "23b46b285f97ba2c",
                  "37601005f427339a"
                ],
                "status_id": 1,
                "text": "then `beacon key id` MUST be the configured [beacon key id](#beacon-key-id)"
              }
            ],
            "",
            "If the [Beacon Key Source](#beacon-key-source) is a [Multi Key Store](#multi-key-store-initialization)",
            "then for each Key Condition Expression or Filter Expression,",
            "extract the value of any [signed part](./beacons.md#signed-part-initialization)",
            "of any [compound beacons](beacons.md#compound-beacon)",
            "with the `name` that equals [Beacon Key Field Name](#beacon-key-field-name)",
            "and construct a list of beacon key ids.",
            "",
            [
              {
                "annotation_ids": [
                  "b07dc8c900644675",
                  "d7f6575c9ce79e59"
                ],
                "status_id": 1,
                "text": "If this list of beacon key ids is empty get beacon key for query MUST"
              }
            ],
            [
              {
                "annotation_ids": [
                  "b07dc8c900644675",
                  "d7f6575c9ce79e59"
                ],
                "status_id": 1,
                "text": "return a flag indicating this."
              }
            ],
            "",
            [
              {
                "annotation_ids": [
                  "d6c2ba8decd36082",
                  "17f4a7cfdbfb6363"
                ],
                "status_id": 1,
                "text": "A query MUST fail if this flag is present, and any part of the query"
              }
            ],
            [
              {
                "annotation_ids": [
                  "d6c2ba8decd36082",
                  "17f4a7cfdbfb6363"
                ],
                "status_id": 1,
                "text": "requires a key; that is, needs to compute a standard beacon."
              }
            ],
            "",
            [
              {
                "annotation_ids": [
                  "afe08e0cd3d4462f",
                  "8ca498ea42b0521d"
                ],
                "status_id": 1,
                "text": "If this list of beacon key ids has more than one unique beacon key id"
              }
            ],
            [
              {
                "annotation_ids": [
                  "afe08e0cd3d4462f",
                  "8ca498ea42b0521d"
                ],
                "status_id": 1,
                "text": "then get beacon key for query MUST fail."
              }
            ],
            "",
            [
              {
                "annotation_ids": [
                  "9c4afd533068694c",
                  "b06582898a26fe8b"
                ],
                "status_id": 1,
                "text": "`beacon key id` MUST be this unique value."
              }
            ],
            "",
            [
              {
                "annotation_ids": [
                  "73be0737c92780d5"
                ],
                "status_id": 8,
                "text": "The `beacon key id`, [Key Store Cache](#key-store-cache), and a `KeyStore`"
              }
            ],
            [
              {
                "annotation_ids": [
                  "73be0737c92780d5"
                ],
                "status_id": 8,
                "text": "MUST be passed to [Get Beacon Key Materials](#get-beacon-key-materials)"
              }
            ],
            [
              {
                "annotation_ids": [
                  "73be0737c92780d5"
                ],
                "status_id": 8,
                "text": "and the result returned for Get beacon key for query."
              }
            ]
          ],
          "requirements": [
            "37601005f427339a",
            "37601005f427339a",
            "d7f6575c9ce79e59",
            "d7f6575c9ce79e59",
            "17f4a7cfdbfb6363",
            "17f4a7cfdbfb6363",
            "8ca498ea42b0521d",
            "8ca498ea42b0521d",
            "b06582898a26fe8b",
            "73be0737c92780d5",
            "73be0737c92780d5",
            "73be0737c92780d5"
          ],
          "title": "Get beacon key for query"
        },
        {
          "id": "get-beacon-key-materials",
          "lines": [
            "Takes a `beacon key id`, [Key Store Cache](#key-store-cache), and a `KeyStore`",
            "",
            [
              {
                "annotation_ids": [
                  "cb647e9a8f0f5150",
                  "ce5517a490ef4625"
                ],
                "status_id": 1,
                "text": "Get beacon key MUST Call the associated [Key Store Cache](#key-store-cache)"
              }
            ],
            [
              {
                "annotation_ids": [
                  "cb647e9a8f0f5150",
                  "ce5517a490ef4625"
                ],
                "status_id": 1,
                "text": "[Get Cache Entry](../../submodules/MaterialProviders/aws-encryption-sdk-specification/framework/local-cryptographic-materials-cache.md#get-cache-entry)"
              }
            ],
            [
              {
                "annotation_ids": [
                  "cb647e9a8f0f5150",
                  "ce5517a490ef4625"
                ],
                "status_id": 1,
                "text": "with the `beacon key id`."
              }
            ],
            "",
            [
              {
                "annotation_ids": [
                  "073a59e31418744f",
                  "bbeb42ad9b8d3a6d"
                ],
                "status_id": 1,
                "text": "If a [cache entry](../../submodules/MaterialProviders/aws-encryption-sdk-specification/framework/cryptographic-materials-cache.md#cache-entry)"
              }
            ],
            [
              {
                "annotation_ids": [
                  "073a59e31418744f",
                  "bbeb42ad9b8d3a6d"
                ],
                "status_id": 1,
                "text": "exists, get beacon key MUST return the [entry materials](../../submodules/MaterialProviders/aws-encryption-sdk-specification/framework/cryptographic-materials-cache.md#materials)."
              }
            ],
            "",
            [
              {
                "annotation_ids": [
                  "abf47f0a1bd7c6fe",
                  "7d7dae3db9e21c07"
                ],
                "status_id": 1,
                "text": "The `beacon key id` MUST be passed to the configured `KeyStore`'s `GetBeaconKey` operation."
              }
            ],
            [
              {
                "annotation_ids": [
                  "44e733a458a43860",
                  "b7a123a8761a3230"
                ],
                "status_id": 1,
                "text": "If `GetBeaconKey` fails get beacon key MUST fail."
              }
            ],
            "",
            [
              {
                "annotation_ids": [
                  "594323f04ec48a66",
                  "a41b2ad56654aada"
                ],
                "status_id": 7,
                "text": "For every [standard beacons](beacons.md#standard-beacon-initialization) an HMAC key"
              }
            ],
            [
              {
                "annotation_ids": [
                  "594323f04ec48a66",
                  "a41b2ad56654aada"
                ],
                "status_id": 7,
                "text": "MUST be generated in accordance with [HMAC Key Generation](#hmac-key-generation)."
              }
            ],
            "",
            [
              {
                "annotation_ids": [
                  "11ea5bc71cd35704",
                  "90bf62c5cc77d3c2"
                ],
                "status_id": 7,
                "text": "[Beacon Key Materials](../../submodules/MaterialProviders/aws-encryption-sdk-specification/framework/structures.md#beacon-key-materials) MUST be generated"
              }
            ],
            [
              {
                "annotation_ids": [
                  "11ea5bc71cd35704",
                  "90bf62c5cc77d3c2"
                ],
                "status_id": 7,
                "text": "with the [beacon key id](#beacon-key-id) equal to the `beacon key id`"
              }
            ],
            [
              {
                "annotation_ids": [
                  "11ea5bc71cd35704",
                  "90bf62c5cc77d3c2"
                ],
                "status_id": 7,
                "text": "and the [HMAC Keys](../../submodules/MaterialProviders/aws-encryption-sdk-specification/framework/structures.md#hmac-keys) equal to a map"
              }
            ],
            [
              {
                "annotation_ids": [
                  "11ea5bc71cd35704",
                  "90bf62c5cc77d3c2"
                ],
                "status_id": 7,
                "text": "of every [standard beacons](beacons.md#standard-beacon-initialization) name to its generated HMAC key."
              }
            ],
            "",
            [
              {
                "annotation_ids": [
                  "95d2fb061aa8a88a",
                  "08817b844f94f3a4"
                ],
                "status_id": 7,
                "text": "These materials MUST be put into the associated [Key Store Cache](#key-store-cache)"
              }
            ],
            [
              {
                "annotation_ids": [
                  "95d2fb061aa8a88a",
                  "08817b844f94f3a4"
                ],
                "status_id": 7,
                "text": "with an [Expiry Time](../../submodules/MaterialProviders/aws-encryption-sdk-specification/framework/cryptographic-materials-cache.md#expiry-time)"
              }
            ],
            [
              {
                "annotation_ids": [
                  "95d2fb061aa8a88a",
                  "08817b844f94f3a4"
                ],
                "status_id": 7,
                "text": "equal to now + configured [cacheTTL](#cachettl)."
              }
            ],
            "",
            [
              {
                "annotation_ids": [
                  "b90a65b9ee538c15",
                  "e5adc28bae927ba7"
                ],
                "status_id": 1,
                "text": "These cached materials MUST be returned."
              }
            ]
          ],
          "requirements": [
            "ce5517a490ef4625",
            "ce5517a490ef4625",
            "ce5517a490ef4625",
            "bbeb42ad9b8d3a6d",
            "bbeb42ad9b8d3a6d",
            "7d7dae3db9e21c07",
            "b7a123a8761a3230",
            "a41b2ad56654aada",
            "a41b2ad56654aada",
            "90bf62c5cc77d3c2",
            "90bf62c5cc77d3c2",
            "90bf62c5cc77d3c2",
            "90bf62c5cc77d3c2",
            "08817b844f94f3a4",
            "08817b844f94f3a4",
            "08817b844f94f3a4",
            "e5adc28bae927ba7"
          ],
          "title": "Get Beacon Key Materials"
        },
        {
          "id": "hmac-key-generation",
          "lines": [
            "Each beacon requires a key for use in its HMAC calculation.",
            "",
            [
              {
                "annotation_ids": [
                  "5ed13c284f86ad64",
                  "f947e9b51565e2de"
                ],
                "status_id": 1,
                "text": "For each beacon HKDF-SHA512 MUST be used"
              }
            ],
            [
              {
                "annotation_ids": [
                  "5ed13c284f86ad64",
                  "f947e9b51565e2de"
                ],
                "status_id": 1,
                "text": "to calculate the key for individual beacon,"
              }
            ],
            [
              {
                "annotation_ids": [
                  "5ed13c284f86ad64",
                  "f947e9b51565e2de"
                ],
                "status_id": 1,
                "text": "using the beacon key retrieved above as the initial key material with no salt."
              }
            ],
            [
              {
                "annotation_ids": [
                  "385fedfce12cdafc",
                  "3e68779f93672f75"
                ],
                "status_id": 1,
                "text": "The `info` MUST be the concatenation of \"AWS_DBE_SCAN_BEACON\" encoded as UTF8"
              }
            ],
            [
              {
                "annotation_ids": [
                  "385fedfce12cdafc",
                  "3e68779f93672f75"
                ],
                "status_id": 1,
                "text": "and the beacon name."
              }
            ],
            [
              {
                "annotation_ids": [
                  "462840dab6b2d348",
                  "d59e08e3681a0ad6"
                ],
                "status_id": 1,
                "text": "The `expectedLength` MUST be 64 bytes."
              }
            ]
          ],
          "requirements": [
            "f947e9b51565e2de",
            "f947e9b51565e2de",
            "f947e9b51565e2de",
            "3e68779f93672f75",
            "3e68779f93672f75",
            "d59e08e3681a0ad6"
          ],
          "title": "HMAC Key Generation"
        }
      ],
      "title": "Search Config"
    },
    "specification/searchable-encryption/virtual.md": {
      "format": "markdown",
      "sections": [
        {
          "id": "virtual-fields",
          "lines": [],
          "title": "Virtual Fields"
        },
        {
          "id": "version",
          "lines": [
            "1.0.0"
          ],
          "title": "Version"
        },
        {
          "id": "changelog",
          "lines": [],
          "title": "Changelog"
        },
        {
          "id": "overview",
          "lines": [
            "A virtual field is a field constructed from parts of other fields, but never stored.",
            "",
            "A virtual field can be used in the construction of a [beacon](beacons.md)",
            "which can be stored in the database and can be used to search.",
            "",
            "For example a virtual NameTag field, which is constructed from the first letter of the FirstName",
            "field followed by the LastName field, all in lowercase.",
            "",
            "When querying, the customer must construct the virtual field value, and use it like",
            "any other search term, e.g. `NameTag=jsmith`. Other than this, and the initial configuration,",
            "the user experience is the same as if there were no virtual beacons, e.g. results never",
            "contain virtual field values."
          ],
          "title": "Overview"
        },
        {
          "id": "virtual-field-initialization",
          "lines": [
            [
              {
                "annotation_ids": [
                  "d68381727d194194",
                  "f31aed678caffc7f"
                ],
                "status_id": 1,
                "text": "On initialization of a Virtual Field, the caller MUST provide:"
              }
            ],
            "",
            [
              {
                "annotation_ids": [
                  "d68381727d194194"
                ],
                "status_id": 2,
                "text": "- A name -- a string"
              }
            ],
            [
              {
                "annotation_ids": [
                  "d68381727d194194"
                ],
                "status_id": 2,
                "text": "- A list of [Virtual Parts](#virtual-part-initialization)"
              }
            ],
            "",
            [
              {
                "annotation_ids": [
                  "eba1a02e8aa7327b",
                  "47382a2f38fd361a"
                ],
                "status_id": 7,
                "text": "The evaluation of a Virtual Field MUST be the concatenation of all of its parts,"
              }
            ],
            [
              {
                "annotation_ids": [
                  "eba1a02e8aa7327b",
                  "47382a2f38fd361a"
                ],
                "status_id": 7,
                "text": "in the order they are configured."
              }
            ],
            "",
            [
              {
                "annotation_ids": [
                  "b8d5d9924038a86d",
                  "c02cc8eb6fe1fa34"
                ],
                "status_id": 1,
                "text": "Initialization MUST fail if two virtual fields are defined with the same set of locations."
              }
            ],
            "",
            [
              {
                "annotation_ids": [
                  "4b6f511c1de26c14",
                  "6af1438a3816ce76"
                ],
                "status_id": 1,
                "text": "Initialization MUST fail if a virtual field is defined with only one location,"
              }
            ],
            [
              {
                "annotation_ids": [
                  "4b6f511c1de26c14",
                  "6af1438a3816ce76"
                ],
                "status_id": 1,
                "text": "and also a [standard beacon](beacons.md#standard-beacon) is defined with that same location."
              }
            ]
          ],
          "requirements": [
            "f31aed678caffc7f",
            "47382a2f38fd361a",
            "47382a2f38fd361a",
            "c02cc8eb6fe1fa34",
            "6af1438a3816ce76",
            "6af1438a3816ce76"
          ],
          "title": "Virtual Field Initialization"
        },
        {
          "id": "virtual-part-initialization",
          "lines": [
            [
              {
                "annotation_ids": [
                  "f469f0f859c730a2",
                  "3ffcf9246c89c167"
                ],
                "status_id": 1,
                "text": "On initialization of a Virtual Part, the caller MUST provide:"
              }
            ],
            "",
            [
              {
                "annotation_ids": [
                  "f469f0f859c730a2"
                ],
                "status_id": 2,
                "text": "- A location -- a [Terminal Location](#terminal-location)"
              }
            ],
            "",
            [
              {
                "annotation_ids": [
                  "2a9496236040801d",
                  "2d382e1736c55115"
                ],
                "status_id": 3,
                "text": "On initialization of a Virtual Part, the caller MAY provide:"
              }
            ],
            "",
            [
              {
                "annotation_ids": [
                  "2a9496236040801d"
                ],
                "status_id": 2,
                "text": "- A list of [Virtual Transforms](#virtual-transform-initialization)"
              }
            ],
            "",
            [
              {
                "annotation_ids": [
                  "f501b1cdf4d4a05e",
                  "c7d5c94053091a9e"
                ],
                "status_id": 7,
                "text": "The evaluation of a Virtual Part MUST be the value of its location,"
              }
            ],
            [
              {
                "annotation_ids": [
                  "f501b1cdf4d4a05e",
                  "c7d5c94053091a9e"
                ],
                "status_id": 7,
                "text": "which is then transformed by each Virtual Transform,"
              }
            ],
            [
              {
                "annotation_ids": [
                  "f501b1cdf4d4a05e",
                  "c7d5c94053091a9e"
                ],
                "status_id": 7,
                "text": "in the order they are configured."
              }
            ],
            "",
            [
              {
                "annotation_ids": [
                  "6e309de00ae5fd18",
                  "10a71cbdbf4f4219"
                ],
                "status_id": 1,
                "text": "Evaluation MUST return no value if the location does not exist,"
              }
            ],
            [
              {
                "annotation_ids": [
                  "6e309de00ae5fd18",
                  "10a71cbdbf4f4219"
                ],
                "status_id": 1,
                "text": "or is not a plain string value."
              }
            ]
          ],
          "requirements": [
            "3ffcf9246c89c167",
            "2d382e1736c55115",
            "c7d5c94053091a9e",
            "c7d5c94053091a9e",
            "c7d5c94053091a9e",
            "10a71cbdbf4f4219",
            "10a71cbdbf4f4219"
          ],
          "title": "Virtual Part Initialization"
        },
        {
          "id": "virtual-transform-initialization",
          "lines": [
            [
              {
                "annotation_ids": [
                  "9bef47691ac50055",
                  "70ac2e32bd644a1f"
                ],
                "status_id": 1,
                "text": "On initialization of a Virtual Transform, the caller MUST provide exactly one of"
              }
            ],
            "",
            [
              {
                "annotation_ids": [
                  "9bef47691ac50055"
                ],
                "status_id": 2,
                "text": "- an [Upper](#upper-transform-initialization) transform"
              }
            ],
            [
              {
                "annotation_ids": [
                  "9bef47691ac50055"
                ],
                "status_id": 2,
                "text": "- a [Lower](#lower-transform-initialization) transform"
              }
            ],
            [
              {
                "annotation_ids": [
                  "9bef47691ac50055"
                ],
                "status_id": 2,
                "text": "- an [Insert](#insert-transform-initialization) transform"
              }
            ],
            [
              {
                "annotation_ids": [
                  "9bef47691ac50055"
                ],
                "status_id": 2,
                "text": "- a [GetPrefix](#getprefix-transform-initialization) transform"
              }
            ],
            [
              {
                "annotation_ids": [
                  "9bef47691ac50055"
                ],
                "status_id": 2,
                "text": "- a [GetSuffix](#getsuffix-transform-initialization) transform"
              }
            ],
            [
              {
                "annotation_ids": [
                  "9bef47691ac50055"
                ],
                "status_id": 2,
                "text": "- a [GetSubstring](#getsubstring-transform-initialization) transform"
              }
            ],
            [
              {
                "annotation_ids": [
                  "9bef47691ac50055"
                ],
                "status_id": 2,
                "text": "- a [GetSegment](#getsegment-transform-initialization) transform"
              }
            ],
            [
              {
                "annotation_ids": [
                  "9bef47691ac50055"
                ],
                "status_id": 2,
                "text": "- a [GetSegments](#getsegments-transform-initialization) transform"
              }
            ],
            "",
            "All transforms take a string as input and produce a string as output."
          ],
          "requirements": [
            "70ac2e32bd644a1f"
          ],
          "title": "Virtual Transform Initialization"
        },
        {
          "id": "upper-transform-initialization",
          "lines": [
            [
              {
                "annotation_ids": [
                  "33663a0ab64cf05d",
                  "24eaeded1c5a7ed4"
                ],
                "status_id": 1,
                "text": "On initialization of an Upper Transform, the caller MUST NOT provide any"
              }
            ],
            [
              {
                "annotation_ids": [
                  "33663a0ab64cf05d",
                  "24eaeded1c5a7ed4"
                ],
                "status_id": 1,
                "text": "additional parameters to the Upper Transform."
              }
            ],
            "",
            [
              {
                "annotation_ids": [
                  "2cb52b1aa74156ed",
                  "f7ae525e380e118f"
                ],
                "status_id": 1,
                "text": "The Upper transform MUST convert all ascii lowercase characters into their uppercase equivalents."
              }
            ]
          ],
          "requirements": [
            "24eaeded1c5a7ed4",
            "24eaeded1c5a7ed4",
            "f7ae525e380e118f"
          ],
          "title": "Upper Transform Initialization"
        },
        {
          "id": "lower-transform-initialization",
          "lines": [
            [
              {
                "annotation_ids": [
                  "c11527d99e7ca464",
                  "e854d76a54d0b5ed"
                ],
                "status_id": 1,
                "text": "On initialization of a Lower Transform, the caller MUST NOT provide any"
              }
            ],
            [
              {
                "annotation_ids": [
                  "c11527d99e7ca464",
                  "e854d76a54d0b5ed"
                ],
                "status_id": 1,
                "text": "additional parameters to the Lower Transform."
              }
            ],
            "",
            [
              {
                "annotation_ids": [
                  "29214a5b06bfcc0d",
                  "02683919cfab37c6"
                ],
                "status_id": 1,
                "text": "The Lower transform MUST convert all ascii uppercase characters into their lowercase equivalents."
              }
            ]
          ],
          "requirements": [
            "e854d76a54d0b5ed",
            "e854d76a54d0b5ed",
            "02683919cfab37c6"
          ],
          "title": "Lower Transform Initialization"
        },
        {
          "id": "insert-transform-initialization",
          "lines": [
            [
              {
                "annotation_ids": [
                  "973c4ae08c4de4fc",
                  "eb5ff7278de2dcd8"
                ],
                "status_id": 1,
                "text": "On initialization of an Insert Transform, the caller MUST provide:"
              }
            ],
            "",
            [
              {
                "annotation_ids": [
                  "973c4ae08c4de4fc"
                ],
                "status_id": 2,
                "text": "- a literal string"
              }
            ],
            "",
            [
              {
                "annotation_ids": [
                  "0592997dccf4543d",
                  "aef161badf029092"
                ],
                "status_id": 1,
                "text": "The Insert transform MUST append this string to its input"
              }
            ]
          ],
          "requirements": [
            "eb5ff7278de2dcd8",
            "aef161badf029092"
          ],
          "title": "Insert Transform Initialization"
        },
        {
          "id": "getprefix-transform-initialization",
          "lines": [
            [
              {
                "annotation_ids": [
                  "0087a6be6bcb58ef",
                  "e02c945b79a3f689"
                ],
                "status_id": 1,
                "text": "On initialization of a GetPrefix Transform, the caller MUST provide:"
              }
            ],
            "",
            [
              {
                "annotation_ids": [
                  "0087a6be6bcb58ef"
                ],
                "status_id": 2,
                "text": "- length : an integer"
              }
            ],
            "",
            [
              {
                "annotation_ids": [
                  "386e31cfa61196f9",
                  "d3ddb59dcf7a8580"
                ],
                "status_id": 1,
                "text": "If length is non-negative, the GetPrefix transform MUST return the first `length` characters of the input."
              }
            ],
            "",
            [
              {
                "annotation_ids": [
                  "4eada6b54943ab7d",
                  "9fc2bb2382f9f44f"
                ],
                "status_id": 1,
                "text": "If length is non-negative, and length exceeds the length of the string, the input string MUST be returned."
              }
            ],
            "",
            [
              {
                "annotation_ids": [
                  "d6eb5c7fe08f8fce",
                  "d0800b507fc20dfd"
                ],
                "status_id": 1,
                "text": "If length is negative, then the GetPrefix transform MUST return"
              }
            ],
            [
              {
                "annotation_ids": [
                  "d6eb5c7fe08f8fce",
                  "d0800b507fc20dfd"
                ],
                "status_id": 1,
                "text": "all but the last `-length` character of the input."
              }
            ],
            "",
            [
              {
                "annotation_ids": [
                  "f48a6641b3120ff5",
                  "0757e11750782aaf"
                ],
                "status_id": 1,
                "text": "If length is negative and -length exceeds the length on the input,"
              }
            ],
            [
              {
                "annotation_ids": [
                  "f48a6641b3120ff5",
                  "0757e11750782aaf"
                ],
                "status_id": 1,
                "text": "the empty string MUST be returned."
              }
            ]
          ],
          "requirements": [
            "e02c945b79a3f689",
            "d3ddb59dcf7a8580",
            "9fc2bb2382f9f44f",
            "d0800b507fc20dfd",
            "d0800b507fc20dfd",
            "0757e11750782aaf",
            "0757e11750782aaf"
          ],
          "title": "GetPrefix Transform Initialization"
        },
        {
          "id": "getsuffix-transform-initialization",
          "lines": [
            [
              {
                "annotation_ids": [
                  "c59c30fc239d92dc",
                  "0efa6c2e6cc42310"
                ],
                "status_id": 1,
                "text": "On initialization of a GetSuffix Transform, the caller MUST provide:"
              }
            ],
            "",
            [
              {
                "annotation_ids": [
                  "c59c30fc239d92dc"
                ],
                "status_id": 2,
                "text": "- length : an integer"
              }
            ],
            "",
            [
              {
                "annotation_ids": [
                  "5e5a2fc043259409",
                  "e365f9ceb477f121"
                ],
                "status_id": 1,
                "text": "If length is non-negative, the GetSuffix transform MUST return the last `length` characters of the input."
              }
            ],
            "",
            [
              {
                "annotation_ids": [
                  "15cf181c53ebbcd6",
                  "b3933983b55dff82"
                ],
                "status_id": 1,
                "text": "If length is non-negative, and length exceeds the length of the string, the input string MUST be returned."
              }
            ],
            "",
            [
              {
                "annotation_ids": [
                  "a65f97cd621d414a",
                  "0a5cebf417accb48"
                ],
                "status_id": 1,
                "text": "If length is negative, then the GetSuffix transform MUST return"
              }
            ],
            [
              {
                "annotation_ids": [
                  "a65f97cd621d414a",
                  "0a5cebf417accb48"
                ],
                "status_id": 1,
                "text": "all but the first `-length` character of the input."
              }
            ],
            "",
            [
              {
                "annotation_ids": [
                  "3349ce7aaeb0681c",
                  "7f5bf5f1eaf453a2"
                ],
                "status_id": 1,
                "text": "If length is negative and -length exceeds the length on the input,"
              }
            ],
            [
              {
                "annotation_ids": [
                  "3349ce7aaeb0681c",
                  "7f5bf5f1eaf453a2"
                ],
                "status_id": 1,
                "text": "the empty string MUST be returned."
              }
            ]
          ],
          "requirements": [
            "0efa6c2e6cc42310",
            "e365f9ceb477f121",
            "b3933983b55dff82",
            "0a5cebf417accb48",
            "0a5cebf417accb48",
            "7f5bf5f1eaf453a2",
            "7f5bf5f1eaf453a2"
          ],
          "title": "GetSuffix Transform Initialization"
        },
        {
          "id": "position-definition",
          "lines": [
            "The transforms below refer to positions within a list.",
            "",
            [
              {
                "annotation_ids": [
                  "c89e62fd79c00de2",
                  "28365c18cf068d3d"
                ],
                "status_id": 1,
                "text": "If the position provided is positive, it MUST be the zero-based index from the start of the list."
              }
            ],
            "",
            [
              {
                "annotation_ids": [
                  "428563b74979ba80",
                  "072fb97641bbfea4"
                ],
                "status_id": 1,
                "text": "If the position provided is negative, it's absolute value MUST be the"
              }
            ],
            [
              {
                "annotation_ids": [
                  "428563b74979ba80",
                  "072fb97641bbfea4"
                ],
                "status_id": 1,
                "text": "one-based index from the end of the list, that is, -1 refers to the last item in the list."
              }
            ],
            "",
            "Positions are always clamped to the bounds of the list. That is `-999999999` refers to the first item in the list, and `999999999` refers to the position just after the last item in the list."
          ],
          "requirements": [
            "28365c18cf068d3d",
            "072fb97641bbfea4",
            "072fb97641bbfea4"
          ],
          "title": "Position Definition"
        },
        {
          "id": "getsubstring-transform-initialization",
          "lines": [
            [
              {
                "annotation_ids": [
                  "42d979011be8d842",
                  "6aa15ddc9d64f396"
                ],
                "status_id": 1,
                "text": "On initialization of a GetSubstring Transform, the caller MUST provide:"
              }
            ],
            "",
            [
              {
                "annotation_ids": [
                  "42d979011be8d842"
                ],
                "status_id": 2,
                "text": "- low : an integer [position](#position-definition)"
              }
            ],
            [
              {
                "annotation_ids": [
                  "42d979011be8d842"
                ],
                "status_id": 2,
                "text": "- high : an integer [position](#position-definition)"
              }
            ],
            "",
            [
              {
                "annotation_ids": [
                  "600b431183acb5b1",
                  "0c5041d186c5f5db"
                ],
                "status_id": 1,
                "text": "The GetSubstring transform MUST return the range of characters"
              }
            ],
            [
              {
                "annotation_ids": [
                  "600b431183acb5b1",
                  "0c5041d186c5f5db"
                ],
                "status_id": 1,
                "text": "from low (inclusive) to high (exclusive)"
              }
            ],
            "",
            "If high is less than or equal to low, an empty string is returned."
          ],
          "requirements": [
            "6aa15ddc9d64f396",
            "0c5041d186c5f5db",
            "0c5041d186c5f5db"
          ],
          "title": "GetSubstring Transform Initialization"
        },
        {
          "id": "getsegment-transform-initialization",
          "lines": [
            [
              {
                "annotation_ids": [
                  "db492958b7004546",
                  "19200278c261b4b8"
                ],
                "status_id": 1,
                "text": "On initialization of a GetSegment Transform, the caller MUST provide:"
              }
            ],
            "",
            [
              {
                "annotation_ids": [
                  "db492958b7004546"
                ],
                "status_id": 2,
                "text": "- split : an character"
              }
            ],
            [
              {
                "annotation_ids": [
                  "db492958b7004546"
                ],
                "status_id": 2,
                "text": "- index : an integer [position](#position-definition)"
              }
            ],
            "",
            [
              {
                "annotation_ids": [
                  "229214e53072ef0e",
                  "69df5b8a502db379"
                ],
                "status_id": 1,
                "text": "The GetSegment transform MUST split the input string on the given character,"
              }
            ],
            [
              {
                "annotation_ids": [
                  "229214e53072ef0e",
                  "69df5b8a502db379"
                ],
                "status_id": 1,
                "text": "and return the item in the resulting list the corresponds to the given position."
              }
            ],
            "",
            [
              {
                "annotation_ids": [
                  "1247d834a9ca3ef5",
                  "8d763ece4ad439c8"
                ],
                "status_id": 1,
                "text": "If index is greater than the number of items in the list, an empty string MUST be returned."
              }
            ]
          ],
          "requirements": [
            "19200278c261b4b8",
            "69df5b8a502db379",
            "69df5b8a502db379",
            "8d763ece4ad439c8"
          ],
          "title": "GetSegment Transform Initialization"
        },
        {
          "id": "getsegments-transform-initialization",
          "lines": [
            [
              {
                "annotation_ids": [
                  "130a71376878041e",
                  "5b5a398d27c72a22"
                ],
                "status_id": 1,
                "text": "On initialization of a GetSegments Transform, the caller MUST provide:"
              }
            ],
            "",
            [
              {
                "annotation_ids": [
                  "130a71376878041e"
                ],
                "status_id": 2,
                "text": "- split : an character"
              }
            ],
            [
              {
                "annotation_ids": [
                  "130a71376878041e"
                ],
                "status_id": 2,
                "text": "- low : an integer [position](#position-definition)"
              }
            ],
            [
              {
                "annotation_ids": [
                  "130a71376878041e"
                ],
                "status_id": 2,
                "text": "- high : an integer [position](#position-definition)"
              }
            ],
            "",
            [
              {
                "annotation_ids": [
                  "311b946d8eb9265c",
                  "a1616242e82d35e7"
                ],
                "status_id": 1,
                "text": "The GetSegments transform MUST split the input string on the `split` character."
              }
            ],
            "",
            [
              {
                "annotation_ids": [
                  "156648e421aebb9d",
                  "bcc0178ceacd4cdc"
                ],
                "status_id": 1,
                "text": "GetSegments MUST return the range of parts from low (inclusive) to high (exclusive),"
              }
            ],
            [
              {
                "annotation_ids": [
                  "156648e421aebb9d",
                  "bcc0178ceacd4cdc"
                ],
                "status_id": 1,
                "text": "joined on the `split` character."
              }
            ],
            "",
            [
              {
                "annotation_ids": [
                  "df3ba3b91b356c22",
                  "59c05358a39941d7"
                ],
                "status_id": 1,
                "text": "If high is less than or equal to low, an empty string MUST be returned."
              }
            ]
          ],
          "requirements": [
            "5b5a398d27c72a22",
            "a1616242e82d35e7",
            "bcc0178ceacd4cdc",
            "bcc0178ceacd4cdc",
            "59c05358a39941d7"
          ],
          "title": "GetSegments Transform Initialization"
        },
        {
          "id": "terminal-location",
          "lines": [
            "A Terminal Location is a Path to a part of a piece of structured data.",
            "",
            "It is exactly equivalent to a DynamoDB document path, e.g. `foo` or `foo.bar` or `foo.bar[3].baz`",
            "",
            [
              {
                "annotation_ids": [
                  "ee9ef0842db04894",
                  "975ada8a67c28956"
                ],
                "status_id": 1,
                "text": "A Terminal Location specification MUST be a list of one more [Segments](#segments),"
              }
            ],
            [
              {
                "annotation_ids": [
                  "ee9ef0842db04894",
                  "975ada8a67c28956"
                ],
                "status_id": 1,
                "text": "the first one of which must be a string index."
              }
            ]
          ],
          "requirements": [
            "975ada8a67c28956",
            "975ada8a67c28956"
          ],
          "title": "Terminal Location"
        },
        {
          "id": "segments",
          "lines": [
            [
              {
                "annotation_ids": [
                  "83fcd8163f2dd8df",
                  "517cdec5aa9c0697"
                ],
                "status_id": 1,
                "text": "A Segment MUST be one of"
              }
            ],
            "",
            [
              {
                "annotation_ids": [
                  "83fcd8163f2dd8df"
                ],
                "status_id": 2,
                "text": "- A literal \".\" followed by a field name, indicating a lookup into a Structured Data Map."
              }
            ],
            [
              {
                "annotation_ids": [
                  "83fcd8163f2dd8df"
                ],
                "status_id": 2,
                "text": "- A literal \"[\" followed by a decimal integer followed by a literal \"]\","
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "  "
              },
              {
                "annotation_ids": [
                  "83fcd8163f2dd8df"
                ],
                "status_id": 2,
                "text": "indicating an index into a Structured Data List."
              }
            ]
          ],
          "requirements": [
            "517cdec5aa9c0697"
          ],
          "title": "Segments"
        }
      ],
      "title": "Virtual Fields"
    },
    "specification/structured-encryption/decrypt-path-structure.md": {
      "format": "markdown",
      "sections": [
        {
          "id": "decrypt-path-structure",
          "lines": [],
          "title": "Decrypt Path Structure"
        },
        {
          "id": "version",
          "lines": [
            "1.0.0"
          ],
          "title": "Version"
        },
        {
          "id": "changelog",
          "lines": [
            "- 1.0.0",
            "",
            "  - Initial record"
          ],
          "title": "Changelog"
        },
        {
          "id": "definitions",
          "lines": [],
          "title": "Definitions"
        },
        {
          "id": "conventions-used-in-this-document",
          "lines": [
            "The key words \"MUST\", \"MUST NOT\", \"REQUIRED\", \"SHALL\", \"SHALL NOT\", \"SHOULD\", \"SHOULD NOT\", \"RECOMMENDED\", \"MAY\", and \"OPTIONAL\"",
            "in this document are to be interpreted as described in [RFC 2119](https://tools.ietf.org/html/rfc2119)."
          ],
          "title": "Conventions used in this document"
        },
        {
          "id": "overview",
          "lines": [
            "This document describes the behavior by which a [Structured Data](./structures.md#structured-data)",
            "which has been [encrypted](./encrypt-structure.md) is decrypted.",
            "We define decryption over this [Structured Data](./structures.md#structured-data) to mean that",
            "we obtain back the original Structured Data,",
            "and ensure integrity and authenticity is ensured over a set of [Terminal Data](./structures.md#terminal-data)."
          ],
          "title": "Overview"
        },
        {
          "id": "input",
          "lines": [
            [
              {
                "annotation_ids": [
                  "9d8bed84167bf5fc",
                  "72ae0186b63754c9"
                ],
                "status_id": 1,
                "text": "The following inputs to this behavior are REQUIRED:"
              }
            ],
            "",
            [
              {
                "annotation_ids": [
                  "9d8bed84167bf5fc"
                ],
                "status_id": 2,
                "text": "- [Table Name](#table-name)"
              }
            ],
            [
              {
                "annotation_ids": [
                  "9d8bed84167bf5fc"
                ],
                "status_id": 2,
                "text": "- [Cryptographic Materials Manager (CMM)](#cmm)"
              }
            ],
            [
              {
                "annotation_ids": [
                  "9d8bed84167bf5fc"
                ],
                "status_id": 2,
                "text": "- [Auth List](#auth-list)"
              }
            ],
            "",
            [
              {
                "annotation_ids": [
                  "054ec855b9321516",
                  "18fcfbd07d6e016a"
                ],
                "status_id": 1,
                "text": "The following inputs to this behavior MUST be OPTIONAL:"
              }
            ],
            "",
            [
              {
                "annotation_ids": [
                  "054ec855b9321516"
                ],
                "status_id": 2,
                "text": "- [Encryption Context](#encryption-context)"
              }
            ]
          ],
          "requirements": [
            "72ae0186b63754c9",
            "18fcfbd07d6e016a"
          ],
          "title": "Input"
        },
        {
          "id": "table-name",
          "lines": [
            "The logical name for the structure.",
            "This can be the same as the physical name.",
            "For example the name of the table to hold the encrypted record."
          ],
          "title": "Table Name"
        },
        {
          "id": "auth-list",
          "lines": [
            "The [Auth List](./structures.md#auth-list) to be decrypted.",
            "",
            [
              {
                "annotation_ids": [
                  "d915228a92aa1c1b",
                  "21aa2d3d9c3ddc12"
                ],
                "status_id": 1,
                "text": "This Auth List MUST contain data located at the [header index](./header.md#header-index)"
              }
            ],
            [
              {
                "annotation_ids": [
                  "d915228a92aa1c1b",
                  "21aa2d3d9c3ddc12"
                ],
                "status_id": 1,
                "text": "and the [footer index](./footer.md#footer-index)."
              }
            ],
            "",
            "The Auth List describes how each [Terminal Data](./structures.md#terminal-data) should be treated during decryption.",
            "",
            [
              {
                "annotation_ids": [
                  "3796cfd5db2176c8",
                  "9d01df8b2f561ae4"
                ],
                "status_id": 1,
                "text": "The Auth List MUST include at least one [SIGN Authenticate Action](./structures.md#sign);"
              }
            ],
            [
              {
                "annotation_ids": [
                  "3796cfd5db2176c8",
                  "9d01df8b2f561ae4"
                ],
                "status_id": 1,
                "text": "otherwise, this operation MUST yield an error."
              }
            ],
            "",
            [
              {
                "annotation_ids": [
                  "16ff140faf65292e",
                  "d37f79c6bfa3f01e"
                ],
                "status_id": 1,
                "text": "The Auth List MUST NOT contain duplicate Paths."
              }
            ]
          ],
          "requirements": [
            "21aa2d3d9c3ddc12",
            "21aa2d3d9c3ddc12",
            "9d01df8b2f561ae4",
            "9d01df8b2f561ae4",
            "d37f79c6bfa3f01e"
          ],
          "title": "Auth List"
        },
        {
          "id": "cmm",
          "lines": [
            "A CMM that implements the [CMM interface](../../submodules/MaterialProviders/aws-encryption-sdk-specification/framework/cmm-interface.md)."
          ],
          "title": "CMM"
        },
        {
          "id": "encryption-context",
          "lines": [
            "See [encryption context](./structures.md#encryption-context).",
            "",
            "In order for decryption to succeed:",
            "",
            [
              {
                "annotation_ids": [
                  "a05cfe05d1247392"
                ],
                "status_id": 8,
                "text": "- This MUST include any key-values pairs that were used during the original [encryption](./encrypt-path-structure.md)"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "  "
              },
              {
                "annotation_ids": [
                  "a05cfe05d1247392"
                ],
                "status_id": 8,
                "text": "of the [input data](#auth-list),"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "  "
              },
              {
                "annotation_ids": [
                  "a05cfe05d1247392"
                ],
                "status_id": 8,
                "text": "but not stored in the [input Structured Data's header](./header.md#encryption-context)."
              }
            ],
            [
              {
                "annotation_ids": [
                  "41e2e65c7bb8f503"
                ],
                "status_id": 10,
                "text": "- This MAY include any key-values pairs that are stored"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "  "
              },
              {
                "annotation_ids": [
                  "41e2e65c7bb8f503"
                ],
                "status_id": 10,
                "text": "in the [input Structured Data's header](./header.md#encryption-context)."
              }
            ],
            [
              {
                "annotation_ids": [
                  "024cdf12f7fbef47"
                ],
                "status_id": 8,
                "text": "- This MUST NOT include any key-values pairs that were not"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "  "
              },
              {
                "annotation_ids": [
                  "024cdf12f7fbef47"
                ],
                "status_id": 8,
                "text": "used during the original [encryption](./encrypt-structure.md) of the [input data](#auth-list)."
              }
            ]
          ],
          "requirements": [
            "a05cfe05d1247392",
            "a05cfe05d1247392",
            "a05cfe05d1247392",
            "41e2e65c7bb8f503",
            "41e2e65c7bb8f503",
            "024cdf12f7fbef47",
            "024cdf12f7fbef47"
          ],
          "title": "Encryption Context"
        },
        {
          "id": "output",
          "lines": [
            [
              {
                "annotation_ids": [
                  "f307a0dc035482f8",
                  "614004e2f0aed936"
                ],
                "status_id": 1,
                "text": "This operation MUST output the following:"
              }
            ],
            "",
            [
              {
                "annotation_ids": [
                  "f307a0dc035482f8"
                ],
                "status_id": 2,
                "text": "- [Crypto List](./structures.md#crypto-list): Decrypted Terminals and the Crypto Schema for each Terminal,"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "  "
              },
              {
                "annotation_ids": [
                  "f307a0dc035482f8"
                ],
                "status_id": 2,
                "text": "calculated using the Crypto Legend in the header, the signature scope used for decryption, and the data in the input structure."
              }
            ],
            [
              {
                "annotation_ids": [
                  "f307a0dc035482f8"
                ],
                "status_id": 2,
                "text": "- [Parsed Header](#parsed-header)"
              }
            ]
          ],
          "requirements": [
            "614004e2f0aed936"
          ],
          "title": "Output"
        },
        {
          "id": "parsed-header",
          "lines": [
            [
              {
                "annotation_ids": [
                  "8749b83b00c5558d",
                  "a3396a4d8a47ff6a"
                ],
                "status_id": 1,
                "text": "This structure MUST contain the following values,"
              }
            ],
            [
              {
                "annotation_ids": [
                  "8749b83b00c5558d",
                  "a3396a4d8a47ff6a"
                ],
                "status_id": 1,
                "text": "representing the deserialized form of the header of the input encrypted structure:"
              }
            ],
            "",
            [
              {
                "annotation_ids": [
                  "8749b83b00c5558d"
                ],
                "status_id": 2,
                "text": "- [Algorithm Suite ID](./header.md#format-flavor): The Algorithm Suite ID associated with the Format Flavor on the header."
              }
            ],
            [
              {
                "annotation_ids": [
                  "8749b83b00c5558d"
                ],
                "status_id": 2,
                "text": "- [Stored Encryption Context](./header.md#encryption-context): The Encryption Context stored in the header."
              }
            ],
            [
              {
                "annotation_ids": [
                  "8749b83b00c5558d"
                ],
                "status_id": 2,
                "text": "- [Encrypted Data Keys](./header.md#encrypted-data-keys): The Encrypted Data Keys stored in the header."
              }
            ],
            [
              {
                "annotation_ids": [
                  "8749b83b00c5558d"
                ],
                "status_id": 2,
                "text": "- [Encryption Context](#encryption-context): The full Encryption Context used."
              }
            ]
          ],
          "requirements": [
            "a3396a4d8a47ff6a",
            "a3396a4d8a47ff6a"
          ],
          "title": "Parsed Header"
        },
        {
          "id": "behavior",
          "lines": [
            [
              {
                "annotation_ids": [
                  "7912c4024f603525"
                ],
                "status_id": 8,
                "text": "All inputs MUST adhere to their requirements;"
              }
            ],
            [
              {
                "annotation_ids": [
                  "7912c4024f603525"
                ],
                "status_id": 8,
                "text": "otherwise this operation MUST immediately yield an error."
              }
            ],
            "",
            "The Decrypt Structure operation is divided into several distinct steps:",
            "",
            "1. [Parse the Header](#parse-the-header)",
            "1. [Retrieve Decryption Materials](#retrieve-decryption-materials)",
            "1. [Verify Signatures](#verify-signatures)",
            "1. [Construct Decrypted Structured Data](#construct-decrypted-structured-data)",
            "",
            [
              {
                "annotation_ids": [
                  "351fb4456db5079c"
                ],
                "status_id": 8,
                "text": "This operation MUST perform all the above steps,"
              }
            ],
            [
              {
                "annotation_ids": [
                  "351fb4456db5079c"
                ],
                "status_id": 8,
                "text": "and it MUST perform them in the above order."
              }
            ],
            "",
            [
              {
                "annotation_ids": [
                  "4c7b1fb700dc810c"
                ],
                "status_id": 8,
                "text": "If any of these steps fails, this operation MUST halt and indicate a failure to the caller."
              }
            ]
          ],
          "requirements": [
            "7912c4024f603525",
            "7912c4024f603525",
            "351fb4456db5079c",
            "351fb4456db5079c",
            "4c7b1fb700dc810c"
          ],
          "title": "Behavior"
        },
        {
          "id": "parse-the-header",
          "lines": [
            [
              {
                "annotation_ids": [
                  "40e943aa2d522a69",
                  "7335e7594a41a631"
                ],
                "status_id": 1,
                "text": "Given the [input data](#auth-list),"
              }
            ],
            [
              {
                "annotation_ids": [
                  "40e943aa2d522a69",
                  "7335e7594a41a631"
                ],
                "status_id": 1,
                "text": "this operation MUST access the [Terminal Data](./structures.md#terminal-data)"
              }
            ],
            [
              {
                "annotation_ids": [
                  "40e943aa2d522a69",
                  "7335e7594a41a631"
                ],
                "status_id": 1,
                "text": "at \"aws_dbe_head\"."
              }
            ],
            "",
            [
              {
                "annotation_ids": [
                  "3c852d060c2d515b",
                  "3c8baaef69858ca0"
                ],
                "status_id": 1,
                "text": "The [Terminal Type Id](./structures.md#terminal-type-id) on this Terminal Data MUST be `0xFFFF`."
              }
            ],
            "We refer to the [Terminal Value](./structures.md#terminal-value)",
            "on this Terminal Data as the header bytes.",
            "",
            [
              {
                "annotation_ids": [
                  "7f2a51fbc2701cd3",
                  "c7102abd78959dac",
                  "23041b97980224e1"
                ],
                "status_id": 11,
                "text": "This operation MUST deserialize the header bytes"
              }
            ],
            [
              {
                "annotation_ids": [
                  "7f2a51fbc2701cd3",
                  "c7102abd78959dac",
                  "23041b97980224e1"
                ],
                "status_id": 11,
                "text": "according to the [header format](./header.md)."
              }
            ],
            "",
            [
              {
                "annotation_ids": [
                  "d4f1d2972676722f",
                  "a6fdb6700ee03930"
                ],
                "status_id": 7,
                "text": "The header field value MUST be [verified](header.md#commitment-verification)"
              }
            ],
            "",
            "The below calculations REQUIRE a [Crypto Schema](./structures.md#crypto-schema),",
            "which is determined based on the input [Authentication Schema](#auth-list) and the",
            "parsed [Encrypt Legend](./header.md#encrypt-legend) in the header,",
            "such that for each [Terminal Data](./structures.md#terminal-data)",
            "in the [input Structured Data](#auth-list):",
            "",
            "- The Crypto Action is [DO_NOTHING](./structures.md#DO_NOTHING) if",
            "  the Authentication Schema indicates [DO_NOT_SIGN](./structures.md#donotsign) for this Terminal Data.",
            "- The Crypto Action is [SIGN_ONLY](./structures.md#signonly) if",
            "  the Authentication Schema indicates [SIGN](./structures.md#sign) for this Terminal Data",
            "  and the Encrypt Legend byte corresponding to this Terminal Data is `0x73`.",
            "- The Crypto Action is [SIGN_AND_INCLUDE_IN_ENCRYPTION_CONTEXT](./structures.md#sign_and_include_in_encryption_context) if",
            "  the Authentication Schema indicates [SIGN](./structures.md#sign) for this Terminal Data",
            "  and the Encrypt Legend byte corresponding to this Terminal Data is `0x63`.",
            "- The Crypto Action is [ENCRYPT_AND_SIGN](./structures.md#encryptandsign) if",
            "  the Authentication Schema indicates [SIGN](./structures.md#sign) for this Terminal Data",
            "  and the Encrypt Legend byte corresponding to this Terminal Data is `0x65`."
          ],
          "requirements": [
            "7335e7594a41a631",
            "7335e7594a41a631",
            "7335e7594a41a631",
            "3c8baaef69858ca0",
            "23041b97980224e1",
            "23041b97980224e1",
            "a6fdb6700ee03930"
          ],
          "title": "Parse the Header"
        },
        {
          "id": "retrieve-decryption-materials",
          "lines": [
            [
              {
                "annotation_ids": [
                  "9b88a19818900b8e",
                  "2e80f3d6de97b843"
                ],
                "status_id": 7,
                "text": "This operation MUST [calculate the appropriate CMM and encryption context](#create-new-encryption-context-and-cmm)."
              }
            ],
            "",
            [
              {
                "annotation_ids": [
                  "a8786e0debbba3ad",
                  "8ad9be2cc15cdf56"
                ],
                "status_id": 7,
                "text": "This operation MUST obtain a set of decryption materials by calling"
              }
            ],
            [
              {
                "annotation_ids": [
                  "a8786e0debbba3ad",
                  "8ad9be2cc15cdf56"
                ],
                "status_id": 7,
                "text": "[Decrypt Materials](../../submodules/MaterialProviders/aws-encryption-sdk-specification/framework/cmm-interface.md#decrypt-materials)"
              }
            ],
            [
              {
                "annotation_ids": [
                  "a8786e0debbba3ad",
                  "8ad9be2cc15cdf56"
                ],
                "status_id": 7,
                "text": "on the [CMM](#cmm) calculated above."
              }
            ],
            "",
            [
              {
                "annotation_ids": [
                  "5bb8f92042f4bd52",
                  "14a57fe5581a0b0b"
                ],
                "status_id": 7,
                "text": "The call to the CMM's Decrypt Materials operation MUST be constructed as follows:"
              }
            ],
            "",
            "- Encryption Context: The [Encryption Context parsed from the header](./header.md#encryption-context).",
            "- Algorithm Suite ID: The algorithm suite [indicated by the Message Format Flavor](./header.md#format-flavor)",
            "  parsed in the header.",
            "- Commitment Policy: DBE_COMMITMENT_POLICY",
            "- Encrypted Data Keys: The [Encrypted Data Keys parsed from the header](./header.md#encrypted-data-keys).",
            "- Reproduced Encryption Context: This is the encryption context calculated above.",
            "",
            [
              {
                "annotation_ids": [
                  "8d5376d5269d27ea",
                  "13c30b0870cd7099"
                ],
                "status_id": 7,
                "text": "The algorithm suite used in all further aspects of this operation MUST be"
              }
            ],
            [
              {
                "annotation_ids": [
                  "8d5376d5269d27ea",
                  "13c30b0870cd7099"
                ],
                "status_id": 7,
                "text": "the algorithm suite in the"
              }
            ],
            [
              {
                "annotation_ids": [
                  "8d5376d5269d27ea",
                  "13c30b0870cd7099"
                ],
                "status_id": 7,
                "text": "[decryption materials](../../submodules/MaterialProviders/aws-encryption-sdk-specification/framework/structures.md#decryption-materials)"
              }
            ],
            [
              {
                "annotation_ids": [
                  "8d5376d5269d27ea",
                  "13c30b0870cd7099"
                ],
                "status_id": 7,
                "text": "returned from the Decrypt Materials call."
              }
            ],
            [
              {
                "annotation_ids": [
                  "f9aa0d4959f13e95",
                  "1553a653e8878e17"
                ],
                "status_id": 15,
                "text": "Note that the algorithm suite in the retrieved decryption materials MAY be different from the input algorithm suite."
              }
            ],
            [
              {
                "annotation_ids": [
                  "b10abf83ecc1a000",
                  "fef95bf0760bd164"
                ],
                "status_id": 7,
                "text": "If this algorithm suite is not a"
              }
            ],
            [
              {
                "annotation_ids": [
                  "b10abf83ecc1a000",
                  "fef95bf0760bd164"
                ],
                "status_id": 7,
                "text": "[supported suite for DBE](../../submodules/MaterialProviders/aws-encryption-sdk-specification/framework/algorithm-suites.md#supported-algorithm-suites-enum)"
              }
            ],
            [
              {
                "annotation_ids": [
                  "b10abf83ecc1a000",
                  "fef95bf0760bd164"
                ],
                "status_id": 7,
                "text": "this operation MUST yield an error."
              }
            ]
          ],
          "requirements": [
            "2e80f3d6de97b843",
            "8ad9be2cc15cdf56",
            "8ad9be2cc15cdf56",
            "8ad9be2cc15cdf56",
            "14a57fe5581a0b0b",
            "13c30b0870cd7099",
            "13c30b0870cd7099",
            "13c30b0870cd7099",
            "13c30b0870cd7099",
            "1553a653e8878e17",
            "fef95bf0760bd164",
            "fef95bf0760bd164",
            "fef95bf0760bd164"
          ],
          "title": "Retrieve Decryption Materials"
        },
        {
          "id": "create-new-encryption-context-and-cmm",
          "lines": [
            [
              {
                "annotation_ids": [
                  "9aa80d58a09ecc42",
                  "ecca1c1f86878940"
                ],
                "status_id": 7,
                "text": "If the version stored in the header is 1,"
              }
            ],
            [
              {
                "annotation_ids": [
                  "9aa80d58a09ecc42",
                  "ecca1c1f86878940"
                ],
                "status_id": 7,
                "text": "then the input cmm and encryption context MUST be used unchanged."
              }
            ],
            "",
            [
              {
                "annotation_ids": [
                  "ab2ac77b7acf4196",
                  "696dae7b84f9369d"
                ],
                "status_id": 7,
                "text": "Otherwise, this operation MUST add an [entry](../dynamodb-encryption-client/encrypt-item.md#base-context-value-version-2) to the encryption context for every"
              }
            ],
            [
              {
                "annotation_ids": [
                  "ab2ac77b7acf4196",
                  "696dae7b84f9369d"
                ],
                "status_id": 7,
                "text": "[SIGN_AND_INCLUDE_IN_ENCRYPTION_CONTEXT Crypto Action](./structures.md#sign_and_include_in_encryption_context)"
              }
            ],
            [
              {
                "annotation_ids": [
                  "ab2ac77b7acf4196",
                  "696dae7b84f9369d"
                ],
                "status_id": 7,
                "text": "[Terminal Data](./structures.md#terminal-data)"
              }
            ],
            [
              {
                "annotation_ids": [
                  "ab2ac77b7acf4196",
                  "696dae7b84f9369d"
                ],
                "status_id": 7,
                "text": "in the input record, plus the Legend."
              }
            ],
            "",
            [
              {
                "annotation_ids": [
                  "1a3389587985739c",
                  "3904a45954a10e9b"
                ],
                "status_id": 7,
                "text": "An error MUST be returned if any of the entries added to the encryption context in this step"
              }
            ],
            [
              {
                "annotation_ids": [
                  "1a3389587985739c",
                  "3904a45954a10e9b"
                ],
                "status_id": 7,
                "text": "have the same key as any entry already in the encryption context."
              }
            ],
            "",
            [
              {
                "annotation_ids": [
                  "e5fcf6075fb25702",
                  "603f45995d3d0873"
                ],
                "status_id": 7,
                "text": "Then, this operation MUST create a [Required Encryption Context CMM](https://github.com/awslabs/private-aws-encryption-sdk-specification-staging/blob/dafny-verified/framework/required-encryption-context-cmm.md)"
              }
            ],
            [
              {
                "annotation_ids": [
                  "e5fcf6075fb25702",
                  "603f45995d3d0873"
                ],
                "status_id": 7,
                "text": "with the following inputs:"
              }
            ],
            "",
            [
              {
                "annotation_ids": [
                  "e5fcf6075fb25702"
                ],
                "status_id": 13,
                "text": "- This input [CMM](./ddb-table-encryption-config.md#cmm) as the underlying CMM."
              }
            ],
            [
              {
                "annotation_ids": [
                  "e5fcf6075fb25702"
                ],
                "status_id": 13,
                "text": "- The name of every entry added above."
              }
            ]
          ],
          "requirements": [
            "ecca1c1f86878940",
            "ecca1c1f86878940",
            "696dae7b84f9369d",
            "696dae7b84f9369d",
            "696dae7b84f9369d",
            "696dae7b84f9369d",
            "3904a45954a10e9b",
            "3904a45954a10e9b",
            "603f45995d3d0873",
            "603f45995d3d0873"
          ],
          "title": "Create New Encryption Context and CMM"
        },
        {
          "id": "verify-signatures",
          "lines": [
            [
              {
                "annotation_ids": [
                  "e21e88c3ddffd5a9",
                  "284201609a2a87de"
                ],
                "status_id": 1,
                "text": "A footer field MUST exist with the name `aws_dbe_foot`"
              }
            ],
            "",
            [
              {
                "annotation_ids": [
                  "ae4bc8d356087a36",
                  "9a2bf97a1a4d496d"
                ],
                "status_id": 1,
                "text": "The footer field TypeID MUST be 0xFFFF"
              }
            ],
            "",
            [
              {
                "annotation_ids": [
                  "1865ae92b71cdfe7",
                  "7ee0cb7967a87e08"
                ],
                "status_id": 7,
                "text": "The footer field value MUST be [verified](footer.md#footer-verification)."
              }
            ],
            "",
            [
              {
                "annotation_ids": [
                  "d6605fa507e9003e",
                  "511c8fbddf3a1aaa"
                ],
                "status_id": 7,
                "text": "Decryption MUST fail immediately if verification fails."
              }
            ],
            "",
            [
              {
                "annotation_ids": [
                  "15ccf4db20f651bb",
                  "f5899109350c5599"
                ],
                "status_id": 7,
                "text": "This operation MUST deserialize the bytes in [Terminal Value](./structures.md#terminal-value)"
              }
            ],
            [
              {
                "annotation_ids": [
                  "15ccf4db20f651bb",
                  "f5899109350c5599"
                ],
                "status_id": 7,
                "text": "according to the [footer format](./footer.md)."
              }
            ],
            "",
            [
              {
                "annotation_ids": [
                  "8eee9a0f31e17cc6",
                  "b4f4d449edb76a69"
                ],
                "status_id": 1,
                "text": "The number of [HMACs in the footer](./footer.md#hmacs)"
              }
            ],
            [
              {
                "annotation_ids": [
                  "8eee9a0f31e17cc6",
                  "b4f4d449edb76a69"
                ],
                "status_id": 1,
                "text": "MUST be the number of [Encrypted Data Keys in the header](./header.md#encrypted-data-keys)."
              }
            ]
          ],
          "requirements": [
            "284201609a2a87de",
            "9a2bf97a1a4d496d",
            "7ee0cb7967a87e08",
            "511c8fbddf3a1aaa",
            "f5899109350c5599",
            "f5899109350c5599",
            "b4f4d449edb76a69",
            "b4f4d449edb76a69"
          ],
          "title": "Verify Signatures"
        },
        {
          "id": "calculate-cipherkey-and-nonce",
          "lines": [
            "The Cipherkey and Nonce must be calculated as for [encryption](encrypt-structure.md#calculate-cipherkey-and-nonce)."
          ],
          "title": "Calculate Cipherkey and Nonce"
        },
        {
          "id": "construct-decrypted-structured-data",
          "lines": [
            "In the output [Crypto List](./structures.md#crypto-list):",
            "",
            [
              {
                "annotation_ids": [
                  "29c2331e29479e81",
                  "df9cac0b62e13cdb"
                ],
                "status_id": 1,
                "text": "- An entry MUST NOT exist with the key \"aws_dbe_head\" or \"aws_dbe_foot\"."
              }
            ],
            [
              {
                "annotation_ids": [
                  "f082e0d3ffea5c2e",
                  "164861a8b1dbd2ea"
                ],
                "status_id": 1,
                "text": "- For every entry in the [input Auth List](#auth-list), other than the header and footer,"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "  "
              },
              {
                "annotation_ids": [
                  "f082e0d3ffea5c2e",
                  "164861a8b1dbd2ea"
                ],
                "status_id": 1,
                "text": "an entry MUST exist with the same key in the output Crypto List."
              }
            ],
            [
              {
                "annotation_ids": [
                  "24c3a60e86cfc651",
                  "b097bed68d527a98"
                ],
                "status_id": 1,
                "text": "- For every entry in the output Crypto List"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "  "
              },
              {
                "annotation_ids": [
                  "24c3a60e86cfc651",
                  "b097bed68d527a98"
                ],
                "status_id": 1,
                "text": "an entry MUST exist with the same key in the [input Auth List](#auth-list)."
              }
            ],
            "  Put plainly, the output does not add or drop any entries during decryption, other than the header and footer.",
            "",
            "For each entry in the output Crypto List:",
            "",
            [
              {
                "annotation_ids": [
                  "6f7a6eddfadf3137",
                  "6ff9675eeaa52649"
                ],
                "status_id": 1,
                "text": "If the action is [ENCRYPT_AND_SIGN](./structures.md#encryptandsign)"
              }
            ],
            [
              {
                "annotation_ids": [
                  "6f7a6eddfadf3137",
                  "6ff9675eeaa52649"
                ],
                "status_id": 1,
                "text": "this Terminal Data MUST have [Terminal Type ID](./structures.md#terminal-type-id)"
              }
            ],
            [
              {
                "annotation_ids": [
                  "6f7a6eddfadf3137",
                  "6ff9675eeaa52649"
                ],
                "status_id": 1,
                "text": "equal to the first two bytes of the input Terminal Data's value,"
              }
            ],
            [
              {
                "annotation_ids": [
                  "6f7a6eddfadf3137",
                  "6ff9675eeaa52649"
                ],
                "status_id": 1,
                "text": "and a value equal to the [decryption](#terminal-data-decryption) of the input Terminal Data's value."
              }
            ],
            "",
            [
              {
                "annotation_ids": [
                  "61ac560e2df058fa",
                  "9c4cd24561d01dd3"
                ],
                "status_id": 1,
                "text": "Otherwise, this Terminal Data MUST have [Terminal Type ID](./structures.md#terminal-type-id) and"
              }
            ],
            [
              {
                "annotation_ids": [
                  "61ac560e2df058fa",
                  "9c4cd24561d01dd3"
                ],
                "status_id": 1,
                "text": "[Terminal Value](./structures.md#terminal-value) equal to the input Terminal Data."
              }
            ],
            "",
            [
              {
                "annotation_ids": [
                  "764c1e39f2212ba9",
                  "00429fcd1f6adb31",
                  "1adee74832edfa4b"
                ],
                "status_id": 14,
                "text": "The output MUST also include a [Parsed Header](#parsed-header) that contains"
              }
            ],
            [
              {
                "annotation_ids": [
                  "764c1e39f2212ba9",
                  "00429fcd1f6adb31",
                  "1adee74832edfa4b"
                ],
                "status_id": 14,
                "text": "data that was serialized into the header included in the output Structured Data."
              }
            ]
          ],
          "requirements": [
            "df9cac0b62e13cdb",
            "164861a8b1dbd2ea",
            "164861a8b1dbd2ea",
            "b097bed68d527a98",
            "b097bed68d527a98",
            "6ff9675eeaa52649",
            "6ff9675eeaa52649",
            "6ff9675eeaa52649",
            "6ff9675eeaa52649",
            "9c4cd24561d01dd3",
            "9c4cd24561d01dd3",
            "1adee74832edfa4b",
            "1adee74832edfa4b"
          ],
          "title": "Construct Decrypted Structured Data"
        },
        {
          "id": "terminal-data-decryption",
          "lines": [
            "Decryption of [Terminal Data](./structures.md#terminal-data) takes a",
            "encrypted Terminal Data as input, and returns a Terminal Data.",
            "",
            [
              {
                "annotation_ids": [
                  "d5cba03b24e72ac6",
                  "c5ac94c0397223c0"
                ],
                "status_id": 7,
                "text": "The input [Terminal Value](./structures.md#terminal-value) MUST be deserialized as follows:"
              }
            ],
            "",
            "| Field                    | Length   |",
            "| ------------------------ | -------- |",
            "| Terminal Type Id         | 2        |",
            "| Encrypted Terminal Value | Variable |",
            "",
            [
              {
                "annotation_ids": [
                  "8fc79d4e79aa61ee",
                  "79bb3e19a233b769"
                ],
                "status_id": 1,
                "text": "The output Terminal Data MUST have a [Terminal Type Id](./structures.md#terminal-type-id)"
              }
            ],
            [
              {
                "annotation_ids": [
                  "8fc79d4e79aa61ee",
                  "79bb3e19a233b769"
                ],
                "status_id": 1,
                "text": "equal to the deserialized Terminal Type Id."
              }
            ],
            "",
            [
              {
                "annotation_ids": [
                  "065fb7c8c5d55e0d",
                  "af55829a37e97735"
                ],
                "status_id": 7,
                "text": "The output Terminal Data MUST have a [Terminal Value](./structures.md#terminal-type-id)"
              }
            ],
            [
              {
                "annotation_ids": [
                  "065fb7c8c5d55e0d",
                  "af55829a37e97735"
                ],
                "status_id": 7,
                "text": "equal to the following decryption:"
              }
            ],
            "",
            "- The decryption algorithm used is the",
            "  [encryption algorithm](../../submodules/MaterialProviders/aws-encryption-sdk-specification/framework/algorithm-suites.md#algorithm-suites-encryption-settings)",
            "  indicated in the algorithm suite.",
            "- The AAD is the [canonical path](./header.md#canonical-path) for this Terminal Data.",
            "- The Cipherkey and Nonce are as calculate [above](#calculate-cipherkey-and-nonce).",
            "- The ciphertext is the deserialized Encrypted Terminal Value."
          ],
          "requirements": [
            "c5ac94c0397223c0",
            "79bb3e19a233b769",
            "79bb3e19a233b769",
            "af55829a37e97735",
            "af55829a37e97735"
          ],
          "title": "Terminal Data Decryption"
        }
      ],
      "title": "Decrypt Path Structure"
    },
    "specification/structured-encryption/decrypt-structure.md": {
      "format": "markdown",
      "sections": [
        {
          "id": "decrypt-structure",
          "lines": [],
          "title": "Decrypt Structure"
        },
        {
          "id": "version",
          "lines": [
            "1.1.0"
          ],
          "title": "Version"
        },
        {
          "id": "changelog",
          "lines": [
            "- 1.1.0",
            "",
            "  - Update for simplified structured encryption",
            "",
            "- 1.0.0",
            "  - Initial record"
          ],
          "title": "Changelog"
        },
        {
          "id": "definitions",
          "lines": [],
          "title": "Definitions"
        },
        {
          "id": "conventions-used-in-this-document",
          "lines": [
            "The key words \"MUST\", \"MUST NOT\", \"REQUIRED\", \"SHALL\", \"SHALL NOT\", \"SHOULD\", \"SHOULD NOT\", \"RECOMMENDED\", \"MAY\", and \"OPTIONAL\"",
            "in this document are to be interpreted as described in [RFC 2119](https://tools.ietf.org/html/rfc2119)."
          ],
          "title": "Conventions used in this document"
        },
        {
          "id": "overview",
          "lines": [
            "This document describes the behavior by which a [Structured Data](./structures.md#structured-data)",
            "which has been [encrypted](./encrypt-structure.md) is decrypted.",
            "We define decryption over this [Structured Data](./structures.md#structured-data) to mean that",
            "we obtain back the original Structured Data,",
            "and ensure integrity and authenticity is ensured over a set of [Terminal Data](./structures.md#terminal-data)."
          ],
          "title": "Overview"
        },
        {
          "id": "input",
          "lines": [
            [
              {
                "annotation_ids": [
                  "ff0a7438daf8a988",
                  "0f88834f11ae590a"
                ],
                "status_id": 1,
                "text": "The following inputs to this behavior are REQUIRED:"
              }
            ],
            "",
            "- [Table Name](decrypt-path-structure.md#table-name)",
            "- [Authenticate Schema](decrypt-path-structure.md#authenticate-schema)",
            "- [Cryptographic Materials Manager (CMM)](decrypt-path-structure.md#cmm)",
            "- [Encrypted Structured Data](decrypt-path-structure.md#encrypted-structured-data)",
            "",
            [
              {
                "annotation_ids": [
                  "aaf755733e2f34e3",
                  "414c423fc92159e7"
                ],
                "status_id": 1,
                "text": "The following inputs to this behavior MUST be OPTIONAL:"
              }
            ],
            "",
            "- [Encryption Context](decrypt-path-structure.md#encryption-context)"
          ],
          "requirements": [
            "0f88834f11ae590a",
            "414c423fc92159e7"
          ],
          "title": "Input"
        },
        {
          "id": "output",
          "lines": [
            [
              {
                "annotation_ids": [
                  "513d107d9f46ef20",
                  "a92f1edf9330ff83"
                ],
                "status_id": 1,
                "text": "This operation MUST output the following:"
              }
            ],
            "",
            [
              {
                "annotation_ids": [
                  "513d107d9f46ef20"
                ],
                "status_id": 2,
                "text": "- [Structured Data](decrypt-path-structure.md#structured-data)"
              }
            ],
            [
              {
                "annotation_ids": [
                  "513d107d9f46ef20"
                ],
                "status_id": 2,
                "text": "- [Crypto Schema](./structures.md#crypto-schema): The Crypto Schema for each signed Terminal,"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "  "
              },
              {
                "annotation_ids": [
                  "513d107d9f46ef20"
                ],
                "status_id": 2,
                "text": "calculated using the Crypto Legend in the header, the signature scope used for decryption, and the data in the input structure."
              }
            ],
            [
              {
                "annotation_ids": [
                  "513d107d9f46ef20"
                ],
                "status_id": 2,
                "text": "- [Parsed Header](decrypt-path-structure.md#parsed-header)"
              }
            ]
          ],
          "requirements": [
            "a92f1edf9330ff83"
          ],
          "title": "Output"
        },
        {
          "id": "behavior",
          "lines": [
            [
              {
                "annotation_ids": [
                  "4619e6e858fd5515",
                  "cbeeff4348e40403"
                ],
                "status_id": 1,
                "text": "The input [Structured Data](decrypt-path-structure.md#structured-data) and [Authenticate Schema](decrypt-path-structure.md#authenticate-schema)"
              }
            ],
            [
              {
                "annotation_ids": [
                  "4619e6e858fd5515",
                  "cbeeff4348e40403"
                ],
                "status_id": 1,
                "text": "MUST refer to the same set of locations."
              }
            ],
            "",
            [
              {
                "annotation_ids": [
                  "32bab0d2c2fb8142",
                  "0b9c730e686f4289"
                ],
                "status_id": 1,
                "text": "The input [Structured Data](decrypt-path-structure.md#structured-data) and [Authenticate Schema](decrypt-path-structure.md#authenticate-schema)"
              }
            ],
            [
              {
                "annotation_ids": [
                  "32bab0d2c2fb8142",
                  "0b9c730e686f4289"
                ],
                "status_id": 1,
                "text": "MUST be combined into a single [Auth List](decrypt-path-structure.md#auth-list)."
              }
            ],
            "",
            [
              {
                "annotation_ids": [
                  "11586b01fbd1ea47",
                  "830b6e9f2bb45463"
                ],
                "status_id": 1,
                "text": "Decrypt Structure MUST then behave as [Decrypt Path Structure](decrypt-path-structure.md)"
              }
            ],
            "",
            [
              {
                "annotation_ids": [
                  "7b7567339ea6bfed",
                  "26d88229f91f3bd9"
                ],
                "status_id": 1,
                "text": "The output [Crypto List](decrypt-path-structure.md#crypto-list) produced by [Decrypt Path Structure](decrypt-path-structure.md)"
              }
            ],
            [
              {
                "annotation_ids": [
                  "7b7567339ea6bfed",
                  "26d88229f91f3bd9"
                ],
                "status_id": 1,
                "text": "MUST be split into [Structured Data](decrypt-path-structure.md#structured-data) and [Crypto Schema](decrypt-path-structure.md#crypto-schema)"
              }
            ],
            [
              {
                "annotation_ids": [
                  "7b7567339ea6bfed",
                  "26d88229f91f3bd9"
                ],
                "status_id": 1,
                "text": "maps."
              }
            ]
          ],
          "requirements": [
            "cbeeff4348e40403",
            "cbeeff4348e40403",
            "0b9c730e686f4289",
            "0b9c730e686f4289",
            "830b6e9f2bb45463",
            "26d88229f91f3bd9",
            "26d88229f91f3bd9",
            "26d88229f91f3bd9"
          ],
          "title": "Behavior"
        }
      ],
      "title": "Decrypt Structure"
    },
    "specification/structured-encryption/encrypt-path-structure.md": {
      "format": "markdown",
      "sections": [
        {
          "id": "encrypt-path-structure",
          "lines": [],
          "title": "Encrypt Path Structure"
        },
        {
          "id": "version",
          "lines": [
            "1.0.0"
          ],
          "title": "Version"
        },
        {
          "id": "changelog",
          "lines": [
            "- 1.0.0",
            "",
            "  - Initial record"
          ],
          "title": "Changelog"
        },
        {
          "id": "definitions",
          "lines": [],
          "title": "Definitions"
        },
        {
          "id": "conventions-used-in-this-document",
          "lines": [
            "The key words \"MUST\", \"MUST NOT\", \"REQUIRED\", \"SHALL\", \"SHALL NOT\", \"SHOULD\", \"SHOULD NOT\", \"RECOMMENDED\", \"MAY\", and \"OPTIONAL\"",
            "in this document are to be interpreted as described in [RFC 2119](https://tools.ietf.org/html/rfc2119)."
          ],
          "title": "Conventions used in this document"
        },
        {
          "id": "overview",
          "lines": [
            "This document describes the behavior by which a [Structured Data](./structures.md#structured-data) is encrypted.",
            "We define encryption over this [Structured Data](./structures.md#structured-data) to mean that",
            "authenticity is ensured over a non-empty set of [Terminal Data](./structures.md#terminal-data),",
            "and confidentiality is ensured over a (possibly empty) subset of that Terminal Data."
          ],
          "title": "Overview"
        },
        {
          "id": "input",
          "lines": [
            [
              {
                "annotation_ids": [
                  "481c5f47de8406ab",
                  "fb402ac46ba36ac0"
                ],
                "status_id": 1,
                "text": "The following inputs to this behavior are REQUIRED:"
              }
            ],
            "",
            [
              {
                "annotation_ids": [
                  "481c5f47de8406ab"
                ],
                "status_id": 2,
                "text": "- [Table Name](#table-name)"
              }
            ],
            [
              {
                "annotation_ids": [
                  "481c5f47de8406ab"
                ],
                "status_id": 2,
                "text": "- [Crypto List](#crypto-list)"
              }
            ],
            [
              {
                "annotation_ids": [
                  "481c5f47de8406ab"
                ],
                "status_id": 2,
                "text": "- [Cryptographic Materials Manager (CMM)](#cmm)"
              }
            ],
            "",
            [
              {
                "annotation_ids": [
                  "eda8762bbe879b3f",
                  "a6e5fa672e349707"
                ],
                "status_id": 1,
                "text": "The following inputs to this behavior MUST be OPTIONAL:"
              }
            ],
            "",
            [
              {
                "annotation_ids": [
                  "eda8762bbe879b3f"
                ],
                "status_id": 2,
                "text": "- [Algorithm Suite](#algorithm-suite)"
              }
            ],
            [
              {
                "annotation_ids": [
                  "eda8762bbe879b3f"
                ],
                "status_id": 2,
                "text": "- [Encryption Context](#encryption-context)"
              }
            ]
          ],
          "requirements": [
            "fb402ac46ba36ac0",
            "a6e5fa672e349707"
          ],
          "title": "Input"
        },
        {
          "id": "table-name",
          "lines": [
            "The logical name for the structure.",
            "This can be the same as the physical name.",
            "For example the name of the table to hold the encrypted record."
          ],
          "title": "Table Name"
        },
        {
          "id": "crypto-list",
          "lines": [
            "The [Crypto List](./structures.md#crypto-list) to be encrypted.",
            "",
            [
              {
                "annotation_ids": [
                  "06df1caf678e27c2",
                  "8a993c482a96a38f"
                ],
                "status_id": 1,
                "text": "The [paths](./structures.md#path) in the input [Crypto List](./structures.md#crypto-list) MUST be unique."
              }
            ],
            "",
            [
              {
                "annotation_ids": [
                  "1ecbf9d43cb703f0",
                  "c1d44f6558d318e8"
                ],
                "status_id": 1,
                "text": "This Crypto List MUST NOT already contain data located at the [header index](./header.md#header-index)"
              }
            ],
            [
              {
                "annotation_ids": [
                  "1ecbf9d43cb703f0",
                  "c1d44f6558d318e8"
                ],
                "status_id": 1,
                "text": "or the [footer index](./footer.md#footer-index)."
              }
            ],
            "",
            "The Crypto List describes how each [Terminal Data](./structures.md#terminal-data) should be treated during encryption.",
            "",
            [
              {
                "annotation_ids": [
                  "cce8308338f58b69",
                  "9418a343804e2b98"
                ],
                "status_id": 1,
                "text": "The Crypto List MUST include at least one [Crypto Action](./structures.md#crypto-action)"
              }
            ],
            [
              {
                "annotation_ids": [
                  "cce8308338f58b69",
                  "9418a343804e2b98"
                ],
                "status_id": 1,
                "text": "that is not [DO_NOTHING](./structures.md#do_nothing)."
              }
            ]
          ],
          "requirements": [
            "8a993c482a96a38f",
            "c1d44f6558d318e8",
            "c1d44f6558d318e8",
            "9418a343804e2b98",
            "9418a343804e2b98"
          ],
          "title": "Crypto List"
        },
        {
          "id": "cmm",
          "lines": [
            "A CMM that implements the [CMM interface](../../submodules/MaterialProviders/aws-encryption-sdk-specification/framework/cmm-interface.md)."
          ],
          "title": "CMM"
        },
        {
          "id": "algorithm-suite",
          "lines": [
            [
              {
                "annotation_ids": [
                  "3a8b2972de0008f5"
                ],
                "status_id": 9,
                "text": "The [algorithm suite](../../submodules/MaterialProviders/aws-encryption-sdk-specification/framework/algorithm-suites.md) that SHOULD be used for encryption."
              }
            ],
            "",
            [
              {
                "annotation_ids": [
                  "9f6e3b7f2911bc4c",
                  "2f01ea4b4eabb71f"
                ],
                "status_id": 1,
                "text": "This algorithm suite MUST be a"
              }
            ],
            [
              {
                "annotation_ids": [
                  "9f6e3b7f2911bc4c",
                  "2f01ea4b4eabb71f"
                ],
                "status_id": 1,
                "text": "[supported suite for Database Encryption (DBE)](../../submodules/MaterialProviders/aws-encryption-sdk-specification/framework/algorithm-suites.md#supported-algorithm-suites-enum);"
              }
            ],
            [
              {
                "annotation_ids": [
                  "9f6e3b7f2911bc4c",
                  "2f01ea4b4eabb71f"
                ],
                "status_id": 1,
                "text": "otherwise, this operation MUST yield an error."
              }
            ]
          ],
          "requirements": [
            "3a8b2972de0008f5",
            "2f01ea4b4eabb71f",
            "2f01ea4b4eabb71f",
            "2f01ea4b4eabb71f"
          ],
          "title": "Algorithm Suite"
        },
        {
          "id": "encryption-context",
          "lines": [
            "See [encryption context](./structures.md#encryption-context).",
            "",
            "The prefix `aws-crypto-` is reserved for internal use by the AWS Encryption SDK; see the",
            "[the Default CMM spec](../../submodules/MaterialProviders/aws-encryption-sdk-specification/framework/default-cmm.md)",
            "for one such use.",
            [
              {
                "annotation_ids": [
                  "e4ee3a0bc6b9797c",
                  "9ad561940f120335"
                ],
                "status_id": 1,
                "text": "The operation MUST fail if an encryption context is provided which contains a key with the prefix `aws-crypto-`."
              }
            ]
          ],
          "requirements": [
            "9ad561940f120335"
          ],
          "title": "Encryption Context"
        },
        {
          "id": "output",
          "lines": [
            [
              {
                "annotation_ids": [
                  "53a237adc88c3e2d",
                  "a1e62849d718f565"
                ],
                "status_id": 1,
                "text": "This operation MUST output the following:"
              }
            ],
            "",
            [
              {
                "annotation_ids": [
                  "53a237adc88c3e2d"
                ],
                "status_id": 2,
                "text": "- [Encrypted Crypto List](#encrypted-crypto-list)"
              }
            ],
            [
              {
                "annotation_ids": [
                  "53a237adc88c3e2d"
                ],
                "status_id": 2,
                "text": "- [Parsed Header](./decrypt-structure.md#parsed-header)"
              }
            ]
          ],
          "requirements": [
            "a1e62849d718f565"
          ],
          "title": "Output"
        },
        {
          "id": "encrypted-crypto-list",
          "lines": [
            "An encrypted form of the [input Crypto List](#crypto-list),",
            "encrypted according to the [behavior specified below](#behavior)."
          ],
          "title": "Encrypted Crypto List"
        },
        {
          "id": "behavior",
          "lines": [
            [
              {
                "annotation_ids": [
                  "38a866630f43ea35"
                ],
                "status_id": 8,
                "text": "All inputs MUST adhere to their requirements;"
              }
            ],
            [
              {
                "annotation_ids": [
                  "38a866630f43ea35"
                ],
                "status_id": 8,
                "text": "otherwise this operation MUST immediately yield an error."
              }
            ],
            "",
            "Given valid inputs,",
            "the Encrypt Structure operation is divided into several distinct steps:",
            "",
            "1. [Retrieve Encryption Materials](#retrieve-encryption-materials)",
            "1. [Calculate Intermediate Encrypted Structured Data](#calculate-intermediate-encrypted-structured-data)",
            "1. [Construct Encrypted Structured Data](#construct-encrypted-structured-data)",
            "",
            [
              {
                "annotation_ids": [
                  "37b4b1cba2a5e648"
                ],
                "status_id": 8,
                "text": "This operation MUST perform all the above steps,"
              }
            ],
            [
              {
                "annotation_ids": [
                  "37b4b1cba2a5e648"
                ],
                "status_id": 8,
                "text": "and it MUST perform them in the above order."
              }
            ],
            "",
            [
              {
                "annotation_ids": [
                  "501325b103cbaa78"
                ],
                "status_id": 8,
                "text": "If any of these steps fails, this operation MUST halt and indicate a failure to the caller."
              }
            ]
          ],
          "requirements": [
            "38a866630f43ea35",
            "38a866630f43ea35",
            "37b4b1cba2a5e648",
            "37b4b1cba2a5e648",
            "501325b103cbaa78"
          ],
          "title": "Behavior"
        },
        {
          "id": "retrieve-encryption-materials",
          "lines": [
            [
              {
                "annotation_ids": [
                  "4055e27a6e47b5fb",
                  "2e317ff7790d4e00"
                ],
                "status_id": 7,
                "text": "This operation MUST [calculate the appropriate CMM and encryption context](#create-new-encryption-context-and-cmm)."
              }
            ],
            "",
            [
              {
                "annotation_ids": [
                  "f00a6ce82d8e5073",
                  "1c1d82d94631b5e3"
                ],
                "status_id": 1,
                "text": "This operation MUST obtain a set of encryption materials by calling"
              }
            ],
            [
              {
                "annotation_ids": [
                  "f00a6ce82d8e5073",
                  "1c1d82d94631b5e3"
                ],
                "status_id": 1,
                "text": "[Get Encryption Materials](../../submodules/MaterialProviders/aws-encryption-sdk-specification/framework/cmm-interface.md#get-encryption-materials)"
              }
            ],
            [
              {
                "annotation_ids": [
                  "f00a6ce82d8e5073",
                  "1c1d82d94631b5e3"
                ],
                "status_id": 1,
                "text": "on the [CMM](#cmm) calculated above."
              }
            ],
            "",
            [
              {
                "annotation_ids": [
                  "73867d426056389d",
                  "7e87bed4771f5e60"
                ],
                "status_id": 1,
                "text": "This operation MUST call Get Encryption Materials on the CMM as follows."
              }
            ],
            "",
            [
              {
                "annotation_ids": [
                  "82545f1ce27fde02",
                  "d2026b119afbd91e"
                ],
                "status_id": 1,
                "text": "- Encryption Context: This MUST be the encryption context calculated above."
              }
            ],
            [
              {
                "annotation_ids": [
                  "8a598dc9229e40c7",
                  "1dbc112ac9403621"
                ],
                "status_id": 1,
                "text": "- Commitment Policy: This MUST be"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "  "
              },
              {
                "annotation_ids": [
                  "8a598dc9229e40c7",
                  "1dbc112ac9403621"
                ],
                "status_id": 1,
                "text": "[REQUIRE_ENCRYPT_REQUIRE_DECRYPT](../../submodules/MaterialProviders/aws-encryption-sdk-specification/framework/commitment-policy.md#esdkrequire_encrypt_require_decrypt)."
              }
            ],
            [
              {
                "annotation_ids": [
                  "104e8c84d9f22b47",
                  "dd7683f3a3981931"
                ],
                "status_id": 1,
                "text": "- Algorithm Suite: If provided, this is the [input algorithm suite](#algorithm-suite);"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "  "
              },
              {
                "annotation_ids": [
                  "104e8c84d9f22b47",
                  "dd7683f3a3981931"
                ],
                "status_id": 1,
                "text": "otherwise, this field MUST be the algorithm suite corresponding to the enum"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "  "
              },
              {
                "annotation_ids": [
                  "104e8c84d9f22b47",
                  "dd7683f3a3981931"
                ],
                "status_id": 1,
                "text": "[DBE.ALG_AES_256_GCM_HKDF_SHA512_COMMIT_KEY_ECDSA_P384_SYMSIG_HMAC_SHA384](../../submodules/MaterialProviders/aws-encryption-sdk-specification/framework/algorithm-suites.md#supported-algorithm-suites-enum)."
              }
            ],
            [
              {
                "annotation_ids": [
                  "97d32e53784325dd",
                  "2dbe9054d2de3779"
                ],
                "status_id": 1,
                "text": "- Max Plaintext Length: This field MUST be the result of the calculation `encryptedTerminalDataNum * 2 + totalEncryptedTerminalValuesSize`"
              }
            ],
            "  - `encryptedTerminalDataNum` is the number of [Terminal Data](./structures.md#terminal-data)",
            "    in the [input data](#crypto-list) being encrypted,",
            "    as defined by the [input Crypto Schema](#crypto-list).",
            "  - `totalEncryptedTerminalValuesSize` is the sum of the length of all [Terminal Values](./structures.md#terminal-value)",
            "    in the [input data](#crypto-list) being encrypted,",
            "    as defined by the [input Crypto Schema](#crypto-list).",
            "",
            [
              {
                "annotation_ids": [
                  "57f769cd524fc39e"
                ],
                "status_id": 8,
                "text": "The algorithm suite used in all aspects of this operation MUST be"
              }
            ],
            [
              {
                "annotation_ids": [
                  "57f769cd524fc39e"
                ],
                "status_id": 8,
                "text": "the algorithm suite in the"
              }
            ],
            [
              {
                "annotation_ids": [
                  "57f769cd524fc39e"
                ],
                "status_id": 8,
                "text": "[encryption materials](../../submodules/MaterialProviders/aws-encryption-sdk-specification/framework/structures.md#encryption-materials)"
              }
            ],
            [
              {
                "annotation_ids": [
                  "57f769cd524fc39e"
                ],
                "status_id": 8,
                "text": "returned from the Get Encryption Materials call."
              }
            ],
            "",
            [
              {
                "annotation_ids": [
                  "dff9abadb73ac2ae"
                ],
                "status_id": 10,
                "text": "Note that the algorithm suite in the retrieved encryption materials MAY be different from the input algorithm suite."
              }
            ],
            [
              {
                "annotation_ids": [
                  "ec579959d35b36fe",
                  "dda2562eab3c513c"
                ],
                "status_id": 7,
                "text": "If this algorithm suite is not a"
              }
            ],
            [
              {
                "annotation_ids": [
                  "ec579959d35b36fe",
                  "dda2562eab3c513c"
                ],
                "status_id": 7,
                "text": "[supported suite for Database Encryption (DBE)](../../submodules/MaterialProviders/aws-encryption-sdk-specification/framework/algorithm-suites.md#supported-algorithm-suites-enum),"
              }
            ],
            [
              {
                "annotation_ids": [
                  "ec579959d35b36fe",
                  "dda2562eab3c513c"
                ],
                "status_id": 7,
                "text": "this operation MUST yield an error."
              }
            ]
          ],
          "requirements": [
            "2e317ff7790d4e00",
            "1c1d82d94631b5e3",
            "1c1d82d94631b5e3",
            "1c1d82d94631b5e3",
            "7e87bed4771f5e60",
            "d2026b119afbd91e",
            "1dbc112ac9403621",
            "1dbc112ac9403621",
            "dd7683f3a3981931",
            "dd7683f3a3981931",
            "dd7683f3a3981931",
            "2dbe9054d2de3779",
            "57f769cd524fc39e",
            "57f769cd524fc39e",
            "57f769cd524fc39e",
            "57f769cd524fc39e",
            "dff9abadb73ac2ae",
            "dda2562eab3c513c",
            "dda2562eab3c513c",
            "dda2562eab3c513c"
          ],
          "title": "Retrieve Encryption Materials"
        },
        {
          "id": "create-new-encryption-context-and-cmm",
          "lines": [
            [
              {
                "annotation_ids": [
                  "5e4bcb12733b0a41",
                  "564cba9991c18a09",
                  "da1fec09f8e760aa"
                ],
                "status_id": 4,
                "text": "If no [Crypto Action](./structures.md#crypto-action) is configured to be"
              }
            ],
            [
              {
                "annotation_ids": [
                  "5e4bcb12733b0a41",
                  "564cba9991c18a09",
                  "da1fec09f8e760aa"
                ],
                "status_id": 4,
                "text": "[SIGN_AND_INCLUDE_IN_ENCRYPTION_CONTEXT Crypto Action](./structures.md#sign_and_include_in_encryption_context)"
              }
            ],
            [
              {
                "annotation_ids": [
                  "5e4bcb12733b0a41",
                  "564cba9991c18a09",
                  "da1fec09f8e760aa"
                ],
                "status_id": 4,
                "text": "then the input cmm and encryption context MUST be used unchanged."
              }
            ],
            "",
            [
              {
                "annotation_ids": [
                  "b0d6253ce129c4c7",
                  "f294d4896e6ce3b3",
                  "8d816b6725a8fdeb"
                ],
                "status_id": 4,
                "text": "Otherwise, this operation MUST add an [entry](../dynamodb-encryption-client/encrypt-item.md#base-context-value-version-2) to the encryption context for every"
              }
            ],
            [
              {
                "annotation_ids": [
                  "b0d6253ce129c4c7",
                  "f294d4896e6ce3b3",
                  "8d816b6725a8fdeb"
                ],
                "status_id": 4,
                "text": "[SIGN_AND_INCLUDE_IN_ENCRYPTION_CONTEXT Crypto Action](./structures.md#sign_and_include_in_encryption_context)"
              }
            ],
            [
              {
                "annotation_ids": [
                  "b0d6253ce129c4c7",
                  "f294d4896e6ce3b3",
                  "8d816b6725a8fdeb"
                ],
                "status_id": 4,
                "text": "[Terminal Data](./structures.md#terminal-data)"
              }
            ],
            [
              {
                "annotation_ids": [
                  "b0d6253ce129c4c7",
                  "f294d4896e6ce3b3",
                  "8d816b6725a8fdeb"
                ],
                "status_id": 4,
                "text": "in the input record, plus the Legend."
              }
            ],
            "",
            [
              {
                "annotation_ids": [
                  "a620a421d4ea8141",
                  "c7304a2956bc997d"
                ],
                "status_id": 7,
                "text": "An error MUST be returned if any of the entries added to the encryption context in this step"
              }
            ],
            [
              {
                "annotation_ids": [
                  "a620a421d4ea8141",
                  "c7304a2956bc997d"
                ],
                "status_id": 7,
                "text": "have the same key as any entry already in the encryption context."
              }
            ],
            "",
            [
              {
                "annotation_ids": [
                  "66ecd33b01565ac8",
                  "58a0b44220618d53",
                  "607fcf6813455e10"
                ],
                "status_id": 4,
                "text": "The Legend MUST be named \"aws-crypto-legend\" and be a string with one character per attribute added above,"
              }
            ],
            [
              {
                "annotation_ids": [
                  "66ecd33b01565ac8",
                  "58a0b44220618d53",
                  "607fcf6813455e10"
                ],
                "status_id": 4,
                "text": "with a one-to-one correspondence with the attributes sorted by their UTF8 encoding,"
              }
            ],
            [
              {
                "annotation_ids": [
                  "66ecd33b01565ac8",
                  "58a0b44220618d53",
                  "607fcf6813455e10"
                ],
                "status_id": 4,
                "text": "each character designating the original type of the attribute,"
              }
            ],
            [
              {
                "annotation_ids": [
                  "66ecd33b01565ac8",
                  "58a0b44220618d53",
                  "607fcf6813455e10"
                ],
                "status_id": 4,
                "text": "to allow reversing of the [encoding](../dynamodb-encryption-client/encrypt-item.md#base-context-value-version-2)."
              }
            ],
            "",
            [
              {
                "annotation_ids": [
                  "66ecd33b01565ac8",
                  "58a0b44220618d53"
                ],
                "status_id": 5,
                "text": "- 'S' if the attribute was of type String"
              }
            ],
            [
              {
                "annotation_ids": [
                  "66ecd33b01565ac8",
                  "58a0b44220618d53"
                ],
                "status_id": 5,
                "text": "- 'N' if the attribute was of type Number"
              }
            ],
            [
              {
                "annotation_ids": [
                  "66ecd33b01565ac8",
                  "58a0b44220618d53"
                ],
                "status_id": 5,
                "text": "- 'L' if the attribute was of type Null or Boolean"
              }
            ],
            [
              {
                "annotation_ids": [
                  "66ecd33b01565ac8",
                  "58a0b44220618d53"
                ],
                "status_id": 5,
                "text": "- 'B' otherwise"
              }
            ],
            "",
            [
              {
                "annotation_ids": [
                  "93856d8108c89fce",
                  "a75ec80af4ed6219",
                  "837ceb638c871eac"
                ],
                "status_id": 4,
                "text": "Then, this operation MUST create a [Required Encryption Context CMM](https://github.com/awslabs/private-aws-encryption-sdk-specification-staging/blob/dafny-verified/framework/required-encryption-context-cmm.md)"
              }
            ],
            [
              {
                "annotation_ids": [
                  "93856d8108c89fce",
                  "a75ec80af4ed6219",
                  "837ceb638c871eac"
                ],
                "status_id": 4,
                "text": "with the following inputs:"
              }
            ],
            "",
            [
              {
                "annotation_ids": [
                  "a75ec80af4ed6219"
                ],
                "status_id": 13,
                "text": "- This input [CMM](./ddb-table-encryption-config.md#cmm) as the underlying CMM."
              }
            ],
            [
              {
                "annotation_ids": [
                  "a75ec80af4ed6219"
                ],
                "status_id": 13,
                "text": "- The name of every entry added above."
              }
            ]
          ],
          "requirements": [
            "da1fec09f8e760aa",
            "da1fec09f8e760aa",
            "da1fec09f8e760aa",
            "8d816b6725a8fdeb",
            "8d816b6725a8fdeb",
            "8d816b6725a8fdeb",
            "8d816b6725a8fdeb",
            "c7304a2956bc997d",
            "c7304a2956bc997d",
            "607fcf6813455e10",
            "607fcf6813455e10",
            "607fcf6813455e10",
            "607fcf6813455e10",
            "837ceb638c871eac",
            "837ceb638c871eac"
          ],
          "title": "Create New Encryption Context and CMM"
        },
        {
          "id": "encryption-context-naming",
          "lines": [
            [
              {
                "annotation_ids": [
                  "d652ceb7f10ede02",
                  "eea2ed0838b627b6"
                ],
                "status_id": 7,
                "text": "When a key-value pair is added to the encryption context,"
              }
            ],
            [
              {
                "annotation_ids": [
                  "d652ceb7f10ede02",
                  "eea2ed0838b627b6"
                ],
                "status_id": 7,
                "text": "the key MUST be the concatenation of the literal"
              }
            ],
            [
              {
                "annotation_ids": [
                  "d652ceb7f10ede02",
                  "eea2ed0838b627b6"
                ],
                "status_id": 7,
                "text": "\"aws-crypto-attr.\" and the member strings of the"
              }
            ],
            [
              {
                "annotation_ids": [
                  "d652ceb7f10ede02",
                  "eea2ed0838b627b6"
                ],
                "status_id": 7,
                "text": "path joined by the '.' character."
              }
            ],
            "",
            "This mapping does not produce a unique output for every unique input.",
            "For example ['a.b'] and ['a', 'b'] both produce \"a.b\".",
            "",
            [
              {
                "annotation_ids": [
                  "98a32b1e60cea559",
                  "1dcbe0bd177fbfd4"
                ],
                "status_id": 7,
                "text": "An error MUST be returned if an attempt is made to add two"
              }
            ],
            [
              {
                "annotation_ids": [
                  "98a32b1e60cea559",
                  "1dcbe0bd177fbfd4"
                ],
                "status_id": 7,
                "text": "different attributes that produce the same encryption context key."
              }
            ]
          ],
          "requirements": [
            "eea2ed0838b627b6",
            "eea2ed0838b627b6",
            "eea2ed0838b627b6",
            "eea2ed0838b627b6",
            "1dcbe0bd177fbfd4",
            "1dcbe0bd177fbfd4"
          ],
          "title": "Encryption Context Naming"
        },
        {
          "id": "calculate-intermediate-encrypted-structured-data",
          "lines": [
            "To construct the final Encrypted Structured Data,",
            "a pre-signature version of this Encrypted Structured Data",
            "must first be calculated.",
            "This will be referred to as the Intermediate Encryption Structured Data.",
            "",
            "The calculations below REQUIRE generating a unique [Message ID](./header.md#message-id) for this Encrypted Structured Data.",
            [
              {
                "annotation_ids": [
                  "d057bbddda6d9f89",
                  "bcb16d0e9cdc334e"
                ],
                "status_id": 7,
                "text": "The process used to generate this identifier MUST use a good source of randomness"
              }
            ],
            [
              {
                "annotation_ids": [
                  "d057bbddda6d9f89",
                  "bcb16d0e9cdc334e"
                ],
                "status_id": 7,
                "text": "to make the chance of duplicate identifiers negligible."
              }
            ],
            "",
            "The Intermediate Encryption Structured Data has the following specifics:",
            "",
            [
              {
                "annotation_ids": [
                  "cafe644cf7dab72e",
                  "d9366e6139a73eba"
                ],
                "status_id": 1,
                "text": "For every entry"
              }
            ],
            [
              {
                "annotation_ids": [
                  "cafe644cf7dab72e",
                  "d9366e6139a73eba"
                ],
                "status_id": 1,
                "text": "in the input [Crypto List](#crypto-list)"
              }
            ],
            [
              {
                "annotation_ids": [
                  "cafe644cf7dab72e",
                  "d9366e6139a73eba"
                ],
                "status_id": 1,
                "text": "there MUST be an entry with the same [canonical path](./header.md#canonical-path)"
              }
            ],
            [
              {
                "annotation_ids": [
                  "cafe644cf7dab72e",
                  "d9366e6139a73eba"
                ],
                "status_id": 1,
                "text": "in Intermediate Encrypted Structured Data."
              }
            ],
            "",
            [
              {
                "annotation_ids": [
                  "7028d5e6a0ed506e",
                  "653207d2d8e7caa1"
                ],
                "status_id": 1,
                "text": "There MUST be no other entries in the Intermediate Encrypted Structured Data."
              }
            ]
          ],
          "requirements": [
            "bcb16d0e9cdc334e",
            "bcb16d0e9cdc334e",
            "d9366e6139a73eba",
            "d9366e6139a73eba",
            "d9366e6139a73eba",
            "d9366e6139a73eba",
            "653207d2d8e7caa1"
          ],
          "title": "Calculate Intermediate Encrypted Structured Data"
        },
        {
          "id": "calculate-info",
          "lines": [
            [
              {
                "annotation_ids": [
                  "2f1ce19edb8181a2",
                  "11aa2b99b85cb1ac"
                ],
                "status_id": 1,
                "text": "The `info` used for the HKDF function MUST be"
              }
            ],
            [
              {
                "annotation_ids": [
                  "2f1ce19edb8181a2",
                  "11aa2b99b85cb1ac"
                ],
                "status_id": 1,
                "text": "| Field | Length |"
              }
            ],
            [
              {
                "annotation_ids": [
                  "2f1ce19edb8181a2",
                  "11aa2b99b85cb1ac"
                ],
                "status_id": 1,
                "text": "| -------------------- | -------- |"
              }
            ],
            [
              {
                "annotation_ids": [
                  "2f1ce19edb8181a2",
                  "11aa2b99b85cb1ac"
                ],
                "status_id": 1,
                "text": "| \"AWS_DBE_DERIVE_KEY\" | 18 |"
              }
            ],
            [
              {
                "annotation_ids": [
                  "2f1ce19edb8181a2",
                  "11aa2b99b85cb1ac"
                ],
                "status_id": 1,
                "text": "| Message ID | 32 |"
              }
            ]
          ],
          "requirements": [
            "11aa2b99b85cb1ac",
            "11aa2b99b85cb1ac",
            "11aa2b99b85cb1ac",
            "11aa2b99b85cb1ac",
            "11aa2b99b85cb1ac"
          ],
          "title": "Calculate Info"
        },
        {
          "id": "calculate-cipherkey-and-nonce",
          "lines": [
            [
              {
                "annotation_ids": [
                  "3cabf31e8d9a6585",
                  "bc786991f5bf7519"
                ],
                "status_id": 1,
                "text": "The HKDF algorithm used to calculate the Field Root Key MUST be the"
              }
            ],
            [
              {
                "annotation_ids": [
                  "3cabf31e8d9a6585",
                  "bc786991f5bf7519"
                ],
                "status_id": 1,
                "text": "[Encryption Key KDF](../../submodules/MaterialProviders/aws-encryption-sdk-specification/framework/algorithm-suites.md#algorithm-suites-encryption-key-derivation-settings)"
              }
            ],
            [
              {
                "annotation_ids": [
                  "3cabf31e8d9a6585",
                  "bc786991f5bf7519"
                ],
                "status_id": 1,
                "text": "indicated by the algorithm suite, using a provided plaintext data key, no salt,"
              }
            ],
            [
              {
                "annotation_ids": [
                  "3cabf31e8d9a6585",
                  "bc786991f5bf7519"
                ],
                "status_id": 1,
                "text": "and an info as calculated [above](#calculate-info)"
              }
            ],
            "",
            [
              {
                "annotation_ids": [
                  "43f6f7e49ef73e15",
                  "213ecee4678c4b2c",
                  "dc48694bb65bf52b"
                ],
                "status_id": 11,
                "text": "The `FieldRootKey` MUST be generated with the plaintext data key in the encryption materials"
              }
            ],
            [
              {
                "annotation_ids": [
                  "43f6f7e49ef73e15",
                  "213ecee4678c4b2c",
                  "dc48694bb65bf52b"
                ],
                "status_id": 11,
                "text": "and the Message ID generated for this Encrypted Structured Data."
              }
            ],
            "",
            "The `FieldRootKey` is combined with the ordinal position of a field within a record",
            "to generate a unique `FieldKey` for encrypting that field.",
            "",
            "The ordinal position is calculated by sorting the",
            "[canonical path](./header.md#canonical-path)",
            "of all of the [ENCRYPT_AND_SIGN](./structures.md#encryptandsign) fields,",
            "sorting those paths in ascending order,",
            "and taking the zero-based position of the field in that sorted list.",
            "",
            [
              {
                "annotation_ids": [
                  "8436b1a4a59e7510",
                  "7d6d6eb6f08a887a"
                ],
                "status_id": 1,
                "text": "The calculated Field Root MUST have length equal to the"
              }
            ],
            [
              {
                "annotation_ids": [
                  "8436b1a4a59e7510",
                  "7d6d6eb6f08a887a"
                ],
                "status_id": 1,
                "text": "[algorithm suite's encryption key length](../../submodules/MaterialProviders/aws-encryption-sdk-specification/framework/algorithm-suites.md#algorithm-suites-encryption-settings)."
              }
            ],
            "",
            [
              {
                "annotation_ids": [
                  "33f7ed673c17df61",
                  "03b64312df7fa178"
                ],
                "status_id": 1,
                "text": "The `FieldKeyNonce` for a given offset MUST be 16 bytes comprised of"
              }
            ],
            [
              {
                "annotation_ids": [
                  "33f7ed673c17df61",
                  "03b64312df7fa178"
                ],
                "status_id": 1,
                "text": "| Field | Length | Interpretation |"
              }
            ],
            [
              {
                "annotation_ids": [
                  "33f7ed673c17df61",
                  "03b64312df7fa178"
                ],
                "status_id": 1,
                "text": "| ------------- | -------- | -------------- |"
              }
            ],
            [
              {
                "annotation_ids": [
                  "33f7ed673c17df61",
                  "03b64312df7fa178"
                ],
                "status_id": 1,
                "text": "| \"AwsDbeField\" | 11 | Literal Ascii String |"
              }
            ],
            [
              {
                "annotation_ids": [
                  "33f7ed673c17df61",
                  "03b64312df7fa178"
                ],
                "status_id": 1,
                "text": "| 0x2c | 1 | 44, the length of the eventual FieldKey |"
              }
            ],
            [
              {
                "annotation_ids": [
                  "33f7ed673c17df61",
                  "03b64312df7fa178"
                ],
                "status_id": 1,
                "text": "| offset | 4 | 32 bit integer representation of offset |"
              }
            ],
            "",
            [
              {
                "annotation_ids": [
                  "60c2def12ad9414a",
                  "389a58616831cc42"
                ],
                "status_id": 1,
                "text": "The `FieldKey` for a given key and offset MUST be the first 44 bytes"
              }
            ],
            [
              {
                "annotation_ids": [
                  "60c2def12ad9414a",
                  "389a58616831cc42"
                ],
                "status_id": 1,
                "text": "of the aes256ctr_stream"
              }
            ],
            [
              {
                "annotation_ids": [
                  "60c2def12ad9414a",
                  "389a58616831cc42"
                ],
                "status_id": 1,
                "text": "of the `FieldRootKey` and the `FieldKeyNonce` of three times the given offset."
              }
            ],
            "The `FieldKey` is used to derive a specific Cipherkey for each specific TerminalData to be encrypted, and the nonces that are used for that encryption\"",
            "",
            [
              {
                "annotation_ids": [
                  "9943454342de6fb5",
                  "2a653035487116fa",
                  "60aaf19de68698b3"
                ],
                "status_id": 11,
                "text": "The `Cipherkey` MUST be the first 32 bytes of the `FieldKey`"
              }
            ],
            "",
            [
              {
                "annotation_ids": [
                  "172817606fd4dce4",
                  "d058caa5cd73b757",
                  "bcc5c2fdfc7e41dd"
                ],
                "status_id": 11,
                "text": "The `Nonce` MUST be the remaining 12 bytes of the `FieldKey`"
              }
            ]
          ],
          "requirements": [
            "bc786991f5bf7519",
            "bc786991f5bf7519",
            "bc786991f5bf7519",
            "bc786991f5bf7519",
            "dc48694bb65bf52b",
            "dc48694bb65bf52b",
            "7d6d6eb6f08a887a",
            "7d6d6eb6f08a887a",
            "03b64312df7fa178",
            "03b64312df7fa178",
            "03b64312df7fa178",
            "03b64312df7fa178",
            "03b64312df7fa178",
            "03b64312df7fa178",
            "389a58616831cc42",
            "389a58616831cc42",
            "389a58616831cc42",
            "60aaf19de68698b3",
            "bcc5c2fdfc7e41dd"
          ],
          "title": "Calculate Cipherkey and Nonce"
        },
        {
          "id": "terminal-data-encryption",
          "lines": [
            "Encryption of [Terminal Data](./structures.md#terminal-data) takes a",
            "Terminal Data as input, and returns an encrypted Terminal Data.",
            "",
            [
              {
                "annotation_ids": [
                  "ce207cdc047a1296",
                  "13daf9dc639b0dcc"
                ],
                "status_id": 1,
                "text": "The output encrypted Terminal Data MUST have a [Terminal Type Id](./structures.md#terminal-type-id)"
              }
            ],
            [
              {
                "annotation_ids": [
                  "ce207cdc047a1296",
                  "13daf9dc639b0dcc"
                ],
                "status_id": 1,
                "text": "equal `0xFFFF`."
              }
            ],
            "",
            [
              {
                "annotation_ids": [
                  "ff4760e779f401bb",
                  "1c764b014097a5f2"
                ],
                "status_id": 1,
                "text": "The output encrypted Terminal Data MUST have a [Terminal Value](./structures.md#terminal-value)"
              }
            ],
            [
              {
                "annotation_ids": [
                  "ff4760e779f401bb",
                  "1c764b014097a5f2"
                ],
                "status_id": 1,
                "text": "with the following serialization:"
              }
            ],
            "",
            "| Field                    | Length   |",
            "| ------------------------ | -------- |",
            "| Terminal Type Id         | 2        |",
            "| Encrypted Terminal Value | Variable |"
          ],
          "requirements": [
            "13daf9dc639b0dcc",
            "13daf9dc639b0dcc",
            "1c764b014097a5f2",
            "1c764b014097a5f2"
          ],
          "title": "Terminal Data Encryption"
        },
        {
          "id": "terminal-type-id",
          "lines": [
            [
              {
                "annotation_ids": [
                  "3d1a7801d9f4a7c3",
                  "0a759407ec7a466b"
                ],
                "status_id": 1,
                "text": "Terminal Type Id MUST equal the input Terminal Data's Terminal Type Id."
              }
            ]
          ],
          "requirements": [
            "0a759407ec7a466b"
          ],
          "title": "Terminal Type Id"
        },
        {
          "id": "encrypted-terminal-value",
          "lines": [
            [
              {
                "annotation_ids": [
                  "74cac5e4e6accdd2",
                  "7105a9a83af70f77"
                ],
                "status_id": 7,
                "text": "The Encrypted Terminal Value MUST be derived according to the following encryption:"
              }
            ],
            "",
            "- The encryption algorithm used is the",
            "  [encryption algorithm](../../submodules/MaterialProviders/aws-encryption-sdk-specification/framework/algorithm-suites.md#algorithm-suites-encryption-settings)",
            "  indicated in the algorithm suite.",
            "- The AAD is the [canonical path](./header.md#canonical-path) for this Terminal Data.",
            "- The [Cipherkey and Nonce](#calculate-cipherkey-and-nonce) are as calculated above.",
            "- The plaintext is the [Terminal Value](./structures.md#terminal-value) for this Terminal Data."
          ],
          "requirements": [
            "7105a9a83af70f77"
          ],
          "title": "Encrypted Terminal Value"
        },
        {
          "id": "construct-encrypted-structured-data",
          "lines": [
            "Given an Intermediate Encrypted Structured Data,",
            "the signatures over this Structured Data may be calculated,",
            "and the final Encrypted Structured Data outputted."
          ],
          "title": "Construct Encrypted Structured Data"
        },
        {
          "id": "header-field",
          "lines": [
            [
              {
                "annotation_ids": [
                  "0bf56873743cb869",
                  "c49ff501f2abc446"
                ],
                "status_id": 1,
                "text": "The Header Field name MUST be `aws_dbe_head`"
              }
            ],
            "",
            [
              {
                "annotation_ids": [
                  "a3f7695aebd8906e",
                  "1aa34cd5053e3ed9"
                ],
                "status_id": 7,
                "text": "The Header Field TypeID MUST be 0xFFFF"
              }
            ],
            "",
            [
              {
                "annotation_ids": [
                  "2169c94f3d997799",
                  "21c8401290d15edf"
                ],
                "status_id": 7,
                "text": "The Header Field Value MUST be the full serialized [header](header.md) with commitment."
              }
            ],
            "",
            [
              {
                "annotation_ids": [
                  "49d171d2d018a243",
                  "690a8d2226a83402"
                ],
                "status_id": 7,
                "text": "The encryption context field serialized in the header MUST contain all key-value"
              }
            ],
            [
              {
                "annotation_ids": [
                  "49d171d2d018a243",
                  "690a8d2226a83402"
                ],
                "status_id": 7,
                "text": "pairs of the encryption context in the [encryption materials](#retrieve-encryption-materials)"
              }
            ],
            [
              {
                "annotation_ids": [
                  "49d171d2d018a243",
                  "690a8d2226a83402"
                ],
                "status_id": 7,
                "text": "that are not included in the"
              }
            ],
            [
              {
                "annotation_ids": [
                  "49d171d2d018a243",
                  "690a8d2226a83402"
                ],
                "status_id": 7,
                "text": "[required encryption context keys](../framework/structures.md#required-encryption-context-keys) list."
              }
            ]
          ],
          "requirements": [
            "c49ff501f2abc446",
            "1aa34cd5053e3ed9",
            "21c8401290d15edf",
            "690a8d2226a83402",
            "690a8d2226a83402",
            "690a8d2226a83402",
            "690a8d2226a83402"
          ],
          "title": "Header Field"
        },
        {
          "id": "footer-field",
          "lines": [
            [
              {
                "annotation_ids": [
                  "50497c2933ba562c",
                  "3b1cb95ab2c4bb9d"
                ],
                "status_id": 1,
                "text": "The Footer Field name MUST be `aws_dbe_foot`"
              }
            ],
            "",
            [
              {
                "annotation_ids": [
                  "d8e039d79120b1d2",
                  "64cc67477a0e5887"
                ],
                "status_id": 1,
                "text": "The Footer Field TypeID MUST be 0xFFFF"
              }
            ],
            "",
            [
              {
                "annotation_ids": [
                  "3002436cf7abbf76",
                  "134b13e8def992a0"
                ],
                "status_id": 1,
                "text": "The Footer Field Value MUST be the serialized [footer](footer.md)."
              }
            ]
          ],
          "requirements": [
            "3b1cb95ab2c4bb9d",
            "64cc67477a0e5887",
            "134b13e8def992a0"
          ],
          "title": "Footer Field"
        },
        {
          "id": "encrypted-structured-data",
          "lines": [
            [
              {
                "annotation_ids": [
                  "43e0cd160528779b",
                  "417613ec59da1fcd"
                ],
                "status_id": 1,
                "text": "- For every entry in the input [Crypto List](#crypto-list)"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "  "
              },
              {
                "annotation_ids": [
                  "43e0cd160528779b",
                  "417613ec59da1fcd"
                ],
                "status_id": 1,
                "text": "an entry MUST exist with the same [path](./structures.md#path) in the final Encrypted Structured Data."
              }
            ],
            [
              {
                "annotation_ids": [
                  "baaa1eff9df34c36",
                  "4f0cdf2e5361601d"
                ],
                "status_id": 1,
                "text": "- The [Header Field](#header-field) MUST exist in the final Encrypted Structured Data"
              }
            ],
            [
              {
                "annotation_ids": [
                  "8cd41b6b1ee21242",
                  "cb90ced4209977f3"
                ],
                "status_id": 1,
                "text": "- The [Footer Field](#footer-field) MUST exist in the final Encrypted Structured Data"
              }
            ],
            [
              {
                "annotation_ids": [
                  "03c5973a5dfcef62",
                  "ba182ef03dfc0e04"
                ],
                "status_id": 1,
                "text": "- For every entry in the final Encrypted Structured Data, other than the header and footer,"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "  "
              },
              {
                "annotation_ids": [
                  "03c5973a5dfcef62",
                  "ba182ef03dfc0e04"
                ],
                "status_id": 1,
                "text": "an entry MUST exist with the same [path](./structures.md#path) in the input [Crypto List](#crypto-list)."
              }
            ],
            "",
            "For each entry in the final Encrypted Structured Data:",
            "",
            [
              {
                "annotation_ids": [
                  "bc245a5dc83fb052",
                  "dd2021b4802d515a"
                ],
                "status_id": 1,
                "text": "If the [Crypto Schema](#crypto-list)"
              }
            ],
            [
              {
                "annotation_ids": [
                  "bc245a5dc83fb052",
                  "dd2021b4802d515a"
                ],
                "status_id": 1,
                "text": "indicates a [Crypto Action](./structures.md#crypto-action)"
              }
            ],
            [
              {
                "annotation_ids": [
                  "bc245a5dc83fb052",
                  "dd2021b4802d515a"
                ],
                "status_id": 1,
                "text": "of [ENCRYPT_AND_SIGN](./structures.md#encryptandsign),"
              }
            ],
            [
              {
                "annotation_ids": [
                  "bc245a5dc83fb052",
                  "dd2021b4802d515a"
                ],
                "status_id": 1,
                "text": "the Terminal Data MUST have [Terminal Type ID](./structures.md#terminal-type-id)"
              }
            ],
            [
              {
                "annotation_ids": [
                  "bc245a5dc83fb052",
                  "dd2021b4802d515a"
                ],
                "status_id": 1,
                "text": "equal to 0xffff and the value MUST be"
              }
            ],
            [
              {
                "annotation_ids": [
                  "bc245a5dc83fb052",
                  "dd2021b4802d515a"
                ],
                "status_id": 1,
                "text": "the [encryption](#terminal-data-encryption)"
              }
            ],
            [
              {
                "annotation_ids": [
                  "bc245a5dc83fb052",
                  "dd2021b4802d515a"
                ],
                "status_id": 1,
                "text": "of the input's Terminal Data."
              }
            ],
            "",
            [
              {
                "annotation_ids": [
                  "41470bfa1022a0d9",
                  "74eb49d2a6b94e1b"
                ],
                "status_id": 1,
                "text": "Otherwise, this Terminal Data MUST have [Terminal Type ID](./structures.md#terminal-type-id)"
              }
            ],
            [
              {
                "annotation_ids": [
                  "41470bfa1022a0d9",
                  "74eb49d2a6b94e1b"
                ],
                "status_id": 1,
                "text": "and [Terminal Value](./structures.md#terminal-value) equal to the input Terminal Data's."
              }
            ]
          ],
          "requirements": [
            "417613ec59da1fcd",
            "417613ec59da1fcd",
            "4f0cdf2e5361601d",
            "cb90ced4209977f3",
            "ba182ef03dfc0e04",
            "ba182ef03dfc0e04",
            "dd2021b4802d515a",
            "dd2021b4802d515a",
            "dd2021b4802d515a",
            "dd2021b4802d515a",
            "dd2021b4802d515a",
            "dd2021b4802d515a",
            "dd2021b4802d515a",
            "74eb49d2a6b94e1b",
            "74eb49d2a6b94e1b"
          ],
          "title": "Encrypted Structured Data"
        }
      ],
      "title": "Encrypt Path Structure"
    },
    "specification/structured-encryption/encrypt-structure.md": {
      "format": "markdown",
      "sections": [
        {
          "id": "encrypt-structure",
          "lines": [],
          "title": "Encrypt Structure"
        },
        {
          "id": "version",
          "lines": [
            "1.1.0"
          ],
          "title": "Version"
        },
        {
          "id": "changelog",
          "lines": [
            "- 1.1.0",
            "",
            "  - Update for simplified structured encryption",
            "",
            "- 1.0.0",
            "  - Initial record"
          ],
          "title": "Changelog"
        },
        {
          "id": "definitions",
          "lines": [],
          "title": "Definitions"
        },
        {
          "id": "conventions-used-in-this-document",
          "lines": [
            "The key words \"MUST\", \"MUST NOT\", \"REQUIRED\", \"SHALL\", \"SHALL NOT\", \"SHOULD\", \"SHOULD NOT\", \"RECOMMENDED\", \"MAY\", and \"OPTIONAL\"",
            "in this document are to be interpreted as described in [RFC 2119](https://tools.ietf.org/html/rfc2119)."
          ],
          "title": "Conventions used in this document"
        },
        {
          "id": "overview",
          "lines": [
            "This document describes the behavior by which a [Structured Data](./structures.md#structured-data) is encrypted.",
            "We define encryption over this [Structured Data](./structures.md#structured-data) to mean that",
            "authenticity is ensured over a non-empty set of [Terminal Data](./structures.md#terminal-data),",
            "and confidentiality is ensured over a (possibly empty) subset of that Terminal Data."
          ],
          "title": "Overview"
        },
        {
          "id": "input",
          "lines": [
            [
              {
                "annotation_ids": [
                  "c2e39f1cb57c08a4",
                  "911d4f823ebe5cfb"
                ],
                "status_id": 1,
                "text": "The following inputs to this behavior are REQUIRED:"
              }
            ],
            "",
            "- [Table Name](encrypt-path-structure.md#table-name)",
            "- [Structured Data](encrypt-path-structure.md#structured-data)",
            "- [Crypto Schema](encrypt-path-structure.md#crypto-schema)",
            "- [Cryptographic Materials Manager (CMM)](encrypt-path-structure.md#cmm)",
            "",
            [
              {
                "annotation_ids": [
                  "5df82d7216361c52",
                  "fca5c37a52bef006"
                ],
                "status_id": 1,
                "text": "The following inputs to this behavior MUST be OPTIONAL:"
              }
            ],
            "",
            "- [Algorithm Suite](encrypt-path-structure.md#algorithm-suite)",
            "- [Encryption Context](encrypt-path-structure.md#encryption-context)"
          ],
          "requirements": [
            "911d4f823ebe5cfb",
            "fca5c37a52bef006"
          ],
          "title": "Input"
        },
        {
          "id": "output",
          "lines": [
            [
              {
                "annotation_ids": [
                  "91826485753faad1",
                  "ee38a94650aedac0"
                ],
                "status_id": 1,
                "text": "This operation MUST output the following:"
              }
            ],
            "",
            [
              {
                "annotation_ids": [
                  "91826485753faad1"
                ],
                "status_id": 2,
                "text": "- [Encrypted Structured Data](encrypt-path-structure.md#encrypted-structured-data)"
              }
            ],
            [
              {
                "annotation_ids": [
                  "91826485753faad1"
                ],
                "status_id": 2,
                "text": "- [Crypto Schema](./structures.md#crypto-schema): The Crypto Schema for each signed Terminal"
              }
            ],
            [
              {
                "annotation_ids": [
                  "91826485753faad1"
                ],
                "status_id": 2,
                "text": "- [Parsed Header](./decrypt-structure.md#parsed-header)"
              }
            ]
          ],
          "requirements": [
            "ee38a94650aedac0"
          ],
          "title": "Output"
        },
        {
          "id": "behavior",
          "lines": [
            [
              {
                "annotation_ids": [
                  "4abc5a3d2b838bae",
                  "f7ddddc2d6681a8f"
                ],
                "status_id": 1,
                "text": "The input [Structured Data](encrypt-path-structure.md#structured-data) and [Crypto Schema](encrypt-path-structure.md#crypto-schema)"
              }
            ],
            [
              {
                "annotation_ids": [
                  "4abc5a3d2b838bae",
                  "f7ddddc2d6681a8f"
                ],
                "status_id": 1,
                "text": "MUST refer to the same set of locations."
              }
            ],
            "",
            [
              {
                "annotation_ids": [
                  "78cb6b7bf2c4629f",
                  "7e92293b95d82269"
                ],
                "status_id": 1,
                "text": "The input [Structured Data](encrypt-path-structure.md#structured-data) and [Crypto Schema](encrypt-path-structure.md#crypto-schema)"
              }
            ],
            [
              {
                "annotation_ids": [
                  "78cb6b7bf2c4629f",
                  "7e92293b95d82269"
                ],
                "status_id": 1,
                "text": "MUST be combined into a single [Crypto List](encrypt-path-structure.md#crypto-list)."
              }
            ],
            "",
            [
              {
                "annotation_ids": [
                  "610348584b1f1ee4",
                  "e105e61f7d7d74ef"
                ],
                "status_id": 1,
                "text": "Encrypt Structure MUST then behave as [Encrypt Path Structure](encrypt-path-structure.md)"
              }
            ],
            "",
            [
              {
                "annotation_ids": [
                  "00e4754d665a59a2",
                  "ee0be7efc0dc8939"
                ],
                "status_id": 1,
                "text": "The output [Crypto List](encrypt-path-structure.md#crypto-list) produced by [Encrypt Path Structure](encrypt-path-structure.md)"
              }
            ],
            [
              {
                "annotation_ids": [
                  "00e4754d665a59a2",
                  "ee0be7efc0dc8939"
                ],
                "status_id": 1,
                "text": "MUST be split into [Structured Data](encrypt-path-structure.md#structured-data) and [Crypto Schema](encrypt-path-structure.md#crypto-schema)"
              }
            ],
            [
              {
                "annotation_ids": [
                  "00e4754d665a59a2",
                  "ee0be7efc0dc8939"
                ],
                "status_id": 1,
                "text": "maps."
              }
            ]
          ],
          "requirements": [
            "f7ddddc2d6681a8f",
            "f7ddddc2d6681a8f",
            "7e92293b95d82269",
            "7e92293b95d82269",
            "e105e61f7d7d74ef",
            "ee0be7efc0dc8939",
            "ee0be7efc0dc8939",
            "ee0be7efc0dc8939"
          ],
          "title": "Behavior"
        }
      ],
      "title": "Encrypt Structure"
    },
    "specification/structured-encryption/footer.md": {
      "format": "markdown",
      "sections": [
        {
          "id": "structured-encryption-footer",
          "lines": [],
          "title": "Structured Encryption Footer"
        },
        {
          "id": "overview",
          "lines": [
            "The footer is a special [Terminal Data](./structures.md#terminal-data)",
            "that exists on encrypted [Structured Data](./structures.md#structured-data)",
            "in order to store signatures over signed fields in that structured data."
          ],
          "title": "Overview"
        },
        {
          "id": "signed-fields",
          "lines": [
            "When encrypting, `signed fields` refers to all fields for which the",
            "[Crypto Schema](./structures.md#crypto-schema) indicates `ENCRYPT_AND_SIGN` or `SIGN_ONLY`.",
            "",
            "When decrypting `signed fields` refers to all fields for which the",
            "the [Authenticate Schema](./structures.md#authenticate-schema) indicates `SIGN`"
          ],
          "title": "Signed Fields"
        },
        {
          "id": "footer-format",
          "lines": [
            [
              {
                "annotation_ids": [
                  "5ba83cd190b28f57",
                  "d26581372f582fdd"
                ],
                "status_id": 1,
                "text": "The [Terminal Value](./structures.md#terminal-value) of the footer MUST be"
              }
            ],
            "",
            "| Field                             | Length (bytes)                                          | Interpreted as                       |",
            "| --------------------------------- | ------------------------------------------------------- | ------------------------------------ |",
            "| [Recipient Tags](#recipient-tags) | Variable. 48 bytes per Encrypted Data Key in the header | Bytes                                |",
            "| [Signature](#signature)           | 0 or 96                                                 | Signature, if signatures are enabled |"
          ],
          "requirements": [
            "d26581372f582fdd"
          ],
          "title": "Footer Format"
        },
        {
          "id": "canonical-hash",
          "lines": [
            "A canonical hash is calculated for the encrypted form of a record.",
            "This hash is used to calculate the HMACs and Signature."
          ],
          "title": "Canonical Hash"
        },
        {
          "id": "canonical-field",
          "lines": [],
          "title": "Canonical Field"
        },
        {
          "id": "canonical-encrypted-field",
          "lines": [
            [
              {
                "annotation_ids": [
                  "e58f3a00e775531c",
                  "27fc6b640acadf7c"
                ],
                "status_id": 1,
                "text": "The canonical form of an encrypted field MUST be"
              }
            ],
            [
              {
                "annotation_ids": [
                  "e58f3a00e775531c",
                  "27fc6b640acadf7c"
                ],
                "status_id": 1,
                "text": "| Field | Length (bytes) | Interpreted as |"
              }
            ],
            [
              {
                "annotation_ids": [
                  "e58f3a00e775531c",
                  "27fc6b640acadf7c"
                ],
                "status_id": 1,
                "text": "| ----- | -------------- | -------------- |"
              }
            ],
            [
              {
                "annotation_ids": [
                  "e58f3a00e775531c",
                  "27fc6b640acadf7c"
                ],
                "status_id": 1,
                "text": "| The [canonical path](./header.md#canonical-path) of the field name | Variable | Bytes |"
              }
            ],
            [
              {
                "annotation_ids": [
                  "e58f3a00e775531c",
                  "27fc6b640acadf7c"
                ],
                "status_id": 1,
                "text": "| encrypted data length - 2 | 8 | 64-bit integer |"
              }
            ],
            [
              {
                "annotation_ids": [
                  "e58f3a00e775531c",
                  "27fc6b640acadf7c"
                ],
                "status_id": 1,
                "text": "| \"ENCRYPTED\" | 9 | Literal Ascii text |"
              }
            ],
            [
              {
                "annotation_ids": [
                  "e58f3a00e775531c",
                  "27fc6b640acadf7c"
                ],
                "status_id": 1,
                "text": "| TypeID | 2 | the type ID of the unencrypted Terminal |"
              }
            ],
            [
              {
                "annotation_ids": [
                  "e58f3a00e775531c",
                  "27fc6b640acadf7c"
                ],
                "status_id": 1,
                "text": "| value | Variable | the encrypted Terminal value |"
              }
            ],
            "",
            "The original data length of an encrypted field will be two less than its encrypted form",
            "because the encrypted form starts with the two byte unencrypted data type;",
            "so by using 2 less than the encrypted data length, we are using the original data length."
          ],
          "requirements": [
            "27fc6b640acadf7c",
            "27fc6b640acadf7c",
            "27fc6b640acadf7c",
            "27fc6b640acadf7c",
            "27fc6b640acadf7c",
            "27fc6b640acadf7c",
            "27fc6b640acadf7c",
            "27fc6b640acadf7c"
          ],
          "title": "Canonical Encrypted Field"
        },
        {
          "id": "canonical-plaintext-field",
          "lines": [
            [
              {
                "annotation_ids": [
                  "d395a865b3e76124",
                  "6223cc3b29b3603f"
                ],
                "status_id": 1,
                "text": "The canonical form of a plaintext field MUST be"
              }
            ],
            [
              {
                "annotation_ids": [
                  "d395a865b3e76124",
                  "6223cc3b29b3603f"
                ],
                "status_id": 1,
                "text": "| Field | Length (bytes) | Interpreted as |"
              }
            ],
            [
              {
                "annotation_ids": [
                  "d395a865b3e76124",
                  "6223cc3b29b3603f"
                ],
                "status_id": 1,
                "text": "| ----- | -------------- | -------------- |"
              }
            ],
            [
              {
                "annotation_ids": [
                  "d395a865b3e76124",
                  "6223cc3b29b3603f"
                ],
                "status_id": 1,
                "text": "| The [canonical path](./header.md#canonical-path) of the field name | Variable | Bytes |"
              }
            ],
            [
              {
                "annotation_ids": [
                  "d395a865b3e76124",
                  "6223cc3b29b3603f"
                ],
                "status_id": 1,
                "text": "| data length | 8 | 64-bit integer |"
              }
            ],
            [
              {
                "annotation_ids": [
                  "d395a865b3e76124",
                  "6223cc3b29b3603f"
                ],
                "status_id": 1,
                "text": "| \"PLAINTEXT\" | 9 | Literal Ascii text |"
              }
            ],
            [
              {
                "annotation_ids": [
                  "d395a865b3e76124",
                  "6223cc3b29b3603f"
                ],
                "status_id": 1,
                "text": "| TypeID | 2 | the type ID of the Terminal |"
              }
            ],
            [
              {
                "annotation_ids": [
                  "d395a865b3e76124",
                  "6223cc3b29b3603f"
                ],
                "status_id": 1,
                "text": "| value | Variable | the Terminal value |"
              }
            ]
          ],
          "requirements": [
            "6223cc3b29b3603f",
            "6223cc3b29b3603f",
            "6223cc3b29b3603f",
            "6223cc3b29b3603f",
            "6223cc3b29b3603f",
            "6223cc3b29b3603f",
            "6223cc3b29b3603f",
            "6223cc3b29b3603f"
          ],
          "title": "Canonical Plaintext Field"
        },
        {
          "id": "canonical-record",
          "lines": [
            [
              {
                "annotation_ids": [
                  "b0b2e5d792cf8906",
                  "a3e100f6c6e3a989"
                ],
                "status_id": 1,
                "text": "The canonical form of a record MUST be"
              }
            ],
            [
              {
                "annotation_ids": [
                  "b0b2e5d792cf8906",
                  "a3e100f6c6e3a989"
                ],
                "status_id": 1,
                "text": "| Field | Length (bytes) | Interpreted as |"
              }
            ],
            [
              {
                "annotation_ids": [
                  "b0b2e5d792cf8906",
                  "a3e100f6c6e3a989"
                ],
                "status_id": 1,
                "text": "| ----- | -------------- | -------------- |"
              }
            ],
            [
              {
                "annotation_ids": [
                  "b0b2e5d792cf8906",
                  "a3e100f6c6e3a989"
                ],
                "status_id": 1,
                "text": "| header | Variable | The full serialized header with commitment |"
              }
            ],
            [
              {
                "annotation_ids": [
                  "b0b2e5d792cf8906",
                  "a3e100f6c6e3a989"
                ],
                "status_id": 1,
                "text": "| AAD Length | 8 | 64-bit integer, the length of the following AAD data |"
              }
            ],
            [
              {
                "annotation_ids": [
                  "b0b2e5d792cf8906",
                  "a3e100f6c6e3a989"
                ],
                "status_id": 1,
                "text": "| AAD | Variable | The serialization of the Encryption Context from the Encryption Materials |"
              }
            ],
            [
              {
                "annotation_ids": [
                  "b0b2e5d792cf8906",
                  "a3e100f6c6e3a989"
                ],
                "status_id": 1,
                "text": "| Field Data | Variable | For each [signed field](#signed-fields), ordered lexicographically by [canonical path](./header.md#canonical-path), the [canonical field](#canonical-field)."
              },
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": " |"
              }
            ]
          ],
          "requirements": [
            "a3e100f6c6e3a989",
            "a3e100f6c6e3a989",
            "a3e100f6c6e3a989",
            "a3e100f6c6e3a989",
            "a3e100f6c6e3a989",
            "a3e100f6c6e3a989",
            "a3e100f6c6e3a989"
          ],
          "title": "Canonical Record"
        },
        {
          "id": "hash-calculation",
          "lines": [
            [
              {
                "annotation_ids": [
                  "fb81be2c32ab89c0",
                  "dc0a507e7b7fd3b6"
                ],
                "status_id": 1,
                "text": "The canonical hash of a record MUST be the SHA384 of the canonical form of the record."
              }
            ]
          ],
          "requirements": [
            "dc0a507e7b7fd3b6"
          ],
          "title": "Hash Calculation"
        },
        {
          "id": "recipient-tags",
          "lines": [
            [
              {
                "annotation_ids": [
                  "39eace62e1ce0997",
                  "f914fa5afef93d92"
                ],
                "status_id": 1,
                "text": "There MUST be one Recipient Tag for each Encrypted Data Key in the [header](./header.md#encrypted-data-keys)"
              }
            ],
            "",
            "The encryption materials provide a list of encrypted data keys,",
            "and an associated list of symmetricSigningKeys,",
            "representing authorized recipients.",
            "",
            [
              {
                "annotation_ids": [
                  "e0a306127e4f12ce",
                  "684d4e0cf6fd9804"
                ],
                "status_id": 7,
                "text": "the Recipient Tag MUST be MUST be calculated over the [Canonical Hash](#canonical-hash)"
              }
            ],
            [
              {
                "annotation_ids": [
                  "e0a306127e4f12ce",
                  "684d4e0cf6fd9804"
                ],
                "status_id": 7,
                "text": "using the [symmetric signature algorithm](../../submodules/MaterialProviders/aws-encryption-sdk-specification/framework/algorithm-suites.md#algorithm-suites-signature-settings)"
              }
            ],
            [
              {
                "annotation_ids": [
                  "e0a306127e4f12ce",
                  "684d4e0cf6fd9804"
                ],
                "status_id": 7,
                "text": "indicated in the algorithm suite,"
              }
            ],
            [
              {
                "annotation_ids": [
                  "e0a306127e4f12ce",
                  "684d4e0cf6fd9804"
                ],
                "status_id": 7,
                "text": "and the"
              }
            ],
            [
              {
                "annotation_ids": [
                  "e0a306127e4f12ce",
                  "684d4e0cf6fd9804"
                ],
                "status_id": 7,
                "text": "[symmetric signing keys](../../submodules/MaterialProviders/aws-encryption-sdk-specification/framework/structures.md#symmetric-signing-keys)"
              }
            ],
            [
              {
                "annotation_ids": [
                  "e0a306127e4f12ce",
                  "684d4e0cf6fd9804"
                ],
                "status_id": 7,
                "text": "in the encryption materials."
              }
            ],
            "",
            [
              {
                "annotation_ids": [
                  "346f1c80465ed410",
                  "4cd1bfc7199732aa"
                ],
                "status_id": 7,
                "text": "the HMAC values MUST have the same order as the"
              }
            ],
            [
              {
                "annotation_ids": [
                  "346f1c80465ed410",
                  "4cd1bfc7199732aa"
                ],
                "status_id": 7,
                "text": "[symmetric signing keys](../../submodules/MaterialProviders/aws-encryption-sdk-specification/framework/structures.md#symmetric-signing-keys)"
              }
            ],
            [
              {
                "annotation_ids": [
                  "346f1c80465ed410",
                  "4cd1bfc7199732aa"
                ],
                "status_id": 7,
                "text": "used to calculate them."
              }
            ]
          ],
          "requirements": [
            "f914fa5afef93d92",
            "684d4e0cf6fd9804",
            "684d4e0cf6fd9804",
            "684d4e0cf6fd9804",
            "684d4e0cf6fd9804",
            "684d4e0cf6fd9804",
            "684d4e0cf6fd9804",
            "4cd1bfc7199732aa",
            "4cd1bfc7199732aa",
            "4cd1bfc7199732aa"
          ],
          "title": "Recipient Tags"
        },
        {
          "id": "signature",
          "lines": [
            [
              {
                "annotation_ids": [
                  "d8a27d7a79dd4ebd"
                ],
                "status_id": 8,
                "text": "The signature MUST be included in the footer if the flavor"
              }
            ],
            [
              {
                "annotation_ids": [
                  "d8a27d7a79dd4ebd"
                ],
                "status_id": 8,
                "text": "in the [header](./header.md#format-flavor) is 0x01"
              }
            ],
            [
              {
                "annotation_ids": [
                  "d8a27d7a79dd4ebd"
                ],
                "status_id": 8,
                "text": "and MUST NOT be included in the footer if the flavor"
              }
            ],
            [
              {
                "annotation_ids": [
                  "d8a27d7a79dd4ebd"
                ],
                "status_id": 8,
                "text": "in the [header](./header.md#format-flavor) is 0x00."
              }
            ],
            "",
            [
              {
                "annotation_ids": [
                  "e332dc80a6c1bed6",
                  "1c67f06dfb1d5d75"
                ],
                "status_id": 7,
                "text": "The `signature`, if it exists, MUST be calculated over the [Canonical Hash](#canonical-hash),"
              }
            ],
            [
              {
                "annotation_ids": [
                  "e332dc80a6c1bed6",
                  "1c67f06dfb1d5d75"
                ],
                "status_id": 7,
                "text": "using the asymmetric signing key in the encryption materials."
              }
            ],
            "",
            [
              {
                "annotation_ids": [
                  "5d81feec9d61fef0",
                  "ac8ada92dc3960f7"
                ],
                "status_id": 1,
                "text": "The `signature`, if it exists, MUST be calculated using the"
              }
            ],
            [
              {
                "annotation_ids": [
                  "5d81feec9d61fef0",
                  "ac8ada92dc3960f7"
                ],
                "status_id": 1,
                "text": "[asymmetric signature algorithm](../../submodules/MaterialProviders/aws-encryption-sdk-specification/framework/algorithm-suites.md#algorithm-suites-signature-settings)"
              }
            ],
            [
              {
                "annotation_ids": [
                  "5d81feec9d61fef0",
                  "ac8ada92dc3960f7"
                ],
                "status_id": 1,
                "text": "indicated by the algorithm suite."
              }
            ]
          ],
          "requirements": [
            "d8a27d7a79dd4ebd",
            "d8a27d7a79dd4ebd",
            "d8a27d7a79dd4ebd",
            "d8a27d7a79dd4ebd",
            "1c67f06dfb1d5d75",
            "1c67f06dfb1d5d75",
            "ac8ada92dc3960f7",
            "ac8ada92dc3960f7",
            "ac8ada92dc3960f7"
          ],
          "title": "Signature"
        },
        {
          "id": "footer-verification",
          "lines": [
            "The footer is verified before it's record is decrypted."
          ],
          "title": "Footer Verification"
        },
        {
          "id": "recipient-tag-verification",
          "lines": [
            [
              {
                "annotation_ids": [
                  "1c81c5a473724fd8",
                  "3152c7de1a8d805a"
                ],
                "status_id": 7,
                "text": "Verification MUST fail unless at least one of the [Recipient Tags](#recipient-tags)"
              }
            ],
            [
              {
                "annotation_ids": [
                  "1c81c5a473724fd8",
                  "3152c7de1a8d805a"
                ],
                "status_id": 7,
                "text": "matches a calculated recipient tag using the provided symmetricSigningKey."
              }
            ],
            [
              {
                "annotation_ids": [
                  "467503d6fc5b2390",
                  "6750346fe9a2016c"
                ],
                "status_id": 7,
                "text": "Recipient Tag comparisons MUST be constant time operations."
              }
            ]
          ],
          "requirements": [
            "3152c7de1a8d805a",
            "3152c7de1a8d805a",
            "6750346fe9a2016c"
          ],
          "title": "Recipient Tag Verification"
        },
        {
          "id": "signature-verification",
          "lines": [
            [
              {
                "annotation_ids": [
                  "fed4d1e2720a30c3",
                  "35e64e548c2d75d2"
                ],
                "status_id": 7,
                "text": "If the footer contains a signature, this signature MUST be verified using the"
              }
            ],
            [
              {
                "annotation_ids": [
                  "fed4d1e2720a30c3",
                  "35e64e548c2d75d2"
                ],
                "status_id": 7,
                "text": "[asymmetric signature algorithm](../../submodules/MaterialProviders/aws-encryption-sdk-specification/framework/algorithm-suites.md#algorithm-suites-signature-settings)"
              }
            ],
            [
              {
                "annotation_ids": [
                  "fed4d1e2720a30c3",
                  "35e64e548c2d75d2"
                ],
                "status_id": 7,
                "text": "indicated by the algorithm suite."
              }
            ]
          ],
          "requirements": [
            "35e64e548c2d75d2",
            "35e64e548c2d75d2",
            "35e64e548c2d75d2"
          ],
          "title": "Signature Verification"
        }
      ],
      "title": "Structured Encryption Footer"
    },
    "specification/structured-encryption/header.md": {
      "format": "markdown",
      "sections": [
        {
          "id": "structured-encryption-header",
          "lines": [],
          "title": "Structured Encryption Header"
        },
        {
          "id": "overview",
          "lines": [
            "The header is a special [Terminal Data](./structures.md#terminal-data)",
            "that exists on encrypted [Structured Data](./structures.md#structured-data)",
            "in order to store metadata on its encryption."
          ],
          "title": "Overview"
        },
        {
          "id": "header-value",
          "lines": [],
          "title": "Header Value"
        },
        {
          "id": "partial-header",
          "lines": [
            [
              {
                "annotation_ids": [
                  "a3b043ef588a45d5",
                  "cad994b396646f5b"
                ],
                "status_id": 1,
                "text": "The Partial Header MUST be"
              }
            ],
            "",
            "| Length (bytes) | Meaning                                     |",
            "| -------------- | ------------------------------------------- |",
            "| 1              | [Format Version](#format-version)           |",
            "| 1              | [Format Flavor](#format-flavor)             |",
            "| 32             | [Message ID](#message-id)                   |",
            "| Variable       | [Encrypt Legend](#encrypt-legend)           |",
            "| Variable       | [Encryption Context](#encryption-context)   |",
            "| Variable       | [Encrypted Data Keys](#encrypted-data-keys) |"
          ],
          "requirements": [
            "cad994b396646f5b"
          ],
          "title": "Partial Header"
        },
        {
          "id": "full-header-value",
          "lines": [
            [
              {
                "annotation_ids": [
                  "9a5088138cc4e5ff",
                  "b2004917078e6211"
                ],
                "status_id": 1,
                "text": "The value of the header MUST be"
              }
            ],
            "",
            "| Length (bytes) | Meaning                                 |",
            "| -------------- | --------------------------------------- |",
            "| Variable       | [Partial Header](#partial-header)       |",
            "| 32             | [Header Commitment](#header-commitment) |"
          ],
          "requirements": [
            "b2004917078e6211"
          ],
          "title": "Full Header Value"
        },
        {
          "id": "format-version",
          "lines": [
            "The message format version dictates the cryptographic algorithms supported",
            "as well as the specific serialized header and footer format.",
            "",
            [
              {
                "annotation_ids": [
                  "9b5792cfa19081a8",
                  "5fcadb002a1603a2"
                ],
                "status_id": 1,
                "text": "The Version MUST be `0x01` or `0x02`."
              }
            ],
            "",
            [
              {
                "annotation_ids": [
                  "6da5cf291c5aae67",
                  "2c25352ab0b7e609"
                ],
                "status_id": 1,
                "text": "If any [Crypto Action](./structures.md#crypto-action) is configured as"
              }
            ],
            [
              {
                "annotation_ids": [
                  "6da5cf291c5aae67",
                  "2c25352ab0b7e609"
                ],
                "status_id": 1,
                "text": "[SIGN_AND_INCLUDE_IN_ENCRYPTION_CONTEXT Crypto Action](./structures.md#sign_and_include_in_encryption_context)"
              }
            ],
            [
              {
                "annotation_ids": [
                  "6da5cf291c5aae67",
                  "2c25352ab0b7e609"
                ],
                "status_id": 1,
                "text": "the Version MUST be 0x02; otherwise, Version MUST be 0x01."
              }
            ]
          ],
          "requirements": [
            "5fcadb002a1603a2",
            "2c25352ab0b7e609",
            "2c25352ab0b7e609",
            "2c25352ab0b7e609"
          ],
          "title": "Format Version"
        },
        {
          "id": "format-flavor",
          "lines": [
            "The flavor dictates the",
            "[algorithm suite](../../submodules/MaterialProviders/aws-encryption-sdk-specification/framework/algorithm-suites.md)",
            "this message is written under.",
            "Specifically, the flavor is stored as a single byte, representing the second byte of the",
            "Algorithm Suite ID; with the first byte assumed to be 0x67.",
            [
              {
                "annotation_ids": [
                  "266667b0ac8bf04a",
                  "8df89c2485d4e1bc"
                ],
                "status_id": 1,
                "text": "The algorithm suite indicated by the flavor MUST be a"
              }
            ],
            [
              {
                "annotation_ids": [
                  "266667b0ac8bf04a",
                  "8df89c2485d4e1bc"
                ],
                "status_id": 1,
                "text": "[DBE supported algorithm suite](../../submodules/MaterialProviders/aws-encryption-sdk-specification/framework/algorithm-suites.md#supported-algorithm-suites-enum)."
              }
            ],
            "",
            "| Value | Algorithm Suite ID | Algorithm Suite Enum                                                 |",
            "| ----- | ------------------ | -------------------------------------------------------------------- |",
            "| 0x00  | 0x67 0x00          | ALG_AES_256_GCM_HKDF_SHA512_COMMIT_KEY_SYMSIG_HMAC_SHA384            |",
            "| 0x01  | 0x67 0x01          | ALG_AES_256_GCM_HKDF_SHA512_COMMIT_KEY_ECDSA_P384_SYMSIG_HMAC_SHA384 |"
          ],
          "requirements": [
            "8df89c2485d4e1bc",
            "8df89c2485d4e1bc"
          ],
          "title": "Format Flavor"
        },
        {
          "id": "message-id",
          "lines": [
            "The Message ID is a random 256-bit value.",
            "",
            [
              {
                "annotation_ids": [
                  "14f88aa7790f194b",
                  "7df2e9a0bff1398d"
                ],
                "status_id": 7,
                "text": "Implementations MUST generate a fresh 256-bit random MessageID, from a cryptographically secure source, for each record encrypted."
              }
            ]
          ],
          "requirements": [
            "7df2e9a0bff1398d"
          ],
          "title": "Message ID"
        },
        {
          "id": "encrypt-legend",
          "lines": [
            "The Encrypt Legend is a serialized description of which authenticated fields in the record were encrypted.",
            "",
            [
              {
                "annotation_ids": [
                  "6075298adb905ba5",
                  "b450a26191066495"
                ],
                "status_id": 1,
                "text": "The Encrypt Legend MUST be serialized as"
              }
            ],
            "",
            "| Field                                         | Length (bytes)                                                                          | Interpreted as    |",
            "| --------------------------------------------- | --------------------------------------------------------------------------------------- | ----------------- |",
            "| Encrypt Legend Length                         | 2                                                                                       | big endian UInt16 |",
            "| [Encrypt Legend Bytes](#encrypt-legend-bytes) | Variable. Equal to the value specified in the previous 2 bytes (Encrypt Legend Length). | Bytes             |"
          ],
          "requirements": [
            "b450a26191066495"
          ],
          "title": "Encrypt Legend"
        },
        {
          "id": "encrypt-legend-bytes",
          "lines": [
            [
              {
                "annotation_ids": [
                  "31b703baa31a5766",
                  "fadd72fd52ef849b"
                ],
                "status_id": 1,
                "text": "Each Crypto Action MUST be encoded as follows"
              }
            ],
            "",
            "- `0x65` (`e` in UTF-8, for \"Encrypt and Sign\") means that a particular field was encrypted",
            "  and included in the signature calculation.",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "  "
              },
              {
                "annotation_ids": [
                  "6c9be8ac70a0b1d6"
                ],
                "status_id": 8,
                "text": "This indicates that this field MUST be attempted to be decrypted during decryption."
              }
            ],
            "- `0x73` (`s` in UTF-8, for \"Sign Only\") means that a particular field was not encrypted,",
            "  but still included in the signature calculation.",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "  "
              },
              {
                "annotation_ids": [
                  "be80a73bde20c7b1"
                ],
                "status_id": 8,
                "text": "This indicates that this field MUST NOT be attempted to be decrypted during decryption."
              }
            ],
            "- `0x63` (`c` in UTF-8, for \"Context\") means that a particular field was not encrypted,",
            "  but still included in the signature calculation,",
            "  as well as being included in the encryption context.",
            "  This indicates that this field MUST NOT be attempted to be decrypted during decryption.",
            "- no entry if the attribute is not signed",
            "",
            [
              {
                "annotation_ids": [
                  "0f97306645f6b74f",
                  "3f35c43b982efe0b",
                  "fb8a8d4535e3016f",
                  "75a70436d806c2d7"
                ],
                "status_id": 16,
                "text": "The Encrypt Legend Bytes MUST be serialized as follows:"
              }
            ],
            "",
            "1. Order every authenticated attribute in the item by the [Canonical Path](#canonical-path)",
            "2. For each authenticated terminal, in order,",
            "   append one of the byte values specified above to indicate whether",
            "   that field should be encrypted.",
            "",
            [
              {
                "annotation_ids": [
                  "947381316b716214",
                  "3086de1720168c76"
                ],
                "status_id": 1,
                "text": "The length of this serialized value (in bytes) MUST equal the number of authenticated fields indicated"
              }
            ],
            [
              {
                "annotation_ids": [
                  "947381316b716214",
                  "3086de1720168c76"
                ],
                "status_id": 1,
                "text": "by the caller's [Authenticate Schema](./structures.md#authenticate-schema)."
              }
            ]
          ],
          "requirements": [
            "fadd72fd52ef849b",
            "6c9be8ac70a0b1d6",
            "be80a73bde20c7b1",
            "75a70436d806c2d7",
            "3086de1720168c76",
            "3086de1720168c76"
          ],
          "title": "Encrypt Legend Bytes"
        },
        {
          "id": "canonical-path",
          "lines": [
            "The canonical path is a unique byte sequence indicating a Terminal within Structured Data.",
            "",
            "All numbers are encoded as a big endian 8 byte values.",
            "",
            [
              {
                "annotation_ids": [
                  "a2af3a135d14c137",
                  "b05f16fa495e018e"
                ],
                "status_id": 1,
                "text": "The canonical path MUST start with the UTF8 encoded table name."
              }
            ],
            "",
            [
              {
                "annotation_ids": [
                  "5e1dda40e91553b6",
                  "c7e3dfe5940e0a5c"
                ],
                "status_id": 1,
                "text": "This MUST be followed by the depth of the Terminal within Structured Data."
              }
            ],
            "",
            [
              {
                "annotation_ids": [
                  "e6adb2c23c1de322",
                  "42eb9be63a8a01a5"
                ],
                "status_id": 1,
                "text": "This MUST be followed by the encoding for each Structured Data in the path, including the Terminal itself."
              }
            ],
            "",
            [
              {
                "annotation_ids": [
                  "7d65def2ca5c7257"
                ],
                "status_id": 8,
                "text": "For Structured Data in Structured Data Lists, this MUST be a 0x23 byte (# in UTF-8),"
              }
            ],
            [
              {
                "annotation_ids": [
                  "7d65def2ca5c7257"
                ],
                "status_id": 8,
                "text": "followed by the numerical index."
              }
            ],
            "",
            [
              {
                "annotation_ids": [
                  "498766996a3602aa",
                  "c5433be135095289"
                ],
                "status_id": 1,
                "text": "For Structured Data in Structured Data Maps, this MUST be a 0x24 byte ($ in UTF-8),"
              }
            ],
            [
              {
                "annotation_ids": [
                  "498766996a3602aa",
                  "c5433be135095289"
                ],
                "status_id": 1,
                "text": "followed by the length of the key, followed by the key as a UTF8 string."
              }
            ]
          ],
          "requirements": [
            "b05f16fa495e018e",
            "c7e3dfe5940e0a5c",
            "42eb9be63a8a01a5",
            "7d65def2ca5c7257",
            "7d65def2ca5c7257",
            "c5433be135095289",
            "c5433be135095289"
          ],
          "title": "Canonical Path"
        },
        {
          "id": "encryption-context",
          "lines": [
            [
              {
                "annotation_ids": [
                  "6f70e653a73cd141",
                  "4a7f9a4b97348c49"
                ],
                "status_id": 1,
                "text": "The Encryption Context MUST be serialized as follows"
              }
            ],
            "",
            "| Field                                             | Length (bytes)                                                       | Interpreted as                                    |",
            "| ------------------------------------------------- | -------------------------------------------------------------------- | ------------------------------------------------- |",
            "| [Key Value Pair Count](#key-value-pair-count)     | 2                                                                    | big endian UInt16                                 |",
            "| [Key Value Pair Entries](#key-value-pair-entries) | Variable. Determined by the count and length of each key-value pair. | [Key Value Pair Entries](#key-value-pair-entries) |"
          ],
          "requirements": [
            "4a7f9a4b97348c49"
          ],
          "title": "Encryption Context"
        },
        {
          "id": "key-value-pair-count",
          "lines": [
            "The number of key-value pairs within the [Key Value Pair Entries](#key-value-pair-entries) field."
          ],
          "title": "Key Value Pair Count"
        },
        {
          "id": "key-value-pair-entries",
          "lines": [
            "A sequence of one or more key-value pair entries.",
            "",
            [
              {
                "annotation_ids": [
                  "cef4c25a28db6ed0",
                  "7392973622c18198",
                  "beb3e52b1ac8430b"
                ],
                "status_id": 4,
                "text": "This sequence MUST NOT contain duplicate entries."
              }
            ],
            "",
            [
              {
                "annotation_ids": [
                  "0c0f243de61b24cd",
                  "7985e75f1b3bab45",
                  "bcff825ee1676a6c",
                  "4d8f403c1cdc34cd"
                ],
                "status_id": 4,
                "text": "These entries MUST have entries sorted, by key,"
              }
            ],
            [
              {
                "annotation_ids": [
                  "0c0f243de61b24cd",
                  "7985e75f1b3bab45",
                  "bcff825ee1676a6c",
                  "4d8f403c1cdc34cd"
                ],
                "status_id": 4,
                "text": "in ascending order according to the UTF-8 encoded binary value."
              }
            ],
            "",
            [
              {
                "annotation_ids": [
                  "e4eb744b63681a70",
                  "c78310adc79da639"
                ],
                "status_id": 1,
                "text": "Each Key Value Pair MUST be serialized as follows"
              }
            ],
            "",
            "| Field        | Length (bytes)                                                                 | Interpreted as      |",
            "| ------------ | ------------------------------------------------------------------------------ | ------------------- |",
            "| Key Length   | 2                                                                              | big endian UInt16   |",
            "| Key          | Variable. Equal to the value specified in the previous 2 bytes (Key Length).   | UTF-8 encoded bytes |",
            "| Value Length | 2                                                                              | big endian UInt16   |",
            "| Value        | Variable. Equal to the value specified in the previous 2 bytes (Value Length). | UTF-8 encoded bytes |"
          ],
          "requirements": [
            "beb3e52b1ac8430b",
            "4d8f403c1cdc34cd",
            "4d8f403c1cdc34cd",
            "c78310adc79da639"
          ],
          "title": "Key Value Pair Entries"
        },
        {
          "id": "encrypted-data-keys",
          "lines": [
            [
              {
                "annotation_ids": [
                  "4f6cadf3bc73e8a0",
                  "71968b14b22f246e"
                ],
                "status_id": 1,
                "text": "The Encrypted Data Keys MUST be serialized as follows"
              }
            ],
            "",
            "| Field                                                     | Length (bytes)                                                       | Interpreted as                                            |",
            "| --------------------------------------------------------- | -------------------------------------------------------------------- | --------------------------------------------------------- |",
            "| [Encrypted Data Key Count](#encrypted-data-key-count)     | 1                                                                    | unsigned 8 bit number                                     |",
            "| [Encrypted Data Key Entries](#encrypted-data-key-entries) | Variable. Determined by the count and length of each key-value pair. | [Encrypted Data Key Entries](#encrypted-data-key-entries) |"
          ],
          "requirements": [
            "71968b14b22f246e"
          ],
          "title": "Encrypted Data Keys"
        },
        {
          "id": "encrypted-data-key-count",
          "lines": [
            "The number of encrypted data keys.",
            [
              {
                "annotation_ids": [
                  "0bfe516a1bf08ae7",
                  "069fcf81874edda6"
                ],
                "status_id": 1,
                "text": "This value MUST be greater than 0."
              }
            ]
          ],
          "requirements": [
            "069fcf81874edda6"
          ],
          "title": "Encrypted Data Key Count"
        },
        {
          "id": "encrypted-data-key-entries",
          "lines": [
            [
              {
                "annotation_ids": [
                  "4e6295361cdd6182",
                  "d25a2a4995297786"
                ],
                "status_id": 1,
                "text": "Each Encrypted Data Key MUST be serialized as follows"
              }
            ],
            "",
            "| Field                                                               | Length (bytes)                                                                                    | Interpreted as      |",
            "| ------------------------------------------------------------------- | ------------------------------------------------------------------------------------------------- | ------------------- |",
            "| [Key Provider ID Length](#key-provider-id-length)                   | 2                                                                                                 | big endian UInt16   |",
            "| [Key Provider ID](#key-provider-id)                                 | Variable. Equal to the value specified in the previous 2 bytes (Key Provider ID Length).          | UTF-8 encoded bytes |",
            "| [Key Provider Information Length](#key-provider-information-length) | 2                                                                                                 | big endian UInt16   |",
            "| [Key Provider Information](#key-provider-information)               | Variable. Equal to the value specified in the previous 2 bytes (Key Provider Information Length). | Bytes               |",
            "| [Encrypted Data Key Length](#encrypted-data-key-length)             | 2                                                                                                 | big endian UInt16   |",
            "| [Encrypted Data Key](#encrypted-data-key)                           | Variable. Equal to the value specified in the previous 2 bytes (Encrypted Data Key Length).       | Bytes               |"
          ],
          "requirements": [
            "d25a2a4995297786"
          ],
          "title": "Encrypted Data Key Entries"
        },
        {
          "id": "key-provider-id-length",
          "lines": [
            "The length of the key provider ID."
          ],
          "title": "Key Provider ID Length"
        },
        {
          "id": "key-provider-id",
          "lines": [
            "The key provider ID."
          ],
          "title": "Key Provider ID"
        },
        {
          "id": "key-provider-information-length",
          "lines": [
            "The length of the key provider information."
          ],
          "title": "Key Provider Information Length"
        },
        {
          "id": "key-provider-information",
          "lines": [
            "The key provider information."
          ],
          "title": "Key Provider Information"
        },
        {
          "id": "encrypted-data-key-length",
          "lines": [
            "The length of the encrypted data key."
          ],
          "title": "Encrypted Data Key Length"
        },
        {
          "id": "encrypted-data-key",
          "lines": [
            "The encrypted data key.",
            "It is the data key encrypted by the key provider."
          ],
          "title": "Encrypted Data Key"
        },
        {
          "id": "header-commitment",
          "lines": [],
          "title": "Header Commitment"
        },
        {
          "id": "commit-key",
          "lines": [
            [
              {
                "annotation_ids": [
                  "54fa98ff58a43352",
                  "fc5f15084383cc1d"
                ],
                "status_id": 1,
                "text": "The HKDF used to calculate the Commitment Key MUST be the"
              }
            ],
            [
              {
                "annotation_ids": [
                  "54fa98ff58a43352",
                  "fc5f15084383cc1d"
                ],
                "status_id": 1,
                "text": "[Commit Key KDF](../../submodules/MaterialProviders/aws-encryption-sdk-specification/framework/algorithm-suites.md#algorithm-suites-commit-key-derivation-settings)"
              }
            ],
            [
              {
                "annotation_ids": [
                  "54fa98ff58a43352",
                  "fc5f15084383cc1d"
                ],
                "status_id": 1,
                "text": "indicated by the algorithm suite."
              }
            ],
            "",
            [
              {
                "annotation_ids": [
                  "8ae7b05d1df22ea7",
                  "0606528f257a8da6"
                ],
                "status_id": 1,
                "text": "The calculated Commitment Key MUST have length equal to the"
              }
            ],
            [
              {
                "annotation_ids": [
                  "8ae7b05d1df22ea7",
                  "0606528f257a8da6"
                ],
                "status_id": 1,
                "text": "[algorithm suite's encryption key length](../../submodules/MaterialProviders/aws-encryption-sdk-specification/framework/algorithm-suites.md#algorithm-suites-encryption-settings)."
              }
            ],
            "",
            [
              {
                "annotation_ids": [
                  "29402852a82cf42e",
                  "a67615a5225cfc09"
                ],
                "status_id": 1,
                "text": "The `info` used for the HKDF function MUST be"
              }
            ],
            [
              {
                "annotation_ids": [
                  "29402852a82cf42e",
                  "a67615a5225cfc09"
                ],
                "status_id": 1,
                "text": "| Field | Length |"
              }
            ],
            [
              {
                "annotation_ids": [
                  "29402852a82cf42e",
                  "a67615a5225cfc09"
                ],
                "status_id": 1,
                "text": "| -------------------- | -------- |"
              }
            ],
            [
              {
                "annotation_ids": [
                  "29402852a82cf42e",
                  "a67615a5225cfc09"
                ],
                "status_id": 1,
                "text": "| \"AWS_DBE_COMMIT_KEY\" | 18 |"
              }
            ],
            [
              {
                "annotation_ids": [
                  "29402852a82cf42e",
                  "a67615a5225cfc09"
                ],
                "status_id": 1,
                "text": "| Message ID | 32 |"
              }
            ],
            "",
            [
              {
                "annotation_ids": [
                  "22fcfc386ce8b542",
                  "66440a37db3c766a"
                ],
                "status_id": 1,
                "text": "The HKDF calculation MUST use a supplied key, no salt, and an `info` as described above."
              }
            ],
            "",
            [
              {
                "annotation_ids": [
                  "f457a10951d1ec11",
                  "5983893fdb05995b"
                ],
                "status_id": 7,
                "text": "The commit key calculation described above MUST be performed with the record's plaintext data key"
              }
            ],
            [
              {
                "annotation_ids": [
                  "f457a10951d1ec11",
                  "5983893fdb05995b"
                ],
                "status_id": 7,
                "text": "and the header's message id."
              }
            ]
          ],
          "requirements": [
            "fc5f15084383cc1d",
            "fc5f15084383cc1d",
            "fc5f15084383cc1d",
            "0606528f257a8da6",
            "0606528f257a8da6",
            "a67615a5225cfc09",
            "a67615a5225cfc09",
            "a67615a5225cfc09",
            "a67615a5225cfc09",
            "a67615a5225cfc09",
            "66440a37db3c766a",
            "5983893fdb05995b",
            "5983893fdb05995b"
          ],
          "title": "Commit Key"
        },
        {
          "id": "commitment-calculation",
          "lines": [
            [
              {
                "annotation_ids": [
                  "ef9bd800bc8d4e69",
                  "0dd06662921141fe"
                ],
                "status_id": 1,
                "text": "The Header Commitment MUST be calculated as a the first 32 bytes of an HmacSha384,"
              }
            ],
            [
              {
                "annotation_ids": [
                  "ef9bd800bc8d4e69",
                  "0dd06662921141fe"
                ],
                "status_id": 1,
                "text": "with the serialized partial header as the message, and the Commit Key as the key."
              }
            ],
            "For example",
            "",
            "```python",
            "def GetHeaderCommitment(Header, CommitKey):",
            "    # Truncate to 256 bits (32 bytes; returning only the leftmost bits)",
            "    return HmacSha384(Header, CommitKey)[0:32]",
            "",
            "def CheckHeaderCommitment(Header, CommitKey):",
            "    Commitment = Header[-32:32]  # Last 32 bytes of the header",
            "    Preceding = Header[:-32]     # Everything before the Header Commitment",
            "    return ConstantTimeEquals(Commitment, GetHeaderCommitment(Preceding, CommitKey)",
            "```"
          ],
          "requirements": [
            "0dd06662921141fe",
            "0dd06662921141fe"
          ],
          "title": "Commitment Calculation"
        },
        {
          "id": "commitment-verification",
          "lines": [
            "To verify a header, recalculate the [Header Commitment](#header-commitment) and",
            "compare it to the stored [Header Commitment](#header-commitment).",
            "",
            [
              {
                "annotation_ids": [
                  "5e5bd7bae1024a3b",
                  "d9cb52f4e758426d"
                ],
                "status_id": 1,
                "text": "Header commitment comparisons MUST be constant time operations."
              }
            ]
          ],
          "requirements": [
            "d9cb52f4e758426d"
          ],
          "title": "Commitment Verification"
        },
        {
          "id": "notes",
          "lines": [
            "While the Header Commitment does",
            "produce a distinct 256-bit hash output per header and commitment key,",
            "it does not provide any integrity guarantees over the encrypted attributes.",
            "Integrity over the encrypted attributes is ensured by the signatures in the",
            "[footer](footer.md)."
          ],
          "title": "Notes"
        }
      ],
      "title": "Structured Encryption Header"
    },
    "specification/structured-encryption/resolve-auth-actions.md": {
      "format": "markdown",
      "sections": [
        {
          "id": "resolve-auth-actions",
          "lines": [],
          "title": "Resolve Auth Actions"
        },
        {
          "id": "version",
          "lines": [
            "1.0.0"
          ],
          "title": "Version"
        },
        {
          "id": "changelog",
          "lines": [
            "- 1.0.0",
            "",
            "  - Initial record"
          ],
          "title": "Changelog"
        },
        {
          "id": "definitions",
          "lines": [],
          "title": "Definitions"
        },
        {
          "id": "conventions-used-in-this-document",
          "lines": [
            "The key words \"MUST\", \"MUST NOT\", \"REQUIRED\", \"SHALL\", \"SHALL NOT\", \"SHOULD\", \"SHOULD NOT\", \"RECOMMENDED\", \"MAY\", and \"OPTIONAL\"",
            "in this document are to be interpreted as described in [RFC 2119](https://tools.ietf.org/html/rfc2119)."
          ],
          "title": "Conventions used in this document"
        },
        {
          "id": "overview",
          "lines": [
            "ResolveAuthActions takes an encrypted record and determines the CryptoActions originally used for encryption.",
            "",
            "It makes no network calls and does no encryption nor decryption."
          ],
          "title": "Overview"
        },
        {
          "id": "input",
          "lines": [
            [
              {
                "annotation_ids": [
                  "98817e3cb4b3cac6",
                  "8b61216c44d0756d"
                ],
                "status_id": 1,
                "text": "The following inputs to this behavior are REQUIRED:"
              }
            ],
            "",
            [
              {
                "annotation_ids": [
                  "98817e3cb4b3cac6"
                ],
                "status_id": 2,
                "text": "- [Table Name](#table-name)"
              }
            ],
            [
              {
                "annotation_ids": [
                  "98817e3cb4b3cac6"
                ],
                "status_id": 2,
                "text": "- [Auth List](#auth-list)"
              }
            ],
            [
              {
                "annotation_ids": [
                  "98817e3cb4b3cac6"
                ],
                "status_id": 2,
                "text": "- [Header Bytes](#header-bytes)"
              }
            ]
          ],
          "requirements": [
            "8b61216c44d0756d"
          ],
          "title": "Input"
        },
        {
          "id": "table-name",
          "lines": [
            "The logical name for the structure.",
            "This can be the same as the physical name.",
            "For example the name of the table to hold the encrypted record."
          ],
          "title": "Table Name"
        },
        {
          "id": "auth-list",
          "lines": [
            "The [Auth List](./structures.md#auth-list) describes how each [Terminal Data](./structures.md#terminal-data) would be treated during decryption.",
            "",
            "The header and footer fields (aws_dbe_head and aws_dbe_foot) can be present, but they need not be present.",
            "",
            "Data members need not contain any particular values."
          ],
          "title": "Auth List"
        },
        {
          "id": "header-bytes",
          "lines": [
            "The sequence of bytes representing the serialized header, as is usually found in the `aws_dbe_head` attribute."
          ],
          "title": "Header Bytes"
        },
        {
          "id": "output",
          "lines": [
            [
              {
                "annotation_ids": [
                  "d452b994d3eb6ea2",
                  "60cc39e0da8e0695"
                ],
                "status_id": 1,
                "text": "This operation MUST output the following:"
              }
            ],
            "",
            [
              {
                "annotation_ids": [
                  "d452b994d3eb6ea2"
                ],
                "status_id": 2,
                "text": "[Crypto List](./structures.md#crypto-list): Input terminal data and the Crypto Schema for each Terminal,"
              }
            ],
            [
              {
                "annotation_ids": [
                  "d452b994d3eb6ea2"
                ],
                "status_id": 2,
                "text": "calculated using the Crypto Legend in the header, the signature scope used for decryption, and the data in the input structure."
              }
            ]
          ],
          "requirements": [
            "60cc39e0da8e0695"
          ],
          "title": "Output"
        },
        {
          "id": "behavior",
          "lines": [
            "Resolve Auth Actions examines the configuration and the provided header to determine",
            "the [Crypto Actions](structures.md#crypto-action) originally use for encryption.",
            "",
            "The data members are returned unchanged and unexamined."
          ],
          "title": "Behavior"
        }
      ],
      "title": "Resolve Auth Actions"
    },
    "specification/structured-encryption/structures.md": {
      "format": "markdown",
      "sections": [
        {
          "id": "structures",
          "lines": [],
          "title": "Structures"
        },
        {
          "id": "version",
          "lines": [
            "1.1.0"
          ],
          "title": "Version"
        },
        {
          "id": "changelog",
          "lines": [
            "- 1.1.0",
            "",
            "  - Update for simplified structured encryption",
            "",
            "- 1.0.0",
            "  - Initial record"
          ],
          "title": "Changelog"
        },
        {
          "id": "definitions",
          "lines": [],
          "title": "Definitions"
        },
        {
          "id": "conventions-used-in-this-document",
          "lines": [
            "The key words \"MUST\", \"MUST NOT\", \"REQUIRED\", \"SHALL\", \"SHALL NOT\", \"SHOULD\", \"SHOULD NOT\", \"RECOMMENDED\", \"MAY\", and \"OPTIONAL\"",
            "in this document are to be interpreted as described in [RFC 2119](https://tools.ietf.org/html/rfc2119)."
          ],
          "title": "Conventions used in this document"
        },
        {
          "id": "overview",
          "lines": [
            "This document includes the specifications for common structures referenced throughout the",
            "Structured Encryption Library specification.",
            [
              {
                "annotation_ids": [
                  "7e420c23c7f31870"
                ],
                "status_id": 8,
                "text": "These structures define a group of related fields that MUST hold certain properties."
              }
            ],
            [
              {
                "annotation_ids": [
                  "d89abcb1cc365cfa"
                ],
                "status_id": 8,
                "text": "Wherever these structures are referenced in this specification,"
              }
            ],
            [
              {
                "annotation_ids": [
                  "d89abcb1cc365cfa"
                ],
                "status_id": 8,
                "text": "implementations MUST ensure that all properties of a structure's fields are upheld."
              }
            ],
            "",
            "Note that this specification does not specify how these structures should be represented or passed",
            "throughout the Structured Encryption Library.",
            [
              {
                "annotation_ids": [
                  "e2462cb99ef90474"
                ],
                "status_id": 10,
                "text": "While these structures will usually be represented as objects, lower level languages MAY represent"
              }
            ],
            [
              {
                "annotation_ids": [
                  "e2462cb99ef90474"
                ],
                "status_id": 10,
                "text": "these fields in a less strictly defined way as long as all field properties are still upheld."
              }
            ],
            "",
            "Structures defined in this document:",
            "",
            "- [Authenticate Action](#authenticate-action)",
            "- [Authenticate Schema](#authenticate-schema)",
            "- [Crypto Action](#crypto-action)",
            "- [Crypto Schema](#crypto-schema)",
            "- [Encrypt Action](#encrypt-action)",
            "- [Encryption Context](#encryption-context)",
            "- [Structured Data](#structured-data)",
            "- [Terminal Data](#terminal-data)",
            "- [Path Segment](#path-segment)",
            "- [Path](#path)",
            "- [Crypto Item](#crypto-item)",
            "- [Crypto List](#crypto-list)",
            "- [Auth Item](#auth-item)",
            "- [Auth List](#auth-list)"
          ],
          "requirements": [
            "7e420c23c7f31870",
            "d89abcb1cc365cfa",
            "d89abcb1cc365cfa",
            "e2462cb99ef90474",
            "e2462cb99ef90474"
          ],
          "title": "Overview"
        },
        {
          "id": "authenticate-action",
          "lines": [
            "An Authenticate Action describes whether a particular [Terminal Data](#terminal-data)",
            "is or is not authenticated during the Encrypt Structure and Decrypt Structure operations."
          ],
          "title": "Authenticate Action"
        },
        {
          "id": "supported-authenticate-actions",
          "lines": [],
          "title": "Supported Authenticate Actions"
        },
        {
          "id": "sign",
          "lines": [
            [
              {
                "annotation_ids": [
                  "93e23f479f564c04"
                ],
                "status_id": 8,
                "text": "During [Encrypt Structure](./encrypt-structure.md),"
              }
            ],
            [
              {
                "annotation_ids": [
                  "93e23f479f564c04"
                ],
                "status_id": 8,
                "text": "SIGN signifies that the [Terminal Data](#terminal-data) MUST be included in the signature calculations"
              }
            ],
            [
              {
                "annotation_ids": [
                  "93e23f479f564c04"
                ],
                "status_id": 8,
                "text": "on the footer."
              }
            ],
            "",
            [
              {
                "annotation_ids": [
                  "af7644c856c01c55"
                ],
                "status_id": 8,
                "text": "During [Decrypt Structure](./decrypt-structure.md),"
              }
            ],
            [
              {
                "annotation_ids": [
                  "af7644c856c01c55"
                ],
                "status_id": 8,
                "text": "SIGN signifies that the [Terminal Data](#terminal-data) MUST be authenticated,"
              }
            ],
            [
              {
                "annotation_ids": [
                  "af7644c856c01c55"
                ],
                "status_id": 8,
                "text": "and thus be included in the verification of the signatures on the footer."
              }
            ]
          ],
          "requirements": [
            "93e23f479f564c04",
            "93e23f479f564c04",
            "93e23f479f564c04",
            "af7644c856c01c55",
            "af7644c856c01c55",
            "af7644c856c01c55"
          ],
          "title": "SIGN"
        },
        {
          "id": "do-not-sign",
          "lines": [
            [
              {
                "annotation_ids": [
                  "1f38a4f677e18354"
                ],
                "status_id": 8,
                "text": "During [Encrypt Structure](./encrypt-structure.md),"
              }
            ],
            [
              {
                "annotation_ids": [
                  "1f38a4f677e18354"
                ],
                "status_id": 8,
                "text": "DO_NOT_SIGN signifies that the [Terminal Data](#terminal-data) MUST NOT be included in the signature calculations"
              }
            ],
            [
              {
                "annotation_ids": [
                  "1f38a4f677e18354"
                ],
                "status_id": 8,
                "text": "on the footer."
              }
            ],
            "",
            [
              {
                "annotation_ids": [
                  "9cf3c9d3448280e5"
                ],
                "status_id": 8,
                "text": "During [Decrypt Structure](./decrypt-structure.md),"
              }
            ],
            [
              {
                "annotation_ids": [
                  "9cf3c9d3448280e5"
                ],
                "status_id": 8,
                "text": "DO_NOT_SIGN signifies that the [Terminal Data](#terminal-data) MUST NOT be authenticated,"
              }
            ],
            [
              {
                "annotation_ids": [
                  "9cf3c9d3448280e5"
                ],
                "status_id": 8,
                "text": "and thus not be included in the verification of the signatures on the footer."
              }
            ]
          ],
          "requirements": [
            "1f38a4f677e18354",
            "1f38a4f677e18354",
            "1f38a4f677e18354",
            "9cf3c9d3448280e5",
            "9cf3c9d3448280e5",
            "9cf3c9d3448280e5"
          ],
          "title": "DO_NOT_SIGN"
        },
        {
          "id": "authenticate-schema",
          "lines": [
            "The Authentication Schema maps a [Authenticate Action](#authenticate-action) to each [Terminal Data](#terminal-data)",
            "within a [Structured Data](#structured-data),",
            "based on that Terminal Data's location within the Structured Data."
          ],
          "title": "Authenticate Schema"
        },
        {
          "id": "crypto-action",
          "lines": [
            "A Crypto Action is a supported [Authenticate Action](#authenticate-action) and [Encrypt Action](#encrypt-action) pair."
          ],
          "title": "Crypto Action"
        },
        {
          "id": "supported-crypto-actions",
          "lines": [],
          "title": "Supported Crypto Actions"
        },
        {
          "id": "encrypt-and-sign",
          "lines": [
            "ENCRYPT_AND_SIGN indicates that the following actions apply to a [Terminal Data](#terminal-data):",
            "",
            "- [ENCRYPT](#encrypt)",
            "- [SIGN](#sign)"
          ],
          "title": "ENCRYPT_AND_SIGN"
        },
        {
          "id": "sign-only",
          "lines": [
            "SIGN_ONLY indicates that the following actions apply to a [Terminal Data](#terminal-data):",
            "",
            "- [DO_NOT_ENCRYPT](#do_not_encrypt)",
            "- [SIGN](#sign)"
          ],
          "title": "SIGN_ONLY"
        },
        {
          "id": "sign-and-include-in-encryption-context",
          "lines": [
            "SIGN_AND_INCLUDE_IN_ENCRYPTION_CONTEXT indicates that the following actions apply to a [Terminal Data](#terminal-data):",
            "",
            "- [DO_NOT_ENCRYPT](#do_not_encrypt)",
            "- [SIGN](#sign)",
            "",
            [
              {
                "annotation_ids": [
                  "fb33103ec14ac672"
                ],
                "status_id": 8,
                "text": "and further that the [Terminal Data](#terminal-data) MUST be included in the encryption context."
              }
            ]
          ],
          "requirements": [
            "fb33103ec14ac672"
          ],
          "title": "SIGN_AND_INCLUDE_IN_ENCRYPTION_CONTEXT"
        },
        {
          "id": "do-nothing",
          "lines": [
            "DO_NOTHING indicates that the following actions apply to a [Terminal Data](#terminal-data):",
            "",
            "- [DO_NOT_ENCRYPT](#do_not_encrypt)",
            "- [DO_NOT_SIGN](#do_not_sign)"
          ],
          "title": "DO_NOTHING"
        },
        {
          "id": "crypto-schema",
          "lines": [
            "The Crypto Schema maps a [Crypto Action](#authenticate-action) to each [Terminal Data](#terminal-data)",
            "within a [Structured Data](#structured-data),",
            "based on that Terminal Data's location within the Structured Data."
          ],
          "title": "Crypto Schema"
        },
        {
          "id": "encrypt-action",
          "lines": [
            "An Encrypt Action describes whether a particular [Terminal Data](#terminal-data)",
            "is or is not encrypted and decrypted during the Encrypt Structure and Decrypt Structure operations."
          ],
          "title": "Encrypt Action"
        },
        {
          "id": "supported-encrypt-actions",
          "lines": [],
          "title": "Supported Encrypt Actions"
        },
        {
          "id": "encrypt",
          "lines": [
            [
              {
                "annotation_ids": [
                  "a2ac6849747a0a4c"
                ],
                "status_id": 8,
                "text": "During [Encrypt Structure](encrypt-structure.md#encrypt-structure),"
              }
            ],
            [
              {
                "annotation_ids": [
                  "a2ac6849747a0a4c"
                ],
                "status_id": 8,
                "text": "ENCRYPT signifies that the [Terminal Value](#terminal-value) in the [Terminal Data](#terminal-data)"
              }
            ],
            [
              {
                "annotation_ids": [
                  "a2ac6849747a0a4c"
                ],
                "status_id": 8,
                "text": "MUST be encrypted in the resulting encrypted [Structured Data](#structured-data)."
              }
            ],
            "",
            [
              {
                "annotation_ids": [
                  "48b5b60e786aeddd"
                ],
                "status_id": 8,
                "text": "During [Decrypt Structure](decrypt-structure.md#decrypt-structure),"
              }
            ],
            [
              {
                "annotation_ids": [
                  "48b5b60e786aeddd"
                ],
                "status_id": 8,
                "text": "ENCRYPT signifies that the [Terminal Value](#terminal-value) in the [Terminal Data](#terminal-data)"
              }
            ],
            [
              {
                "annotation_ids": [
                  "48b5b60e786aeddd"
                ],
                "status_id": 8,
                "text": "MUST be attempted to be decrypted."
              }
            ]
          ],
          "requirements": [
            "a2ac6849747a0a4c",
            "a2ac6849747a0a4c",
            "a2ac6849747a0a4c",
            "48b5b60e786aeddd",
            "48b5b60e786aeddd",
            "48b5b60e786aeddd"
          ],
          "title": "ENCRYPT"
        },
        {
          "id": "do-not-encrypt",
          "lines": [
            [
              {
                "annotation_ids": [
                  "67bdc347b6017b1c"
                ],
                "status_id": 8,
                "text": "During [Encrypt Structure](encrypt-structure.md#encrypt-structure)"
              }
            ],
            [
              {
                "annotation_ids": [
                  "67bdc347b6017b1c"
                ],
                "status_id": 8,
                "text": "and [Decrypt Structure](decrypt-structure.md#decrypt-structure),"
              }
            ],
            [
              {
                "annotation_ids": [
                  "67bdc347b6017b1c"
                ],
                "status_id": 8,
                "text": "DO_NOT_ENCRYPT signifies that the [Terminal Data](#terminal-data)"
              }
            ],
            [
              {
                "annotation_ids": [
                  "67bdc347b6017b1c"
                ],
                "status_id": 8,
                "text": "MUST have an equal [Terminal Value](#terminal-value) and"
              }
            ],
            [
              {
                "annotation_ids": [
                  "67bdc347b6017b1c"
                ],
                "status_id": 8,
                "text": "[Terminal Type Id](#terminal-type-id) as the the Terminal Data"
              }
            ],
            [
              {
                "annotation_ids": [
                  "67bdc347b6017b1c"
                ],
                "status_id": 8,
                "text": "in the same location in the resulting encrypted [Structured Data](#structured-data)."
              }
            ],
            "No encryption or decryption is performed on the Terminal Data."
          ],
          "requirements": [
            "67bdc347b6017b1c",
            "67bdc347b6017b1c",
            "67bdc347b6017b1c",
            "67bdc347b6017b1c",
            "67bdc347b6017b1c",
            "67bdc347b6017b1c"
          ],
          "title": "DO_NOT_ENCRYPT"
        },
        {
          "id": "encryption-context",
          "lines": [
            "[The Encryption Context as defined by the Material Providers Library specification.](https://github.com/awslabs/private-aws-encryption-sdk-specification-staging/blob/master/framework/structures.md#encryption-context)"
          ],
          "title": "Encryption Context"
        },
        {
          "id": "structured-data",
          "lines": [
            "Structured Data is intended to support",
            "the expression of most [JSON](https://datatracker.ietf.org/doc/html/rfc7159) and [XML](https://www.w3.org/TR/xml/) data.",
            "",
            "Structured Data is expressed as a [Structured Data Map](#structured-data-map)"
          ],
          "title": "Structured Data"
        },
        {
          "id": "structured-data-map",
          "lines": [
            [
              {
                "annotation_ids": [
                  "5bb7fe55485c1314",
                  "d12221367e86fac9"
                ],
                "status_id": 1,
                "text": "A Structured Data Map MUST consist of:"
              }
            ],
            "",
            "- A map strings to [Terminal Data](#terminal-data)",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "  "
              },
              {
                "annotation_ids": [
                  "4a4a3f418bf2e318",
                  "d4086c9851d01c23"
                ],
                "status_id": 1,
                "text": "- This map MUST NOT allow duplicate key values"
              }
            ]
          ],
          "requirements": [
            "d12221367e86fac9",
            "d4086c9851d01c23"
          ],
          "title": "Structured Data Map"
        },
        {
          "id": "terminal-data",
          "lines": [
            "Terminal Data is a structure that contains:",
            "",
            "- Terminal Type ID",
            "- Terminal Value"
          ],
          "title": "Terminal Data"
        },
        {
          "id": "terminal-type-id",
          "lines": [
            [
              {
                "annotation_ids": [
                  "5743967f50ddfaea",
                  "5f0f2585bf1d7fdb"
                ],
                "status_id": 1,
                "text": "A Terminal Type ID MUST be a 2 byte value that is used to identify how callers interpret [Terminal Value](#terminal-value)."
              }
            ],
            "",
            [
              {
                "annotation_ids": [
                  "36f61203ed365ab4"
                ],
                "status_id": 8,
                "text": "If [Terminal Value](#terminal-value) is to be interpreted as raw bytes,"
              }
            ],
            [
              {
                "annotation_ids": [
                  "36f61203ed365ab4"
                ],
                "status_id": 8,
                "text": "the Terminal Type ID MUST be 0xFFFF."
              }
            ],
            [
              {
                "annotation_ids": [
                  "e0c6cbbd736cae7d"
                ],
                "status_id": 8,
                "text": "Any other value prefixed by 0xFF is reserved and MUST NOT be used."
              }
            ],
            "",
            "It is the responsibility of the caller to define and maintain a mapping of Terminal Type IDs (including 0xFFFF) to specific types",
            "and how those types should be serialized and deserialized."
          ],
          "requirements": [
            "5f0f2585bf1d7fdb",
            "36f61203ed365ab4",
            "36f61203ed365ab4",
            "e0c6cbbd736cae7d"
          ],
          "title": "Terminal Type ID"
        },
        {
          "id": "terminal-value",
          "lines": [
            [
              {
                "annotation_ids": [
                  "821d73070a16fdb6",
                  "ea8be5898a02bba2"
                ],
                "status_id": 1,
                "text": "Terminal Value MUST be a sequence of bytes, and MAY be empty (zero-length)."
              }
            ],
            "",
            [
              {
                "annotation_ids": [
                  "8edf04a85665558f"
                ],
                "status_id": 8,
                "text": "If these bytes are to be deserialized, these bytes MUST be interpreted as the type indicated in this Terminal Data's [Terminal Type ID](#terminal-type-id).D"
              }
            ]
          ],
          "requirements": [
            "ea8be5898a02bba2",
            "8edf04a85665558f"
          ],
          "title": "Terminal Value"
        },
        {
          "id": "path-segment",
          "lines": [
            [
              {
                "annotation_ids": [
                  "1de955988676a2f1",
                  "25147dc970d5974b"
                ],
                "status_id": 1,
                "text": "A path segment MUST be a string, designating the name of a member of a structure."
              }
            ],
            "",
            "In the future, a path segment might also refer to an index into a list, or to an attribute name."
          ],
          "requirements": [
            "25147dc970d5974b"
          ],
          "title": "Path Segment"
        },
        {
          "id": "path",
          "lines": [
            "A path is a sequence of [path segments](#path-segment) that refer to a location within a structure."
          ],
          "title": "Path"
        },
        {
          "id": "crypto-item",
          "lines": [
            [
              {
                "annotation_ids": [
                  "88691558546ce1e0",
                  "3441001d54352016"
                ],
                "status_id": 1,
                "text": "A crypto item MUST consist of"
              }
            ],
            "",
            [
              {
                "annotation_ids": [
                  "88691558546ce1e0"
                ],
                "status_id": 2,
                "text": "- a [Path](#path)"
              }
            ],
            [
              {
                "annotation_ids": [
                  "88691558546ce1e0"
                ],
                "status_id": 2,
                "text": "- a [Crypto Action](#crypto-action)"
              }
            ],
            [
              {
                "annotation_ids": [
                  "88691558546ce1e0"
                ],
                "status_id": 2,
                "text": "- a [Terminal Data](#terminal-data)"
              }
            ],
            "",
            "and indicates that this data exists at this location, and should be handled with this action."
          ],
          "requirements": [
            "3441001d54352016"
          ],
          "title": "Crypto Item"
        },
        {
          "id": "crypto-list",
          "lines": [
            [
              {
                "annotation_ids": [
                  "e682ff7866e8b33c",
                  "e95c58faef13cbbc"
                ],
                "status_id": 1,
                "text": "A crypto list MUST be a sequence of [crypto item](#crypto-item)"
              }
            ]
          ],
          "requirements": [
            "e95c58faef13cbbc"
          ],
          "title": "Crypto List"
        },
        {
          "id": "auth-item",
          "lines": [
            [
              {
                "annotation_ids": [
                  "26cc1058bdd746e0",
                  "00edab0e92a5e5c3"
                ],
                "status_id": 1,
                "text": "An auth item MUST consist of"
              }
            ],
            "",
            [
              {
                "annotation_ids": [
                  "26cc1058bdd746e0"
                ],
                "status_id": 2,
                "text": "- a [Path](#path)"
              }
            ],
            [
              {
                "annotation_ids": [
                  "26cc1058bdd746e0"
                ],
                "status_id": 2,
                "text": "- an [Authenticate Action](#authenticate-action)"
              }
            ],
            [
              {
                "annotation_ids": [
                  "26cc1058bdd746e0"
                ],
                "status_id": 2,
                "text": "- a [Terminal Data](#terminal-data)"
              }
            ],
            "",
            "and indicates that this data exists at this location, and should be handled with this action."
          ],
          "requirements": [
            "00edab0e92a5e5c3"
          ],
          "title": "Auth Item"
        },
        {
          "id": "auth-list",
          "lines": [
            [
              {
                "annotation_ids": [
                  "84e5fa78d053183c",
                  "bf8ad16938929be3"
                ],
                "status_id": 1,
                "text": "An auth list MUST be a sequence of [auth item](#auth-item)"
              }
            ]
          ],
          "requirements": [
            "bf8ad16938929be3"
          ],
          "title": "Auth List"
        }
      ],
      "title": "Structures"
    }
  },
  "version": "2.0"
}
