    },
    {
      "comment": "When mapping [DynamoDB Table Names](#dynamodb-table-name) to [logical table name](#logical-table-name)\nthere MUST a one to one mapping between the two.\n",
      "id": "fbbe120ab833f53a",
      "level": "Must",
      "line": 18,
      "quote": "When mapping [DynamoDB Table Names](#dynamodb-table-name) to [logical table name](#logical-table-name) there MUST a one to one mapping between the two.",
      "source": "compliance/specification/dynamodb-encryption-client/ddb-table-encryption-config/logical-table-name.toml",
      "target_path": "specification/dynamodb-encryption-client/ddb-table-encryption-config.md",
      "target_section": "logical-table-name",
      "type": "SPEC"
    },
    {
      "comment": "If not specified, encryption and decryption MUST behave according to `FORBID_PLAINTEXT_WRITE_FORBID_PLAINTEXT_READ`.\n",
      "id": "68b4233f6a5b2906",
      "level": "Must",
