    },
    {
      "id": "04b6b66d85e91b18",
      "level": "Auto",
      "line": 1094,
      "quote": "This operation MUST create a [Required Encryption Context CMM](https://github.com/awslabs/private-aws-encryption-sdk-specification-staging/blob/dafny-verified/framework/required-encryption-context-cmm.md) with the following inputs: - This item encryptor's [CMM](./ddb-table-encryption-config.md#cmm) as the underlying CMM. - The keys from the [DynamoDB Item Base Context](#dynamodb-item-base-context).",
      "source": "DynamoDbEncryption/dafny/DynamoDbItemEncryptor/src/AwsCryptographyDbEncryptionSdkDynamoDbItemEncryptorOperations.dfy",
      "target_path": "specification/dynamodb-encryption-client/decrypt-item.md",
