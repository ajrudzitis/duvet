            "              | Reserved-by-Protocol | False                      |",
            "              +----------------------+----------------------------+",
            "",
            "                            Table 9: TEST-NET-1",
            "",
            "                  +----------------------+--------------------+",
            "                  | Attribute            | Value              |",
            "                  +----------------------+--------------------+",
            "                  | Address Block        | 192.88.99.0/24     |",
            "                  | Name                 | 6to4 Relay Anycast |",
            "                  | RFC                  | [RFC3068]          |",
            "                  | Allocation Date      | June 2001          |",
            "                  | Termination Date     | N/A                |",
            "                  | Source               | True               |",
            "                  | Destination          | True               |",
            "                  | Forwardable          | True               |",
