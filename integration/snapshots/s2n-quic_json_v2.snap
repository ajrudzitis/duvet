              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "aeb5c0d0d4ca4f44"
                ],
                "status_id": 1,
                "text": "+                                                               +"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
