      "target_section": "section-5.1.2",
      "tracking_issue": "380",
      "type": "TODO"
    },
    {
      "feature": "Client",
      "id": "971357a7977a48af",
      "level": "Auto",
      "line": 3,
      "quote": "Clients that support multiple QUIC versions SHOULD ensure that the first UDP datagram they send is sized to the largest of the minimum datagram sizes from all versions they support, using PADDING frames (Section 19.1) as necessary.",
      "source": "specs/todos/transport/6.toml",
