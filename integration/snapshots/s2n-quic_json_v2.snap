      "target_section": "4.2.4",
      "type": "CITATION"
    },
    {
      "comment": "See https://github.com/aws/s2n-quic/issues/959",
      "id": "8bf331f839ba23fd",
      "level": "Auto",
      "line": 528,
      "quote": "An update to the PLPMTU (or MPS) MUST NOT increase the congestion window measured in bytes [RFC4821].",
      "source": "quic/s2n-quic-core/src/recovery/bbr.rs",
      "target_path": "https://www.rfc-editor.org/rfc/rfc8899",
      "target_section": "section-3",
      "type": "EXCEPTION"
    },
    {
      "id": "e438bfbf5264594b",
      "level": "Auto",
      "line": 534,
      "quote": "If the maximum datagram size is decreased in order to complete the handshake, the congestion window SHOULD be set to the new initial congestion window.",
      "source": "quic/s2n-quic-core/src/recovery/bbr.rs",
      "target_path": "https://www.rfc-editor.org/rfc/rfc9002",
      "target_section": "section-7.2",
      "type": "CITATION"
    },
    {
      "id": "4745119969174e34",
      "level": "Auto",
      "line": 575,
      "quote": "BBROnInit(): init_windowed_max_filter(filter=BBR.MaxBwFilter, value=0, time=0) BBR.min_rtt = SRTT ? SRTT : Inf BBR.min_rtt_stamp = Now() BBR.probe_rtt_done_stamp = 0 BBR.probe_rtt_round_done = false BBR.prior_cwnd = 0 BBR.idle_restart = false BBR.extra_acked_interval_start = Now() BBR.extra_acked_delivered = 0 BBRResetCongestionSignals() BBRResetLowerBounds() BBRInitRoundCounting() BBRInitFullPipe() BBRInitPacingRate() BBREnterStartup()",
      "source": "quic/s2n-quic-core/src/recovery/bbr.rs",
      "target_path": "https://tools.ietf.org/id/draft-cardwell-iccrg-bbr-congestion-control-02",
      "target_section": "4.2.1",
      "type": "CITATION"
    },
    {
      "id": "d2b901218c241a73",
      "level": "Auto",
      "line": 639,
      "quote": "BBRBDPMultiple(gain): if (BBR.min_rtt == Inf) return InitialCwnd /* no valid RTT samples yet */ BBR.bdp = BBR.bw * BBR.min_rtt return gain * BBR.bdp",
      "source": "quic/s2n-quic-core/src/recovery/bbr.rs",
      "target_path": "https://tools.ietf.org/id/draft-cardwell-iccrg-bbr-congestion-control-02",
      "target_section": "4.6.4.2",
      "type": "CITATION"
    },
    {
      "id": "624702ce09719db9",
      "level": "Auto",
      "line": 659,
      "quote": "BBRTargetInflight() return min(BBR.bdp, cwnd)",
      "source": "quic/s2n-quic-core/src/recovery/bbr.rs",
      "target_path": "https://tools.ietf.org/id/draft-cardwell-iccrg-bbr-congestion-control-02",
      "target_section": "4.3.3.5.3",
      "type": "CITATION"
    },
    {
      "id": "6e8624624287e86d",
      "level": "Auto",
      "line": 673,
      "quote": "BBRUpdateMaxInflight() BBRUpdateAggregationBudget() inflight = BBRBDPMultiple(BBR.cwnd_gain) inflight += BBR.extra_acked BBR.max_inflight = BBRQuantizationBudget(inflight)",
      "source": "quic/s2n-quic-core/src/recovery/bbr.rs",
      "target_path": "https://tools.ietf.org/id/draft-cardwell-iccrg-bbr-congestion-control-02",
      "target_section": "4.6.4.2",
      "type": "CITATION"
    },
    {
      "id": "afe129d0195ebf20",
      "level": "Auto",
      "line": 694,
      "quote": "BBRInflight(gain) inflight = BBRBDPMultiple(gain) return BBRQuantizationBudget(inflight)",
      "source": "quic/s2n-quic-core/src/recovery/bbr.rs",
      "target_path": "https://tools.ietf.org/id/draft-cardwell-iccrg-bbr-congestion-control-02",
      "target_section": "4.6.4.2",
      "type": "CITATION"
    },
    {
      "id": "6a3ace3b8b43eb00",
      "level": "Auto",
      "line": 711,
      "quote": "BBRInflightWithHeadroom() if (BBR.inflight_hi == Infinity) return Infinity headroom = max(1, BBRHeadroom * BBR.inflight_hi) return max(BBR.inflight_hi - headroom, BBRMinPipeCwnd)",
      "source": "quic/s2n-quic-core/src/recovery/bbr.rs",
      "target_path": "https://tools.ietf.org/id/draft-cardwell-iccrg-bbr-congestion-control-02",
      "target_section": "4.3.3.6",
      "type": "CITATION"
    },
    {
      "id": "f93aa8d509468b23",
      "level": "Auto",
      "line": 738,
      "quote": "BBRQuantizationBudget(inflight) BBRUpdateOffloadBudget() inflight = max(inflight, BBR.offload_budget) inflight = max(inflight, BBRMinPipeCwnd) if (BBR.state == ProbeBW && BBR.cycle_idx == ProbeBW_UP) inflight += 2 return inflight",
      "source": "quic/s2n-quic-core/src/recovery/bbr.rs",
      "target_path": "https://tools.ietf.org/id/draft-cardwell-iccrg-bbr-congestion-control-02",
      "target_section": "4.6.4.2",
      "type": "CITATION"
    },
    {
      "id": "1e60327cc3e6c115",
      "level": "Auto",
      "line": 747,
      "quote": "BBRUpdateOffloadBudget(): BBR.offload_budget = 3 * BBR.send_quantum",
      "source": "quic/s2n-quic-core/src/recovery/bbr.rs",
      "target_path": "https://tools.ietf.org/id/draft-cardwell-iccrg-bbr-congestion-control-02",
      "target_section": "4.5.4",
      "type": "CITATION"
    },
    {
      "id": "eea990051727d015",
      "level": "Auto",
      "line": 804,
      "quote": "IsInflightTooHigh() return (rs.lost > rs.tx_in_flight * BBRLossThresh)",
      "source": "quic/s2n-quic-core/src/recovery/bbr.rs",
      "target_path": "https://tools.ietf.org/id/draft-cardwell-iccrg-bbr-congestion-control-02",
      "target_section": "4.5.6.2",
      "type": "CITATION"
    },
    {
      "id": "56bd4a68cdd0e5f1",
      "level": "Auto",
      "line": 811,
      "quote": "Endpoints SHOULD use an initial congestion window of ten times the maximum datagram size (max_datagram_size), while limiting the window to the larger of 14,720 bytes or twice the maximum datagram size.",
      "source": "quic/s2n-quic-core/src/recovery/bbr.rs",
      "target_path": "https://www.rfc-editor.org/rfc/rfc9002",
      "target_section": "section-7.2",
      "type": "CITATION"
    },
    {
      "id": "d91a27fb3c5b412f",
      "level": "Auto",
      "line": 837,
      "quote": "BBRSetCwnd(): BBRUpdateMaxInflight() BBRModulateCwndForRecovery() if (!BBR.packet_conservation) { if (BBR.filled_pipe) cwnd = min(cwnd + rs.newly_acked, BBR.max_inflight) else if (cwnd < BBR.max_inflight || C.delivered < InitialCwnd) cwnd = cwnd + rs.newly_acked cwnd = max(cwnd, BBRMinPipeCwnd) } BBRBoundCwndForProbeRTT() BBRBoundCwndForModel()",
      "source": "quic/s2n-quic-core/src/recovery/bbr.rs",
      "target_path": "https://tools.ietf.org/id/draft-cardwell-iccrg-bbr-congestion-control-02",
      "target_section": "4.6.4.6",
      "type": "CITATION"
    },
    {
      "comment": "https://github.com/aws/s2n-quic/issues/1511",
      "id": "72b11443b9c94743",
      "level": "Auto",
      "line": 851,
      "quote": "BBRModulateCwndForRecovery()",
      "source": "quic/s2n-quic-core/src/recovery/bbr.rs",
      "target_path": "https://tools.ietf.org/id/draft-cardwell-iccrg-bbr-congestion-control-02",
      "target_section": "4.6.4.6",
      "type": "EXCEPTION"
    },
    {
      "id": "e73a02a731773c02",
      "level": "Auto",
      "line": 883,
      "quote": "BBRBoundCwndForProbeRTT(): if (BBR.state == ProbeRTT) cwnd = min(cwnd, BBRProbeRTTCwnd())",
      "source": "quic/s2n-quic-core/src/recovery/bbr.rs",
      "target_path": "https://tools.ietf.org/id/draft-cardwell-iccrg-bbr-congestion-control-02",
      "target_section": "4.6.4.5",
      "type": "CITATION"
    },
    {
      "id": "1fa7121884d44bec",
      "level": "Auto",
      "line": 904,
      "quote": "BBRBoundCwndForModel(): cap = Infinity if (IsInAProbeBWState() and BBR.state != ProbeBW_CRUISE) cap = BBR.inflight_hi else if (BBR.state == ProbeRTT or BBR.state == ProbeBW_CRUISE) cap = BBRInflightWithHeadroom() /* apply inflight_lo (possibly infinite): */ cap = min(cap, BBR.inflight_lo) cap = max(cap, BBRMinPipeCwnd) cwnd = min(cwnd, cap)",
      "source": "quic/s2n-quic-core/src/recovery/bbr.rs",
      "target_path": "https://tools.ietf.org/id/draft-cardwell-iccrg-bbr-congestion-control-02",
      "target_section": "4.6.4.7",
      "type": "CITATION"
    },
    {
      "id": "7a9939a01cd6dc30",
      "level": "Auto",
      "line": 944,
      "quote": "BBRSaveCwnd() if (!InLossRecovery() and BBR.state != ProbeRTT) return cwnd else return max(BBR.prior_cwnd, cwnd)",
      "source": "quic/s2n-quic-core/src/recovery/bbr.rs",
      "target_path": "https://tools.ietf.org/id/draft-cardwell-iccrg-bbr-congestion-control-02",
      "target_section": "4.6.4.4",
      "type": "CITATION"
    },
    {
      "id": "7613326476da384a",
      "level": "Auto",
      "line": 960,
      "quote": "BBRRestoreCwnd() cwnd = max(cwnd, BBR.prior_cwnd)",
      "source": "quic/s2n-quic-core/src/recovery/bbr.rs",
      "target_path": "https://tools.ietf.org/id/draft-cardwell-iccrg-bbr-congestion-control-02",
      "target_section": "4.6.4.4",
      "type": "CITATION"
    },
    {
      "id": "bda5e0ad36282565",
      "level": "Auto",
      "line": 978,
      "quote": "if (!BBR.bw_probe_samples) return /* not a packet sent while probing bandwidth */ rs.tx_in_flight = packet.tx_in_flight /* inflight at transmit */ rs.lost = C.lost - packet.lost /* data lost since transmit */ rs.is_app_limited = packet.is_app_limited; if (IsInflightTooHigh(rs)) rs.tx_in_flight = BBRInflightHiFromLostPacket(rs, packet) BBRHandleInflightTooHigh(rs)",
      "source": "quic/s2n-quic-core/src/recovery/bbr.rs",
      "target_path": "https://tools.ietf.org/id/draft-cardwell-iccrg-bbr-congestion-control-02",
      "target_section": "4.5.6.2",
      "type": "CITATION"
    },
    {
      "id": "531dd18c029c90cf",
      "level": "Auto",
      "line": 1029,
      "quote": "BBRInflightHiFromLostPacket(rs, packet): size = packet.size /* What was in flight before this packet? */ inflight_prev = rs.tx_in_flight - size /* What was lost before this packet? */ lost_prev = rs.lost - size lost_prefix = (BBRLossThresh * inflight_prev - lost_prev) / (1 - BBRLossThresh) /* At what inflight value did losses cross BBRLossThresh? */ inflight = inflight_prev + lost_prefix return inflight",
      "source": "quic/s2n-quic-core/src/recovery/bbr.rs",
      "target_path": "https://tools.ietf.org/id/draft-cardwell-iccrg-bbr-congestion-control-02",
      "target_section": "4.5.6.2",
      "type": "CITATION"
    },
    {
      "id": "107fa52a41aa186f",
      "level": "Auto",
      "line": 1070,
      "quote": "A sender MAY implement alternative mechanisms to update its congestion window after periods of underutilization, such as those proposed for TCP in [RFC7661].",
      "source": "quic/s2n-quic-core/src/recovery/bbr.rs",
      "target_path": "https://www.rfc-editor.org/rfc/rfc9002",
      "target_section": "section-7.8",
      "type": "CITATION"
    },
    {
      "id": "fbd27f5abe2d74e9",
      "level": "Auto",
      "line": 1074,
      "quote": "BBRHandleRestartFromIdle(): if (packets_in_flight == 0 and C.app_limited) BBR.idle_restart = true BBR.extra_acked_interval_start = Now() if (IsInAProbeBWState()) BBRSetPacingRateWithGain(1)",
      "source": "quic/s2n-quic-core/src/recovery/bbr.rs",
      "target_path": "https://tools.ietf.org/id/draft-cardwell-iccrg-bbr-congestion-control-02",
      "target_section": "4.4.3",
      "type": "CITATION"
    },
    {
      "id": "b2b11c1dbf63481b",
      "level": "Auto",
      "line": 1098,
      "quote": "else if (BBR.state == ProbeRTT) BBRCheckProbeRTTDone()",
      "source": "quic/s2n-quic-core/src/recovery/bbr.rs",
      "target_path": "https://tools.ietf.org/id/draft-cardwell-iccrg-bbr-congestion-control-02",
      "target_section": "4.4.3",
      "tracking_issue": "1412",
      "type": "TODO"
    },
    {
      "id": "9ca02b44c2654dc5",
      "level": "Auto",
      "line": 1104,
      "quote": "As an optimization, when restarting from idle BBR checks to see if the connection is in ProbeRTT and has met the exit conditions for ProbeRTT. If a connection goes idle during ProbeRTT then often it will have met those exit conditions by the time it restarts, so that the connection can restore the cwnd to its full value before it starts transmitting a new flight of data.",
      "source": "quic/s2n-quic-core/src/recovery/bbr.rs",
      "target_path": "https://tools.ietf.org/id/draft-cardwell-iccrg-bbr-congestion-control-02",
      "target_section": "4.4.2",
      "tracking_issue": "1412",
      "type": "TODO"
    },
    {
      "id": "f4bf1890f317b752",
      "level": "Auto",
      "line": 31,
      "quote": "",
      "source": "quic/s2n-quic-core/src/recovery/cubic/tests.rs",
      "target_path": "https://www.rfc-editor.org/rfc/rfc8312",
      "target_section": "section-4.1",
      "type": "TEST"
    },
    {
      "id": "5e8ff71cfe130f94",
      "level": "Auto",
      "line": 55,
      "quote": "Therefore, C SHOULD be set to 0.4.",
      "source": "quic/s2n-quic-core/src/recovery/cubic/tests.rs",
      "target_path": "https://www.rfc-editor.org/rfc/rfc8312",
      "target_section": "section-5.1",
      "type": "TEST"
    },
    {
      "id": "a66d6f45ca4f64c6",
      "level": "Auto",
      "line": 71,
      "quote": "",
      "source": "quic/s2n-quic-core/src/recovery/cubic/tests.rs",
      "target_path": "https://www.rfc-editor.org/rfc/rfc8312",
      "target_section": "section-4.6",
      "type": "TEST"
    },
    {
      "id": "2226f4f768b2e2ab",
      "level": "Auto",
      "line": 89,
      "quote": "",
      "source": "quic/s2n-quic-core/src/recovery/cubic/tests.rs",
      "target_path": "https://www.rfc-editor.org/rfc/rfc8312",
      "target_section": "section-4.5",
      "type": "TEST"
    },
    {
      "id": "cefaab207231d581",
      "level": "Auto",
      "line": 108,
      "quote": "To speed up this bandwidth release by existing flows, the following mechanism called \"fast convergence\" SHOULD be implemented.",
      "source": "quic/s2n-quic-core/src/recovery/cubic/tests.rs",
      "target_path": "https://www.rfc-editor.org/rfc/rfc8312",
      "target_section": "section-4.6",
      "type": "TEST"
    },
    {
      "id": "940f3f86e23a3936",
      "level": "Auto",
      "line": 118,
      "quote": "Parameter beta_cubic SHOULD be set to 0.7.",
      "source": "quic/s2n-quic-core/src/recovery/cubic/tests.rs",
      "target_path": "https://www.rfc-editor.org/rfc/rfc8312",
      "target_section": "section-4.5",
      "type": "TEST"
    },
    {
      "id": "9d6bdf52474cbd67",
      "level": "Auto",
      "line": 125,
      "quote": "",
      "source": "quic/s2n-quic-core/src/recovery/cubic/tests.rs",
      "target_path": "https://www.rfc-editor.org/rfc/rfc9002",
      "target_section": "section-7.8",
      "type": "TEST"
    },
    {
      "id": "83118d8b0ca0ad99",
      "level": "Auto",
      "line": 170,
      "quote": "Endpoints SHOULD use an initial congestion window of ten times the maximum datagram size (max_datagram_size), while limiting the window to the larger of 14,720 bytes or twice the maximum datagram size.",
      "source": "quic/s2n-quic-core/src/recovery/cubic/tests.rs",
      "target_path": "https://www.rfc-editor.org/rfc/rfc9002",
      "target_section": "section-7.2",
      "type": "TEST"
    },
    {
      "id": "f700264561f35874",
      "level": "Auto",
      "line": 225,
      "quote": "The RECOMMENDED value is 2 * max_datagram_size.",
      "source": "quic/s2n-quic-core/src/recovery/cubic/tests.rs",
      "target_path": "https://www.rfc-editor.org/rfc/rfc9002",
      "target_section": "section-7.2",
      "type": "TEST"
    },
    {
      "id": "2ee780673cad7f86",
      "level": "Auto",
      "line": 271,
      "quote": "CUBIC MUST employ a slow-start algorithm, when the cwnd is no more than ssthresh.  Among the slow-start algorithms, CUBIC MAY choose the standard TCP slow start [RFC5681] in general networks, or the limited slow start [RFC3742] or hybrid slow start [HR08] for fast and long- distance networks.",
      "source": "quic/s2n-quic-core/src/recovery/cubic/tests.rs",
      "target_path": "https://www.rfc-editor.org/rfc/rfc8312",
      "target_section": "section-4.8",
      "type": "TEST"
    },
    {
      "id": "9eb935bd486bde81",
      "level": "Auto",
      "line": 449,
      "quote": "In case of long periods when cwnd has not been updated due to the application rate limit, such as idle periods, t in Eq. 1 MUST NOT include these periods; otherwise, W_cubic(t) might be very high after restarting from these periods.",
      "source": "quic/s2n-quic-core/src/recovery/cubic/tests.rs",
      "target_path": "https://www.rfc-editor.org/rfc/rfc8312",
      "target_section": "section-5.8",
      "type": "TEST"
    },
    {
      "id": "10472dc7e243c8a8",
      "level": "Auto",
      "line": 690,
      "quote": "The sender MUST exit slow start and enter a recovery period when a packet is lost or when the ECN-CE count reported by its peer increases.",
      "source": "quic/s2n-quic-core/src/recovery/cubic/tests.rs",
      "target_path": "https://www.rfc-editor.org/rfc/rfc9002",
      "target_section": "section-7.3.1",
      "type": "TEST"
    },
    {
      "id": "4b517065d12152a1",
      "level": "Auto",
      "line": 699,
      "quote": "Implementations MAY reduce the congestion window immediately upon entering a recovery period or use other mechanisms, such as Proportional Rate Reduction [PRR], to reduce the congestion window more gradually.",
      "source": "quic/s2n-quic-core/src/recovery/cubic/tests.rs",
      "target_path": "https://www.rfc-editor.org/rfc/rfc9002",
      "target_section": "section-7.3.2",
      "type": "TEST"
    },
    {
      "id": "0b2f8a02fbc87ade",
      "level": "Auto",
      "line": 753,
      "quote": "When persistent congestion is declared, the sender's congestion window MUST be reduced to the minimum congestion window (kMinimumWindow), similar to a TCP sender's response on an RTO [RFC5681].",
      "source": "quic/s2n-quic-core/src/recovery/cubic/tests.rs",
      "target_path": "https://www.rfc-editor.org/rfc/rfc9002",
      "target_section": "section-7.6.2",
      "type": "TEST"
    },
    {
      "id": "ab4a7660ed88cc5a",
      "level": "Auto",
      "line": 780,
      "quote": "If the maximum datagram size changes during the connection, the initial congestion window SHOULD be recalculated with the new size.",
      "source": "quic/s2n-quic-core/src/recovery/cubic/tests.rs",
      "target_path": "https://www.rfc-editor.org/rfc/rfc9002",
      "target_section": "section-7.2",
      "type": "TEST"
    },
    {
      "id": "c14771b56644746a",
      "level": "Auto",
      "line": 785,
      "quote": "A PL that maintains the congestion window in terms of a limit to the number of outstanding fixed-size packets SHOULD adapt this limit to compensate for the size of the actual packets.",
      "source": "quic/s2n-quic-core/src/recovery/cubic/tests.rs",
      "target_path": "https://www.rfc-editor.org/rfc/rfc8899",
      "target_section": "section-3",
      "type": "TEST"
    },
    {
      "id": "f4e8a87e5b2b4d02",
      "level": "Auto",
      "line": 807,
      "quote": "If the maximum datagram size changes during the connection, the initial congestion window SHOULD be recalculated with the new size.",
      "source": "quic/s2n-quic-core/src/recovery/cubic/tests.rs",
      "target_path": "https://www.rfc-editor.org/rfc/rfc9002",
      "target_section": "section-7.2",
      "type": "TEST"
    },
    {
      "id": "0d0dc909bf3d7158",
      "level": "Auto",
      "line": 812,
      "quote": "If the maximum datagram size is decreased in order to complete the handshake, the congestion window SHOULD be set to the new initial congestion window.",
      "source": "quic/s2n-quic-core/src/recovery/cubic/tests.rs",
      "target_path": "https://www.rfc-editor.org/rfc/rfc9002",
      "target_section": "section-7.2",
      "type": "TEST"
    },
    {
      "id": "20b2a2b893f8bb6d",
      "level": "Auto",
      "line": 853,
      "quote": "The sender MUST discard all recovery state associated with those packets and MUST remove them from the count of bytes in flight.",
      "source": "quic/s2n-quic-core/src/recovery/cubic/tests.rs",
      "target_path": "https://www.rfc-editor.org/rfc/rfc9002",
      "target_section": "section-6.4",
      "type": "TEST"
    },
    {
      "id": "4038864e594da582",
      "level": "Auto",
      "line": 876,
      "quote": "When bytes in flight is smaller than the congestion window and sending is not pacing limited, the congestion window is underutilized.  This can happen due to insufficient application data or flow control limits.  When this occurs, the congestion window SHOULD NOT be increased in either slow start or congestion avoidance.",
      "source": "quic/s2n-quic-core/src/recovery/cubic/tests.rs",
      "target_path": "https://www.rfc-editor.org/rfc/rfc9002",
      "target_section": "section-7.8",
      "type": "TEST"
    },
    {
      "id": "578520800a70646f",
      "level": "Auto",
      "line": 1054,
      "quote": "",
      "source": "quic/s2n-quic-core/src/recovery/cubic/tests.rs",
      "target_path": "https://www.rfc-editor.org/rfc/rfc9002",
      "target_section": "section-7.3.2",
      "type": "TEST"
    },
    {
      "id": "e23251e5c6eda471",
      "level": "Auto",
      "line": 1085,
      "quote": "",
      "source": "quic/s2n-quic-core/src/recovery/cubic/tests.rs",
      "target_path": "https://www.rfc-editor.org/rfc/rfc9002",
      "target_section": "section-7.3.2",
      "type": "TEST"
    },
    {
      "id": "752b747f7e0a9088",
      "level": "Auto",
      "line": 1197,
      "quote": "If so, CUBIC is in the TCP-friendly region and cwnd SHOULD be set to W_est(t) at each reception of an ACK.",
      "source": "quic/s2n-quic-core/src/recovery/cubic/tests.rs",
      "target_path": "https://www.rfc-editor.org/rfc/rfc8312",
      "target_section": "section-4.2",
      "type": "TEST"
    },
    {
      "id": "a3d60522e4564dac",
      "level": "Auto",
      "line": 1218,
      "quote": "In this region, cwnd MUST be incremented by (W_cubic(t+RTT) - cwnd)/cwnd for each received ACK, where W_cubic(t+RTT) is calculated using Eq. 1.",
      "source": "quic/s2n-quic-core/src/recovery/cubic/tests.rs",
      "target_path": "https://www.rfc-editor.org/rfc/rfc8312",
      "target_section": "section-4.3",
      "type": "TEST"
    },
    {
      "id": "6b17f9ed388b0460",
      "level": "Auto",
      "line": 1250,
      "quote": "In this region, cwnd MUST be incremented by (W_cubic(t+RTT) - cwnd)/cwnd for each received ACK, where W_cubic(t+RTT) is calculated using Eq. 1.",
      "source": "quic/s2n-quic-core/src/recovery/cubic/tests.rs",
      "target_path": "https://www.rfc-editor.org/rfc/rfc8312",
      "target_section": "section-4.4",
      "type": "TEST"
    },
    {
      "id": "6404f792deea0d9b",
      "level": "Auto",
      "line": 24,
      "quote": "New Path or      +------------+ persistent congestion |   Slow     | (O)---------------------->|   Start    | +------------+ | Loss or | ECN-CE increase | v +------------+     Loss or       +------------+ | Congestion |  ECN-CE increase  |  Recovery  | | Avoidance  |------------------>|   Period   | +------------+                   +------------+ ^                            | |                            | +----------------------------+ Acknowledgment of packet sent during recovery",
      "source": "quic/s2n-quic-core/src/recovery/cubic.rs",
      "target_path": "https://www.rfc-editor.org/rfc/rfc9002",
      "target_section": "section-7.3",
      "type": "CITATION"
    },
    {
      "id": "d3097f515666ae44",
      "level": "Auto",
      "line": 85,
      "quote": "If the congestion window is reduced immediately, a single packet can be sent prior to reduction.  This speeds up loss recovery if the data in the lost packet is retransmitted and is similar to TCP as described in Section 5 of [RFC6675].",
      "source": "quic/s2n-quic-core/src/recovery/cubic.rs",
      "target_path": "https://www.rfc-editor.org/rfc/rfc9002",
      "target_section": "section-7.3.2",
      "type": "CITATION"
    },
    {
      "id": "b2319ef5f446f51c",
      "level": "Auto",
      "line": 107,
      "quote": "t is the elapsed time from the beginning of the current congestion avoidance",
      "source": "quic/s2n-quic-core/src/recovery/cubic.rs",
      "target_path": "https://www.rfc-editor.org/rfc/rfc8312",
      "target_section": "section-4.1",
      "type": "CITATION"
    },
    {
      "id": "1d78363bc5dd3df9",
      "level": "Auto",
      "line": 119,
      "quote": "CUBIC does not raise its congestion window size if the flow is currently limited by the application instead of the congestion window.  In case of long periods when cwnd has not been updated due to the application rate limit, such as idle periods, t in Eq. 1 MUST NOT include these periods; otherwise, W_cubic(t) might be very high after restarting from these periods.",
      "source": "quic/s2n-quic-core/src/recovery/cubic.rs",
      "target_path": "https://www.rfc-editor.org/rfc/rfc8312",
      "target_section": "section-5.8",
      "type": "CITATION"
    },
    {
      "id": "280023d71778cbde",
      "level": "Auto",
      "line": 141,
      "quote": "CUBIC MUST employ a slow-start algorithm, when the cwnd is no more than ssthresh.",
      "source": "quic/s2n-quic-core/src/recovery/cubic.rs",
      "target_path": "https://www.rfc-editor.org/rfc/rfc8312",
      "target_section": "section-4.8",
      "type": "CITATION"
    },
    {
      "id": "d526ec58869ead62",
      "level": "Auto",
      "line": 145,
      "quote": "Among the slow-start algorithms, CUBIC MAY choose the standard TCP slow start [RFC5681] in general networks, or the limited slow start [RFC3742] or hybrid slow start [HR08] for fast and long- distance networks.",
      "source": "quic/s2n-quic-core/src/recovery/cubic.rs",
      "target_path": "https://www.rfc-editor.org/rfc/rfc8312",
      "target_section": "section-4.8",
      "type": "CITATION"
    },
    {
      "id": "a6e2276af3f0fff8",
      "level": "Auto",
      "line": 155,
      "quote": "The sum of the size in bytes of all sent packets that contain at least one ack-eliciting or PADDING frame and have not been acknowledged or declared lost.  The size does not include IP or UDP overhead, but does include the QUIC header and Authenticated Encryption with Associated Data (AEAD) overhead. Packets only containing ACK frames do not count toward bytes_in_flight to ensure congestion control does not impede congestion feedback.",
      "source": "quic/s2n-quic-core/src/recovery/cubic.rs",
      "target_path": "https://www.rfc-editor.org/rfc/rfc9002",
      "target_section": "appendix-B.2",
      "type": "CITATION"
    },
    {
      "id": "6d7d649cb8f90bf2",
      "level": "Auto",
      "line": 273,
      "quote": "In the case when CUBIC runs the hybrid slow start [HR08], it may exit the first slow start without incurring any packet loss and thus W_max is undefined.  In this special case, CUBIC switches to congestion avoidance and increases its congestion window size using Eq. 1, where t is the elapsed time since the beginning of the current congestion avoidance, K is set to 0, and W_max is set to the congestion window size at the beginning of the current congestion avoidance.",
      "source": "quic/s2n-quic-core/src/recovery/cubic.rs",
      "target_path": "https://www.rfc-editor.org/rfc/rfc8312",
      "target_section": "section-4.8",
      "type": "CITATION"
    },
    {
      "id": "abae1b47e18fda3d",
      "level": "Auto",
      "line": 305,
      "quote": "When bytes in flight is smaller than the congestion window and sending is not pacing limited, the congestion window is underutilized.  This can happen due to insufficient application data or flow control limits.  When this occurs, the congestion window SHOULD NOT be increased in either slow start or congestion avoidance.",
      "source": "quic/s2n-quic-core/src/recovery/cubic.rs",
      "target_path": "https://www.rfc-editor.org/rfc/rfc9002",
      "target_section": "section-7.8",
      "type": "CITATION"
    },
    {
      "id": "6d18e58924ed62b0",
      "level": "Auto",
      "line": 317,
      "quote": "A recovery period ends and the sender enters congestion avoidance when a packet sent during the recovery period is acknowledged.",
      "source": "quic/s2n-quic-core/src/recovery/cubic.rs",
      "target_path": "https://www.rfc-editor.org/rfc/rfc9002",
      "target_section": "section-7.3.2",
      "type": "CITATION"
    },
    {
      "id": "414ce10ba143cf31",
      "level": "Auto",
      "line": 345,
      "quote": "While a sender is in slow start, the congestion window increases by the number of bytes acknowledged when each acknowledgment is processed.  This results in exponential growth of the congestion window.",
      "source": "quic/s2n-quic-core/src/recovery/cubic.rs",
      "target_path": "https://www.rfc-editor.org/rfc/rfc9002",
      "target_section": "section-7.3.1",
      "type": "CITATION"
    },
    {
      "id": "3c8feb6efe1645d2",
      "level": "Auto",
      "line": 369,
      "quote": "t is the elapsed time from the beginning of the current congestion avoidance",
      "source": "quic/s2n-quic-core/src/recovery/cubic.rs",
      "target_path": "https://www.rfc-editor.org/rfc/rfc8312",
      "target_section": "section-4.1",
      "type": "CITATION"
    },
    {
      "id": "d3580c35776cc02b",
      "level": "Auto",
      "line": 373,
      "quote": "RTT is the weighted average RTT",
      "source": "quic/s2n-quic-core/src/recovery/cubic.rs",
      "target_path": "https://www.rfc-editor.org/rfc/rfc8312",
      "target_section": "section-4.1",
      "type": "CITATION"
    },
    {
      "id": "103176956d09a9b9",
      "level": "Auto",
      "line": 411,
      "quote": "When persistent congestion is declared, the sender's congestion window MUST be reduced to the minimum congestion window (kMinimumWindow), similar to a TCP sender's response on an RTO [RFC5681].",
      "source": "quic/s2n-quic-core/src/recovery/cubic.rs",
      "target_path": "https://www.rfc-editor.org/rfc/rfc9002",
      "target_section": "section-7.6.2",
      "type": "CITATION"
    },
    {
      "id": "d15cb43e5f1bc0de",
      "level": "Auto",
      "line": 434,
      "quote": "If a path has been validated to support Explicit Congestion Notification (ECN) [RFC3168] [RFC8311], QUIC treats a Congestion Experienced (CE) codepoint in the IP header as a signal of congestion.",
      "source": "quic/s2n-quic-core/src/recovery/cubic.rs",
      "target_path": "https://www.rfc-editor.org/rfc/rfc9002",
      "target_section": "section-7.1",
      "type": "CITATION"
    },
    {
      "comment": "See https://github.com/aws/s2n-quic/issues/959",
      "id": "55188a45f803b038",
      "level": "Auto",
      "line": 442,
      "quote": "An update to the PLPMTU (or MPS) MUST NOT increase the congestion window measured in bytes [RFC4821].",
      "source": "quic/s2n-quic-core/src/recovery/cubic.rs",
      "target_path": "https://www.rfc-editor.org/rfc/rfc8899",
      "target_section": "section-3",
      "type": "EXCEPTION"
    },
    {
      "id": "ce77032494c2da52",
      "level": "Auto",
      "line": 448,
      "quote": "A PL that maintains the congestion window in terms of a limit to the number of outstanding fixed-size packets SHOULD adapt this limit to compensate for the size of the actual packets.",
      "source": "quic/s2n-quic-core/src/recovery/cubic.rs",
      "target_path": "https://www.rfc-editor.org/rfc/rfc8899",
      "target_section": "section-3",
      "type": "CITATION"
    },
    {
      "id": "480c4dacd46ce70b",
      "level": "Auto",
      "line": 453,
      "quote": "If the maximum datagram size is decreased in order to complete the handshake, the congestion window SHOULD be set to the new initial congestion window.",
      "source": "quic/s2n-quic-core/src/recovery/cubic.rs",
      "target_path": "https://www.rfc-editor.org/rfc/rfc9002",
      "target_section": "section-7.2",
      "type": "CITATION"
    },
    {
      "id": "af9301e8b8e1b06f",
      "level": "Auto",
      "line": 471,
      "quote": "When Initial and Handshake packet protection keys are discarded (see Section 4.9 of [QUIC-TLS]), all packets that were sent with those keys can no longer be acknowledged because their acknowledgments cannot be processed.  The sender MUST discard all recovery state associated with those packets and MUST remove them from the count of bytes in flight.",
      "source": "quic/s2n-quic-core/src/recovery/cubic.rs",
      "target_path": "https://www.rfc-editor.org/rfc/rfc9002",
      "target_section": "section-6.4",
      "type": "CITATION"
    },
    {
      "id": "6a8586acac0e25a9",
      "level": "Auto",
      "line": 521,
      "quote": "Endpoints SHOULD use an initial congestion window of ten times the maximum datagram size (max_datagram_size), while limiting the window to the larger of 14,720 bytes or twice the maximum datagram size.",
      "source": "quic/s2n-quic-core/src/recovery/cubic.rs",
      "target_path": "https://www.rfc-editor.org/rfc/rfc9002",
      "target_section": "section-7.2",
      "type": "CITATION"
    },
    {
      "id": "f10f4fb2ce56872b",
      "level": "Auto",
      "line": 527,
      "quote": "If the maximum datagram size changes during the connection, the initial congestion window SHOULD be recalculated with the new size.",
      "source": "quic/s2n-quic-core/src/recovery/cubic.rs",
      "target_path": "https://www.rfc-editor.org/rfc/rfc9002",
      "target_section": "section-7.2",
      "type": "CITATION"
    },
    {
      "id": "65bcf955a834b19f",
      "level": "Auto",
      "line": 562,
      "quote": "When receiving an ACK in congestion avoidance (cwnd could be greater than or less than W_max), CUBIC checks whether W_cubic(t) is less than W_est(t).  If so, CUBIC is in the TCP-friendly region and cwnd SHOULD be set to W_est(t) at each reception of an ACK.",
      "source": "quic/s2n-quic-core/src/recovery/cubic.rs",
      "target_path": "https://www.rfc-editor.org/rfc/rfc8312",
      "target_section": "section-4.2",
      "type": "CITATION"
    },
    {
      "id": "f3e08514df45833c",
      "level": "Auto",
      "line": 569,
      "quote": "Upon receiving an ACK during congestion avoidance, CUBIC computes the window increase rate during the next RTT period using Eq. 1.  It sets W_cubic(t+RTT) as the candidate target value of the congestion window",
      "source": "quic/s2n-quic-core/src/recovery/cubic.rs",
      "target_path": "https://www.rfc-editor.org/rfc/rfc8312",
      "target_section": "section-4.1",
      "type": "CITATION"
    },
    {
      "id": "602571f2e144bf8c",
      "level": "Auto",
      "line": 576,
      "quote": "When receiving an ACK in congestion avoidance, if CUBIC is not in the TCP-friendly region and cwnd is less than W_max, then CUBIC is in the concave region.  In this region, cwnd MUST be incremented by (W_cubic(t+RTT) - cwnd)/cwnd for each received ACK, where W_cubic(t+RTT) is calculated using Eq. 1.",
      "source": "quic/s2n-quic-core/src/recovery/cubic.rs",
      "target_path": "https://www.rfc-editor.org/rfc/rfc8312",
      "target_section": "section-4.3",
      "type": "CITATION"
    },
    {
      "id": "8d15a04625749b06",
      "level": "Auto",
      "line": 589,
      "quote": "In this region, cwnd MUST be incremented by (W_cubic(t+RTT) - cwnd)/cwnd for each received ACK, where W_cubic(t+RTT) is calculated using Eq. 1.",
      "source": "quic/s2n-quic-core/src/recovery/cubic.rs",
      "target_path": "https://www.rfc-editor.org/rfc/rfc8312",
      "target_section": "section-4.4",
      "type": "CITATION"
    },
    {
      "id": "369b750b8e995f27",
      "level": "Auto",
      "line": 633,
      "quote": "The sender MUST exit slow start and enter a recovery period when a packet is lost or when the ECN-CE count reported by its peer increases.",
      "source": "quic/s2n-quic-core/src/recovery/cubic.rs",
      "target_path": "https://www.rfc-editor.org/rfc/rfc9002",
      "target_section": "section-7.3.1",
      "type": "CITATION"
    },
    {
      "id": "405e5bfd1dc5ffa8",
      "level": "Auto",
      "line": 638,
      "quote": "If the congestion window is reduced immediately, a single packet can be sent prior to reduction.  This speeds up loss recovery if the data in the lost packet is retransmitted and is similar to TCP as described in Section 5 of [RFC6675].",
      "source": "quic/s2n-quic-core/src/recovery/cubic.rs",
      "target_path": "https://www.rfc-editor.org/rfc/rfc9002",
      "target_section": "section-7.3.2",
      "type": "CITATION"
    },
    {
      "id": "2ca7994362c1a04c",
      "level": "Auto",
      "line": 645,
      "quote": "Implementations MAY reduce the congestion window immediately upon entering a recovery period or use other mechanisms, such as Proportional Rate Reduction [PRR], to reduce the congestion window more gradually.",
      "source": "quic/s2n-quic-core/src/recovery/cubic.rs",
      "target_path": "https://www.rfc-editor.org/rfc/rfc9002",
      "target_section": "section-7.3.2",
      "type": "CITATION"
    },
    {
      "id": "95053af2652b95d7",
      "level": "Auto",
      "line": 651,
      "quote": "The minimum congestion window is the smallest value the congestion window can attain in response to loss, an increase in the peer- reported ECN-CE count, or persistent congestion.",
      "source": "quic/s2n-quic-core/src/recovery/cubic.rs",
      "target_path": "https://www.rfc-editor.org/rfc/rfc9002",
      "target_section": "section-7.2",
      "type": "CITATION"
    },
    {
      "id": "067cf07610387770",
      "level": "Auto",
      "line": 705,
      "quote": "W_max is the window size just before the window is reduced in the last congestion event.",
      "source": "quic/s2n-quic-core/src/recovery/cubic.rs",
      "target_path": "https://www.rfc-editor.org/rfc/rfc8312",
      "target_section": "section-4.1",
      "type": "CITATION"
    },
    {
      "id": "216fca5ea23fabd4",
      "level": "Auto",
      "line": 709,
      "quote": "a flow remembers the last value of W_max before it updates W_max for the current congestion event. Let us call the last value of W_max to be W_last_max.",
      "source": "quic/s2n-quic-core/src/recovery/cubic.rs",
      "target_path": "https://www.rfc-editor.org/rfc/rfc8312",
      "target_section": "section-4.6",
      "type": "CITATION"
    },
    {
      "id": "666c0a186e013a2b",
      "level": "Auto",
      "line": 719,
      "quote": "Based on these observations and our experiments, we find C=0.4 gives a good balance between TCP-friendliness and aggressiveness of window increase.  Therefore, C SHOULD be set to 0.4.",
      "source": "quic/s2n-quic-core/src/recovery/cubic.rs",
      "target_path": "https://www.rfc-editor.org/rfc/rfc8312",
      "target_section": "section-5.1",
      "type": "CITATION"
    },
    {
      "id": "ec78ed3b876676b6",
      "level": "Auto",
      "line": 725,
      "quote": "Parameter beta_cubic SHOULD be set to 0.7.",
      "source": "quic/s2n-quic-core/src/recovery/cubic.rs",
      "target_path": "https://www.rfc-editor.org/rfc/rfc8312",
      "target_section": "section-4.5",
      "type": "CITATION"
    },
    {
      "id": "81524006cbe26d46",
      "level": "Auto",
      "line": 747,
      "quote": "CUBIC uses the following window increase function: W_cubic(t) = C*(t-K)^3 + W_max (Eq. 1) where C is a constant fixed to determine the aggressiveness of window increase in high BDP networks, t is the elapsed time from the beginning of the current congestion avoidance, and K is the time period that the above function takes to increase the current window size to W_max if there are no further congestion events and is calculated using the following equation: K = cubic_root(W_max*(1-beta_cubic)/C) (Eq. 2) where beta_cubic is the CUBIC multiplication decrease factor",
      "source": "quic/s2n-quic-core/src/recovery/cubic.rs",
      "target_path": "https://www.rfc-editor.org/rfc/rfc8312",
      "target_section": "section-4.1",
      "type": "CITATION"
    },
    {
      "id": "b44465d6b5f1c4a8",
      "level": "Auto",
      "line": 767,
      "quote": "W_est(t) = W_max*beta_cubic +",
      "source": "quic/s2n-quic-core/src/recovery/cubic.rs",
      "target_path": "https://www.rfc-editor.org/rfc/rfc8312",
      "target_section": "section-4.2",
      "type": "CITATION"
    },
    {
      "id": "cd685006ebd9be2c",
      "level": "Auto",
      "line": 778,
      "quote": "When a packet loss is detected by duplicate ACKs or a network congestion is detected by ECN-Echo ACKs, CUBIC updates its W_max, cwnd, and ssthresh as follows.  Parameter beta_cubic SHOULD be set to 0.7. W_max = cwnd;                 // save window size before reduction ssthresh = cwnd * beta_cubic; // new slow-start threshold ssthresh = max(ssthresh, 2);  // threshold is at least 2 MSS cwnd = cwnd * beta_cubic;     // window reduction",
      "source": "quic/s2n-quic-core/src/recovery/cubic.rs",
      "target_path": "https://www.rfc-editor.org/rfc/rfc8312",
      "target_section": "section-4.5",
      "type": "CITATION"
    },
    {
      "id": "bec06735309c6111",
      "level": "Auto",
      "line": 793,
      "quote": "To speed up this bandwidth release by existing flows, the following mechanism called \"fast convergence\" SHOULD be implemented.",
      "source": "quic/s2n-quic-core/src/recovery/cubic.rs",
      "target_path": "https://www.rfc-editor.org/rfc/rfc8312",
      "target_section": "section-4.6",
      "type": "CITATION"
    },
    {
      "id": "c6084dc79e4f4f42",
      "level": "Auto",
      "line": 798,
      "quote": "With fast convergence, when a congestion event occurs, before the window reduction of the congestion window, a flow remembers the last value of W_max before it updates W_max for the current congestion event.  Let us call the last value of W_max to be W_last_max. if (W_max < W_last_max){ // should we make room for others W_last_max = W_max;             // remember the last W_max W_max = W_max*(1.0+beta_cubic)/2.0; // further reduce W_max } else { W_last_max = W_max              // remember the last W_max } At a congestion event, if the current value of W_max is less than W_last_max, this indicates that the saturation point experienced by this flow is getting reduced because of the change in available bandwidth.  Then we allow this flow to release more bandwidth by reducing W_max further.  This action effectively lengthens the time for this flow to increase its congestion window because the reduced W_max forces the flow to have the plateau earlier.  This allows more time for the new flow to catch up to its congestion window size.",
      "source": "quic/s2n-quic-core/src/recovery/cubic.rs",
      "target_path": "https://www.rfc-editor.org/rfc/rfc8312",
      "target_section": "section-4.6",
      "type": "CITATION"
    },
    {
      "id": "f4c480b6052927d7",
      "level": "Auto",
      "line": 828,
      "quote": "_K_ is the time period that the above function takes to increase the congestion window size at the beginning of the current congestion avoidance stage to _W_(max)_ if there are no further congestion events and is calculated using the following equation: ________________ /W    - cwnd 3  /  max       start K = | /  ---------------- |/           C Figure 2 where _cwnd_(start)_ is the congestion window at the beginning of the current congestion avoidance stage.",
      "source": "quic/s2n-quic-core/src/recovery/cubic.rs",
      "target_path": "https://tools.ietf.org/id/draft-eggert-tcpm-rfc8312bis-01",
      "target_section": "4.2",
      "type": "CITATION"
    },
    {
      "id": "ebeb1183cb600a28",
      "level": "Auto",
      "line": 851,
      "quote": "In the case when CUBIC runs the hybrid slow start [HR08], it may exit the first slow start without incurring any packet loss and thus W_max is undefined.  In this special case, CUBIC switches to congestion avoidance and increases its congestion window size using Eq. 1, where t is the elapsed time since the beginning of the current congestion avoidance, K is set to 0, and W_max is set to the congestion window size at the beginning of the current congestion avoidance.",
      "source": "quic/s2n-quic-core/src/recovery/cubic.rs",
      "target_path": "https://www.rfc-editor.org/rfc/rfc8312",
      "target_section": "section-4.8",
      "type": "CITATION"
    },
    {
      "id": "45a111ba594af915",
      "level": "Auto",
      "line": 868,
      "quote": "The minimum congestion window is the smallest value the congestion window can attain in response to loss, an increase in the peer- reported ECN-CE count, or persistent congestion.  The RECOMMENDED value is 2 * max_datagram_size.",
      "source": "quic/s2n-quic-core/src/recovery/cubic.rs",
      "target_path": "https://www.rfc-editor.org/rfc/rfc9002",
      "target_section": "section-7.2",
      "type": "CITATION"
    },
    {
      "id": "0c42da8913eff469",
      "level": "Auto",
      "line": 33,
      "quote": "o  RttThresh = clamp(MIN_RTT_THRESH, lastRoundMinRTT / 8, MAX_RTT_THRESH)",
      "source": "quic/s2n-quic-core/src/recovery/hybrid_slow_start.rs",
      "target_path": "https://tools.ietf.org/id/draft-ietf-tcpm-hystartplusplus-04.txt",
      "target_section": "section-4.2",
      "type": "CITATION"
    },
    {
      "id": "6b5fc25cca92e3c5",
      "level": "Auto",
      "line": 37,
      "quote": "It is RECOMMENDED that a HyStart++ implementation use the following constants: *  MIN_RTT_THRESH = 4 msec *  MAX_RTT_THRESH = 16 msec *  N_RTT_SAMPLE = 8 *  CSS_GROWTH_DIVISOR = 4 *  CSS_ROUNDS = 5",
      "source": "quic/s2n-quic-core/src/recovery/hybrid_slow_start.rs",
      "target_path": "https://tools.ietf.org/id/draft-ietf-tcpm-hystartplusplus-04.txt",
      "target_section": "section-4.3",
      "type": "CITATION"
    },
    {
      "id": "bc788967c0b635ad",
      "level": "Auto",
      "line": 74,
      "quote": "A sender begins in slow start because the slow start threshold is initialized to an infinite value.",
      "source": "quic/s2n-quic-core/src/recovery/hybrid_slow_start.rs",
      "target_path": "https://www.rfc-editor.org/rfc/rfc9002",
      "target_section": "section-7.3.1",
      "type": "CITATION"
    },
    {
      "id": "f0d5f6decfde3569",
      "level": "Auto",
      "line": 103,
      "quote": "An implementation SHOULD use HyStart++ only for the initial slow start (when ssthresh is at its initial value of arbitrarily high per [RFC5681]) and fall back to using traditional slow start for the remainder of the connection lifetime.",
      "source": "quic/s2n-quic-core/src/recovery/hybrid_slow_start.rs",
      "target_path": "https://tools.ietf.org/id/draft-ietf-tcpm-hystartplusplus-04.txt",
      "target_section": "section-4.3",
      "type": "CITATION"
    },
    {
      "id": "04fdbaaa99ae6be9",
      "level": "Auto",
      "line": 7,
      "quote": "The RECOMMENDED initial value for the packet reordering threshold (kPacketThreshold) is 3, based on best practices for TCP loss detection [RFC5681] [RFC6675].  In order to remain similar to TCP, implementations SHOULD NOT use a packet threshold less than 3; see [RFC5681].",
      "source": "quic/s2n-quic-core/src/recovery/loss.rs",
      "target_path": "https://www.rfc-editor.org/rfc/rfc9002",
      "target_section": "section-6.1.1",
      "type": "CITATION"
    },
    {
      "id": "29557453ab628c65",
      "level": "Auto",
      "line": 54,
      "quote": "A packet is declared lost if it meets all of the following conditions: *  The packet is unacknowledged, in flight, and was sent prior to an acknowledged packet. *  The packet was sent kPacketThreshold packets before an acknowledged packet (Section 6.1.1), or it was sent long enough in the past (Section 6.1.2).",
      "source": "quic/s2n-quic-core/src/recovery/loss.rs",
      "target_path": "https://www.rfc-editor.org/rfc/rfc9002",
      "target_section": "section-6.1",
      "type": "CITATION"
    },
    {
      "id": "abb7cf127c9cd3cf",
      "level": "Auto",
      "line": 78,
      "quote": "The RECOMMENDED initial value for the packet reordering threshold (kPacketThreshold) is 3, based on best practices for TCP loss detection [RFC5681] [RFC6675].",
      "source": "quic/s2n-quic-core/src/recovery/loss.rs",
      "target_path": "https://www.rfc-editor.org/rfc/rfc9002",
      "target_section": "section-6.1.1",
      "type": "TEST"
    },
    {
      "id": "161a9bc2bd881036",
      "level": "Auto",
      "line": 84,
      "quote": "In order to remain similar to TCP, implementations SHOULD NOT use a packet threshold less than 3; see [RFC5681].",
      "source": "quic/s2n-quic-core/src/recovery/loss.rs",
      "target_path": "https://www.rfc-editor.org/rfc/rfc9002",
      "target_section": "section-6.1.1",
      "type": "TEST"
    },
    {
      "id": "8baaf4eb248a1d44",
      "level": "Auto",
      "line": 25,
      "quote": "Senders SHOULD limit bursts to the initial congestion window; see Section 7.2.",
      "source": "quic/s2n-quic-core/src/recovery/mod.rs",
      "target_path": "https://www.rfc-editor.org/rfc/rfc9002",
      "target_section": "section-7.7",
      "type": "CITATION"
    },
    {
      "id": "6acb57e6056ee130",
      "level": "Auto",
      "line": 29,
      "quote": "Endpoints SHOULD use an initial congestion window of ten times the maximum datagram size (max_datagram_size), while limiting the window to the larger of 14,720 bytes or twice the maximum datagram size.",
      "source": "quic/s2n-quic-core/src/recovery/mod.rs",
      "target_path": "https://www.rfc-editor.org/rfc/rfc9002",
      "target_section": "section-7.2",
      "type": "CITATION"
    },
    {
      "feature": "Packet pacing",
      "id": "615f733d5f40e5cb",
      "level": "Auto",
      "line": 35,
      "quote": "A sender with knowledge that the network path to the receiver can absorb larger bursts MAY use a higher limit.",
      "source": "quic/s2n-quic-core/src/recovery/mod.rs",
      "target_path": "https://www.rfc-editor.org/rfc/rfc9002",
      "target_section": "section-7.7",
      "tracking_issue": "1073",
      "type": "TODO"
    },
    {
      "id": "58186f61d1351453",
      "level": "Auto",
      "line": 303,
      "quote": "A perfectly paced sender spreads packets exactly evenly over time. For a window-based congestion controller, such as the one in this document, that rate can be computed by averaging the congestion window over the RTT. Expressed as a rate in units of bytes per time, where congestion_window is in bytes: rate = N * congestion_window / smoothed_rtt Or expressed as an inter-packet interval in units of time: interval = ( smoothed_rtt * packet_size / congestion_window ) / N",
      "source": "quic/s2n-quic-core/src/recovery/pacing/tests.rs",
      "target_path": "https://www.rfc-editor.org/rfc/rfc9002",
      "target_section": "section-7.7",
      "type": "TEST"
    },
    {
      "id": "3cb8e5e1c6369a57",
      "level": "Auto",
      "line": 13,
      "quote": "Using a value for \"N\" that is small, but at least 1 (for example, 1.25) ensures that variations in RTT do not result in underutilization of the congestion window.",
      "source": "quic/s2n-quic-core/src/recovery/pacing.rs",
      "target_path": "https://www.rfc-editor.org/rfc/rfc9002",
      "target_section": "section-7.7",
      "type": "CITATION"
    },
    {
      "id": "82f5adce235cd6ad",
      "level": "Auto",
      "line": 101,
      "quote": "A perfectly paced sender spreads packets exactly evenly over time. For a window-based congestion controller, such as the one in this document, that rate can be computed by averaging the congestion window over the RTT. Expressed as a rate in units of bytes per time, where congestion_window is in bytes: rate = N * congestion_window / smoothed_rtt",
      "source": "quic/s2n-quic-core/src/recovery/pacing.rs",
      "target_path": "https://www.rfc-editor.org/rfc/rfc9002",
      "target_section": "section-7.7",
      "type": "CITATION"
    },
    {
      "id": "860c1d9fea846e30",
      "level": "Auto",
      "line": 40,
      "quote": "The persistent congestion period SHOULD NOT start until there is at least one RTT sample.  Before the first RTT sample, a sender arms its PTO timer based on the initial RTT (Section 6.2.2), which could be substantially larger than the actual RTT.  Requiring a prior RTT sample prevents a sender from establishing persistent congestion with potentially too few probes.",
      "source": "quic/s2n-quic-core/src/recovery/persistent_congestion.rs",
      "target_path": "https://www.rfc-editor.org/rfc/rfc9002",
      "target_section": "section-7.6.2",
      "type": "CITATION"
    },
    {
      "id": "219350f31870747c",
      "level": "Auto",
      "line": 59,
      "quote": "Loss of a QUIC packet that is carried in a PMTU probe is therefore not a reliable indication of congestion and SHOULD NOT trigger a congestion control reaction; see Item 7 in Section 3 of [DPLPMTUD].",
      "source": "quic/s2n-quic-core/src/recovery/persistent_congestion.rs",
      "target_path": "https://www.rfc-editor.org/rfc/rfc9000",
      "target_section": "section-14.4",
      "type": "CITATION"
    },
    {
      "id": "755d847798e7812a",
      "level": "Auto",
      "line": 68,
      "quote": "A sender establishes persistent congestion after the receipt of an acknowledgment if two packets that are ack-eliciting are declared lost, and: *  across all packet number spaces, none of the packets sent between the send times of these two packets are acknowledged;",
      "source": "quic/s2n-quic-core/src/recovery/persistent_congestion.rs",
      "target_path": "https://www.rfc-editor.org/rfc/rfc9002",
      "target_section": "section-7.6.2",
      "type": "CITATION"
    },
    {
      "id": "055d69735a042efe",
      "level": "Auto",
      "line": 91,
      "quote": "These two packets MUST be ack-eliciting, since a receiver is required to acknowledge only ack-eliciting packets within its maximum acknowledgment delay; see Section 13.2 of [QUIC-TRANSPORT].",
      "source": "quic/s2n-quic-core/src/recovery/persistent_congestion.rs",
      "target_path": "https://www.rfc-editor.org/rfc/rfc9002",
      "target_section": "section-7.6.2",
      "type": "CITATION"
    },
    {
      "id": "d42d9548813f5739",
      "level": "Auto",
      "line": 135,
      "quote": "These two packets MUST be ack-eliciting, since a receiver is required to acknowledge only ack-eliciting packets within its maximum acknowledgment delay; see Section 13.2 of [QUIC-TRANSPORT].",
      "source": "quic/s2n-quic-core/src/recovery/persistent_congestion.rs",
      "target_path": "https://www.rfc-editor.org/rfc/rfc9002",
      "target_section": "section-7.6.2",
      "type": "CITATION"
    },
    {
      "id": "85a58012b86ba8b4",
      "level": "Auto",
      "line": 26,
      "quote": "When a PTO timer expires, a sender MUST send at least one ack- eliciting packet in the packet number space as a probe.",
      "source": "quic/s2n-quic-core/src/recovery/pto.rs",
      "target_path": "https://www.rfc-editor.org/rfc/rfc9002",
      "target_section": "section-6.2.4",
      "type": "CITATION"
    },
    {
      "id": "fe379c3d7ecbf299",
      "level": "Auto",
      "line": 30,
      "quote": "Since the server could be blocked until more datagrams are received from the client, it is the client's responsibility to send packets to unblock the server until it is certain that the server has finished its address validation",
      "source": "quic/s2n-quic-core/src/recovery/pto.rs",
      "target_path": "https://www.rfc-editor.org/rfc/rfc9002",
      "target_section": "section-6.2.2.1",
      "type": "CITATION"
    },
    {
      "id": "5c3504a09973c51b",
      "level": "Auto",
      "line": 36,
      "quote": "An endpoint MAY send up to two full-sized datagrams containing ack-eliciting packets to avoid an expensive consecutive PTO expiration due to a single lost datagram or to transmit data from multiple packet number spaces.",
      "source": "quic/s2n-quic-core/src/recovery/pto.rs",
      "target_path": "https://www.rfc-editor.org/rfc/rfc9002",
      "target_section": "section-6.2.4",
      "type": "CITATION"
    },
    {
      "id": "1c53e84a391b0c9f",
      "level": "Auto",
      "line": 43,
      "quote": "Sending two packets on PTO expiration increases resilience to packet drops, thus reducing the probability of consecutive PTO events.",
      "source": "quic/s2n-quic-core/src/recovery/pto.rs",
      "target_path": "https://www.rfc-editor.org/rfc/rfc9002",
      "target_section": "section-6.2.4",
      "type": "CITATION"
    },
    {
      "id": "cfb2099e4e4d19ef",
      "level": "Auto",
      "line": 54,
      "quote": "A sender SHOULD restart its PTO timer every time an ack-eliciting packet is sent or acknowledged, or when Initial or Handshake keys are discarded (Section 4.9 of [QUIC-TLS]).",
      "source": "quic/s2n-quic-core/src/recovery/pto.rs",
      "target_path": "https://www.rfc-editor.org/rfc/rfc9002",
      "target_section": "section-6.2.1",
      "type": "CITATION"
    },
    {
      "id": "4b750a90452391da",
      "level": "Auto",
      "line": 107,
      "quote": "All probe packets sent on a PTO MUST be ack-eliciting.",
      "source": "quic/s2n-quic-core/src/recovery/pto.rs",
      "target_path": "https://www.rfc-editor.org/rfc/rfc9002",
      "target_section": "section-6.2.4",
      "type": "CITATION"
    },
    {
      "id": "87f720eeddeb6dce",
      "level": "Auto",
      "line": 110,
      "quote": "When there is no data to send, the sender SHOULD send a PING or other ack-eliciting frame in a single packet, re-arming the PTO timer.",
      "source": "quic/s2n-quic-core/src/recovery/pto.rs",
      "target_path": "https://www.rfc-editor.org/rfc/rfc9002",
      "target_section": "section-6.2.4",
      "type": "CITATION"
    },
    {
      "id": "f5b88cfeca0cf5dc",
      "level": "Auto",
      "line": 116,
      "quote": "Probe packets MUST NOT be blocked by the congestion controller.",
      "source": "quic/s2n-quic-core/src/recovery/pto.rs",
      "target_path": "https://www.rfc-editor.org/rfc/rfc9002",
      "target_section": "section-7.5",
      "type": "CITATION"
    },
    {
      "id": "12dca41cd9c20df6",
      "level": "Auto",
      "line": 121,
      "quote": "When the PTO fires, the client MUST send a Handshake packet if it has Handshake keys, otherwise it MUST send an Initial packet in a UDP datagram with a payload of at least 1200 bytes.",
      "source": "quic/s2n-quic-core/src/recovery/pto.rs",
      "target_path": "https://www.rfc-editor.org/rfc/rfc9002",
      "target_section": "section-6.2.2.1",
      "type": "CITATION"
    },
    {
      "id": "ec350f7b969d4875",
      "level": "Auto",
      "line": 126,
      "quote": "// Client sends an anti-deadlock packet: Initial is padded // to earn more anti-amplification credit, // a Handshake packet proves address ownership.",
      "source": "quic/s2n-quic-core/src/recovery/pto.rs",
      "target_path": "https://www.rfc-editor.org/rfc/rfc9002",
      "target_section": "appendix-A.9",
      "type": "CITATION"
    },
    {
      "id": "1b6d63d465a9d6cd",
      "level": "Auto",
      "line": 229,
      "quote": "All probe packets sent on a PTO MUST be ack-eliciting.",
      "source": "quic/s2n-quic-core/src/recovery/pto.rs",
      "target_path": "https://www.rfc-editor.org/rfc/rfc9002",
      "target_section": "section-6.2.4",
      "type": "TEST"
    },
    {
      "id": "1e1ca2c2722b8e80",
      "level": "Auto",
      "line": 233,
      "quote": "When a PTO timer expires, a sender MUST send at least one ack- eliciting packet in the packet number space as a probe.",
      "source": "quic/s2n-quic-core/src/recovery/pto.rs",
      "target_path": "https://www.rfc-editor.org/rfc/rfc9002",
      "target_section": "section-6.2.4",
      "type": "TEST"
    },
    {
      "id": "5d650893388b102f",
      "level": "Auto",
      "line": 238,
      "quote": "When there is no data to send, the sender SHOULD send a PING or other ack-eliciting frame in a single packet, re-arming the PTO timer.",
      "source": "quic/s2n-quic-core/src/recovery/pto.rs",
      "target_path": "https://www.rfc-editor.org/rfc/rfc9002",
      "target_section": "section-6.2.4",
      "type": "TEST"
    },
    {
      "id": "5544f519d146b7bd",
      "level": "Auto",
      "line": 250,
      "quote": "All probe packets sent on a PTO MUST be ack-eliciting.",
      "source": "quic/s2n-quic-core/src/recovery/pto.rs",
      "target_path": "https://www.rfc-editor.org/rfc/rfc9002",
      "target_section": "section-6.2.4",
      "type": "TEST"
    },
    {
      "id": "09f1100027fe05a1",
      "level": "Auto",
      "line": 254,
      "quote": "When a PTO timer expires, a sender MUST send at least one ack- eliciting packet in the packet number space as a probe.",
      "source": "quic/s2n-quic-core/src/recovery/pto.rs",
      "target_path": "https://www.rfc-editor.org/rfc/rfc9002",
      "target_section": "section-6.2.4",
      "type": "TEST"
    },
    {
      "id": "01061e51b92464af",
      "level": "Auto",
      "line": 12,
      "quote": "When no previous RTT is available, the initial RTT SHOULD be set to 333 milliseconds.  This results in handshakes starting with a PTO of 1 second, as recommended for TCP's initial RTO; see Section 2 of [RFC6298].",
      "source": "quic/s2n-quic-core/src/recovery/rtt_estimator.rs",
      "target_path": "https://www.rfc-editor.org/rfc/rfc9002",
      "target_section": "section-6.2.2",
      "type": "CITATION"
    },
    {
      "id": "6468572b659f3298",
      "level": "Auto",
      "line": 24,
      "quote": "The RECOMMENDED value of the timer granularity (kGranularity) is 1 millisecond.",
      "source": "quic/s2n-quic-core/src/recovery/rtt_estimator.rs",
      "target_path": "https://www.rfc-editor.org/rfc/rfc9002",
      "target_section": "section-6.1.2",
      "type": "CITATION"
    },
    {
      "id": "31ae9a0c2946cdfc",
      "level": "Auto",
      "line": 28,
      "quote": "The RECOMMENDED value for kPersistentCongestionThreshold is 3, which results in behavior that is approximately equivalent to a TCP sender declaring an RTO after two TLPs.",
      "source": "quic/s2n-quic-core/src/recovery/rtt_estimator.rs",
      "target_path": "https://www.rfc-editor.org/rfc/rfc9002",
      "target_section": "section-7.6.1",
      "type": "CITATION"
    },
    {
      "id": "b59f9cc03a858b36",
      "level": "Auto",
      "line": 75,
      "quote": "Before any RTT samples are available for a new path or when the estimator is reset, the estimator is initialized using the initial RTT; see Section 6.2.2. smoothed_rtt and rttvar are initialized as follows, where kInitialRtt contains the initial RTT value:",
      "source": "quic/s2n-quic-core/src/recovery/rtt_estimator.rs",
      "target_path": "https://www.rfc-editor.org/rfc/rfc9002",
      "target_section": "section-5.3",
      "type": "CITATION"
    },
    {
      "id": "5040cc1ae20351f7",
      "level": "Auto",
      "line": 139,
      "quote": "The PTO period is the amount of time that a sender ought to wait for an acknowledgement of a sent packet.",
      "source": "quic/s2n-quic-core/src/recovery/rtt_estimator.rs",
      "target_path": "https://www.rfc-editor.org/rfc/rfc9002",
      "target_section": "section-6.2.1",
      "type": "CITATION"
    },
    {
      "id": "35184366f667ec58",
      "level": "Auto",
      "line": 147,
      "quote": "When an ack-eliciting packet is transmitted, the sender schedules a timer for the PTO period as follows: PTO = smoothed_rtt + max(4*rttvar, kGranularity) + max_ack_delay",
      "source": "quic/s2n-quic-core/src/recovery/rtt_estimator.rs",
      "target_path": "https://www.rfc-editor.org/rfc/rfc9002",
      "target_section": "section-6.2.1",
      "type": "CITATION"
    },
    {
      "id": "8ac90f508dcc2554",
      "level": "Auto",
      "line": 154,
      "quote": "The PTO period MUST be at least kGranularity, to avoid the timer expiring immediately.",
      "source": "quic/s2n-quic-core/src/recovery/rtt_estimator.rs",
      "target_path": "https://www.rfc-editor.org/rfc/rfc9002",
      "target_section": "section-6.2.1",
      "type": "CITATION"
    },
    {
      "id": "eb62b97d5cd685a3",
      "level": "Auto",
      "line": 162,
      "quote": "When the PTO is armed for Initial or Handshake packet number spaces, the max_ack_delay in the PTO period computation is set to 0, since the peer is expected to not delay these packets intentionally; see Section 13.2.1 of [QUIC-TRANSPORT].",
      "source": "quic/s2n-quic-core/src/recovery/rtt_estimator.rs",
      "target_path": "https://www.rfc-editor.org/rfc/rfc9002",
      "target_section": "section-6.2.1",
      "type": "CITATION"
    },
    {
      "id": "993e2750146a6793",
      "level": "Auto",
      "line": 171,
      "quote": "Even when there are ack-eliciting packets in flight in multiple packet number spaces, the exponential increase in PTO occurs across all spaces to prevent excess load on the network.  For example, a timeout in the Initial packet number space doubles the length of the timeout in the Handshake packet number space.",
      "source": "quic/s2n-quic-core/src/recovery/rtt_estimator.rs",
      "target_path": "https://www.rfc-editor.org/rfc/rfc9002",
      "target_section": "section-6.2.1",
      "type": "CITATION"
    },
    {
      "id": "66164cdfa3a7375b",
      "level": "Auto",
      "line": 179,
      "quote": "The PTO period is the amount of time that a sender ought to wait for an acknowledgement of a sent packet.",
      "source": "quic/s2n-quic-core/src/recovery/rtt_estimator.rs",
      "target_path": "https://www.rfc-editor.org/rfc/rfc9002",
      "target_section": "section-6.2.1",
      "type": "CITATION"
    },
    {
      "id": "23ebf841357e91a4",
      "level": "Auto",
      "line": 204,
      "quote": "min_rtt MUST be set to the latest_rtt on the first RTT sample.",
      "source": "quic/s2n-quic-core/src/recovery/rtt_estimator.rs",
      "target_path": "https://www.rfc-editor.org/rfc/rfc9002",
      "target_section": "section-5.2",
      "type": "CITATION"
    },
    {
      "id": "3acd98099138c57b",
      "level": "Auto",
      "line": 207,
      "quote": "On the first RTT sample after initialization, smoothed_rtt and rttvar are set as follows: smoothed_rtt = latest_rtt rttvar = latest_rtt / 2",
      "source": "quic/s2n-quic-core/src/recovery/rtt_estimator.rs",
      "target_path": "https://www.rfc-editor.org/rfc/rfc9002",
      "target_section": "section-5.3",
      "type": "CITATION"
    },
    {
      "id": "186f4960aa82fcc3",
      "level": "Auto",
      "line": 218,
      "quote": "min_rtt MUST be set to the lesser of min_rtt and latest_rtt (Section 5.1) on all other samples.",
      "source": "quic/s2n-quic-core/src/recovery/rtt_estimator.rs",
      "target_path": "https://www.rfc-editor.org/rfc/rfc9002",
      "target_section": "section-5.2",
      "type": "CITATION"
    },
    {
      "id": "8e4285b013065e5d",
      "level": "Auto",
      "line": 223,
      "quote": "when adjusting an RTT sample using peer-reported acknowledgment delays, an endpoint: *  MAY ignore the acknowledgment delay for Initial packets, since these acknowledgments are not delayed by the peer (Section 13.2.1 of [QUIC-TRANSPORT]);",
      "source": "quic/s2n-quic-core/src/recovery/rtt_estimator.rs",
      "target_path": "https://www.rfc-editor.org/rfc/rfc9002",
      "target_section": "section-5.3",
      "type": "CITATION"
    },
    {
      "id": "8a5eb849c74868d1",
      "level": "Auto",
      "line": 234,
      "quote": "To account for this, the endpoint SHOULD ignore max_ack_delay until the handshake is confirmed, as defined in Section 4.1.2 of [QUIC-TLS].",
      "source": "quic/s2n-quic-core/src/recovery/rtt_estimator.rs",
      "target_path": "https://www.rfc-editor.org/rfc/rfc9002",
      "target_section": "section-5.3",
      "type": "CITATION"
    },
    {
      "id": "841529c88d7393e4",
      "level": "Auto",
      "line": 239,
      "quote": "*  SHOULD ignore the peer's max_ack_delay until the handshake is confirmed;",
      "source": "quic/s2n-quic-core/src/recovery/rtt_estimator.rs",
      "target_path": "https://www.rfc-editor.org/rfc/rfc9002",
      "target_section": "section-5.3",
      "type": "CITATION"
    },
    {
      "id": "ae07a593a5e1494b",
      "level": "Auto",
      "line": 243,
      "quote": "*  MUST use the lesser of the acknowledgement delay and the peer's max_ack_delay after the handshake is confirmed; and",
      "source": "quic/s2n-quic-core/src/recovery/rtt_estimator.rs",
      "target_path": "https://www.rfc-editor.org/rfc/rfc9002",
      "target_section": "section-5.3",
      "type": "CITATION"
    },
    {
      "id": "35352745e00c890e",
      "level": "Auto",
      "line": 251,
      "quote": "*  MUST NOT subtract the acknowledgement delay from the RTT sample if the resulting value is smaller than the min_rtt.",
      "source": "quic/s2n-quic-core/src/recovery/rtt_estimator.rs",
      "target_path": "https://www.rfc-editor.org/rfc/rfc9002",
      "target_section": "section-5.3",
      "type": "CITATION"
    },
    {
      "id": "cd487125fa58a81c",
      "level": "Auto",
      "line": 257,
      "quote": "Therefore, prior to handshake confirmation, an endpoint MAY ignore RTT samples if adjusting the RTT sample for acknowledgement delay causes the sample to be less than the min_rtt.",
      "source": "quic/s2n-quic-core/src/recovery/rtt_estimator.rs",
      "target_path": "https://www.rfc-editor.org/rfc/rfc9002",
      "target_section": "section-5.3",
      "type": "CITATION"
    },
    {
      "id": "d3cf8ee4749535ab",
      "level": "Auto",
      "line": 265,
      "quote": "On subsequent RTT samples, smoothed_rtt and rttvar evolve as follows: ack_delay = decoded acknowledgment delay from ACK frame if (handshake confirmed): ack_delay = min(ack_delay, max_ack_delay) adjusted_rtt = latest_rtt if (latest_rtt >= min_rtt + ack_delay): adjusted_rtt = latest_rtt - ack_delay smoothed_rtt = 7/8 * smoothed_rtt + 1/8 * adjusted_rtt rttvar_sample = abs(smoothed_rtt - adjusted_rtt) rttvar = 3/4 * rttvar + 1/4 * rttvar_sample",
      "source": "quic/s2n-quic-core/src/recovery/rtt_estimator.rs",
      "target_path": "https://www.rfc-editor.org/rfc/rfc9002",
      "target_section": "section-5.3",
      "type": "CITATION"
    },
    {
      "id": "4e676ff3c99ada6a",
      "level": "Auto",
      "line": 291,
      "quote": "The persistent congestion duration is computed as follows: (smoothed_rtt + max(4*rttvar, kGranularity) + max_ack_delay) * kPersistentCongestionThreshold Unlike the PTO computation in Section 6.2, this duration includes the max_ack_delay irrespective of the packet number spaces in which losses are established. This duration allows a sender to send as many packets before establishing persistent congestion, including some in response to PTO expiration, as TCP does with Tail Loss Probes [RFC8985] and an RTO [RFC5681].",
      "source": "quic/s2n-quic-core/src/recovery/rtt_estimator.rs",
      "target_path": "https://www.rfc-editor.org/rfc/rfc9002",
      "target_section": "section-7.6.1",
      "type": "CITATION"
    },
    {
      "id": "5a2068dd1bad87a6",
      "level": "Auto",
      "line": 318,
      "quote": "The time threshold is: max(kTimeThreshold * max(smoothed_rtt, latest_rtt), kGranularity)",
      "source": "quic/s2n-quic-core/src/recovery/rtt_estimator.rs",
      "target_path": "https://www.rfc-editor.org/rfc/rfc9002",
      "target_section": "section-6.1.2",
      "type": "CITATION"
    },
    {
      "id": "35512c0db9658474",
      "level": "Auto",
      "line": 327,
      "quote": "The RECOMMENDED time threshold (kTimeThreshold), expressed as an RTT multiplier, is 9/8.",
      "source": "quic/s2n-quic-core/src/recovery/rtt_estimator.rs",
      "target_path": "https://www.rfc-editor.org/rfc/rfc9002",
      "target_section": "section-6.1.2",
      "type": "CITATION"
    },
    {
      "id": "7e69ba4620851bfa",
      "level": "Auto",
      "line": 332,
      "quote": "To avoid declaring packets as lost too early, this time threshold MUST be set to at least the local timer granularity, as indicated by the kGranularity constant.",
      "source": "quic/s2n-quic-core/src/recovery/rtt_estimator.rs",
      "target_path": "https://www.rfc-editor.org/rfc/rfc9002",
      "target_section": "section-6.1.2",
      "type": "CITATION"
    },
    {
      "id": "46db57fc3684cf2f",
      "level": "Auto",
      "line": 346,
      "quote": "Endpoints SHOULD set the min_rtt to the newest RTT sample after persistent congestion is established.",
      "source": "quic/s2n-quic-core/src/recovery/rtt_estimator.rs",
      "target_path": "https://www.rfc-editor.org/rfc/rfc9002",
      "target_section": "section-5.2",
      "type": "CITATION"
    },
    {
      "id": "83269f2e9c58a82d",
      "level": "Auto",
      "line": 447,
      "quote": "*  MUST use the lesser of the acknowledgement delay and the peer's max_ack_delay after the handshake is confirmed;",
      "source": "quic/s2n-quic-core/src/recovery/rtt_estimator.rs",
      "target_path": "https://www.rfc-editor.org/rfc/rfc9002",
      "target_section": "section-5.3",
      "type": "TEST"
    },
    {
      "id": "25043f14f27bfdc4",
      "level": "Auto",
      "line": 477,
      "quote": "*  MUST use the lesser of the acknowledgement delay and the peer's max_ack_delay after the handshake is confirmed; and",
      "source": "quic/s2n-quic-core/src/recovery/rtt_estimator.rs",
      "target_path": "https://www.rfc-editor.org/rfc/rfc9002",
      "target_section": "section-5.3",
      "type": "TEST"
    },
    {
      "id": "11f224b0fbbb9895",
      "level": "Auto",
      "line": 498,
      "quote": "To account for this, the endpoint SHOULD ignore max_ack_delay until the handshake is confirmed, as defined in Section 4.1.2 of [QUIC-TLS].",
      "source": "quic/s2n-quic-core/src/recovery/rtt_estimator.rs",
      "target_path": "https://www.rfc-editor.org/rfc/rfc9002",
      "target_section": "section-5.3",
      "type": "TEST"
    },
    {
      "id": "e971e3d6e543adc7",
      "level": "Auto",
      "line": 504,
      "quote": "*  SHOULD ignore the peer's max_ack_delay until the handshake is confirmed;",
      "source": "quic/s2n-quic-core/src/recovery/rtt_estimator.rs",
      "target_path": "https://www.rfc-editor.org/rfc/rfc9002",
      "target_section": "section-5.3",
      "type": "TEST"
    },
    {
      "id": "f8a5fa09bac58f72",
      "level": "Auto",
      "line": 530,
      "quote": "min_rtt MUST be set to the latest_rtt on the first RTT sample.",
      "source": "quic/s2n-quic-core/src/recovery/rtt_estimator.rs",
      "target_path": "https://www.rfc-editor.org/rfc/rfc9002",
      "target_section": "section-5.2",
      "type": "TEST"
    },
    {
      "id": "347b1679ab91e7fa",
      "level": "Auto",
      "line": 574,
      "quote": "min_rtt MUST be set to the lesser of min_rtt and latest_rtt (Section 5.1) on all other samples.",
      "source": "quic/s2n-quic-core/src/recovery/rtt_estimator.rs",
      "target_path": "https://www.rfc-editor.org/rfc/rfc9002",
      "target_section": "section-5.2",
