      "target_path": "https://www.rfc-editor.org/rfc/rfc9000",
      "target_section": "section-7.4.1",
      "tracking_issue": "355",
      "type": "TODO"
    },
    {
      "feature": "0-RTT",
      "id": "262ad79b41105aeb",
      "level": "Auto",
      "line": 47,
      "quote": "A server MAY store and recover the previously sent values of the max_idle_timeout, max_udp_payload_size, and disable_active_migration parameters and reject 0-RTT if it selects smaller values.",
      "source": "specs/todos/transport/7.4.1.toml",
      "target_path": "https://www.rfc-editor.org/rfc/rfc9000",
      "target_section": "section-7.4.1",
      "tracking_issue": "355",
      "type": "TODO"
    },
    {
      "feature": "0-RTT",
      "id": "2ad7f0989135654d",
      "level": "Auto",
      "line": 56,
