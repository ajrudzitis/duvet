    },
    {
      "feature": "0-RTT",
      "id": "741f4a92e4f279aa",
      "level": "Auto",
      "line": 20,
      "quote": "If 0-RTT data is accepted by the server, the server MUST NOT reduce any limits or alter any values that might be violated by the client with its 0-RTT data.",
