    },
    {
      "id": "0f2abebe1358449a",
      "level": "Auto",
      "line": 352,
      "quote": "A receiver MUST ignore any Retire Prior To fields that do not increase the largest received Retire Prior To value.",
      "source": "quic/s2n-quic-transport/src/connection/peer_id_registry.rs",
      "target_path": "https://www.rfc-editor.org/rfc/rfc9000",
      "target_section": "section-19.15",
