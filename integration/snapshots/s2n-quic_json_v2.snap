      "target_path": "https://www.rfc-editor.org/rfc/rfc9000",
      "target_section": "section-7.4.1",
      "tracking_issue": "355",
      "type": "TODO"
    },
    {
      "feature": "0-RTT",
      "id": "29028a761b630927",
      "level": "Auto",
      "line": 29,
      "quote": "In particular, a server that accepts 0-RTT data MUST NOT set values for the following parameters (Section 18.2) that are smaller than the remembered values of the parameters.",
      "source": "specs/todos/transport/7.4.1.toml",
      "target_path": "https://www.rfc-editor.org/rfc/rfc9000",
      "target_section": "section-7.4.1",
      "tracking_issue": "355",
      "type": "TODO"
    },
    {
      "feature": "0-RTT",
      "id": "96a82e6227e82455",
      "level": "Auto",
      "line": 38,
      "quote": "The applicable subset of transport parameters that permit the sending of application data SHOULD be set to non-zero values for 0-RTT.",
