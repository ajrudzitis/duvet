    },
    {
      "id": "b6987807d6441a26",
      "level": "Auto",
      "line": 301,
      "quote": "The sequence number of the initial connection ID is 0.",
      "source": "quic/s2n-quic-transport/src/connection/peer_id_registry.rs",
