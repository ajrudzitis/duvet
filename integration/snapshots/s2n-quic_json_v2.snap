      "type": "CITATION"
    },
    {
      "id": "91206d134e8d1e9e",
      "level": "Auto",
      "line": 26,
      "quote": "",
      "source": "quic/s2n-quic-events/events/endpoint.rs",
      "target_path": "https://tools.ietf.org/id/draft-marx-qlog-event-definitions-quic-h3-02",
      "target_section": "5.3.6",
      "type": "CITATION"
    },
    {
      "id": "9fe8cdb4826079e3",
