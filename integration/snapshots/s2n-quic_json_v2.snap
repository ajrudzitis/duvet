    },
    {
      "id": "ce91fbd23a65cdaf",
      "level": "Auto",
      "line": 295,
      "quote": "Before a stream is created, all streams of the same type with lower- numbered stream IDs MUST be created.  This ensures that the creation order for streams is consistent on both endpoints.",
      "source": "quic/s2n-quic-transport/src/stream/manager.rs",
      "target_path": "https://www.rfc-editor.org/rfc/rfc9000",
      "target_section": "section-3.2",
      "type": "CITATION"
    },
    {
      "id": "4be7241d7fcd5cef",
      "level": "Auto",
      "line": 303,
      "quote": "A QUIC endpoint MUST NOT reuse a stream ID within a connection.",
      "source": "quic/s2n-quic-transport/src/stream/manager.rs",
      "target_path": "https://www.rfc-editor.org/rfc/rfc9000",
      "target_section": "section-2.1",
