    },
    {
      "id": "7b2c31893845ee0b",
      "level": "Auto",
      "line": 1001,
      "quote": "Prior to validating the client address, servers MUST NOT send more than three times as many bytes as the number of bytes they have received.",
      "source": "quic/s2n-quic-transport/src/path/mod.rs",
      "target_path": "https://www.rfc-editor.org/rfc/rfc9000",
