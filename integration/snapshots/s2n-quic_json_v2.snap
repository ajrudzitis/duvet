                "text": "       "
              },
              {
                "annotation_ids": [
                  "9b068a126ff2ab86"
                ],
                "status_id": 1,
                "text": "|        V                 |"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "       "
              },
              {
                "annotation_ids": [
                  "9b068a126ff2ab86"
                ],
                "status_id": 1,
                "text": "+---> ProbeBW_DOWN  -------+"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "       "
              },
              {
                "annotation_ids": [
                  "9b068a126ff2ab86"
                ],
                "status_id": 1,
                "text": "| ^      |                 |"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "       "
              },
              {
                "annotation_ids": [
                  "9b068a126ff2ab86"
                ],
                "status_id": 1,
                "text": "| |      V                 |"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "       "
              },
              {
                "annotation_ids": [
                  "9b068a126ff2ab86"
                ],
                "status_id": 1,
                "text": "| |   ProbeBW_CRUISE ------+"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "       "
              },
              {
                "annotation_ids": [
                  "9b068a126ff2ab86"
                ],
                "status_id": 1,
                "text": "| |      |                 |"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "       "
              },
              {
                "annotation_ids": [
                  "9b068a126ff2ab86"
                ],
                "status_id": 1,
                "text": "| |      V                 |"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "       "
              },
              {
                "annotation_ids": [
                  "9b068a126ff2ab86"
                ],
                "status_id": 1,
                "text": "| |   ProbeBW_REFILL  -----+"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "       "
              },
              {
                "annotation_ids": [
                  "9b068a126ff2ab86"
                ],
                "status_id": 1,
                "text": "| |      |                 |"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "       "
              },
              {
                "annotation_ids": [
                  "9b068a126ff2ab86"
                ],
                "status_id": 1,
                "text": "| |      V                 |"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "       "
              },
              {
                "annotation_ids": [
                  "9b068a126ff2ab86"
                ],
                "status_id": 1,
                "text": "| |   ProbeBW_UP  ---------+"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "       "
              },
              {
                "annotation_ids": [
                  "9b068a126ff2ab86"
                ],
                "status_id": 1,
                "text": "| |      |                 |"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "       "
              },
              {
                "annotation_ids": [
                  "9b068a126ff2ab86"
                ],
                "status_id": 1,
                "text": "| +------+                 |"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "       "
              },
              {
                "annotation_ids": [
                  "9b068a126ff2ab86"
                ],
                "status_id": 1,
                "text": "|                          |"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "       "
              },
              {
                "annotation_ids": [
                  "9b068a126ff2ab86"
                ],
                "status_id": 1,
                "text": "+---- ProbeRTT <-----------+"
              }
            ]
          ],
          "title": "State Transition Diagram"
        },
        {
          "id": "section-4.1.2",
          "lines": [
            "   When starting up, BBR probes to try to quickly build a model of the",
            "   network path; to adapt to later changes to the path or its traffic,",
            "   BBR must continue to probe to update its model.  If the available",
            "   bottleneck bandwidth increases, BBR must send faster to discover",
            "   this.  Likewise, if the round-trip propagation delay changes, this",
            "   changes the BDP, and thus BBR must send slower to get inflight below",
            "   the new BDP in order to measure the new BBR.min_rtt.  Thus, BBR's",
            "   state machine runs periodic, sequential experiments, sending faster",
            "   to check for BBR.bw increases or sending slower to yield bandwidth,",
            "   drain the queue, and check for BBR.min_rtt decreases.  The frequency,",
            "   magnitude, duration, and structure of these experiments differ",
            "   depending on what's already known (startup or steady-state) and",
            "   application sending behavior (intermittent or continuous).",
            "",
            "   This state machine has several goals:",
            "",
            "   *  Achieve high throughput by efficiently utilizing available",
            "      bandwidth.",
            "",
            "   *  Achieve low latency and packet loss rates by keeping queues",
            "      bounded and small.",
            "",
            "   *  Share bandwidth with other flows in an approximately fair manner.",
            "",
            "   *  Feed samples to the model estimators to refresh and update the",
            "      model."
          ],
          "title": "State Machine Operation Overview"
        },
        {
          "id": "section-4.1.3",
          "lines": [
            "   In the BBR framework, at any given time the sender can choose one of",
            "   the following tactics:",
            "",
            "   *  Acceleration: Send faster then the network is delivering data: to",
            "      probe the maximum bandwidth available to the flow",
            "",
            "   *  Cruising: Send at the same rate the network is delivering data:",
            "      try to match the sending rate to the flow's current available",
            "      bandwidth, to try to achieve high utilization of the available",
            "      bandwidth without increasing queue pressure",
            "",
            "   *  Deceleration: Send slower than the network is delivering data: to",
            "      reduce the amount of data in flight, with a number of overlapping",
            "      motivations:",
            "",
            "      -  Reducing queuing delay: to reduce queuing delay, to reduce",
            "         latency for request/response cross-traffic (e.g.  RPC, web",
            "         traffic).",
            "",
            "      -  Reducing packet loss: to reduce packet loss, to reduce tail",
            "         latency for request/response cross-traffic (e.g.  RPC, web",
            "         traffic) and improve coexistence with Reno/CUBIC.",
            "",
            "      -  Probing BBR.min_rtt: to probe the path's BBR.min_rtt",
            "",
            "      -  Bandwidth convergence: to aid bandwidth fairness convergence,",
            "         by leaving unused capacity in the bottleneck link or bottleneck",
            "         buffer, to allow other flows that may have lower sending rates",
            "         to discover and utilize the unused capacity",
            "",
            "      -  Burst tolerance: to allow bursty arrivals of cross-traffic",
            "         (e.g. short web or RPC requests) to be able to share the",
            "         bottleneck link without causing excessive queuing delay or",
            "         packet loss",
            "",
            "   Throughout the lifetime of a BBR flow, it sequentially cycles through",
            "   all three tactics, to measure the network path and try to optimize",
            "   its operating point.",
            "",
            "   BBR's state machine uses two control mechanisms.  Primarily, it uses",
            "   the pacing_gain (see the \"Pacing Rate\" section), which controls how",
            "   fast packets are sent relative to BBR.bw.  A pacing_gain > 1",
            "   decreases inter-packet time and increases inflight.  A pacing_gain <",
            "",
            "   1 has the opposite effect, increasing inter-packet time and while",
            "   aiming to decrease inflight.  Second, if the state machine needs to",
            "   quickly reduce inflight to a particular absolute value, it uses the",
            "   cwnd."
          ],
          "title": "State Machine Tactics"
        },
        {
          "id": "section-4.2",
          "lines": [
            "   The BBR algorithm is an event-driven algorithm that executes steps",
            "   upon the following events: connection initialization, upon each ACK,",
            "   upon the transmission of each quantum, and upon loss detection",
            "   events.  All of the sub-steps invoked referenced below are described",
            "   below."
          ],
          "title": "Algorithm Organization"
        },
        {
          "id": "section-4.2.1",
          "lines": [
            "   Upon transport connection initialization, BBR executes its",
            "   initialization steps:",
            "",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "     "
              },
              {
                "annotation_ids": [
                  "a0228b098cfd2268",
                  "4745119969174e34"
                ],
                "status_id": 2,
                "text": "BBROnInit():"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "       "
              },
              {
                "annotation_ids": [
                  "a0228b098cfd2268",
                  "4745119969174e34"
                ],
                "status_id": 2,
                "text": "init_windowed_max_filter(filter=BBR.MaxBwFilter, value=0, time=0)"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "       "
              },
              {
                "annotation_ids": [
                  "a0228b098cfd2268",
                  "4745119969174e34"
                ],
                "status_id": 2,
                "text": "BBR.min_rtt = SRTT ? SRTT : Inf"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "       "
              },
              {
                "annotation_ids": [
                  "a0228b098cfd2268",
                  "4745119969174e34"
                ],
                "status_id": 2,
                "text": "BBR.min_rtt_stamp = Now()"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "       "
              },
              {
                "annotation_ids": [
                  "a0228b098cfd2268",
                  "4745119969174e34"
                ],
                "status_id": 2,
                "text": "BBR.probe_rtt_done_stamp = 0"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "       "
              },
              {
                "annotation_ids": [
                  "a0228b098cfd2268",
                  "4745119969174e34"
                ],
                "status_id": 2,
                "text": "BBR.probe_rtt_round_done = false"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "       "
              },
              {
                "annotation_ids": [
                  "a0228b098cfd2268",
                  "4745119969174e34"
                ],
                "status_id": 2,
                "text": "BBR.prior_cwnd = 0"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "       "
              },
              {
                "annotation_ids": [
                  "a0228b098cfd2268",
                  "4745119969174e34"
                ],
                "status_id": 2,
                "text": "BBR.idle_restart = false"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "       "
              },
              {
                "annotation_ids": [
                  "a0228b098cfd2268",
                  "4745119969174e34"
                ],
                "status_id": 2,
                "text": "BBR.extra_acked_interval_start = Now()"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "       "
              },
              {
                "annotation_ids": [
                  "a0228b098cfd2268",
                  "4745119969174e34"
                ],
                "status_id": 2,
                "text": "BBR.extra_acked_delivered = 0"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "       "
              },
              {
                "annotation_ids": [
                  "a0228b098cfd2268",
                  "4745119969174e34"
                ],
                "status_id": 2,
                "text": "BBRResetCongestionSignals()"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "       "
              },
              {
                "annotation_ids": [
                  "a0228b098cfd2268",
                  "4745119969174e34"
                ],
                "status_id": 2,
                "text": "BBRResetLowerBounds()"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "       "
              },
              {
                "annotation_ids": [
                  "a0228b098cfd2268",
                  "4745119969174e34"
                ],
                "status_id": 2,
                "text": "BBRInitRoundCounting()"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "       "
              },
              {
                "annotation_ids": [
                  "a0228b098cfd2268",
                  "4745119969174e34"
                ],
                "status_id": 2,
                "text": "BBRInitFullPipe()"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "       "
              },
              {
                "annotation_ids": [
                  "a0228b098cfd2268",
                  "4745119969174e34"
                ],
                "status_id": 2,
                "text": "BBRInitPacingRate()"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "       "
              },
              {
                "annotation_ids": [
                  "a0228b098cfd2268",
                  "4745119969174e34"
                ],
                "status_id": 2,
                "text": "BBREnterStartup()"
              }
            ]
          ],
          "title": "Initialization"
        },
        {
          "id": "section-4.2.2",
          "lines": [
            "   When transmitting, BBR merely needs to check for the case where the",
            "   flow is restarting from idle:",
            "",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "     "
              },
              {
                "annotation_ids": [
                  "51f3b6e50fa31d1d"
                ],
                "status_id": 1,
                "text": "BBROnTransmit():"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "       "
              },
              {
                "annotation_ids": [
                  "51f3b6e50fa31d1d"
                ],
                "status_id": 1,
                "text": "BBRHandleRestartFromIdle()"
              }
            ]
          ],
          "title": "Per-Transmit Steps"
        },
        {
          "id": "section-4.2.3",
          "lines": [
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "4303c24bbcc1f53c"
                ],
                "status_id": 1,
                "text": "On every ACK, the BBR algorithm executes the following"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "4303c24bbcc1f53c"
                ],
                "status_id": 1,
                "text": "BBRUpdateOnACK() steps in order to update its network path model,"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "4303c24bbcc1f53c"
                ],
                "status_id": 1,
                "text": "update its state machine, and adjust its control parameters to adapt"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "4303c24bbcc1f53c"
                ],
                "status_id": 1,
                "text": "to the updated model:"
              }
            ],
            "",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "     "
              },
              {
                "annotation_ids": [
                  "4303c24bbcc1f53c"
                ],
                "status_id": 1,
                "text": "BBRUpdateOnACK():"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "       "
              },
              {
                "annotation_ids": [
                  "4303c24bbcc1f53c"
                ],
                "status_id": 1,
                "text": "BBRUpdateModelAndState()"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "       "
              },
              {
                "annotation_ids": [
                  "4303c24bbcc1f53c"
                ],
                "status_id": 1,
                "text": "BBRUpdateControlParameters()"
              }
            ],
            "",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "     "
              },
              {
                "annotation_ids": [
                  "e809634cadeeed24"
                ],
                "status_id": 1,
                "text": "BBRUpdateModelAndState():"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "       "
              },
              {
                "annotation_ids": [
                  "e809634cadeeed24"
                ],
                "status_id": 1,
                "text": "BBRUpdateLatestDeliverySignals()"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "       "
              },
              {
                "annotation_ids": [
                  "e809634cadeeed24"
                ],
                "status_id": 1,
                "text": "BBRUpdateCongestionSignals()"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "       "
              },
              {
                "annotation_ids": [
                  "ffbbf67f692f3aa7"
                ],
                "status_id": 1,
                "text": "BBRUpdateACKAggregation()"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "       "
              },
              {
                "annotation_ids": [
                  "1b0f2f1b38499144"
                ],
                "status_id": 1,
                "text": "BBRCheckStartupDone()"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "       "
              },
              {
                "annotation_ids": [
                  "1b0f2f1b38499144"
                ],
                "status_id": 1,
                "text": "BBRCheckDrain()"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "       "
              },
              {
                "annotation_ids": [
                  "e16c67aa8e569af3"
                ],
                "status_id": 1,
                "text": "BBRUpdateProbeBWCyclePhase()"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "       "
              },
              {
                "annotation_ids": [
                  "f9f668d62c4000f4"
                ],
                "status_id": 1,
                "text": "BBRUpdateMinRTT()"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "       "
              },
              {
                "annotation_ids": [
                  "f9f668d62c4000f4"
                ],
                "status_id": 1,
                "text": "BBRCheckProbeRTT()"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "       "
              },
              {
                "annotation_ids": [
                  "f9f668d62c4000f4"
                ],
                "status_id": 1,
                "text": "BBRAdvanceLatestDeliverySignals()"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "       "
              },
              {
                "annotation_ids": [
                  "f9f668d62c4000f4"
                ],
                "status_id": 1,
                "text": "BBRBoundBWForModel()"
              }
            ],
            "",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "     "
              },
              {
                "annotation_ids": [
                  "1d257f5712468773"
                ],
                "status_id": 1,
                "text": "BBRUpdateControlParameters():"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "       "
              },
              {
                "annotation_ids": [
                  "1d257f5712468773"
                ],
                "status_id": 1,
                "text": "BBRSetPacingRate()"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "       "
              },
              {
                "annotation_ids": [
                  "1d257f5712468773"
                ],
                "status_id": 1,
                "text": "BBRSetSendQuantum()"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "       "
              },
              {
                "annotation_ids": [
                  "1d257f5712468773"
                ],
                "status_id": 1,
                "text": "BBRSetCwnd()"
              }
            ]
          ],
          "title": "Per-ACK Steps"
        },
        {
          "id": "section-4.2.4",
          "lines": [
            "   On every packet loss event, where some sequence range \"packet\" is",
            "   marked lost, the BBR algorithm executes the following",
            "   BBRUpdateOnLoss() steps in order to update its network path model",
            "",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "     "
              },
              {
                "annotation_ids": [
                  "5b31bc64a017b347"
                ],
                "status_id": 1,
                "text": "BBRUpdateOnLoss(packet):"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "       "
              },
              {
                "annotation_ids": [
                  "5b31bc64a017b347"
                ],
                "status_id": 1,
                "text": "BBRHandleLostPacket(packet)"
              }
            ]
          ],
          "title": "Per-Loss Steps"
        },
        {
          "id": "section-4.3",
          "lines": [],
          "title": "State Machine Operation"
        },
        {
          "id": "section-4.3.1",
          "lines": [],
          "title": "Startup"
        },
        {
          "id": "section-4.3.1.1",
          "lines": [
            "   When a BBR flow starts up, it performs its first (and most rapid)",
            "   sequential probe/drain process in the Startup and Drain states.",
            "   Network link bandwidths currently span a range of at least 11 orders",
            "   of magnitude, from a few bps to 200 Gbps.  To quickly learn",
            "   BBR.max_bw, given this huge range to explore, BBR's Startup state",
            "   does an exponential search of the rate space, doubling the sending",
            "   rate each round.  This finds BBR.max_bw in O(log_2(BDP)) round trips.",
            "",
            "   To achieve this rapid probing in the smoothest possible fashion, in",
            "   Startup BBR uses the minimum gain values that will allow the sending",
            "   rate to double each round: in Startup BBR sets BBR.pacing_gain to",
            "   BBRStartupPacingGain (2.77) [BBRStartupPacingGain] and BBR.cwnd_gain",
            "   to BBRStartupCwndGain (2).",
            "",
            "   When initializing a connection, or upon any later entry into Startup",
            "   mode, BBR executes the following BBREnterStartup() steps:",
            "",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "     "
              },
              {
                "annotation_ids": [
                  "a51208f5091111c3"
                ],
                "status_id": 1,
                "text": "BBREnterStartup():"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "       "
              },
              {
                "annotation_ids": [
                  "a51208f5091111c3"
                ],
                "status_id": 1,
                "text": "BBR.state = Startup"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "       "
              },
              {
                "annotation_ids": [
                  "a51208f5091111c3"
                ],
                "status_id": 1,
                "text": "BBR.pacing_gain = BBRStartupPacingGain"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "       "
              },
              {
                "annotation_ids": [
                  "a51208f5091111c3"
                ],
                "status_id": 1,
                "text": "BBR.cwnd_gain = BBRStartupCwndGain"
              }
            ],
            "",
            "   As BBR grows its sending rate rapidly, it obtains higher delivery",
            "   rate samples, BBR.max_bw increases, and the pacing rate and cwnd both",
            "   adapt by smoothly growing in proportion.  Once the pipe is full, a",
            "   queue typically forms, but the cwnd_gain bounds any queue to",
            "   (cwnd_gain - 1) * estimated_BDP, which is approximately (2.77 - 1) *",
            "   estimated_BDP = 1.77 * estimated_BDP.  The immediately following",
            "   Drain state is designed to quickly drain that queue.",
            "",
            "   During Startup, BBR estimates whether the pipe is full using two",
            "   estimators.  The first looks for a plateau in the BBR.max_bw",
            "   estimate.  The second looks for packet loss.  The following",
            "   subsections discuss these estimators.",
            "",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "     "
              },
              {
                "annotation_ids": [
                  "9ae3997e72b9d889",
                  "d52933653d482761"
                ],
                "status_id": 2,
                "text": "BBRCheckStartupDone():"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "       "
              },
              {
                "annotation_ids": [
                  "9ae3997e72b9d889",
                  "d52933653d482761"
                ],
                "status_id": 2,
                "text": "BBRCheckStartupFullBandwidth()"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "       "
              },
              {
                "annotation_ids": [
                  "9ae3997e72b9d889",
                  "d52933653d482761"
                ],
                "status_id": 2,
                "text": "BBRCheckStartupHighLoss()"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "       "
              },
              {
                "annotation_ids": [
                  "9ae3997e72b9d889",
                  "d52933653d482761"
                ],
                "status_id": 2,
                "text": "if (BBR.state == Startup and BBR.filled_pipe)"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "         "
              },
              {
                "annotation_ids": [
                  "9ae3997e72b9d889",
                  "d52933653d482761"
                ],
                "status_id": 2,
                "text": "BBREnterDrain()"
              }
            ]
          ],
          "title": "Startup Dynamics"
        },
        {
          "id": "section-4.3.1.2",
          "lines": [
            "   During Startup, BBR estimates whether the pipe is full by looking for",
            "   a plateau in the BBR.max_bw estimate.  The output of this \"full pipe\"",
            "   estimator is tracked in BBR.filled_pipe, a boolean that records",
            "   whether BBR estimates that it has ever fully utilized its available",
            "   bandwidth (\"filled the pipe\").  If BBR notices that there are several",
            "   (three) rounds where attempts to double the delivery rate actually",
            "   result in little increase (less than 25 percent), then it estimates",
            "   that it has reached BBR.max_bw, sets BBR.filled_pipe to true, exits",
            "   Startup and enters Drain.",
            "",
            "   Upon connection initialization the full pipe estimator runs:",
            "",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "     "
              },
              {
                "annotation_ids": [
                  "d10fc2a4709cc988"
                ],
                "status_id": 1,
                "text": "BBRInitFullPipe():"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "       "
              },
              {
                "annotation_ids": [
                  "d10fc2a4709cc988"
                ],
                "status_id": 1,
                "text": "BBR.filled_pipe = false"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "       "
              },
              {
                "annotation_ids": [
                  "d10fc2a4709cc988"
                ],
                "status_id": 1,
                "text": "BBR.full_bw = 0"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "       "
              },
              {
                "annotation_ids": [
                  "d10fc2a4709cc988"
                ],
                "status_id": 1,
                "text": "BBR.full_bw_count = 0"
              }
            ],
            "",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "8e459a1bf8b33f8d"
                ],
                "status_id": 1,
                "text": "Once per round trip, upon an ACK that acknowledges new data, and when"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "8e459a1bf8b33f8d"
                ],
                "status_id": 1,
                "text": "the delivery rate sample is not application-limited (see [draft-"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "8e459a1bf8b33f8d"
                ],
                "status_id": 1,
                "text": "cheng-iccrg-delivery-rate-estimation]), BBR runs the \"full pipe\""
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "8e459a1bf8b33f8d"
                ],
                "status_id": 1,
                "text": "estimator"
              },
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": ", if needed:"
              }
            ],
            "",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "     "
              },
              {
                "annotation_ids": [
                  "7069816164d474b1"
                ],
                "status_id": 1,
                "text": "BBRCheckStartupFullBandwidth():"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "       "
              },
              {
                "annotation_ids": [
                  "7069816164d474b1"
                ],
                "status_id": 1,
                "text": "if BBR.filled_pipe or"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "          "
              },
              {
                "annotation_ids": [
                  "7069816164d474b1"
                ],
                "status_id": 1,
                "text": "!BBR.round_start or rs.is_app_limited"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "         "
              },
              {
                "annotation_ids": [
                  "7069816164d474b1"
                ],
                "status_id": 1,
                "text": "return  /* no need to check for a full pipe now */"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "       "
              },
              {
                "annotation_ids": [
                  "7069816164d474b1"
                ],
                "status_id": 1,
                "text": "if (BBR.max_bw >= BBR.full_bw * 1.25)  /* still growing? */"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "         "
              },
              {
                "annotation_ids": [
                  "7069816164d474b1"
                ],
                "status_id": 1,
                "text": "BBR.full_bw = BBR.max_bw    /* record new baseline level */"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "         "
              },
              {
                "annotation_ids": [
                  "7069816164d474b1"
                ],
                "status_id": 1,
                "text": "BBR.full_bw_count = 0"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "         "
              },
              {
                "annotation_ids": [
                  "7069816164d474b1"
                ],
                "status_id": 1,
                "text": "return"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "       "
              },
              {
                "annotation_ids": [
                  "7069816164d474b1"
                ],
                "status_id": 1,
                "text": "BBR.full_bw_count++ /* another round w/o much growth */"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "       "
              },
              {
                "annotation_ids": [
                  "7069816164d474b1"
                ],
                "status_id": 1,
                "text": "if (BBR.full_bw_count >= 3)"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "         "
              },
              {
                "annotation_ids": [
                  "7069816164d474b1"
                ],
                "status_id": 1,
                "text": "BBR.filled_pipe = true"
              }
            ],
            "",
            "   BBR waits three rounds to have solid evidence that the sender is not",
            "   detecting a delivery-rate plateau that was temporarily imposed by the",
            "   receive window.  Allowing three rounds provides time for the",
            "   receiver's receive-window auto-tuning to open up the receive window",
            "   and for the BBR sender to realize that BBR.max_bw should be higher:",
            "   in the first round the receive-window auto-tuning algorithm grows the",
            "   receive window; in the second round the sender fills the higher",
            "   receive window; in the third round the sender gets higher delivery-",
            "   rate samples.  This three-round threshold was validated by YouTube",
            "   experimental data."
          ],
          "title": "Exiting Startup Based on Bandwidth Plateau"
        },
        {
          "id": "section-4.3.1.3",
          "lines": [
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "3efc62f2b36eada0"
                ],
                "status_id": 1,
                "text": "A second method BBR uses for estimating the bottleneck is full is by"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "3efc62f2b36eada0"
                ],
                "status_id": 1,
                "text": "looking at sustained packet losses Specifically for a case where the"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "3efc62f2b36eada0"
                ],
                "status_id": 1,
                "text": "following criteria are all met:"
              }
            ],
            "",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "3efc62f2b36eada0",
                  "6a588cc0fec43f7e"
                ],
                "status_id": 3,
                "text": "*  The connection has been in fast recovery for at least one full"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "      "
              },
              {
                "annotation_ids": [
                  "3efc62f2b36eada0",
                  "6a588cc0fec43f7e"
                ],
                "status_id": 3,
                "text": "round trip."
              }
            ],
            "",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "3efc62f2b36eada0"
                ],
                "status_id": 1,
                "text": "*  The loss rate over the time scale of a single full round trip"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "      "
              },
              {
                "annotation_ids": [
                  "3efc62f2b36eada0"
                ],
                "status_id": 1,
                "text": "exceeds BBRLossThresh (2%)."
              }
            ],
            "",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "8ef86505045d8f08"
                ],
                "status_id": 4,
                "text": "*  There are at least BBRStartupFullLossCnt=3 discontiguous sequence"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "      "
              },
              {
                "annotation_ids": [
                  "8ef86505045d8f08"
                ],
                "status_id": 4,
                "text": "ranges lost in that round trip."
              }
            ],
            "",
            "   If these criteria are all met, then BBRCheckStartupHighLoss() sets",
            "   BBR.filled_pipe = true and exits Startup and enters Drain.",
            "",
            "   The algorithm waits until all three criteria are met to filter out",
            "   noise from burst losses, and to try to ensure the bottleneck is fully",
            "   utilized on a sustained basis, and the full bottleneck bandwidth has",
            "   been measured, before attempting to drain the level of in-flight data",
            "   to the estimated BDP."
          ],
          "title": "Exiting Startup Based on Packet Loss"
        },
        {
          "id": "section-4.3.2",
          "lines": [
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   Upon exiting Startup, BBR enters its Drain state.  "
              },
              {
                "annotation_ids": [
                  "352f1bfe3abf00e6",
                  "6750e86fad6c53e4"
                ],
                "status_id": 2,
                "text": "In Drain, BBR aims"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "352f1bfe3abf00e6",
                  "6750e86fad6c53e4"
                ],
                "status_id": 2,
                "text": "to quickly drain any queue created in Startup by switching to a"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "352f1bfe3abf00e6",
                  "6750e86fad6c53e4"
                ],
                "status_id": 2,
                "text": "pacing_gain well below 1.0, until any estimated queue has been"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "352f1bfe3abf00e6",
                  "6750e86fad6c53e4"
                ],
                "status_id": 2,
                "text": "drained.  It uses a pacing_gain that is the inverse of the value used"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "352f1bfe3abf00e6",
                  "6750e86fad6c53e4"
                ],
                "status_id": 2,
                "text": "during Startup, chosen to try to drain the queue in one round"
              }
            ],
            "   [BBRDrainPacingGain]:",
            "",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "     "
              },
              {
                "annotation_ids": [
                  "fdf9a6bc581cf8c0",
                  "0c40607470e0c1a7",
                  "4693b7008c435374"
                ],
                "status_id": 2,
                "text": "BBREnterDrain():"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "       "
              },
              {
                "annotation_ids": [
                  "fdf9a6bc581cf8c0",
                  "0c40607470e0c1a7",
                  "4693b7008c435374"
                ],
                "status_id": 2,
                "text": "BBR.state = Drain"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "       "
              },
              {
                "annotation_ids": [
                  "0cb715f27eca1cc1",
                  "fdf9a6bc581cf8c0",
                  "0c40607470e0c1a7",
                  "4693b7008c435374"
                ],
                "status_id": 2,
                "text": "BBR.pacing_gain = 1/BBRStartupCwndGain  /* pace slowly */"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "       "
              },
              {
                "annotation_ids": [
                  "fdf9a6bc581cf8c0",
                  "0c40607470e0c1a7",
                  "4693b7008c435374"
                ],
                "status_id": 2,
                "text": "BBR.cwnd_gain = BBRStartupCwndGain      /* maintain cwnd */"
              }
            ],
            "",
            "   In Drain, when the amount of data in flight is less than or equal to",
            "   the estimated BDP, meaning BBR estimates that the queue has been",
            "   fully drained, then BBR exits Drain and enters ProbeBW.  To implement",
            "   this, upon every ACK BBR executes:",
            "",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "     "
              },
              {
                "annotation_ids": [
                  "42fc8bc460897a31",
                  "804952dff80f14ab"
                ],
                "status_id": 2,
                "text": "BBRCheckDrain():"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "       "
              },
              {
                "annotation_ids": [
                  "42fc8bc460897a31",
                  "804952dff80f14ab"
                ],
                "status_id": 2,
                "text": "if (BBR.state == Drain and packets_in_flight <= BBRInflight(1.0))"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "         "
              },
              {
                "annotation_ids": [
                  "42fc8bc460897a31",
                  "804952dff80f14ab"
                ],
                "status_id": 2,
                "text": "BBREnterProbeBW()  /* BBR estimates the queue was drained */"
              }
            ]
          ],
          "title": "Drain"
        },
        {
          "id": "section-4.3.3",
          "lines": [
            "   Long-lived BBR flows tend to spend the vast majority of their time in",
            "   the ProbeBW states.  In the ProbeBW states, a BBR flow sequentially",
            "   accelerates, decelerates, and cruises, to measure the network path,",
            "   improve its operating point (increase throughput and reduce queue",
            "   pressure), and converge toward a more fair allocation of bottleneck",
            "   bandwidth.  To do this, the flow sequentially cycles through all",
            "   three tactics: trying to send faster than, slower than, and at the",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   same rate as the network delivery process.  To achieve this, "
              },
              {
                "annotation_ids": [
                  "40f1253c5b449269"
                ],
                "status_id": 1,
                "text": "a BBR"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "40f1253c5b449269"
                ],
                "status_id": 1,
                "text": "flow in ProbeBW mode cycles through the four Probe bw states - DOWN,"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "40f1253c5b449269"
                ],
                "status_id": 1,
                "text": "CRUISE, REFILL, and UP"
              },
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": " - described below in turn."
              }
            ]
          ],
          "title": "ProbeBW"
        },
        {
          "id": "section-4.3.3.1",
          "lines": [
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "ebe144bdd3642e89",
                  "81eb190312c2afb2",
                  "dbdba2b610ed0ee8"
                ],
                "status_id": 2,
                "text": "In the ProbeBW_DOWN phase of the cycle, a BBR flow pursues the"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "ebe144bdd3642e89",
                  "81eb190312c2afb2",
                  "dbdba2b610ed0ee8"
                ],
                "status_id": 2,
                "text": "deceleration tactic, to try to send slower than the network is"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "ebe144bdd3642e89",
                  "81eb190312c2afb2",
                  "dbdba2b610ed0ee8"
                ],
                "status_id": 2,
                "text": "delivering data, to reduce the amount of data in flight, with all of"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "ebe144bdd3642e89",
                  "81eb190312c2afb2",
                  "dbdba2b610ed0ee8"
                ],
                "status_id": 2,
                "text": "the standard motivations for the deceleration tactic (discussed in"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "ebe144bdd3642e89",
                  "81eb190312c2afb2",
                  "dbdba2b610ed0ee8"
                ],
                "status_id": 2,
                "text": "\"State Machine Tactics\", above).  It does this by switching to a"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "ebe144bdd3642e89",
                  "81eb190312c2afb2",
                  "dbdba2b610ed0ee8"
                ],
                "status_id": 2,
                "text": "BBR.pacing_gain of 0.9, sending at 90% of BBR.bw."
              },
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "  The pacing_gain"
              }
            ],
            "   value of 0.9 is derived based on the ProbeBW_UP pacing gain of 1.25,",
            "   as the minimum pacing_gain value that allows bandwidth-based",
            "   convergence to approximate fairness.",
            "",
            "   Exit conditions: The flow exits this phase and enters CRUISE when the",
            "   flow estimates that both of the following conditions have been met:",
            "",
            "   *  There is free headroom: If inflight_hi is set, then BBR remains in",
            "      DOWN at least until the volume of in-flight data is less than or",
            "      equal to BBRHeadroom*BBR.inflight_hi.  The goal of this constraint",
            "      is to ensure that in cases where loss signals suggest an upper",
            "      limit on the volume of in-flight data, then the flow attempts to",
            "      leave some free headroom in the path (e.g. free space in the",
            "      bottleneck buffer or free time slots in the bottleneck link) that",
            "      can be used by cross traffic (both for volume-based convergence of",
            "      bandwidth shares and for burst tolerance).",
            "",
            "   *  The volume of in-flight data is less than or equal to BBR.BDP,",
            "      i.e. the flow estimates that it has drained any queue at the",
            "      bottleneck."
          ],
          "title": "ProbeBW_DOWN"
        },
        {
          "id": "section-4.3.3.2",
          "lines": [
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "dc8be4166ae1fa81",
                  "463201568ed2c332"
                ],
                "status_id": 2,
                "text": "In the ProbeBW_CRUISE phase of the cycle, a BBR flow pursues the"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "dc8be4166ae1fa81",
                  "463201568ed2c332"
                ],
                "status_id": 2,
                "text": "\"cruising\" tactic (discussed in \"State Machine Tactics\", above),"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "dc8be4166ae1fa81",
                  "463201568ed2c332"
                ],
                "status_id": 2,
                "text": "attempting to send at the same rate the network is delivering data."
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "dc8be4166ae1fa81",
                  "463201568ed2c332"
                ],
                "status_id": 2,
                "text": "It tries to match the sending rate to the flow's current available"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "dc8be4166ae1fa81",
                  "463201568ed2c332"
                ],
                "status_id": 2,
                "text": "bandwidth, to try to achieve high utilization of the available"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "dc8be4166ae1fa81",
                  "463201568ed2c332"
                ],
                "status_id": 2,
                "text": "bandwidth without increasing queue pressure.  It does this by"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "dc8be4166ae1fa81",
                  "463201568ed2c332"
                ],
                "status_id": 2,
                "text": "switching to a pacing_gain of 1.0, sending at 100% of BBR.bw."
              }
            ],
            "   Notably, while in this state it responds to concrete congestion",
            "   signals (loss) by reducing BBR.bw_lo and BBR.inflight_lo, because",
            "   these signals suggest that the available bandwidth and deliverable",
            "   volume of in-flight data have likely reduced, and the flow needs to",
            "   change to adapt, slowing down to match the latest delivery process.",
            "",
            "   Exit conditions: The connection adaptively holds this state until it",
            "   decides that it is time to probe for bandwidth, at which time it",
            "   enters ProbeBW_REFILL (see \"Time Scale for Bandwidth Probing\",",
            "   below)."
          ],
          "title": "ProbeBW_CRUISE"
        },
        {
          "id": "section-4.3.3.3",
          "lines": [
            "   The goal of the ProbeBW_REFILL state is to \"refill the pipe\", to try",
            "   to fully utilize the network bottleneck without creating any",
            "   significant queue pressure.",
            "",
            "   To do this, BBR first resets the short-term model parameters bw_lo",
            "   and inflight_lo, setting both to \"Infinity\".  This is the key moment",
            "   in the BBR time scale strategy (see \"Time Scale Strategy\", above)",
            "   where the flow pivots, discarding its conservative short-term bw_lo",
            "   and inflight_lo parameters and beginning to robustly probe the",
            "   bottleneck's long-term available bandwidth.  During this time bw_hi",
            "   and inflight_hi, if set, constrain the connection.",
            "",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "ede918166fd51ee5",
                  "a91a686ede794b42"
                ],
                "status_id": 2,
                "text": "During ProbeBW_REFILL BBR uses a BBR.pacing_gain of 1.0, to send at a"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "ede918166fd51ee5",
                  "a91a686ede794b42"
                ],
                "status_id": 2,
                "text": "rate that matches the current estimated available bandwidth"
              },
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": ", for one"
              }
            ],
            "   packet-timed round trip.  The goal is to fully utilize the bottleneck",
            "   link before transitioning into ProbeBW_UP and significantly",
            "   increasing the chances of causing a loss signal.  The motivating",
            "   insight is that, as soon as a flow starts acceleration, sending",
            "   faster than the available bandwidth, it will start building a queue",
            "   at the bottleneck.  And if the buffer is shallow enough, then the",
            "   flow can cause loss signals very shortly after the first accelerating",
            "   packets arrive at the bottleneck.  If the flow were to neglect to",
            "   fill the pipe before it causes this loss signal, then these very",
            "   quick signals of excess queue could cause the flow's estimate of the",
            "   path's capacity (i.e. inflight_hi) to significantly underestimate.",
            "   In particular, if the flow were to transition directly from",
            "",
            "   ProbeBW_CRUISE to ProbeBW_UP, the volume of in-flight data (at the",
            "   time the first accelerating packets were sent) may often be still",
            "   very close to the volume of in-flight data maintained in CRUISE,",
            "   which may be only BBRHeadroom*inflight_hi.",
            "",
            "   Exit conditions: The flow exits ProbeBW_REFILL after one packet-timed",
            "   round trip, and enters UP.  This is because after one full round trip",
            "   of sending in ProbeBW_REFILL the flow (if not application-limited)",
            "   has had an opportunity to place as many packets in flight as its",
            "   BBR.bw estimate permits.  And correspondingly, at this point the flow",
            "   starts to see bandwidth samples reflecting its ProbeBW_REFILL",
            "   behavior, which may be putting too much data in flight."
          ],
          "title": "ProbeBW_REFILL"
        },
        {
          "id": "section-4.3.3.4",
          "lines": [
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "c111d6ca67f5e4f2",
                  "73c7b1d3b2b2ec8f"
                ],
                "status_id": 2,
                "text": "After ProbeBW_REFILL refills the pipe, ProbeBW_UP probes for possible"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "c111d6ca67f5e4f2",
                  "73c7b1d3b2b2ec8f"
                ],
                "status_id": 2,
                "text": "increases in available bandwidth by using a BBR.pacing_gain of 1.25,"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "c111d6ca67f5e4f2",
                  "73c7b1d3b2b2ec8f"
                ],
                "status_id": 2,
                "text": "sending faster than the current estimated available bandwidth."
              }
            ],
            "",
            "   If the flow has not set BBR.inflight_hi or BBR.bw_hi, it tries to",
            "   raise the volume of in-flight data to at least BBR.pacing_gain *",
            "   BBR.bdp = 1.25 * BBR.bdp; note that this may take more than",
            "   BBR.min_rtt if BBR.min_rtt is small (e.g. on a LAN).",
            "",
            "   If the flow has set BBR.inflight_hi or BBR.bw_hi, it moves to an",
            "   operating point based on those limits and then gradually increases",
            "   the upper volume bound (BBR.inflight_hi) and rate bound (BBR.bw_hi)",
            "   using the following approach:",
            "",
            "   *  bw_hi: The flow raises bw_hi to the latest measured bandwidth",
            "      sample if the latest measured bandwidth sample is above bw_hi and",
            "      the loss rate for the sample is not above the BBRLossThresh.",
            "",
            "   *  inflight_hi: The flow raises inflight_hi in ProbeBW_UP in a manner",
            "      that is slow and cautious at first, but increasingly rapid and",
            "      bold over time.  The initial caution is motivated by the fact that",
            "      a given BBR flow may be sharing a shallow buffer with thousands of",
            "      other flows, so that the buffer space available to the flow may be",
            "      quite tight - even just a single packet.  The increasingly rapid",
            "      growth over time is motivated by the fact that in a high-speed WAN",
            "      the increase in available bandwidth (and thus the estimated BDP)",
            "      may require the flow to grow the volume of its inflight data by up",
            "      to O(1,000,000); even a quite typical BDP like 10Gbps * 100ms is",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "      82,563 packets.  "
              },
              {
                "annotation_ids": [
                  "ae4eb196364556b0"
                ],
                "status_id": 1,
                "text": "BBR takes an approach where the additive increase"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "      "
              },
              {
                "annotation_ids": [
                  "ae4eb196364556b0"
                ],
                "status_id": 1,
                "text": "to BBR.inflight_hi exponentially doubles each round trip"
              },
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "; in each"
              }
            ],
            "      successive round trip, inflight_hi grows by 1, 2, 4, 8, 16, etc,",
            "      with the increases spread uniformly across the entire round trip.",
            "      This helps allow BBR to utilize a larger BDP in O(log(BDP)) round",
            "      trips, meeting the design goal for scalable utilization of newly-",
            "      available bandwidth.",
            "",
            "   Exit conditions: The BBR flow ends ProbeBW_UP bandwidth probing and",
            "   transitions to ProbeBW_DOWN to try to drain the bottleneck queue when",
            "   any of the following conditions are met:",
            "",
            "   1.  Estimated queue: The flow has been in ProbeBW_UP for at least",
            "       1*min_rtt, and the estimated queue is high enough that the flow",
            "       judges it has robustly probed for available bandwidth",
            "       (packets_in_flight > 1.25 * BBR.bdp).",
            "",
            "   2.  Loss: The current loss rate exceeds BBRLossThresh (2%)."
          ],
          "title": "ProbeBW_UP"
        },
        {
          "id": "section-4.3.3.5",
          "lines": [
            "   Choosing the time scale for probing bandwidth is tied to the question",
            "   of how to coexist with legacy Reno/CUBIC flows, since probing for",
            "   bandwidth runs a significant risk of causing packet loss, and causing",
            "   packet loss can significantly limit the throughput of such legacy",
            "   Reno/CUBIC flows."
          ],
          "title": "Time Scale for Bandwidth Probing"
        },
        {
          "id": "section-4.3.3.5.1",
          "lines": [
            "   BBR has an explicit strategy for coexistence with Reno/CUBIC: to try",
            "   to behave in a manner so that Reno/CUBIC flows coexisting with BBR",
            "   can continue to work well in the primary contexts where they do",
            "   today:",
            "",
            "   *  Intra-datacenter/LAN traffic: we want Reno/CUBIC to be able to",
            "      perform well in 100M through 40G enterprise and datacenter",
            "      Ethernet",
            "",
            "      -  BDP = 40 Gbps * 20 us / (1514 bytes) ~= 66 packets",
            "",
            "   *  Public Internet last mile traffic: we want Reno/CUBIC to be able",
            "      to support up to 25Mbps (for 4K Video) at an RTT of 30ms, typical",
            "      parameters for common CDNs for large video services:",
            "",
            "      -  BDP = 25Mbps * 30 ms / (1514 bytes) ~= 62 packets",
            "",
            "   The challenge in meeting these goals is that Reno/CUBIC need long",
            "   periods of no loss to utilize large BDPs.  The good news is that in",
            "   the environments where Reno/CUBIC work well today (mentioned above),",
            "   the BDPs are small, roughly ~100 packets or less."
          ],
          "title": "Bandwidth Probing and Coexistence with Reno/CUBIC"
        },
        {
          "id": "section-4.3.3.5.2",
          "lines": [
            "   The BBR strategy has several aspects:",
            "",
            "   1.  The highest priority is to estimate the bandwidth available to",
            "       the BBR flow in question.",
            "",
            "   2.  Secondarily, a given BBR flow adapts (within bounds) the",
            "       frequency at which it probes bandwidth and knowingly risks packet",
            "       loss, to allow Reno/CUBIC to reach a bandwidth at least as high",
            "       as that given BBR flow.",
            "",
            "   To adapt the frequency of bandwidth probing, BBR considers two time",
            "   scales: a BBR-native time scale, and a bounded Reno-conscious time",
            "   scale:",
            "",
            "   *  T_bbr: BBR-native time-scale",
            "",
            "      -  T_bbr = uniformly randomly distributed between 2 and 3 secs",
            "",
            "   *  T_reno: Reno-coexistence time scale",
            "",
            "      -  T_reno_bound = pick_randomly_either({62, 63})",
            "",
            "      -  reno_bdp = min(BBR.bdp, cwnd)",
            "",
            "      -  T_reno = min(reno_bdp, T_reno_bound) round trips",
            "",
            "   *  T_probe: The time between bandwidth probe UP phases:",
            "",
            "      -  T_probe = min(T_bbr, T_reno)",
            "",
            "   This dual-time-scale approach is similar to that used by CUBIC, which",
            "   has a CUBIC-native time scale given by a cubic curve, and a \"Reno",
            "   emulation\" module that estimates what cwnd would give the flow Reno-",
            "   equivalent throughput.  At any given moment, CUBIC choose the cwnd",
            "   implied by the more aggressive strategy.",
            "",
            "   We randomize both the T_bbr and T_reno parameters, for better mixing",
            "   and fairness convergence."
          ],
          "title": "A Dual-Time-Scale Approach for Coexistence"
        },
        {
          "id": "section-4.3.3.5.3",
          "lines": [
            "   We design the maximum wall-clock bounds of BBR-native inter-",
            "   bandwidth-probe wall clock time, T_bbr, to be:",
            "",
            "   *  Higher than 2 sec to try to avoid causing loss for a long enough",
            "      time to allow Reno flow with RTT=30ms to get 25Mbps (4K video)",
            "      throughput.  For this workload, given the Reno sawtooth that",
            "      raises cwnd from roughly BDP to 2*BDP, one MSS per round trip, the",
            "      inter-bandwidth-probe time must be at least: BDP * RTT = 25Mbps *",
            "      .030 sec / (1514 bytes) * 0.030 sec = 1.9secs",
            "",
            "   *  Lower than 3 sec to ensure flows can start probing in a reasonable",
            "      amount of time to discover unutilized bw on human-scale",
            "      interactive time-scales (e.g. perhaps traffic from a competing web",
            "      page download is now complete).",
            "",
            "   The maximum round-trip bounds of the Reno-coexistence time scale,",
            "   T_reno, are chosen to be 62-63 with the following considerations in",
            "   mind:",
            "",
            "   *  Choosing a value smaller than roughly 60 would imply that when BBR",
            "      flows coexisted with Reno/CUBIC flows (e.g.  Netflix Reno flows)",
            "      on public Internet broadband links, the Reno/CUBIC flows would not",
            "      be able to achieve enough bandwidth to show 4K video.",
            "",
            "   *  Choosing a value larger than roughly 65 would prevent BBR from",
            "      reaching its goal of tolerating 1% loss per round trip.  Given",
            "      that the steady-state (non-bandwidth-probing) BBR response to a",
            "      round trip with X% packet loss is to reduce the sending rate by X%",
            "      (see the \"Updating the Model Upon Packet Loss\" section), this",
            "      means that the BBR sending rate after N rounds of packet loss at a",
            "      rate loss_rate is (1 - loss_rate)^N.  This means that for a flow",
            "      that encounters 1% loss in 65 round trips of ProbeBW_CRUISE, and",
            "      then doubles its cwnd (back to BBR.inflight_hi) in ProbeBW_REFILL",
            "      and ProbeBW_UP, it will be able to restore and reprobe its",
            "      original sending rate, since: BBW.max_bw * (1 - loss_rate)^N * 2 =",
            "      BBR.max_bw * (1 - .01)^65 ~= 1.04 * BBR.max_bw.  That is, the flow",
            "      will be able to fully respond to packet loss signals in",
            "      ProbeBW_CRUISE while also fully re-measuring its maximum",
            "      achievable throughput in ProbeBW_UP.",
            "",
            "   The resulting behavior is that for BBR flows with small BDPs, the",
            "   bandwidth probing will be on roughly the same time scale as Reno/",
            "   CUBIC; flows with large BDPs will intentionally probe more rapidly/",
            "   frequently than Reno/CUBIC would (roughly every 62 round trips for",
            "   low-RTT flows, or 2-3 secs for high-RTT flows).",
            "",
            "   The considerations above for timing bandwidth probing can be",
            "   implemented as follows:",
            "",
            "     /* Is it time to transition from DOWN or CRUISE to REFILL? */",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "     "
              },
              {
                "annotation_ids": [
                  "7f6fa4bc3277600a"
                ],
                "status_id": 1,
                "text": "BBRCheckTimeToProbeBW():"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "       "
              },
              {
                "annotation_ids": [
                  "7f6fa4bc3277600a"
                ],
                "status_id": 1,
                "text": "if (BBRHasElapsedInPhase(BBR.bw_probe_wait) ||"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "           "
              },
              {
                "annotation_ids": [
                  "7f6fa4bc3277600a"
                ],
                "status_id": 1,
                "text": "BBRIsRenoCoexistenceProbeTime())"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "         "
              },
              {
                "annotation_ids": [
                  "7f6fa4bc3277600a"
                ],
                "status_id": 1,
                "text": "BBRStartProbeBW_REFILL()"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "         "
              },
              {
                "annotation_ids": [
                  "7f6fa4bc3277600a"
                ],
                "status_id": 1,
                "text": "return true"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "       "
              },
              {
                "annotation_ids": [
                  "7f6fa4bc3277600a"
                ],
                "status_id": 1,
                "text": "return false"
              }
            ],
            "",
            "     /* Randomized decision about how long to wait until",
            "      * probing for bandwidth, using round count and wall clock.",
            "      */",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "     "
              },
              {
                "annotation_ids": [
                  "1de04125c062a74b"
                ],
                "status_id": 1,
                "text": "BBRPickProbeWait():"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "       "
              },
              {
                "annotation_ids": [
                  "1de04125c062a74b"
                ],
                "status_id": 1,
                "text": "/* Decide random round-trip bound for wait: */"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "       "
              },
              {
                "annotation_ids": [
                  "1de04125c062a74b"
                ],
                "status_id": 1,
                "text": "BBR.rounds_since_bw_probe ="
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "         "
              },
              {
                "annotation_ids": [
                  "1de04125c062a74b"
                ],
                "status_id": 1,
                "text": "random_int_between(0, 1); /* 0 or 1 */"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "       "
              },
              {
                "annotation_ids": [
                  "1de04125c062a74b"
                ],
                "status_id": 1,
                "text": "/* Decide the random wall clock bound for wait: */"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "       "
              },
              {
                "annotation_ids": [
                  "1de04125c062a74b"
                ],
                "status_id": 1,
                "text": "BBR.bw_probe_wait ="
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "         "
              },
              {
                "annotation_ids": [
                  "1de04125c062a74b"
                ],
                "status_id": 1,
                "text": "2sec + random_float_between(0.0, 1.0) /* 0..1 sec */"
              }
            ],
            "",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "     "
              },
              {
                "annotation_ids": [
                  "35dac15be609d870"
                ],
                "status_id": 1,
                "text": "BBRIsRenoCoexistenceProbeTime():"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "       "
              },
              {
                "annotation_ids": [
                  "35dac15be609d870"
                ],
                "status_id": 1,
                "text": "reno_rounds = BBRTargetInflight()"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "       "
              },
              {
                "annotation_ids": [
                  "35dac15be609d870"
                ],
                "status_id": 1,
                "text": "rounds = min(reno_rounds, 63)"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "       "
              },
              {
                "annotation_ids": [
                  "35dac15be609d870"
                ],
                "status_id": 1,
                "text": "return BBR.rounds_since_bw_probe >= rounds"
              }
            ],
            "",
            "     /* How much data do we want in flight?",
            "      * Our estimated BDP, unless congestion cut cwnd. */",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "     "
              },
              {
                "annotation_ids": [
                  "67f0748802193bb8",
                  "624702ce09719db9"
                ],
                "status_id": 1,
                "text": "BBRTargetInflight()"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "       "
              },
              {
                "annotation_ids": [
                  "67f0748802193bb8",
                  "624702ce09719db9"
                ],
                "status_id": 1,
                "text": "return min(BBR.bdp, cwnd)"
              }
            ]
          ],
          "title": "Design Considerations for Choosing Constant Parameters"
        },
        {
          "id": "section-4.3.3.6",
          "lines": [
            "   BBR's ProbeBW algorithm operates as follows.",
            "",
            "   Upon entering ProbeBW, BBR executes:",
            "",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "     "
              },
              {
                "annotation_ids": [
                  "c3960918dbf936ec"
                ],
                "status_id": 1,
                "text": "BBREnterProbeBW():"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "       "
              },
              {
                "annotation_ids": [
                  "c3960918dbf936ec"
                ],
                "status_id": 1,
                "text": "BBRStartProbeBW_DOWN()"
              }
            ],
            "",
            "   The core logic for entering each state:",
            "",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "     "
              },
              {
                "annotation_ids": [
                  "44110f5c05f3fb8f"
                ],
                "status_id": 1,
                "text": "BBRStartProbeBW_DOWN():"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "       "
              },
              {
                "annotation_ids": [
                  "44110f5c05f3fb8f"
                ],
                "status_id": 1,
                "text": "BBRResetCongestionSignals()"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "       "
              },
              {
                "annotation_ids": [
                  "44110f5c05f3fb8f"
                ],
                "status_id": 1,
                "text": "BBR.probe_up_cnt = Infinity /* not growing inflight_hi */"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "       "
              },
              {
                "annotation_ids": [
                  "44110f5c05f3fb8f"
                ],
                "status_id": 1,
                "text": "BBRPickProbeWait()"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "       "
              },
              {
                "annotation_ids": [
                  "44110f5c05f3fb8f"
                ],
                "status_id": 1,
                "text": "BBR.cycle_stamp = Now()  /* start wall clock */"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "       "
              },
              {
                "annotation_ids": [
                  "44110f5c05f3fb8f"
                ],
                "status_id": 1,
                "text": "BBR.ack_phase  = ACKS_PROBE_STOPPING"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "       "
              },
              {
                "annotation_ids": [
                  "44110f5c05f3fb8f"
                ],
                "status_id": 1,
                "text": "BBRStartRound()"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "       "
              },
              {
                "annotation_ids": [
                  "44110f5c05f3fb8f"
                ],
                "status_id": 1,
                "text": "BBR.state = ProbeBW_DOWN"
              }
            ],
            "",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "     "
              },
              {
                "annotation_ids": [
                  "0857f7af82040f0f"
                ],
                "status_id": 1,
                "text": "BBRStartProbeBW_CRUISE():"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "       "
              },
              {
                "annotation_ids": [
                  "0857f7af82040f0f"
                ],
                "status_id": 1,
                "text": "BBR.state = ProbeBW_CRUISE"
              }
            ],
            "",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "     "
              },
              {
                "annotation_ids": [
                  "09151652023f8b2d"
                ],
                "status_id": 1,
                "text": "BBRStartProbeBW_REFILL():"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "       "
              },
              {
                "annotation_ids": [
                  "09151652023f8b2d"
                ],
                "status_id": 1,
                "text": "BBRResetLowerBounds()"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "       "
              },
              {
                "annotation_ids": [
                  "09151652023f8b2d"
                ],
                "status_id": 1,
                "text": "BBR.bw_probe_up_rounds = 0"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "       "
              },
              {
                "annotation_ids": [
                  "09151652023f8b2d"
                ],
                "status_id": 1,
                "text": "BBR.bw_probe_up_acks = 0"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "       "
              },
              {
                "annotation_ids": [
                  "09151652023f8b2d"
                ],
                "status_id": 1,
                "text": "BBR.ack_phase = ACKS_REFILLING"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "       "
              },
              {
                "annotation_ids": [
                  "09151652023f8b2d"
                ],
                "status_id": 1,
                "text": "BBRStartRound()"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "       "
              },
              {
                "annotation_ids": [
                  "09151652023f8b2d"
                ],
                "status_id": 1,
                "text": "BBR.state = ProbeBW_REFILL"
              }
            ],
            "",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "     "
              },
              {
                "annotation_ids": [
                  "86f8dedb6a5f2cbb"
                ],
                "status_id": 1,
                "text": "BBRStartProbeBW_UP():"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "       "
              },
              {
                "annotation_ids": [
                  "86f8dedb6a5f2cbb"
                ],
                "status_id": 1,
                "text": "BBR.ack_phase = ACKS_PROBE_STARTING"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "       "
              },
              {
                "annotation_ids": [
                  "86f8dedb6a5f2cbb"
                ],
                "status_id": 1,
                "text": "BBRStartRound()"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "       "
              },
              {
                "annotation_ids": [
                  "86f8dedb6a5f2cbb"
                ],
                "status_id": 1,
                "text": "BBR.cycle_stamp = Now() /* start wall clock */"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "       "
              },
              {
                "annotation_ids": [
                  "86f8dedb6a5f2cbb"
                ],
                "status_id": 1,
                "text": "BBR.state = ProbeBW_UP"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "       "
              },
              {
                "annotation_ids": [
                  "86f8dedb6a5f2cbb"
                ],
                "status_id": 1,
                "text": "BBRRaiseInflightHiSlope()"
              }
            ],
            "",
            "   BBR executes the following BBRUpdateProbeBWCyclePhase() logic on each",
            "   ACK that ACKs or SACKs new data, to advance the ProbeBW state",
            "   machine:",
            "",
            "     /* The core state machine logic for ProbeBW: */",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "     "
              },
              {
                "annotation_ids": [
                  "f0193b7dc503e513"
                ],
                "status_id": 1,
                "text": "BBRUpdateProbeBWCyclePhase():"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "       "
              },
              {
                "annotation_ids": [
                  "f0193b7dc503e513"
                ],
                "status_id": 1,
                "text": "if (!BBR.filled_pipe)"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "         "
              },
              {
                "annotation_ids": [
                  "f0193b7dc503e513"
                ],
                "status_id": 1,
                "text": "return  /* only handling steady-state behavior here */"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "       "
              },
              {
                "annotation_ids": [
                  "f0193b7dc503e513"
                ],
                "status_id": 1,
                "text": "BBRAdaptUpperBounds()"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "       "
              },
              {
                "annotation_ids": [
                  "f0193b7dc503e513"
                ],
                "status_id": 1,
                "text": "if (!IsInAProbeBWState())"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "         "
              },
              {
                "annotation_ids": [
                  "f0193b7dc503e513"
                ],
                "status_id": 1,
                "text": "return /* only handling ProbeBW states here: */"
              }
            ],
            "",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "       "
              },
              {
                "annotation_ids": [
                  "f0193b7dc503e513"
                ],
                "status_id": 1,
                "text": "switch (state)"
              }
            ],
            "",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "       "
              },
              {
                "annotation_ids": [
                  "f0193b7dc503e513"
                ],
                "status_id": 1,
                "text": "ProbeBW_DOWN:"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "         "
              },
              {
                "annotation_ids": [
                  "f0193b7dc503e513"
                ],
                "status_id": 1,
                "text": "if (BBRCheckTimeToProbeBW())"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "           "
              },
              {
                "annotation_ids": [
                  "f0193b7dc503e513"
                ],
                "status_id": 1,
                "text": "return /* already decided state transition */"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "         "
              },
              {
                "annotation_ids": [
                  "f0193b7dc503e513"
                ],
                "status_id": 1,
                "text": "if (BBRCheckTimeToCruise())"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "           "
              },
              {
                "annotation_ids": [
                  "f0193b7dc503e513"
                ],
                "status_id": 1,
                "text": "BBRStartProbeBW_CRUISE()"
              }
            ],
            "",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "       "
              },
              {
                "annotation_ids": [
                  "f0193b7dc503e513"
                ],
                "status_id": 1,
                "text": "ProbeBW_CRUISE:"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "         "
              },
              {
                "annotation_ids": [
                  "f0193b7dc503e513"
                ],
                "status_id": 1,
                "text": "if (BBRCheckTimeToProbeBW())"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "           "
              },
              {
                "annotation_ids": [
                  "f0193b7dc503e513"
                ],
                "status_id": 1,
                "text": "return /* already decided state transition */"
              }
            ],
            "",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "       "
              },
              {
                "annotation_ids": [
                  "f0193b7dc503e513"
                ],
                "status_id": 1,
                "text": "ProbeBW_REFILL:"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "         "
              },
              {
                "annotation_ids": [
                  "f0193b7dc503e513"
                ],
                "status_id": 1,
                "text": "/* After one round of REFILL, start UP */"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "         "
              },
              {
                "annotation_ids": [
                  "f0193b7dc503e513"
                ],
                "status_id": 1,
                "text": "if (BBR.round_start)"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "           "
              },
              {
                "annotation_ids": [
                  "f0193b7dc503e513"
                ],
                "status_id": 1,
                "text": "BBR.bw_probe_samples = 1"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "           "
              },
              {
                "annotation_ids": [
                  "f0193b7dc503e513"
                ],
                "status_id": 1,
                "text": "BBRStartProbeBW_UP()"
              }
            ],
            "",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "       "
              },
              {
                "annotation_ids": [
                  "f0193b7dc503e513"
                ],
                "status_id": 1,
                "text": "ProbeBW_UP:"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "         "
              },
              {
                "annotation_ids": [
                  "f0193b7dc503e513"
                ],
                "status_id": 1,
                "text": "if (BBRHasElapsedInPhase(BBR.min_rtt) and"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "             "
              },
              {
                "annotation_ids": [
                  "f0193b7dc503e513"
                ],
                "status_id": 1,
                "text": "inflight > BBRInflight(BBR.max_bw, 1.25))"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "           "
              },
              {
                "annotation_ids": [
                  "f0193b7dc503e513"
                ],
                "status_id": 1,
                "text": "BBRStartProbeBW_DOWN()"
              }
            ],
            "",
            "   The ancillary logic to implement the ProbeBW state machine:",
            "",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "     "
              },
              {
                "annotation_ids": [
                  "3663dd3340fa434c"
                ],
                "status_id": 1,
                "text": "IsInAProbeBWState()"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "       "
              },
              {
                "annotation_ids": [
                  "3663dd3340fa434c"
                ],
                "status_id": 1,
                "text": "state = BBR.state"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "       "
              },
              {
                "annotation_ids": [
                  "3663dd3340fa434c"
                ],
                "status_id": 1,
                "text": "return (state == ProbeBW_DOWN or"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "               "
              },
              {
                "annotation_ids": [
                  "3663dd3340fa434c"
                ],
                "status_id": 1,
                "text": "state == ProbeBW_CRUISE or"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "               "
              },
              {
                "annotation_ids": [
                  "3663dd3340fa434c"
                ],
                "status_id": 1,
                "text": "state == ProbeBW_REFILL or"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "               "
              },
              {
                "annotation_ids": [
                  "3663dd3340fa434c"
                ],
                "status_id": 1,
                "text": "state == ProbeBW_UP)"
              }
            ],
            "",
            "     /* Time to transition from DOWN to CRUISE? */",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "     "
              },
              {
                "annotation_ids": [
                  "b8134ec57c4541df"
                ],
                "status_id": 1,
                "text": "BBRCheckTimeToCruise():"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "       "
              },
              {
                "annotation_ids": [
                  "b8134ec57c4541df"
                ],
                "status_id": 1,
                "text": "if (inflight > BBRInflightWithHeadroom())"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "         "
              },
              {
                "annotation_ids": [
                  "b8134ec57c4541df"
                ],
                "status_id": 1,
                "text": "return false /* not enough headroom */"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "       "
              },
              {
                "annotation_ids": [
                  "b8134ec57c4541df"
                ],
                "status_id": 1,
                "text": "if (inflight <= BBRInflight(BBR.max_bw, 1.0))"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "         "
              },
              {
                "annotation_ids": [
                  "b8134ec57c4541df"
                ],
                "status_id": 1,
                "text": "return true  /* inflight <= estimated BDP */"
              }
            ],
            "",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "     "
              },
              {
                "annotation_ids": [
                  "e22d44538dd6ecc8"
                ],
                "status_id": 1,
                "text": "BBRHasElapsedInPhase(interval):"
              }
            ],
            "",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "       "
              },
              {
                "annotation_ids": [
                  "e22d44538dd6ecc8"
                ],
                "status_id": 1,
                "text": "return Now() > BBR.cycle_stamp + interval"
              }
            ],
            "",
            "     /* Return a volume of data that tries to leave free",
            "      * headroom in the bottleneck buffer or link for",
            "      * other flows, for fairness convergence and lower",
            "      * RTTs and loss */",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "     "
              },
              {
                "annotation_ids": [
                  "b756362799c482f2",
                  "6a3ace3b8b43eb00"
                ],
                "status_id": 2,
                "text": "BBRInflightWithHeadroom():"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "       "
              },
              {
                "annotation_ids": [
                  "b756362799c482f2",
                  "6a3ace3b8b43eb00"
                ],
                "status_id": 2,
                "text": "if (BBR.inflight_hi == Infinity)"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "         "
              },
              {
                "annotation_ids": [
                  "b756362799c482f2",
                  "6a3ace3b8b43eb00"
                ],
                "status_id": 2,
                "text": "return Infinity"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "       "
              },
              {
                "annotation_ids": [
                  "b756362799c482f2",
                  "6a3ace3b8b43eb00"
                ],
                "status_id": 2,
                "text": "headroom = max(1, BBRHeadroom * BBR.inflight_hi)"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "         "
              },
              {
                "annotation_ids": [
                  "b756362799c482f2",
                  "6a3ace3b8b43eb00"
                ],
                "status_id": 2,
                "text": "return max(BBR.inflight_hi - headroom,"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "                    "
              },
              {
                "annotation_ids": [
                  "b756362799c482f2",
                  "6a3ace3b8b43eb00"
                ],
                "status_id": 2,
                "text": "BBRMinPipeCwnd)"
              }
            ],
            "",
            "     /* Raise inflight_hi slope if appropriate. */",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "     "
              },
              {
                "annotation_ids": [
                  "3f9d4bbcb1fa7405"
                ],
                "status_id": 1,
                "text": "BBRRaiseInflightHiSlope():"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "       "
              },
              {
                "annotation_ids": [
                  "3f9d4bbcb1fa7405"
                ],
                "status_id": 1,
                "text": "growth_this_round = 1MSS << BBR.bw_probe_up_rounds"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "       "
              },
              {
                "annotation_ids": [
                  "3f9d4bbcb1fa7405"
                ],
                "status_id": 1,
                "text": "BBR.bw_probe_up_rounds = min(BBR.bw_probe_up_rounds + 1, 30)"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "       "
              },
              {
                "annotation_ids": [
                  "3f9d4bbcb1fa7405"
                ],
                "status_id": 1,
                "text": "BBR.probe_up_cnt = max(cwnd / growth_this_round, 1)"
              }
            ],
            "",
            "     /* Increase inflight_hi if appropriate. */",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "     "
              },
              {
                "annotation_ids": [
                  "a6742ca709e70048"
                ],
                "status_id": 1,
                "text": "BBRProbeInflightHiUpward():"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "       "
              },
              {
                "annotation_ids": [
                  "a6742ca709e70048"
                ],
                "status_id": 1,
                "text": "if (!is_cwnd_limited or cwnd < BBR.inflight_hi)"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "         "
              },
              {
                "annotation_ids": [
                  "a6742ca709e70048"
                ],
                "status_id": 1,
                "text": "return  /* not fully using inflight_hi, so don't grow it */"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "      "
              },
              {
                "annotation_ids": [
                  "a6742ca709e70048"
                ],
                "status_id": 1,
                "text": "BBR.bw_probe_up_acks += rs.newly_acked"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "      "
              },
              {
                "annotation_ids": [
                  "a6742ca709e70048"
                ],
                "status_id": 1,
                "text": "if (BBR.bw_probe_up_acks >= BBR.probe_up_cnt)"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "        "
              },
              {
                "annotation_ids": [
                  "a6742ca709e70048"
                ],
                "status_id": 1,
                "text": "delta = BBR.bw_probe_up_acks / BBR.probe_up_cnt"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "        "
              },
              {
                "annotation_ids": [
                  "a6742ca709e70048"
                ],
                "status_id": 1,
                "text": "BBR.bw_probe_up_acks -= delta * BBR.bw_probe_up_cnt"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "        "
              },
              {
                "annotation_ids": [
                  "a6742ca709e70048"
                ],
                "status_id": 1,
                "text": "BBR.inflight_hi += delta"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "      "
              },
              {
                "annotation_ids": [
                  "a6742ca709e70048"
                ],
                "status_id": 1,
                "text": "if (BBR.round_start)"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "        "
              },
              {
                "annotation_ids": [
                  "a6742ca709e70048"
                ],
                "status_id": 1,
                "text": "BBRRaiseInflightHiSlope()"
              }
            ],
            "",
            "     /* Track ACK state and update BBR.max_bw window and",
            "      * BBR.inflight_hi and BBR.bw_hi. */",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "     "
              },
              {
                "annotation_ids": [
                  "18e2e102ab1bd4c1"
                ],
                "status_id": 1,
                "text": "BBRAdaptUpperBounds():"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "       "
              },
              {
                "annotation_ids": [
                  "18e2e102ab1bd4c1",
                  "73b421d1defe88e3"
                ],
                "status_id": 1,
                "text": "if (BBR.ack_phase == ACKS_PROBE_STARTING and BBR.round_start)"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "         "
              },
              {
                "annotation_ids": [
                  "18e2e102ab1bd4c1",
                  "73b421d1defe88e3"
                ],
                "status_id": 1,
                "text": "/* starting to get bw probing samples */"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "         "
              },
              {
                "annotation_ids": [
                  "18e2e102ab1bd4c1",
                  "73b421d1defe88e3"
                ],
                "status_id": 1,
                "text": "BBR.ack_phase = ACKS_PROBE_FEEDBACK"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "       "
              },
              {
                "annotation_ids": [
                  "18e2e102ab1bd4c1",
                  "73b421d1defe88e3"
                ],
                "status_id": 1,
                "text": "if (BBR.ack_phase == ACKS_PROBE_STOPPING and BBR.round_start)"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "         "
              },
              {
                "annotation_ids": [
                  "18e2e102ab1bd4c1",
                  "73b421d1defe88e3"
                ],
                "status_id": 1,
                "text": "/* end of samples from bw probing phase */"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "         "
              },
              {
                "annotation_ids": [
                  "18e2e102ab1bd4c1",
                  "73b421d1defe88e3"
                ],
                "status_id": 1,
                "text": "if (IsInAProbeBWState() and !rs.is_app_limited)"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "           "
              },
              {
                "annotation_ids": [
                  "18e2e102ab1bd4c1",
                  "73b421d1defe88e3"
                ],
                "status_id": 1,
                "text": "BBRAdvanceMaxBwFilter()"
              }
            ],
            "",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "       "
              },
              {
                "annotation_ids": [
                  "18e2e102ab1bd4c1"
                ],
                "status_id": 1,
                "text": "if (!CheckInflightTooHigh())"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "         "
              },
              {
                "annotation_ids": [
                  "18e2e102ab1bd4c1"
                ],
                "status_id": 1,
                "text": "/* Loss rate is safe. Adjust upper bounds upward. */"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "         "
              },
              {
                "annotation_ids": [
                  "18e2e102ab1bd4c1"
                ],
                "status_id": 1,
                "text": "if (BBR.inflight_hi == Infinity or BBR.bw_hi == Infinity)"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "           "
              },
              {
                "annotation_ids": [
                  "18e2e102ab1bd4c1"
                ],
                "status_id": 1,
                "text": "return /* no upper bounds to raise */"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "         "
              },
              {
                "annotation_ids": [
                  "18e2e102ab1bd4c1"
                ],
                "status_id": 1,
                "text": "if (rs.tx_in_flight > BBR.inflight_hi)"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "           "
              },
              {
                "annotation_ids": [
                  "18e2e102ab1bd4c1"
                ],
                "status_id": 1,
                "text": "BBR.inflight_hi = rs.tx_in_flight"
              }
            ],
            "",
            "         if (rs.delivery_rate > BBR.bw_hi)",
            "           BBR.bw_hi = rs.bw",
            "         if (BBR.state == ProbeBW_UP)",
            "           BBRProbeInflightHiUpward()"
          ],
          "title": "ProbeBW Algorithm Details"
        },
        {
          "id": "section-4.3.4",
          "lines": [],
          "title": "ProbeRTT"
        },
        {
          "id": "section-4.3.4.1",
          "lines": [
            "   To help probe for BBR.min_rtt, on an as-needed basis BBR flows enter",
            "   the ProbeRTT state to try to cooperate to periodically drain the",
            "   bottleneck queue - and thus improve their BBR.min_rtt estimate of the",
            "   unloaded two-way propagation delay.",
            "",
            "   A critical point is that before BBR raises its BBR.min_rtt estimate",
            "   (which would in turn raise its maximum permissible cwnd), it first",
            "   enters ProbeRTT to try to make a concerted and coordinated effort to",
            "   drain the bottleneck queue and make a robust BBR.min_rtt measurement.",
            "   This allows the BBR.min_rtt estimates of ensembles of BBR flows to",
            "   converge avoiding feedback loops of ever-increasing queues and RTT",
            "   samples.",
            "",
            "   The ProbeRTT state works in concert with BBR.min_rtt estimation.  Up",
            "   to once every ProbeRTTInterval = 5 seconds, the flow enters ProbeRTT,",
            "   decelerating by setting its cwnd_gain to BBRProbeRTTCwndGain = 0.5 to",
            "   reduce its volume of inflight data to half of its estimated BDP, to",
            "   try to allow the flow to measure the unloaded two-way propagation",
            "   delay.",
            "",
            "   There are two main motivations for making the MinRTTFilterLen roughly",
            "   twice the ProbeRTTInterval.  First, this ensures that during a",
            "   ProbeRTT episode the flow will \"remember\" the BBR.min_rtt value it",
            "   measured during the previous ProbeRTT episode, providing a robust bdp",
            "   estimate for the cwnd = 0.5*bdp calculation, increasing the",
            "   likelihood of fully draining the bottleneck queue.  Second, this",
            "   allows the flow's BBR.min_rtt filter window to generally include RTT",
            "   samples from two ProbeTT episodes, providing a more robust estimate.",
            "",
            "   The algorithm for ProbeRTT is as follows:",
            "",
            "   Entry conditions: In any state other than ProbeRTT itself, if the",
            "   BBR.probe_rtt_min_delay estimate has not been updated (i.e., by",
            "   getting a lower RTT measurement) for more than ProbeRTTInterval = 5",
            "   seconds, then BBR enters ProbeRTT and reduces the BBR.cwnd_gain to",
            "   BBRProbeRTTCwndGain = 0.5.",
            "",
            "   Exit conditions: After maintaining the volume of in-flight data at",
            "   BBRProbeRTTCwndGain*BBR.bdp for at least ProbeRTTDuration (200 ms)",
            "   and at least one round trip, BBR leaves ProbeRTT and transitions to",
            "   ProbeBW if it estimates the pipe was filled already, or Startup",
            "   otherwise."
          ],
          "title": "ProbeRTT Overview"
        },
        {
          "id": "section-4.3.4.2",
          "lines": [
            "   BBR is designed to have ProbeRTT sacrifice no more than roughly 2% of",
            "   a flow's available bandwidth.  It is also designed to spend the vast",
            "   majority of its time (at least roughly 96 percent) in ProbeBW and the",
            "   rest in ProbeRTT, based on a set of tradeoffs.  ProbeRTT lasts long",
            "   enough (at least ProbeRTTDuration = 200 ms) to allow flows with",
            "   different RTTs to have overlapping ProbeRTT states, while still being",
            "   short enough to bound the throughput penalty of ProbeRTT's cwnd",
            "   capping to roughly 2%, with the average throughput targeted at:",
            "",
            "     throughput = (200ms*0.5*BBR.bw + (5s - 200ms)*BBR.bw) / 5s",
            "                = (.1s + 4.8s)/5s * BBR.bw = 0.98 * BBR.bw",
            "",
            "   As discussed above, BBR's BBR.min_rtt filter window, MinRTTFilterLen,",
            "   and time interval between ProbeRTT states, ProbeRTTInterval, work in",
            "   concert.  BBR uses a MinRTTFilterLen equal to or longer than",
            "   ProbeRTTInterval to allow the filter window to include at least one",
            "   ProbeRTT.",
            "",
            "   To allow coordination with other BBR flows, each flow MUST use the",
            "   standard ProbeRTTInterval of 5 secs.",
            "",
            "   An ProbeRTTInterval of 5 secs is short enough to allow quick",
            "   convergence if traffic levels or routes change, but long enough so",
            "   that interactive applications (e.g., Web, remote procedure calls,",
            "   video chunks) often have natural silences or low-rate periods within",
            "   the window where the flow's rate is low enough for long enough to",
            "   drain its queue in the bottleneck.  Then the BBR.probe_rtt_min_delay",
            "   filter opportunistically picks up these measurements, and the",
            "   BBR.probe_rtt_min_delay estimate refreshes without requiring",
            "   ProbeRTT.  This way, flows typically need only pay the 2 percent",
            "   throughput penalty if there are multiple bulk flows busy sending over",
            "   the entire ProbeRTTInterval window.",
            "",
            "   As an optimization, when restarting from idle and finding that the",
            "   BBR.probe_rtt_min_delay has expired, BBR does not enter ProbeRTT; the",
            "   idleness is deemed a sufficient attempt to coordinate to drain the",
            "   queue."
          ],
          "title": "ProbeRTT Design Rationale"
        },
        {
          "id": "section-4.3.4.3",
          "lines": [
            "   Upon transmitting each packet, BBR (or the associated transport",
            "   protocol) stores in per-packet data the wall-clock scheduled",
            "   transmission time of the packet in packet.departure_time (see the",
            "   \"Pacing Rate: BBR.pacing_rate\" section for how this is calculated).",
            "",
            "   For every ACK that newly acknowledges some data (whether cumulatively",
            "   or selectively), the sender's BBR implementation (or the associated",
            "   transport protocol implementation) attempts to calculate an RTT",
            "   sample.  The sender MUST consider any potential retransmission",
            "   ambiguities that can arise in some transport protocols.  If some of",
            "   the acknowledged data was not retransmitted, or some of the data was",
            "   retransmitted but the sender can still unambiguously determine the",
            "   RTT of the data (e.g. if the transport supports [RFC7323] TCP",
            "   timestamps or an equivalent mechanism), then the sender calculates an",
            "   RTT sample, rs.rtt, as follows:",
            "",
            "     rs.rtt = Now() - packet.departure_time"
          ],
          "title": "Calculating the rs.rtt RTT Sample"
        },
        {
          "id": "section-4.3.4.4",
          "lines": [
            "   On every ACK BBR executes BBRUpdateMinRTT() to update its ProbeRTT",
            "   scheduling state (BBR.probe_rtt_min_delay and",
            "   BBR.probe_rtt_min_stamp) and its BBR.min_rtt estimate:",
            "",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "     "
              },
              {
                "annotation_ids": [
                  "176fbe66d5d43e4c"
                ],
                "status_id": 1,
                "text": "BBRUpdateMinRTT()"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "       "
              },
              {
                "annotation_ids": [
                  "176fbe66d5d43e4c"
                ],
                "status_id": 1,
                "text": "BBR.probe_rtt_expired ="
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "         "
              },
              {
                "annotation_ids": [
                  "176fbe66d5d43e4c"
                ],
                "status_id": 1,
                "text": "Now() > BBR.probe_rtt_min_stamp + ProbeRTTInterval"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "       "
              },
              {
                "annotation_ids": [
                  "176fbe66d5d43e4c"
                ],
                "status_id": 1,
                "text": "if (rs.rtt >= 0 and"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "           "
              },
              {
                "annotation_ids": [
                  "176fbe66d5d43e4c"
                ],
                "status_id": 1,
                "text": "(rs.rtt < BBR.probe_rtt_min_delay or"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "            "
              },
              {
                "annotation_ids": [
                  "176fbe66d5d43e4c"
                ],
                "status_id": 1,
                "text": "BBR.probe_rtt_expired))"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "          "
              },
              {
                "annotation_ids": [
                  "176fbe66d5d43e4c"
                ],
                "status_id": 1,
                "text": "BBR.probe_rtt_min_delay = rs.rtt"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "          "
              },
              {
                "annotation_ids": [
                  "176fbe66d5d43e4c"
                ],
                "status_id": 1,
                "text": "BBR.probe_rtt_min_stamp = Now()"
              }
            ],
            "",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "       "
              },
              {
                "annotation_ids": [
                  "176fbe66d5d43e4c"
                ],
                "status_id": 1,
                "text": "min_rtt_expired ="
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "         "
              },
              {
                "annotation_ids": [
                  "176fbe66d5d43e4c"
                ],
                "status_id": 1,
                "text": "Now() > BBR.min_rtt_stamp + MinRTTFilterLen"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "       "
              },
              {
                "annotation_ids": [
                  "176fbe66d5d43e4c"
                ],
                "status_id": 1,
                "text": "if (BBR.probe_rtt_min_delay < BBR.min_rtt or"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "           "
              },
              {
                "annotation_ids": [
                  "176fbe66d5d43e4c"
                ],
                "status_id": 1,
                "text": "min_rtt_expired)"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "         "
              },
              {
                "annotation_ids": [
                  "176fbe66d5d43e4c"
                ],
                "status_id": 1,
                "text": "BBR.min_rtt       = BBR.probe_rtt_min_delay"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "         "
              },
              {
                "annotation_ids": [
                  "176fbe66d5d43e4c"
                ],
                "status_id": 1,
                "text": "BBR.min_rtt_stamp = BBR.probe_rtt_min_stamp"
              }
            ],
            "",
            "   Here BBR.probe_rtt_expired is a boolean recording whether the",
            "   BBR.probe_rtt_min_delay has expired and is due for a refresh, via",
            "   either an application idle period or a transition into ProbeRTT",
            "   state.",
            "",
            "   On every ACK BBR executes BBRCheckProbeRTT() to handle the steps",
            "   related to the ProbeRTT state as follows:",
            "",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "     "
              },
              {
                "annotation_ids": [
                  "f04d9631bdcacd55"
                ],
                "status_id": 1,
                "text": "BBRCheckProbeRTT():"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "       "
              },
              {
                "annotation_ids": [
                  "f04d9631bdcacd55"
                ],
                "status_id": 1,
                "text": "if (BBR.state != ProbeRTT and"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "           "
              },
              {
                "annotation_ids": [
                  "f04d9631bdcacd55"
                ],
                "status_id": 1,
                "text": "BBR.probe_rtt_expired and"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "           "
              },
              {
                "annotation_ids": [
                  "f04d9631bdcacd55"
                ],
                "status_id": 1,
                "text": "not BBR.idle_restart)"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "         "
              },
              {
                "annotation_ids": [
                  "f04d9631bdcacd55"
                ],
                "status_id": 1,
                "text": "BBREnterProbeRTT()"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "         "
              },
              {
                "annotation_ids": [
                  "f04d9631bdcacd55"
                ],
                "status_id": 1,
                "text": "BBRSaveCwnd()"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "         "
              },
              {
                "annotation_ids": [
                  "f04d9631bdcacd55"
                ],
                "status_id": 1,
                "text": "BBR.probe_rtt_done_stamp = 0"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "         "
              },
              {
                "annotation_ids": [
                  "f04d9631bdcacd55"
                ],
                "status_id": 1,
                "text": "BBR.ack_phase = ACKS_PROBE_STOPPING"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "         "
              },
              {
                "annotation_ids": [
                  "f04d9631bdcacd55"
                ],
                "status_id": 1,
                "text": "BBRStartRound()"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "       "
              },
              {
                "annotation_ids": [
                  "f04d9631bdcacd55"
                ],
                "status_id": 1,
                "text": "if (BBR.state == ProbeRTT)"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "         "
              },
              {
                "annotation_ids": [
                  "f04d9631bdcacd55"
                ],
                "status_id": 1,
                "text": "BBRHandleProbeRTT()"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "       "
              },
              {
                "annotation_ids": [
                  "f04d9631bdcacd55"
                ],
                "status_id": 1,
                "text": "if (rs.delivered > 0)"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "         "
              },
              {
                "annotation_ids": [
                  "f04d9631bdcacd55"
                ],
                "status_id": 1,
                "text": "BBR.idle_restart = false"
              }
            ],
            "",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "     "
              },
              {
                "annotation_ids": [
                  "cfb15ebc9ac82570",
                  "e294029e7d2fa462"
                ],
                "status_id": 2,
                "text": "BBREnterProbeRTT():"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "       "
              },
              {
                "annotation_ids": [
                  "cfb15ebc9ac82570",
                  "e294029e7d2fa462"
                ],
                "status_id": 2,
                "text": "BBR.state = ProbeRTT"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "       "
              },
              {
                "annotation_ids": [
                  "cfb15ebc9ac82570",
                  "e294029e7d2fa462"
                ],
                "status_id": 2,
                "text": "BBR.pacing_gain = 1"
              }
            ],
            "       BBR.cwnd_gain = BBRProbeRTTCwndGain  /* 0.5 */",
            "",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "     "
              },
              {
                "annotation_ids": [
                  "97f999f861fc0240"
                ],
                "status_id": 1,
                "text": "BBRHandleProbeRTT():"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "       "
              },
              {
                "annotation_ids": [
                  "97f999f861fc0240"
                ],
                "status_id": 1,
                "text": "/* Ignore low rate samples during ProbeRTT: */"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "       "
              },
              {
                "annotation_ids": [
                  "97f999f861fc0240"
                ],
                "status_id": 1,
                "text": "MarkConnectionAppLimited()"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "       "
              },
              {
                "annotation_ids": [
                  "97f999f861fc0240"
                ],
                "status_id": 1,
                "text": "if (BBR.probe_rtt_done_stamp == 0 and"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "           "
              },
              {
                "annotation_ids": [
                  "97f999f861fc0240"
                ],
                "status_id": 1,
                "text": "packets_in_flight <= BBRProbeRTTCwnd())"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "         "
              },
              {
                "annotation_ids": [
                  "97f999f861fc0240"
                ],
                "status_id": 1,
                "text": "/* Wait for at least ProbeRTTDuration to elapse: */"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "         "
              },
              {
                "annotation_ids": [
                  "97f999f861fc0240"
                ],
                "status_id": 1,
                "text": "BBR.probe_rtt_done_stamp ="
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "           "
              },
              {
                "annotation_ids": [
                  "97f999f861fc0240"
                ],
                "status_id": 1,
                "text": "Now() + ProbeRTTDuration"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "         "
              },
              {
                "annotation_ids": [
                  "97f999f861fc0240"
                ],
                "status_id": 1,
                "text": "/* Wait for at least one round to elapse: */"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "         "
              },
              {
                "annotation_ids": [
                  "97f999f861fc0240"
                ],
                "status_id": 1,
                "text": "BBR.probe_rtt_round_done = false"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "         "
              },
              {
                "annotation_ids": [
                  "97f999f861fc0240"
                ],
                "status_id": 1,
                "text": "BBRStartRound()"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "       "
              },
              {
                "annotation_ids": [
                  "97f999f861fc0240"
                ],
                "status_id": 1,
                "text": "else if (BBR.probe_rtt_done_stamp != 0)"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "         "
              },
              {
                "annotation_ids": [
                  "97f999f861fc0240"
                ],
                "status_id": 1,
                "text": "if (BBR.round_start)"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "           "
              },
              {
                "annotation_ids": [
                  "97f999f861fc0240"
                ],
                "status_id": 1,
                "text": "BBR.probe_rtt_round_done = true"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "         "
              },
              {
                "annotation_ids": [
                  "97f999f861fc0240"
                ],
                "status_id": 1,
                "text": "if (BBR.probe_rtt_round_done)"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "           "
              },
              {
                "annotation_ids": [
                  "97f999f861fc0240"
                ],
                "status_id": 1,
                "text": "BBRCheckProbeRTTDone()"
              }
            ],
            "",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "     "
              },
              {
                "annotation_ids": [
                  "7e6e5167c460aba2"
                ],
                "status_id": 1,
                "text": "BBRCheckProbeRTTDone():"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "       "
              },
              {
                "annotation_ids": [
                  "7e6e5167c460aba2"
                ],
                "status_id": 1,
                "text": "if (BBR.probe_rtt_done_stamp != 0 and"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "           "
              },
              {
                "annotation_ids": [
                  "7e6e5167c460aba2"
                ],
                "status_id": 1,
                "text": "Now() > BBR.probe_rtt_done_stamp)"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "         "
              },
              {
                "annotation_ids": [
                  "7e6e5167c460aba2"
                ],
                "status_id": 1,
                "text": "/* schedule next ProbeRTT: */"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "         "
              },
              {
                "annotation_ids": [
                  "7e6e5167c460aba2"
                ],
                "status_id": 1,
                "text": "BBR.probe_rtt_min_stamp = Now()"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "         "
              },
              {
                "annotation_ids": [
                  "7e6e5167c460aba2"
                ],
                "status_id": 1,
                "text": "BBRRestoreCwnd()"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "         "
              },
              {
                "annotation_ids": [
                  "7e6e5167c460aba2"
                ],
                "status_id": 1,
                "text": "BBRExitProbeRTT()"
              }
            ],
            "",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "     "
              },
              {
                "annotation_ids": [
                  "2118a25c08e1a85a"
                ],
                "status_id": 1,
                "text": "MarkConnectionAppLimited():"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "       "
              },
              {
                "annotation_ids": [
                  "2118a25c08e1a85a"
                ],
                "status_id": 1,
                "text": "C.app_limited ="
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "         "
              },
              {
                "annotation_ids": [
                  "2118a25c08e1a85a"
                ],
                "status_id": 1,
                "text": "(C.delivered + packets_in_flight) ? : 1"
              }
            ]
          ],
          "title": "ProbeRTT Logic"
        },
        {
          "id": "section-4.3.4.5",
          "lines": [
            "   When exiting ProbeRTT, BBR transitions to ProbeBW if it estimates the",
            "   pipe was filled already, or Startup otherwise.",
            "",
            "   When transitioning out of ProbeRTT, BBR calls BBRResetLowerBounds()",
            "   to reset the lower bounds, since any congestion encountered in",
            "   ProbeRTT may have pulled the short-term model far below the capacity",
            "   of the path.",
            "",
            "   But the algorithm is cautious in timing the next bandwidth probe:",
            "   raising inflight after ProbeRTT may cause loss, so the algorithm",
            "   resets the bandwidth-probing clock by starting the cycle at",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   ProbeBW_DOWN().  But then "
              },
              {
                "annotation_ids": [
                  "95a99e9ca171dd46"
                ],
                "status_id": 1,
                "text": "as an optimization, since the connection is"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "95a99e9ca171dd46"
                ],
                "status_id": 1,
                "text": "exiting ProbeRTT, we know that infligh is already below the estimated"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "95a99e9ca171dd46"
                ],
                "status_id": 1,
                "text": "BDP, so the connection can proceed immediately to ProbeBW_CRUISE"
              },
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "."
              }
            ],
            "",
            "   To summarize, the logic for exiting ProbeRTT is as follows:",
            "",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "     "
              },
              {
                "annotation_ids": [
                  "f5e080c0cc4084a2"
                ],
                "status_id": 1,
                "text": "BBRExitProbeRTT():"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "       "
              },
              {
                "annotation_ids": [
                  "f5e080c0cc4084a2"
                ],
                "status_id": 1,
                "text": "BBRResetLowerBounds()"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "       "
              },
              {
                "annotation_ids": [
                  "f5e080c0cc4084a2"
                ],
                "status_id": 1,
                "text": "if (BBR.filled_pipe)"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "         "
              },
              {
                "annotation_ids": [
                  "f5e080c0cc4084a2"
                ],
                "status_id": 1,
                "text": "BBRStartProbeBW_DOWN()"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "         "
              },
              {
                "annotation_ids": [
                  "f5e080c0cc4084a2"
                ],
                "status_id": 1,
                "text": "BBRStartProbeBW_CRUISE()"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "       "
              },
              {
                "annotation_ids": [
                  "f5e080c0cc4084a2"
                ],
                "status_id": 1,
                "text": "else"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "         "
              },
              {
                "annotation_ids": [
                  "f5e080c0cc4084a2"
                ],
                "status_id": 1,
                "text": "BBREnterStartup()"
              }
            ]
          ],
          "title": "Exiting ProbeRTT"
        },
        {
          "id": "section-4.4",
          "lines": [],
          "title": "Restarting From Idle"
        },
        {
          "id": "section-4.4.1",
          "lines": [
            "   When restarting from idle in ProbeBW states, BBR leaves its cwnd as-",
            "   is and paces packets at exactly BBR.bw, aiming to return as quickly",
            "   as possible to its target operating point of rate balance and a full",
            "   pipe.  Specifically, if the flow's BBR.state is ProbeBW, and the flow",
            "   is application-limited, and there are no packets in flight currently,",
            "   then at the moment the flow sends one or more packets BBR sets",
            "   BBR.pacing_rate to exactly BBR.bw.  More precisely, the BBR algorithm",
            "   takes the following steps in BBRHandleRestartFromIdle() before",
            "   sending a packet for a flow.",
            "",
            "   The \"Restarting Idle Connections\" section of [RFC5681] suggests",
            "   restarting from idle by slow-starting from the initial window.",
            "   However, this approach was assuming a congestion control algorithm",
            "   that had no estimate of the bottleneck bandwidth and no pacing, and",
            "   thus resorted to relying on slow-starting driven by an ACK clock.",
            "   The long (log_2(BDP)*RTT) delays required to reach full utilization",
            "   with that \"slow start after idle\" approach caused many large",
            "",
            "   deployments to disable this mechanism, resulting in a \"BDP-scale",
            "   line-rate burst\" approach instead.  Instead of these two approaches,",
            "   BBR restarts by pacing at BBR.bw, typically achieving approximate",
            "   rate balance and a full pipe after only one BBR.min_rtt has elapsed."
          ],
          "title": "Setting Pacing Rate in ProbeBW"
        },
        {
          "id": "section-4.4.2",
          "lines": [
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "9ca02b44c2654dc5"
                ],
                "status_id": 5,
                "text": "As an optimization, when restarting from idle BBR checks to see if"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "9ca02b44c2654dc5"
                ],
                "status_id": 5,
                "text": "the connection is in ProbeRTT and has met the exit conditions for"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "9ca02b44c2654dc5"
                ],
                "status_id": 5,
                "text": "ProbeRTT.  If a connection goes idle during ProbeRTT then often it"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "9ca02b44c2654dc5"
                ],
                "status_id": 5,
                "text": "will have met those exit conditions by the time it restarts, so that"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "9ca02b44c2654dc5"
                ],
                "status_id": 5,
                "text": "the connection can restore the cwnd to its full value before it"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "9ca02b44c2654dc5"
                ],
                "status_id": 5,
                "text": "starts transmitting a new flight of data."
              }
            ]
          ],
          "title": "Checking for ProberRTT Completion"
        },
        {
          "id": "section-4.4.3",
          "lines": [
            "   The BBR algorithm takes the following steps in",
            "   BBRHandleRestartFromIdle() before sending a packet for a flow:",
            "",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "     "
              },
              {
                "annotation_ids": [
                  "d1eebb4ec069936a",
                  "fbd27f5abe2d74e9"
                ],
                "status_id": 2,
                "text": "BBRHandleRestartFromIdle():"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "       "
              },
              {
                "annotation_ids": [
                  "d1eebb4ec069936a",
                  "fbd27f5abe2d74e9"
                ],
                "status_id": 2,
                "text": "if (packets_in_flight == 0 and C.app_limited)"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "         "
              },
              {
                "annotation_ids": [
                  "d1eebb4ec069936a",
                  "fbd27f5abe2d74e9"
                ],
                "status_id": 2,
                "text": "BBR.idle_restart = true"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "            "
              },
              {
                "annotation_ids": [
                  "d1eebb4ec069936a",
                  "fbd27f5abe2d74e9"
                ],
                "status_id": 2,
                "text": "BBR.extra_acked_interval_start = Now()"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "         "
              },
              {
                "annotation_ids": [
                  "d1eebb4ec069936a",
                  "fbd27f5abe2d74e9"
                ],
                "status_id": 2,
                "text": "if (IsInAProbeBWState())"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "           "
              },
              {
                "annotation_ids": [
                  "d1eebb4ec069936a",
                  "fbd27f5abe2d74e9"
                ],
                "status_id": 2,
                "text": "BBRSetPacingRateWithGain(1)"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "         "
              },
              {
                "annotation_ids": [
                  "b2b11c1dbf63481b"
                ],
                "status_id": 5,
                "text": "else if (BBR.state == ProbeRTT)"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "           "
              },
              {
                "annotation_ids": [
                  "b2b11c1dbf63481b"
                ],
                "status_id": 5,
                "text": "BBRCheckProbeRTTDone()"
              }
            ]
          ],
          "title": "Logic"
        },
        {
          "id": "section-4.5",
          "lines": [
            "   BBR is a model-based congestion control algorithm: it is based on an",
            "   explicit model of the network path over which a transport flow",
            "   travels.  The following is a summary of each parameter, including its",
            "   meaning and how the algorithm calculates and uses its value.  We can",
            "   group the parameter into three groups:",
            "",
            "   *  core state machine parameters",
            "",
            "   *  parameters to model the data rate",
            "",
            "   *  parameters to model the volume of in-flight data"
          ],
          "title": "Updating Network Path Model Parameters"
        },
        {
          "id": "section-4.5.1",
          "lines": [
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "5a7e5ee75cfc782c"
                ],
                "status_id": 1,
                "text": "Several aspects of the BBR algorithm depend on counting the progress"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "5a7e5ee75cfc782c"
                ],
                "status_id": 1,
                "text": "of \"packet-timed\" round trips, which start at the transmission of"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "5a7e5ee75cfc782c"
                ],
                "status_id": 1,
                "text": "some segment, and then end at the acknowledgement of that segment."
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "5a7e5ee75cfc782c"
                ],
                "status_id": 1,
                "text": "BBR.round_count is a count of the number of these \"packet-timed\""
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "5a7e5ee75cfc782c"
                ],
                "status_id": 1,
                "text": "round trips elapsed so far."
              },
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "  BBR uses this virtual BBR.round_count"
              }
            ],
            "   because it is more robust than using wall clock time.  In particular,",
            "   arbitrary intervals of wall clock time can elapse due to application",
            "   idleness, variations in RTTs, or timer delays for retransmission",
            "   timeouts, causing wall-clock-timed model parameter estimates to \"time",
            "   out\" or to be \"forgotten\" too quickly to provide robustness.",
            "",
            "   BBR counts packet-timed round trips by recording state about a",
            "   sentinel packet, and waiting for an ACK of any data packet that was",
            "   sent after that sentinel packet, using the following pseudocode:",
            "",
            "   Upon connection initialization:",
            "",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "     "
              },
              {
                "annotation_ids": [
                  "19c870da5f666a42"
                ],
                "status_id": 1,
                "text": "BBRInitRoundCounting():"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "       "
              },
              {
                "annotation_ids": [
                  "19c870da5f666a42"
                ],
                "status_id": 1,
                "text": "BBR.next_round_delivered = 0"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "       "
              },
              {
                "annotation_ids": [
                  "19c870da5f666a42"
                ],
                "status_id": 1,
                "text": "BBR.round_start = false"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "       "
              },
              {
                "annotation_ids": [
                  "19c870da5f666a42"
                ],
                "status_id": 1,
                "text": "BBR.round_count = 0"
              }
            ],
            "",
            "   Upon sending each packet, the rate estimation algorithm [draft-cheng-",
            "   iccrg-delivery-rate-estimation] records the amount of data thus far",
            "   acknowledged as delivered:",
            "",
            "     packet.delivered = C.delivered",
            "",
            "   Upon receiving an ACK for a given data packet, the rate estimation",
            "   algorithm [draft-cheng-iccrg-delivery-rate-estimation] updates the",
            "   amount of data thus far acknowledged as delivered:",
            "",
            "       C.delivered += packet.size",
            "",
            "   Upon receiving an ACK for a given data packet, the BBR algorithm",
            "   first executes the following logic to see if a round trip has",
            "   elapsed, and if so, increment the count of such round trips elapsed:",
            "",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "     "
              },
              {
                "annotation_ids": [
                  "957f03639e024ab9"
                ],
                "status_id": 1,
                "text": "BBRUpdateRound():"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "       "
              },
              {
                "annotation_ids": [
                  "957f03639e024ab9"
                ],
                "status_id": 1,
                "text": "if (packet.delivered >= BBR.next_round_delivered)"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "         "
              },
              {
                "annotation_ids": [
                  "957f03639e024ab9"
                ],
                "status_id": 1,
                "text": "BBRStartRound()"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "         "
              },
              {
                "annotation_ids": [
                  "957f03639e024ab9"
                ],
                "status_id": 1,
                "text": "BBR.round_count++"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "         "
              },
              {
                "annotation_ids": [
                  "957f03639e024ab9"
                ],
                "status_id": 1,
                "text": "BBR.rounds_since_probe++"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "         "
              },
              {
                "annotation_ids": [
                  "957f03639e024ab9"
                ],
                "status_id": 1,
                "text": "BBR.round_start = true"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "       "
              },
              {
                "annotation_ids": [
                  "957f03639e024ab9"
                ],
                "status_id": 1,
                "text": "else"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "         "
              },
              {
                "annotation_ids": [
                  "957f03639e024ab9"
                ],
                "status_id": 1,
                "text": "BBR.round_start = false"
              }
            ],
            "",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "     "
              },
              {
                "annotation_ids": [
                  "05f101b720b4c773"
                ],
                "status_id": 1,
                "text": "BBRStartRound():"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "       "
              },
              {
                "annotation_ids": [
                  "05f101b720b4c773"
                ],
                "status_id": 1,
                "text": "BBR.next_round_delivered = C.delivered"
              }
            ]
          ],
          "title": "BBR.round_count: Tracking Packet-Timed Round Trips"
        },
        {
          "id": "section-4.5.2",
          "lines": [
            "   BBR.max_bw is BBR's estimate of the maximum bottleneck bandwidth",
            "   available to data transmissions for the transport flow.  At any time,",
            "   a transport connection's data transmissions experience some slowest",
            "   link or bottleneck.  The bottleneck's delivery rate determines the",
            "   connection's maximum data-delivery rate.  BBR tries to closely match",
            "   its sending rate to this bottleneck delivery rate to help seek \"rate",
            "   balance\", where the flow's packet arrival rate at the bottleneck",
            "   equals the departure rate.  The bottleneck rate varies over the life",
            "   of a connection, so BBR continually estimates BBR.max_bw using recent",
            "   signals."
          ],
          "title": "BBR.max_bw: Estimated Maximum Bandwidth"
        },
        {
          "id": "section-4.5.2.1",
          "lines": [
            "   Since calculating delivery rate samples is subtle, and the samples",
            "   are useful independent of congestion control, the approach BBR uses",
            "   for measuring each single delivery rate sample is specified in a",
            "   separate Internet Draft [draft-cheng-iccrg-delivery-rate-estimation]."
          ],
          "title": "Delivery Rate Samples for Estimating BBR.max_bw"
        },
        {
          "id": "section-4.5.2.2",
          "lines": [
            "   Delivery rate samples are often below the typical bottleneck",
            "   bandwidth available to the flow, due to \"noise\" introduced by random",
            "   variation in physical transmission processes (e.g. radio link layer",
            "   noise) or queues or along the network path.  To filter these effects",
            "   BBR uses a max filter: BBR estimates BBR.max_bw using the windowed",
            "   maximum recent delivery rate sample seen by the connection over",
            "   recent history.",
            "",
            "   The BBR.max_bw max filter window covers a time period extending over",
            "   the past two ProbeBW cycles.  The BBR.max_bw max filter window length",
            "   is driven by trade-offs among several considerations:",
            "",
            "   *  It is long enough to cover at least one entire ProbeBW cycle (see",
            "      the \"ProbeBW\" section).  This ensures that the window contains at",
            "      least some delivery rate samples that are the result of data",
            "      transmitted with a super-unity pacing_gain (a pacing_gain larger",
            "      than 1.0).  Such super-unity delivery rate samples are",
            "      instrumental in revealing the path's underlying available",
            "      bandwidth even when there is noise from delivery rate shortfalls",
            "      due to aggregation delays, queuing delays from variable cross-",
            "      traffic, lossy link layers with uncorrected losses, or short-term",
            "      buffer exhaustion (e.g., brief coincident bursts in a shallow",
            "      buffer).",
            "",
            "   *  It aims to be long enough to cover short-term fluctuations in the",
            "      network's delivery rate due to the aforementioned sources of",
            "      noise.  In particular, the delivery rate for radio link layers",
            "      (e.g., wifi and cellular technologies) can be highly variable, and",
            "      the filter window needs to be long enough to remember \"good\"",
            "      delivery rate samples in order to be robust to such variations.",
            "",
            "   *  It aims to be short enough to respond in a timely manner to",
            "      sustained reductions in the bandwidth available to a flow, whether",
            "      this is because other flows are using a larger share of the",
            "      bottleneck, or the bottleneck link service rate has reduced due to",
            "      layer 1 or layer 2 changes, policy changes, or routing changes.",
            "      In any of these cases, existing BBR flows traversing the",
            "      bottleneck should, in a timely manner, reduce their BBR.max_bw",
            "      estimates and thus pacing rate and in-flight data, in order to",
            "      match the sending behavior to the new available bandwidth."
          ],
          "title": "BBR.max_bw Max Filter"
        },
        {
          "id": "section-4.5.2.3",
          "lines": [
            "   Transmissions can be application-limited, meaning the transmission",
            "   rate is limited by the application rather than the congestion control",
            "   algorithm.  This is quite common because of request/response traffic.",
            "   When there is a transmission opportunity but no data to send, the",
            "   delivery rate sampler marks the corresponding bandwidth sample(s) as",
            "   application-limited [draft-cheng-iccrg-delivery-rate-estimation].",
            "   The BBR.max_bw estimator carefully decides which samples to include",
            "   in the bandwidth model to ensure that BBR.max_bw reflects network",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   limits, not application limits.  "
              },
              {
                "annotation_ids": [
                  "1e93a4dcd9e38041"
                ],
                "status_id": 1,
                "text": "By default, the estimator discards"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "1e93a4dcd9e38041"
                ],
                "status_id": 1,
                "text": "application-limited samples, since by definition they reflect"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "1e93a4dcd9e38041"
                ],
                "status_id": 1,
                "text": "application limits.  However, the estimator does use application-"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "1e93a4dcd9e38041"
                ],
                "status_id": 1,
                "text": "limited samples if the measured delivery rate happens to be larger"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "1e93a4dcd9e38041"
                ],
                "status_id": 1,
                "text": "than the current BBR.max_bw estimate, since this indicates the"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "1e93a4dcd9e38041"
                ],
                "status_id": 1,
                "text": "current BBR.Max_bw estimate is too low."
              }
            ]
          ],
          "title": "BBR.max_bw and Application-limited Delivery Rate Samples"
        },
        {
          "id": "section-4.5.2.4",
          "lines": [
            "   For every ACK that acknowledges some data packets as delivered, BBR",
            "   invokes BBRUpdateMaxBw() to update the BBR.max_bw estimator as",
            "   follows (here rs.delivery_rate is the delivery rate sample obtained",
            "   from the ACK that is being processed, as specified in [draft-cheng-",
            "   iccrg-delivery-rate-estimation]):",
            "",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "     "
              },
              {
                "annotation_ids": [
                  "202377d1d4ae62d1"
                ],
                "status_id": 1,
                "text": "BBRUpdateMaxBw()"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "       "
              },
              {
                "annotation_ids": [
                  "202377d1d4ae62d1"
                ],
                "status_id": 1,
                "text": "BBRUpdateRound()"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "       "
              },
              {
                "annotation_ids": [
                  "202377d1d4ae62d1"
                ],
                "status_id": 1,
                "text": "if (rs.delivery_rate >= BBR.max_bw || !rs.is_app_limited)"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "           "
              },
              {
                "annotation_ids": [
                  "202377d1d4ae62d1"
                ],
                "status_id": 1,
                "text": "BBR.max_bw = update_windowed_max_filter("
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "                         "
              },
              {
                "annotation_ids": [
                  "202377d1d4ae62d1"
                ],
                "status_id": 1,
                "text": "filter=BBR.MaxBwFilter,"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "                         "
              },
              {
                "annotation_ids": [
                  "202377d1d4ae62d1"
                ],
                "status_id": 1,
                "text": "value=rs.delivery_rate,"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "                         "
              },
              {
                "annotation_ids": [
                  "202377d1d4ae62d1"
                ],
                "status_id": 1,
                "text": "time=BBR.cycle_count,"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "                         "
              },
              {
                "annotation_ids": [
                  "202377d1d4ae62d1"
                ],
                "status_id": 1,
                "text": "window_length=MaxBwFilterLen)"
              }
            ]
          ],
          "title": "Updating the BBR.max_bw Max Filter"
        },
        {
          "id": "section-4.5.2.5",
          "lines": [
            "   BBR tracks time for the BBR.max_bw filter window using a virtual",
            "   (non-wall-clock) time tracked by counting the cyclical progression",
            "   through ProbeBW cycles.  Each time through the Probe bw cycle, one",
            "   round trip after exiting ProbeBW_UP (the point at which the flow has",
            "   its best chance to measure the highest throughput of the cycle), BBR",
            "   increments BBR.cycle_count, the virtual time used by the BBR.max_bw",
            "   filter window.  Note that BBR.cycle_count only needs to be tracked",
            "   with a single bit, since the BBR.max_bw filter only needs to track",
            "   samples from two time slots: the previous ProbeBW cycle and the",
            "   current ProbeBW cycle:",
            "",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "     "
              },
              {
                "annotation_ids": [
                  "2be49dccf1219390"
                ],
                "status_id": 1,
                "text": "BBRAdvanceMaxBwFilter():"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "       "
              },
              {
                "annotation_ids": [
                  "2be49dccf1219390"
                ],
                "status_id": 1,
                "text": "BBR.cycle_count++"
              }
            ]
          ],
          "title": "Tracking Time for the BBR.max_bw Max Filter"
        },
        {
          "id": "section-4.5.3",
          "lines": [
            "   BBR.min_rtt is BBR's estimate of the round-trip propagation delay of",
            "   the path over which a transport connection is sending.  The path's",
            "   round-trip propagation delay determines the minimum amount of time",
            "   over which the connection must be willing to sustain transmissions at",
            "   the BBR.bw rate, and thus the minimum amount of data needed in-",
            "   flight, for the connection to reach full utilization (a \"Full Pipe\").",
            "   The round-trip propagation delay can vary over the life of a",
            "   connection, so BBR continually estimates BBR.min_rtt using recent",
            "   round-trip delay samples."
          ],
          "title": "BBR.min_rtt: Estimated Minimum Round-Trip Time"
        },
        {
          "id": "section-4.5.3.1",
          "lines": [
            "   For every data packet a connection sends, BBR calculates an RTT",
            "   sample that measures the time interval from sending a data packet",
            "   until that packet is acknowledged.",
            "",
            "   For the most part, the same considerations and mechanisms that apply",
            "   to RTT estimation for the purposes of retransmission timeout",
            "   calculations [RFC6298] apply to BBR RTT samples.  Namely, BBR does",
            "   not use RTT samples based on the transmission time of retransmitted",
            "   packets, since these are ambiguous, and thus unreliable.  Also, BBR",
            "   calculates RTT samples using both cumulative and selective",
            "   acknowledgments (if the transport supports [RFC2018] SACK options or",
            "   an equivalent mechanism), or transport-layer timestamps (if the",
            "   transport supports [RFC7323] TCP timestamps or an equivalent",
            "   mechanism).",
            "",
            "   The only divergence from RTT estimation for retransmission timeouts",
            "   is in the case where a given acknowledgment ACKs more than one data",
            "   packet.  In order to be conservative and schedule long timeouts to",
            "   avoid spurious retransmissions, the maximum among such potential RTT",
            "   samples is typically used for computing retransmission timeouts;",
            "   i.e., SRTT is typically calculated using the data packet with the",
            "   earliest transmission time.  By contrast, in order for BBR to try to",
            "   reach the minimum amount of data in flight to fill the pipe, BBR uses",
            "   the minimum among such potential RTT samples; i.e., BBR calculates",
            "   the RTT using the data packet with the latest transmission time."
          ],
          "title": "Round-Trip Time Samples for Estimating BBR.min_rtt"
        },
        {
          "id": "section-4.5.3.2",
          "lines": [
            "   RTT samples tend to be above the round-trip propagation delay of the",
            "   path, due to \"noise\" introduced by random variation in physical",
            "   transmission processes (e.g. radio link layer noise), queues along",
            "   the network path, the receiver's delayed ack strategy, ack",
            "   aggregation, etc.  Thus to filter out these effects BBR uses a min",
            "   filter: BBR estimates BBR.min_rtt using the minimum recent RTT sample",
            "   seen by the connection over that past MinRTTFilterLen seconds.  (Many",
            "   of the same network effects that can decrease delivery rate",
            "   measurements can increase RTT samples, which is why BBR's min-",
            "   filtering approach for RTTs is the complement of its max-filtering",
            "   approach for delivery rates.)",
            "",
            "   The length of the BBR.min_rtt min filter window is MinRTTFilterLen =",
            "   10 secs.  This is driven by trade-offs among several considerations:",
            "",
            "   *  The MinRTTFilterLen is longer than ProbeRTTInterval, so that it",
            "      covers an entire ProbeRTT cycle (see the \"ProbeRTT\" section",
            "      below).  This helps ensure that the window can contain RTT samples",
            "",
            "      that are the result of data transmitted with inflight below the",
            "      estimated BDP of the flow.  Such RTT samples are important for",
            "      helping to reveal the path's underlying two-way propagation delay",
            "      even when the aforementioned \"noise\" effects can often obscure it.",
            "",
            "   *  The MinRTTFilterLen aims to be long enough to avoid needing to cut",
            "      in-flight and throughput often.  Measuring two-way propagation",
            "      delay requires in-flight to be at or below BDP, which risks some",
            "      amount of underutilization, so BBR uses a filter window long",
            "      enough that such underutilization events can be rare.",
            "",
            "   *  The MinRTTFilterLen aims to be long enough that many applications",
            "      have a \"natural\" moment of silence or low utilization that can cut",
            "      in-flight below BDP and naturally serve to refresh the",
            "      BBR.min_rtt, without requiring BBR to force an artificial cut in",
            "      in-flight.  This applies to many popular applications, including",
            "      Web, RPC, chunked audio or video traffic.",
            "",
            "   *  The MinRTTFilterLen aims to be short enough to respond in a timely",
            "      manner to real increases in the two-way propagation delay of the",
            "      path, e.g. due to route changes, which are expected to typically",
            "      happen on longer time scales.",
            "",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "8d815ca5ab4ec233"
                ],
                "status_id": 1,
                "text": "A BBR implementation MAY use a generic windowed min filter to track"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "8d815ca5ab4ec233"
                ],
                "status_id": 1,
                "text": "BBR.min_rtt.  However, a significant savings in space and improvement"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "8d815ca5ab4ec233"
                ],
                "status_id": 1,
                "text": "in freshness can be achieved by integrating the BBR.min_rtt"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "8d815ca5ab4ec233"
                ],
                "status_id": 1,
                "text": "estimation into the ProbeRTT state machine"
              },
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": ", so this document"
              }
            ],
            "   discusses that approach in the ProbeRTT section."
          ],
          "title": "BBR.min_rtt Min Filter"
        },
        {
          "id": "section-4.5.4",
          "lines": [
            "   BBR.offload_budget is the estimate of the minimum volume of data",
            "   necessary to achieve full throughput using sender (TSO/GSO) and",
            "   receiver (LRO, GRO) host offload mechanisms, computed as follows:",
            "",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "       "
              },
              {
                "annotation_ids": [
                  "1e60327cc3e6c115"
                ],
                "status_id": 1,
                "text": "BBRUpdateOffloadBudget():"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "         "
              },
              {
                "annotation_ids": [
                  "1e60327cc3e6c115"
                ],
                "status_id": 1,
                "text": "BBR.offload_budget = 3 * BBR.send_quantum"
              }
            ],
            "",
            "   The factor of 3 is chosen to allow maintaining at least:",
            "",
            "   *  1 quantum in the sending host's queuing discipline layer",
            "",
            "   *  1 quantum being segmented in the sending host TSO/GSO engine",
            "",
            "   *  1 quantum being reassembled or otherwise remaining unacknowledged",
            "      due to the receiver host's LRO/GRO/delayed-ACK engine"
          ],
          "title": "BBR.offload_budget"
        },
        {
          "id": "section-4.5.5",
          "lines": [
            "   BBR.extra_acked is a volume of data that is the estimate of the",
            "   recent degree of aggregation in the network path.  For each ACK, the",
            "   algorithm computes a sample of the estimated extra ACKed data beyond",
            "   the amount of data that the sender expected to be ACKed over the",
            "   timescale of a round-trip, given the BBR.bw.  Then it computes",
            "   BBR.extra_acked as the windowed maximum sample over the last",
            "   BBRExtraAckedFilterLen=10 packet-timed round-trips.  If the ACK rate",
            "   falls below the expected bandwidth, then the algorithm estimates an",
            "   aggregation episode has terminated, and resets the sampling interval",
            "   to start from the current time.",
            "",
            "   The BBR.extra_acked thus reflects the recently-measured magnitude of",
            "   data and ACK aggregation effects such as batching and slotting at",
            "   shared-medium L2 hops (wifi, cellular, DOCSIS), as well as end-host",
            "   offload mechanisms (TSO, GSO, LRO, GRO), and end host or middlebox",
            "   ACK decimation/thinning.",
            "",
            "   BBR augments its cwnd by BBR.extra_acked to allow the connection to",
            "   keep sending during inter-ACK silences, to an extent that matches the",
            "   recently measured degree of aggregation.",
            "",
            "   More precisely, this is computed as:",
            "",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "     "
              },
              {
                "annotation_ids": [
                  "71dc3c6ed7d6bf5e"
                ],
                "status_id": 1,
                "text": "BBRUpdateACKAggregation():"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "       "
              },
              {
                "annotation_ids": [
                  "71dc3c6ed7d6bf5e"
                ],
                "status_id": 1,
                "text": "/* Find excess ACKed beyond expected amount over this interval */"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "       "
              },
              {
                "annotation_ids": [
                  "71dc3c6ed7d6bf5e"
                ],
                "status_id": 1,
                "text": "interval = (Now() - BBR.extra_acked_interval_start)"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "       "
              },
              {
                "annotation_ids": [
                  "71dc3c6ed7d6bf5e"
                ],
                "status_id": 1,
                "text": "expected_delivered = BBR.bw * interval"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "       "
              },
              {
                "annotation_ids": [
                  "71dc3c6ed7d6bf5e"
                ],
                "status_id": 1,
                "text": "/* Reset interval if ACK rate is below expected rate: */"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "       "
              },
              {
                "annotation_ids": [
                  "71dc3c6ed7d6bf5e"
                ],
                "status_id": 1,
                "text": "if (BBR.extra_acked_delivered <= expected_delivered)"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "           "
              },
              {
                "annotation_ids": [
                  "71dc3c6ed7d6bf5e"
                ],
                "status_id": 1,
                "text": "BBR.extra_acked_delivered = 0"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "           "
              },
              {
                "annotation_ids": [
                  "71dc3c6ed7d6bf5e"
                ],
                "status_id": 1,
                "text": "BBR.extra_acked_interval_start = Now()"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "           "
              },
              {
                "annotation_ids": [
                  "71dc3c6ed7d6bf5e"
                ],
                "status_id": 1,
                "text": "expected_delivered = 0"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "       "
              },
              {
                "annotation_ids": [
                  "71dc3c6ed7d6bf5e"
                ],
                "status_id": 1,
                "text": "BBR.extra_acked_delivered += rs.newly_acked"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "       "
              },
              {
                "annotation_ids": [
                  "71dc3c6ed7d6bf5e"
                ],
                "status_id": 1,
                "text": "extra = BBR.extra_acked_delivered - expected_delivered"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "       "
              },
              {
                "annotation_ids": [
                  "71dc3c6ed7d6bf5e"
                ],
                "status_id": 1,
                "text": "extra = min(extra, cwnd)"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "       "
              },
              {
                "annotation_ids": [
                  "71dc3c6ed7d6bf5e"
                ],
                "status_id": 1,
                "text": "BBR.extra_acked ="
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "         "
              },
              {
                "annotation_ids": [
                  "71dc3c6ed7d6bf5e"
                ],
                "status_id": 1,
                "text": "update_windowed_max_filter("
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "           "
              },
              {
                "annotation_ids": [
                  "71dc3c6ed7d6bf5e"
                ],
                "status_id": 1,
                "text": "filter=BBR.ExtraACKedFilter,"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "           "
              },
              {
                "annotation_ids": [
                  "71dc3c6ed7d6bf5e"
                ],
                "status_id": 1,
                "text": "value=extra,"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "           "
              },
              {
                "annotation_ids": [
                  "71dc3c6ed7d6bf5e"
                ],
                "status_id": 1,
                "text": "time=BBR.round_count,"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "           "
              },
              {
                "annotation_ids": [
                  "71dc3c6ed7d6bf5e"
                ],
                "status_id": 1,
                "text": "window_length=BBRExtraAckedFilterLen)"
              }
            ]
          ],
          "title": "BBR.extra_acked"
        },
        {
          "id": "section-4.5.6",
          "lines": [
            "   In every state, BBR responds to (filtered) congestion signals,",
            "   including loss.  The response to those congestion signals depends on",
            "   the flow's current state, since the information that the flow can",
            "   infer depends on what the flow was doing when the flow experienced",
            "   the signal."
          ],
          "title": "Updating the Model Upon Packet Loss"
        },
        {
          "id": "section-4.5.6.1",
          "lines": [
            "   In Startup, if the congestion signals meet the Startup exit criteria,",
            "   the flow exits Startup and enters Drain."
          ],
          "title": "Probing for Bandwidth In Startup"
        },
        {
          "id": "section-4.5.6.2",
          "lines": [
            "   BBR searches for the maximum volume of data that can be sensibly",
            "   placed in-flight in the network.  A key precondition is that the flow",
            "   is actually trying robustly to find that operating point.  To",
            "   implement this, when a flow is in ProbeBW, and an ACK covers data",
            "   sent in one of the accelerating phases (REFILL or UP), and the ACK",
            "   indicates that the loss rate over the past round trip exceeds the",
            "   queue pressure objective, and the flow is not application limited,",
            "   and has not yet responded to congestion signals from the most recent",
            "   REFILL or UP phase, then the flow estimates that the volume of data",
            "   it allowed in flight exceeded what matches the current delivery",
            "   process on the path, and reduces BBR.inflight_hi:",
            "",
            "     /* Do loss signals suggest inflight is too high?",
            "      * If so, react. */",
            "     CheckInflightTooHigh():",
            "       if (IsInflightTooHigh(rs))",
            "         if (BBR.bw_probe_samples)",
            "           BBRHandleInflightTooHigh()",
            "         return true  /* inflight too high */",
            "       else",
            "         return false /* inflight not too high */",
            "",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "     "
              },
              {
                "annotation_ids": [
                  "eea990051727d015"
                ],
                "status_id": 1,
                "text": "IsInflightTooHigh():"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "       "
              },
              {
                "annotation_ids": [
                  "eea990051727d015"
                ],
                "status_id": 1,
                "text": "return (rs.lost > rs.tx_in_flight * BBRLossThresh)"
              }
            ],
            "",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "     "
              },
              {
                "annotation_ids": [
                  "cfc7dce06b9df2f3"
                ],
                "status_id": 1,
                "text": "BBRHandleInflightTooHigh():"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "       "
              },
              {
                "annotation_ids": [
                  "cfc7dce06b9df2f3"
                ],
                "status_id": 1,
                "text": "BBR.bw_probe_samples = 0;  /* only react once per bw probe */"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "       "
              },
              {
                "annotation_ids": [
                  "cfc7dce06b9df2f3"
                ],
                "status_id": 1,
                "text": "if (!rs.is_app_limited)"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "         "
              },
              {
                "annotation_ids": [
                  "cfc7dce06b9df2f3"
                ],
                "status_id": 1,
                "text": "BBR.inflight_hi = max(rs.tx_in_flight,"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "                               "
              },
              {
                "annotation_ids": [
                  "cfc7dce06b9df2f3"
                ],
                "status_id": 1,
                "text": "BBRTargetInflight() * BBRBeta))"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "       "
              },
              {
                "annotation_ids": [
                  "cfc7dce06b9df2f3"
                ],
                "status_id": 1,
                "text": "If (BBR.state == ProbeBW_UP)"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "         "
              },
              {
                "annotation_ids": [
                  "cfc7dce06b9df2f3"
                ],
                "status_id": 1,
                "text": "BBRStartProbeBW_DOWN()"
              }
            ],
            "",
            "   Here rs.tx_in_flight is the amount of data that was estimated to be",
            "   in flight when the most recently ACKed packet was sent.  And the",
            "   BBRBeta (0.7x) bound is to try to ensure that BBR does not react more",
            "   dramatically than CUBIC's 0.7x multiplicative decrease factor.",
            "",
            "   Some loss detection algorithms, including algorithms like RACK",
            "   [RFC8985] that delay loss marking while waiting for potential",
            "   reordering to resolve, may mark packets as lost long after the loss",
            "   itself happened.  In such cases, the tx_in_flight for the delivered",
            "   sequence range that allowed the loss to be detected may be",
            "   considerably smaller than the tx_in_flight of the lost packet itself.",
            "   In such cases using the former tx_in_flight rather than the latter",
            "   can cause BBR.inflight_hi to be significantly underestimated.  To",
            "   avoid such issues, BBR processes each loss detection event to more",
            "   precisely estimate the volume of in-flight data at which loss rates",
            "   cross BBRLossThresh, noting that this may have happened mid-way",
            "   through some packet.  To estimate this value, we can solve for",
            "   \"lost_prefix\" in the following equation, where inflight_prev",
            "   represents the volume of in-flight data preceding this packet,",
            "   lost_prev represents the data lost among that previous in-flight",
            "   data:",
            "",
            "    lost                     /  inflight                     >= BBRLossThresh",
            "   (lost_prev + lost_prefix) / (inflight_prev + lost_prefix) >= BBRLossThresh",
            "   /* solving for lost_prefix we arrive at: */",
            "   lost_prefix = (BBRLossThresh * inflight_prev - lost_prev) / (1 - BBRLossThresh)",
            "",
            "   In pseudocode:",
            "",
            "     BBRHandleLostPacket(packet):",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "       "
              },
              {
                "annotation_ids": [
                  "3e305cb80eca0ee4",
                  "bda5e0ad36282565"
                ],
                "status_id": 2,
                "text": "if (!BBR.bw_probe_samples)"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "         "
              },
              {
                "annotation_ids": [
                  "3e305cb80eca0ee4",
                  "bda5e0ad36282565"
                ],
                "status_id": 2,
                "text": "return /* not a packet sent while probing bandwidth */"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "       "
              },
              {
                "annotation_ids": [
                  "3e305cb80eca0ee4",
                  "bda5e0ad36282565"
                ],
                "status_id": 2,
                "text": "rs.tx_in_flight = packet.tx_in_flight /* inflight at transmit */"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "       "
              },
              {
                "annotation_ids": [
                  "3e305cb80eca0ee4",
                  "bda5e0ad36282565"
                ],
                "status_id": 2,
                "text": "rs.lost = C.lost - packet.lost /* data lost since transmit */"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "       "
              },
              {
                "annotation_ids": [
                  "3e305cb80eca0ee4",
                  "bda5e0ad36282565"
                ],
                "status_id": 2,
                "text": "rs.is_app_limited = packet.is_app_limited;"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "       "
              },
              {
                "annotation_ids": [
                  "3e305cb80eca0ee4",
                  "bda5e0ad36282565"
                ],
                "status_id": 2,
                "text": "if (IsInflightTooHigh(rs))"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "         "
              },
              {
                "annotation_ids": [
                  "3e305cb80eca0ee4",
                  "bda5e0ad36282565"
                ],
                "status_id": 2,
                "text": "rs.tx_in_flight = BBRInflightHiFromLostPacket(rs, packet)"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "         "
              },
              {
                "annotation_ids": [
                  "3e305cb80eca0ee4",
                  "bda5e0ad36282565"
                ],
                "status_id": 2,
                "text": "BBRHandleInflightTooHigh(rs)"
              }
            ],
            "",
            "     /* At what prefix of packet did losses exceed BBRLossThresh? */",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "     "
              },
              {
                "annotation_ids": [
                  "0284d6c8aeccd081",
                  "531dd18c029c90cf"
                ],
                "status_id": 2,
                "text": "BBRInflightHiFromLostPacket(rs, packet):"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "       "
              },
              {
                "annotation_ids": [
                  "0284d6c8aeccd081",
                  "531dd18c029c90cf"
                ],
                "status_id": 2,
                "text": "size = packet.size"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "       "
              },
              {
                "annotation_ids": [
                  "0284d6c8aeccd081",
                  "531dd18c029c90cf"
                ],
                "status_id": 2,
                "text": "/* What was in flight before this packet? */"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "       "
              },
              {
                "annotation_ids": [
                  "0284d6c8aeccd081",
                  "531dd18c029c90cf"
                ],
                "status_id": 2,
                "text": "inflight_prev = rs.tx_in_flight - size"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "       "
              },
              {
                "annotation_ids": [
                  "0284d6c8aeccd081",
                  "531dd18c029c90cf"
                ],
                "status_id": 2,
                "text": "/* What was lost before this packet? */"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "       "
              },
              {
                "annotation_ids": [
                  "0284d6c8aeccd081",
                  "531dd18c029c90cf"
                ],
                "status_id": 2,
                "text": "lost_prev = rs.lost - size"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "       "
              },
              {
                "annotation_ids": [
                  "0284d6c8aeccd081",
                  "531dd18c029c90cf"
                ],
                "status_id": 2,
                "text": "lost_prefix = (BBRLossThresh * inflight_prev - lost_prev) /"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "                     "
              },
              {
                "annotation_ids": [
                  "0284d6c8aeccd081",
                  "531dd18c029c90cf"
                ],
                "status_id": 2,
                "text": "(1 - BBRLossThresh)"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "       "
              },
              {
                "annotation_ids": [
                  "0284d6c8aeccd081",
                  "531dd18c029c90cf"
                ],
                "status_id": 2,
                "text": "/* At what inflight value did losses cross BBRLossThresh? */"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "       "
              },
              {
                "annotation_ids": [
                  "0284d6c8aeccd081",
                  "531dd18c029c90cf"
                ],
                "status_id": 2,
                "text": "inflight = inflight_prev + lost_prefix"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "       "
              },
              {
                "annotation_ids": [
                  "0284d6c8aeccd081",
                  "531dd18c029c90cf"
                ],
                "status_id": 2,
                "text": "return inflight"
              }
            ]
          ],
          "title": "Probing for Bandwidth In ProbeBW"
        },
        {
          "id": "section-4.5.6.3",
          "lines": [
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "4548b164dc74ed27",
                  "ea89728a3aa01b1c"
                ],
                "status_id": 2,
                "text": "When not explicitly accelerating to probe for bandwidth (Drain,"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "4548b164dc74ed27",
                  "ea89728a3aa01b1c"
                ],
                "status_id": 2,
                "text": "ProbeRTT, ProbeBW_DOWN, ProbeBW_CRUISE), BBR responds to loss by"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "4548b164dc74ed27",
                  "ea89728a3aa01b1c"
                ],
                "status_id": 2,
                "text": "slowing down to some extent."
              },
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "  This is because loss suggests that the"
              }
            ],
            "   available bandwidth and safe volume of in-flight data may have",
            "   decreased recently, and the flow needs to adapt, slowing down toward",
            "   the latest delivery process.  BBR flows implement this response by",
            "   reducing the short-term model parameters, BBR.bw_lo and",
            "   BBR.inflight_lo.",
            "",
            "   When encountering packet loss when the flow is not probing for",
            "   bandwidth, the strategy is to gradually adapt to the current measured",
            "   delivery process (the rate and volume of data that is delivered",
            "   through the network path over the last round trip).  This applies",
            "   generally: whether in fast recovery, RTO recovery, TLP recovery;",
            "   whether application-limited or not.",
            "",
            "   There are two key parameters the algorithm tracks, to measure the",
            "   current delivery process:",
            "",
            "   BBR.bw_latest: a 1-round-trip max of delivered bandwidth",
            "   (rs.delivery_rate).",
            "",
            "   BBR.inflight_latest: a 1-round-trip max of delivered volume of data",
            "   (rs.delivered).",
            "",
            "   Upon the ACK at the end of each round that encountered a newly-marked",
            "   loss, the flow updates its model (bw_lo and inflight_lo) as follows:",
            "",
            "         bw_lo     = max(       bw_latest, BBRBeta *       bw_lo )",
            "   inflight_lo     = max( inflight_latest, BBRBeta * inflight_lo )",
            "",
            "   This logic can be represented as follows:",
            "",
            "     /* Near start of ACK processing: */",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "     "
              },
              {
                "annotation_ids": [
                  "e2549c73de9d5a46"
                ],
                "status_id": 1,
                "text": "BBRUpdateLatestDeliverySignals():"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "       "
              },
              {
                "annotation_ids": [
                  "e2549c73de9d5a46"
                ],
                "status_id": 1,
                "text": "BBR.loss_round_start = 0"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "       "
              },
              {
                "annotation_ids": [
                  "e2549c73de9d5a46"
                ],
                "status_id": 1,
                "text": "BBR.bw_latest       = max(BBR.bw_latest,       rs.delivery_rate)"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "       "
              },
              {
                "annotation_ids": [
                  "e2549c73de9d5a46"
                ],
                "status_id": 1,
                "text": "BBR.inflight_latest = max(BBR.inflight_latest, rs.delivered)"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "       "
              },
              {
                "annotation_ids": [
                  "e2549c73de9d5a46"
                ],
                "status_id": 1,
                "text": "if (rs.prior_delivered >= BBR.loss_round_delivered)"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "         "
              },
              {
                "annotation_ids": [
                  "e2549c73de9d5a46"
                ],
                "status_id": 1,
                "text": "BBR.loss_round_delivered = C.delivered"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "         "
              },
              {
                "annotation_ids": [
                  "e2549c73de9d5a46"
                ],
                "status_id": 1,
                "text": "BBR.loss_round_start = 1"
              }
            ],
            "",
            "     /* Near end of ACK processing: */",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "     "
              },
              {
                "annotation_ids": [
                  "c960d068907f7465"
                ],
                "status_id": 1,
                "text": "BBRAdvanceLatestDeliverySignals():"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "       "
              },
              {
                "annotation_ids": [
                  "c960d068907f7465"
                ],
                "status_id": 1,
                "text": "if (BBR.loss_round_start)"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "         "
              },
              {
                "annotation_ids": [
                  "c960d068907f7465"
                ],
                "status_id": 1,
                "text": "BBR.bw_latest       = rs.delivery_rate"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "         "
              },
              {
                "annotation_ids": [
                  "c960d068907f7465"
                ],
                "status_id": 1,
                "text": "BBR.inflight_latest = rs.delivered"
              }
            ],
            "",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "     "
              },
              {
                "annotation_ids": [
                  "d4eaa14a06b6d5fe"
                ],
                "status_id": 1,
                "text": "BBRResetCongestionSignals():"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "       "
              },
              {
                "annotation_ids": [
                  "d4eaa14a06b6d5fe"
                ],
                "status_id": 1,
                "text": "BBR.loss_in_round = 0"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "       "
              },
              {
                "annotation_ids": [
                  "d4eaa14a06b6d5fe"
                ],
                "status_id": 1,
                "text": "BBR.bw_latest = 0"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "       "
              },
              {
                "annotation_ids": [
                  "d4eaa14a06b6d5fe"
                ],
                "status_id": 1,
                "text": "BBR.inflight_latest = 0"
              }
            ],
            "",
            "     /* Update congestion state on every ACK */",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "     "
              },
              {
                "annotation_ids": [
                  "b848fa02123fd014"
                ],
                "status_id": 1,
                "text": "BBRUpdateCongestionSignals():"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "       "
              },
              {
                "annotation_ids": [
                  "b848fa02123fd014"
                ],
                "status_id": 1,
                "text": "BBRUpdateMaxBw()"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "       "
              },
              {
                "annotation_ids": [
                  "b848fa02123fd014"
                ],
                "status_id": 1,
                "text": "if (rs.losses > 0)"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "         "
              },
              {
                "annotation_ids": [
                  "b848fa02123fd014"
                ],
                "status_id": 1,
                "text": "BBR.loss_in_round = 1"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "       "
              },
              {
                "annotation_ids": [
                  "b848fa02123fd014"
                ],
                "status_id": 1,
                "text": "if (!BBR.loss_round_start)"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "         "
              },
              {
                "annotation_ids": [
                  "b848fa02123fd014"
                ],
                "status_id": 1,
                "text": "return  /* wait until end of round trip */"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "       "
              },
              {
                "annotation_ids": [
                  "b848fa02123fd014"
                ],
                "status_id": 1,
                "text": "BBRAdaptLowerBoundsFromCongestion()"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "       "
              },
              {
                "annotation_ids": [
                  "b848fa02123fd014"
                ],
                "status_id": 1,
                "text": "BBR.loss_in_round = 0"
              }
            ],
            "",
            "     /* Once per round-trip respond to congestion */",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "     "
              },
              {
                "annotation_ids": [
                  "069e7f2df8eccfe3"
                ],
                "status_id": 1,
                "text": "BBRAdaptLowerBoundsFromCongestion():"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "       "
              },
              {
                "annotation_ids": [
                  "069e7f2df8eccfe3"
                ],
                "status_id": 1,
                "text": "if (BBRIsProbingBW())"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "         "
              },
              {
                "annotation_ids": [
                  "069e7f2df8eccfe3"
                ],
                "status_id": 1,
                "text": "return"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "       "
              },
              {
                "annotation_ids": [
                  "069e7f2df8eccfe3"
                ],
                "status_id": 1,
                "text": "if (BBR.loss_in_round())"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "         "
              },
              {
                "annotation_ids": [
                  "069e7f2df8eccfe3"
                ],
                "status_id": 1,
                "text": "BBRInitLowerBounds()"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "         "
              },
              {
                "annotation_ids": [
                  "069e7f2df8eccfe3"
                ],
                "status_id": 1,
                "text": "BBRLossLowerBounds()"
              }
            ],
            "",
            "     /* Handle the first congestion episode in this cycle */",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "     "
              },
              {
                "annotation_ids": [
                  "f6e1f21a52127ec6"
                ],
                "status_id": 1,
                "text": "BBRInitLowerBounds():"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "       "
              },
              {
                "annotation_ids": [
                  "f6e1f21a52127ec6"
                ],
                "status_id": 1,
                "text": "if (BBR.bw_lo == Infinity)"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "         "
              },
              {
                "annotation_ids": [
                  "f6e1f21a52127ec6"
                ],
                "status_id": 1,
                "text": "BBR.bw_lo = BBR.max_bw"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "       "
              },
              {
                "annotation_ids": [
                  "79efb7a71763a730"
                ],
                "status_id": 1,
                "text": "if (BBR.inflight_lo == Infinity)"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "         "
              },
              {
                "annotation_ids": [
                  "79efb7a71763a730"
                ],
                "status_id": 1,
                "text": "BBR.inflight_lo = cwnd"
              }
            ],
            "",
            "     /* Adjust model once per round based on loss */",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "     "
              },
              {
                "annotation_ids": [
                  "57c48a5c2ca26f0e"
                ],
                "status_id": 1,
                "text": "BBRLossLowerBounds()"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "       "
              },
              {
                "annotation_ids": [
                  "57c48a5c2ca26f0e"
                ],
                "status_id": 1,
                "text": "BBR.bw_lo       = max(BBR.bw_latest,"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "                             "
              },
              {
                "annotation_ids": [
                  "57c48a5c2ca26f0e"
                ],
                "status_id": 1,
                "text": "BBRBeta * BBR.bw_lo)"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "       "
              },
              {
                "annotation_ids": [
                  "c4e3b25d1ad617c2"
                ],
                "status_id": 1,
                "text": "BBR.inflight_lo = max(BBR.inflight_latest,"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "                             "
              },
              {
                "annotation_ids": [
                  "c4e3b25d1ad617c2"
                ],
                "status_id": 1,
                "text": "BBRBeta * BBR.infligh_lo)"
              }
            ],
            "",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "     "
              },
              {
                "annotation_ids": [
                  "39b6ff1f4fce3776"
                ],
                "status_id": 1,
                "text": "BBRResetLowerBounds():"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "       "
              },
              {
                "annotation_ids": [
                  "39b6ff1f4fce3776"
                ],
                "status_id": 1,
                "text": "BBR.bw_lo       = Infinity"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "       "
              },
              {
                "annotation_ids": [
                  "c7e59388bde1247f"
                ],
                "status_id": 1,
                "text": "BBR.inflight_lo = Infinity"
              }
            ],
            "",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "     "
              },
              {
                "annotation_ids": [
                  "55196c62f17f87f9"
                ],
                "status_id": 1,
                "text": "BBRBoundBWForModel():"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "       "
              },
              {
                "annotation_ids": [
                  "55196c62f17f87f9"
                ],
                "status_id": 1,
                "text": "BBR.bw = min(BBR.max_bw, BBR.bw_lo, BBR.bw_hi)"
              }
            ]
          ],
          "title": "When not Probing for Bandwidth"
        },
        {
          "id": "section-4.6",
          "lines": [
            "   BBR uses three distinct but interrelated control parameters: pacing",
            "   rate, send quantum, and congestion window (cwnd)."
          ],
          "title": "Updating Control Parameters"
        },
        {
          "id": "section-4.6.1",
          "lines": [
            "   The following table summarizes how BBR modulates the control",
            "   parameters in each state.  In the table below, the semantics of the",
            "   columns are as follows:",
            "",
            "   *  State: the state in the BBR state machine, as depicted in the",
            "      \"State Transition Diagram\" section above.",
            "",
            "   *  Tactic: The tactic chosen from the \"State Machine Tactics\"",
            "      subsection above: \"accel\" refers to acceleration, \"decel\" to",
            "      deceleration, and \"cruise\" to cruising.",
            "",
            "   *  Pacing Gain: the value used for BBR.pacing_gain in the given",
            "      state.",
            "",
            "   *  Cwnd Gain: the value used for BBR.cwnd_gain in the given state.",
            "",
            "   *  Rate Cap: the rate values applied as bounds on the BBR.max_bw",
            "      value applied to compute BBR.bw.",
            "",
            "   *  Volume Cap: the volume values applied as bounds on the",
            "      BBR.max_inflight value to compute cwnd.",
            "",
            "   The control behavior can be summarized as follows.  Upon processing",
            "   each ACK, BBR uses the values in the table below to compute BBR.bw in",
            "   BBRBoundBWForModel(), and the cwnd in BBRBoundCwndForModel():",
            "",
            "+-----------------+--------+--------+------+--------+------------------+",
            "| State           | Tactic | Pacing | Cwnd | Rate   | Volume           |",
            "|                 |        | Gain   | Gain | Cap    | Cap              |",
            "+-----------------+--------+--------+------+--------+------------------+",
            "| Startup         | accel  | 2.77   | 2    |        |                  |",
            "|                 |        |        |      |        |                  |",
            "+-----------------+--------+--------+------+--------+------------------+",
            "| Drain           | decel  | 0.5    | 2    | bw_hi, | inflight_hi,     |",
            "|                 |        |        |      | bw_lo  | inflight_lo      |",
            "+-----------------+--------+--------+------+--------+------------------+",
            "| ProbeBW_DOWN    | decel  | 0.9    | 2    | bw_hi, | inflight_hi,     |",
            "|                 |        |        |      | bw_lo  | inflight_lo      |",
            "+-----------------+--------+--------+------+--------+------------------+",
            "| ProbeBW_CRUISE  | cruise | 1.0    | 2    | bw_hi, | 0.85*inflight_hi |",
            "|                 |        |        |      | bw_lo  | inflight_lo      |",
            "+-----------------+--------+--------+------+--------+------------------+",
            "| ProbeBW_REFILL  | accel  | 1.0    | 2    | bw_hi  | inflight_hi      |",
            "|                 |        |        |      |        |                  |",
            "+-----------------+--------+--------+------+--------+------------------+",
            "| ProbeBW_UP      | accel  | 1.25   | 2    | bw_hi  | inflight_hi      |",
            "|                 |        |        |      |        |                  |",
            "+-----------------+--------+--------+------+--------+------------------+",
            "| ProbeRTT        | decel  | 1.0    | 0.5  | bw_hi, | 0.85*inflight_hi |",
            "|                 |        |        |      | bw_lo  | inflight_lo      |",
            "+-----------------+--------+--------+------+--------+------------------+"
          ],
          "title": "Summary of Control Behavior in the State Machine"
        },
        {
          "id": "section-4.6.2",
          "lines": [
            "   To help match the packet-arrival rate to the bottleneck bandwidth",
            "   available to the flow, BBR paces data packets.  Pacing enforces a",
            "   maximum rate at which BBR schedules quanta of packets for",
            "   transmission.",
            "",
            "   The sending host implements pacing by maintaining inter-quantum",
            "   spacing at the time each packet is scheduled for departure,",
            "   calculating the next departure time for a packet for a given flow",
            "   (BBR.next_departure_time) as a function of the most recent packet",
            "   size and the current pacing rate, as follows:",
            "",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "     "
              },
              {
                "annotation_ids": [
                  "6291ebf847e270b8"
                ],
                "status_id": 1,
                "text": "BBR.next_departure_time = max(Now(), BBR.next_departure_time)"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "     "
              },
              {
                "annotation_ids": [
                  "6291ebf847e270b8"
                ],
                "status_id": 1,
                "text": "packet.departure_time = BBR.next_departure_time"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "     "
              },
              {
                "annotation_ids": [
                  "6291ebf847e270b8"
                ],
                "status_id": 1,
                "text": "pacing_delay = packet.size / BBR.pacing_rate"
              }
            ],
            "     BBR.next_departure_time = BBR.next_departure_time + pacing_delay",
            "",
            "   To adapt to the bottleneck, in general BBR sets the pacing rate to be",
            "   proportional to bw, with a dynamic gain, or scaling factor of",
            "   proportionality, called pacing_gain.",
            "",
            "   When a BBR flow starts it has no bw estimate (bw is 0).  So in this",
            "   case it sets an initial pacing rate based on the transport sender",
            "   implementation's initial congestion window (\"InitialCwnd\", e.g. from",
            "   [RFC6928]), the initial SRTT (smoothed round-trip time) after the",
            "   first non-zero RTT sample, and the initial pacing_gain:",
            "",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "     "
              },
              {
                "annotation_ids": [
                  "a8f7429d1c878607"
                ],
                "status_id": 1,
                "text": "BBRInitPacingRate():"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "       "
              },
              {
                "annotation_ids": [
                  "a8f7429d1c878607"
                ],
                "status_id": 1,
                "text": "nominal_bandwidth = InitialCwnd / (SRTT ? SRTT : 1ms)"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "       "
              },
              {
                "annotation_ids": [
                  "a8f7429d1c878607"
                ],
                "status_id": 1,
                "text": "BBR.pacing_rate =  BBRStartupPacingGain * nominal_bandwidth"
              }
            ],
            "",
            "   After initialization, on each data ACK BBR updates its pacing rate to",
            "   be proportional to bw, as long as it estimates that it has filled the",
            "   pipe (BBR.filled_pipe is true; see the \"Startup\" section for",
            "   details), or doing so increases the pacing rate.  Limiting the pacing",
            "   rate updates in this way helps the connection probe robustly for",
            "   bandwidth until it estimates it has reached its full available",
            "   bandwidth (\"filled the pipe\").  In particular, this prevents the",
            "   pacing rate from being reduced when the connection has only seen",
            "   application-limited bandwidth samples.  BBR updates the pacing rate",
            "   on each ACK by executing the BBRSetPacingRate() step as follows:",
            "",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "     "
              },
              {
                "annotation_ids": [
                  "f5b0be76a4d50d6a",
                  "263948336f459c64"
                ],
                "status_id": 2,
                "text": "BBRSetPacingRateWithGain(pacing_gain):"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "       "
              },
              {
                "annotation_ids": [
                  "f5b0be76a4d50d6a",
                  "263948336f459c64"
                ],
                "status_id": 2,
                "text": "rate = pacing_gain * bw * (100 - BBRPacingMarginPercent) / 100"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "       "
              },
              {
                "annotation_ids": [
                  "f5b0be76a4d50d6a",
                  "263948336f459c64"
                ],
                "status_id": 2,
                "text": "if (BBR.filled_pipe || rate > BBR.pacing_rate)"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "         "
              },
              {
                "annotation_ids": [
                  "f5b0be76a4d50d6a",
                  "263948336f459c64"
                ],
                "status_id": 2,
                "text": "BBR.pacing_rate = rate"
              }
            ],
            "",
            "     BBRSetPacingRate():",
            "       BBRSetPacingRateWithGain(BBR.pacing_gain)",
            "",
            "   To help drive the network toward lower queues and low latency while",
            "   maintaining high utilization, the BBRPacingMarginPercent constant of",
            "   1 aims to cause BBR to pace at 1% below the bw, on average."
          ],
          "title": "Pacing Rate: BBR.pacing_rate"
        },
        {
          "id": "section-4.6.3",
          "lines": [
            "   In order to amortize per-packet overheads involved in the sending",
            "   process (host CPU, NIC processing, and interrupt processing delays),",
            "   high-performance transport sender implementations (e.g., Linux TCP)",
            "   often schedule an aggregate containing multiple packets (multiple",
            "   SMSS) worth of data as a single quantum (using TSO, GSO, or other",
            "   offload mechanisms).  The BBR congestion control algorithm makes this",
            "   control decision explicitly, dynamically calculating a quantum",
            "   control parameter that specifies the maximum size of these",
            "   transmission aggregates.  This decision is based on a trade-off:",
            "",
            "   *  A smaller quantum is preferred at lower data rates because it",
            "      results in shorter packet bursts, shorter queues, lower queueing",
            "      delays, and lower rates of packet loss.",
            "",
            "   *  A bigger quantum can be required at higher data rates because it",
            "      results in lower CPU overheads at the sending and receiving hosts,",
            "      who can ship larger amounts of data with a single trip through the",
            "      networking stack.",
            "",
            "   On each ACK, BBR runs BBRSetSendQuantum() to update BBR.send_quantum",
            "   as follows:",
            "",
            "     BBRSetSendQuantum():",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "       "
              },
              {
                "annotation_ids": [
                  "a8ec8e6015e61c7a",
                  "92cf81dfb1cec91e"
                ],
                "status_id": 2,
                "text": "if (BBR.pacing_rate < 1.2 Mbps)"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "         "
              },
              {
                "annotation_ids": [
                  "a8ec8e6015e61c7a",
                  "92cf81dfb1cec91e"
                ],
                "status_id": 2,
                "text": "floor = 1 * SMSS"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "       "
              },
              {
                "annotation_ids": [
                  "a8ec8e6015e61c7a",
                  "92cf81dfb1cec91e"
                ],
                "status_id": 2,
                "text": "else"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "         "
              },
              {
                "annotation_ids": [
                  "a8ec8e6015e61c7a",
                  "92cf81dfb1cec91e"
                ],
                "status_id": 2,
                "text": "floor = 2 * SMSS"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "       "
              },
              {
                "annotation_ids": [
                  "a8ec8e6015e61c7a",
                  "6d3dbd4921ba3a0f",
                  "057c16c44e1c9bf4",
                  "92cf81dfb1cec91e"
                ],
                "status_id": 6,
                "text": "BBR.send_quantum = min(BBR.pacing_rate * 1ms, 64KBytes)"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "       "
              },
              {
                "annotation_ids": [
                  "a8ec8e6015e61c7a",
                  "92cf81dfb1cec91e"
                ],
                "status_id": 2,
                "text": "BBR.send_quantum = max(BBR.send_quantum, floor)"
              }
            ],
            "",
            "   A BBR implementation MAY use alternate approaches to select a",
            "   BBR.send_quantum, as appropriate for the CPU overheads anticipated",
            "   for senders and receivers, and buffering considerations anticipated",
            "   in the network path.  However, for the sake of the network and other",
            "   users, a BBR implementation SHOULD attempt to use the smallest",
            "   feasible quanta."
          ],
          "title": "Send Quantum: BBR.send_quantum"
        },
        {
          "id": "section-4.6.4",
          "lines": [
            "   The congestion window, or cwnd, controls the maximum volume of data",
            "   BBR allows in flight in the network at any time.  It is the maximum",
            "   volume of in-flight data that the algorithm estimates is appropriate",
            "   for matching the current network path delivery process, given all",
            "   available signals in the model, at any time scale.  BBR adapts the",
            "   cwnd based on its model of the network path and the state machine's",
            "   decisions about how to probe that path.",
            "",
            "   By default, BBR grows its cwnd to meet its BBR.max_inflight, which",
            "   models what's required for achieving full throughput, and as such is",
            "   scaled to adapt to the estimated BDP computed from its path model.",
            "   But BBR's selection of cwnd is designed to explicitly trade off among",
            "   competing considerations that dynamically adapt to various",
            "   conditions.  So in loss recovery BBR more conservatively adjusts its",
            "   sending behavior based on more recent delivery samples, and if BBR",
            "   needs to re-probe the current BBR.min_rtt of the path then it cuts",
            "   its cwnd accordingly.  The following sections describe the various",
            "   considerations that impact cwnd."
          ],
          "title": "Congestion Window"
        },
        {
          "id": "section-4.6.4.1",
          "lines": [
            "   BBR generally uses measurements to build a model of the network path",
            "   and then adapts control decisions to the path based on that model.",
            "   As such, the selection of the initial cwnd is considered to be",
            "   outside the scope of the BBR algorithm, since at initialization there",
            "   are no measurements yet upon which BBR can operate.  Thus, at",
            "   initialization, BBR uses the transport sender implementation's",
            "   initial congestion window (e.g. from [RFC6298] for TCP)."
          ],
          "title": "Initial cwnd"
        },
        {
          "id": "section-4.6.4.2",
          "lines": [
            "   The BBR BBR.max_inflight is the upper bound on the volume of data BBR",
            "   allows in flight.  This bound is always in place, and dominates when",
            "   all other considerations have been satisfied: the flow is not in loss",
            "   recovery, does not need to probe BBR.min_rtt, and has accumulated",
            "   confidence in its model parameters by receiving enough ACKs to",
            "   gradually grow the current cwnd to meet the BBR.max_inflight.",
            "",
            "   On each ACK, BBR calculates the BBR.max_inflight in",
            "   BBRUpdateMaxInflight() as follows:",
            "",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "     "
              },
              {
                "annotation_ids": [
                  "c12b24979290354e",
                  "d2b901218c241a73"
                ],
                "status_id": 2,
                "text": "BBRBDPMultiple(gain):"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "       "
              },
              {
                "annotation_ids": [
                  "c12b24979290354e",
                  "d2b901218c241a73"
                ],
                "status_id": 2,
                "text": "if (BBR.min_rtt == Inf)"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "         "
              },
              {
                "annotation_ids": [
                  "c12b24979290354e",
                  "d2b901218c241a73"
                ],
                "status_id": 2,
                "text": "return InitialCwnd /* no valid RTT samples yet */"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "       "
              },
              {
                "annotation_ids": [
                  "c12b24979290354e",
                  "d2b901218c241a73"
                ],
                "status_id": 2,
                "text": "BBR.bdp = BBR.bw * BBR.min_rtt"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "       "
              },
              {
                "annotation_ids": [
                  "c12b24979290354e",
                  "d2b901218c241a73"
                ],
                "status_id": 2,
                "text": "return gain * BBR.bdp"
              }
            ],
            "",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "     "
              },
              {
                "annotation_ids": [
                  "db4af7f0163c26af",
                  "f93aa8d509468b23"
                ],
                "status_id": 2,
                "text": "BBRQuantizationBudget(inflight)"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "       "
              },
              {
                "annotation_ids": [
                  "db4af7f0163c26af",
                  "f93aa8d509468b23"
                ],
                "status_id": 2,
                "text": "BBRUpdateOffloadBudget()"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "       "
              },
              {
                "annotation_ids": [
                  "db4af7f0163c26af",
                  "f93aa8d509468b23"
                ],
                "status_id": 2,
                "text": "inflight = max(inflight, BBR.offload_budget)"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "       "
              },
              {
                "annotation_ids": [
                  "db4af7f0163c26af",
                  "f93aa8d509468b23"
                ],
                "status_id": 2,
                "text": "inflight = max(inflight, BBRMinPipeCwnd)"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "         "
              },
              {
                "annotation_ids": [
                  "db4af7f0163c26af",
                  "f93aa8d509468b23"
                ],
                "status_id": 2,
                "text": "if (BBR.state == ProbeBW && BBR.cycle_idx == ProbeBW_UP)"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "         "
              },
              {
                "annotation_ids": [
                  "db4af7f0163c26af",
                  "f93aa8d509468b23"
                ],
                "status_id": 2,
                "text": "inflight += 2"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "       "
              },
              {
                "annotation_ids": [
                  "db4af7f0163c26af",
                  "f93aa8d509468b23"
                ],
                "status_id": 2,
                "text": "return inflight"
              }
            ],
            "",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "     "
              },
              {
                "annotation_ids": [
                  "10b87ad063d3f648",
                  "afe129d0195ebf20"
                ],
                "status_id": 2,
                "text": "BBRInflight(gain):"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "       "
              },
              {
                "annotation_ids": [
                  "10b87ad063d3f648",
                  "afe129d0195ebf20"
                ],
                "status_id": 2,
                "text": "inflight = BBRBDPMultiple(gain)"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "       "
              },
              {
                "annotation_ids": [
                  "10b87ad063d3f648",
                  "afe129d0195ebf20"
                ],
                "status_id": 2,
                "text": "return BBRQuantizationBudget(inflight)"
              }
            ],
            "",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "     "
              },
              {
                "annotation_ids": [
                  "3cb4fbb8b865df80",
                  "6e8624624287e86d"
                ],
                "status_id": 2,
                "text": "BBRUpdateMaxInflight():"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "       "
              },
              {
                "annotation_ids": [
                  "3cb4fbb8b865df80",
                  "6e8624624287e86d"
                ],
                "status_id": 2,
                "text": "BBRUpdateAggregationBudget()"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "       "
              },
              {
                "annotation_ids": [
                  "3cb4fbb8b865df80",
                  "6e8624624287e86d"
                ],
                "status_id": 2,
                "text": "inflight = BBRBDPMultiple(BBR.cwnd_gain)"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "       "
              },
              {
                "annotation_ids": [
                  "3cb4fbb8b865df80",
                  "6e8624624287e86d"
                ],
                "status_id": 2,
                "text": "inflight += BBR.extra_acked"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "       "
              },
              {
                "annotation_ids": [
                  "3cb4fbb8b865df80",
                  "6e8624624287e86d"
                ],
                "status_id": 2,
                "text": "BBR.max_inflight = BBRQuantizationBudget(inflight)"
              }
            ],
            "",
            "   The \"estimated_bdp\" term tries to allow enough packets in flight to",
            "   fully utilize the estimated BDP of the path, by allowing the flow to",
            "   send at BBR.bw for a duration of BBR.min_rtt.  Scaling up the BDP by",
            "   BBR.cwnd_gain bounds in-flight data to a small multiple of the BDP,",
            "   to handle common network and receiver behavior, such as delayed,",
            "   stretched, or aggregated ACKs [A15].  The \"quanta\" term allows enough",
            "   quanta in flight on the sending and receiving hosts to reach high",
            "   throughput even in environments using offload mechanisms."
          ],
          "title": "Computing BBR.max_inflight"
        },
        {
          "id": "section-4.6.4.3",
          "lines": [
            "   For BBR.max_inflight, BBR imposes a floor of BBRMinPipeCwnd (4",
            "   packets, i.e. 4 * SMSS).  This floor helps ensure that even at very",
            "   low BDPs, and with a transport like TCP where a receiver may ACK only",
            "   every alternate SMSS of data, there are enough packets in flight to",
            "   maintain full pipelining.  In particular BBR tries to allow at least",
            "   2 data packets in flight and ACKs for at least 2 data packets on the",
            "   path from receiver to sender."
          ],
          "title": "Minimum cwnd for Pipelining"
        },
        {
          "id": "section-4.6.4.4",
          "lines": [
            "   BBR interprets loss as a hint that there may be recent changes in",
            "   path behavior that are not yet fully reflected in its model of the",
            "   path, and thus it needs to be more conservative.",
            "",
            "   Upon a retransmission timeout (RTO), BBR conservatively reduces cwnd",
            "   to a value that will allow 1 SMSS to be transmitted.  Then BBR",
            "   gradually increases cwnd using the normal approach outlined below in",
            "   \"Core cwnd Adjustment Mechanism\".",
            "",
            "   When a BBR sender detects packet loss but there are still packets in",
            "   flight, on the first round of the loss-repair process BBR temporarily",
            "   reduces the cwnd to match the current delivery rate as ACKs arrive.",
            "   On second and later rounds of loss repair, it ensures the sending",
            "   rate never exceeds twice the current delivery rate as ACKs arrive.",
            "",
            "   When BBR exits loss recovery it restores the cwnd to the \"last known",
            "   good\" value that cwnd held before entering recovery.  This applies",
            "   equally whether the flow exits loss recovery because it finishes",
            "   repairing all losses or because it executes an \"undo\" event after",
            "   inferring that a loss recovery event was spurious.",
            "",
            "   There are several ways to implement this high-level design for",
            "   updating cwnd in loss recovery.  One is as follows:",
            "",
            "   Upon retransmission timeout (RTO):",
            "",
            "     BBROnEnterRTO():",
            "       BBR.prior_cwnd = BBRSaveCwnd()",
            "       cwnd = packets_in_flight + 1",
            "",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "a0b64d5e061b766d"
                ],
                "status_id": 7,
                "text": "Upon entering Fast Recovery, set cwnd to the number of packets still"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "a0b64d5e061b766d"
                ],
                "status_id": 7,
                "text": "in flight (allowing at least one for a fast retransmit):"
              }
            ],
            "",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "     "
              },
              {
                "annotation_ids": [
                  "a0b64d5e061b766d"
                ],
                "status_id": 7,
                "text": "BBROnEnterFastRecovery():"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "       "
              },
              {
                "annotation_ids": [
                  "a0b64d5e061b766d"
                ],
                "status_id": 7,
                "text": "BBR.prior_cwnd = BBRSaveCwnd()"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "       "
              },
              {
                "annotation_ids": [
                  "a0b64d5e061b766d"
                ],
                "status_id": 7,
                "text": "cwnd = packets_in_flight + max(rs.newly_acked, 1)"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "       "
              },
              {
                "annotation_ids": [
                  "a0b64d5e061b766d"
                ],
                "status_id": 7,
                "text": "BBR.packet_conservation = true"
              }
            ],
            "",
            "   Upon every ACK in Fast Recovery, run the following",
            "   BBRModulateCwndForRecovery() steps, which help ensure packet",
            "   conservation on the first round of recovery, and sending at no more",
            "   than twice the current delivery rate on later rounds of recovery",
            "   (given that \"rs.newly_acked\" packets were newly marked ACKed or",
            "   SACKed and \"rs.newly_lost\" were newly marked lost):",
            "",
            "     BBRModulateCwndForRecovery():",
            "       if (rs.newly_lost > 0)",
            "         cwnd = max(cwnd - rs.newly_lost, 1)",
            "       if (BBR.packet_conservation)",
            "         cwnd = max(cwnd, packets_in_flight + rs.newly_acked)",
            "",
            "   After one round-trip in Fast Recovery:",
            "",
            "     BBR.packet_conservation = false",
            "",
            "   Upon exiting loss recovery (RTO recovery or Fast Recovery), either by",
            "   repairing all losses or undoing recovery, BBR restores the best-known",
            "   cwnd value we had upon entering loss recovery:",
            "",
            "     BBR.packet_conservation = false",
            "     BBRRestoreCwnd()",
            "",
            "   Note that exiting loss recovery happens during ACK processing, and at",
            "   the end of ACK processing BBRBoundCwndForModel() will bound the cwnd",
            "   based on the current model parameters.  Thus the cwnd and pacing rate",
            "   after loss recovery will generally be smaller than the values",
            "   entering loss recovery.",
            "",
            "   The BBRSaveCwnd() and BBRRestoreCwnd() helpers help remember and",
            "   restore the last-known good cwnd (the latest cwnd unmodulated by loss",
            "   recovery or ProbeRTT), and is defined as follows:",
            "",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "     "
              },
              {
                "annotation_ids": [
                  "7895a524797458ee",
                  "7a9939a01cd6dc30"
                ],
                "status_id": 2,
                "text": "BBRSaveCwnd():"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "       "
              },
              {
                "annotation_ids": [
                  "7895a524797458ee",
                  "7a9939a01cd6dc30"
                ],
                "status_id": 2,
                "text": "if (!InLossRecovery() and BBR.state != ProbeRTT)"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "         "
              },
              {
                "annotation_ids": [
                  "7895a524797458ee",
                  "7a9939a01cd6dc30"
                ],
                "status_id": 2,
                "text": "return cwnd"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "       "
              },
              {
                "annotation_ids": [
                  "7895a524797458ee",
                  "7a9939a01cd6dc30"
                ],
                "status_id": 2,
                "text": "else"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "         "
              },
              {
                "annotation_ids": [
                  "7895a524797458ee",
                  "7a9939a01cd6dc30"
                ],
                "status_id": 2,
                "text": "return max(BBR.prior_cwnd, cwnd)"
              }
            ],
            "",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "     "
              },
              {
                "annotation_ids": [
                  "2b180660d028043e",
                  "7613326476da384a"
                ],
                "status_id": 2,
                "text": "BBRRestoreCwnd():"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "       "
              },
              {
                "annotation_ids": [
                  "2b180660d028043e",
                  "7613326476da384a"
                ],
                "status_id": 2,
                "text": "cwnd = max(cwnd, BBR.prior_cwnd)"
              }
            ]
          ],
          "title": "Modulating cwnd in Loss Recovery"
        },
        {
          "id": "section-4.6.4.5",
          "lines": [
            "   If BBR decides it needs to enter the ProbeRTT state (see the",
            "   \"ProbeRTT\" section below), its goal is to quickly reduce the volume",
            "   of in-flight data and drain the bottleneck queue, thereby allowing",
            "   measurement of BBR.min_rtt.  To implement this mode, BBR bounds the",
            "   cwnd to BBRMinPipeCwnd, the minimal value that allows pipelining (see",
            "   the \"Minimum cwnd for Pipelining\" section, above):",
            "",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "     "
              },
              {
                "annotation_ids": [
                  "65e7dc5236a3430a",
                  "aa8f81d5737a7d25"
                ],
                "status_id": 2,
                "text": "BBRProbeRTTCwnd():"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "       "
              },
              {
                "annotation_ids": [
                  "65e7dc5236a3430a",
                  "aa8f81d5737a7d25"
                ],
                "status_id": 2,
                "text": "probe_rtt_cwnd = BBRBDPMultiple(BBR.bw, BBRProbeRTTCwndGain)"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "       "
              },
              {
                "annotation_ids": [
                  "65e7dc5236a3430a",
                  "aa8f81d5737a7d25"
                ],
                "status_id": 2,
                "text": "probe_rtt_cwnd = max(probe_rtt_cwnd, BBRMinPipeCwnd)"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "       "
              },
              {
                "annotation_ids": [
                  "65e7dc5236a3430a",
                  "aa8f81d5737a7d25"
                ],
                "status_id": 2,
                "text": "return probe_rtt_cwnd"
              }
            ],
            "",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "     "
              },
              {
                "annotation_ids": [
                  "d0331080b8d51868",
                  "e73a02a731773c02"
                ],
                "status_id": 2,
                "text": "BBRBoundCwndForProbeRTT():"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "       "
              },
              {
                "annotation_ids": [
                  "d0331080b8d51868",
                  "e73a02a731773c02"
                ],
                "status_id": 2,
                "text": "if (BBR.state == ProbeRTT)"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "         "
              },
              {
                "annotation_ids": [
                  "d0331080b8d51868",
                  "e73a02a731773c02"
                ],
                "status_id": 2,
                "text": "cwnd = min(cwnd, BBRProbeRTTCwnd())"
              }
            ]
          ],
          "title": "Modulating cwnd in ProbeRTT"
        },
        {
          "id": "section-4.6.4.6",
          "lines": [
            "   The network path and traffic traveling over it can make sudden",
            "   dramatic changes.  To adapt to these changes smoothly and robustly,",
            "   and reduce packet losses in such cases, BBR uses a conservative",
            "   strategy.  When cwnd is above the BBR.max_inflight derived from BBR's",
            "   path model, BBR cuts the cwnd immediately to the BBR.max_inflight.",
            "   When cwnd is below BBR.max_inflight, BBR raises the cwnd gradually",
            "   and cautiously, increasing cwnd by no more than the amount of data",
            "   acknowledged (cumulatively or selectively) upon each ACK.",
            "",
            "   Specifically, on each ACK that acknowledges \"rs.newly_acked\" packets",
            "   as newly ACKed or SACKed, BBR runs the following BBRSetCwnd() steps",
            "   to update cwnd:",
            "",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "     "
              },
              {
                "annotation_ids": [
                  "d91a27fb3c5b412f"
                ],
                "status_id": 1,
                "text": "BBRSetCwnd():"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "       "
              },
              {
                "annotation_ids": [
                  "d91a27fb3c5b412f"
                ],
                "status_id": 1,
                "text": "BBRUpdateMaxInflight()"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "       "
              },
              {
                "annotation_ids": [
                  "d91a27fb3c5b412f",
                  "72b11443b9c94743"
                ],
                "status_id": 3,
                "text": "BBRModulateCwndForRecovery()"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "       "
              },
              {
                "annotation_ids": [
                  "d91a27fb3c5b412f"
                ],
                "status_id": 1,
                "text": "if (!BBR.packet_conservation) {"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "         "
              },
              {
                "annotation_ids": [
                  "aa8abd2d40f48a2d",
                  "d91a27fb3c5b412f"
                ],
                "status_id": 2,
                "text": "if (BBR.filled_pipe)"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "           "
              },
              {
                "annotation_ids": [
                  "aa8abd2d40f48a2d",
                  "d91a27fb3c5b412f"
                ],
                "status_id": 2,
                "text": "cwnd = min(cwnd + rs.newly_acked, BBR.max_inflight)"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "         "
              },
              {
                "annotation_ids": [
                  "87373019573e8924",
                  "d91a27fb3c5b412f"
                ],
                "status_id": 2,
                "text": "else if (cwnd < BBR.max_inflight || C.delivered < InitialCwnd)"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "           "
              },
              {
                "annotation_ids": [
                  "87373019573e8924",
                  "d91a27fb3c5b412f"
                ],
                "status_id": 2,
                "text": "cwnd = cwnd + rs.newly_acked"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "         "
              },
              {
                "annotation_ids": [
                  "d91a27fb3c5b412f"
                ],
                "status_id": 1,
                "text": "cwnd = max(cwnd, BBRMinPipeCwnd)"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "       "
              },
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "}"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "       "
              },
              {
                "annotation_ids": [
                  "d91a27fb3c5b412f"
                ],
                "status_id": 1,
                "text": "BBRBoundCwndForProbeRTT()"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "       "
              },
              {
                "annotation_ids": [
                  "d91a27fb3c5b412f"
                ],
                "status_id": 1,
                "text": "BBRBoundCwndForModel()"
              }
            ],
            "",
            "   There are several considerations embodied in the logic above.  If BBR",
            "   has measured enough samples to achieve confidence that it has filled",
            "   the pipe (see the description of BBR.filled_pipe in the \"Startup\"",
            "   section below), then it increases its cwnd based on the number of",
            "   packets delivered, while bounding its cwnd to be no larger than the",
            "   BBR.max_inflight adapted to the estimated BDP.  Otherwise, if the",
            "   cwnd is below the BBR.max_inflight, or the sender has marked so",
            "   little data delivered (less than InitialCwnd) that it does not yet",
            "   judge its BBR.max_bw estimate and BBR.max_inflight as useful, then it",
            "   increases cwnd without bounding it to be below BBR.max_inflight.",
            "   Finally, BBR imposes a floor of BBRMinPipeCwnd in order to allow",
            "   pipelining even with small BDPs (see the \"Minimum cwnd for",
            "   Pipelining\" section, above)."
          ],
          "title": "Core cwnd Adjustment Mechanism"
        },
        {
          "id": "section-4.6.4.7",
          "lines": [
            "   Finally, BBR bounds the cwnd based on recent congestion, as outlined",
            "   in the \"Volume Cap\" column of the table in the \"Summary of Control",
            "   Behavior in the State Machine\" section:",
            "",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "     "
              },
              {
                "annotation_ids": [
                  "ffa881f1017d52c0",
                  "1fa7121884d44bec"
                ],
                "status_id": 2,
                "text": "BBRBoundCwndForModel():"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "       "
              },
              {
                "annotation_ids": [
                  "ffa881f1017d52c0",
                  "1fa7121884d44bec"
                ],
                "status_id": 2,
                "text": "cap = Infinity"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "       "
              },
              {
                "annotation_ids": [
                  "ffa881f1017d52c0",
                  "1fa7121884d44bec"
                ],
                "status_id": 2,
                "text": "if (IsInAProbeBWState() and"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "           "
              },
              {
                "annotation_ids": [
                  "ffa881f1017d52c0",
                  "1fa7121884d44bec"
                ],
                "status_id": 2,
                "text": "BBR.state != ProbeBW_CRUISE)"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "         "
              },
              {
                "annotation_ids": [
                  "ffa881f1017d52c0",
                  "1fa7121884d44bec"
                ],
                "status_id": 2,
                "text": "cap = BBR.inflight_hi"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "       "
              },
              {
                "annotation_ids": [
                  "ffa881f1017d52c0",
                  "1fa7121884d44bec"
                ],
                "status_id": 2,
                "text": "else if (BBR.state == ProbeRTT or"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "                "
              },
              {
                "annotation_ids": [
                  "ffa881f1017d52c0",
                  "1fa7121884d44bec"
                ],
                "status_id": 2,
                "text": "BBR.state == ProbeBW_CRUISE)"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "         "
              },
              {
                "annotation_ids": [
                  "ffa881f1017d52c0",
                  "1fa7121884d44bec"
                ],
                "status_id": 2,
                "text": "cap = BBRInflightWithHeadroom()"
              }
            ],
            "",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "       "
              },
              {
                "annotation_ids": [
                  "ffa881f1017d52c0",
                  "1fa7121884d44bec"
                ],
                "status_id": 2,
                "text": "/* apply inflight_lo (possibly infinite): */"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "       "
              },
              {
                "annotation_ids": [
                  "ffa881f1017d52c0",
                  "1fa7121884d44bec"
                ],
                "status_id": 2,
                "text": "cap = min(cap, BBR.inflight_lo)"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "       "
              },
              {
                "annotation_ids": [
                  "ffa881f1017d52c0",
                  "1fa7121884d44bec"
                ],
                "status_id": 2,
                "text": "cap = max(cap, BBRMinPipeCwnd)"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "       "
              },
              {
                "annotation_ids": [
                  "ffa881f1017d52c0",
                  "1fa7121884d44bec"
                ],
                "status_id": 2,
                "text": "cwnd = min(cwnd, cap)"
              }
            ]
          ],
          "title": "Bounding cwnd Based on Recent Congestion"
        },
        {
          "id": "section-5",
          "lines": [
            "   This section records the status of known implementations of the",
            "   algorithm defined by this specification at the time of posting of",
            "   this Internet-Draft, and is based on a proposal described in",
            "   [RFC7942].  The description of implementations in this section is",
            "   intended to assist the IETF in its decision processes in progressing",
            "   drafts to RFCs.  Please note that the listing of any individual",
            "   implementation here does not imply endorsement by the IETF.",
            "   Furthermore, no effort has been spent to verify the information",
            "   presented here that was supplied by IETF contributors.  This is not",
            "   intended as, and must not be construed to be, a catalog of available",
            "   implementations or their features.  Readers are advised to note that",
            "   other implementations may exist.",
            "",
            "   According to [RFC7942], \"this will allow reviewers and working groups",
            "   to assign due consideration to documents that have the benefit of",
            "   running code, which may serve as evidence of valuable experimentation",
            "   and feedback that have made the implemented protocols more mature.",
            "   It is up to the individual working groups to use this information as",
            "   they see fit\".",
            "",
            "   As of the time of writing, the following implementations of BBR have",
            "   been publicly released:",
            "",
            "   *  Linux TCP",
            "",
            "      -  Source code URL:",
            "",
            "         o  https://github.com/google/bbr/blob/v2alpha/README.md",
            "",
            "         o  https://github.com/google/bbr/blob/v2alpha/net/ipv4/",
            "            tcp_bbr2.c",
            "",
            "      -  Source: Google",
            "",
            "      -  Maturity: production",
            "",
            "      -  License: dual-licensed: GPLv2 / BSD",
            "",
            "      -  Contact: https://groups.google.com/d/forum/bbr-dev",
            "",
            "      -  Last updated: August 21, 2021",
            "",
            "   *  QUIC",
            "",
            "      -  Source code URLs:",
            "",
            "         o  https://cs.chromium.org/chromium/src/net/third_party/quiche/",
            "            src/quic/core/congestion_control/bbr2_sender.cc",
            "",
            "         o  https://cs.chromium.org/chromium/src/net/third_party/quiche/",
            "            src/quic/core/congestion_control/bbr2_sender.h",
            "",
            "      -  Source: Google",
            "",
            "      -  Maturity: production",
            "",
            "      -  License: BSD-style",
            "",
            "      -  Contact: https://groups.google.com/d/forum/bbr-dev",
            "",
            "      -  Last updated: October 21, 2021"
          ],
          "title": "Implementation Status"
        },
        {
          "id": "section-6",
          "lines": [
            "   This proposal makes no changes to the underlying security of",
            "   transport protocols or congestion control algorithms.  BBR shares the",
            "   same security considerations as the existing standard congestion",
            "   control algorithm [RFC5681]."
          ],
          "title": "Security Considerations"
        },
        {
          "id": "section-7",
          "lines": [
            "   This document has no IANA actions.  Here we are using that phrase,",
            "   suggested by [RFC5226], because BBR does not modify or extend the",
            "   wire format of any network protocol, nor does it add new dependencies",
            "   on assigned numbers.  BBR involves only a change to the congestion",
            "   control algorithm of a transport sender, and does not involve changes",
            "   in the network, the receiver, or any network protocol.",
            "",
            "   Note to RFC Editor: this section may be removed on publication as an",
            "   RFC."
          ],
          "title": "IANA Considerations"
        },
        {
          "id": "section-8",
          "lines": [
            "   The authors are grateful to Len Kleinrock for his work on the theory",
            "   underlying congestion control.  We are indebted to Larry Brakmo for",
            "   pioneering work on the Vegas [BP95] and New Vegas [B15] congestion",
            "   control algorithms, which presaged many elements of BBR, and for",
            "   Larry's advice and guidance during BBR's early development.  The",
            "   authors would also like to thank Kevin Yang, Priyaranjan Jha, Yousuk",
            "   Seung, Luke Hsiao for their work on TCP BBR; Jana Iyengar, Victor",
            "   Vasiliev, Bin Wu for their work on QUIC BBR; and Matt Mathis for his",
            "   research work on the BBR algorithm and its implications [MM19].  We",
            "   would also like to thank C.  Stephen Gunn, Eric Dumazet, Nandita",
            "   Dukkipati, Pawel Jurczyk, Biren Roy, David Wetherall, Amin Vahdat,",
            "   Leonidas Kontothanassis, and the YouTube, google.com, Bandwidth",
            "   Enforcer, and Google SRE teams for their invaluable help and support.",
            "   We would like to thank Randall R.  Stewart, Jim Warner, Loganaden",
            "   Velvindron, Hiren Panchasara, and Adrian Zapletal for feedback and",
            "   suggestions on earlier versions of this document."
          ],
          "title": "Acknowledgments"
        },
        {
          "id": "section-9",
          "lines": [],
