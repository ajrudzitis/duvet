              },
              {
                "annotation_ids": [
                  "2e1ef005e7f45440"
                ],
                "status_id": 1,
                "text": "ECT   CE         [Obsolete] RFC 2481 names for the ECN bits."
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "         "
              },
              {
                "annotation_ids": [
                  "2e1ef005e7f45440"
                ],
                "status_id": 1,
                "text": "0     0         Not-ECT"
              }
            ],
            [
              {
                "annotation_ids": [],
