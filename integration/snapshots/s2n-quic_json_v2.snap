      "quote": "An endpoint MUST NOT send a Stateless Reset that is three times or more larger than the packet it receives to avoid being used for amplification.",
      "source": "quic/s2n-quic-core/src/packet/stateless_reset.rs",
      "target_path": "https://www.rfc-editor.org/rfc/rfc9000",
      "target_section": "section-10.3",
