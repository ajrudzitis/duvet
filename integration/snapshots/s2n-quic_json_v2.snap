            "   *  Subodh Iyengar",
            "   *  Tatsuhiro Tsujikawa",
            "   *  Ted Hardie",
            "   *  Tom Jones",
            "   *  Victor Vasiliev"
          ],
          "title": "Contributors"
        },
        {
          "id": "name-authors-addresses",
          "lines": [
            "   Jana Iyengar (editor)",
            "   Fastly",
