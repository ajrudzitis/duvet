    },
    {
      "id": "0c40607470e0c1a7",
      "level": "Auto",
      "line": 43,
      "quote": "BBREnterDrain(): BBR.state = Drain BBR.pacing_gain = 1/BBRStartupCwndGain  /* pace slowly */ BBR.cwnd_gain = BBRStartupCwndGain      /* maintain cwnd */",
      "source": "quic/s2n-quic-core/src/recovery/bbr/drain.rs",
      "target_path": "https://tools.ietf.org/id/draft-cardwell-iccrg-bbr-congestion-control-02",
