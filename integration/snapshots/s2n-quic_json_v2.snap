    },
    {
      "id": "36b58e172e1ea42b",
      "level": "Auto",
      "line": 601,
      "quote": "",
      "source": "quic/s2n-quic-events/events/common.rs",
      "target_path": "https://tools.ietf.org/id/draft-marx-qlog-event-definitions-quic-h3-02",
      "target_section": "A.4",
