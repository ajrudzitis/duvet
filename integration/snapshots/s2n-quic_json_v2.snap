                  "2bcde3b2ddb0bd1e",
                  "6efd9ad39ca6a07f"
                ],
                "status_id": 1,
                "text": "| Recv All Data             |"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "          "
              },
              {
                "annotation_ids": [
                  "2bcde3b2ddb0bd1e",
                  "6efd9ad39ca6a07f"
                ],
                "status_id": 1,
                "text": "v                           v"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "      "
              },
              {
                "annotation_ids": [
                  "2bcde3b2ddb0bd1e",
                  "6efd9ad39ca6a07f"
                ],
                "status_id": 1,
                "text": "+-------+ Recv RESET_STREAM +-------+"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "      "
              },
              {
                "annotation_ids": [
                  "2bcde3b2ddb0bd1e",
                  "6efd9ad39ca6a07f"
                ],
                "status_id": 1,
                "text": "| Data  |--- (optional) --->| Reset |"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "      "
              },
              {
                "annotation_ids": [
                  "2bcde3b2ddb0bd1e",
                  "6efd9ad39ca6a07f"
                ],
                "status_id": 1,
                "text": "| Recvd |  Recv All Data    | Recvd |"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "      "
              },
              {
                "annotation_ids": [
                  "2bcde3b2ddb0bd1e",
                  "6efd9ad39ca6a07f"
                ],
                "status_id": 1,
                "text": "+-------+<-- (optional) ----+-------+"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "          "
              },
              {
                "annotation_ids": [
                  "2bcde3b2ddb0bd1e",
                  "6efd9ad39ca6a07f"
                ],
                "status_id": 1,
                "text": "|                           |"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "          "
              },
              {
                "annotation_ids": [
                  "2bcde3b2ddb0bd1e",
                  "6efd9ad39ca6a07f"
                ],
                "status_id": 1,
                "text": "| App Read All Data         | App Read Reset"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "          "
              },
              {
                "annotation_ids": [
                  "2bcde3b2ddb0bd1e",
                  "6efd9ad39ca6a07f"
                ],
                "status_id": 1,
                "text": "v                           v"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "      "
              },
              {
                "annotation_ids": [
                  "2bcde3b2ddb0bd1e",
                  "6efd9ad39ca6a07f"
                ],
                "status_id": 1,
                "text": "+-------+                   +-------+"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "      "
              },
              {
                "annotation_ids": [
                  "2bcde3b2ddb0bd1e",
                  "6efd9ad39ca6a07f"
                ],
                "status_id": 1,
                "text": "| Data  |                   | Reset |"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "      "
              },
              {
                "annotation_ids": [
                  "2bcde3b2ddb0bd1e",
                  "6efd9ad39ca6a07f"
                ],
                "status_id": 1,
                "text": "| Read  |                   | Read  |"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "      "
              },
              {
                "annotation_ids": [
                  "2bcde3b2ddb0bd1e",
                  "6efd9ad39ca6a07f"
                ],
                "status_id": 1,
                "text": "+-------+                   +-------+"
              }
            ],
            "",
            "              Figure 3: States for Receiving Parts of Streams",
            "",
            "   The receiving part of a stream initiated by a peer (types 1 and 3 for",
            "   a client, or 0 and 2 for a server) is created when the first STREAM,",
            "   STREAM_DATA_BLOCKED, or RESET_STREAM frame is received for that",
            "   stream.  For bidirectional streams initiated by a peer, receipt of a",
            "   MAX_STREAM_DATA or STOP_SENDING frame for the sending part of the",
            "   stream also creates the receiving part.  The initial state for the",
            "   receiving part of a stream is \"Recv\".",
            "",
            "   For a bidirectional stream, the receiving part enters the \"Recv\"",
            "   state when the sending part initiated by the endpoint (type 0 for a",
            "   client, type 1 for a server) enters the \"Ready\" state.",
            "",
            "   An endpoint opens a bidirectional stream when a MAX_STREAM_DATA or",
            "   STOP_SENDING frame is received from the peer for that stream.",
            "   Receiving a MAX_STREAM_DATA frame for an unopened stream indicates",
            "   that the remote peer has opened the stream and is providing flow",
            "   control credit.  Receiving a STOP_SENDING frame for an unopened",
            "   stream indicates that the remote peer no longer wishes to receive",
            "   data on this stream.  Either frame might arrive before a STREAM or",
            "   STREAM_DATA_BLOCKED frame if packets are lost or reordered.",
            "",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "ce91fbd23a65cdaf",
                  "ce8ca832c7ba75ec"
                ],
                "status_id": 13,
                "text": "Before a stream is created, all streams of the same type with lower-"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "ce91fbd23a65cdaf",
                  "ce8ca832c7ba75ec"
                ],
                "status_id": 13,
                "text": "numbered stream IDs MUST be created."
              },
              {
                "annotation_ids": [
                  "ce91fbd23a65cdaf"
                ],
                "status_id": 1,
                "text": "  This ensures that the creation"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "ce91fbd23a65cdaf"
                ],
                "status_id": 1,
                "text": "order for streams is consistent on both endpoints."
              }
            ],
            "",
            "   In the \"Recv\" state, the endpoint receives STREAM and",
            "   STREAM_DATA_BLOCKED frames.  Incoming data is buffered and can be",
            "   reassembled into the correct order for delivery to the application.",
            "   As data is consumed by the application and buffer space becomes",
            "   available, the endpoint sends MAX_STREAM_DATA frames to allow the",
            "   peer to send more data.",
            "",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "3fab040bd3aacc64"
                ],
                "status_id": 1,
                "text": "When a STREAM frame with a FIN bit is received, the final size of the"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "3fab040bd3aacc64"
                ],
                "status_id": 1,
                "text": "stream is known; see Section 4.5.  The receiving part of the stream"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "3fab040bd3aacc64"
                ],
                "status_id": 1,
                "text": "then enters the \"Size Known\" state.  In this state, the endpoint no"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "3fab040bd3aacc64"
                ],
                "status_id": 1,
                "text": "longer needs to send MAX_STREAM_DATA frames; it only receives any"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "3fab040bd3aacc64"
                ],
                "status_id": 1,
                "text": "retransmissions of stream data."
              }
            ],
            "",
            "   Once all data for the stream has been received, the receiving part",
            "   enters the \"Data Recvd\" state.  This might happen as a result of",
            "   receiving the same STREAM frame that causes the transition to \"Size",
            "   Known\".  After all data has been received, any STREAM or",
            "   STREAM_DATA_BLOCKED frames for the stream can be discarded.",
            "",
            "   The \"Data Recvd\" state persists until stream data has been delivered",
            "   to the application.  Once stream data has been delivered, the stream",
            "   enters the \"Data Read\" state, which is a terminal state.",
            "",
            "   Receiving a RESET_STREAM frame in the \"Recv\" or \"Size Known\" state",
            "   causes the stream to enter the \"Reset Recvd\" state.  This might cause",
            "   the delivery of stream data to the application to be interrupted.",
            "",
            "   It is possible that all stream data has already been received when a",
            "   RESET_STREAM is received (that is, in the \"Data Recvd\" state).",
            "   Similarly, it is possible for remaining stream data to arrive after",
            "   receiving a RESET_STREAM frame (the \"Reset Recvd\" state).  An",
            "   implementation is free to manage this situation as it chooses.",
            "",
            "   Sending a RESET_STREAM means that an endpoint cannot guarantee",
            "   delivery of stream data; however, there is no requirement that stream",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   data not be delivered if a RESET_STREAM is received.  "
              },
              {
                "annotation_ids": [
                  "4d223abcc4ff0f5d",
                  "08f787cf4fe2072e"
                ],
                "status_id": 21,
                "text": "An"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "4d223abcc4ff0f5d",
                  "08f787cf4fe2072e"
                ],
                "status_id": 21,
                "text": "implementation MAY interrupt delivery of stream data, discard any"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "4d223abcc4ff0f5d",
                  "08f787cf4fe2072e"
                ],
                "status_id": 21,
                "text": "data that was not consumed, and signal the receipt of the"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "4d223abcc4ff0f5d",
                  "08f787cf4fe2072e"
                ],
                "status_id": 21,
                "text": "RESET_STREAM."
              },
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "  A RESET_STREAM signal might be suppressed or withheld"
              }
            ],
            "   if stream data is completely received and is buffered to be read by",
            "   the application.  If the RESET_STREAM is suppressed, the receiving",
            "   part of the stream remains in \"Data Recvd\".",
            "",
            "   Once the application receives the signal indicating that the stream",
            "   was reset, the receiving part of the stream transitions to the \"Reset",
            "   Read\" state, which is a terminal state."
          ],
          "requirements": [
            "ce8ca832c7ba75ec",
            "ce8ca832c7ba75ec",
            "08f787cf4fe2072e",
            "08f787cf4fe2072e",
            "08f787cf4fe2072e",
            "08f787cf4fe2072e"
          ],
          "title": "Receiving Stream States"
        },
        {
          "id": "section-3.3",
          "lines": [
            "   The sender of a stream sends just three frame types that affect the",
            "   state of a stream at either the sender or the receiver: STREAM",
            "   (Section 19.8), STREAM_DATA_BLOCKED (Section 19.13), and RESET_STREAM",
            "   (Section 19.4).",
            "",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "667990a0e42b1dd5",
                  "b7baec6e43dd5deb"
                ],
                "status_id": 13,
                "text": "A sender MUST NOT send any of these frames from a terminal state"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "667990a0e42b1dd5",
                  "b7baec6e43dd5deb"
                ],
                "status_id": 13,
                "text": "(\"Data Recvd\" or \"Reset Recvd\")."
              },
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "  "
              },
              {
                "annotation_ids": [
                  "7e38dd5cb42b9d5d",
                  "b1c96e70e24d7655",
                  "c7b385879ed05fa3"
                ],
                "status_id": 13,
                "text": "A sender MUST NOT send a STREAM or"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "7e38dd5cb42b9d5d",
                  "b1c96e70e24d7655",
                  "c7b385879ed05fa3"
                ],
                "status_id": 13,
                "text": "STREAM_DATA_BLOCKED frame for a stream in the \"Reset Sent\" state or"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "7e38dd5cb42b9d5d",
                  "b1c96e70e24d7655",
                  "c7b385879ed05fa3"
                ],
                "status_id": 13,
                "text": "any terminal state -- that is, after sending a RESET_STREAM frame."
              },
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "  A"
              }
            ],
            "   receiver could receive any of these three frames in any state, due to",
            "   the possibility of delayed delivery of packets carrying them.",
            "",
            "   The receiver of a stream sends MAX_STREAM_DATA frames (Section 19.10)",
            "   and STOP_SENDING frames (Section 19.5).",
            "",
            "   The receiver only sends MAX_STREAM_DATA frames in the \"Recv\" state.",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "45c93449d9656473",
                  "350715e3f86deafc"
                ],
                "status_id": 21,
                "text": "A receiver MAY send a STOP_SENDING frame in any state where it has"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "45c93449d9656473",
                  "350715e3f86deafc"
                ],
                "status_id": 21,
                "text": "not received a RESET_STREAM frame -- that is, states other than"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "45c93449d9656473",
                  "350715e3f86deafc"
                ],
                "status_id": 21,
                "text": "\"Reset Recvd\" or \"Reset Read\"."
              },
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "  However, there is little value in"
              }
            ],
            "   sending a STOP_SENDING frame in the \"Data Recvd\" state, as all stream",
            "   data has been received.  A sender could receive either of these two",
            "   types of frames in any state as a result of delayed delivery of",
            "   packets."
          ],
          "requirements": [
            "b7baec6e43dd5deb",
            "b7baec6e43dd5deb",
            "c7b385879ed05fa3",
            "c7b385879ed05fa3",
            "c7b385879ed05fa3",
            "350715e3f86deafc",
            "350715e3f86deafc",
            "350715e3f86deafc"
          ],
          "title": "Permitted Frame Types"
        },
        {
          "id": "section-3.4",
          "lines": [
            "   A bidirectional stream is composed of sending and receiving parts.",
            "   Implementations can represent states of the bidirectional stream as",
            "   composites of sending and receiving stream states.  The simplest",
            "   model presents the stream as \"open\" when either sending or receiving",
            "   parts are in a non-terminal state and \"closed\" when both sending and",
            "   receiving streams are in terminal states.",
            "",
            "   Table 2 shows a more complex mapping of bidirectional stream states",
            "   that loosely correspond to the stream states defined in HTTP/2",
            "   [HTTP2].  This shows that multiple states on sending or receiving",
            "   parts of streams are mapped to the same composite state.  Note that",
            "   this is just one possibility for such a mapping; this mapping",
            "   requires that data be acknowledged before the transition to a",
            "   \"closed\" or \"half-closed\" state.",
            "",
            "      +===================+=======================+=================+",
            "      | Sending Part      | Receiving Part        | Composite State |",
            "      +===================+=======================+=================+",
            "      | No Stream / Ready | No Stream / Recv (*1) | idle            |",
            "      +-------------------+-----------------------+-----------------+",
            "      | Ready / Send /    | Recv / Size Known     | open            |",
            "      | Data Sent         |                       |                 |",
            "      +-------------------+-----------------------+-----------------+",
            "      | Ready / Send /    | Data Recvd / Data     | half-closed     |",
            "      | Data Sent         | Read                  | (remote)        |",
            "      +-------------------+-----------------------+-----------------+",
            "      | Ready / Send /    | Reset Recvd / Reset   | half-closed     |",
            "      | Data Sent         | Read                  | (remote)        |",
            "      +-------------------+-----------------------+-----------------+",
            "      | Data Recvd        | Recv / Size Known     | half-closed     |",
            "      |                   |                       | (local)         |",
            "      +-------------------+-----------------------+-----------------+",
            "      | Reset Sent /      | Recv / Size Known     | half-closed     |",
            "      | Reset Recvd       |                       | (local)         |",
            "      +-------------------+-----------------------+-----------------+",
            "      | Reset Sent /      | Data Recvd / Data     | closed          |",
            "      | Reset Recvd       | Read                  |                 |",
            "      +-------------------+-----------------------+-----------------+",
            "      | Reset Sent /      | Reset Recvd / Reset   | closed          |",
            "      | Reset Recvd       | Read                  |                 |",
            "      +-------------------+-----------------------+-----------------+",
            "      | Data Recvd        | Data Recvd / Data     | closed          |",
            "      |                   | Read                  |                 |",
            "      +-------------------+-----------------------+-----------------+",
            "      | Data Recvd        | Reset Recvd / Reset   | closed          |",
            "      |                   | Read                  |                 |",
            "      +-------------------+-----------------------+-----------------+",
            "",
            "            Table 2: Possible Mapping of Stream States to HTTP/2",
            "",
            "      |  Note (*1): A stream is considered \"idle\" if it has not yet been",
            "      |  created or if the receiving part of the stream is in the \"Recv\"",
            "      |  state without yet having received any frames."
          ],
          "title": "Bidirectional Stream States"
        },
        {
          "id": "section-3.5",
          "lines": [
            "   If an application is no longer interested in the data it is receiving",
            "   on a stream, it can abort reading the stream and specify an",
            "   application error code.",
            "",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "bbc1dc458c925066",
                  "63a976cdf78f5991"
                ],
                "status_id": 22,
                "text": "If the stream is in the \"Recv\" or \"Size Known\" state, the transport"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "bbc1dc458c925066",
                  "63a976cdf78f5991"
                ],
                "status_id": 22,
                "text": "SHOULD signal this by sending a STOP_SENDING frame to prompt closure"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "bbc1dc458c925066",
                  "63a976cdf78f5991"
                ],
                "status_id": 22,
                "text": "of the stream in the opposite direction."
              },
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "  This typically indicates"
              }
            ],
            "   that the receiving application is no longer reading data it receives",
            "   from the stream, but it is not a guarantee that incoming data will be",
            "   ignored.",
            "",
            "   STREAM frames received after sending a STOP_SENDING frame are still",
            "   counted toward connection and stream flow control, even though these",
            "   frames can be discarded upon receipt.",
            "",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "ed758483a6e111aa"
                ],
                "status_id": 1,
                "text": "A STOP_SENDING frame requests that the receiving endpoint send a"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "ed758483a6e111aa"
                ],
                "status_id": 1,
                "text": "RESET_STREAM frame.  "
              },
              {
                "annotation_ids": [
                  "ed758483a6e111aa",
                  "5e03b5408ef33589"
                ],
                "status_id": 13,
                "text": "An endpoint that receives a STOP_SENDING frame"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "ed758483a6e111aa",
                  "5e03b5408ef33589"
                ],
                "status_id": 13,
                "text": "MUST send a RESET_STREAM frame if the stream is in the \"Ready\" or"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "ed758483a6e111aa",
                  "5e03b5408ef33589"
                ],
                "status_id": 13,
                "text": "\"Send\" state."
              },
              {
                "annotation_ids": [
                  "ed758483a6e111aa"
                ],
                "status_id": 1,
                "text": "  "
              },
              {
                "annotation_ids": [
                  "ed758483a6e111aa",
                  "24e0260ac13b0486"
                ],
                "status_id": 21,
                "text": "If the stream is in the \"Data Sent\" state, the"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "ed758483a6e111aa",
                  "24e0260ac13b0486"
                ],
                "status_id": 21,
                "text": "endpoint MAY defer sending the RESET_STREAM frame until the packets"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "ed758483a6e111aa",
                  "24e0260ac13b0486"
                ],
                "status_id": 21,
                "text": "containing outstanding data are acknowledged or declared lost."
              },
              {
                "annotation_ids": [
                  "ed758483a6e111aa"
                ],
                "status_id": 1,
                "text": "  "
              },
              {
                "annotation_ids": [
                  "ed758483a6e111aa",
                  "1b8169a84b5fce4b"
                ],
                "status_id": 22,
                "text": "If"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "ed758483a6e111aa",
                  "1b8169a84b5fce4b"
                ],
                "status_id": 22,
                "text": "any outstanding data is declared lost, the endpoint SHOULD send a"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "ed758483a6e111aa",
                  "1b8169a84b5fce4b"
                ],
                "status_id": 22,
                "text": "RESET_STREAM frame instead of retransmitting the data."
              }
            ],
            "",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "94602a514e7159d8",
                  "58008e9519dd7c64"
                ],
                "status_id": 22,
                "text": "An endpoint SHOULD copy the error code from the STOP_SENDING frame to"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "94602a514e7159d8",
                  "58008e9519dd7c64"
                ],
                "status_id": 22,
                "text": "the RESET_STREAM frame it sends, but it can use any application error"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "94602a514e7159d8",
                  "58008e9519dd7c64"
                ],
                "status_id": 22,
                "text": "code."
              },
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "  "
              },
              {
                "annotation_ids": [
                  "55573b21cbda9c69",
                  "ca94d1fe95c7fdc5"
                ],
                "status_id": 15,
                "text": "An endpoint that sends a STOP_SENDING frame MAY ignore the"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "55573b21cbda9c69",
                  "ca94d1fe95c7fdc5"
                ],
                "status_id": 15,
                "text": "error code in any RESET_STREAM frames subsequently received for that"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "55573b21cbda9c69",
                  "ca94d1fe95c7fdc5"
                ],
                "status_id": 15,
                "text": "stream."
              }
            ],
            "",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "2b7a198260b838fb",
                  "576925622deb731d"
                ],
                "status_id": 22,
                "text": "STOP_SENDING SHOULD only be sent for a stream that has not been reset"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "2b7a198260b838fb",
                  "576925622deb731d"
                ],
                "status_id": 22,
                "text": "by the peer."
              },
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "  STOP_SENDING is most useful for streams in the \"Recv\""
              }
            ],
            "   or \"Size Known\" state.",
            "",
            "   An endpoint is expected to send another STOP_SENDING frame if a",
            "   packet containing a previous STOP_SENDING is lost.  However, once",
            "   either all stream data or a RESET_STREAM frame has been received for",
            "   the stream -- that is, the stream is in any state other than \"Recv\"",
            "   or \"Size Known\" -- sending a STOP_SENDING frame is unnecessary.",
            "",
            "   An endpoint that wishes to terminate both directions of a",
            "   bidirectional stream can terminate one direction by sending a",
            "   RESET_STREAM frame, and it can encourage prompt termination in the",
            "   opposite direction by sending a STOP_SENDING frame."
          ],
          "requirements": [
            "63a976cdf78f5991",
            "63a976cdf78f5991",
            "63a976cdf78f5991",
            "5e03b5408ef33589",
            "5e03b5408ef33589",
            "5e03b5408ef33589",
            "24e0260ac13b0486",
            "24e0260ac13b0486",
            "24e0260ac13b0486",
            "1b8169a84b5fce4b",
            "1b8169a84b5fce4b",
            "1b8169a84b5fce4b",
            "58008e9519dd7c64",
            "58008e9519dd7c64",
            "58008e9519dd7c64",
            "ca94d1fe95c7fdc5",
            "ca94d1fe95c7fdc5",
            "ca94d1fe95c7fdc5",
            "576925622deb731d",
            "576925622deb731d"
          ],
          "title": "Solicited State Transitions"
        },
        {
          "id": "section-4",
          "lines": [
            "   Receivers need to limit the amount of data that they are required to",
            "   buffer, in order to prevent a fast sender from overwhelming them or a",
            "   malicious sender from consuming a large amount of memory.  To enable",
            "   a receiver to limit memory commitments for a connection, streams are",
            "   flow controlled both individually and across a connection as a whole.",
            "   A QUIC receiver controls the maximum amount of data the sender can",
            "   send on a stream as well as across all streams at any time, as",
            "   described in Sections 4.1 and 4.2.",
            "",
            "   Similarly, to limit concurrency within a connection, a QUIC endpoint",
            "   controls the maximum cumulative number of streams that its peer can",
            "   initiate, as described in Section 4.6.",
            "",
            "   Data sent in CRYPTO frames is not flow controlled in the same way as",
            "   stream data.  QUIC relies on the cryptographic protocol",
            "   implementation to avoid excessive buffering of data; see [QUIC-TLS].",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "8eee19114587a4a6",
                  "297ab0e4d35bd8fd"
                ],
                "status_id": 18,
                "text": "To avoid excessive buffering at multiple layers, QUIC implementations"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "8eee19114587a4a6",
                  "297ab0e4d35bd8fd"
                ],
                "status_id": 18,
                "text": "SHOULD provide an interface for the cryptographic protocol"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "8eee19114587a4a6",
                  "297ab0e4d35bd8fd"
                ],
                "status_id": 18,
                "text": "implementation to communicate its buffering limits."
              }
            ]
          ],
          "requirements": [
            "297ab0e4d35bd8fd",
            "297ab0e4d35bd8fd",
            "297ab0e4d35bd8fd"
          ],
          "title": "Flow Control"
        },
        {
          "id": "section-4.1",
          "lines": [
            "   QUIC employs a limit-based flow control scheme where a receiver",
            "   advertises the limit of total bytes it is prepared to receive on a",
            "   given stream or for the entire connection.  This leads to two levels",
            "   of data flow control in QUIC:",
            "",
            "   *  Stream flow control, which prevents a single stream from consuming",
            "      the entire receive buffer for a connection by limiting the amount",
            "      of data that can be sent on each stream.",
            "",
            "   *  Connection flow control, which prevents senders from exceeding a",
            "      receiver's buffer capacity for the connection by limiting the",
            "      total bytes of stream data sent in STREAM frames on all streams.",
            "",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "ef0a69079d49b0da",
                  "a4a23092edf91a31"
                ],
                "status_id": 13,
                "text": "Senders MUST NOT send data in excess of either limit."
              }
            ],
            "",
            "   A receiver sets initial limits for all streams through transport",
            "   parameters during the handshake (Section 7.4).  Subsequently, a",
            "   receiver sends MAX_STREAM_DATA frames (Section 19.10) or MAX_DATA",
            "   frames (Section 19.9) to the sender to advertise larger limits.",
            "",
            "   A receiver can advertise a larger limit for a stream by sending a",
            "   MAX_STREAM_DATA frame with the corresponding stream ID.  A",
            "   MAX_STREAM_DATA frame indicates the maximum absolute byte offset of a",
            "   stream.  A receiver could determine the flow control offset to be",
            "   advertised based on the current offset of data consumed on that",
            "   stream.",
            "",
            "   A receiver can advertise a larger limit for a connection by sending a",
            "   MAX_DATA frame, which indicates the maximum of the sum of the",
            "   absolute byte offsets of all streams.  A receiver maintains a",
            "   cumulative sum of bytes received on all streams, which is used to",
            "   check for violations of the advertised connection or stream data",
            "   limits.  A receiver could determine the maximum data limit to be",
            "   advertised based on the sum of bytes consumed on all streams.",
            "",
            "   Once a receiver advertises a limit for the connection or a stream, it",
            "   is not an error to advertise a smaller limit, but the smaller limit",
            "   has no effect.",
            "",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "0d84397f4d340388",
                  "f9b25d75b429d43e",
                  "758b001e494f0a51",
                  "eca346fa50c98657"
                ],
                "status_id": 13,
                "text": "A receiver MUST close the connection with an error of type"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "0d84397f4d340388",
                  "f9b25d75b429d43e",
                  "758b001e494f0a51",
                  "eca346fa50c98657"
                ],
                "status_id": 13,
                "text": "FLOW_CONTROL_ERROR if the sender violates the advertised connection"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "0d84397f4d340388",
                  "f9b25d75b429d43e",
                  "758b001e494f0a51",
                  "eca346fa50c98657"
                ],
                "status_id": 13,
                "text": "or stream data limits; see Section 11 for details on error handling."
              }
            ],
            "",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "261d2cfffbf2d5e7",
                  "11a16ed2d085e4a3",
                  "da74ade93153479d",
                  "21b760bf006d4a05",
                  "23758e8545f92cb3",
                  "5825974d6488b37e"
                ],
                "status_id": 9,
                "text": "A sender MUST ignore any MAX_STREAM_DATA or MAX_DATA frames that do"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "261d2cfffbf2d5e7",
                  "11a16ed2d085e4a3",
                  "da74ade93153479d",
                  "21b760bf006d4a05",
                  "23758e8545f92cb3",
                  "5825974d6488b37e"
                ],
                "status_id": 9,
                "text": "not increase flow control limits."
              }
            ],
            "",
            "   If a sender has sent data up to the limit, it will be unable to send",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   new data and is considered blocked.  "
              },
              {
                "annotation_ids": [
                  "e7e636438d07d7e2",
                  "a9d87464f3a3d01f",
                  "2703176a0c77004f",
                  "c120f9deadab5323",
                  "4050eb5088365906"
                ],
                "status_id": 8,
                "text": "A sender SHOULD send a"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "e7e636438d07d7e2",
                  "a9d87464f3a3d01f",
                  "2703176a0c77004f",
                  "c120f9deadab5323",
                  "4050eb5088365906"
                ],
                "status_id": 8,
                "text": "STREAM_DATA_BLOCKED or DATA_BLOCKED frame to indicate to the receiver"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "e7e636438d07d7e2",
                  "a9d87464f3a3d01f",
                  "2703176a0c77004f",
                  "c120f9deadab5323",
                  "4050eb5088365906"
                ],
                "status_id": 8,
                "text": "that it has data to write but is blocked by flow control limits."
              },
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "  If"
              }
            ],
            "   a sender is blocked for a period longer than the idle timeout",
            "   (Section 10.1), the receiver might close the connection even when the",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   sender has data that is available for transmission.  "
              },
              {
                "annotation_ids": [
                  "403e6d8c705c908b",
                  "a3c2ea304097812d",
                  "94d6ec18b9ae1e20",
                  "db7a47cd47730907",
                  "737442a815981ca4",
                  "5f8ef8741ac12aca",
                  "aa7fb66ee9ed619c",
                  "dcad2862e413ef4f"
                ],
                "status_id": 8,
                "text": "To keep the"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "403e6d8c705c908b",
                  "a3c2ea304097812d",
                  "94d6ec18b9ae1e20",
                  "db7a47cd47730907",
                  "737442a815981ca4",
                  "5f8ef8741ac12aca",
                  "aa7fb66ee9ed619c",
                  "dcad2862e413ef4f"
                ],
                "status_id": 8,
                "text": "connection from closing, a sender that is flow control limited SHOULD"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "403e6d8c705c908b",
                  "a3c2ea304097812d",
                  "94d6ec18b9ae1e20",
                  "db7a47cd47730907",
                  "737442a815981ca4",
                  "5f8ef8741ac12aca",
                  "aa7fb66ee9ed619c",
                  "dcad2862e413ef4f"
                ],
                "status_id": 8,
                "text": "periodically send a STREAM_DATA_BLOCKED or DATA_BLOCKED frame when it"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "403e6d8c705c908b",
                  "a3c2ea304097812d",
                  "94d6ec18b9ae1e20",
                  "db7a47cd47730907",
                  "737442a815981ca4",
                  "5f8ef8741ac12aca",
                  "aa7fb66ee9ed619c",
                  "dcad2862e413ef4f"
                ],
                "status_id": 8,
                "text": "has no ack-eliciting packets in flight."
              }
            ]
          ],
          "requirements": [
            "a4a23092edf91a31",
            "eca346fa50c98657",
            "eca346fa50c98657",
            "eca346fa50c98657",
            "5825974d6488b37e",
            "5825974d6488b37e",
            "4050eb5088365906",
            "4050eb5088365906",
            "4050eb5088365906",
            "dcad2862e413ef4f",
            "dcad2862e413ef4f",
            "dcad2862e413ef4f",
            "dcad2862e413ef4f"
          ],
          "title": "Data Flow Control"
        },
        {
          "id": "section-4.2",
          "lines": [
            "   Implementations decide when and how much credit to advertise in",
            "   MAX_STREAM_DATA and MAX_DATA frames, but this section offers a few",
            "   considerations.",
            "",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "05ccca8b42d82220",
                  "011426e106b5440c"
                ],
                "status_id": 16,
                "text": "To avoid blocking a sender, a receiver MAY send a MAX_STREAM_DATA or"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "05ccca8b42d82220",
                  "011426e106b5440c"
                ],
                "status_id": 16,
                "text": "MAX_DATA frame multiple times within a round trip or send it early"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "05ccca8b42d82220",
                  "011426e106b5440c"
                ],
                "status_id": 16,
                "text": "enough to allow time for loss of the frame and subsequent recovery."
              }
            ],
            "",
            "   Control frames contribute to connection overhead.  Therefore,",
            "   frequently sending MAX_STREAM_DATA and MAX_DATA frames with small",
            "   changes is undesirable.  On the other hand, if updates are less",
            "   frequent, larger increments to limits are necessary to avoid blocking",
            "   a sender, requiring larger resource commitments at the receiver.",
            "   There is a trade-off between resource commitment and overhead when",
            "   determining how large a limit is advertised.",
            "",
            "   A receiver can use an autotuning mechanism to tune the frequency and",
            "   amount of advertised additional credit based on a round-trip time",
            "   estimate and the rate at which the receiving application consumes",
            "   data, similar to common TCP implementations.  As an optimization, an",
            "   endpoint could send frames related to flow control only when there",
            "   are other frames to send, ensuring that flow control does not cause",
            "   extra packets to be sent.",
            "",
            "   A blocked sender is not required to send STREAM_DATA_BLOCKED or",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   DATA_BLOCKED frames.  "
              },
              {
                "annotation_ids": [
                  "5dd8415ed22c4f79",
                  "6d19c2e47eea218d"
                ],
                "status_id": 13,
                "text": "Therefore, a receiver MUST NOT wait for a"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "5dd8415ed22c4f79",
                  "6d19c2e47eea218d"
                ],
                "status_id": 13,
                "text": "STREAM_DATA_BLOCKED or DATA_BLOCKED frame before sending a"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "5dd8415ed22c4f79",
                  "6d19c2e47eea218d"
                ],
                "status_id": 13,
                "text": "MAX_STREAM_DATA or MAX_DATA frame; doing so could result in the"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "5dd8415ed22c4f79",
                  "6d19c2e47eea218d"
                ],
                "status_id": 13,
                "text": "sender being blocked for the rest of the connection."
              },
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "  Even if the"
              }
            ],
            "   sender sends these frames, waiting for them will result in the sender",
            "   being blocked for at least an entire round trip.",
            "",
            "   When a sender receives credit after being blocked, it might be able",
            "   to send a large amount of data in response, resulting in short-term",
            "   congestion; see Section 7.7 of [QUIC-RECOVERY] for a discussion of",
            "   how a sender can avoid this congestion."
          ],
          "requirements": [
            "011426e106b5440c",
            "011426e106b5440c",
            "011426e106b5440c",
            "6d19c2e47eea218d",
            "6d19c2e47eea218d",
            "6d19c2e47eea218d",
            "6d19c2e47eea218d"
          ],
          "title": "Increasing Flow Control Limits"
        },
        {
          "id": "section-4.3",
          "lines": [
            "   If an endpoint cannot ensure that its peer always has available flow",
            "   control credit that is greater than the peer's bandwidth-delay",
            "   product on this connection, its receive throughput will be limited by",
            "   flow control.",
            "",
            "   Packet loss can cause gaps in the receive buffer, preventing the",
            "   application from consuming data and freeing up receive buffer space.",
            "",
            "   Sending timely updates of flow control limits can improve",
            "   performance.  Sending packets only to provide flow control updates",
            "   can increase network load and adversely affect performance.  Sending",
            "   flow control updates along with other frames, such as ACK frames,",
            "   reduces the cost of those updates."
          ],
          "title": "Flow Control Performance"
        },
        {
          "id": "section-4.4",
          "lines": [
            "   Endpoints need to eventually agree on the amount of flow control",
            "   credit that has been consumed on every stream, to be able to account",
            "   for all bytes for connection-level flow control.",
            "",
            "   On receipt of a RESET_STREAM frame, an endpoint will tear down state",
            "   for the matching stream and ignore further data arriving on that",
            "   stream.",
            "",
            "   RESET_STREAM terminates one direction of a stream abruptly.  For a",
            "   bidirectional stream, RESET_STREAM has no effect on data flow in the",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   opposite direction.  "
              },
              {
                "annotation_ids": [
                  "08439cf0c6a97b70",
                  "4a6ee3b14d7ff726"
                ],
                "status_id": 13,
                "text": "Both endpoints MUST maintain flow control state"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "08439cf0c6a97b70",
                  "4a6ee3b14d7ff726"
                ],
                "status_id": 13,
                "text": "for the stream in the unterminated direction until that direction"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "08439cf0c6a97b70",
                  "4a6ee3b14d7ff726"
                ],
                "status_id": 13,
                "text": "enters a terminal state."
              }
            ]
          ],
          "requirements": [
            "4a6ee3b14d7ff726",
            "4a6ee3b14d7ff726",
            "4a6ee3b14d7ff726"
          ],
          "title": "Handling Stream Cancellation"
        },
        {
          "id": "section-4.5",
          "lines": [
            "   The final size is the amount of flow control credit that is consumed",
            "   by a stream.  Assuming that every contiguous byte on the stream was",
            "   sent once, the final size is the number of bytes sent.  More",
            "   generally, this is one higher than the offset of the byte with the",
            "   largest offset sent on the stream, or zero if no bytes were sent.",
            "",
            "   A sender always communicates the final size of a stream to the",
            "   receiver reliably, no matter how the stream is terminated.  The final",
            "   size is the sum of the Offset and Length fields of a STREAM frame",
            "   with a FIN flag, noting that these fields might be implicit.",
            "   Alternatively, the Final Size field of a RESET_STREAM frame carries",
            "   this value.  This guarantees that both endpoints agree on how much",
            "   flow control credit was consumed by the sender on that stream.",
            "",
            "   An endpoint will know the final size for a stream when the receiving",
            "   part of the stream enters the \"Size Known\" or \"Reset Recvd\" state",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   (Section 3).  "
              },
              {
                "annotation_ids": [
                  "f28f9b9871bd6f4e",
                  "edb1ef634f0f23f1"
                ],
                "status_id": 13,
                "text": "The receiver MUST use the final size of the stream to"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "f28f9b9871bd6f4e",
                  "edb1ef634f0f23f1"
                ],
                "status_id": 13,
                "text": "account for all bytes sent on the stream in its connection-level flow"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "f28f9b9871bd6f4e",
                  "edb1ef634f0f23f1"
                ],
                "status_id": 13,
                "text": "controller."
              }
            ],
            "",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "d8f3a28f908b2f81",
                  "d7efc72d52171ea2"
                ],
                "status_id": 13,
                "text": "An endpoint MUST NOT send data on a stream at or beyond the final"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "d8f3a28f908b2f81",
                  "d7efc72d52171ea2"
                ],
                "status_id": 13,
                "text": "size."
              }
            ],
            "",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "2bf3276319a34934",
                  "fdd7c09bd2d8841c",
                  "c11dcc7d907f992b"
                ],
                "status_id": 1,
                "text": "Once a final size for a stream is known, it cannot change.  "
              },
              {
                "annotation_ids": [
                  "2bf3276319a34934",
                  "fdd7c09bd2d8841c",
                  "c11dcc7d907f992b",
                  "c221797d6218ff2e"
                ],
                "status_id": 22,
                "text": "If a"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "2bf3276319a34934",
                  "fdd7c09bd2d8841c",
                  "c11dcc7d907f992b",
                  "c221797d6218ff2e"
                ],
                "status_id": 22,
                "text": "RESET_STREAM or STREAM frame is received indicating a change in the"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "2bf3276319a34934",
                  "fdd7c09bd2d8841c",
                  "c11dcc7d907f992b",
                  "c221797d6218ff2e"
                ],
                "status_id": 22,
                "text": "final size for the stream, an endpoint SHOULD respond with an error"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "2bf3276319a34934",
                  "fdd7c09bd2d8841c",
                  "c11dcc7d907f992b",
                  "c221797d6218ff2e"
                ],
                "status_id": 22,
                "text": "of type FINAL_SIZE_ERROR; see Section 11 for details on error"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "2bf3276319a34934",
                  "fdd7c09bd2d8841c",
                  "c11dcc7d907f992b",
                  "c221797d6218ff2e"
                ],
                "status_id": 22,
                "text": "handling."
              },
              {
                "annotation_ids": [
                  "c11dcc7d907f992b"
                ],
                "status_id": 1,
                "text": "  "
              },
              {
                "annotation_ids": [
                  "c11dcc7d907f992b",
                  "ec413ad2fe1a80ef"
                ],
                "status_id": 22,
                "text": "A receiver SHOULD treat receipt of data at or beyond the"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "c11dcc7d907f992b",
                  "ec413ad2fe1a80ef"
                ],
                "status_id": 22,
                "text": "final size as an error of type FINAL_SIZE_ERROR, even after a stream"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "c11dcc7d907f992b",
                  "ec413ad2fe1a80ef"
                ],
                "status_id": 22,
                "text": "is closed."
              },
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "  Generating these errors is not mandatory, because"
              }
            ],
            "   requiring that an endpoint generate these errors also means that the",
            "   endpoint needs to maintain the final size state for closed streams,",
            "   which could mean a significant state commitment."
          ],
          "requirements": [
            "edb1ef634f0f23f1",
            "edb1ef634f0f23f1",
            "edb1ef634f0f23f1",
            "d7efc72d52171ea2",
            "d7efc72d52171ea2",
            "c221797d6218ff2e",
            "c221797d6218ff2e",
            "c221797d6218ff2e",
            "c221797d6218ff2e",
            "c221797d6218ff2e",
            "ec413ad2fe1a80ef",
            "ec413ad2fe1a80ef",
            "ec413ad2fe1a80ef"
          ],
          "title": "Stream Final Size"
        },
        {
          "id": "section-4.6",
          "lines": [
            "   An endpoint limits the cumulative number of incoming streams a peer",
            "   can open.  Only streams with a stream ID less than \"(max_streams * 4",
            "   + first_stream_id_of_type)\" can be opened; see Table 1.  Initial",
            "   limits are set in the transport parameters; see Section 18.2.",
            "   Subsequent limits are advertised using MAX_STREAMS frames; see",
            "   Section 19.11.  Separate limits apply to unidirectional and",
            "   bidirectional streams.",
            "",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "610aad010f163229",
                  "8b6c136e87d174d9",
                  "61de797e7927dbc6"
                ],
                "status_id": 1,
                "text": "If a max_streams transport parameter or a MAX_STREAMS frame is"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "610aad010f163229",
                  "8b6c136e87d174d9",
                  "61de797e7927dbc6"
                ],
                "status_id": 1,
                "text": "received with a value greater than 2^60, this would allow a maximum"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "610aad010f163229",
                  "8b6c136e87d174d9",
                  "61de797e7927dbc6"
                ],
                "status_id": 1,
                "text": "stream ID that cannot be expressed as a variable-length integer; see"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "610aad010f163229",
                  "8b6c136e87d174d9",
                  "61de797e7927dbc6"
                ],
                "status_id": 1,
                "text": "Section 16.  "
              },
              {
                "annotation_ids": [
                  "610aad010f163229",
                  "8b6c136e87d174d9",
                  "61de797e7927dbc6",
                  "4ce3523ca69e5eff"
                ],
                "status_id": 13,
                "text": "If either is received, the connection MUST be closed"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "610aad010f163229",
                  "8b6c136e87d174d9",
                  "61de797e7927dbc6",
                  "4ce3523ca69e5eff"
                ],
                "status_id": 13,
                "text": "immediately with a connection error of type TRANSPORT_PARAMETER_ERROR"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "610aad010f163229",
                  "8b6c136e87d174d9",
                  "61de797e7927dbc6",
                  "4ce3523ca69e5eff"
                ],
                "status_id": 13,
                "text": "if the offending value was received in a transport parameter or of"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "610aad010f163229",
                  "8b6c136e87d174d9",
                  "61de797e7927dbc6",
                  "4ce3523ca69e5eff"
                ],
                "status_id": 13,
                "text": "type FRAME_ENCODING_ERROR if it was received in a frame; see"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "610aad010f163229",
                  "8b6c136e87d174d9",
                  "61de797e7927dbc6",
                  "4ce3523ca69e5eff"
                ],
                "status_id": 13,
                "text": "Section 10.2."
              }
            ],
            "",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "5a6605a74b5f3e91",
                  "992a0d6f0b700532",
                  "276ee6001aac3dfa",
                  "fcf525b91bfa9cf7",
                  "a308be0bbc7f31d0"
                ],
                "status_id": 9,
                "text": "Endpoints MUST NOT exceed the limit set by their peer."
              },
              {
                "annotation_ids": [
                  "5a6605a74b5f3e91",
                  "276ee6001aac3dfa"
                ],
                "status_id": 1,
                "text": "  "
              },
              {
                "annotation_ids": [
                  "5a6605a74b5f3e91",
                  "c66bdb7debb0b6df",
                  "276ee6001aac3dfa",
                  "2cfa7e13fb1b98b9"
                ],
                "status_id": 9,
                "text": "An endpoint"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "5a6605a74b5f3e91",
                  "c66bdb7debb0b6df",
                  "276ee6001aac3dfa",
                  "2cfa7e13fb1b98b9"
                ],
                "status_id": 9,
                "text": "that receives a frame with a stream ID exceeding the limit it has"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "5a6605a74b5f3e91",
                  "c66bdb7debb0b6df",
                  "276ee6001aac3dfa",
                  "2cfa7e13fb1b98b9"
                ],
                "status_id": 9,
                "text": "sent MUST treat this as a connection error of type"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "5a6605a74b5f3e91",
                  "c66bdb7debb0b6df",
                  "276ee6001aac3dfa",
                  "2cfa7e13fb1b98b9"
                ],
                "status_id": 9,
                "text": "STREAM_LIMIT_ERROR; see Section 11 for details on error handling."
              }
            ],
            "",
            "   Once a receiver advertises a stream limit using the MAX_STREAMS",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   frame, advertising a smaller limit has no effect.  "
              },
              {
                "annotation_ids": [
                  "3407ab21f14b990b",
                  "e151665a6c720d45",
                  "7e88f1d8de2e54f7"
                ],
                "status_id": 9,
                "text": "MAX_STREAMS frames"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "3407ab21f14b990b",
                  "e151665a6c720d45",
                  "7e88f1d8de2e54f7"
                ],
                "status_id": 9,
                "text": "that do not increase the stream limit MUST be ignored."
              }
            ],
            "",
            "   As with stream and connection flow control, this document leaves",
            "   implementations to decide when and how many streams should be",
            "   advertised to a peer via MAX_STREAMS.  Implementations might choose",
            "   to increase limits as streams are closed, to keep the number of",
            "   streams available to peers roughly consistent.",
            "",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "e93b258033f0a8ff",
                  "38285c62feaceec4",
                  "4c40ba00125d32b8"
                ],
                "status_id": 8,
                "text": "An endpoint that is unable to open a new stream due to the peer's"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "e93b258033f0a8ff",
                  "38285c62feaceec4",
                  "4c40ba00125d32b8"
                ],
                "status_id": 8,
                "text": "limits SHOULD send a STREAMS_BLOCKED frame (Section 19.14)."
              },
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "  This"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   signal is considered useful for debugging.  "
              },
              {
                "annotation_ids": [
                  "79f3f088264fd8c0",
                  "57c65144b98bfb9f",
                  "2a734467a0b996a6"
                ],
                "status_id": 9,
                "text": "An endpoint MUST NOT wait"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "79f3f088264fd8c0",
                  "57c65144b98bfb9f",
                  "2a734467a0b996a6"
                ],
                "status_id": 9,
                "text": "to receive this signal before advertising additional credit, since"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "79f3f088264fd8c0",
                  "57c65144b98bfb9f",
                  "2a734467a0b996a6"
                ],
                "status_id": 9,
                "text": "doing so will mean that the peer will be blocked for at least an"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "79f3f088264fd8c0",
                  "57c65144b98bfb9f",
                  "2a734467a0b996a6"
                ],
                "status_id": 9,
                "text": "entire round trip"
              },
              {
                "annotation_ids": [
                  "2a734467a0b996a6"
                ],
                "status_id": 20,
                "text": ", and potentially indefinitely if the peer chooses"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "2a734467a0b996a6"
                ],
                "status_id": 20,
                "text": "not to send STREAMS_BLOCKED frames."
              }
            ]
          ],
          "requirements": [
            "4ce3523ca69e5eff",
            "4ce3523ca69e5eff",
            "4ce3523ca69e5eff",
            "4ce3523ca69e5eff",
            "4ce3523ca69e5eff",
            "a308be0bbc7f31d0",
            "2cfa7e13fb1b98b9",
            "2cfa7e13fb1b98b9",
            "2cfa7e13fb1b98b9",
            "2cfa7e13fb1b98b9",
            "7e88f1d8de2e54f7",
            "7e88f1d8de2e54f7",
            "4c40ba00125d32b8",
            "4c40ba00125d32b8",
            "2a734467a0b996a6",
            "2a734467a0b996a6",
            "2a734467a0b996a6",
            "2a734467a0b996a6",
            "2a734467a0b996a6"
          ],
          "title": "Controlling Concurrency"
        },
        {
          "id": "section-5",
          "lines": [
            "   A QUIC connection is shared state between a client and a server.",
            "",
            "   Each connection starts with a handshake phase, during which the two",
            "   endpoints establish a shared secret using the cryptographic handshake",
            "   protocol [QUIC-TLS] and negotiate the application protocol.  The",
            "   handshake (Section 7) confirms that both endpoints are willing to",
            "   communicate (Section 8.1) and establishes parameters for the",
            "   connection (Section 7.4).",
            "",
            "   An application protocol can use the connection during the handshake",
            "   phase with some limitations.  0-RTT allows application data to be",
            "   sent by a client before receiving a response from the server.",
            "   However, 0-RTT provides no protection against replay attacks; see",
            "   Section 9.2 of [QUIC-TLS].  A server can also send application data",
            "   to a client before it receives the final cryptographic handshake",
            "   messages that allow it to confirm the identity and liveness of the",
            "   client.  These capabilities allow an application protocol to offer",
            "   the option of trading some security guarantees for reduced latency.",
            "",
            "   The use of connection IDs (Section 5.1) allows connections to migrate",
            "   to a new network path, both as a direct choice of an endpoint and",
            "   when forced by a change in a middlebox.  Section 9 describes",
            "   mitigations for the security and privacy issues associated with",
            "   migration.",
            "",
            "   For connections that are no longer needed or desired, there are",
            "   several ways for a client and server to terminate a connection, as",
            "   described in Section 10."
          ],
          "title": "Connections"
        },
        {
          "id": "section-5.1",
          "lines": [
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "3f3d33fb19323674"
                ],
                "status_id": 1,
                "text": "Each connection possesses a set of connection identifiers, or"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "3f3d33fb19323674"
                ],
                "status_id": 1,
                "text": "connection IDs, each of which can identify the connection."
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "3f3d33fb19323674"
                ],
                "status_id": 1,
                "text": "Connection IDs are independently selected by endpoints; each endpoint"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "3f3d33fb19323674"
                ],
                "status_id": 1,
                "text": "selects the connection IDs that its peer uses."
              }
            ],
            "",
            "   The primary function of a connection ID is to ensure that changes in",
            "   addressing at lower protocol layers (UDP, IP) do not cause packets",
            "   for a QUIC connection to be delivered to the wrong endpoint.  Each",
            "   endpoint selects connection IDs using an implementation-specific (and",
            "   perhaps deployment-specific) method that will allow packets with that",
            "   connection ID to be routed back to the endpoint and to be identified",
            "   by the endpoint upon receipt.",
            "",
            "   Multiple connection IDs are used so that endpoints can send packets",
            "   that cannot be identified by an observer as being for the same",
            "   connection without cooperation from an endpoint; see Section 9.5.",
            "",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "358ba3db0d1b42bc",
                  "66442f51d27db163"
                ],
                "status_id": 12,
                "text": "Connection IDs MUST NOT contain any information that can be used by"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "358ba3db0d1b42bc",
                  "66442f51d27db163"
                ],
                "status_id": 12,
                "text": "an external observer (that is, one that does not cooperate with the"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "358ba3db0d1b42bc",
                  "66442f51d27db163"
                ],
                "status_id": 12,
                "text": "issuer) to correlate them with other connection IDs for the same"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "358ba3db0d1b42bc",
                  "66442f51d27db163"
                ],
                "status_id": 12,
                "text": "connection."
              },
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "  "
              },
              {
                "annotation_ids": [
                  "07085cfa119ac10d",
                  "1a9c49243cf4d64d",
                  "70e97e7add68f081"
                ],
                "status_id": 9,
                "text": "As a trivial example, this means the same connection ID"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "07085cfa119ac10d",
                  "1a9c49243cf4d64d",
                  "70e97e7add68f081"
                ],
                "status_id": 9,
                "text": "MUST NOT be issued more than once on the same connection."
              }
            ],
            "",
            "   Packets with long headers include Source Connection ID and",
            "   Destination Connection ID fields.  These fields are used to set the",
            "   connection IDs for new connections; see Section 7.2 for details.",
            "",
            "   Packets with short headers (Section 17.3) only include the",
            "   Destination Connection ID and omit the explicit length.  The length",
            "   of the Destination Connection ID field is expected to be known to",
            "   endpoints.  Endpoints using a load balancer that routes based on",
            "   connection ID could agree with the load balancer on a fixed length",
            "   for connection IDs or agree on an encoding scheme.  A fixed portion",
            "   could encode an explicit length, which allows the entire connection",
            "   ID to vary in length and still be used by the load balancer.",
            "",
            "   A Version Negotiation (Section 17.2.1) packet echoes the connection",
            "   IDs selected by the client, both to ensure correct routing toward the",
            "   client and to demonstrate that the packet is in response to a packet",
            "   sent by the client.",
            "",
            "   A zero-length connection ID can be used when a connection ID is not",
            "   needed to route to the correct endpoint.  However, multiplexing",
            "   connections on the same local IP address and port while using zero-",
            "   length connection IDs will cause failures in the presence of peer",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   connection migration, NAT rebinding, and client port reuse.  "
              },
              {
                "annotation_ids": [
                  "3059124a8788357c",
                  "11241d5ca4b36c1e"
                ],
                "status_id": 12,
                "text": "An"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "3059124a8788357c",
                  "11241d5ca4b36c1e"
                ],
                "status_id": 12,
                "text": "endpoint MUST NOT use the same IP address and port for multiple"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "3059124a8788357c",
                  "11241d5ca4b36c1e"
                ],
                "status_id": 12,
                "text": "concurrent connections with zero-length connection IDs, unless it is"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "3059124a8788357c",
                  "11241d5ca4b36c1e"
                ],
                "status_id": 12,
                "text": "certain that those protocol features are not in use."
              }
            ],
            "",
            "   When an endpoint uses a non-zero-length connection ID, it needs to",
            "   ensure that the peer has a supply of connection IDs from which to",
            "   choose for packets sent to the endpoint.  These connection IDs are",
            "   supplied by the endpoint using the NEW_CONNECTION_ID frame",
            "   (Section 19.15)."
          ],
          "requirements": [
            "66442f51d27db163",
            "66442f51d27db163",
            "66442f51d27db163",
            "66442f51d27db163",
            "70e97e7add68f081",
            "70e97e7add68f081",
            "11241d5ca4b36c1e",
            "11241d5ca4b36c1e",
            "11241d5ca4b36c1e",
            "11241d5ca4b36c1e"
          ],
          "title": "Connection ID"
        },
        {
          "id": "section-5.1.1",
          "lines": [
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "aeff65c18a218201",
                  "f4b906cea5178a09"
                ],
                "status_id": 1,
                "text": "Each connection ID has an associated sequence number to assist in"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "aeff65c18a218201",
                  "f4b906cea5178a09"
                ],
                "status_id": 1,
                "text": "detecting when NEW_CONNECTION_ID or RETIRE_CONNECTION_ID frames refer"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "aeff65c18a218201",
                  "f4b906cea5178a09"
                ],
                "status_id": 1,
                "text": "to the same value."
              },
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "  The initial connection ID issued by an endpoint"
              }
            ],
            "   is sent in the Source Connection ID field of the long packet header",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   (Section 17.2) during the handshake.  "
              },
              {
                "annotation_ids": [
                  "84d338000469cc68",
                  "0a5fc9c0a09f4022",
                  "b6987807d6441a26"
                ],
                "status_id": 1,
                "text": "The sequence number of the"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "84d338000469cc68",
                  "0a5fc9c0a09f4022",
                  "b6987807d6441a26"
                ],
                "status_id": 1,
                "text": "initial connection ID is 0."
              },
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "  If the preferred_address transport"
              }
            ],
            "   parameter is sent, the sequence number of the supplied connection ID",
            "   is 1.",
            "",
            "   Additional connection IDs are communicated to the peer using",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   NEW_CONNECTION_ID frames (Section 19.15).  "
              },
              {
                "annotation_ids": [
                  "cd7939cd7111da92",
                  "0897e9f8327c0fcc",
                  "e4ca95f625cac82c"
                ],
                "status_id": 9,
                "text": "The sequence number on"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "cd7939cd7111da92",
                  "0897e9f8327c0fcc",
                  "e4ca95f625cac82c"
                ],
                "status_id": 9,
                "text": "each newly issued connection ID MUST increase by 1."
              },
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "  The connection"
              }
            ],
            "   ID that a client selects for the first Destination Connection ID",
            "   field it sends and any connection ID provided by a Retry packet are",
            "   not assigned sequence numbers.",
            "",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "d9bd3405663ee929",
                  "2316958eebeca8fb",
                  "c504d86a23d81914"
                ],
                "status_id": 9,
                "text": "When an endpoint issues a connection ID, it MUST accept packets that"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "d9bd3405663ee929",
                  "2316958eebeca8fb",
                  "c504d86a23d81914"
                ],
                "status_id": 9,
                "text": "carry this connection ID for the duration of the connection or until"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "d9bd3405663ee929",
                  "2316958eebeca8fb",
                  "c504d86a23d81914"
                ],
                "status_id": 9,
                "text": "its peer invalidates the connection ID via a RETIRE_CONNECTION_ID"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "d9bd3405663ee929",
                  "2316958eebeca8fb",
                  "c504d86a23d81914"
                ],
                "status_id": 9,
                "text": "frame (Section 19.16)."
              },
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "  Connection IDs that are issued and not"
              }
            ],
            "   retired are considered active; any active connection ID is valid for",
            "   use with the current connection at any time, in any packet type.",
            "   This includes the connection ID issued by the server via the",
            "   preferred_address transport parameter.",
            "",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "dbe5be269ef8738d",
                  "cb6e5238aeda2dba",
                  "dfb766af79decaea"
                ],
                "status_id": 8,
                "text": "An endpoint SHOULD ensure that its peer has a sufficient number of"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "dbe5be269ef8738d",
                  "cb6e5238aeda2dba",
                  "dfb766af79decaea"
                ],
                "status_id": 8,
                "text": "available and unused connection IDs."
              },
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "  Endpoints advertise the number"
              }
            ],
            "   of active connection IDs they are willing to maintain using the",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   active_connection_id_limit transport parameter.  "
              },
              {
                "annotation_ids": [
                  "dbba1a6a97af78dc",
                  "41a738bf319b94ae",
                  "0b305f4db3933c4e"
                ],
                "status_id": 9,
                "text": "An endpoint MUST NOT"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "dbba1a6a97af78dc",
                  "41a738bf319b94ae",
                  "0b305f4db3933c4e"
                ],
                "status_id": 9,
                "text": "provide more connection IDs than the peer's limit."
              },
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "  "
              },
              {
                "annotation_ids": [
                  "c24fe07bcc4978ae",
                  "2b1734814c09837c",
                  "df49567fea85ac24",
                  "6d1e2574cbc0a3cd"
                ],
                "status_id": 11,
                "text": "An endpoint MAY"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "c24fe07bcc4978ae",
                  "2b1734814c09837c",
                  "df49567fea85ac24",
                  "6d1e2574cbc0a3cd"
                ],
                "status_id": 11,
                "text": "send connection IDs that temporarily exceed a peer's limit if the"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "c24fe07bcc4978ae",
                  "2b1734814c09837c",
                  "df49567fea85ac24",
                  "6d1e2574cbc0a3cd"
                ],
                "status_id": 11,
                "text": "NEW_CONNECTION_ID frame also requires the retirement of any excess,"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "c24fe07bcc4978ae",
                  "2b1734814c09837c",
                  "df49567fea85ac24",
                  "6d1e2574cbc0a3cd"
                ],
                "status_id": 11,
                "text": "by including a sufficiently large value in the Retire Prior To field."
              }
            ],
            "",
            "   A NEW_CONNECTION_ID frame might cause an endpoint to add some active",
            "   connection IDs and retire others based on the value of the Retire",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   Prior To field.  "
              },
              {
                "annotation_ids": [
                  "3ae64419e54cac85",
                  "4aafd39bc8fccf57",
                  "92b026cc417f75cc",
                  "00c902e8cb986195",
                  "7cd217d509209af0"
                ],
                "status_id": 9,
                "text": "After processing a NEW_CONNECTION_ID frame and"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "3ae64419e54cac85",
                  "4aafd39bc8fccf57",
                  "92b026cc417f75cc",
                  "00c902e8cb986195",
                  "7cd217d509209af0"
                ],
                "status_id": 9,
                "text": "adding and retiring active connection IDs, if the number of active"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "3ae64419e54cac85",
                  "4aafd39bc8fccf57",
                  "92b026cc417f75cc",
                  "00c902e8cb986195",
                  "7cd217d509209af0"
                ],
                "status_id": 9,
                "text": "connection IDs exceeds the value advertised in its"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "3ae64419e54cac85",
                  "4aafd39bc8fccf57",
                  "92b026cc417f75cc",
                  "00c902e8cb986195",
                  "7cd217d509209af0"
                ],
                "status_id": 9,
                "text": "active_connection_id_limit transport parameter, an endpoint MUST"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "3ae64419e54cac85",
                  "4aafd39bc8fccf57",
                  "92b026cc417f75cc",
                  "00c902e8cb986195",
                  "7cd217d509209af0"
                ],
                "status_id": 9,
                "text": "close the connection with an error of type CONNECTION_ID_LIMIT_ERROR."
              }
            ],
            "",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "82ecef3831ac2a2b",
                  "ff4d340ca7ab2552",
                  "7ba1664bf8584203"
                ],
                "status_id": 8,
                "text": "An endpoint SHOULD supply a new connection ID when the peer retires a"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "82ecef3831ac2a2b",
                  "ff4d340ca7ab2552",
                  "7ba1664bf8584203"
                ],
                "status_id": 8,
                "text": "connection ID."
              },
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "  "
              },
              {
                "annotation_ids": [
                  "eb58bcf8296f30d1",
                  "f5e55d24cd90cbeb"
                ],
                "status_id": 15,
                "text": "If an endpoint provided fewer connection IDs than the"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "eb58bcf8296f30d1",
                  "f5e55d24cd90cbeb"
                ],
                "status_id": 15,
                "text": "peer's active_connection_id_limit, it MAY supply a new connection ID"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "eb58bcf8296f30d1",
                  "f5e55d24cd90cbeb"
                ],
                "status_id": 15,
                "text": "when it receives a packet with a previously unused connection ID."
              },
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "  "
              },
              {
                "annotation_ids": [
                  "dba7e21daadccf13",
                  "186192f920dba4fe"
                ],
                "status_id": 15,
                "text": "An"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "dba7e21daadccf13",
                  "186192f920dba4fe"
                ],
                "status_id": 15,
                "text": "endpoint MAY limit the total number of connection IDs issued for each"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "dba7e21daadccf13",
                  "186192f920dba4fe"
                ],
                "status_id": 15,
                "text": "connection to avoid the risk of running out of connection IDs; see"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "dba7e21daadccf13",
                  "186192f920dba4fe"
                ],
                "status_id": 15,
                "text": "Section 10.3.2."
              },
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "  "
              },
              {
                "annotation_ids": [
                  "6d52f6c28b4d9ed3",
                  "12a867b1d94a0d36",
                  "b2f5e6001acbd51a"
                ],
                "status_id": 11,
                "text": "An endpoint MAY also limit the issuance of"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "6d52f6c28b4d9ed3",
                  "12a867b1d94a0d36",
                  "b2f5e6001acbd51a"
                ],
                "status_id": 11,
                "text": "connection IDs to reduce the amount of per-path state it maintains,"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "6d52f6c28b4d9ed3",
                  "12a867b1d94a0d36",
                  "b2f5e6001acbd51a"
                ],
                "status_id": 11,
                "text": "such as path validation status, as its peer might interact with it"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "6d52f6c28b4d9ed3",
                  "12a867b1d94a0d36",
                  "b2f5e6001acbd51a"
                ],
                "status_id": 11,
                "text": "over as many paths as there are issued connection IDs."
              }
            ],
            "",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "6fe0222326c3960c",
                  "2ef6ac9b313c645b",
                  "8f29adec6f95432a"
                ],
                "status_id": 8,
                "text": "An endpoint that initiates migration and requires non-zero-length"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "6fe0222326c3960c",
                  "2ef6ac9b313c645b",
                  "8f29adec6f95432a"
                ],
                "status_id": 8,
                "text": "connection IDs SHOULD ensure that the pool of connection IDs"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "6fe0222326c3960c",
                  "2ef6ac9b313c645b",
                  "8f29adec6f95432a"
                ],
                "status_id": 8,
                "text": "available to its peer allows the peer to use a new connection ID on"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "6fe0222326c3960c",
                  "2ef6ac9b313c645b",
                  "8f29adec6f95432a"
                ],
                "status_id": 8,
                "text": "migration, as the peer will be unable to respond if the pool is"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "6fe0222326c3960c",
                  "2ef6ac9b313c645b",
                  "8f29adec6f95432a"
                ],
                "status_id": 8,
                "text": "exhausted."
              }
            ],
            "",
            "   An endpoint that selects a zero-length connection ID during the",
            "   handshake cannot issue a new connection ID.  A zero-length",
            "   Destination Connection ID field is used in all packets sent toward",
            "   such an endpoint over any network path."
          ],
          "requirements": [
            "e4ca95f625cac82c",
            "e4ca95f625cac82c",
            "c504d86a23d81914",
            "c504d86a23d81914",
            "c504d86a23d81914",
            "c504d86a23d81914",
            "dfb766af79decaea",
            "dfb766af79decaea",
            "0b305f4db3933c4e",
            "0b305f4db3933c4e",
            "6d1e2574cbc0a3cd",
            "6d1e2574cbc0a3cd",
            "6d1e2574cbc0a3cd",
            "6d1e2574cbc0a3cd",
            "7cd217d509209af0",
            "7cd217d509209af0",
            "7cd217d509209af0",
            "7cd217d509209af0",
            "7cd217d509209af0",
            "7ba1664bf8584203",
            "7ba1664bf8584203",
            "f5e55d24cd90cbeb",
            "f5e55d24cd90cbeb",
            "f5e55d24cd90cbeb",
            "186192f920dba4fe",
            "186192f920dba4fe",
            "186192f920dba4fe",
            "186192f920dba4fe",
            "b2f5e6001acbd51a",
            "b2f5e6001acbd51a",
            "b2f5e6001acbd51a",
            "b2f5e6001acbd51a",
            "8f29adec6f95432a",
            "8f29adec6f95432a",
            "8f29adec6f95432a",
            "8f29adec6f95432a",
            "8f29adec6f95432a"
          ],
          "title": "Issuing Connection IDs"
        },
        {
          "id": "section-5.1.2",
          "lines": [
            "   An endpoint can change the connection ID it uses for a peer to",
            "   another available one at any time during the connection.  An endpoint",
            "   consumes connection IDs in response to a migrating peer; see",
            "   Section 9.5 for more details.",
            "",
            "   An endpoint maintains a set of connection IDs received from its peer,",
            "   any of which it can use when sending packets.  When the endpoint",
            "   wishes to remove a connection ID from use, it sends a",
            "   RETIRE_CONNECTION_ID frame to its peer.  Sending a",
            "   RETIRE_CONNECTION_ID frame indicates that the connection ID will not",
            "   be used again and requests that the peer replace it with a new",
            "   connection ID using a NEW_CONNECTION_ID frame.",
            "",
            "   As discussed in Section 9.5, endpoints limit the use of a connection",
            "   ID to packets sent from a single local address to a single",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   destination address.  "
              },
              {
                "annotation_ids": [
                  "5035b13e3b5d4a0b",
                  "b560b90634e051a0"
                ],
                "status_id": 18,
                "text": "Endpoints SHOULD retire connection IDs when"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "5035b13e3b5d4a0b",
                  "b560b90634e051a0"
                ],
                "status_id": 18,
                "text": "they are no longer actively using either the local or destination"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "5035b13e3b5d4a0b",
                  "b560b90634e051a0"
                ],
                "status_id": 18,
                "text": "address for which the connection ID was used."
              }
            ],
            "",
            "   An endpoint might need to stop accepting previously issued connection",
            "   IDs in certain circumstances.  Such an endpoint can cause its peer to",
            "   retire connection IDs by sending a NEW_CONNECTION_ID frame with an",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   increased Retire Prior To field.  "
              },
              {
                "annotation_ids": [
                  "ecf3e465f6417e06",
                  "b7b53591e3f97fe9",
                  "b3f665a2703b19e7"
                ],
                "status_id": 8,
                "text": "The endpoint SHOULD continue to"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "ecf3e465f6417e06",
                  "b7b53591e3f97fe9",
                  "b3f665a2703b19e7"
                ],
                "status_id": 8,
                "text": "accept the previously issued connection IDs until they are retired by"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "ecf3e465f6417e06",
                  "b7b53591e3f97fe9",
                  "b3f665a2703b19e7"
                ],
                "status_id": 8,
                "text": "the peer."
              },
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "  "
              },
              {
                "annotation_ids": [
                  "c0299440fdad3cb8",
                  "7b1ea521f5f8c992"
                ],
                "status_id": 15,
                "text": "If the endpoint can no longer process the indicated"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "c0299440fdad3cb8",
                  "7b1ea521f5f8c992"
                ],
                "status_id": 15,
                "text": "connection IDs, it MAY close the connection."
              }
            ],
            "",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "65a38ba8b6d77e05",
                  "01e855d7d46672a6",
                  "853259a0df8cb519",
                  "4080e5954ce4d91e",
                  "a3253938be9247f0"
                ],
                "status_id": 9,
                "text": "Upon receipt of an increased Retire Prior To field, the peer MUST"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "65a38ba8b6d77e05",
                  "01e855d7d46672a6",
                  "853259a0df8cb519",
                  "4080e5954ce4d91e",
                  "a3253938be9247f0"
                ],
                "status_id": 9,
                "text": "stop using the corresponding connection IDs and retire them with"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "65a38ba8b6d77e05",
                  "01e855d7d46672a6",
                  "853259a0df8cb519",
                  "4080e5954ce4d91e",
                  "a3253938be9247f0"
                ],
                "status_id": 9,
                "text": "RETIRE_CONNECTION_ID frames before adding the newly provided"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "65a38ba8b6d77e05",
                  "01e855d7d46672a6",
                  "853259a0df8cb519",
                  "4080e5954ce4d91e",
                  "a3253938be9247f0"
                ],
                "status_id": 9,
                "text": "connection ID to the set of active connection IDs."
              },
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "  This ordering"
              }
            ],
            "   allows an endpoint to replace all active connection IDs without the",
            "   possibility of a peer having no available connection IDs and without",
            "   exceeding the limit the peer sets in the active_connection_id_limit",
            "   transport parameter; see Section 18.2.  Failure to cease using the",
            "   connection IDs when requested can result in connection failures, as",
            "   the issuing endpoint might be unable to continue using the connection",
            "   IDs with the active connection.",
            "",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "b83339fe404c0e03",
                  "4846a13fe993a830",
                  "942d5f416807725d"
                ],
                "status_id": 8,
                "text": "An endpoint SHOULD limit the number of connection IDs it has retired"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "b83339fe404c0e03",
                  "4846a13fe993a830",
                  "942d5f416807725d"
                ],
                "status_id": 8,
                "text": "locally for which RETIRE_CONNECTION_ID frames have not yet been"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "b83339fe404c0e03",
                  "4846a13fe993a830",
                  "942d5f416807725d"
                ],
                "status_id": 8,
                "text": "acknowledged."
              },
              {
                "annotation_ids": [
                  "b83339fe404c0e03",
                  "4846a13fe993a830"
                ],
                "status_id": 2,
                "text": "  "
              },
              {
                "annotation_ids": [
                  "b83339fe404c0e03",
                  "5c6e768543175d5c",
                  "4846a13fe993a830",
                  "e4d485ce35b55e7c"
                ],
                "status_id": 8,
                "text": "An endpoint SHOULD allow for sending and tracking a"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "b83339fe404c0e03",
                  "5c6e768543175d5c",
                  "4846a13fe993a830",
                  "e4d485ce35b55e7c"
                ],
                "status_id": 8,
                "text": "number of RETIRE_CONNECTION_ID frames of at least twice the value of"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "b83339fe404c0e03",
                  "5c6e768543175d5c",
                  "4846a13fe993a830",
                  "e4d485ce35b55e7c"
                ],
                "status_id": 8,
                "text": "the active_connection_id_limit transport parameter."
              },
              {
                "annotation_ids": [
                  "b83339fe404c0e03",
                  "4846a13fe993a830"
                ],
                "status_id": 2,
                "text": "  "
              },
              {
                "annotation_ids": [
                  "b83339fe404c0e03",
                  "8061f11d34d8a0c2",
                  "d185b86f4edfe7a4",
                  "2a9dcc05e15d9d1a",
                  "4846a13fe993a830",
                  "62d1491d583221ec"
                ],
                "status_id": 9,
                "text": "An endpoint MUST"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "b83339fe404c0e03",
                  "8061f11d34d8a0c2",
                  "d185b86f4edfe7a4",
                  "2a9dcc05e15d9d1a",
                  "4846a13fe993a830",
                  "62d1491d583221ec"
                ],
                "status_id": 9,
                "text": "NOT forget a connection ID without retiring it"
              },
              {
                "annotation_ids": [
                  "b83339fe404c0e03",
                  "8061f11d34d8a0c2",
                  "d185b86f4edfe7a4",
                  "4846a13fe993a830",
                  "62d1491d583221ec"
                ],
                "status_id": 9,
                "text": ", though it MAY choose"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "b83339fe404c0e03",
                  "8061f11d34d8a0c2",
                  "d185b86f4edfe7a4",
                  "4846a13fe993a830",
                  "62d1491d583221ec"
                ],
                "status_id": 9,
                "text": "to treat having connection IDs in need of retirement that exceed this"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "b83339fe404c0e03",
                  "8061f11d34d8a0c2",
                  "d185b86f4edfe7a4",
                  "4846a13fe993a830",
                  "62d1491d583221ec"
                ],
                "status_id": 9,
                "text": "limit as a connection error of type CONNECTION_ID_LIMIT_ERROR."
              }
            ],
            "",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "98197adce689fc8d",
                  "70e6a9456cb8df96"
                ],
                "status_id": 18,
                "text": "Endpoints SHOULD NOT issue updates of the Retire Prior To field"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "98197adce689fc8d",
                  "70e6a9456cb8df96"
                ],
                "status_id": 18,
                "text": "before receiving RETIRE_CONNECTION_ID frames that retire all"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "98197adce689fc8d",
                  "70e6a9456cb8df96"
                ],
                "status_id": 18,
                "text": "connection IDs indicated by the previous Retire Prior To value."
              }
            ]
          ],
          "requirements": [
            "b560b90634e051a0",
            "b560b90634e051a0",
            "b560b90634e051a0",
            "b3f665a2703b19e7",
            "b3f665a2703b19e7",
            "b3f665a2703b19e7",
            "7b1ea521f5f8c992",
            "7b1ea521f5f8c992",
            "a3253938be9247f0",
            "a3253938be9247f0",
            "a3253938be9247f0",
            "a3253938be9247f0",
            "942d5f416807725d",
            "942d5f416807725d",
            "942d5f416807725d",
            "e4d485ce35b55e7c",
            "e4d485ce35b55e7c",
            "e4d485ce35b55e7c",
            "62d1491d583221ec",
            "62d1491d583221ec",
            "62d1491d583221ec",
            "62d1491d583221ec",
            "70e6a9456cb8df96",
            "70e6a9456cb8df96",
            "70e6a9456cb8df96"
          ],
          "title": "Consuming and Retiring Connection IDs"
        },
        {
          "id": "section-5.2",
          "lines": [
            "   Incoming packets are classified on receipt.  Packets can either be",
            "   associated with an existing connection or -- for servers --",
            "   potentially create a new connection.",
            "",
            "   Endpoints try to associate a packet with an existing connection.  If",
            "   the packet has a non-zero-length Destination Connection ID",
            "   corresponding to an existing connection, QUIC processes that packet",
            "   accordingly.  Note that more than one connection ID can be associated",
            "   with a connection; see Section 5.1.",
            "",
            "   If the Destination Connection ID is zero length and the addressing",
            "   information in the packet matches the addressing information the",
            "   endpoint uses to identify a connection with a zero-length connection",
            "   ID, QUIC processes the packet as part of that connection.  An",
            "   endpoint can use just destination IP and port or both source and",
            "   destination addresses for identification, though this makes",
            "   connections fragile as described in Section 5.1.",
            "",
            "   Endpoints can send a Stateless Reset (Section 10.3) for any packets",
            "   that cannot be attributed to an existing connection.  A Stateless",
            "   Reset allows a peer to more quickly identify when a connection",
            "   becomes unusable.",
            "",
            "   Packets that are matched to an existing connection are discarded if",
            "   the packets are inconsistent with the state of that connection.  For",
            "   example, packets are discarded if they indicate a different protocol",
            "   version than that of the connection or if the removal of packet",
            "   protection is unsuccessful once the expected keys are available.",
            "",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "39c9e42b4943f075",
                  "30d0026e849fd1e7"
                ],
                "status_id": 16,
                "text": "Invalid packets that lack strong integrity protection, such as"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "39c9e42b4943f075",
                  "30d0026e849fd1e7"
                ],
                "status_id": 16,
                "text": "Initial, Retry, or Version Negotiation, MAY be discarded."
              },
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "  "
              },
              {
                "annotation_ids": [
                  "e9e5bc9da9683ae8"
                ],
                "status_id": 20,
                "text": "An"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "e9e5bc9da9683ae8"
                ],
                "status_id": 20,
                "text": "endpoint MUST generate a connection error if processing the contents"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "e9e5bc9da9683ae8"
                ],
                "status_id": 20,
                "text": "of these packets prior to discovering an error, or fully revert any"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "e9e5bc9da9683ae8"
                ],
                "status_id": 20,
                "text": "changes made during that processing."
              }
            ]
          ],
          "requirements": [
            "30d0026e849fd1e7",
            "30d0026e849fd1e7",
            "e9e5bc9da9683ae8",
            "e9e5bc9da9683ae8",
            "e9e5bc9da9683ae8",
            "e9e5bc9da9683ae8"
          ],
          "title": "Matching Packets to Connections"
        },
        {
          "id": "section-5.2.1",
          "lines": [
            "   Valid packets sent to clients always include a Destination Connection",
            "   ID that matches a value the client selects.  Clients that choose to",
            "   receive zero-length connection IDs can use the local address and port",
            "   to identify a connection.  Packets that do not match an existing",
            "   connection -- based on Destination Connection ID or, if this value is",
            "   zero length, local IP address and port -- are discarded.",
            "",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "55335982bfc864aa"
                ],
                "status_id": 1,
                "text": "Due to packet reordering or loss, a client might receive packets for"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "55335982bfc864aa"
                ],
                "status_id": 1,
                "text": "a connection that are encrypted with a key it has not yet computed."
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "3225a655ed087d90",
                  "55335982bfc864aa",
                  "b07a6a42c7f780ae",
                  "60695a7b42f716d1"
                ],
                "status_id": 23,
                "text": "The client MAY drop these packets, or it MAY buffer them in"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "3225a655ed087d90",
                  "55335982bfc864aa",
                  "b07a6a42c7f780ae",
                  "60695a7b42f716d1"
                ],
                "status_id": 23,
                "text": "anticipation of later packets that allow it to compute the key."
              }
            ],
            "",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "f4f0219cfe199dff",
                  "078563bc05171225"
                ],
                "status_id": 13,
                "text": "If a client receives a packet that uses a different version than it"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "f4f0219cfe199dff",
                  "078563bc05171225"
                ],
                "status_id": 13,
                "text": "initially selected, it MUST discard that packet."
              }
            ]
          ],
          "requirements": [
            "b07a6a42c7f780ae",
            "b07a6a42c7f780ae",
            "60695a7b42f716d1",
            "60695a7b42f716d1",
            "078563bc05171225",
            "078563bc05171225"
          ],
          "title": "Client Packet Handling"
        },
        {
          "id": "section-5.2.2",
          "lines": [
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "1ba21cce65a48a70",
                  "a297bb8e26f02475"
                ],
                "status_id": 22,
                "text": "If a server receives a packet that indicates an unsupported version"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "1ba21cce65a48a70",
                  "a297bb8e26f02475"
                ],
                "status_id": 22,
                "text": "and if the packet is large enough to initiate a new connection for"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "1ba21cce65a48a70",
                  "a297bb8e26f02475"
                ],
                "status_id": 22,
                "text": "any supported version, the server SHOULD send a Version Negotiation"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "1ba21cce65a48a70",
                  "a297bb8e26f02475"
                ],
                "status_id": 22,
                "text": "packet as described in Section 6.1."
              },
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "  "
              },
              {
                "annotation_ids": [
                  "133b67e545fd98e0",
                  "20eaf6a007f2d625"
                ],
                "status_id": 21,
                "text": "A server MAY limit the number of"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "133b67e545fd98e0",
                  "20eaf6a007f2d625"
                ],
                "status_id": 21,
                "text": "packets to which it responds with a Version Negotiation packet."
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "fbe2a83cbcc02fba",
                  "a529a990e7258848"
                ],
                "status_id": 13,
                "text": "Servers MUST drop smaller packets that specify unsupported versions."
              }
            ],
            "",
            "   The first packet for an unsupported version can use different",
            "   semantics and encodings for any version-specific field.  In",
            "   particular, different packet protection keys might be used for",
            "   different versions.  Servers that do not support a particular version",
            "   are unlikely to be able to decrypt the payload of the packet or",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   properly interpret the result.  "
              },
              {
                "annotation_ids": [
                  "33b84784416b56b3",
                  "ff909e9d153e9689"
                ],
                "status_id": 22,
                "text": "Servers SHOULD respond with a Version"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "33b84784416b56b3",
                  "ff909e9d153e9689"
                ],
                "status_id": 22,
                "text": "Negotiation packet, provided that the datagram is sufficiently long."
              }
            ],
            "",
            "   Packets with a supported version, or no Version field, are matched to",
            "   a connection using the connection ID or -- for packets with zero-",
            "   length connection IDs -- the local address and port.  These packets",
            "   are processed using the selected connection; otherwise, the server",
            "   continues as described below.",
            "",
            "   If the packet is an Initial packet fully conforming with the",
            "   specification, the server proceeds with the handshake (Section 7).",
            "   This commits the server to the version that the client selected.",
            "",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "01e0460e0be9271b",
                  "bdfbe0b55ecccd2f"
                ],
                "status_id": 18,
                "text": "If a server refuses to accept a new connection, it SHOULD send an"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "01e0460e0be9271b",
                  "bdfbe0b55ecccd2f"
                ],
                "status_id": 18,
                "text": "Initial packet containing a CONNECTION_CLOSE frame with error code"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "01e0460e0be9271b",
                  "bdfbe0b55ecccd2f"
                ],
                "status_id": 18,
                "text": "CONNECTION_REFUSED."
              }
            ],
            "",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "b0606190cc087654",
                  "ed97fbfba65a5967"
                ],
                "status_id": 16,
                "text": "If the packet is a 0-RTT packet, the server MAY buffer a limited"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "b0606190cc087654",
                  "ed97fbfba65a5967"
                ],
                "status_id": 16,
                "text": "number of these packets in anticipation of a late-arriving Initial"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "b0606190cc087654",
                  "ed97fbfba65a5967"
                ],
                "status_id": 16,
                "text": "packet."
              },
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "  "
              },
              {
                "annotation_ids": [
                  "806530a9c43476b6",
                  "24c44b0b58cb54c0"
                ],
                "status_id": 18,
                "text": "Clients are not able to send Handshake packets prior to"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "806530a9c43476b6",
                  "24c44b0b58cb54c0"
                ],
                "status_id": 18,
                "text": "receiving a server response, so servers SHOULD ignore any such"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "806530a9c43476b6",
                  "24c44b0b58cb54c0"
                ],
                "status_id": 18,
                "text": "packets."
              }
            ],
            "",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "eec53c089fc4f709",
                  "b771992b1a35b745"
                ],
                "status_id": 13,
                "text": "Servers MUST drop incoming packets under all other circumstances."
              }
            ]
          ],
          "requirements": [
            "a297bb8e26f02475",
            "a297bb8e26f02475",
            "a297bb8e26f02475",
            "a297bb8e26f02475",
            "20eaf6a007f2d625",
            "20eaf6a007f2d625",
            "a529a990e7258848",
            "ff909e9d153e9689",
            "ff909e9d153e9689",
            "bdfbe0b55ecccd2f",
            "bdfbe0b55ecccd2f",
            "bdfbe0b55ecccd2f",
            "ed97fbfba65a5967",
            "ed97fbfba65a5967",
            "ed97fbfba65a5967",
            "24c44b0b58cb54c0",
            "24c44b0b58cb54c0",
            "24c44b0b58cb54c0",
            "b771992b1a35b745"
          ],
          "title": "Server Packet Handling"
        },
        {
          "id": "section-5.2.3",
          "lines": [
            "   A server deployment could load-balance among servers using only",
            "   source and destination IP addresses and ports.  Changes to the",
            "   client's IP address or port could result in packets being forwarded",
            "   to the wrong server.  Such a server deployment could use one of the",
            "   following methods for connection continuity when a client's address",
            "   changes.",
            "",
            "   *  Servers could use an out-of-band mechanism to forward packets to",
            "      the correct server based on connection ID.",
            "",
            "   *  If servers can use a dedicated server IP address or port, other",
            "      than the one that the client initially connects to, they could use",
            "      the preferred_address transport parameter to request that clients",
            "      move connections to that dedicated address.  Note that clients",
            "      could choose not to use the preferred address.",
            "",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "857f17c739bb20b6",
                  "7ab2e87df2c85969"
                ],
                "status_id": 10,
                "text": "A server in a deployment that does not implement a solution to"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "857f17c739bb20b6",
                  "7ab2e87df2c85969"
                ],
                "status_id": 10,
                "text": "maintain connection continuity when the client address changes SHOULD"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "857f17c739bb20b6",
                  "7ab2e87df2c85969"
                ],
                "status_id": 10,
                "text": "indicate that migration is not supported by using the"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "857f17c739bb20b6",
                  "7ab2e87df2c85969"
                ],
                "status_id": 10,
                "text": "disable_active_migration transport parameter."
              },
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "  The"
              }
            ],
            "   disable_active_migration transport parameter does not prohibit",
            "   connection migration after a client has acted on a preferred_address",
            "   transport parameter.",
            "",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "fbedb1a658792af9",
                  "7a148ad0da8e486f"
                ],
                "status_id": 12,
                "text": "Server deployments that use this simple form of load balancing MUST"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "fbedb1a658792af9",
                  "7a148ad0da8e486f"
                ],
                "status_id": 12,
                "text": "avoid the creation of a stateless reset oracle; see Section 21.11."
              }
            ]
          ],
          "requirements": [
            "7ab2e87df2c85969",
            "7ab2e87df2c85969",
            "7ab2e87df2c85969",
            "7ab2e87df2c85969",
            "7a148ad0da8e486f",
            "7a148ad0da8e486f"
          ],
          "title": "Considerations for Simple Load Balancers"
        },
        {
          "id": "section-5.3",
          "lines": [
            "   This document does not define an API for QUIC; it instead defines a",
            "   set of functions for QUIC connections that application protocols can",
            "   rely upon.  An application protocol can assume that an implementation",
            "   of QUIC provides an interface that includes the operations described",
            "   in this section.  An implementation designed for use with a specific",
            "   application protocol might provide only those operations that are",
            "   used by that protocol.",
            "",
            "   When implementing the client role, an application protocol can:",
            "",
            "   *  open a connection, which begins the exchange described in",
            "      Section 7;",
            "",
            "   *  enable Early Data when available; and",
            "",
            "   *  be informed when Early Data has been accepted or rejected by a",
            "      server.",
            "",
            "   When implementing the server role, an application protocol can:",
            "",
            "   *  listen for incoming connections, which prepares for the exchange",
            "      described in Section 7;",
            "",
            "   *  if Early Data is supported, embed application-controlled data in",
            "      the TLS resumption ticket sent to the client; and",
            "",
            "   *  if Early Data is supported, retrieve application-controlled data",
            "      from the client's resumption ticket and accept or reject Early",
            "      Data based on that information.",
            "",
            "   In either role, an application protocol can:",
            "",
            "   *  configure minimum values for the initial number of permitted",
            "      streams of each type, as communicated in the transport parameters",
            "      (Section 7.4);",
            "",
            "   *  control resource allocation for receive buffers by setting flow",
            "      control limits both for streams and for the connection;",
            "",
            "   *  identify whether the handshake has completed successfully or is",
            "      still ongoing;",
            "",
            "   *  keep a connection from silently closing, by either generating PING",
            "      frames (Section 19.2) or requesting that the transport send",
            "      additional frames before the idle timeout expires (Section 10.1);",
            "      and",
            "",
            "   *  immediately close (Section 10.2) the connection."
          ],
          "title": "Operations on Connections"
        },
        {
          "id": "section-6",
          "lines": [
            "   Version negotiation allows a server to indicate that it does not",
            "   support the version the client used.  A server sends a Version",
            "   Negotiation packet in response to each packet that might initiate a",
            "   new connection; see Section 5.2 for details.",
            "",
            "   The size of the first packet sent by a client will determine whether",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   a server sends a Version Negotiation packet.  "
              },
              {
                "annotation_ids": [
                  "971357a7977a48af",
                  "c39307444a2b54ae"
                ],
                "status_id": 18,
                "text": "Clients that support"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "971357a7977a48af",
                  "c39307444a2b54ae"
                ],
                "status_id": 18,
                "text": "multiple QUIC versions SHOULD ensure that the first UDP datagram they"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "971357a7977a48af",
                  "c39307444a2b54ae"
                ],
                "status_id": 18,
                "text": "send is sized to the largest of the minimum datagram sizes from all"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "971357a7977a48af",
                  "c39307444a2b54ae"
                ],
                "status_id": 18,
                "text": "versions they support, using PADDING frames (Section 19.1) as"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "971357a7977a48af",
                  "c39307444a2b54ae"
                ],
                "status_id": 18,
                "text": "necessary."
              },
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "  This ensures that the server responds if there is a"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   mutually supported version.  "
              },
              {
                "annotation_ids": [
                  "c1ca3810aedb9e16"
                ],
                "status_id": 1,
                "text": "A server might not send a Version"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "c1ca3810aedb9e16"
                ],
                "status_id": 1,
                "text": "Negotiation packet if the datagram it receives is smaller than the"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "c1ca3810aedb9e16"
                ],
                "status_id": 1,
                "text": "minimum size specified in a different version;"
              },
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": " see Section 14.1."
              }
            ]
          ],
          "requirements": [
            "c39307444a2b54ae",
            "c39307444a2b54ae",
            "c39307444a2b54ae",
            "c39307444a2b54ae",
            "c39307444a2b54ae"
          ],
          "title": "Version Negotiation"
        },
        {
          "id": "section-6.1",
          "lines": [
            "   If the version selected by the client is not acceptable to the",
            "   server, the server responds with a Version Negotiation packet; see",
            "   Section 17.2.1.  This includes a list of versions that the server",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   will accept.  "
              },
              {
                "annotation_ids": [
                  "4490087acf47658b",
                  "87532235eb7274fa"
                ],
                "status_id": 13,
                "text": "An endpoint MUST NOT send a Version Negotiation packet"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "4490087acf47658b",
                  "87532235eb7274fa"
                ],
                "status_id": 13,
                "text": "in response to receiving a Version Negotiation packet."
              }
            ],
            "",
            "   This system allows a server to process packets with unsupported",
            "   versions without retaining state.  Though either the Initial packet",
            "   or the Version Negotiation packet that is sent in response could be",
            "   lost, the client will send new packets until it successfully receives",
            "   a response or it abandons the connection attempt.",
            "",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "4035eae20cc53e5c",
                  "492f50ea5bc46a5e"
                ],
                "status_id": 21,
                "text": "A server MAY limit the number of Version Negotiation packets it"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "4035eae20cc53e5c",
                  "492f50ea5bc46a5e"
                ],
                "status_id": 21,
                "text": "sends."
              },
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "  For instance, "
              },
              {
                "annotation_ids": [
                  "a9ded591be206ec6"
                ],
                "status_id": 1,
                "text": "a server that is able to recognize packets as"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "a9ded591be206ec6"
                ],
                "status_id": 1,
                "text": "0-RTT might choose not to send Version Negotiation packets in"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "a9ded591be206ec6"
                ],
                "status_id": 1,
                "text": "response to 0-RTT packets with the expectation that it will"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "a9ded591be206ec6"
                ],
                "status_id": 1,
                "text": "eventually receive an Initial packet."
              }
            ]
          ],
          "requirements": [
            "87532235eb7274fa",
            "87532235eb7274fa",
            "492f50ea5bc46a5e",
            "492f50ea5bc46a5e"
          ],
          "title": "Sending Version Negotiation Packets"
        },
        {
          "id": "section-6.2",
          "lines": [
            "   Version Negotiation packets are designed to allow for functionality",
            "   to be defined in the future that allows QUIC to negotiate the version",
            "   of QUIC to use for a connection.  Future Standards Track",
            "   specifications might change how implementations that support multiple",
            "   versions of QUIC react to Version Negotiation packets received in",
            "   response to an attempt to establish a connection using this version.",
            "",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "c00c8b528159cef2",
                  "5d35591abe9b608f"
                ],
                "status_id": 17,
                "text": "A client that supports only this version of QUIC MUST abandon the"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "c00c8b528159cef2",
                  "5d35591abe9b608f"
                ],
                "status_id": 17,
                "text": "current connection attempt if it receives a Version Negotiation"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "c00c8b528159cef2",
                  "5d35591abe9b608f"
                ],
                "status_id": 17,
                "text": "packet, with the following two exceptions."
              },
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "  "
              },
              {
                "annotation_ids": [
                  "eed21c5d5e4d9feb",
                  "bb9f0aff35056ada"
                ],
                "status_id": 17,
                "text": "A client MUST discard any"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "eed21c5d5e4d9feb",
                  "bb9f0aff35056ada"
                ],
                "status_id": 17,
                "text": "Version Negotiation packet if it has received and successfully"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "eed21c5d5e4d9feb",
                  "bb9f0aff35056ada"
                ],
                "status_id": 17,
                "text": "processed any other packet, including an earlier Version Negotiation"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "eed21c5d5e4d9feb",
                  "bb9f0aff35056ada"
                ],
                "status_id": 17,
                "text": "packet."
              },
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "  "
              },
              {
                "annotation_ids": [
                  "2cbde06950629d56",
                  "1c29b18a059a082e"
                ],
                "status_id": 17,
                "text": "A client MUST discard a Version Negotiation packet that"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "2cbde06950629d56",
                  "1c29b18a059a082e"
                ],
                "status_id": 17,
                "text": "lists the QUIC version selected by the client."
              }
            ],
            "",
            "   How to perform version negotiation is left as future work defined by",
            "   future Standards Track specifications.  In particular, that future",
            "   work will ensure robustness against version downgrade attacks; see",
            "   Section 21.12."
          ],
          "requirements": [
            "5d35591abe9b608f",
            "5d35591abe9b608f",
            "5d35591abe9b608f",
            "bb9f0aff35056ada",
            "bb9f0aff35056ada",
            "bb9f0aff35056ada",
            "bb9f0aff35056ada",
            "1c29b18a059a082e",
            "1c29b18a059a082e"
          ],
          "title": "Handling Version Negotiation Packets"
        },
        {
          "id": "section-6.3",
          "lines": [
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "49020306a16820c8"
                ],
                "status_id": 1,
                "text": "For a server to use a new version in the future, clients need to"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "49020306a16820c8"
                ],
                "status_id": 1,
                "text": "correctly handle unsupported versions.  Some version numbers"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "49020306a16820c8"
                ],
                "status_id": 1,
                "text": "(0x?a?a?a?a, as defined in Section 15) are reserved for inclusion in"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "49020306a16820c8"
                ],
                "status_id": 1,
                "text": "fields that contain version numbers."
              }
            ],
            "",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "f0cb7b3b01d70dc6",
                  "f8042919b511a6dd"
                ],
                "status_id": 21,
                "text": "Endpoints MAY add reserved versions to any field where unknown or"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "f0cb7b3b01d70dc6",
                  "f8042919b511a6dd"
                ],
                "status_id": 21,
                "text": "unsupported versions are ignored to test that a peer correctly"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "f0cb7b3b01d70dc6",
                  "f8042919b511a6dd"
                ],
                "status_id": 21,
                "text": "ignores the value."
              },
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "  For instance, an endpoint could include a"
              }
            ],
            "   reserved version in a Version Negotiation packet; see Section 17.2.1.",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "bdbb260175b6c284",
                  "9cf44770bc6dc4b2"
                ],
                "status_id": 21,
                "text": "Endpoints MAY send packets with a reserved version to test that a"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "bdbb260175b6c284",
                  "9cf44770bc6dc4b2"
                ],
                "status_id": 21,
                "text": "peer correctly discards the packet."
              }
            ]
          ],
          "requirements": [
            "f8042919b511a6dd",
            "f8042919b511a6dd",
            "f8042919b511a6dd",
            "9cf44770bc6dc4b2",
            "9cf44770bc6dc4b2"
          ],
          "title": "Using Reserved Versions"
        },
        {
          "id": "section-7",
          "lines": [
            "   QUIC relies on a combined cryptographic and transport handshake to",
            "   minimize connection establishment latency.  QUIC uses the CRYPTO",
            "   frame (Section 19.6) to transmit the cryptographic handshake.  The",
            "   version of QUIC defined in this document is identified as 0x00000001",
            "   and uses TLS as described in [QUIC-TLS]; a different QUIC version",
            "   could indicate that a different cryptographic handshake protocol is",
            "   in use.",
            "",
            "   QUIC provides reliable, ordered delivery of the cryptographic",
            "   handshake data.  QUIC packet protection is used to encrypt as much of",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   the handshake protocol as possible.  "
              },
              {
                "annotation_ids": [
                  "859013f112b9ab1b",
                  "3dff35df8971cbef"
                ],
                "status_id": 12,
                "text": "The cryptographic handshake MUST"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "859013f112b9ab1b",
                  "3dff35df8971cbef"
                ],
                "status_id": 12,
                "text": "provide the following properties:"
              }
            ],
            "",
            "   *  authenticated key exchange, where",
            "",
            "      -  a server is always authenticated,",
            "",
            "      -  a client is optionally authenticated,",
            "",
            "      -  every connection produces distinct and unrelated keys, and",
            "",
            "      -  keying material is usable for packet protection for both 0-RTT",
            "         and 1-RTT packets.",
            "",
            "   *  authenticated exchange of values for transport parameters of both",
            "      endpoints, and confidentiality protection for server transport",
            "      parameters (see Section 7.4).",
            "",
            "   *  authenticated negotiation of an application protocol (TLS uses",
            "      Application-Layer Protocol Negotiation (ALPN) [ALPN] for this",
            "      purpose).",
            "",
            "   The CRYPTO frame can be sent in different packet number spaces",
            "   (Section 12.3).  The offsets used by CRYPTO frames to ensure ordered",
            "   delivery of cryptographic handshake data start from zero in each",
            "   packet number space.",
            "",
            "   Figure 4 shows a simplified handshake and the exchange of packets and",
            "   frames that are used to advance the handshake.  Exchange of",
            "   application data during the handshake is enabled where possible,",
            "   shown with an asterisk (\"*\").  Once the handshake is complete,",
            "   endpoints are able to exchange application data freely.",
            "",
            "   Client                                               Server",
            "",
            "   Initial (CRYPTO)",
            "   0-RTT (*)              ---------->",
            "                                              Initial (CRYPTO)",
            "                                            Handshake (CRYPTO)",
            "                          <----------                1-RTT (*)",
            "   Handshake (CRYPTO)",
            "   1-RTT (*)              ---------->",
            "                          <----------   1-RTT (HANDSHAKE_DONE)",
            "",
            "   1-RTT                  <=========>                    1-RTT",
            "",
            "                    Figure 4: Simplified QUIC Handshake",
            "",
            "   Endpoints can use packets sent during the handshake to test for",
            "   Explicit Congestion Notification (ECN) support; see Section 13.4.  An",
            "   endpoint validates support for ECN by observing whether the ACK",
            "   frames acknowledging the first packets it sends carry ECN counts, as",
            "   described in Section 13.4.2.",
            "",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "0e7529d90593e83d",
                  "0028db16a81e832d"
                ],
                "status_id": 13,
                "text": "Endpoints MUST explicitly negotiate an application protocol."
              },
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "  This"
              }
            ],
            "   avoids situations where there is a disagreement about the protocol",
            "   that is in use."
          ],
          "requirements": [
            "3dff35df8971cbef",
            "3dff35df8971cbef",
            "0028db16a81e832d"
          ],
          "title": "Cryptographic and Transport Handshake"
        },
        {
          "id": "section-7.1",
          "lines": [
            "   Details of how TLS is integrated with QUIC are provided in",
            "   [QUIC-TLS], but some examples are provided here.  An extension of",
            "   this exchange to support client address validation is shown in",
            "   Section 8.1.2.",
            "",
            "   Once any address validation exchanges are complete, the cryptographic",
            "   handshake is used to agree on cryptographic keys.  The cryptographic",
            "   handshake is carried in Initial (Section 17.2.2) and Handshake",
            "   (Section 17.2.4) packets.",
            "",
            "   Figure 5 provides an overview of the 1-RTT handshake.  Each line",
            "   shows a QUIC packet with the packet type and packet number shown",
            "   first, followed by the frames that are typically contained in those",
            "   packets.  For instance, the first packet is of type Initial, with",
            "   packet number 0, and contains a CRYPTO frame carrying the",
            "   ClientHello.",
            "",
            "   Multiple QUIC packets -- even of different packet types -- can be",
            "   coalesced into a single UDP datagram; see Section 12.2.  As a result,",
            "   this handshake could consist of as few as four UDP datagrams, or any",
            "   number more (subject to limits inherent to the protocol, such as",
            "   congestion control and anti-amplification).  For instance, the",
            "   server's first flight contains Initial packets, Handshake packets,",
            "   and \"0.5-RTT data\" in 1-RTT packets.",
            "",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "ae010132439b3541"
                ],
                "status_id": 1,
                "text": "Client                                                  Server"
              }
            ],
            "",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "ae010132439b3541"
                ],
                "status_id": 1,
                "text": "Initial[0]: CRYPTO[CH] ->"
              }
            ],
            "",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "                                    "
              },
              {
                "annotation_ids": [
                  "ae010132439b3541"
                ],
                "status_id": 1,
                "text": "Initial[0]: CRYPTO[SH] ACK[0]"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "                          "
              },
              {
                "annotation_ids": [
                  "ae010132439b3541"
                ],
                "status_id": 1,
                "text": "Handshake[0]: CRYPTO[EE, CERT, CV, FIN]"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "                                    "
              },
              {
                "annotation_ids": [
                  "ae010132439b3541"
                ],
                "status_id": 1,
                "text": "<- 1-RTT[0]: STREAM[1, \"...\"]"
              }
            ],
            "",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "ae010132439b3541"
                ],
                "status_id": 1,
                "text": "Initial[1]: ACK[0]"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "ae010132439b3541"
                ],
                "status_id": 1,
                "text": "Handshake[0]: CRYPTO[FIN], ACK[0]"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "ae010132439b3541"
                ],
                "status_id": 1,
                "text": "1-RTT[0]: STREAM[0, \"...\"], ACK[0] ->"
              }
            ],
            "",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "                                             "
              },
              {
                "annotation_ids": [
                  "ae010132439b3541"
                ],
                "status_id": 1,
                "text": "Handshake[1]: ACK[0]"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "            "
              },
              {
                "annotation_ids": [
                  "ae010132439b3541"
                ],
                "status_id": 1,
                "text": "<- 1-RTT[1]: HANDSHAKE_DONE, STREAM[3, \"...\"], ACK[0]"
              }
            ],
            "",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "                     "
              },
              {
                "annotation_ids": [
                  "ae010132439b3541"
                ],
                "status_id": 1,
                "text": "Figure 5: Example 1-RTT Handshake"
              }
            ],
            "",
            "   Figure 6 shows an example of a connection with a 0-RTT handshake and",
            "   a single packet of 0-RTT data.  Note that as described in",
            "   Section 12.3, the server acknowledges 0-RTT data in 1-RTT packets,",
            "   and the client sends 1-RTT packets in the same packet number space.",
            "",
            "   Client                                                  Server",
            "",
            "   Initial[0]: CRYPTO[CH]",
            "   0-RTT[0]: STREAM[0, \"...\"] ->",
            "",
            "                                    Initial[0]: CRYPTO[SH] ACK[0]",
            "                                     Handshake[0] CRYPTO[EE, FIN]",
            "                             <- 1-RTT[0]: STREAM[1, \"...\"] ACK[0]",
            "",
            "   Initial[1]: ACK[0]",
            "   Handshake[0]: CRYPTO[FIN], ACK[0]",
            "   1-RTT[1]: STREAM[0, \"...\"] ACK[0] ->",
            "",
            "                                             Handshake[1]: ACK[0]",
            "            <- 1-RTT[1]: HANDSHAKE_DONE, STREAM[3, \"...\"], ACK[1]",
            "",
            "                     Figure 6: Example 0-RTT Handshake"
          ],
          "title": "Example Handshake Flows"
        },
        {
          "id": "section-7.2",
          "lines": [
            "   A connection ID is used to ensure consistent routing of packets, as",
            "   described in Section 5.1.  The long header contains two connection",
            "   IDs: the Destination Connection ID is chosen by the recipient of the",
            "   packet and is used to provide consistent routing; the Source",
            "   Connection ID is used to set the Destination Connection ID used by",
            "   the peer.",
            "",
            "   During the handshake, packets with the long header (Section 17.2) are",
            "   used to establish the connection IDs used by both endpoints.  Each",
            "   endpoint uses the Source Connection ID field to specify the",
            "   connection ID that is used in the Destination Connection ID field of",
            "   packets being sent to them.  After processing the first Initial",
            "   packet, each endpoint sets the Destination Connection ID field in",
            "   subsequent packets it sends to the value of the Source Connection ID",
            "   field that it received.",
            "",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "477ae01528322282",
                  "5210a302a4e0cbfb",
                  "294439d25310309d"
                ],
                "status_id": 1,
                "text": "When an Initial packet is sent by a client that has not previously"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "477ae01528322282",
                  "5210a302a4e0cbfb",
                  "294439d25310309d"
                ],
                "status_id": 1,
                "text": "received an Initial or Retry packet from the server, the client"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "477ae01528322282",
                  "5210a302a4e0cbfb",
                  "294439d25310309d"
                ],
                "status_id": 1,
                "text": "populates the Destination Connection ID field with an unpredictable"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "477ae01528322282",
                  "5210a302a4e0cbfb",
                  "294439d25310309d"
                ],
                "status_id": 1,
                "text": "value."
              },
              {
                "annotation_ids": [
                  "477ae01528322282",
                  "5210a302a4e0cbfb"
                ],
                "status_id": 1,
                "text": "  "
              },
              {
                "annotation_ids": [
                  "477ae01528322282",
                  "5210a302a4e0cbfb",
                  "970d75b6584425db"
                ],
                "status_id": 13,
                "text": "This Destination Connection ID MUST be at least 8 bytes in"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "477ae01528322282",
                  "5210a302a4e0cbfb",
                  "970d75b6584425db"
                ],
                "status_id": 13,
                "text": "length."
              },
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "  "
              },
              {
                "annotation_ids": [
                  "7bb26e93271f022d",
                  "0453b999e03c45c5",
                  "1ad6fe8e65e4074c",
                  "adb5ea7cad6df481"
                ],
                "status_id": 24,
                "text": "Until a packet is received from the server, the client MUST"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "7bb26e93271f022d",
                  "0453b999e03c45c5",
                  "1ad6fe8e65e4074c",
                  "adb5ea7cad6df481"
                ],
                "status_id": 24,
                "text": "use the same Destination Connection ID value on all packets in this"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "7bb26e93271f022d",
                  "0453b999e03c45c5",
                  "1ad6fe8e65e4074c",
                  "adb5ea7cad6df481"
                ],
                "status_id": 24,
                "text": "connection."
              }
            ],
            "",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "eb6511423fb856f2"
                ],
                "status_id": 1,
                "text": "The Destination Connection ID field from the first Initial packet"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "eb6511423fb856f2"
                ],
                "status_id": 1,
                "text": "sent by a client is used to determine packet protection keys for"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "eb6511423fb856f2"
                ],
                "status_id": 1,
                "text": "Initial packets."
              },
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "  These keys change after receiving a Retry packet;"
              }
            ],
            "   see Section 5.2 of [QUIC-TLS].",
            "",
            "   The client populates the Source Connection ID field with a value of",
            "   its choosing and sets the Source Connection ID Length field to",
            "   indicate the length.",
            "",
            "   0-RTT packets in the first flight use the same Destination Connection",
            "   ID and Source Connection ID values as the client's first Initial",
            "   packet.",
            "",
            "   Upon first receiving an Initial or Retry packet from the server, the",
            "   client uses the Source Connection ID supplied by the server as the",
            "   Destination Connection ID for subsequent packets, including any 0-RTT",
            "   packets.  This means that a client might have to change the",
            "   connection ID it sets in the Destination Connection ID field twice",
            "   during connection establishment: once in response to a Retry packet",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   and once in response to an Initial packet from the server.  "
              },
              {
                "annotation_ids": [
                  "7343ef20b4906640",
                  "7158d4cbd3a99ba5",
                  "251a3012a25f8a10",
                  "c44be17cf0437812"
                ],
                "status_id": 25,
                "text": "Once a"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "7343ef20b4906640",
                  "7158d4cbd3a99ba5",
                  "251a3012a25f8a10",
                  "c44be17cf0437812"
                ],
                "status_id": 25,
                "text": "client has received a valid Initial packet from the server, it MUST"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "7343ef20b4906640",
                  "7158d4cbd3a99ba5",
                  "251a3012a25f8a10",
                  "c44be17cf0437812"
                ],
                "status_id": 25,
                "text": "discard any subsequent packet it receives on that connection with a"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "7343ef20b4906640",
                  "7158d4cbd3a99ba5",
                  "251a3012a25f8a10",
                  "c44be17cf0437812"
                ],
                "status_id": 25,
                "text": "different Source Connection ID."
              }
            ],
            "",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "ebbc4090f691ac03",
                  "43815835494d3ffb",
                  "8ea0c6ae21a81e19",
                  "b6395c2c8f4e3168"
                ],
                "status_id": 25,
                "text": "A client MUST change the Destination Connection ID it uses for"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "ebbc4090f691ac03",
                  "43815835494d3ffb",
                  "8ea0c6ae21a81e19",
                  "b6395c2c8f4e3168"
                ],
                "status_id": 25,
                "text": "sending packets in response to only the first received Initial or"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "ebbc4090f691ac03",
                  "43815835494d3ffb",
                  "8ea0c6ae21a81e19",
                  "b6395c2c8f4e3168"
                ],
                "status_id": 25,
                "text": "Retry packet."
              },
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "  "
              },
              {
                "annotation_ids": [
                  "5875646c7325a607",
                  "812745265173298a"
                ],
                "status_id": 13,
                "text": "A server MUST set the Destination Connection ID it"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "5875646c7325a607",
                  "812745265173298a"
                ],
                "status_id": 13,
                "text": "uses for sending packets based on the first received Initial packet."
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "916cc21b06edcf1b",
                  "7a928f1da652bce3",
                  "166315b0224ddb65"
                ],
                "status_id": 25,
                "text": "Any further changes to the Destination Connection ID are only"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "916cc21b06edcf1b",
                  "7a928f1da652bce3",
                  "166315b0224ddb65"
                ],
                "status_id": 25,
                "text": "permitted if the values are taken from NEW_CONNECTION_ID frames; if"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "916cc21b06edcf1b",
                  "7a928f1da652bce3",
                  "166315b0224ddb65"
                ],
                "status_id": 25,
                "text": "subsequent Initial packets include a different Source Connection ID,"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "916cc21b06edcf1b",
                  "7a928f1da652bce3",
                  "166315b0224ddb65"
                ],
                "status_id": 25,
                "text": "they MUST be discarded."
              },
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "  This avoids unpredictable outcomes that"
              }
            ],
            "   might otherwise result from stateless processing of multiple Initial",
            "   packets with different Source Connection IDs.",
            "",
            "   The Destination Connection ID that an endpoint sends can change over",
            "   the lifetime of a connection, especially in response to connection",
            "   migration (Section 9); see Section 5.1.1 for details."
          ],
          "requirements": [
            "970d75b6584425db",
            "970d75b6584425db",
            "adb5ea7cad6df481",
            "adb5ea7cad6df481",
            "adb5ea7cad6df481",
            "c44be17cf0437812",
            "c44be17cf0437812",
            "c44be17cf0437812",
            "c44be17cf0437812",
            "b6395c2c8f4e3168",
            "b6395c2c8f4e3168",
            "b6395c2c8f4e3168",
            "812745265173298a",
            "812745265173298a",
            "166315b0224ddb65",
            "166315b0224ddb65",
            "166315b0224ddb65",
            "166315b0224ddb65"
          ],
          "title": "Negotiating Connection IDs"
        },
        {
          "id": "section-7.3",
          "lines": [
            "   The choice each endpoint makes about connection IDs during the",
            "   handshake is authenticated by including all values in transport",
            "   parameters; see Section 7.4.  This ensures that all connection IDs",
            "   used for the handshake are also authenticated by the cryptographic",
            "   handshake.",
            "",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "e393a09e3b498b10",
                  "df59bd4b6ae44bf1"
                ],
                "status_id": 1,
                "text": "Each endpoint includes the value of the Source Connection ID field"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "e393a09e3b498b10",
                  "df59bd4b6ae44bf1"
                ],
                "status_id": 1,
                "text": "from the first Initial packet it sent in the"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "e393a09e3b498b10",
                  "df59bd4b6ae44bf1"
                ],
                "status_id": 1,
                "text": "initial_source_connection_id transport parameter"
              },
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "; see Section 18.2."
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "8093560131a1fa04"
                ],
                "status_id": 1,
                "text": "A server includes the Destination Connection ID field from the first"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "8093560131a1fa04"
                ],
                "status_id": 1,
                "text": "Initial packet it received from the client in the"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "8093560131a1fa04"
                ],
                "status_id": 1,
                "text": "original_destination_connection_id transport parameter; if the server"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "8093560131a1fa04"
                ],
                "status_id": 1,
                "text": "sent a Retry packet, this refers to the first Initial packet received"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "8093560131a1fa04"
                ],
                "status_id": 1,
                "text": "before sending the Retry packet.  If it sends a Retry packet, a"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "8093560131a1fa04"
                ],
                "status_id": 1,
                "text": "server also includes the Source Connection ID field from the Retry"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "8093560131a1fa04"
                ],
                "status_id": 1,
                "text": "packet in the retry_source_connection_id transport parameter."
              }
            ],
            "",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "810c287809fe8b73",
                  "8576357164c9ca01",
                  "7ceca0776e47c543"
                ],
                "status_id": 13,
                "text": "The values provided by a peer for these transport parameters MUST"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "810c287809fe8b73",
                  "8576357164c9ca01",
                  "7ceca0776e47c543"
                ],
                "status_id": 13,
                "text": "match the values that an endpoint used in the Destination and Source"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "810c287809fe8b73",
                  "8576357164c9ca01",
                  "7ceca0776e47c543"
                ],
                "status_id": 13,
                "text": "Connection ID fields of Initial packets that it sent (and received,"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "810c287809fe8b73",
                  "8576357164c9ca01",
                  "7ceca0776e47c543"
                ],
                "status_id": 13,
                "text": "for servers)."
              },
              {
                "annotation_ids": [
                  "810c287809fe8b73",
                  "8576357164c9ca01"
                ],
                "status_id": 1,
                "text": "  "
              },
              {
                "annotation_ids": [
                  "810c287809fe8b73",
                  "8576357164c9ca01",
                  "6435d7ba06e49242"
                ],
                "status_id": 13,
                "text": "Endpoints MUST validate that received transport"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "810c287809fe8b73",
                  "8576357164c9ca01",
                  "6435d7ba06e49242"
                ],
                "status_id": 13,
                "text": "parameters match received connection ID values."
              },
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "  Including connection"
              }
            ],
            "   ID values in transport parameters and verifying them ensures that an",
            "   attacker cannot influence the choice of connection ID for a",
            "   successful connection by injecting packets carrying attacker-chosen",
            "   connection IDs during the handshake.",
            "",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "cbdc5cb94e4492d1",
                  "7ad0e64859de8ae3",
                  "deffd4d73cfe4d4e"
                ],
                "status_id": 13,
                "text": "An endpoint MUST treat the absence of the"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "cbdc5cb94e4492d1",
                  "7ad0e64859de8ae3",
                  "deffd4d73cfe4d4e"
                ],
                "status_id": 13,
                "text": "initial_source_connection_id transport parameter from either endpoint"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "cbdc5cb94e4492d1",
                  "7ad0e64859de8ae3",
                  "deffd4d73cfe4d4e"
                ],
                "status_id": 13,
                "text": "or the absence of the original_destination_connection_id transport"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "cbdc5cb94e4492d1",
                  "7ad0e64859de8ae3",
                  "deffd4d73cfe4d4e"
                ],
                "status_id": 13,
                "text": "parameter from the server as a connection error of type"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "cbdc5cb94e4492d1",
                  "7ad0e64859de8ae3",
                  "deffd4d73cfe4d4e"
                ],
                "status_id": 13,
                "text": "TRANSPORT_PARAMETER_ERROR."
              }
            ],
            "",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "37de9585550d319c",
                  "115ef4adec296e38",
                  "0f627866d552858f"
                ],
                "status_id": 13,
                "text": "An endpoint MUST treat the following as a connection error of type"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "37de9585550d319c",
                  "115ef4adec296e38",
                  "0f627866d552858f"
                ],
                "status_id": 13,
                "text": "TRANSPORT_PARAMETER_ERROR or PROTOCOL_VIOLATION:"
              }
            ],
            "",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "4254ae43bb4dcfe6"
                ],
                "status_id": 1,
                "text": "*  absence of the retry_source_connection_id transport parameter from"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "      "
              },
              {
                "annotation_ids": [
                  "4254ae43bb4dcfe6"
                ],
                "status_id": 1,
                "text": "the server after receiving a Retry packet,"
              }
            ],
            "",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "bb5569200f072fa4"
                ],
                "status_id": 1,
                "text": "*  presence of the retry_source_connection_id transport parameter"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "      "
              },
              {
                "annotation_ids": [
                  "bb5569200f072fa4"
                ],
                "status_id": 1,
                "text": "when no Retry packet was received, or"
              }
            ],
            "",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "c29e43d66280155e"
                ],
                "status_id": 1,
                "text": "*  a mismatch between values received from a peer in these transport"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "      "
              },
              {
                "annotation_ids": [
                  "c29e43d66280155e"
                ],
                "status_id": 1,
                "text": "parameters and the value sent in the corresponding Destination or"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "      "
              },
              {
                "annotation_ids": [
                  "c29e43d66280155e"
                ],
                "status_id": 1,
                "text": "Source Connection ID fields of Initial packets."
              }
            ],
            "",
            "   If a zero-length connection ID is selected, the corresponding",
            "   transport parameter is included with a zero-length value.",
            "",
            "   Figure 7 shows the connection IDs (with DCID=Destination Connection",
            "   ID, SCID=Source Connection ID) that are used in a complete handshake.",
            "   The exchange of Initial packets is shown, plus the later exchange of",
            "   1-RTT packets that includes the connection ID established during the",
            "   handshake.",
            "",
            "   Client                                                  Server",
            "",
            "   Initial: DCID=S1, SCID=C1 ->",
            "                                     <- Initial: DCID=C1, SCID=S3",
            "                                ...",
            "   1-RTT: DCID=S3 ->",
            "                                                <- 1-RTT: DCID=C1",
            "",
            "               Figure 7: Use of Connection IDs in a Handshake",
            "",
            "   Figure 8 shows a similar handshake that includes a Retry packet.",
            "",
            "   Client                                                  Server",
            "",
            "   Initial: DCID=S1, SCID=C1 ->",
            "                                       <- Retry: DCID=C1, SCID=S2",
            "   Initial: DCID=S2, SCID=C1 ->",
            "                                     <- Initial: DCID=C1, SCID=S3",
            "                                ...",
            "   1-RTT: DCID=S3 ->",
            "                                                <- 1-RTT: DCID=C1",
            "",
            "         Figure 8: Use of Connection IDs in a Handshake with Retry",
            "",
            "   In both cases (Figures 7 and 8), the client sets the value of the",
            "   initial_source_connection_id transport parameter to \"C1\".",
            "",
            "   When the handshake does not include a Retry (Figure 7), the server",
            "   sets original_destination_connection_id to \"S1\" (note that this value",
            "   is chosen by the client) and initial_source_connection_id to \"S3\".",
            "   In this case, the server does not include a",
            "   retry_source_connection_id transport parameter.",
            "",
            "   When the handshake includes a Retry (Figure 8), the server sets",
            "   original_destination_connection_id to \"S1\",",
            "   retry_source_connection_id to \"S2\", and initial_source_connection_id",
            "   to \"S3\"."
          ],
          "requirements": [
            "7ceca0776e47c543",
            "7ceca0776e47c543",
            "7ceca0776e47c543",
            "7ceca0776e47c543",
            "6435d7ba06e49242",
            "6435d7ba06e49242",
            "deffd4d73cfe4d4e",
            "deffd4d73cfe4d4e",
            "deffd4d73cfe4d4e",
            "deffd4d73cfe4d4e",
            "deffd4d73cfe4d4e",
            "0f627866d552858f",
            "0f627866d552858f"
          ],
          "title": "Authenticating Connection IDs"
        },
        {
          "id": "section-7.4",
          "lines": [
            "   During connection establishment, both endpoints make authenticated",
            "   declarations of their transport parameters.  Endpoints are required",
            "   to comply with the restrictions that each parameter defines; the",
            "   description of each parameter includes rules for its handling.",
            "",
            "   Transport parameters are declarations that are made unilaterally by",
            "   each endpoint.  Each endpoint can choose values for transport",
            "   parameters independent of the values chosen by its peer.",
            "",
            "   The encoding of the transport parameters is detailed in Section 18.",
            "",
            "   QUIC includes the encoded transport parameters in the cryptographic",
            "   handshake.  Once the handshake completes, the transport parameters",
            "   declared by the peer are available.  Each endpoint validates the",
            "   values provided by its peer.",
            "",
            "   Definitions for each of the defined transport parameters are included",
            "   in Section 18.2.",
            "",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "d380dfb7f0f0df7d",
                  "35952151362bf521"
                ],
                "status_id": 13,
                "text": "An endpoint MUST treat receipt of a transport parameter with an"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "d380dfb7f0f0df7d",
                  "35952151362bf521"
                ],
                "status_id": 13,
                "text": "invalid value as a connection error of type"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "d380dfb7f0f0df7d",
                  "35952151362bf521"
                ],
                "status_id": 13,
                "text": "TRANSPORT_PARAMETER_ERROR."
              }
            ],
            "",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "8ffcb77c95488b2d",
                  "54c26ed8d46e0afc"
                ],
                "status_id": 13,
                "text": "An endpoint MUST NOT send a parameter more than once in a given"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "8ffcb77c95488b2d",
                  "54c26ed8d46e0afc"
                ],
                "status_id": 13,
                "text": "transport parameters extension."
              },
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "  "
              },
              {
                "annotation_ids": [
                  "6063b23f72e317a6",
                  "bc9ee53ab114d8da",
                  "464b20a0040be30c",
                  "465a4d3c37777e68"
                ],
                "status_id": 22,
                "text": "An endpoint SHOULD treat receipt of"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "6063b23f72e317a6",
                  "bc9ee53ab114d8da",
                  "464b20a0040be30c",
                  "465a4d3c37777e68"
                ],
                "status_id": 22,
                "text": "duplicate transport parameters as a connection error of type"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "6063b23f72e317a6",
                  "bc9ee53ab114d8da",
                  "464b20a0040be30c",
                  "465a4d3c37777e68"
                ],
                "status_id": 22,
                "text": "TRANSPORT_PARAMETER_ERROR."
              }
            ],
            "",
            "   Endpoints use transport parameters to authenticate the negotiation of",
            "   connection IDs during the handshake; see Section 7.3.",
            "",
            "   ALPN (see [ALPN]) allows clients to offer multiple application",
            "   protocols during connection establishment.  The transport parameters",
            "   that a client includes during the handshake apply to all application",
            "   protocols that the client offers.  Application protocols can",
            "   recommend values for transport parameters, such as the initial flow",
            "   control limits.  However, application protocols that set constraints",
            "   on values for transport parameters could make it impossible for a",
            "   client to offer multiple application protocols if these constraints",
            "   conflict."
          ],
          "requirements": [
            "35952151362bf521",
            "35952151362bf521",
            "35952151362bf521",
            "54c26ed8d46e0afc",
            "54c26ed8d46e0afc",
            "465a4d3c37777e68",
            "465a4d3c37777e68",
            "465a4d3c37777e68"
          ],
          "title": "Transport Parameters"
        },
        {
          "id": "section-7.4.1",
          "lines": [
            "   Using 0-RTT depends on both client and server using protocol",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   parameters that were negotiated from a previous connection.  "
              },
              {
                "annotation_ids": [
                  "09626d160c421148"
                ],
                "status_id": 1,
                "text": "To"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "09626d160c421148"
                ],
                "status_id": 1,
                "text": "enable 0-RTT, endpoints store the values of the server transport"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "09626d160c421148"
                ],
                "status_id": 1,
                "text": "parameters with any session tickets it receives on the connection."
              }
            ],
            "   Endpoints also store any information required by the application",
            "   protocol or cryptographic handshake; see Section 4.6 of [QUIC-TLS].",
            "   The values of stored transport parameters are used when attempting",
            "   0-RTT using the session tickets.",
            "",
            "   Remembered transport parameters apply to the new connection until the",
            "   handshake completes and the client starts sending 1-RTT packets.",
            "   Once the handshake completes, the client uses the transport",
            "   parameters established in the handshake.  Not all transport",
            "   parameters are remembered, as some do not apply to future connections",
            "   or they have no effect on the use of 0-RTT.",
            "",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "ebb06409f1d11d58",
                  "862b0c8ce9f2e1a9"
                ],
                "status_id": 12,
                "text": "The definition of a new transport parameter (Section 7.4.2) MUST"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "ebb06409f1d11d58",
                  "862b0c8ce9f2e1a9"
                ],
                "status_id": 12,
                "text": "specify whether storing the transport parameter for 0-RTT is"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "ebb06409f1d11d58",
                  "862b0c8ce9f2e1a9"
                ],
                "status_id": 12,
                "text": "mandatory, optional, or prohibited."
              },
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "  A client need not store a"
              }
            ],
            "   transport parameter it cannot process.",
            "",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "90e18a9c2417b1d8",
                  "ae6dac1934fa1c19"
                ],
                "status_id": 13,
                "text": "A client MUST NOT use remembered values for the following parameters:"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "90e18a9c2417b1d8",
                  "ae6dac1934fa1c19"
                ],
                "status_id": 13,
                "text": "ack_delay_exponent, max_ack_delay, initial_source_connection_id,"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "90e18a9c2417b1d8",
                  "ae6dac1934fa1c19"
                ],
                "status_id": 13,
                "text": "original_destination_connection_id, preferred_address,"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "90e18a9c2417b1d8",
                  "ae6dac1934fa1c19"
                ],
                "status_id": 13,
                "text": "retry_source_connection_id, and stateless_reset_token."
              },
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "  "
              },
              {
                "annotation_ids": [
                  "8e642162d234c2a3",
                  "188a3c4f6c92e011"
                ],
                "status_id": 17,
                "text": "The client"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "8e642162d234c2a3",
                  "188a3c4f6c92e011"
                ],
                "status_id": 17,
                "text": "MUST use the server's new values in the handshake instead; if the"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "8e642162d234c2a3",
                  "188a3c4f6c92e011"
                ],
                "status_id": 17,
                "text": "server does not provide new values, the default values are used."
              }
            ],
            "",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "2f7b865428565035",
                  "ec08d5bc9e1d585e"
                ],
                "status_id": 17,
                "text": "A client that attempts to send 0-RTT data MUST remember all other"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "2f7b865428565035",
                  "ec08d5bc9e1d585e"
                ],
                "status_id": 17,
                "text": "transport parameters used by the server that it is able to process."
              }
            ],
            "   The server can remember these transport parameters or can store an",
            "   integrity-protected copy of the values in the ticket and recover the",
            "   information when accepting 0-RTT data.  A server uses the transport",
            "   parameters in determining whether to accept 0-RTT data.",
            "",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "741f4a92e4f279aa",
                  "faf830d34773918b"
                ],
                "status_id": 17,
                "text": "If 0-RTT data is accepted by the server, the server MUST NOT reduce"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "741f4a92e4f279aa",
                  "faf830d34773918b"
                ],
                "status_id": 17,
                "text": "any limits or alter any values that might be violated by the client"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "741f4a92e4f279aa",
                  "faf830d34773918b"
                ],
                "status_id": 17,
                "text": "with its 0-RTT data."
              },
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "  "
              },
              {
                "annotation_ids": [
                  "29028a761b630927",
                  "315954f0ead4745a"
                ],
                "status_id": 17,
                "text": "In particular, a server that accepts 0-RTT data"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "29028a761b630927",
                  "315954f0ead4745a"
                ],
                "status_id": 17,
                "text": "MUST NOT set values for the following parameters (Section 18.2) that"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "29028a761b630927",
                  "315954f0ead4745a"
                ],
                "status_id": 17,
                "text": "are smaller than the remembered values of the parameters."
              }
            ],
            "",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "435b4dd8202f364c"
                ],
                "status_id": 1,
                "text": "*  active_connection_id_limit"
              }
            ],
            "",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "435b4dd8202f364c"
                ],
                "status_id": 1,
                "text": "*  initial_max_data"
              }
            ],
            "",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "435b4dd8202f364c"
                ],
                "status_id": 1,
                "text": "*  initial_max_stream_data_bidi_local"
              }
            ],
            "",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "435b4dd8202f364c"
                ],
                "status_id": 1,
                "text": "*  initial_max_stream_data_bidi_remote"
              }
            ],
            "",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "435b4dd8202f364c"
                ],
                "status_id": 1,
                "text": "*  initial_max_stream_data_uni"
              }
            ],
            "",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "435b4dd8202f364c"
                ],
                "status_id": 1,
                "text": "*  initial_max_streams_bidi"
              }
            ],
            "",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "435b4dd8202f364c"
                ],
                "status_id": 1,
                "text": "*  initial_max_streams_uni"
              }
            ],
            "",
            "   Omitting or setting a zero value for certain transport parameters can",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   result in 0-RTT data being enabled but not usable.  "
              },
              {
                "annotation_ids": [
                  "96a82e6227e82455",
                  "8e335eaf66161795"
                ],
                "status_id": 18,
                "text": "The applicable"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "96a82e6227e82455",
                  "8e335eaf66161795"
                ],
                "status_id": 18,
                "text": "subset of transport parameters that permit the sending of application"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "96a82e6227e82455",
                  "8e335eaf66161795"
                ],
                "status_id": 18,
                "text": "data SHOULD be set to non-zero values for 0-RTT."
              },
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "  This includes"
              }
            ],
            "   initial_max_data and either (1) initial_max_streams_bidi and",
            "   initial_max_stream_data_bidi_remote or (2) initial_max_streams_uni",
            "   and initial_max_stream_data_uni.",
            "",
            "   A server might provide larger initial stream flow control limits for",
            "   streams than the remembered values that a client applies when sending",
            "   0-RTT.  Once the handshake completes, the client updates the flow",
            "   control limits on all sending streams using the updated values of",
            "   initial_max_stream_data_bidi_remote and initial_max_stream_data_uni.",
            "",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "262ad79b41105aeb",
                  "d5b0fd0684115e30"
                ],
                "status_id": 16,
                "text": "A server MAY store and recover the previously sent values of the"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "262ad79b41105aeb",
                  "d5b0fd0684115e30"
                ],
                "status_id": 16,
                "text": "max_idle_timeout, max_udp_payload_size, and disable_active_migration"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "262ad79b41105aeb",
                  "d5b0fd0684115e30"
                ],
                "status_id": 16,
                "text": "parameters and reject 0-RTT if it selects smaller values."
              },
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "  Lowering"
              }
            ],
            "   the values of these parameters while also accepting 0-RTT data could",
            "   degrade the performance of the connection.  Specifically, lowering",
            "   the max_udp_payload_size could result in dropped packets, leading to",
            "   worse performance compared to rejecting 0-RTT data outright.",
            "",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "2ad7f0989135654d",
                  "d1f1148f9998baa7"
                ],
                "status_id": 17,
                "text": "A server MUST reject 0-RTT data if the restored values for transport"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "2ad7f0989135654d",
                  "d1f1148f9998baa7"
                ],
                "status_id": 17,
                "text": "parameters cannot be supported."
              }
            ],
            "",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "e33b60768e4b641a",
                  "79efd0b0d80a2ca8",
                  "2510c95c3460e386"
                ],
                "status_id": 17,
                "text": "When sending frames in 0-RTT packets, a client MUST only use"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "e33b60768e4b641a",
                  "79efd0b0d80a2ca8",
                  "2510c95c3460e386"
                ],
                "status_id": 17,
                "text": "remembered transport parameters;"
              },
              {
                "annotation_ids": [
                  "79efd0b0d80a2ca8",
                  "2510c95c3460e386"
                ],
                "status_id": 20,
                "text": " "
              },
              {
                "annotation_ids": [
                  "7900a365f0a1106f",
                  "79efd0b0d80a2ca8",
                  "2510c95c3460e386"
                ],
                "status_id": 17,
                "text": "importantly, it MUST NOT use updated"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "7900a365f0a1106f",
                  "79efd0b0d80a2ca8",
                  "2510c95c3460e386"
                ],
                "status_id": 17,
                "text": "values that it learns from the server's updated transport parameters"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "7900a365f0a1106f",
                  "79efd0b0d80a2ca8",
                  "2510c95c3460e386"
                ],
                "status_id": 17,
                "text": "or from frames received in 1-RTT packets."
              },
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "  Updated values of"
              }
            ],
            "   transport parameters from the handshake apply only to 1-RTT packets.",
            "   For instance, flow control limits from remembered transport",
            "   parameters apply to all 0-RTT packets even if those values are",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   increased by the handshake or by frames sent in 1-RTT packets.  "
              },
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "A"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "d1ca043d0b9278ad",
                  "3968b54f2da889ec"
                ],
                "status_id": 16,
                "text": "server MAY treat the use of updated transport parameters in 0-RTT as"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "d1ca043d0b9278ad",
                  "3968b54f2da889ec"
                ],
                "status_id": 16,
                "text": "a connection error of type PROTOCOL_VIOLATION."
              }
            ]
          ],
          "requirements": [
            "862b0c8ce9f2e1a9",
            "862b0c8ce9f2e1a9",
            "862b0c8ce9f2e1a9",
            "ae6dac1934fa1c19",
            "ae6dac1934fa1c19",
            "ae6dac1934fa1c19",
            "ae6dac1934fa1c19",
            "188a3c4f6c92e011",
            "188a3c4f6c92e011",
            "188a3c4f6c92e011",
            "ec08d5bc9e1d585e",
            "ec08d5bc9e1d585e",
            "faf830d34773918b",
            "faf830d34773918b",
            "faf830d34773918b",
            "315954f0ead4745a",
            "315954f0ead4745a",
            "315954f0ead4745a",
            "8e335eaf66161795",
            "8e335eaf66161795",
            "8e335eaf66161795",
            "d5b0fd0684115e30",
            "d5b0fd0684115e30",
            "d5b0fd0684115e30",
            "d1f1148f9998baa7",
            "d1f1148f9998baa7",
            "79efd0b0d80a2ca8",
            "79efd0b0d80a2ca8",
            "79efd0b0d80a2ca8",
            "79efd0b0d80a2ca8",
            "2510c95c3460e386",
            "2510c95c3460e386",
            "2510c95c3460e386",
            "2510c95c3460e386",
            "3968b54f2da889ec",
            "3968b54f2da889ec",
            "3968b54f2da889ec"
          ],
          "title": "Values of Transport Parameters for 0-RTT"
        },
        {
          "id": "section-7.4.2",
          "lines": [
            "   New transport parameters can be used to negotiate new protocol",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   behavior.  "
              },
              {
                "annotation_ids": [
                  "ea80a77f68ecbe8c",
                  "5e4e2c26b07e9916",
                  "51936c9c2d59aea9"
                ],
                "status_id": 9,
                "text": "An endpoint MUST ignore transport parameters that it does"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "ea80a77f68ecbe8c",
                  "5e4e2c26b07e9916",
                  "51936c9c2d59aea9"
                ],
                "status_id": 9,
                "text": "not support."
              },
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "  The absence of a transport parameter therefore disables"
              }
            ],
            "   any optional protocol feature that is negotiated using the parameter.",
            "   As described in Section 18.1, some identifiers are reserved in order",
            "   to exercise this requirement.",
            "",
            "   A client that does not understand a transport parameter can discard",
            "   it and attempt 0-RTT on subsequent connections.  However, if the",
            "   client adds support for a discarded transport parameter, it risks",
            "   violating the constraints that the transport parameter establishes if",
            "   it attempts 0-RTT.  New transport parameters can avoid this problem",
            "   by setting a default of the most conservative value.  Clients can",
            "   avoid this problem by remembering all parameters, even those not",
            "   currently supported.",
            "",
            "   New transport parameters can be registered according to the rules in",
            "   Section 22.3."
          ],
          "requirements": [
            "51936c9c2d59aea9",
            "51936c9c2d59aea9"
          ],
          "title": "New Transport Parameters"
        },
        {
          "id": "section-7.5",
          "lines": [
            "   Implementations need to maintain a buffer of CRYPTO data received out",
            "   of order.  Because there is no flow control of CRYPTO frames, an",
            "   endpoint could potentially force its peer to buffer an unbounded",
            "   amount of data.",
            "",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "3d3191b378c5373d",
                  "7face8d5de0871a2"
                ],
                "status_id": 17,
                "text": "Implementations MUST support buffering at least 4096 bytes of data"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "3d3191b378c5373d",
                  "7face8d5de0871a2"
                ],
                "status_id": 17,
                "text": "received in out-of-order CRYPTO frames."
              },
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "  "
              },
              {
                "annotation_ids": [
                  "db97e23e689311b1",
                  "5f9a64e6a8e9520f"
                ],
                "status_id": 16,
                "text": "Endpoints MAY choose to"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "db97e23e689311b1",
                  "5f9a64e6a8e9520f"
                ],
                "status_id": 16,
                "text": "allow more data to be buffered during the handshake."
              },
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "  A larger limit"
              }
            ],
            "   during the handshake could allow for larger keys or credentials to be",
            "   exchanged.  An endpoint's buffer size does not need to remain",
            "   constant during the life of the connection.",
            "",
            "   Being unable to buffer CRYPTO frames during the handshake can lead to",
            "   a connection failure.  If an endpoint's buffer is exceeded during the",
            "   handshake, it can expand its buffer temporarily to complete the",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   handshake.  "
              },
              {
                "annotation_ids": [
                  "6b9c83d6e70e838f",
                  "ca234ef0fdd304e3"
                ],
                "status_id": 13,
                "text": "If an endpoint does not expand its buffer, it MUST close"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "6b9c83d6e70e838f",
                  "ca234ef0fdd304e3"
                ],
                "status_id": 13,
                "text": "the connection with a CRYPTO_BUFFER_EXCEEDED error code."
              }
            ],
            "",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "d91119c5d7dd17cb",
                  "00428dab814b2995"
                ],
                "status_id": 19,
                "text": "Once the handshake completes, if an endpoint is unable to buffer all"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "d91119c5d7dd17cb",
                  "00428dab814b2995"
                ],
                "status_id": 19,
                "text": "data in a CRYPTO frame, it MAY discard that CRYPTO frame and all"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "d91119c5d7dd17cb",
                  "00428dab814b2995"
                ],
                "status_id": 19,
                "text": "CRYPTO frames received in the future, or it MAY close the connection"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "d91119c5d7dd17cb",
                  "00428dab814b2995"
                ],
                "status_id": 19,
                "text": "with a CRYPTO_BUFFER_EXCEEDED error code."
              },
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "  "
              },
              {
                "annotation_ids": [
                  "ae5492c2f08aa429",
                  "db107f9862c3b493"
                ],
                "status_id": 13,
                "text": "Packets containing"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "ae5492c2f08aa429",
                  "db107f9862c3b493"
                ],
                "status_id": 13,
                "text": "discarded CRYPTO frames MUST be acknowledged because the packet has"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "ae5492c2f08aa429",
                  "db107f9862c3b493"
                ],
                "status_id": 13,
                "text": "been received and processed by the transport even though the CRYPTO"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "ae5492c2f08aa429",
                  "db107f9862c3b493"
                ],
                "status_id": 13,
                "text": "frame was discarded."
              }
            ]
          ],
          "requirements": [
            "7face8d5de0871a2",
            "7face8d5de0871a2",
            "5f9a64e6a8e9520f",
            "5f9a64e6a8e9520f",
            "ca234ef0fdd304e3",
            "ca234ef0fdd304e3",
            "d91119c5d7dd17cb",
            "d91119c5d7dd17cb",
            "d91119c5d7dd17cb",
            "d91119c5d7dd17cb",
            "00428dab814b2995",
            "00428dab814b2995",
            "00428dab814b2995",
            "00428dab814b2995",
            "db107f9862c3b493",
            "db107f9862c3b493",
            "db107f9862c3b493",
            "db107f9862c3b493"
          ],
          "title": "Cryptographic Message Buffering"
        },
        {
          "id": "section-8",
          "lines": [
            "   Address validation ensures that an endpoint cannot be used for a",
            "   traffic amplification attack.  In such an attack, a packet is sent to",
            "   a server with spoofed source address information that identifies a",
            "   victim.  If a server generates more or larger packets in response to",
            "   that packet, the attacker can use the server to send more data toward",
            "   the victim than it would be able to send on its own.",
            "",
            "   The primary defense against amplification attacks is verifying that a",
            "   peer is able to receive packets at the transport address that it",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   claims.  "
              },
              {
                "annotation_ids": [
                  "759f1f4b47b5789b"
                ],
                "status_id": 20,
                "text": "Therefore, after receiving packets from an address that is"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "759f1f4b47b5789b"
                ],
                "status_id": 20,
                "text": "not yet validated, an endpoint MUST limit the amount of data it sends"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "759f1f4b47b5789b"
                ],
                "status_id": 20,
                "text": "to the unvalidated address to three times the amount of data received"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "759f1f4b47b5789b"
                ],
                "status_id": 20,
                "text": "from that address."
              },
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "  This limit on the size of responses is known as"
              }
            ],
            "   the anti-amplification limit.",
            "",
            "   Address validation is performed both during connection establishment",
            "   (see Section 8.1) and during connection migration (see Section 8.2)."
          ],
          "requirements": [
            "759f1f4b47b5789b",
            "759f1f4b47b5789b",
            "759f1f4b47b5789b",
            "759f1f4b47b5789b"
          ],
          "title": "Address Validation"
        },
        {
          "id": "section-8.1",
          "lines": [
            "   Connection establishment implicitly provides address validation for",
            "   both endpoints.  In particular, receipt of a packet protected with",
            "   Handshake keys confirms that the peer successfully processed an",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   Initial packet.  "
              },
              {
                "annotation_ids": [
                  "a8cde0c84996160c"
                ],
                "status_id": 1,
                "text": "Once an endpoint has successfully processed a"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "a8cde0c84996160c"
                ],
                "status_id": 1,
                "text": "Handshake packet from the peer, it can consider the peer address to"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "a8cde0c84996160c"
                ],
                "status_id": 1,
                "text": "have been validated."
              }
            ],
            "",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "f358ba6cbd26a532",
                  "f73eb8758714ea1f"
                ],
                "status_id": 16,
                "text": "Additionally, an endpoint MAY consider the peer address validated if"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "f358ba6cbd26a532",
                  "f73eb8758714ea1f"
                ],
                "status_id": 16,
                "text": "the peer uses a connection ID chosen by the endpoint and the"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "f358ba6cbd26a532",
                  "f73eb8758714ea1f"
                ],
                "status_id": 16,
                "text": "connection ID contains at least 64 bits of entropy"
              },
              {
                "annotation_ids": [
                  "f73eb8758714ea1f"
                ],
                "status_id": 19,
                "text": "."
              }
            ],
            "",
            "   For the client, the value of the Destination Connection ID field in",
            "   its first Initial packet allows it to validate the server address as",
            "   a part of successfully processing any packet.  Initial packets from",
            "   the server are protected with keys that are derived from this value",
            "   (see Section 5.2 of [QUIC-TLS]).  Alternatively, the value is echoed",
            "   by the server in Version Negotiation packets (Section 6) or included",
            "   in the Integrity Tag in Retry packets (Section 5.8 of [QUIC-TLS]).",
            "",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "07b9ab0a21dc0219",
                  "455cc33b7752c76a",
                  "1477ffdeb88b13d4",
                  "341905c3b7567338",
                  "7b2c31893845ee0b",
                  "aa37490c7b31a27e"
                ],
                "status_id": 9,
                "text": "Prior to validating the client address, servers MUST NOT send more"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "07b9ab0a21dc0219",
                  "455cc33b7752c76a",
                  "1477ffdeb88b13d4",
                  "341905c3b7567338",
                  "7b2c31893845ee0b",
                  "aa37490c7b31a27e"
                ],
                "status_id": 9,
                "text": "than three times as many bytes as the number of bytes they have"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "07b9ab0a21dc0219",
                  "455cc33b7752c76a",
                  "1477ffdeb88b13d4",
                  "341905c3b7567338",
                  "7b2c31893845ee0b",
                  "aa37490c7b31a27e"
                ],
                "status_id": 9,
                "text": "received."
              },
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "  This limits the magnitude of any amplification attack that"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   can be mounted using spoofed source addresses.  "
              },
              {
                "annotation_ids": [
                  "e12d371ed8e7c309",
                  "ab70519a2ef4b090",
                  "71cef84febf640e9"
                ],
                "status_id": 9,
                "text": "For the purposes of"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "e12d371ed8e7c309",
                  "ab70519a2ef4b090",
                  "71cef84febf640e9"
                ],
                "status_id": 9,
                "text": "avoiding amplification prior to address validation, servers MUST"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "e12d371ed8e7c309",
                  "ab70519a2ef4b090",
                  "71cef84febf640e9"
                ],
                "status_id": 9,
                "text": "count all of the payload bytes received in datagrams that are"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "e12d371ed8e7c309",
                  "ab70519a2ef4b090",
                  "71cef84febf640e9"
                ],
                "status_id": 9,
                "text": "uniquely attributed to a single connection."
              },
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "  This includes datagrams"
              }
            ],
            "   that contain packets that are successfully processed and datagrams",
            "   that contain packets that are all discarded.",
            "",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "661356bd61952db2",
                  "351eca2725b999ab",
                  "63020251b982e31c"
                ],
                "status_id": 17,
                "text": "Clients MUST ensure that UDP datagrams containing Initial packets"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "661356bd61952db2",
                  "351eca2725b999ab",
                  "63020251b982e31c"
                ],
                "status_id": 17,
                "text": "have UDP payloads of at least 1200 bytes, adding PADDING frames as"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "661356bd61952db2",
                  "351eca2725b999ab",
                  "63020251b982e31c"
                ],
                "status_id": 17,
                "text": "necessary."
              },
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "  A client that sends padded datagrams allows the server to"
              }
            ],
            "   send more data prior to completing address validation.",
            "",
            "   Loss of an Initial or Handshake packet from the server can cause a",
            "   deadlock if the client does not send additional Initial or Handshake",
            "   packets.  A deadlock could occur when the server reaches its anti-",
            "   amplification limit and the client has received acknowledgments for",
            "   all the data it has sent.  In this case, when the client has no",
            "   reason to send additional packets, the server will be unable to send",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   more data because it has not validated the client's address.  "
              },
              {
                "annotation_ids": [
                  "d01ca7a78b3fbd7f",
                  "a861ba0bc5031f59"
                ],
                "status_id": 17,
                "text": "To"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "d01ca7a78b3fbd7f",
                  "a861ba0bc5031f59"
                ],
                "status_id": 17,
                "text": "prevent this deadlock, clients MUST send a packet on a Probe Timeout"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "d01ca7a78b3fbd7f",
                  "a861ba0bc5031f59"
                ],
                "status_id": 17,
                "text": "(PTO); see Section 6.2 of [QUIC-RECOVERY]."
              },
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "  "
              },
              {
                "annotation_ids": [
                  "07b7690ba4555b73",
                  "471714743cde72f3"
                ],
                "status_id": 17,
                "text": "Specifically, the client"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "07b7690ba4555b73",
                  "471714743cde72f3"
                ],
                "status_id": 17,
                "text": "MUST send an Initial packet in a UDP datagram that contains at least"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "07b7690ba4555b73",
                  "471714743cde72f3"
                ],
                "status_id": 17,
                "text": "1200 bytes if it does not have Handshake keys, and otherwise send a"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "07b7690ba4555b73",
                  "471714743cde72f3"
                ],
                "status_id": 17,
                "text": "Handshake packet."
              }
            ],
            "",
            "   A server might wish to validate the client address before starting",
            "   the cryptographic handshake.  QUIC uses a token in the Initial packet",
            "   to provide address validation prior to completing the handshake.",
            "   This token is delivered to the client during connection establishment",
            "   with a Retry packet (see Section 8.1.2) or in a previous connection",
            "   using the NEW_TOKEN frame (see Section 8.1.3).",
            "",
            "   In addition to sending limits imposed prior to address validation,",
            "   servers are also constrained in what they can send by the limits set",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   by the congestion controller.  "
              },
              {
                "annotation_ids": [
                  "36471cf7b4e35a75"
                ],
                "status_id": 1,
                "text": "Clients are only constrained by the"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "36471cf7b4e35a75"
                ],
                "status_id": 1,
                "text": "congestion controller."
              }
            ]
          ],
          "requirements": [
            "f73eb8758714ea1f",
            "f73eb8758714ea1f",
            "f73eb8758714ea1f",
            "aa37490c7b31a27e",
            "aa37490c7b31a27e",
            "aa37490c7b31a27e",
            "71cef84febf640e9",
            "71cef84febf640e9",
            "71cef84febf640e9",
            "71cef84febf640e9",
            "63020251b982e31c",
            "63020251b982e31c",
            "63020251b982e31c",
            "a861ba0bc5031f59",
            "a861ba0bc5031f59",
            "a861ba0bc5031f59",
            "471714743cde72f3",
            "471714743cde72f3",
            "471714743cde72f3",
            "471714743cde72f3"
          ],
          "title": "Address Validation during Connection Establishment"
        },
        {
          "id": "section-8.1.1",
          "lines": [
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "9d6868339d4d2733",
                  "8cf3402472674bd5",
                  "71d3a7c6ce984ac1"
                ],
                "status_id": 9,
                "text": "A token sent in a NEW_TOKEN frame or a Retry packet MUST be"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "9d6868339d4d2733",
                  "8cf3402472674bd5",
                  "71d3a7c6ce984ac1"
                ],
                "status_id": 9,
                "text": "constructed in a way that allows the server to identify how it was"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "9d6868339d4d2733",
                  "8cf3402472674bd5",
                  "71d3a7c6ce984ac1"
                ],
                "status_id": 9,
                "text": "provided to a client."
              },
              {
                "annotation_ids": [
                  "9d6868339d4d2733"
                ],
                "status_id": 1,
                "text": "  These tokens are carried in the same field but"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "9d6868339d4d2733"
                ],
                "status_id": 1,
                "text": "require different handling from servers."
              }
            ]
          ],
          "requirements": [
            "71d3a7c6ce984ac1",
            "71d3a7c6ce984ac1",
            "71d3a7c6ce984ac1"
          ],
          "title": "Token Construction"
        },
        {
          "id": "section-8.1.2",
          "lines": [
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "be5cf89eb19c4a0e"
                ],
                "status_id": 1,
                "text": "Upon receiving the client's Initial packet, the server can request"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "be5cf89eb19c4a0e"
                ],
                "status_id": 1,
                "text": "address validation by sending a Retry packet (Section 17.2.5)"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "be5cf89eb19c4a0e"
                ],
                "status_id": 1,
                "text": "containing a token."
              },
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "  "
              },
              {
                "annotation_ids": [
                  "0977e2c2749798d3",
                  "353d645ea4ce2f44"
                ],
                "status_id": 17,
                "text": "This token MUST be repeated by the client in all"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "0977e2c2749798d3",
                  "353d645ea4ce2f44"
                ],
                "status_id": 17,
                "text": "Initial packets it sends for that connection after it receives the"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "0977e2c2749798d3",
                  "353d645ea4ce2f44"
                ],
                "status_id": 17,
                "text": "Retry packet."
              }
            ],
            "",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "0a6d6dd469eb11f6"
                ],
                "status_id": 1,
                "text": "In response to processing an Initial packet containing a token that"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "0a6d6dd469eb11f6"
                ],
                "status_id": 1,
                "text": "was provided in a Retry packet, a server cannot send another Retry"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "0a6d6dd469eb11f6"
                ],
                "status_id": 1,
                "text": "packet; it can only refuse the connection or permit it to proceed."
              }
            ],
            "",
            "   As long as it is not possible for an attacker to generate a valid",
            "   token for its own address (see Section 8.1.4) and the client is able",
            "   to return that token, it proves to the server that it received the",
            "   token.",
            "",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "80c3c18db520d059"
                ],
                "status_id": 1,
                "text": "A server can also use a Retry packet to defer the state and"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "80c3c18db520d059"
                ],
                "status_id": 1,
                "text": "processing costs of connection establishment.  "
              },
              {
                "annotation_ids": [
                  "668eb355034f445b",
                  "80c3c18db520d059"
                ],
                "status_id": 1,
                "text": "Requiring the server"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "668eb355034f445b",
                  "80c3c18db520d059"
                ],
                "status_id": 1,
                "text": "to provide a different connection ID, along with the"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "668eb355034f445b",
                  "80c3c18db520d059"
                ],
                "status_id": 1,
                "text": "original_destination_connection_id transport parameter defined in"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "668eb355034f445b",
                  "80c3c18db520d059"
                ],
                "status_id": 1,
                "text": "Section 18.2, forces the server to demonstrate that it, or an entity"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "668eb355034f445b",
                  "80c3c18db520d059"
                ],
                "status_id": 1,
                "text": "it cooperates with, received the original Initial packet from the"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "668eb355034f445b",
                  "80c3c18db520d059"
                ],
                "status_id": 1,
                "text": "client."
              },
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "  Providing a different connection ID also grants a server"
              }
            ],
            "   some control over how subsequent packets are routed.  This can be",
            "   used to direct connections to a different server instance.",
            "",
            "   If a server receives a client Initial that contains an invalid Retry",
            "   token but is otherwise valid, it knows the client will not accept",
            "   another Retry token.  The server can discard such a packet and allow",
            "   the client to time out to detect handshake failure, but that could",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   impose a significant latency penalty on the client.  "
              },
              {
                "annotation_ids": [
                  "f65434525636c2d3",
                  "dbbe3928fca8abc3"
                ],
                "status_id": 18,
                "text": "Instead, the"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "f65434525636c2d3",
                  "dbbe3928fca8abc3"
                ],
                "status_id": 18,
                "text": "server SHOULD immediately close (Section 10.2) the connection with an"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "f65434525636c2d3",
                  "dbbe3928fca8abc3"
                ],
                "status_id": 18,
                "text": "INVALID_TOKEN error."
              },
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "  Note that a server has not established any"
              }
            ],
            "   state for the connection at this point and so does not enter the",
            "   closing period.",
            "",
            "   A flow showing the use of a Retry packet is shown in Figure 9.",
            "",
            "   Client                                                  Server",
            "",
            "   Initial[0]: CRYPTO[CH] ->",
            "",
            "                                                   <- Retry+Token",
            "",
            "   Initial+Token[1]: CRYPTO[CH] ->",
            "",
            "                                    Initial[0]: CRYPTO[SH] ACK[1]",
            "                          Handshake[0]: CRYPTO[EE, CERT, CV, FIN]",
            "                                    <- 1-RTT[0]: STREAM[1, \"...\"]",
            "",
            "                   Figure 9: Example Handshake with Retry"
          ],
          "requirements": [
            "353d645ea4ce2f44",
            "353d645ea4ce2f44",
            "353d645ea4ce2f44",
            "dbbe3928fca8abc3",
            "dbbe3928fca8abc3",
            "dbbe3928fca8abc3"
          ],
          "title": "Address Validation Using Retry Packets"
        },
        {
          "id": "section-8.1.3",
          "lines": [
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "6a8999883bf39233",
                  "0725264c3c86457f",
                  "994fe138c7458c7c"
                ],
                "status_id": 16,
                "text": "A server MAY provide clients with an address validation token during"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "6a8999883bf39233",
                  "0725264c3c86457f",
                  "994fe138c7458c7c"
                ],
                "status_id": 16,
                "text": "one connection that can be used on a subsequent connection."
              },
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "  Address"
              }
            ],
            "   validation is especially important with 0-RTT because a server",
            "   potentially sends a significant amount of data to a client in",
            "   response to 0-RTT data.",
            "",
            "   The server uses the NEW_TOKEN frame (Section 19.7) to provide the",
            "   client with an address validation token that can be used to validate",
            "   future connections.  In a future connection, the client includes this",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   token in Initial packets to provide address validation.  "
              },
              {
                "annotation_ids": [
                  "0e7bcc54e42d9d64"
                ],
                "status_id": 20,
                "text": "The client"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "0e7bcc54e42d9d64"
                ],
                "status_id": 20,
                "text": "MUST include the token in all Initial packets it sends, unless a"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "0e7bcc54e42d9d64"
                ],
                "status_id": 20,
                "text": "Retry replaces the token with a newer one."
              },
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "  "
              },
              {
                "annotation_ids": [
                  "0e5eba6339c834e3"
                ],
                "status_id": 20,
                "text": "The client MUST NOT use"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "0e5eba6339c834e3"
                ],
                "status_id": 20,
                "text": "the token provided in a Retry for future connections."
              },
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "  "
              },
              {
                "annotation_ids": [
                  "489475a9aa3acc0c",
                  "35d2dfe2e060b1e1"
                ],
                "status_id": 21,
                "text": "Servers MAY"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "489475a9aa3acc0c",
                  "35d2dfe2e060b1e1"
                ],
                "status_id": 21,
                "text": "discard any Initial packet that does not carry the expected token."
              }
            ],
            "",
            "   Unlike the token that is created for a Retry packet, which is used",
            "   immediately, the token sent in the NEW_TOKEN frame can be used after",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   some period of time has passed.  "
              },
              {
                "annotation_ids": [
                  "dc970aea011be634",
                  "ff498c10212efd75",
                  "ed1a12bd47bc95c4"
                ],
                "status_id": 8,
                "text": "Thus, a token SHOULD have an"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "dc970aea011be634",
                  "ff498c10212efd75",
                  "ed1a12bd47bc95c4"
                ],
                "status_id": 8,
                "text": "expiration time, which could be either an explicit expiration time or"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "dc970aea011be634",
                  "ff498c10212efd75",
                  "ed1a12bd47bc95c4"
                ],
                "status_id": 8,
                "text": "an issued timestamp that can be used to dynamically calculate the"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "dc970aea011be634",
                  "ff498c10212efd75",
                  "ed1a12bd47bc95c4"
                ],
                "status_id": 8,
                "text": "expiration time."
              },
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "  A server can store the expiration time or include"
              }
            ],
            "   it in an encrypted form in the token.",
            "",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "8ade60299d731d06",
                  "2bc71f468317fd7a"
                ],
                "status_id": 17,
                "text": "A token issued with NEW_TOKEN MUST NOT include information that would"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "8ade60299d731d06",
                  "2bc71f468317fd7a"
                ],
                "status_id": 17,
                "text": "allow values to be linked by an observer to the connection on which"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "8ade60299d731d06",
                  "2bc71f468317fd7a"
                ],
                "status_id": 17,
                "text": "it was issued."
              },
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "  For example, it cannot include the previous"
              }
            ],
            "   connection ID or addressing information, unless the values are",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   encrypted.  "
              },
              {
                "annotation_ids": [
                  "3e37a73b0f9e3b35",
                  "b70bb6f5f1674cdb"
                ],
                "status_id": 17,
                "text": "A server MUST ensure that every NEW_TOKEN frame it sends"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "3e37a73b0f9e3b35",
                  "b70bb6f5f1674cdb"
                ],
                "status_id": 17,
                "text": "is unique across all clients, with the exception of those sent to"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "3e37a73b0f9e3b35",
                  "b70bb6f5f1674cdb"
                ],
                "status_id": 17,
                "text": "repair losses of previously sent NEW_TOKEN frames."
              },
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "  "
              },
              {
                "annotation_ids": [
                  "c58aba4ba811afc7",
                  "303a6b1f2f346ea8"
                ],
                "status_id": 21,
                "text": "Information that"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "c58aba4ba811afc7",
                  "303a6b1f2f346ea8"
                ],
                "status_id": 21,
                "text": "allows the server to distinguish between tokens from Retry and"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "c58aba4ba811afc7",
                  "303a6b1f2f346ea8"
                ],
                "status_id": 21,
                "text": "NEW_TOKEN MAY be accessible to entities other than the server."
              }
            ],
            "",
            "   It is unlikely that the client port number is the same on two",
            "   different connections; validating the port is therefore unlikely to",
            "   be successful.",
            "",
            "   A token received in a NEW_TOKEN frame is applicable to any server",
            "   that the connection is considered authoritative for (e.g., server",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   names included in the certificate).  "
              },
              {
                "annotation_ids": [
                  "f98a8d78c0b98e45",
                  "7c6b217d0fa5c0a0",
                  "60ecf92b3086cc0d"
                ],
                "status_id": 18,
                "text": "When connecting to a server for"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "f98a8d78c0b98e45",
                  "7c6b217d0fa5c0a0",
                  "60ecf92b3086cc0d"
                ],
                "status_id": 18,
                "text": "which the client retains an applicable and unused token, it SHOULD"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "f98a8d78c0b98e45",
                  "7c6b217d0fa5c0a0",
                  "60ecf92b3086cc0d"
                ],
                "status_id": 18,
                "text": "include that token in the Token field of its Initial packet."
              }
            ],
            "   Including a token might allow the server to validate the client",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   address without an additional round trip.  "
              },
              {
                "annotation_ids": [
                  "efb2fe967b04c8ea",
                  "0ce2e93ff63faa16",
                  "8eb4aadbfdb643b5"
                ],
                "status_id": 17,
                "text": "A client MUST NOT include"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "efb2fe967b04c8ea",
                  "0ce2e93ff63faa16",
                  "8eb4aadbfdb643b5"
                ],
                "status_id": 17,
                "text": "a token that is not applicable to the server that it is connecting"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "efb2fe967b04c8ea",
                  "0ce2e93ff63faa16",
                  "8eb4aadbfdb643b5"
                ],
                "status_id": 17,
                "text": "to, unless the client has the knowledge that the server that issued"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "efb2fe967b04c8ea",
                  "0ce2e93ff63faa16",
                  "8eb4aadbfdb643b5"
                ],
                "status_id": 17,
                "text": "the token and the server the client is connecting to are jointly"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "efb2fe967b04c8ea",
                  "0ce2e93ff63faa16",
                  "8eb4aadbfdb643b5"
                ],
                "status_id": 17,
                "text": "managing the tokens."
              },
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "  "
              },
              {
                "annotation_ids": [
                  "86f64a0f44cf0ce4",
                  "7e8fbb9caa31a34d",
                  "a1ca34ed499a3d44"
                ],
                "status_id": 16,
                "text": "A client MAY use a token from any previous"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "86f64a0f44cf0ce4",
                  "7e8fbb9caa31a34d",
                  "a1ca34ed499a3d44"
                ],
                "status_id": 16,
                "text": "connection to that server."
              }
            ],
            "",
            "   A token allows a server to correlate activity between the connection",
            "   where the token was issued and any connection where it is used.",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "4af236aead5fa324"
                ],
                "status_id": 5,
                "text": "Clients that want to break continuity of identity with a server can"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "4af236aead5fa324"
                ],
                "status_id": 5,
                "text": "discard tokens provided using the NEW_TOKEN frame."
              },
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "  "
              },
              {
                "annotation_ids": [
                  "fd1c522ddbfcc140",
                  "162bb9786dcca53c"
                ],
                "status_id": 17,
                "text": "In comparison, a"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "fd1c522ddbfcc140",
                  "162bb9786dcca53c"
                ],
                "status_id": 17,
                "text": "token obtained in a Retry packet MUST be used immediately during the"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "fd1c522ddbfcc140",
                  "162bb9786dcca53c"
                ],
                "status_id": 17,
                "text": "connection attempt and cannot be used in subsequent connection"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "fd1c522ddbfcc140",
                  "162bb9786dcca53c"
                ],
                "status_id": 17,
                "text": "attempts."
              }
            ],
            "",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "c519f7471abbe58e",
                  "c0b7826069e6dbd3"
                ],
                "status_id": 18,
                "text": "A client SHOULD NOT reuse a token from a NEW_TOKEN frame for"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "c519f7471abbe58e",
                  "c0b7826069e6dbd3"
                ],
                "status_id": 18,
                "text": "different connection attempts."
              },
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "  Reusing a token allows connections to"
              }
            ],
            "   be linked by entities on the network path; see Section 9.5.",
            "",
            "   Clients might receive multiple tokens on a single connection.  Aside",
            "   from preventing linkability, any token can be used in any connection",
            "   attempt.  Servers can send additional tokens to either enable address",
            "   validation for multiple connection attempts or replace older tokens",
            "   that might become invalid.  For a client, this ambiguity means that",
            "   sending the most recent unused token is most likely to be effective.",
            "   Though saving and using older tokens have no negative consequences,",
            "   clients can regard older tokens as being less likely to be useful to",
            "   the server for address validation.",
            "",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "78fa7c6674f4b528",
                  "ae7144619ea50f7b"
                ],
                "status_id": 13,
                "text": "When a server receives an Initial packet with an address validation"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "78fa7c6674f4b528",
                  "ae7144619ea50f7b"
                ],
                "status_id": 13,
                "text": "token, it MUST attempt to validate the token, unless it has already"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "78fa7c6674f4b528",
                  "ae7144619ea50f7b"
                ],
                "status_id": 13,
                "text": "completed address validation."
              },
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "  "
              },
              {
                "annotation_ids": [
                  "797eed39bbbc5f71",
                  "c1d8536d08994770"
                ],
                "status_id": 18,
                "text": "If the token is invalid, then the"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "797eed39bbbc5f71",
                  "c1d8536d08994770"
                ],
                "status_id": 18,
                "text": "server SHOULD proceed as if the client did not have a validated"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "797eed39bbbc5f71",
                  "c1d8536d08994770"
                ],
                "status_id": 18,
                "text": "address, including potentially sending a Retry packet."
              },
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "  Tokens"
              }
            ],
            "   provided with NEW_TOKEN frames and Retry packets can be distinguished",
            "   by servers (see Section 8.1.1), and the latter can be validated more",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   strictly.  "
              },
              {
                "annotation_ids": [
                  "fd44dc126964f41f",
                  "e5c207b8e5cd98a8"
                ],
                "status_id": 22,
                "text": "If the validation succeeds, the server SHOULD then allow"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "fd44dc126964f41f",
                  "e5c207b8e5cd98a8"
                ],
                "status_id": 22,
                "text": "the handshake to proceed."
              }
            ],
            "",
            "      |  Note: The rationale for treating the client as unvalidated",
            "      |  rather than discarding the packet is that the client might have",
            "      |  received the token in a previous connection using the NEW_TOKEN",
            "      |  frame, and if the server has lost state, it might be unable to",
            "      |  validate the token at all, leading to connection failure if the",
            "      |  packet is discarded.",
            "",
            "   In a stateless design, a server can use encrypted and authenticated",
            "   tokens to pass information to clients that the server can later",
            "   recover and use to validate a client address.  Tokens are not",
            "   integrated into the cryptographic handshake, and so they are not",
            "   authenticated.  For instance, a client might be able to reuse a",
            "   token.  To avoid attacks that exploit this property, a server can",
            "   limit its use of tokens to only the information needed to validate",
            "   client addresses.",
            "",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "a218dedb5fb4ecba"
                ],
                "status_id": 19,
                "text": "Clients MAY use tokens obtained on one connection for any connection"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "a218dedb5fb4ecba"
                ],
                "status_id": 19,
                "text": "attempt using the same version."
              },
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "  When selecting a token to use,"
              }
            ],
            "   clients do not need to consider other properties of the connection",
            "   that is being attempted, including the choice of possible application",
            "   protocols, session tickets, or other connection properties."
          ],
          "requirements": [
            "994fe138c7458c7c",
            "994fe138c7458c7c",
            "0e7bcc54e42d9d64",
            "0e7bcc54e42d9d64",
            "0e7bcc54e42d9d64",
            "0e5eba6339c834e3",
            "0e5eba6339c834e3",
            "35d2dfe2e060b1e1",
            "35d2dfe2e060b1e1",
            "ed1a12bd47bc95c4",
            "ed1a12bd47bc95c4",
            "ed1a12bd47bc95c4",
            "ed1a12bd47bc95c4",
            "2bc71f468317fd7a",
            "2bc71f468317fd7a",
            "2bc71f468317fd7a",
            "b70bb6f5f1674cdb",
            "b70bb6f5f1674cdb",
            "b70bb6f5f1674cdb",
            "303a6b1f2f346ea8",
            "303a6b1f2f346ea8",
            "303a6b1f2f346ea8",
            "60ecf92b3086cc0d",
            "60ecf92b3086cc0d",
            "60ecf92b3086cc0d",
            "8eb4aadbfdb643b5",
            "8eb4aadbfdb643b5",
            "8eb4aadbfdb643b5",
            "8eb4aadbfdb643b5",
            "8eb4aadbfdb643b5",
            "a1ca34ed499a3d44",
            "a1ca34ed499a3d44",
            "162bb9786dcca53c",
            "162bb9786dcca53c",
            "162bb9786dcca53c",
            "162bb9786dcca53c",
            "c0b7826069e6dbd3",
            "c0b7826069e6dbd3",
            "ae7144619ea50f7b",
            "ae7144619ea50f7b",
            "ae7144619ea50f7b",
            "c1d8536d08994770",
            "c1d8536d08994770",
            "c1d8536d08994770",
            "e5c207b8e5cd98a8",
            "e5c207b8e5cd98a8",
            "a218dedb5fb4ecba",
            "a218dedb5fb4ecba"
          ],
          "title": "Address Validation for Future Connections"
        },
        {
          "id": "section-8.1.4",
          "lines": [
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "6438ba3c543a24d4",
                  "9458a7be71207b56"
                ],
                "status_id": 13,
                "text": "An address validation token MUST be difficult to guess."
              },
              {
                "annotation_ids": [
                  "6438ba3c543a24d4"
                ],
                "status_id": 1,
                "text": "  Including a"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "6438ba3c543a24d4"
                ],
                "status_id": 1,
                "text": "random value with at least 128 bits of entropy in the token would be"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "6438ba3c543a24d4"
                ],
                "status_id": 1,
                "text": "sufficient, but this depends on the server remembering the value it"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "6438ba3c543a24d4"
                ],
                "status_id": 1,
                "text": "sends to clients."
              }
            ],
            "",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "952ec3378fbf9b84"
                ],
                "status_id": 1,
                "text": "A token-based scheme allows the server to offload any state"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "952ec3378fbf9b84"
                ],
                "status_id": 1,
                "text": "associated with validation to the client.  "
              },
              {
                "annotation_ids": [
                  "952ec3378fbf9b84",
                  "d0cdf58b7a4121f5",
                  "eb7425a2d3e8b7b8",
                  "7c5d97226cb38562",
                  "d85ca3aeedc41fe9"
                ],
                "status_id": 9,
                "text": "For this design to work,"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "952ec3378fbf9b84",
                  "d0cdf58b7a4121f5",
                  "eb7425a2d3e8b7b8",
                  "7c5d97226cb38562",
                  "d85ca3aeedc41fe9"
                ],
                "status_id": 9,
                "text": "the token MUST be covered by integrity protection against"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "952ec3378fbf9b84",
                  "d0cdf58b7a4121f5",
                  "eb7425a2d3e8b7b8",
                  "7c5d97226cb38562",
                  "d85ca3aeedc41fe9"
                ],
                "status_id": 9,
                "text": "modification or falsification by clients."
              },
              {
                "annotation_ids": [
                  "952ec3378fbf9b84"
                ],
                "status_id": 1,
                "text": "  Without integrity"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "952ec3378fbf9b84"
                ],
                "status_id": 1,
                "text": "protection, malicious clients could generate or guess values for"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "952ec3378fbf9b84"
                ],
                "status_id": 1,
                "text": "tokens that would be accepted by the server.  Only the server"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "952ec3378fbf9b84"
                ],
                "status_id": 1,
                "text": "requires access to the integrity protection key for tokens."
              }
            ],
            "",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "21f9acd69f6e33e8"
                ],
                "status_id": 1,
                "text": "There is no need for a single well-defined format for the token"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "21f9acd69f6e33e8"
                ],
                "status_id": 1,
                "text": "because the server that generates the token also consumes it."
              },
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "  "
              },
              {
                "annotation_ids": [
                  "8ac3a44fbc250d35",
                  "f887ec4c745e4491",
                  "d92efa92267eb1f1"
                ],
                "status_id": 8,
                "text": "Tokens"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "8ac3a44fbc250d35",
                  "f887ec4c745e4491",
                  "d92efa92267eb1f1"
                ],
                "status_id": 8,
                "text": "sent in Retry packets SHOULD include information that allows the"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "8ac3a44fbc250d35",
                  "f887ec4c745e4491",
                  "d92efa92267eb1f1"
                ],
                "status_id": 8,
                "text": "server to verify that the source IP address and port in client"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "8ac3a44fbc250d35",
                  "f887ec4c745e4491",
                  "d92efa92267eb1f1"
                ],
                "status_id": 8,
                "text": "packets remain constant."
              }
            ],
            "",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "77d0b55e5b688c02",
                  "67264e41f40aa2c9"
                ],
                "status_id": 17,
                "text": "Tokens sent in NEW_TOKEN frames MUST include information that allows"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "77d0b55e5b688c02",
                  "67264e41f40aa2c9"
                ],
                "status_id": 17,
                "text": "the server to verify that the client IP address has not changed from"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "77d0b55e5b688c02",
                  "67264e41f40aa2c9"
                ],
                "status_id": 17,
                "text": "when the token was issued."
              },
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "  Servers can use tokens from NEW_TOKEN"
              }
            ],
            "   frames in deciding not to send a Retry packet, even if the client",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   address has changed.  "
              },
              {
                "annotation_ids": [
                  "84d64ae8937ea9cd",
                  "9351028a1c4d3abf",
                  "0e731e9814eda3be",
                  "31f64ea7b5010aac"
                ],
                "status_id": 9,
                "text": "If the client IP address has changed, the"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "84d64ae8937ea9cd",
                  "9351028a1c4d3abf",
                  "0e731e9814eda3be",
                  "31f64ea7b5010aac"
                ],
                "status_id": 9,
                "text": "server MUST adhere to the anti-amplification limit; see Section 8."
              }
            ],
            "   Note that in the presence of NAT, this requirement might be",
            "   insufficient to protect other hosts that share the NAT from",
            "   amplification attacks.",
            "",
            "   Attackers could replay tokens to use servers as amplifiers in DDoS",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   attacks.  "
              },
              {
                "annotation_ids": [
                  "67771d47e52f6a51",
                  "e34c11c4bb6a4c7c",
                  "5bb72c6c6bd2c9d8"
                ],
                "status_id": 9,
                "text": "To protect against such attacks, servers MUST ensure that"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "67771d47e52f6a51",
                  "e34c11c4bb6a4c7c",
                  "5bb72c6c6bd2c9d8"
                ],
                "status_id": 9,
                "text": "replay of tokens is prevented or limited."
              },
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "  "
              },
              {
                "annotation_ids": [
                  "f0f69ad4340d389f",
                  "d7847856d43d7c69",
                  "d4380ee653fd2948"
                ],
                "status_id": 8,
                "text": "Servers SHOULD ensure that"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "f0f69ad4340d389f",
                  "d7847856d43d7c69",
                  "d4380ee653fd2948"
                ],
                "status_id": 8,
                "text": "tokens sent in Retry packets are only accepted for a short time,"
              },
              {
                "annotation_ids": [
                  "d4380ee653fd2948"
                ],
                "status_id": 14,
                "text": " as"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "d4380ee653fd2948"
                ],
                "status_id": 14,
                "text": "they are returned immediately by clients."
              },
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "  "
              },
              {
                "annotation_ids": [
                  "9f5e7c5f7f3cc3f2",
                  "1551c0de35aeab10"
                ],
                "status_id": 18,
                "text": "Tokens that are provided"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "9f5e7c5f7f3cc3f2",
                  "1551c0de35aeab10"
                ],
                "status_id": 18,
                "text": "in NEW_TOKEN frames (Section 19.7) need to be valid for longer but"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "9f5e7c5f7f3cc3f2",
                  "1551c0de35aeab10"
                ],
                "status_id": 18,
                "text": "SHOULD NOT be accepted multiple times."
              },
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "  "
              },
              {
                "annotation_ids": [
                  "b03c0a1813eff965",
                  "dea05e639def30ca"
                ],
                "status_id": 15,
                "text": "Servers are encouraged to"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "b03c0a1813eff965",
                  "dea05e639def30ca"
                ],
                "status_id": 15,
                "text": "allow tokens to be used only once, if possible; tokens MAY include"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "b03c0a1813eff965",
                  "dea05e639def30ca"
                ],
                "status_id": 15,
                "text": "additional information about clients to further narrow applicability"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "b03c0a1813eff965",
                  "dea05e639def30ca"
                ],
                "status_id": 15,
                "text": "or reuse."
              }
            ]
          ],
          "requirements": [
            "9458a7be71207b56",
            "d85ca3aeedc41fe9",
            "d85ca3aeedc41fe9",
            "d85ca3aeedc41fe9",
            "d92efa92267eb1f1",
            "d92efa92267eb1f1",
            "d92efa92267eb1f1",
            "d92efa92267eb1f1",
            "67264e41f40aa2c9",
            "67264e41f40aa2c9",
            "67264e41f40aa2c9",
            "31f64ea7b5010aac",
            "31f64ea7b5010aac",
            "5bb72c6c6bd2c9d8",
            "5bb72c6c6bd2c9d8",
            "d4380ee653fd2948",
            "d4380ee653fd2948",
            "d4380ee653fd2948",
            "1551c0de35aeab10",
            "1551c0de35aeab10",
            "1551c0de35aeab10",
            "dea05e639def30ca",
            "dea05e639def30ca",
            "dea05e639def30ca",
            "dea05e639def30ca"
          ],
          "title": "Address Validation Token Integrity"
        },
        {
          "id": "section-8.2",
          "lines": [
            "   Path validation is used by both peers during connection migration",
            "   (see Section 9) to verify reachability after a change of address.  In",
            "   path validation, endpoints test reachability between a specific local",
            "   address and a specific peer address, where an address is the 2-tuple",
            "   of IP address and port.",
            "",
            "   Path validation tests that packets sent on a path to a peer are",
            "   received by that peer.  Path validation is used to ensure that",
            "   packets received from a migrating peer do not carry a spoofed source",
            "   address.",
            "",
            "   Path validation does not validate that a peer can send in the return",
            "   direction.  Acknowledgments cannot be used for return path validation",
            "   because they contain insufficient entropy and might be spoofed.",
            "   Endpoints independently determine reachability on each direction of a",
            "   path, and therefore return reachability can only be established by",
            "   the peer.",
            "",
            "   Path validation can be used at any time by either endpoint.  For",
            "   instance, an endpoint might check that a peer is still in possession",
            "   of its address after a period of quiescence.",
            "",
            "   Path validation is not designed as a NAT traversal mechanism.  Though",
            "   the mechanism described here might be effective for the creation of",
            "   NAT bindings that support NAT traversal, the expectation is that one",
            "   endpoint is able to receive packets without first having sent a",
            "   packet on that path.  Effective NAT traversal needs additional",
            "   synchronization mechanisms that are not provided here.",
            "",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "83035544fa1aedcc",
                  "873b6f2a7eda39d6",
                  "b17f91b513819600"
                ],
                "status_id": 23,
                "text": "An endpoint MAY include other frames with the PATH_CHALLENGE and"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "83035544fa1aedcc",
                  "873b6f2a7eda39d6",
                  "b17f91b513819600"
                ],
                "status_id": 23,
                "text": "PATH_RESPONSE frames used for path validation."
              },
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "  In particular, an"
              }
            ],
            "   endpoint can include PADDING frames with a PATH_CHALLENGE frame for",
            "   Path Maximum Transmission Unit Discovery (PMTUD); see Section 14.2.1.",
            "   An endpoint can also include its own PATH_CHALLENGE frame when",
            "   sending a PATH_RESPONSE frame.",
            "",
            "   An endpoint uses a new connection ID for probes sent from a new local",
            "   address; see Section 9.5.  When probing a new path, an endpoint can",
            "   ensure that its peer has an unused connection ID available for",
            "   responses.  Sending NEW_CONNECTION_ID and PATH_CHALLENGE frames in",
            "   the same packet, if the peer's active_connection_id_limit permits,",
            "   ensures that an unused connection ID will be available to the peer",
            "   when sending a response.",
            "",
            "   An endpoint can choose to simultaneously probe multiple paths.  The",
            "   number of simultaneous paths used for probes is limited by the number",
            "   of extra connection IDs its peer has previously supplied, since each",
            "   new local address used for a probe requires a previously unused",
            "   connection ID."
          ],
          "requirements": [
            "b17f91b513819600",
            "b17f91b513819600"
          ],
          "title": "Path Validation"
        },
        {
          "id": "section-8.2.1",
          "lines": [
            "   To initiate path validation, an endpoint sends a PATH_CHALLENGE frame",
            "   containing an unpredictable payload on the path to be validated.",
            "",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "a355fa946706a455",
                  "f7e42fa7a8de2da0",
                  "c7fbe5f260c07a43",
                  "68ebca40f233f253"
                ],
                "status_id": 26,
                "text": "An endpoint MAY send multiple PATH_CHALLENGE frames to guard against"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "a355fa946706a455",
                  "f7e42fa7a8de2da0",
                  "c7fbe5f260c07a43",
                  "68ebca40f233f253"
                ],
                "status_id": 26,
                "text": "packet loss."
              },
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "  "
              },
              {
                "annotation_ids": [
                  "b9c2641b4e603aee",
                  "26d9fc3e4651bba4",
                  "c7c8387081fa7acd",
                  "9bcfb9ac8715adc8"
                ],
                "status_id": 27,
                "text": "However, an endpoint SHOULD NOT send multiple"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "b9c2641b4e603aee",
                  "26d9fc3e4651bba4",
                  "c7c8387081fa7acd",
                  "9bcfb9ac8715adc8"
                ],
                "status_id": 27,
                "text": "PATH_CHALLENGE frames in a single packet."
              }
            ],
            "",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "33f6cf477122cae7",
                  "a479346f412d9bed",
                  "8bb726b8e48855fc",
                  "869624b5d1dad408"
                ],
                "status_id": 27,
                "text": "An endpoint SHOULD NOT probe a new path with packets containing a"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "33f6cf477122cae7",
                  "a479346f412d9bed",
                  "8bb726b8e48855fc",
                  "869624b5d1dad408"
                ],
                "status_id": 27,
                "text": "PATH_CHALLENGE frame more frequently than it would send an Initial"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "33f6cf477122cae7",
                  "a479346f412d9bed",
                  "8bb726b8e48855fc",
                  "869624b5d1dad408"
                ],
                "status_id": 27,
                "text": "packet."
              },
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "  This ensures that connection migration is no more load on a"
              }
            ],
            "   new path than establishing a new connection.",
            "",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "225f1c04d74312ea",
                  "ef4aa6a485c5190a",
                  "31fb0d42d34f03b7"
                ],
                "status_id": 9,
                "text": "The endpoint MUST use unpredictable data in every PATH_CHALLENGE"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "225f1c04d74312ea",
                  "ef4aa6a485c5190a",
                  "31fb0d42d34f03b7"
                ],
                "status_id": 9,
                "text": "frame so that it can associate the peer's response with the"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "225f1c04d74312ea",
                  "ef4aa6a485c5190a",
                  "31fb0d42d34f03b7"
                ],
                "status_id": 9,
                "text": "corresponding PATH_CHALLENGE."
              }
            ],
            "",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "ba021aaa35b3b94c",
                  "c5a39e50e76e9820",
                  "5bf05284a438ffd6"
                ],
                "status_id": 25,
                "text": "An endpoint MUST expand datagrams that contain a PATH_CHALLENGE frame"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "ba021aaa35b3b94c",
                  "c5a39e50e76e9820",
                  "5bf05284a438ffd6"
                ],
                "status_id": 25,
                "text": "to at least the smallest allowed maximum datagram size of 1200 bytes,"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "5bf05284a438ffd6"
                ],
                "status_id": 20,
                "text": "unless the anti-amplification limit for the path does not permit"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "5bf05284a438ffd6"
                ],
                "status_id": 20,
                "text": "sending a datagram of this size."
              },
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "  Sending UDP datagrams of this size"
              }
            ],
            "   ensures that the network path from the endpoint to the peer can be",
            "   used for QUIC; see Section 14.",
            "",
            "   When an endpoint is unable to expand the datagram size to 1200 bytes",
            "   due to the anti-amplification limit, the path MTU will not be",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   validated.  "
              },
              {
                "annotation_ids": [
                  "91275876ee69469c"
                ],
                "status_id": 20,
                "text": "To ensure that the path MTU is large enough, the endpoint"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "91275876ee69469c"
                ],
                "status_id": 20,
                "text": "MUST perform a second path validation by sending a PATH_CHALLENGE"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "91275876ee69469c"
                ],
                "status_id": 20,
                "text": "frame in a datagram of at least 1200 bytes."
              },
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "  This additional"
              }
            ],
            "   validation can be performed after a PATH_RESPONSE is successfully",
            "   received or when enough bytes have been received on the path that",
            "   sending the larger datagram will not result in exceeding the anti-",
            "   amplification limit.",
            "",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "9442f5dc21bc8054"
                ],
                "status_id": 20,
                "text": "Unlike other cases where datagrams are expanded, endpoints MUST NOT"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "9442f5dc21bc8054"
                ],
                "status_id": 20,
                "text": "discard datagrams that appear to be too small when they contain"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "9442f5dc21bc8054"
                ],
                "status_id": 20,
                "text": "PATH_CHALLENGE or PATH_RESPONSE."
              }
            ]
          ],
          "requirements": [
            "68ebca40f233f253",
            "68ebca40f233f253",
            "9bcfb9ac8715adc8",
            "9bcfb9ac8715adc8",
            "869624b5d1dad408",
            "869624b5d1dad408",
            "869624b5d1dad408",
            "31fb0d42d34f03b7",
            "31fb0d42d34f03b7",
            "31fb0d42d34f03b7",
            "5bf05284a438ffd6",
            "5bf05284a438ffd6",
            "5bf05284a438ffd6",
            "5bf05284a438ffd6",
            "91275876ee69469c",
            "91275876ee69469c",
            "91275876ee69469c",
            "9442f5dc21bc8054",
            "9442f5dc21bc8054",
            "9442f5dc21bc8054"
          ],
          "title": "Initiating Path Validation"
        },
        {
          "id": "section-8.2.2",
          "lines": [
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "3777d0f6ebe999c8",
                  "b9b0f7225ae8f086",
                  "e0e967a79ae160d6"
                ],
                "status_id": 9,
                "text": "On receiving a PATH_CHALLENGE frame, an endpoint MUST respond by"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "3777d0f6ebe999c8",
                  "b9b0f7225ae8f086",
                  "e0e967a79ae160d6"
                ],
                "status_id": 9,
                "text": "echoing the data contained in the PATH_CHALLENGE frame in a"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "3777d0f6ebe999c8",
                  "b9b0f7225ae8f086",
                  "e0e967a79ae160d6"
                ],
                "status_id": 9,
                "text": "PATH_RESPONSE frame."
              },
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "  "
              },
              {
                "annotation_ids": [
                  "9ce99b8d640ebd83",
                  "0904410647db60de"
                ],
                "status_id": 13,
                "text": "An endpoint MUST NOT delay transmission of a"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "9ce99b8d640ebd83",
                  "0904410647db60de"
                ],
                "status_id": 13,
                "text": "packet containing a PATH_RESPONSE frame unless constrained by"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "9ce99b8d640ebd83",
                  "0904410647db60de"
                ],
                "status_id": 13,
                "text": "congestion control."
              }
            ],
            "",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "0cec248892911ce4",
                  "fa0ce56b79306eea",
                  "9bc01a20c0643a51",
                  "290b31ae636afef9"
                ],
                "status_id": 25,
                "text": "A PATH_RESPONSE frame MUST be sent on the network path where the"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "0cec248892911ce4",
                  "fa0ce56b79306eea",
                  "9bc01a20c0643a51",
                  "290b31ae636afef9"
                ],
                "status_id": 25,
                "text": "PATH_CHALLENGE frame was received."
              },
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "  This ensures that path validation"
              }
            ],
            "   by a peer only succeeds if the path is functional in both directions.",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "7a4d45df60d14941",
                  "d874e0dfaa3c1bb5",
                  "9436e6e6ccd52c53",
                  "1736796599e785ed"
                ],
                "status_id": 24,
                "text": "This requirement MUST NOT be enforced by the endpoint that initiates"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "7a4d45df60d14941",
                  "d874e0dfaa3c1bb5",
                  "9436e6e6ccd52c53",
                  "1736796599e785ed"
                ],
                "status_id": 24,
                "text": "path validation, as that would enable an attack on migration; see"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "7a4d45df60d14941",
                  "d874e0dfaa3c1bb5",
                  "9436e6e6ccd52c53",
                  "1736796599e785ed"
                ],
                "status_id": 24,
                "text": "Section 9.3.3."
              }
            ],
            "",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "800939e821c69448",
                  "6df18e6f4a9990a8",
                  "61cf6b3f122a21ca"
                ],
                "status_id": 25,
                "text": "An endpoint MUST expand datagrams that contain a PATH_RESPONSE frame"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "800939e821c69448",
                  "6df18e6f4a9990a8",
                  "61cf6b3f122a21ca"
                ],
                "status_id": 25,
                "text": "to at least the smallest allowed maximum datagram size of 1200 bytes."
              }
            ],
            "   This verifies that the path is able to carry datagrams of this size",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   in both directions.  "
              },
              {
                "annotation_ids": [
                  "a6d00323eeb43c59"
                ],
                "status_id": 20,
                "text": "However, an endpoint MUST NOT expand the"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "a6d00323eeb43c59"
                ],
                "status_id": 20,
                "text": "datagram containing the PATH_RESPONSE if the resulting data exceeds"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "a6d00323eeb43c59"
                ],
                "status_id": 20,
                "text": "the anti-amplification limit."
              },
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "  This is expected to only occur if the"
              }
            ],
            "   received PATH_CHALLENGE was not sent in an expanded datagram.",
            "",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "92bf244cd5e03f23",
                  "07965663aea5bebd",
                  "6aa1749e019817a0"
                ],
                "status_id": 9,
                "text": "An endpoint MUST NOT send more than one PATH_RESPONSE frame in"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "92bf244cd5e03f23",
                  "07965663aea5bebd",
                  "6aa1749e019817a0"
                ],
                "status_id": 9,
                "text": "response to one PATH_CHALLENGE frame; see Section 13.3."
              },
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "  The peer is"
              }
            ],
            "   expected to send more PATH_CHALLENGE frames as necessary to evoke",
            "   additional PATH_RESPONSE frames."
          ],
          "requirements": [
            "e0e967a79ae160d6",
            "e0e967a79ae160d6",
            "e0e967a79ae160d6",
            "0904410647db60de",
            "0904410647db60de",
            "0904410647db60de",
            "290b31ae636afef9",
            "290b31ae636afef9",
            "1736796599e785ed",
            "1736796599e785ed",
            "1736796599e785ed",
            "61cf6b3f122a21ca",
            "61cf6b3f122a21ca",
            "a6d00323eeb43c59",
            "a6d00323eeb43c59",
            "a6d00323eeb43c59",
            "6aa1749e019817a0",
            "6aa1749e019817a0"
          ],
          "title": "Path Validation Responses"
        },
        {
          "id": "section-8.2.3",
          "lines": [
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "681a82b174950300"
                ],
                "status_id": 1,
                "text": "Path validation succeeds when a PATH_RESPONSE frame is received that"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "681a82b174950300"
                ],
                "status_id": 1,
                "text": "contains the data that was sent in a previous PATH_CHALLENGE frame."
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "bdbd5356dd349972",
                  "681a82b174950300",
                  "1276303e20382f41"
                ],
                "status_id": 2,
                "text": "A PATH_RESPONSE frame received on any network path validates the path"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "bdbd5356dd349972",
                  "681a82b174950300",
                  "1276303e20382f41"
                ],
                "status_id": 2,
                "text": "on which the PATH_CHALLENGE was sent."
              }
            ],
            "",
            "   If an endpoint sends a PATH_CHALLENGE frame in a datagram that is not",
            "   expanded to at least 1200 bytes and if the response to it validates",
            "   the peer address, the path is validated but not the path MTU.  As a",
            "   result, the endpoint can now send more than three times the amount of",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   data that has been received.  "
              },
              {
                "annotation_ids": [
                  "9d089ac61fd70e11",
                  "fe11b8c8134adfb3"
                ],
                "status_id": 12,
                "text": "However, the endpoint MUST initiate"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "9d089ac61fd70e11",
                  "fe11b8c8134adfb3"
                ],
                "status_id": 12,
                "text": "another path validation with an expanded datagram to verify that the"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "9d089ac61fd70e11",
                  "fe11b8c8134adfb3"
                ],
                "status_id": 12,
                "text": "path supports the required MTU."
              }
            ],
            "",
            "   Receipt of an acknowledgment for a packet containing a PATH_CHALLENGE",
            "   frame is not adequate validation, since the acknowledgment can be",
            "   spoofed by a malicious peer."
          ],
          "requirements": [
            "fe11b8c8134adfb3",
            "fe11b8c8134adfb3",
            "fe11b8c8134adfb3"
          ],
          "title": "Successful Path Validation"
        },
        {
          "id": "section-8.2.4",
          "lines": [
            "   Path validation only fails when the endpoint attempting to validate",
            "   the path abandons its attempt to validate the path.",
            "",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "8e7e077eca149af0",
                  "4110ca08436066e7",
                  "d8e8ef19040b5380",
                  "8df9bb9b92b415fb",
                  "100b5091d7f70f06"
                ],
                "status_id": 8,
                "text": "Endpoints SHOULD abandon path validation based on a timer."
              },
              {
                "annotation_ids": [
                  "d8e8ef19040b5380"
                ],
                "status_id": 7,
                "text": "  "
              },
              {
                "annotation_ids": [
                  "d8e8ef19040b5380",
                  "13cb65a0584d8f1c"
                ],
                "status_id": 2,
                "text": "When"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "d8e8ef19040b5380",
                  "13cb65a0584d8f1c"
                ],
                "status_id": 2,
                "text": "setting this timer, implementations are cautioned that the new path"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "d8e8ef19040b5380",
                  "13cb65a0584d8f1c"
                ],
                "status_id": 2,
                "text": "could have a longer round-trip time than the original.  "
              },
              {
                "annotation_ids": [
                  "d8e8ef19040b5380",
                  "13cb65a0584d8f1c",
                  "b1b2bb0203113d6c",
                  "5f4be7f04310051b"
                ],
                "status_id": 28,
                "text": "A value of"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "d8e8ef19040b5380",
                  "13cb65a0584d8f1c",
                  "b1b2bb0203113d6c",
                  "5f4be7f04310051b"
                ],
                "status_id": 28,
                "text": "three times the larger of the current PTO or the PTO for the new path"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "d8e8ef19040b5380",
                  "13cb65a0584d8f1c",
                  "b1b2bb0203113d6c",
                  "5f4be7f04310051b"
                ],
                "status_id": 28,
                "text": "(using kInitialRtt, as defined in [QUIC-RECOVERY]) is RECOMMENDED."
              }
            ],
            "",
            "   This timeout allows for multiple PTOs to expire prior to failing path",
            "   validation, so that loss of a single PATH_CHALLENGE or PATH_RESPONSE",
            "   frame does not cause path validation failure.",
            "",
            "   Note that the endpoint might receive packets containing other frames",
            "   on the new path, but a PATH_RESPONSE frame with appropriate data is",
            "   required for path validation to succeed.",
            "",
            "   When an endpoint abandons path validation, it determines that the",
            "   path is unusable.  This does not necessarily imply a failure of the",
            "   connection -- endpoints can continue sending packets over other paths",
            "   as appropriate.  If no paths are available, an endpoint can wait for",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   a new path to become available or close the connection.  "
              },
              {
                "annotation_ids": [
                  "a2bdbd91fddf6376"
                ],
                "status_id": 19,
                "text": "An endpoint"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "a2bdbd91fddf6376"
                ],
                "status_id": 19,
                "text": "that has no valid network path to its peer MAY signal this using the"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "a2bdbd91fddf6376"
                ],
                "status_id": 19,
                "text": "NO_VIABLE_PATH connection error, noting that this is only possible if"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "a2bdbd91fddf6376"
                ],
                "status_id": 19,
                "text": "the network path exists but does not support the required MTU"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "a2bdbd91fddf6376"
                ],
                "status_id": 19,
                "text": "(Section 14)."
              }
            ],
            "",
            "   A path validation might be abandoned for other reasons besides",
            "   failure.  Primarily, this happens if a connection migration to a new",
            "   path is initiated while a path validation on the old path is in",
            "   progress."
          ],
          "requirements": [
            "100b5091d7f70f06",
            "5f4be7f04310051b",
            "5f4be7f04310051b",
            "5f4be7f04310051b",
            "a2bdbd91fddf6376",
            "a2bdbd91fddf6376",
            "a2bdbd91fddf6376",
            "a2bdbd91fddf6376",
            "a2bdbd91fddf6376"
          ],
          "title": "Failed Path Validation"
        },
        {
          "id": "section-9",
          "lines": [
            "   The use of a connection ID allows connections to survive changes to",
            "   endpoint addresses (IP address and port), such as those caused by an",
            "   endpoint migrating to a new network.  This section describes the",
            "   process by which an endpoint migrates to a new address.",
            "",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "256f432ab1186dc4",
                  "cffa5d5c47ea29d4"
                ],
                "status_id": 1,
                "text": "The design of QUIC relies on endpoints retaining a stable address for"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "256f432ab1186dc4",
                  "cffa5d5c47ea29d4"
                ],
                "status_id": 1,
                "text": "the duration of the handshake.  "
              },
              {
                "annotation_ids": [
                  "256f432ab1186dc4",
                  "cffa5d5c47ea29d4",
                  "3754dd98dffda0b0"
                ],
                "status_id": 13,
                "text": "An endpoint MUST NOT initiate"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "256f432ab1186dc4",
                  "cffa5d5c47ea29d4",
                  "3754dd98dffda0b0"
                ],
                "status_id": 13,
                "text": "connection migration before the handshake is confirmed, as defined in"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "256f432ab1186dc4",
                  "cffa5d5c47ea29d4",
                  "3754dd98dffda0b0"
                ],
                "status_id": 13,
                "text": "Section 4.1.2 of [QUIC-TLS]."
              }
            ],
            "",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "62df56156fb6e4f5"
                ],
                "status_id": 20,
                "text": "If the peer sent the disable_active_migration transport parameter, an"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "62df56156fb6e4f5"
                ],
                "status_id": 20,
                "text": "endpoint also MUST NOT send packets (including probing packets; see"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "62df56156fb6e4f5"
                ],
                "status_id": 20,
                "text": "Section 9.1) from a different local address to the address the peer"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "62df56156fb6e4f5"
                ],
                "status_id": 20,
                "text": "used during the handshake, unless the endpoint has acted on a"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "62df56156fb6e4f5"
                ],
                "status_id": 20,
                "text": "preferred_address transport parameter from the peer."
              },
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "  "
              },
              {
                "annotation_ids": [
                  "8dbb4ff6931e38e8",
                  "9b878cf178d3c788"
                ],
                "status_id": 13,
                "text": "If the peer"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "8dbb4ff6931e38e8",
                  "9b878cf178d3c788"
                ],
                "status_id": 13,
                "text": "violates this requirement, the endpoint MUST either drop the incoming"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "8dbb4ff6931e38e8",
                  "9b878cf178d3c788"
                ],
                "status_id": 13,
                "text": "packets on that path without generating a Stateless Reset or proceed"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "8dbb4ff6931e38e8",
                  "9b878cf178d3c788"
                ],
                "status_id": 13,
                "text": "with path validation and allow the peer to migrate."
              },
              {
                "annotation_ids": [
                  "8dbb4ff6931e38e8"
                ],
                "status_id": 1,
                "text": "  Generating a"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "8dbb4ff6931e38e8"
                ],
                "status_id": 1,
                "text": "Stateless Reset or closing the connection would allow third parties"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "8dbb4ff6931e38e8"
                ],
                "status_id": 1,
                "text": "in the network to cause connections to close by spoofing or otherwise"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "8dbb4ff6931e38e8"
                ],
                "status_id": 1,
                "text": "manipulating observed traffic."
              }
            ],
            "",
            "   Not all changes of peer address are intentional, or active,",
            "   migrations.  The peer could experience NAT rebinding: a change of",
            "   address due to a middlebox, usually a NAT, allocating a new outgoing",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   port or even a new outgoing IP address for a flow.  "
              },
              {
                "annotation_ids": [
                  "6c0afdbaf06bf079",
                  "83bdbc7a678eab51",
                  "81a1561553c3f33a",
                  "7507d60274dec992"
                ],
                "status_id": 9,
                "text": "An endpoint MUST"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "6c0afdbaf06bf079",
                  "83bdbc7a678eab51",
                  "81a1561553c3f33a",
                  "7507d60274dec992"
                ],
                "status_id": 9,
                "text": "perform path validation (Section 8.2) if it detects any change to a"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "6c0afdbaf06bf079",
                  "83bdbc7a678eab51",
                  "81a1561553c3f33a",
                  "7507d60274dec992"
                ],
                "status_id": 9,
                "text": "peer's address, unless it has previously validated that address."
              }
            ],
            "",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "4b12df9c8c8d5679",
                  "fef7f9afda65e6c7",
                  "cbfbff5f672b1cae",
                  "4a92d5875474e5a5"
                ],
                "status_id": 11,
                "text": "When an endpoint has no validated path on which to send packets, it"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "4b12df9c8c8d5679",
                  "fef7f9afda65e6c7",
                  "cbfbff5f672b1cae",
                  "4a92d5875474e5a5"
                ],
                "status_id": 11,
                "text": "MAY discard connection state."
              },
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "  "
              },
              {
                "annotation_ids": [
                  "985e97380e714018",
                  "5e2ac4c3ec8512b6"
                ],
                "status_id": 16,
                "text": "An endpoint capable of connection"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "985e97380e714018",
                  "5e2ac4c3ec8512b6"
                ],
                "status_id": 16,
                "text": "migration MAY wait for a new path to become available before"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "985e97380e714018",
                  "5e2ac4c3ec8512b6"
                ],
                "status_id": 16,
                "text": "discarding connection state."
              }
            ],
            "",
            "   This document limits migration of connections to new client",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   addresses, except as described in Section 9.6.  "
              },
              {
                "annotation_ids": [
                  "1661f08a9f08403c"
                ],
                "status_id": 1,
                "text": "Clients are"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "1661f08a9f08403c"
                ],
                "status_id": 1,
                "text": "responsible for initiating all migrations."
              },
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "  "
              },
              {
                "annotation_ids": [
                  "017b3a57f738e845"
                ],
                "status_id": 1,
                "text": "Servers do not send non-"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "017b3a57f738e845"
                ],
                "status_id": 1,
                "text": "probing packets (see Section 9.1) toward a client address until they"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "017b3a57f738e845"
                ],
                "status_id": 1,
                "text": "see a non-probing packet from that address."
              },
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "  "
              },
              {
                "annotation_ids": [
                  "1dd82a4107182a34",
                  "69fc84a005e41196",
                  "f7cbeb6002b1a3bf"
                ],
                "status_id": 9,
                "text": "If a client receives"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "1dd82a4107182a34",
                  "69fc84a005e41196",
                  "f7cbeb6002b1a3bf"
                ],
                "status_id": 9,
                "text": "packets from an unknown server address, the client MUST discard these"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "1dd82a4107182a34",
                  "69fc84a005e41196",
                  "f7cbeb6002b1a3bf"
                ],
                "status_id": 9,
                "text": "packets."
              }
            ]
          ],
          "requirements": [
            "3754dd98dffda0b0",
            "3754dd98dffda0b0",
            "3754dd98dffda0b0",
            "62df56156fb6e4f5",
            "62df56156fb6e4f5",
            "62df56156fb6e4f5",
            "62df56156fb6e4f5",
            "62df56156fb6e4f5",
            "9b878cf178d3c788",
            "9b878cf178d3c788",
            "9b878cf178d3c788",
            "9b878cf178d3c788",
            "7507d60274dec992",
            "7507d60274dec992",
            "7507d60274dec992",
            "4a92d5875474e5a5",
            "4a92d5875474e5a5",
            "5e2ac4c3ec8512b6",
            "5e2ac4c3ec8512b6",
            "5e2ac4c3ec8512b6",
            "f7cbeb6002b1a3bf",
            "f7cbeb6002b1a3bf",
            "f7cbeb6002b1a3bf"
          ],
          "title": "Connection Migration"
        },
        {
          "id": "section-9.1",
          "lines": [
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "885b6a6aeedda490"
                ],
                "status_id": 19,
                "text": "An endpoint MAY probe for peer reachability from a new local address"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "885b6a6aeedda490"
                ],
                "status_id": 19,
                "text": "using path validation (Section 8.2) prior to migrating the connection"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "885b6a6aeedda490"
                ],
                "status_id": 19,
                "text": "to the new local address."
              },
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "  Failure of path validation simply means"
              }
            ],
            "   that the new path is not usable for this connection.  Failure to",
            "   validate a path does not cause the connection to end unless there are",
            "   no valid alternative paths available.",
            "",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "5039c33addd3c424"
                ],
                "status_id": 1,
                "text": "PATH_CHALLENGE, PATH_RESPONSE, NEW_CONNECTION_ID, and PADDING frames"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "5039c33addd3c424"
                ],
                "status_id": 1,
                "text": "are \"probing frames\", and all other frames are \"non-probing frames\"."
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "531384cff351ab45",
                  "08e090729f016d5c"
                ],
                "status_id": 2,
                "text": "A packet containing only probing frames is a \"probing packet\", and a"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "531384cff351ab45",
                  "08e090729f016d5c"
                ],
                "status_id": 2,
                "text": "packet containing any other frame is a \"non-probing packet\"."
              }
            ]
          ],
          "requirements": [
            "885b6a6aeedda490",
            "885b6a6aeedda490",
            "885b6a6aeedda490"
          ],
          "title": "Probing a New Path"
        },
        {
          "id": "section-9.2",
          "lines": [
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "0f80c183ec9b9cb5",
                  "a02c18f4b0766d0e",
                  "c5b82ed9e3cf7e9a"
                ],
                "status_id": 2,
                "text": "An endpoint can migrate a connection to a new local address by"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "0f80c183ec9b9cb5",
                  "a02c18f4b0766d0e",
                  "c5b82ed9e3cf7e9a"
                ],
                "status_id": 2,
                "text": "sending packets containing non-probing frames from that address."
              }
            ],
            "",
            "   Each endpoint validates its peer's address during connection",
            "   establishment.  Therefore, a migrating endpoint can send to its peer",
            "   knowing that the peer is willing to receive at the peer's current",
            "   address.  Thus, an endpoint can migrate to a new local address",
            "   without first validating the peer's address.",
            "",
            "   To establish reachability on the new path, an endpoint initiates path",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   validation (Section 8.2) on the new path.  "
              },
              {
                "annotation_ids": [
                  "66f02df4c13c55eb"
                ],
                "status_id": 19,
                "text": "An endpoint MAY defer path"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "66f02df4c13c55eb"
                ],
                "status_id": 19,
                "text": "validation until after a peer sends the next non-probing frame to its"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "66f02df4c13c55eb"
                ],
                "status_id": 19,
                "text": "new address."
              }
            ],
            "",
            "   When migrating, the new path might not support the endpoint's current",
            "   sending rate.  Therefore, the endpoint resets its congestion",
            "   controller and RTT estimate, as described in Section 9.4.",
            "",
            "   The new path might not have the same ECN capability.  Therefore, the",
            "   endpoint validates ECN capability as described in Section 13.4."
          ],
          "requirements": [
            "66f02df4c13c55eb",
            "66f02df4c13c55eb",
            "66f02df4c13c55eb"
          ],
          "title": "Initiating Connection Migration"
        },
        {
          "id": "section-9.3",
          "lines": [
            "   Receiving a packet from a new peer address containing a non-probing",
            "   frame indicates that the peer has migrated to that address.",
            "",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "7b16f873602062fb",
                  "24422ceb78370171",
                  "23330c3c17c05947",
                  "a1a8e1f7ce6af81d"
                ],
                "status_id": 13,
                "text": "If the recipient permits the migration, it MUST send subsequent"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "7b16f873602062fb",
                  "24422ceb78370171",
                  "23330c3c17c05947",
                  "a1a8e1f7ce6af81d"
                ],
                "status_id": 13,
                "text": "packets to the new peer address and MUST initiate path validation"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "7b16f873602062fb",
                  "24422ceb78370171",
                  "23330c3c17c05947",
                  "a1a8e1f7ce6af81d"
                ],
                "status_id": 13,
                "text": "(Section 8.2) to verify the peer's ownership of the address if"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "7b16f873602062fb",
                  "24422ceb78370171",
                  "23330c3c17c05947",
                  "a1a8e1f7ce6af81d"
                ],
                "status_id": 13,
                "text": "validation is not already underway."
              },
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "  If the recipient has no unused"
              }
            ],
            "   connection IDs from the peer, it will not be able to send anything on",
            "   the new path until the peer provides one; see Section 9.5.",
            "",
            "   An endpoint only changes the address to which it sends packets in",
            "   response to the highest-numbered non-probing packet.  This ensures",
            "   that an endpoint does not send packets to an old peer address in the",
            "   case that it receives reordered packets.",
            "",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "e557d4386f5dbc92",
                  "33524d557d4d9b6f"
                ],
                "status_id": 13,
                "text": "An endpoint MAY send data to an unvalidated peer address, but it MUST"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "e557d4386f5dbc92",
                  "33524d557d4d9b6f"
                ],
                "status_id": 13,
                "text": "protect against potential attacks as described in Sections 9.3.1 and"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "e557d4386f5dbc92",
                  "33524d557d4d9b6f"
                ],
                "status_id": 13,
                "text": "9.3.2."
              },
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "  "
              },
              {
                "annotation_ids": [
                  "70c25af876aad01e",
                  "0de57d94d3caa684"
                ],
                "status_id": 16,
                "text": "An endpoint MAY skip validation of a peer address if that"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "70c25af876aad01e",
                  "0de57d94d3caa684"
                ],
                "status_id": 16,
                "text": "address has been seen recently."
              },
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "  In particular, if an endpoint"
              }
            ],
            "   returns to a previously validated path after detecting some form of",
            "   spurious migration, skipping address validation and restoring loss",
            "   detection and congestion state can reduce the performance impact of",
            "   the attack.",
            "",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "20a99187c357b639",
                  "bf9d84362af9c7bb"
                ],
                "status_id": 2,
                "text": "After changing the address to which it sends non-probing packets, an"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "20a99187c357b639",
                  "bf9d84362af9c7bb"
                ],
                "status_id": 2,
                "text": "endpoint can abandon any path validation for other addresses."
              }
            ],
            "",
            "   Receiving a packet from a new peer address could be the result of a",
            "   NAT rebinding at the peer.",
            "",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "af63b9b1618ff18e",
                  "40f5d2ce5feaf1c6"
                ],
                "status_id": 18,
                "text": "After verifying a new client address, the server SHOULD send new"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "af63b9b1618ff18e",
                  "40f5d2ce5feaf1c6"
                ],
                "status_id": 18,
                "text": "address validation tokens (Section 8) to the client."
              }
            ]
          ],
          "requirements": [
            "23330c3c17c05947",
            "23330c3c17c05947",
            "23330c3c17c05947",
            "23330c3c17c05947",
            "a1a8e1f7ce6af81d",
            "a1a8e1f7ce6af81d",
            "a1a8e1f7ce6af81d",
            "a1a8e1f7ce6af81d",
            "33524d557d4d9b6f",
            "33524d557d4d9b6f",
            "33524d557d4d9b6f",
            "0de57d94d3caa684",
            "0de57d94d3caa684",
            "40f5d2ce5feaf1c6",
            "40f5d2ce5feaf1c6"
          ],
          "title": "Responding to Connection Migration"
        },
        {
          "id": "section-9.3.1",
          "lines": [
            "   It is possible that a peer is spoofing its source address to cause an",
            "   endpoint to send excessive amounts of data to an unwilling host.  If",
            "   the endpoint sends significantly more data than the spoofing peer,",
            "   connection migration might be used to amplify the volume of data that",
            "   an attacker can generate toward a victim.",
            "",
            "   As described in Section 9.3, an endpoint is required to validate a",
            "   peer's new address to confirm the peer's possession of the new",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   address.  "
              },
              {
                "annotation_ids": [
                  "20ded7a6f621cb66"
                ],
                "status_id": 1,
                "text": "Until a peer's address is deemed valid, an endpoint limits"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "20ded7a6f621cb66"
                ],
                "status_id": 1,
                "text": "the amount of data it sends to that address; see Section 8."
              },
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "  In the"
              }
            ],
            "   absence of this limit, an endpoint risks being used for a denial-of-",
            "   service attack against an unsuspecting victim.",
            "",
            "   If an endpoint skips validation of a peer address as described above,",
            "   it does not need to limit its sending rate."
          ],
          "title": "Peer Address Spoofing"
        },
        {
          "id": "section-9.3.2",
          "lines": [
            "   An on-path attacker could cause a spurious connection migration by",
            "   copying and forwarding a packet with a spoofed address such that it",
            "   arrives before the original packet.  The packet with the spoofed",
            "   address will be seen to come from a migrating connection, and the",
            "   original packet will be seen as a duplicate and dropped.  After a",
            "   spurious migration, validation of the source address will fail",
            "   because the entity at the source address does not have the necessary",
            "   cryptographic keys to read or respond to the PATH_CHALLENGE frame",
            "   that is sent to it even if it wanted to.",
            "",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "c269842555830298",
                  "00124cef4d057cbe",
                  "7f3e3dcd7fdfa85f"
                ],
                "status_id": 9,
                "text": "To protect the connection from failing due to such a spurious"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "c269842555830298",
                  "00124cef4d057cbe",
                  "7f3e3dcd7fdfa85f"
                ],
                "status_id": 9,
                "text": "migration, an endpoint MUST revert to using the last validated peer"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "c269842555830298",
                  "00124cef4d057cbe",
                  "7f3e3dcd7fdfa85f"
                ],
                "status_id": 9,
                "text": "address when validation of a new peer address fails."
              },
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "  Additionally,"
              }
            ],
            "   receipt of packets with higher packet numbers from the legitimate",
            "   peer address will trigger another connection migration.  This will",
            "   cause the validation of the address of the spurious migration to be",
            "   abandoned, thus containing migrations initiated by the attacker",
            "   injecting a single packet.",
            "",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "4b4d041b75cf599d",
                  "fe46ae0c22ac8c51",
                  "c102c5835f4f45d7",
                  "2740d2ffe03aff97"
                ],
                "status_id": 9,
                "text": "If an endpoint has no state about the last validated peer address, it"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "4b4d041b75cf599d",
                  "fe46ae0c22ac8c51",
                  "c102c5835f4f45d7",
                  "2740d2ffe03aff97"
                ],
                "status_id": 9,
                "text": "MUST close the connection silently by discarding all connection"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "4b4d041b75cf599d",
                  "fe46ae0c22ac8c51",
                  "c102c5835f4f45d7",
                  "2740d2ffe03aff97"
                ],
                "status_id": 9,
                "text": "state."
              },
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "  This results in new packets on the connection being handled"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   generically.  "
              },
              {
                "annotation_ids": [
                  "aa1cfb9c3142fa83",
                  "2366df8c0ee515f8"
                ],
                "status_id": 21,
                "text": "For instance, an endpoint MAY send a Stateless Reset in"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "aa1cfb9c3142fa83",
                  "2366df8c0ee515f8"
                ],
                "status_id": 21,
                "text": "response to any further incoming packets."
              }
            ]
          ],
          "requirements": [
            "7f3e3dcd7fdfa85f",
            "7f3e3dcd7fdfa85f",
            "7f3e3dcd7fdfa85f",
            "2740d2ffe03aff97",
            "2740d2ffe03aff97",
            "2740d2ffe03aff97",
            "2366df8c0ee515f8",
            "2366df8c0ee515f8"
          ],
          "title": "On-Path Address Spoofing"
        },
        {
          "id": "section-9.3.3",
          "lines": [
            "   An off-path attacker that can observe packets might forward copies of",
            "   genuine packets to endpoints.  If the copied packet arrives before",
            "   the genuine packet, this will appear as a NAT rebinding.  Any genuine",
            "   packet will be discarded as a duplicate.  If the attacker is able to",
            "   continue forwarding packets, it might be able to cause migration to a",
            "   path via the attacker.  This places the attacker on-path, giving it",
            "   the ability to observe or drop all subsequent packets.",
            "",
            "   This style of attack relies on the attacker using a path that has",
            "   approximately the same characteristics as the direct path between",
            "   endpoints.  The attack is more reliable if relatively few packets are",
            "   sent or if packet loss coincides with the attempted attack.",
            "",
            "   A non-probing packet received on the original path that increases the",
            "   maximum received packet number will cause the endpoint to move back",
            "   to that path.  Eliciting packets on this path increases the",
            "   likelihood that the attack is unsuccessful.  Therefore, mitigation of",
            "   this attack relies on triggering the exchange of packets.",
            "",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "0c6bebe1a51cfbdf",
                  "fca7f218db83bc78"
                ],
                "status_id": 13,
                "text": "In response to an apparent migration, endpoints MUST validate the"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "0c6bebe1a51cfbdf",
                  "fca7f218db83bc78"
                ],
                "status_id": 13,
                "text": "previously active path using a PATH_CHALLENGE frame."
              },
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "  This induces"
              }
            ],
            "   the sending of new packets on that path.  If the path is no longer",
            "   viable, the validation attempt will time out and fail; if the path is",
            "   viable but no longer desired, the validation will succeed but only",
            "   results in probing packets being sent on the path.",
            "",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "f5bce7445158068e",
                  "323d17267e58b592",
                  "048bf771ca8cb6b7"
                ],
                "status_id": 22,
                "text": "An endpoint that receives a PATH_CHALLENGE on an active path SHOULD"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "f5bce7445158068e",
                  "323d17267e58b592",
                  "048bf771ca8cb6b7"
                ],
                "status_id": 22,
                "text": "send a non-probing packet in response."
              },
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "  If the non-probing packet"
              }
            ],
            "   arrives before any copy made by an attacker, this results in the",
            "   connection being migrated back to the original path.  Any subsequent",
            "   migration to another path restarts this entire process.",
            "",
            "   This defense is imperfect, but this is not considered a serious",
            "   problem.  If the path via the attack is reliably faster than the",
            "   original path despite multiple attempts to use that original path, it",
            "   is not possible to distinguish between an attack and an improvement",
            "   in routing.",
            "",
            "   An endpoint could also use heuristics to improve detection of this",
            "   style of attack.  For instance, NAT rebinding is improbable if",
            "   packets were recently received on the old path; similarly, rebinding",
            "   is rare on IPv6 paths.  Endpoints can also look for duplicated",
            "   packets.  Conversely, a change in connection ID is more likely to",
            "   indicate an intentional migration rather than an attack."
          ],
          "requirements": [
            "fca7f218db83bc78",
            "fca7f218db83bc78",
            "048bf771ca8cb6b7",
            "048bf771ca8cb6b7"
          ],
          "title": "Off-Path Packet Forwarding"
        },
        {
          "id": "section-9.4",
          "lines": [
            "   The capacity available on the new path might not be the same as the",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   old path.  "
              },
              {
                "annotation_ids": [
                  "18f001264a42af56",
                  "a4b5faa5381e3d05",
                  "38f86d165f49d4df"
                ],
                "status_id": 9,
                "text": "Packets sent on the old path MUST NOT contribute to"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "18f001264a42af56",
                  "a4b5faa5381e3d05",
                  "38f86d165f49d4df"
                ],
                "status_id": 9,
                "text": "congestion control or RTT estimation for the new path."
              }
            ],
            "",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "1e7f321b68583075",
                  "7ce2d348a3598fe3",
                  "5ce6760d617d2f29"
                ],
                "status_id": 29,
                "text": "On confirming a peer's ownership of its new address, an endpoint MUST"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "1e7f321b68583075",
                  "7ce2d348a3598fe3",
                  "5ce6760d617d2f29"
                ],
                "status_id": 29,
                "text": "immediately reset the congestion controller and round-trip time"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "1e7f321b68583075",
                  "7ce2d348a3598fe3",
                  "5ce6760d617d2f29"
                ],
                "status_id": 29,
                "text": "estimator for the new path to initial values (see Appendices A.3 and"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "1e7f321b68583075",
                  "7ce2d348a3598fe3",
                  "5ce6760d617d2f29"
                ],
                "status_id": 29,
                "text": "B.3 of [QUIC-RECOVERY]) unless the only change in the peer's address"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "1e7f321b68583075",
                  "7ce2d348a3598fe3",
                  "5ce6760d617d2f29"
                ],
                "status_id": 29,
                "text": "is its port number."
              },
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "  "
              },
              {
                "annotation_ids": [
                  "d9e2a83045fc13e8",
                  "92849d2bd646eef1",
                  "39a02ba0dbe40d08"
                ],
                "status_id": 30,
                "text": "Because port-only changes are commonly the"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "d9e2a83045fc13e8",
                  "92849d2bd646eef1",
                  "39a02ba0dbe40d08"
                ],
                "status_id": 30,
                "text": "result of NAT rebinding or other middlebox activity, the endpoint MAY"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "d9e2a83045fc13e8",
                  "92849d2bd646eef1",
                  "39a02ba0dbe40d08"
                ],
                "status_id": 30,
                "text": "instead retain its congestion control state and round-trip estimate"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "d9e2a83045fc13e8",
                  "92849d2bd646eef1",
                  "39a02ba0dbe40d08"
                ],
                "status_id": 30,
                "text": "in those cases instead of reverting to initial values."
              },
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "  In cases"
              }
            ],
            "   where congestion control state retained from an old path is used on a",
            "   new path with substantially different characteristics, a sender could",
            "   transmit too aggressively until the congestion controller and the RTT",
            "   estimator have adapted.  Generally, implementations are advised to be",
            "   cautious when using previous values on a new path.",
            "",
            "   There could be apparent reordering at the receiver when an endpoint",
            "   sends data and probes from/to multiple addresses during the migration",
            "   period, since the two resulting paths could have different round-trip",
            "   times.  A receiver of packets on multiple paths will still send ACK",
            "   frames covering all received packets.",
            "",
            "   While multiple paths might be used during connection migration, a",
            "   single congestion control context and a single loss recovery context",
            "   (as described in [QUIC-RECOVERY]) could be adequate.  For instance,",
            "   an endpoint might delay switching to a new congestion control context",
            "   until it is confirmed that an old path is no longer needed (such as",
            "   the case described in Section 9.3.3).",
            "",
            "   A sender can make exceptions for probe packets so that their loss",
            "   detection is independent and does not unduly cause the congestion",
            "   controller to reduce its sending rate.  An endpoint might set a",
            "   separate timer when a PATH_CHALLENGE is sent, which is canceled if",
            "   the corresponding PATH_RESPONSE is received.  If the timer fires",
            "   before the PATH_RESPONSE is received, the endpoint might send a new",
            "   PATH_CHALLENGE and restart the timer for a longer period of time.",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "38ab7e4621cc84ed",
                  "4ea778205eb31de6"
                ],
                "status_id": 12,
                "text": "This timer SHOULD be set as described in Section 6.2.1 of"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "38ab7e4621cc84ed",
                  "4ea778205eb31de6"
                ],
                "status_id": 12,
                "text": "[QUIC-RECOVERY] and MUST NOT be more aggressive."
              }
            ]
          ],
          "requirements": [
            "38f86d165f49d4df",
            "38f86d165f49d4df",
            "5ce6760d617d2f29",
            "5ce6760d617d2f29",
            "5ce6760d617d2f29",
            "5ce6760d617d2f29",
            "5ce6760d617d2f29",
            "39a02ba0dbe40d08",
            "39a02ba0dbe40d08",
            "39a02ba0dbe40d08",
            "39a02ba0dbe40d08",
            "4ea778205eb31de6",
            "4ea778205eb31de6"
          ],
          "title": "Loss Detection and Congestion Control"
        },
        {
          "id": "section-9.5",
          "lines": [
            "   Using a stable connection ID on multiple network paths would allow a",
            "   passive observer to correlate activity between those paths.  An",
            "   endpoint that moves between networks might not wish to have their",
            "   activity correlated by any entity other than their peer, so different",
            "   connection IDs are used when sending from different local addresses,",
            "   as discussed in Section 5.1.  For this to be effective, endpoints",
            "   need to ensure that connection IDs they provide cannot be linked by",
            "   any other entity.",
            "",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "44ca2e476f1815c8"
                ],
                "status_id": 19,
                "text": "At any time, endpoints MAY change the Destination Connection ID they"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "44ca2e476f1815c8"
                ],
                "status_id": 19,
                "text": "transmit with to a value that has not been used on another path."
              }
            ],
            "",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "1678e937f7d9776e"
                ],
                "status_id": 20,
                "text": "An endpoint MUST NOT reuse a connection ID when sending from more"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "1678e937f7d9776e"
                ],
                "status_id": 20,
                "text": "than one local address -- for example, when initiating connection"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "1678e937f7d9776e"
                ],
                "status_id": 20,
                "text": "migration as described in Section 9.2 or when probing a new network"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "1678e937f7d9776e"
                ],
                "status_id": 20,
                "text": "path as described in Section 9.1."
              }
            ],
            "",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "541334e7451fe1c4",
                  "cca6f19c963cc67e"
                ],
                "status_id": 13,
                "text": "Similarly, an endpoint MUST NOT reuse a connection ID when sending to"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "541334e7451fe1c4",
                  "cca6f19c963cc67e"
                ],
                "status_id": 13,
                "text": "more than one destination address."
              },
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "  "
              },
              {
                "annotation_ids": [
                  "d7454ee80e6875e8",
                  "e16b0c11f199c92b"
                ],
                "status_id": 21,
                "text": "Due to network changes outside"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "d7454ee80e6875e8",
                  "e16b0c11f199c92b"
                ],
                "status_id": 21,
                "text": "the control of its peer, an endpoint might receive packets from a new"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "d7454ee80e6875e8",
                  "e16b0c11f199c92b"
                ],
                "status_id": 21,
                "text": "source address with the same Destination Connection ID field value,"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "d7454ee80e6875e8",
                  "e16b0c11f199c92b"
                ],
                "status_id": 21,
                "text": "in which case it MAY continue to use the current connection ID with"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "d7454ee80e6875e8",
                  "e16b0c11f199c92b"
                ],
                "status_id": 21,
                "text": "the new remote address while still sending from the same local"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "d7454ee80e6875e8",
                  "e16b0c11f199c92b"
                ],
                "status_id": 21,
                "text": "address."
              }
            ],
            "",
            "   These requirements regarding connection ID reuse apply only to the",
            "   sending of packets, as unintentional changes in path without a change",
            "   in connection ID are possible.  For example, after a period of",
            "   network inactivity, NAT rebinding might cause packets to be sent on a",
            "   new path when the client resumes sending.  An endpoint responds to",
            "   such an event as described in Section 9.3.",
            "",
            "   Using different connection IDs for packets sent in both directions on",
            "   each new network path eliminates the use of the connection ID for",
            "   linking packets from the same connection across different network",
            "   paths.  Header protection ensures that packet numbers cannot be used",
            "   to correlate activity.  This does not prevent other properties of",
            "   packets, such as timing and size, from being used to correlate",
            "   activity.",
            "",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "2719d7d5fae72c78"
                ],
                "status_id": 14,
                "text": "An endpoint SHOULD NOT initiate migration with a peer that has"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "2719d7d5fae72c78"
                ],
                "status_id": 14,
                "text": "requested a zero-length connection ID, because traffic over the new"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "2719d7d5fae72c78"
                ],
                "status_id": 14,
                "text": "path might be trivially linkable to traffic over the old one."
              },
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "  If the"
              }
            ],
            "   server is able to associate packets with a zero-length connection ID",
            "   to the right connection, it means that the server is using other",
            "   information to demultiplex packets.  For example, a server might",
            "   provide a unique address to every client -- for instance, using HTTP",
            "   alternative services [ALTSVC].  Information that might allow correct",
            "   routing of packets across multiple network paths will also allow",
            "   activity on those paths to be linked by entities other than the peer.",
            "",
            "   A client might wish to reduce linkability by switching to a new",
            "   connection ID, source UDP port, or IP address (see [RFC8981]) when",
            "   sending traffic after a period of inactivity.  Changing the address",
            "   from which it sends packets at the same time might cause the server",
            "   to detect a connection migration.  This ensures that the mechanisms",
            "   that support migration are exercised even for clients that do not",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   experience NAT rebindings or genuine migrations.  "
              },
              {
                "annotation_ids": [
                  "791df8c9573a43ad"
                ],
                "status_id": 14,
                "text": "Changing address"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "791df8c9573a43ad"
                ],
                "status_id": 14,
                "text": "can cause a peer to reset its congestion control state (see"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "791df8c9573a43ad"
                ],
                "status_id": 14,
                "text": "Section 9.4), so addresses SHOULD only be changed infrequently."
              }
            ],
            "",
            "   An endpoint that exhausts available connection IDs cannot probe new",
            "   paths or initiate migration, nor can it respond to probes or attempts",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   by its peer to migrate.  "
              },
              {
                "annotation_ids": [
                  "fe18182bc8e123a6",
                  "e0140ff83bdc8066",
                  "5bb866d3bdeac482"
                ],
                "status_id": 8,
                "text": "To ensure that migration is possible and"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "fe18182bc8e123a6",
                  "e0140ff83bdc8066",
                  "5bb866d3bdeac482"
                ],
                "status_id": 8,
                "text": "packets sent on different paths cannot be correlated, endpoints"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "fe18182bc8e123a6",
                  "e0140ff83bdc8066",
                  "5bb866d3bdeac482"
                ],
                "status_id": 8,
                "text": "SHOULD provide new connection IDs before peers migrate; see"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "fe18182bc8e123a6",
                  "e0140ff83bdc8066",
                  "5bb866d3bdeac482"
                ],
                "status_id": 8,
                "text": "Section 5.1.1."
              },
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "  If a peer might have exhausted available connection"
              }
            ],
            "   IDs, a migrating endpoint could include a NEW_CONNECTION_ID frame in",
            "   all packets sent on a new network path."
          ],
          "requirements": [
            "44ca2e476f1815c8",
            "44ca2e476f1815c8",
            "1678e937f7d9776e",
            "1678e937f7d9776e",
            "1678e937f7d9776e",
            "1678e937f7d9776e",
            "cca6f19c963cc67e",
            "cca6f19c963cc67e",
            "e16b0c11f199c92b",
            "e16b0c11f199c92b",
            "e16b0c11f199c92b",
            "e16b0c11f199c92b",
            "e16b0c11f199c92b",
            "e16b0c11f199c92b",
            "2719d7d5fae72c78",
            "2719d7d5fae72c78",
            "2719d7d5fae72c78",
            "791df8c9573a43ad",
            "791df8c9573a43ad",
            "791df8c9573a43ad",
            "5bb866d3bdeac482",
            "5bb866d3bdeac482",
            "5bb866d3bdeac482",
            "5bb866d3bdeac482"
          ],
          "title": "Privacy Implications of Connection Migration"
        },
        {
          "id": "section-9.6",
          "lines": [
            "   QUIC allows servers to accept connections on one IP address and",
            "   attempt to transfer these connections to a more preferred address",
            "   shortly after the handshake.  This is particularly useful when",
            "   clients initially connect to an address shared by multiple servers",
            "   but would prefer to use a unicast address to ensure connection",
            "   stability.  This section describes the protocol for migrating a",
            "   connection to a preferred server address.",
            "",
            "   Migrating a connection to a new server address mid-connection is not",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   supported by the version of QUIC specified in this document.  "
              },
              {
                "annotation_ids": [
                  "c797f84432fe40f5"
                ],
                "status_id": 14,
                "text": "If a"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "c797f84432fe40f5"
                ],
                "status_id": 14,
                "text": "client receives packets from a new server address when the client has"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "c797f84432fe40f5"
                ],
                "status_id": 14,
                "text": "not initiated a migration to that address, the client SHOULD discard"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "c797f84432fe40f5"
                ],
                "status_id": 14,
                "text": "these packets."
              }
            ]
          ],
          "requirements": [
            "c797f84432fe40f5",
            "c797f84432fe40f5",
            "c797f84432fe40f5",
            "c797f84432fe40f5"
          ],
          "title": "Server's Preferred Address"
        },
        {
          "id": "section-9.6.1",
          "lines": [
            "   A server conveys a preferred address by including the",
            "   preferred_address transport parameter in the TLS handshake.",
            "",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "9e1e14961b306e42"
                ],
                "status_id": 19,
                "text": "Servers MAY communicate a preferred address of each address family"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "9e1e14961b306e42"
                ],
                "status_id": 19,
                "text": "(IPv4 and IPv6) to allow clients to pick the one most suited to their"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "9e1e14961b306e42"
                ],
                "status_id": 19,
                "text": "network attachment."
              }
            ],
            "",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "1053c952956d53b7"
                ],
                "status_id": 14,
                "text": "Once the handshake is confirmed, the client SHOULD select one of the"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "1053c952956d53b7"
                ],
                "status_id": 14,
                "text": "two addresses provided by the server and initiate path validation"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "1053c952956d53b7"
                ],
                "status_id": 14,
                "text": "(see Section 8.2)."
              },
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "  A client constructs packets using any previously"
              }
            ],
            "   unused active connection ID, taken from either the preferred_address",
            "   transport parameter or a NEW_CONNECTION_ID frame.",
            "",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "6b07d7a264c4ed58"
                ],
                "status_id": 14,
                "text": "As soon as path validation succeeds, the client SHOULD begin sending"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "6b07d7a264c4ed58"
                ],
                "status_id": 14,
                "text": "all future packets to the new server address using the new connection"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "6b07d7a264c4ed58"
                ],
                "status_id": 14,
                "text": "ID and discontinue use of the old server address."
              },
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "  "
              },
              {
                "annotation_ids": [
                  "2d615fead0c955a0"
                ],
                "status_id": 20,
                "text": "If path validation"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "2d615fead0c955a0"
                ],
                "status_id": 20,
                "text": "fails, the client MUST continue sending all future packets to the"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "2d615fead0c955a0"
                ],
                "status_id": 20,
                "text": "server's original IP address."
              }
            ]
          ],
          "requirements": [
            "9e1e14961b306e42",
            "9e1e14961b306e42",
            "9e1e14961b306e42",
            "1053c952956d53b7",
            "1053c952956d53b7",
            "1053c952956d53b7",
            "6b07d7a264c4ed58",
            "6b07d7a264c4ed58",
            "6b07d7a264c4ed58",
            "2d615fead0c955a0",
            "2d615fead0c955a0",
            "2d615fead0c955a0"
          ],
          "title": "Communicating a Preferred Address"
        },
        {
          "id": "section-9.6.2",
          "lines": [
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "89a7308c121814fd"
                ],
                "status_id": 20,
                "text": "A client that migrates to a preferred address MUST validate the"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "89a7308c121814fd"
                ],
                "status_id": 20,
                "text": "address it chooses before migrating; see Section 21.5.3."
              }
            ],
            "",
            "   A server might receive a packet addressed to its preferred IP address",
            "   at any time after it accepts a connection.  If this packet contains a",
            "   PATH_CHALLENGE frame, the server sends a packet containing a",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   PATH_RESPONSE frame as per Section 8.2.  "
              },
              {
                "annotation_ids": [
                  "9a83dbaeebeda2eb"
                ],
                "status_id": 20,
                "text": "The server MUST send non-"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "9a83dbaeebeda2eb"
                ],
                "status_id": 20,
                "text": "probing packets from its original address until it receives a non-"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "9a83dbaeebeda2eb"
                ],
                "status_id": 20,
                "text": "probing packet from the client at its preferred address and until the"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "9a83dbaeebeda2eb"
                ],
                "status_id": 20,
                "text": "server has validated the new path."
              }
            ],
            "",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "ac0055e3e734de3e"
                ],
                "status_id": 20,
                "text": "The server MUST probe on the path toward the client from its"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "ac0055e3e734de3e"
                ],
                "status_id": 20,
                "text": "preferred address."
              },
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "  This helps to guard against spurious migration"
              }
            ],
            "   initiated by an attacker.",
            "",
            "   Once the server has completed its path validation and has received a",
            "   non-probing packet with a new largest packet number on its preferred",
            "   address, the server begins sending non-probing packets to the client",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   exclusively from its preferred IP address.  "
              },
              {
                "annotation_ids": [
                  "359003a1776a0ed2"
                ],
                "status_id": 14,
                "text": "The server SHOULD drop"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "359003a1776a0ed2"
                ],
                "status_id": 14,
                "text": "newer packets for this connection that are received on the old IP"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "359003a1776a0ed2"
                ],
                "status_id": 14,
                "text": "address."
              },
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "  "
              },
              {
                "annotation_ids": [
                  "097caac8c8a8e2b1"
                ],
                "status_id": 19,
                "text": "The server MAY continue to process delayed packets that are"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "097caac8c8a8e2b1"
                ],
                "status_id": 19,
                "text": "received on the old IP address."
              }
            ],
            "",
            "   The addresses that a server provides in the preferred_address",
            "   transport parameter are only valid for the connection in which they",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   are provided.  "
              },
              {
                "annotation_ids": [
                  "e554f66f4c330717"
                ],
                "status_id": 20,
                "text": "A client MUST NOT use these for other connections,"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "e554f66f4c330717"
                ],
                "status_id": 20,
                "text": "including connections that are resumed from the current connection."
              }
            ]
          ],
          "requirements": [
            "89a7308c121814fd",
            "89a7308c121814fd",
            "9a83dbaeebeda2eb",
            "9a83dbaeebeda2eb",
            "9a83dbaeebeda2eb",
            "9a83dbaeebeda2eb",
            "ac0055e3e734de3e",
            "ac0055e3e734de3e",
            "359003a1776a0ed2",
            "359003a1776a0ed2",
            "359003a1776a0ed2",
            "097caac8c8a8e2b1",
            "097caac8c8a8e2b1",
            "e554f66f4c330717",
            "e554f66f4c330717"
          ],
          "title": "Migration to a Preferred Address"
        },
        {
          "id": "section-9.6.3",
          "lines": [
            "   A client might need to perform a connection migration before it has",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   migrated to the server's preferred address.  "
              },
              {
                "annotation_ids": [
                  "783caea35edaa857"
                ],
                "status_id": 14,
                "text": "In this case, the client"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "783caea35edaa857"
                ],
                "status_id": 14,
                "text": "SHOULD perform path validation to both the original and preferred"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "783caea35edaa857"
                ],
                "status_id": 14,
                "text": "server address from the client's new address concurrently."
              }
            ],
            "",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "92de5eaf9f3bcfb8"
                ],
                "status_id": 20,
                "text": "If path validation of the server's preferred address succeeds, the"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "92de5eaf9f3bcfb8"
                ],
                "status_id": 20,
                "text": "client MUST abandon validation of the original address and migrate to"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "92de5eaf9f3bcfb8"
                ],
                "status_id": 20,
                "text": "using the server's preferred address."
              },
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "  "
              },
              {
                "annotation_ids": [
                  "5603818ccabe2891"
                ],
                "status_id": 19,
                "text": "If path validation of the"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "5603818ccabe2891"
                ],
                "status_id": 19,
                "text": "server's preferred address fails but validation of the server's"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "5603818ccabe2891"
                ],
                "status_id": 19,
                "text": "original address succeeds, the client MAY migrate to its new address"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "5603818ccabe2891"
                ],
                "status_id": 19,
                "text": "and continue sending to the server's original address."
              }
            ],
            "",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "e198ebb9b76f9dbb"
                ],
                "status_id": 20,
                "text": "If packets received at the server's preferred address have a"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "e198ebb9b76f9dbb"
                ],
                "status_id": 20,
                "text": "different source address than observed from the client during the"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "e198ebb9b76f9dbb"
                ],
                "status_id": 20,
                "text": "handshake, the server MUST protect against potential attacks as"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "e198ebb9b76f9dbb"
                ],
                "status_id": 20,
                "text": "described in Sections 9.3.1 and 9.3.2."
              },
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "  In addition to intentional"
              }
            ],
            "   simultaneous migration, this might also occur because the client's",
            "   access network used a different NAT binding for the server's",
            "   preferred address.",
            "",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "8af166bda7f04855",
                  "3937a9db0453f5dd"
                ],
                "status_id": 22,
                "text": "Servers SHOULD initiate path validation to the client's new address"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "8af166bda7f04855",
                  "3937a9db0453f5dd"
                ],
                "status_id": 22,
                "text": "upon receiving a probe packet from a different address;"
              },
              {
                "annotation_ids": [
                  "3937a9db0453f5dd"
                ],
                "status_id": 14,
                "text": " see"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "3937a9db0453f5dd"
                ],
                "status_id": 14,
                "text": "Section 8."
              }
            ],
            "",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "e24118c1d6142dee"
                ],
                "status_id": 14,
                "text": "A client that migrates to a new address SHOULD use a preferred"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "e24118c1d6142dee"
                ],
                "status_id": 14,
                "text": "address from the same address family for the server."
              }
            ],
            "",
            "   The connection ID provided in the preferred_address transport",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   parameter is not specific to the addresses that are provided.  "
              },
              {
                "annotation_ids": [
                  "0ab3a3bccc9bd011"
                ],
                "status_id": 19,
                "text": "This"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "0ab3a3bccc9bd011"
                ],
                "status_id": 19,
                "text": "connection ID is provided to ensure that the client has a connection"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "0ab3a3bccc9bd011"
                ],
                "status_id": 19,
                "text": "ID available for migration, but the client MAY use this connection ID"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "0ab3a3bccc9bd011"
                ],
                "status_id": 19,
                "text": "on any path."
              }
            ]
          ],
          "requirements": [
            "783caea35edaa857",
            "783caea35edaa857",
            "783caea35edaa857",
            "92de5eaf9f3bcfb8",
            "92de5eaf9f3bcfb8",
            "92de5eaf9f3bcfb8",
            "5603818ccabe2891",
            "5603818ccabe2891",
            "5603818ccabe2891",
            "5603818ccabe2891",
            "e198ebb9b76f9dbb",
            "e198ebb9b76f9dbb",
            "e198ebb9b76f9dbb",
            "e198ebb9b76f9dbb",
            "3937a9db0453f5dd",
            "3937a9db0453f5dd",
            "3937a9db0453f5dd",
            "e24118c1d6142dee",
            "e24118c1d6142dee",
            "0ab3a3bccc9bd011",
            "0ab3a3bccc9bd011",
            "0ab3a3bccc9bd011",
            "0ab3a3bccc9bd011"
          ],
          "title": "Interaction of Client Migration and Preferred Address"
        },
        {
          "id": "section-9.7",
          "lines": [
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "14fa71bef174fadd"
                ],
                "status_id": 14,
                "text": "Endpoints that send data using IPv6 SHOULD apply an IPv6 flow label"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "14fa71bef174fadd"
                ],
                "status_id": 14,
                "text": "in compliance with [RFC6437], unless the local API does not allow"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "14fa71bef174fadd"
                ],
                "status_id": 14,
                "text": "setting IPv6 flow labels."
              }
            ],
            "",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "5a24c678de15bd85"
                ],
                "status_id": 20,
                "text": "The flow label generation MUST be designed to minimize the chances of"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "5a24c678de15bd85"
                ],
                "status_id": 20,
                "text": "linkability with a previously used flow label, as a stable flow label"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "5a24c678de15bd85"
                ],
                "status_id": 20,
                "text": "would enable correlating activity on multiple paths; see Section 9.5."
              }
            ],
            "",
            "   [RFC6437] suggests deriving values using a pseudorandom function to",
            "   generate flow labels.  Including the Destination Connection ID field",
            "   in addition to source and destination addresses when generating flow",
            "   labels ensures that changes are synchronized with changes in other",
            "   observable identifiers.  A cryptographic hash function that combines",
            "   these inputs with a local secret is one way this might be",
            "   implemented."
          ],
          "requirements": [
            "14fa71bef174fadd",
            "14fa71bef174fadd",
            "14fa71bef174fadd",
            "5a24c678de15bd85",
            "5a24c678de15bd85",
            "5a24c678de15bd85"
          ],
          "title": "Use of IPv6 Flow Label and Migration"
        },
        {
          "id": "section-10",
          "lines": [
            "   An established QUIC connection can be terminated in one of three",
            "   ways:",
            "",
            "   *  idle timeout (Section 10.1)",
            "",
            "   *  immediate close (Section 10.2)",
            "",
            "   *  stateless reset (Section 10.3)",
            "",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "74d55e94ddfe1077",
                  "cd4d9e8b02eaebdd",
                  "ffe4a1daea6133b1"
                ],
                "status_id": 11,
                "text": "An endpoint MAY discard connection state if it does not have a"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "74d55e94ddfe1077",
                  "cd4d9e8b02eaebdd",
                  "ffe4a1daea6133b1"
                ],
                "status_id": 11,
                "text": "validated path on which it can send packets; see Section 8.2"
              },
              {
                "annotation_ids": [
                  "ffe4a1daea6133b1"
                ],
                "status_id": 19,
                "text": "."
              }
            ]
          ],
          "requirements": [
            "ffe4a1daea6133b1",
            "ffe4a1daea6133b1"
          ],
          "title": "Connection Termination"
        },
        {
          "id": "section-10.1",
          "lines": [
            "   If a max_idle_timeout is specified by either endpoint in its",
            "   transport parameters (Section 18.2), the connection is silently",
            "   closed and its state is discarded when it remains idle for longer",
            "   than the minimum of the max_idle_timeout value advertised by both",
            "   endpoints.",
            "",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "148e3118a7681d98",
                  "45cff286392d2c1a"
                ],
                "status_id": 1,
                "text": "Each endpoint advertises a max_idle_timeout, but the effective value"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "148e3118a7681d98",
                  "45cff286392d2c1a"
                ],
                "status_id": 1,
                "text": "at an endpoint is computed as the minimum of the two advertised"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "148e3118a7681d98",
                  "45cff286392d2c1a"
                ],
                "status_id": 1,
                "text": "values ("
              },
              {
                "annotation_ids": [
                  "45cff286392d2c1a"
                ],
                "status_id": 1,
                "text": "or the sole advertised value, if only one endpoint advertises"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "45cff286392d2c1a"
                ],
                "status_id": 1,
                "text": "a non-zero value).  By announcing a max_idle_timeout, an endpoint"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "45cff286392d2c1a"
                ],
                "status_id": 1,
                "text": "commits to initiating an immediate close (Section 10.2) if it"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "45cff286392d2c1a"
                ],
                "status_id": 1,
                "text": "abandons the connection prior to the effective value."
              }
            ],
            "",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "b175741fff8156ae"
                ],
                "status_id": 1,
                "text": "An endpoint restarts its idle timer when a packet from its peer is"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "b175741fff8156ae"
                ],
                "status_id": 1,
                "text": "received and processed successfully."
              },
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "  "
              },
              {
                "annotation_ids": [
                  "b6ab865044c4e43e",
                  "9b66cd9f00fa6096"
                ],
                "status_id": 1,
                "text": "An endpoint also restarts its"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "b6ab865044c4e43e",
                  "9b66cd9f00fa6096"
                ],
                "status_id": 1,
                "text": "idle timer when sending an ack-eliciting packet if no other ack-"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "b6ab865044c4e43e",
                  "9b66cd9f00fa6096"
                ],
                "status_id": 1,
                "text": "eliciting packets have been sent since last receiving and processing"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "b6ab865044c4e43e",
                  "9b66cd9f00fa6096"
                ],
                "status_id": 1,
                "text": "a packet."
              },
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "  Restarting this timer when sending a packet ensures that"
              }
            ],
            "   connections are not closed after new activity is initiated.",
            "",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "1c5f77141a354881",
                  "0b3307cdfba94a32"
                ],
                "status_id": 13,
                "text": "To avoid excessively small idle timeout periods, endpoints MUST"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "1c5f77141a354881",
                  "0b3307cdfba94a32"
                ],
                "status_id": 13,
                "text": "increase the idle timeout period to be at least three times the"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "1c5f77141a354881",
                  "0b3307cdfba94a32"
                ],
                "status_id": 13,
                "text": "current Probe Timeout (PTO)."
              },
              {
                "annotation_ids": [
                  "1c5f77141a354881"
                ],
                "status_id": 1,
                "text": "  This allows for multiple PTOs to"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "1c5f77141a354881"
                ],
                "status_id": 1,
                "text": "expire, and therefore multiple probes to be sent and lost, prior to"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "1c5f77141a354881"
                ],
                "status_id": 1,
                "text": "idle timeout."
              }
            ]
          ],
          "requirements": [
            "0b3307cdfba94a32",
            "0b3307cdfba94a32",
            "0b3307cdfba94a32"
          ],
          "title": "Idle Timeout"
        },
        {
          "id": "section-10.1.1",
          "lines": [
            "   An endpoint that sends packets close to the effective timeout risks",
            "   having them be discarded at the peer, since the idle timeout period",
            "   might have expired at the peer before these packets arrive.",
            "",
            "   An endpoint can send a PING or another ack-eliciting frame to test",
            "   the connection for liveness if the peer could time out soon, such as",
            "   within a PTO; see Section 6.2 of [QUIC-RECOVERY].  This is especially",
            "   useful if any available application data cannot be safely retried.",
            "   Note that the application determines what data is safe to retry."
          ],
          "title": "Liveness Testing"
        },
        {
          "id": "section-10.1.2",
          "lines": [
            "   An endpoint might need to send ack-eliciting packets to avoid an idle",
            "   timeout if it is expecting response data but does not have or is",
            "   unable to send application data.",
            "",
            "   An implementation of QUIC might provide applications with an option",
            "   to defer an idle timeout.  This facility could be used when the",
            "   application wishes to avoid losing state that has been associated",
            "   with an open connection but does not expect to exchange application",
            "   data for some time.  With this option, an endpoint could send a PING",
            "   frame (Section 19.2) periodically, which will cause the peer to",
            "   restart its idle timeout period.  Sending a packet containing a PING",
            "   frame restarts the idle timeout for this endpoint also if this is the",
            "   first ack-eliciting packet sent since receiving a packet.  Sending a",
            "   PING frame causes the peer to respond with an acknowledgment, which",
            "   also restarts the idle timeout for the endpoint.",
            "",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "44627613b95e2cf4"
                ],
                "status_id": 14,
                "text": "Application protocols that use QUIC SHOULD provide guidance on when"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "44627613b95e2cf4"
                ],
                "status_id": 14,
                "text": "deferring an idle timeout is appropriate."
              },
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "  Unnecessary sending of"
              }
            ],
            "   PING frames could have a detrimental effect on performance.",
            "",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "2160169107b21492",
                  "83d5bfdbef37d74b"
                ],
                "status_id": 1,
                "text": "A connection will time out if no packets are sent or received for a"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "2160169107b21492",
                  "83d5bfdbef37d74b"
                ],
                "status_id": 1,
                "text": "period longer than the time negotiated using the max_idle_timeout"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "2160169107b21492",
                  "83d5bfdbef37d74b"
                ],
                "status_id": 1,
                "text": "transport parameter; see Section 10.  However, state in middleboxes"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "2160169107b21492",
                  "83d5bfdbef37d74b"
                ],
                "status_id": 1,
                "text": "might time out earlier than that.  Though REQ-5 in [RFC4787]"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "2160169107b21492",
                  "83d5bfdbef37d74b"
                ],
                "status_id": 1,
                "text": "recommends a 2-minute timeout interval, experience shows that sending"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "2160169107b21492",
                  "83d5bfdbef37d74b"
                ],
                "status_id": 1,
                "text": "packets every 30 seconds is necessary to prevent the majority of"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "2160169107b21492",
                  "83d5bfdbef37d74b"
                ],
                "status_id": 1,
                "text": "middleboxes from losing state for UDP flows [GATEWAY]."
              }
            ]
          ],
          "requirements": [
            "44627613b95e2cf4",
            "44627613b95e2cf4"
          ],
          "title": "Deferring Idle Timeout"
        },
        {
          "id": "section-10.2",
          "lines": [
            "   An endpoint sends a CONNECTION_CLOSE frame (Section 19.19) to",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   terminate the connection immediately.  "
              },
              {
                "annotation_ids": [
                  "f5783ff2e2d9b75c"
                ],
                "status_id": 1,
                "text": "A CONNECTION_CLOSE frame"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "f5783ff2e2d9b75c"
                ],
                "status_id": 1,
                "text": "causes all streams to immediately become closed; open streams can be"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "f5783ff2e2d9b75c"
                ],
                "status_id": 1,
                "text": "assumed to be implicitly reset."
              }
            ],
            "",
            "   After sending a CONNECTION_CLOSE frame, an endpoint immediately",
            "   enters the closing state; see Section 10.2.1.  After receiving a",
            "   CONNECTION_CLOSE frame, endpoints enter the draining state; see",
            "   Section 10.2.2.",
            "",
            "   Violations of the protocol lead to an immediate close.",
            "",
            "   An immediate close can be used after an application protocol has",
            "   arranged to close a connection.  This might be after the application",
            "   protocol negotiates a graceful shutdown.  The application protocol",
            "   can exchange messages that are needed for both application endpoints",
            "   to agree that the connection can be closed, after which the",
            "   application requests that QUIC close the connection.  When QUIC",
            "   consequently closes the connection, a CONNECTION_CLOSE frame with an",
            "   application-supplied error code will be used to signal closure to the",
            "   peer.",
            "",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "ab18445d48072ccd"
                ],
                "status_id": 1,
                "text": "The closing and draining connection states exist to ensure that"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "ab18445d48072ccd"
                ],
                "status_id": 1,
                "text": "connections close cleanly and that delayed or reordered packets are"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "ab18445d48072ccd"
                ],
                "status_id": 1,
                "text": "properly discarded.  "
              },
              {
                "annotation_ids": [
                  "ab18445d48072ccd",
                  "f5177e72b112b986"
                ],
                "status_id": 22,
                "text": "These states SHOULD persist for at least three"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "ab18445d48072ccd",
                  "f5177e72b112b986"
                ],
                "status_id": 22,
                "text": "times the current PTO interval as defined in [QUIC-RECOVERY]."
              }
            ],
            "",
            "   Disposing of connection state prior to exiting the closing or",
            "   draining state could result in an endpoint generating a Stateless",
            "   Reset unnecessarily when it receives a late-arriving packet.",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "4392b1b054c7fe62"
                ],
                "status_id": 19,
                "text": "Endpoints that have some alternative means to ensure that late-"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "4392b1b054c7fe62"
                ],
                "status_id": 19,
                "text": "arriving packets do not induce a response, such as those that are"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "4392b1b054c7fe62"
                ],
                "status_id": 19,
                "text": "able to close the UDP socket, MAY end these states earlier to allow"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "4392b1b054c7fe62"
                ],
                "status_id": 19,
                "text": "for faster resource recovery."
              },
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "  "
              },
              {
                "annotation_ids": [
                  "2fe7d4209354393c"
                ],
                "status_id": 14,
                "text": "Servers that retain an open socket for"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "2fe7d4209354393c"
                ],
                "status_id": 14,
                "text": "accepting new connections SHOULD NOT end the closing or draining"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "2fe7d4209354393c"
                ],
                "status_id": 14,
                "text": "state early."
              }
            ],
            "",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "ceb5129153a31b80",
                  "5d9ec33ac77943c1"
                ],
                "status_id": 22,
                "text": "Once its closing or draining state ends, an endpoint SHOULD discard"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "ceb5129153a31b80",
                  "5d9ec33ac77943c1"
                ],
                "status_id": 22,
                "text": "all connection state."
              },
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "  "
              },
              {
                "annotation_ids": [
                  "4ca28b0171ff7324"
                ],
                "status_id": 19,
                "text": "The endpoint MAY send a Stateless Reset in"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "4ca28b0171ff7324"
                ],
                "status_id": 19,
                "text": "response to any further incoming packets belonging to this"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "4ca28b0171ff7324"
                ],
                "status_id": 19,
                "text": "connection."
              }
            ]
          ],
          "requirements": [
            "f5177e72b112b986",
            "f5177e72b112b986",
            "4392b1b054c7fe62",
            "4392b1b054c7fe62",
            "4392b1b054c7fe62",
            "4392b1b054c7fe62",
            "2fe7d4209354393c",
            "2fe7d4209354393c",
            "2fe7d4209354393c",
            "5d9ec33ac77943c1",
            "5d9ec33ac77943c1",
            "4ca28b0171ff7324",
            "4ca28b0171ff7324",
            "4ca28b0171ff7324"
          ],
          "title": "Immediate Close"
        },
        {
          "id": "section-10.2.1",
          "lines": [
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "fa9dfa755bf910d5"
                ],
                "status_id": 1,
                "text": "An endpoint enters the closing state after initiating an immediate"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "fa9dfa755bf910d5"
                ],
                "status_id": 1,
                "text": "close."
              }
            ],
            "",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "f36d0a65425d3783"
                ],
                "status_id": 1,
                "text": "In the closing state, an endpoint retains only enough information to"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "f36d0a65425d3783"
                ],
                "status_id": 1,
                "text": "generate a packet containing a CONNECTION_CLOSE frame and to identify"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "f36d0a65425d3783"
                ],
                "status_id": 1,
                "text": "packets as belonging to the connection."
              },
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "  "
              },
              {
                "annotation_ids": [
                  "29633441c13579d7"
                ],
                "status_id": 1,
                "text": "An endpoint in the closing"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "29633441c13579d7"
                ],
                "status_id": 1,
                "text": "state sends a packet containing a CONNECTION_CLOSE frame in response"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "29633441c13579d7"
                ],
                "status_id": 1,
                "text": "to any incoming packet that it attributes to the connection."
              }
            ],
            "",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "f22d3df4dfb4ba24",
                  "8d14dba9d4ae43a9"
                ],
                "status_id": 22,
                "text": "An endpoint SHOULD limit the rate at which it generates packets in"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "f22d3df4dfb4ba24",
                  "8d14dba9d4ae43a9"
                ],
                "status_id": 22,
                "text": "the closing state."
              },
              {
                "annotation_ids": [
                  "f22d3df4dfb4ba24"
                ],
                "status_id": 1,
                "text": "  For instance, an endpoint could wait for a"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "f22d3df4dfb4ba24"
                ],
                "status_id": 1,
                "text": "progressively increasing number of received packets or amount of time"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "f22d3df4dfb4ba24"
                ],
                "status_id": 1,
                "text": "before responding to received packets."
              }
            ],
            "",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "ba49ac8316d5624b",
                  "5f539564bdd36e2d"
                ],
                "status_id": 21,
                "text": "An endpoint's selected connection ID and the QUIC version are"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "ba49ac8316d5624b",
                  "5f539564bdd36e2d"
                ],
                "status_id": 21,
                "text": "sufficient information to identify packets for a closing connection;"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "ba49ac8316d5624b",
                  "5f539564bdd36e2d"
                ],
                "status_id": 21,
                "text": "the endpoint MAY discard all other connection state."
              },
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "  "
              },
              {
                "annotation_ids": [
                  "790e3e2def69a985",
                  "86f7ef2a7404d8a9",
                  "17209f6810911223"
                ],
                "status_id": 1,
                "text": "An endpoint"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "790e3e2def69a985",
                  "86f7ef2a7404d8a9",
                  "17209f6810911223"
                ],
                "status_id": 1,
                "text": "that is closing is not required to process any received frame."
              },
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "  "
              },
              {
                "annotation_ids": [
                  "2c6d429cf7816984"
                ],
                "status_id": 19,
                "text": "An"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "2c6d429cf7816984"
                ],
                "status_id": 19,
                "text": "endpoint MAY retain packet protection keys for incoming packets to"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "2c6d429cf7816984"
                ],
                "status_id": 19,
                "text": "allow it to read and process a CONNECTION_CLOSE frame."
              }
            ],
            "",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "41bad1443b771c47"
                ],
                "status_id": 19,
                "text": "An endpoint MAY drop packet protection keys when entering the closing"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "41bad1443b771c47"
                ],
                "status_id": 19,
                "text": "state and send a packet containing a CONNECTION_CLOSE frame in"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "41bad1443b771c47"
                ],
                "status_id": 19,
                "text": "response to any UDP datagram that is received."
              },
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "  However, an endpoint"
              }
            ],
            "   that discards packet protection keys cannot identify and discard",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   invalid packets.  "
              },
              {
                "annotation_ids": [
                  "1d761ac8bfe1dc8f"
                ],
                "status_id": 20,
                "text": "To avoid being used for an amplification attack,"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "1d761ac8bfe1dc8f"
                ],
                "status_id": 20,
                "text": "such endpoints MUST limit the cumulative size of packets it sends to"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "1d761ac8bfe1dc8f"
                ],
                "status_id": 20,
                "text": "three times the cumulative size of the packets that are received and"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "1d761ac8bfe1dc8f"
                ],
                "status_id": 20,
                "text": "attributed to the connection."
              },
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "  "
              },
              {
                "annotation_ids": [
                  "1ae6a2f1dc8366bd"
                ],
                "status_id": 19,
                "text": "To minimize the state that an endpoint"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "1ae6a2f1dc8366bd"
                ],
                "status_id": 19,
                "text": "maintains for a closing connection, endpoints MAY send the exact same"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "1ae6a2f1dc8366bd"
                ],
                "status_id": 19,
                "text": "packet in response to any received packet."
              }
            ],
            "",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "      "
              },
              {
                "annotation_ids": [
                  "7458271382f6070e"
                ],
                "status_id": 1,
                "text": "|  Note: Allowing retransmission of a closing packet is an"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "      "
              },
              {
                "annotation_ids": [
                  "7458271382f6070e"
                ],
                "status_id": 1,
                "text": "|  exception to the requirement that a new packet number be used"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "      "
              },
              {
                "annotation_ids": [
                  "7458271382f6070e"
                ],
                "status_id": 1,
                "text": "|  for each packet; see Section 12.3.  Sending new packet numbers"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "      "
              },
              {
                "annotation_ids": [
                  "7458271382f6070e"
                ],
                "status_id": 1,
                "text": "|  is primarily of advantage to loss recovery and congestion"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "      "
              },
              {
                "annotation_ids": [
                  "7458271382f6070e"
                ],
                "status_id": 1,
                "text": "|  control, which are not expected to be relevant for a closed"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "      "
              },
              {
                "annotation_ids": [
                  "7458271382f6070e"
                ],
                "status_id": 1,
                "text": "|  connection.  Retransmitting the final packet requires less"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "      "
              },
              {
                "annotation_ids": [
                  "7458271382f6070e"
                ],
                "status_id": 1,
                "text": "|  state."
              }
            ],
            "",
            "   While in the closing state, an endpoint could receive packets from a",
            "   new source address, possibly indicating a connection migration; see",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   Section 9.  "
              },
              {
                "annotation_ids": [
                  "b965402bc973f6c5",
                  "e825b24467f1ba69"
                ],
                "status_id": 13,
                "text": "An endpoint in the closing state MUST either discard"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "b965402bc973f6c5",
                  "e825b24467f1ba69"
                ],
                "status_id": 13,
                "text": "packets received from an unvalidated address or limit the cumulative"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "b965402bc973f6c5",
                  "e825b24467f1ba69"
                ],
                "status_id": 13,
                "text": "size of packets it sends to an unvalidated address to three times the"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "b965402bc973f6c5",
                  "e825b24467f1ba69"
                ],
                "status_id": 13,
                "text": "size of packets it receives from that address."
              }
            ],
            "",
            "   An endpoint is not expected to handle key updates when it is closing",
            "   (Section 6 of [QUIC-TLS]).  A key update might prevent the endpoint",
            "   from moving from the closing state to the draining state, as the",
            "   endpoint will not be able to process subsequently received packets,",
            "   but it otherwise has no impact."
          ],
          "requirements": [
            "8d14dba9d4ae43a9",
            "8d14dba9d4ae43a9",
            "5f539564bdd36e2d",
            "5f539564bdd36e2d",
            "5f539564bdd36e2d",
            "2c6d429cf7816984",
            "2c6d429cf7816984",
            "2c6d429cf7816984",
            "41bad1443b771c47",
            "41bad1443b771c47",
            "41bad1443b771c47",
            "1d761ac8bfe1dc8f",
            "1d761ac8bfe1dc8f",
            "1d761ac8bfe1dc8f",
            "1d761ac8bfe1dc8f",
            "1ae6a2f1dc8366bd",
            "1ae6a2f1dc8366bd",
            "1ae6a2f1dc8366bd",
            "e825b24467f1ba69",
            "e825b24467f1ba69",
            "e825b24467f1ba69",
            "e825b24467f1ba69"
          ],
          "title": "Closing Connection State"
        },
        {
          "id": "section-10.2.2",
          "lines": [
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "7cc95d7fbacd8b4c"
                ],
                "status_id": 1,
                "text": "The draining state is entered once an endpoint receives a"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "7cc95d7fbacd8b4c"
                ],
                "status_id": 1,
                "text": "CONNECTION_CLOSE frame, which indicates that its peer is closing or"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "7cc95d7fbacd8b4c"
                ],
                "status_id": 1,
                "text": "draining."
              },
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "  "
              },
              {
                "annotation_ids": [
                  "aca79d8decdaae1f",
                  "67c05da063e0b92d"
                ],
                "status_id": 13,
                "text": "While otherwise identical to the closing state, an"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "aca79d8decdaae1f",
                  "67c05da063e0b92d"
                ],
                "status_id": 13,
                "text": "endpoint in the draining state MUST NOT send any packets."
              },
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "  Retaining"
              }
            ],
            "   packet protection keys is unnecessary once a connection is in the",
            "   draining state.",
            "",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "0a48c1a971d3a227"
                ],
                "status_id": 19,
                "text": "An endpoint that receives a CONNECTION_CLOSE frame MAY send a single"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "0a48c1a971d3a227"
                ],
                "status_id": 19,
                "text": "packet containing a CONNECTION_CLOSE frame before entering the"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "0a48c1a971d3a227"
                ],
                "status_id": 19,
                "text": "draining state, using a NO_ERROR code if appropriate."
              },
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "  "
              },
              {
                "annotation_ids": [
                  "4a76e834880c4198"
                ],
                "status_id": 20,
                "text": "An endpoint"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "4a76e834880c4198"
                ],
                "status_id": 20,
                "text": "MUST NOT send further packets."
              },
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "  Doing so could result in a constant"
              }
            ],
            "   exchange of CONNECTION_CLOSE frames until one of the endpoints exits",
            "   the closing state.",
            "",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "10c1bd877ec6e935"
                ],
                "status_id": 19,
                "text": "An endpoint MAY enter the draining state from the closing state if it"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "10c1bd877ec6e935"
                ],
                "status_id": 19,
                "text": "receives a CONNECTION_CLOSE frame, which indicates that the peer is"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "10c1bd877ec6e935"
                ],
                "status_id": 19,
                "text": "also closing or draining."
              },
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "  In this case, the draining state ends when"
              }
            ],
            "   the closing state would have ended.  In other words, the endpoint",
            "   uses the same end time but ceases transmission of any packets on this",
            "   connection."
          ],
          "requirements": [
            "67c05da063e0b92d",
            "67c05da063e0b92d",
            "0a48c1a971d3a227",
            "0a48c1a971d3a227",
            "0a48c1a971d3a227",
            "4a76e834880c4198",
            "4a76e834880c4198",
            "10c1bd877ec6e935",
            "10c1bd877ec6e935",
            "10c1bd877ec6e935"
          ],
          "title": "Draining Connection State"
        },
        {
          "id": "section-10.2.3",
          "lines": [
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "a242f9da661b7562"
                ],
                "status_id": 1,
                "text": "When sending a CONNECTION_CLOSE frame, the goal is to ensure that the"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "a242f9da661b7562"
                ],
                "status_id": 1,
                "text": "peer will process the frame.  Generally, this means sending the frame"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "a242f9da661b7562"
                ],
                "status_id": 1,
                "text": "in a packet with the highest level of packet protection to avoid the"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "a242f9da661b7562"
                ],
                "status_id": 1,
                "text": "packet being discarded."
              },
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "  "
              },
              {
                "annotation_ids": [
                  "6010523178d9c15a",
                  "8f9a2bf6f1053e4f"
                ],
                "status_id": 13,
                "text": "After the handshake is confirmed (see"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "6010523178d9c15a",
                  "8f9a2bf6f1053e4f"
                ],
                "status_id": 13,
                "text": "Section 4.1.2 of [QUIC-TLS]), an endpoint MUST send any"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "6010523178d9c15a",
                  "8f9a2bf6f1053e4f"
                ],
                "status_id": 13,
                "text": "CONNECTION_CLOSE frames in a 1-RTT packet."
              },
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "  "
              },
              {
                "annotation_ids": [
                  "0f0732486f25819a"
                ],
                "status_id": 19,
                "text": "However, prior to"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "0f0732486f25819a"
                ],
                "status_id": 19,
                "text": "confirming the handshake, it is possible that more advanced packet"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "0f0732486f25819a"
                ],
                "status_id": 19,
                "text": "protection keys are not available to the peer, so another"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "0f0732486f25819a"
                ],
                "status_id": 19,
                "text": "CONNECTION_CLOSE frame MAY be sent in a packet that uses a lower"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "0f0732486f25819a"
                ],
                "status_id": 19,
                "text": "packet protection level."
              },
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "  More specifically:"
              }
            ],
            "",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   *  "
              },
              {
                "annotation_ids": [
                  "1abfd2fd2c22a55e"
                ],
                "status_id": 1,
                "text": "A client will always know whether the server has Handshake keys"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "      "
              },
              {
                "annotation_ids": [
                  "1abfd2fd2c22a55e"
                ],
                "status_id": 1,
                "text": "(see Section 17.2.2.1), but it is possible that a server does not"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "      "
              },
              {
                "annotation_ids": [
                  "1abfd2fd2c22a55e"
                ],
                "status_id": 1,
                "text": "know whether the client has Handshake keys.  "
              },
              {
                "annotation_ids": [
                  "1abfd2fd2c22a55e",
                  "e9df32821f4c71cb"
                ],
                "status_id": 22,
                "text": "Under these"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "      "
              },
              {
                "annotation_ids": [
                  "1abfd2fd2c22a55e",
                  "e9df32821f4c71cb"
                ],
                "status_id": 22,
                "text": "circumstances, a server SHOULD send a CONNECTION_CLOSE frame in"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "      "
              },
              {
                "annotation_ids": [
                  "1abfd2fd2c22a55e",
                  "e9df32821f4c71cb"
                ],
                "status_id": 22,
                "text": "both Handshake and Initial packets to ensure that at least one of"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "      "
              },
              {
                "annotation_ids": [
                  "1abfd2fd2c22a55e",
                  "e9df32821f4c71cb"
                ],
                "status_id": 22,
                "text": "them is processable by the client."
              }
            ],
            "",
            "   *  A client that sends a CONNECTION_CLOSE frame in a 0-RTT packet",
            "      cannot be assured that the server has accepted 0-RTT.  Sending a",
            "      CONNECTION_CLOSE frame in an Initial packet makes it more likely",
            "      that the server can receive the close signal, even if the",
            "      application error code might not be received.",
            "",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "fd95d60eec6c962d"
                ],
                "status_id": 14,
                "text": "*  Prior to confirming the handshake, a peer might be unable to"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "      "
              },
              {
                "annotation_ids": [
                  "fd95d60eec6c962d"
                ],
                "status_id": 14,
                "text": "process 1-RTT packets, so an endpoint SHOULD send a"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "      "
              },
              {
                "annotation_ids": [
                  "fd95d60eec6c962d"
                ],
                "status_id": 14,
                "text": "CONNECTION_CLOSE frame in both Handshake and 1-RTT packets."
              },
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "  "
              },
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "A"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "      "
              },
              {
                "annotation_ids": [
                  "bf4286125401b7dd"
                ],
                "status_id": 14,
                "text": "server SHOULD also send a CONNECTION_CLOSE frame in an Initial"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "      "
              },
              {
                "annotation_ids": [
                  "bf4286125401b7dd"
                ],
                "status_id": 14,
                "text": "packet."
              }
            ],
            "",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "67598e99d4e57e99"
                ],
                "status_id": 1,
                "text": "Sending a CONNECTION_CLOSE of type 0x1d in an Initial or Handshake"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "67598e99d4e57e99"
                ],
                "status_id": 1,
                "text": "packet could expose application state or be used to alter application"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "67598e99d4e57e99"
                ],
                "status_id": 1,
                "text": "state.  "
              },
              {
                "annotation_ids": [
                  "67598e99d4e57e99",
                  "046cdacc40a27a85"
                ],
                "status_id": 13,
                "text": "A CONNECTION_CLOSE of type 0x1d MUST be replaced by a"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "67598e99d4e57e99",
                  "046cdacc40a27a85"
                ],
                "status_id": 13,
                "text": "CONNECTION_CLOSE of type 0x1c when sending the frame in Initial or"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "67598e99d4e57e99",
                  "046cdacc40a27a85"
                ],
                "status_id": 13,
                "text": "Handshake packets."
              },
              {
                "annotation_ids": [
                  "67598e99d4e57e99"
                ],
                "status_id": 1,
                "text": "  Otherwise, information about the application"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "67598e99d4e57e99"
                ],
                "status_id": 1,
                "text": "state might be revealed.  "
              },
              {
                "annotation_ids": [
                  "67598e99d4e57e99",
                  "112388f08907f460"
                ],
                "status_id": 13,
                "text": "Endpoints MUST clear the value of the"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "67598e99d4e57e99",
                  "112388f08907f460"
                ],
                "status_id": 13,
                "text": "Reason Phrase field and SHOULD use the APPLICATION_ERROR code when"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "67598e99d4e57e99",
                  "112388f08907f460"
                ],
                "status_id": 13,
                "text": "converting to a CONNECTION_CLOSE of type 0x1c."
              }
            ],
            "",
            "   CONNECTION_CLOSE frames sent in multiple packet types can be",
            "   coalesced into a single UDP datagram; see Section 12.2.",
            "",
            "   An endpoint can send a CONNECTION_CLOSE frame in an Initial packet.",
            "   This might be in response to unauthenticated information received in",
            "   Initial or Handshake packets.  Such an immediate close might expose",
            "   legitimate connections to a denial of service.  QUIC does not include",
            "   defensive measures for on-path attacks during the handshake; see",
            "   Section 21.2.  However, at the cost of reducing feedback about errors",
            "   for legitimate peers, some forms of denial of service can be made",
            "   more difficult for an attacker if endpoints discard illegal packets",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   rather than terminating a connection with CONNECTION_CLOSE.  "
              },
              {
                "annotation_ids": [
                  "39a14a133ff52bcf"
                ],
                "status_id": 19,
                "text": "For this"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "39a14a133ff52bcf"
                ],
                "status_id": 19,
                "text": "reason, endpoints MAY discard packets rather than immediately close"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "39a14a133ff52bcf"
                ],
                "status_id": 19,
                "text": "if errors are detected in packets that lack authentication."
              }
            ],
            "",
            "   An endpoint that has not established state, such as a server that",
            "   detects an error in an Initial packet, does not enter the closing",
            "   state.  An endpoint that has no state for the connection does not",
            "   enter a closing or draining period on sending a CONNECTION_CLOSE",
            "   frame."
          ],
          "requirements": [
            "8f9a2bf6f1053e4f",
            "8f9a2bf6f1053e4f",
            "8f9a2bf6f1053e4f",
            "0f0732486f25819a",
            "0f0732486f25819a",
            "0f0732486f25819a",
            "0f0732486f25819a",
            "0f0732486f25819a",
            "e9df32821f4c71cb",
            "e9df32821f4c71cb",
            "e9df32821f4c71cb",
            "e9df32821f4c71cb",
            "fd95d60eec6c962d",
            "fd95d60eec6c962d",
            "fd95d60eec6c962d",
            "bf4286125401b7dd",
            "bf4286125401b7dd",
            "bf4286125401b7dd",
            "046cdacc40a27a85",
            "046cdacc40a27a85",
            "046cdacc40a27a85",
            "112388f08907f460",
            "112388f08907f460",
            "112388f08907f460",
            "39a14a133ff52bcf",
            "39a14a133ff52bcf",
            "39a14a133ff52bcf"
          ],
          "title": "Immediate Close during the Handshake"
        },
        {
          "id": "section-10.3",
          "lines": [
            "   A stateless reset is provided as an option of last resort for an",
            "   endpoint that does not have access to the state of a connection.  A",
            "   crash or outage might result in peers continuing to send data to an",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   endpoint that is unable to properly continue the connection.  "
              },
              {
                "annotation_ids": [
                  "17956cca0be67f22",
                  "2969e01135d76d7e"
                ],
                "status_id": 21,
                "text": "An"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "17956cca0be67f22",
                  "2969e01135d76d7e"
                ],
                "status_id": 21,
                "text": "endpoint MAY send a Stateless Reset in response to receiving a packet"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "17956cca0be67f22",
                  "2969e01135d76d7e"
                ],
                "status_id": 21,
                "text": "that it cannot associate with an active connection."
              }
            ],
            "",
            "   A stateless reset is not appropriate for indicating errors in active",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   connections.  "
              },
              {
                "annotation_ids": [
                  "8ef5f9daef4d6b1e",
                  "9bae62a78dfbc091"
                ],
                "status_id": 13,
                "text": "An endpoint that wishes to communicate a fatal"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "8ef5f9daef4d6b1e",
                  "9bae62a78dfbc091"
                ],
                "status_id": 13,
                "text": "connection error MUST use a CONNECTION_CLOSE frame if it is able."
              }
            ],
            "",
            "   To support this process, an endpoint issues a stateless reset token,",
            "   which is a 16-byte value that is hard to guess.  If the peer",
            "   subsequently receives a Stateless Reset, which is a UDP datagram that",
            "   ends in that stateless reset token, the peer will immediately end the",
            "   connection.",
            "",
            "   A stateless reset token is specific to a connection ID.  An endpoint",
            "   issues a stateless reset token by including the value in the",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   Stateless Reset Token field of a NEW_CONNECTION_ID frame.  "
              },
              {
                "annotation_ids": [
                  "f704d073bd2b7766"
                ],
                "status_id": 1,
                "text": "Servers"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "f704d073bd2b7766"
                ],
                "status_id": 1,
                "text": "can also issue a stateless_reset_token transport parameter during the"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "f704d073bd2b7766"
                ],
                "status_id": 1,
                "text": "handshake that applies to the connection ID that it selected during"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "f704d073bd2b7766"
                ],
                "status_id": 1,
                "text": "the handshake.  These exchanges are protected by encryption, so only"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "f704d073bd2b7766"
                ],
                "status_id": 1,
                "text": "client and server know their value.  "
              },
              {
                "annotation_ids": [
                  "a6e6ef780f6b3c0c",
                  "f704d073bd2b7766"
                ],
                "status_id": 1,
                "text": "Note that clients cannot use the"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "a6e6ef780f6b3c0c",
                  "f704d073bd2b7766"
                ],
                "status_id": 1,
                "text": "stateless_reset_token transport parameter because their transport"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "a6e6ef780f6b3c0c",
                  "f704d073bd2b7766"
                ],
                "status_id": 1,
                "text": "parameters do not have confidentiality protection."
              }
            ],
            "",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "b86f685de7a79c46"
                ],
                "status_id": 1,
                "text": "Tokens are invalidated when their associated connection ID is retired"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "b86f685de7a79c46"
                ],
                "status_id": 1,
                "text": "via a RETIRE_CONNECTION_ID frame (Section 19.16)."
              }
            ],
            "",
            "   An endpoint that receives packets that it cannot process sends a",
            "   packet in the following layout (see Section 1.3):",
            "",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "b695dfd4e13d6b7f",
                  "c940042061b50f17",
                  "2131516465b2a1bb"
                ],
                "status_id": 1,
                "text": "Stateless Reset {"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "     "
              },
              {
                "annotation_ids": [
                  "b695dfd4e13d6b7f",
                  "c940042061b50f17",
                  "2131516465b2a1bb"
                ],
                "status_id": 1,
                "text": "Fixed Bits (2) = 1,"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "     "
              },
              {
                "annotation_ids": [
                  "b695dfd4e13d6b7f",
                  "c940042061b50f17",
                  "2131516465b2a1bb"
                ],
                "status_id": 1,
                "text": "Unpredictable Bits (38..),"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "     "
              },
              {
                "annotation_ids": [
                  "b695dfd4e13d6b7f",
                  "c940042061b50f17",
                  "2131516465b2a1bb"
                ],
                "status_id": 1,
                "text": "Stateless Reset Token (128),"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "}"
              }
            ],
            "",
            "                         Figure 10: Stateless Reset",
            "",
            "   This design ensures that a Stateless Reset is -- to the extent",
            "   possible -- indistinguishable from a regular packet with a short",
            "   header.",
            "",
            "   A Stateless Reset uses an entire UDP datagram, starting with the",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   first two bits of the packet header.  "
              },
              {
                "annotation_ids": [
                  "a40a4dddf9ae16fc",
                  "463c53d4ba6293f5",
                  "0ad177a32e4a89f7"
                ],
                "status_id": 8,
                "text": "The remainder of the first byte"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "a40a4dddf9ae16fc",
                  "463c53d4ba6293f5",
                  "0ad177a32e4a89f7"
                ],
                "status_id": 8,
                "text": "and an arbitrary number of bytes following it are set to values that"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "a40a4dddf9ae16fc",
                  "463c53d4ba6293f5",
                  "0ad177a32e4a89f7"
                ],
                "status_id": 8,
                "text": "SHOULD be indistinguishable from random."
              },
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "  The last 16 bytes of the"
              }
            ],
            "   datagram contain a stateless reset token.",
            "",
            "   To entities other than its intended recipient, a Stateless Reset will",
            "   appear to be a packet with a short header.  For the Stateless Reset",
            "   to appear as a valid QUIC packet, the Unpredictable Bits field needs",
            "   to include at least 38 bits of data (or 5 bytes, less the two fixed",
            "   bits).",
            "",
            "   The resulting minimum size of 21 bytes does not guarantee that a",
            "   Stateless Reset is difficult to distinguish from other packets if the",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   recipient requires the use of a connection ID.  "
              },
              {
                "annotation_ids": [
                  "5926c780076bcdf1",
                  "e897e633e355bf3f"
                ],
                "status_id": 22,
                "text": "To achieve that end,"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "5926c780076bcdf1",
                  "e897e633e355bf3f"
                ],
                "status_id": 22,
                "text": "the endpoint SHOULD ensure that all packets it sends are at least 22"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "5926c780076bcdf1",
                  "e897e633e355bf3f"
                ],
                "status_id": 22,
                "text": "bytes longer than the minimum connection ID length that it requests"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "5926c780076bcdf1",
                  "e897e633e355bf3f"
                ],
                "status_id": 22,
                "text": "the peer to include in its packets, adding PADDING frames as"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "5926c780076bcdf1",
                  "e897e633e355bf3f"
                ],
                "status_id": 22,
                "text": "necessary."
              },
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "  This ensures that any Stateless Reset sent by the peer is"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   indistinguishable from a valid packet sent to the endpoint.  "
              },
              {
                "annotation_ids": [
                  "1d9a0b31b9fb4ced",
                  "ef7878b7d9f7dd1e"
                ],
                "status_id": 10,
                "text": "An"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "1d9a0b31b9fb4ced",
                  "ef7878b7d9f7dd1e"
                ],
                "status_id": 10,
                "text": "endpoint that sends a Stateless Reset in response to a packet that is"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "1d9a0b31b9fb4ced",
                  "ef7878b7d9f7dd1e"
                ],
                "status_id": 10,
                "text": "43 bytes or shorter SHOULD send a Stateless Reset that is one byte"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "1d9a0b31b9fb4ced",
                  "ef7878b7d9f7dd1e"
                ],
                "status_id": 10,
                "text": "shorter than the packet it responds to."
              }
            ],
            "",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "2822cb1811c01b89"
                ],
                "status_id": 1,
                "text": "These values assume that the stateless reset token is the same length"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "2822cb1811c01b89"
                ],
                "status_id": 1,
                "text": "as the minimum expansion of the packet protection AEAD.  Additional"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "2822cb1811c01b89"
                ],
                "status_id": 1,
                "text": "unpredictable bytes are necessary if the endpoint could have"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "2822cb1811c01b89"
                ],
                "status_id": 1,
                "text": "negotiated a packet protection scheme with a larger minimum"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "2822cb1811c01b89"
                ],
                "status_id": 1,
                "text": "expansion."
              }
            ],
            "",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "c3abfc6f42c37b99",
                  "d5dba80d93061fed",
                  "d0c38dd3fc97ca60"
                ],
                "status_id": 9,
                "text": "An endpoint MUST NOT send a Stateless Reset that is three times or"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "c3abfc6f42c37b99",
                  "d5dba80d93061fed",
                  "d0c38dd3fc97ca60"
                ],
                "status_id": 9,
                "text": "more larger than the packet it receives to avoid being used for"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "c3abfc6f42c37b99",
                  "d5dba80d93061fed",
                  "d0c38dd3fc97ca60"
                ],
                "status_id": 9,
                "text": "amplification."
              },
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "  Section 10.3.3 describes additional limits on"
              }
            ],
            "   Stateless Reset size.",
            "",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "86923421f62d7d61",
                  "5585bb546cb2d213"
                ],
                "status_id": 17,
                "text": "Endpoints MUST discard packets that are too small to be valid QUIC"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "86923421f62d7d61",
                  "5585bb546cb2d213"
                ],
                "status_id": 17,
                "text": "packets."
              },
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "  To give an example, with the set of AEAD functions defined"
              }
            ],
            "   in [QUIC-TLS], short header packets that are smaller than 21 bytes",
            "   are never valid.",
            "",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "020699b6572a8140",
                  "e7b060565c8998f9",
                  "ff506722e4c89e85",
                  "7ab7c9678b3a4715"
                ],
                "status_id": 9,
                "text": "Endpoints MUST send Stateless Resets formatted as a packet with a"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "020699b6572a8140",
                  "e7b060565c8998f9",
                  "ff506722e4c89e85",
                  "7ab7c9678b3a4715"
                ],
                "status_id": 9,
                "text": "short header."
              },
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "  "
              },
              {
                "annotation_ids": [
                  "df7bdc553d627866",
                  "5608ad47e17282db",
                  "b62bbc555f50f04a"
                ],
                "status_id": 13,
                "text": "However, endpoints MUST treat any packet ending in a"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "df7bdc553d627866",
                  "5608ad47e17282db",
                  "b62bbc555f50f04a"
                ],
                "status_id": 13,
                "text": "valid stateless reset token as a Stateless Reset, as other QUIC"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "df7bdc553d627866",
                  "5608ad47e17282db",
                  "b62bbc555f50f04a"
                ],
                "status_id": 13,
                "text": "versions might allow the use of a long header."
              }
            ],
            "",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "6697c4179935374a",
                  "afa9c12b9e90b922"
                ],
                "status_id": 15,
                "text": "An endpoint MAY send a Stateless Reset in response to a packet with a"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "6697c4179935374a",
                  "afa9c12b9e90b922"
                ],
                "status_id": 15,
                "text": "long header."
              },
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "  Sending a Stateless Reset is not effective prior to the"
              }
            ],
            "   stateless reset token being available to a peer.  In this QUIC",
            "   version, packets with a long header are only used during connection",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   establishment.  "
              },
              {
                "annotation_ids": [
                  "6c6a07cff1181e36"
                ],
                "status_id": 1,
                "text": "Because the stateless reset token is not available"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "6c6a07cff1181e36"
                ],
                "status_id": 1,
                "text": "until connection establishment is complete or near completion,"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "6c6a07cff1181e36"
                ],
                "status_id": 1,
                "text": "ignoring an unknown packet with a long header might be as effective"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "6c6a07cff1181e36"
                ],
                "status_id": 1,
                "text": "as sending a Stateless Reset."
              }
            ],
            "",
            "   An endpoint cannot determine the Source Connection ID from a packet",
            "   with a short header; therefore, it cannot set the Destination",
            "   Connection ID in the Stateless Reset.  The Destination Connection ID",
            "   will therefore differ from the value used in previous packets.  A",
            "   random Destination Connection ID makes the connection ID appear to be",
            "   the result of moving to a new connection ID that was provided using a",
            "   NEW_CONNECTION_ID frame; see Section 19.15.",
            "",
            "   Using a randomized connection ID results in two problems:",
            "",
            "   *  The packet might not reach the peer.  If the Destination",
            "      Connection ID is critical for routing toward the peer, then this",
            "      packet could be incorrectly routed.  This might also trigger",
            "      another Stateless Reset in response; see Section 10.3.3.  A",
            "      Stateless Reset that is not correctly routed is an ineffective",
            "      error detection and recovery mechanism.  In this case, endpoints",
            "      will need to rely on other methods -- such as timers -- to detect",
            "      that the connection has failed.",
            "",
            "   *  The randomly generated connection ID can be used by entities other",
            "      than the peer to identify this as a potential Stateless Reset.  An",
            "      endpoint that occasionally uses different connection IDs might",
            "      introduce some uncertainty about this.",
            "",
            "   This stateless reset design is specific to QUIC version 1.  An",
            "   endpoint that supports multiple versions of QUIC needs to generate a",
            "   Stateless Reset that will be accepted by peers that support any",
            "   version that the endpoint might support (or might have supported",
            "   prior to losing state).  Designers of new versions of QUIC need to be",
            "   aware of this and either (1) reuse this design or (2) use a portion",
            "   of the packet other than the last 16 bytes for carrying data."
          ],
          "requirements": [
            "2969e01135d76d7e",
            "2969e01135d76d7e",
            "2969e01135d76d7e",
            "9bae62a78dfbc091",
            "9bae62a78dfbc091",
            "0ad177a32e4a89f7",
            "0ad177a32e4a89f7",
            "0ad177a32e4a89f7",
            "e897e633e355bf3f",
            "e897e633e355bf3f",
            "e897e633e355bf3f",
            "e897e633e355bf3f",
            "e897e633e355bf3f",
            "ef7878b7d9f7dd1e",
            "ef7878b7d9f7dd1e",
            "ef7878b7d9f7dd1e",
            "ef7878b7d9f7dd1e",
            "d0c38dd3fc97ca60",
            "d0c38dd3fc97ca60",
            "d0c38dd3fc97ca60",
            "5585bb546cb2d213",
            "5585bb546cb2d213",
            "7ab7c9678b3a4715",
            "7ab7c9678b3a4715",
            "b62bbc555f50f04a",
            "b62bbc555f50f04a",
            "b62bbc555f50f04a",
            "afa9c12b9e90b922",
            "afa9c12b9e90b922"
          ],
          "title": "Stateless Reset"
        },
        {
          "id": "section-10.3.1",
          "lines": [
            "   An endpoint detects a potential Stateless Reset using the trailing 16",
            "   bytes of the UDP datagram.  An endpoint remembers all stateless reset",
            "   tokens associated with the connection IDs and remote addresses for",
            "   datagrams it has recently sent.  This includes Stateless Reset Token",
            "   field values from NEW_CONNECTION_ID frames and the server's transport",
            "   parameters but excludes stateless reset tokens associated with",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   connection IDs that are either unused or retired.  "
              },
              {
                "annotation_ids": [
                  "78272bbc0b78862f",
                  "4467ef220f9463f3"
                ],
                "status_id": 3,
                "text": "The endpoint"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "78272bbc0b78862f",
                  "4467ef220f9463f3"
                ],
                "status_id": 3,
                "text": "identifies a received datagram as a Stateless Reset by comparing the"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "78272bbc0b78862f",
                  "4467ef220f9463f3"
                ],
                "status_id": 3,
                "text": "last 16 bytes of the datagram with all stateless reset tokens"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "78272bbc0b78862f",
                  "4467ef220f9463f3"
                ],
                "status_id": 3,
                "text": "associated with the remote address on which the datagram was"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "78272bbc0b78862f",
                  "4467ef220f9463f3"
                ],
                "status_id": 3,
                "text": "received."
              }
            ],
            "",
            "   This comparison can be performed for every inbound datagram.",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "e8e922821caf70bf",
                  "dbfe9cfc7a4aaa8a",
                  "d0e30ee6f9db55ef"
                ],
                "status_id": 21,
                "text": "Endpoints MAY skip this check if any packet from a datagram is"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "e8e922821caf70bf",
                  "dbfe9cfc7a4aaa8a",
                  "d0e30ee6f9db55ef"
                ],
                "status_id": 21,
                "text": "successfully processed."
              },
              {
                "annotation_ids": [
                  "e8e922821caf70bf",
                  "dbfe9cfc7a4aaa8a"
                ],
                "status_id": 1,
                "text": "  "
              },
              {
                "annotation_ids": [
                  "e8e922821caf70bf",
                  "dbfe9cfc7a4aaa8a",
                  "d2adcfa52fb2ee35"
                ],
                "status_id": 13,
                "text": "However, the comparison MUST be performed"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "e8e922821caf70bf",
                  "dbfe9cfc7a4aaa8a",
                  "d2adcfa52fb2ee35"
                ],
                "status_id": 13,
                "text": "when the first packet in an incoming datagram either cannot be"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "e8e922821caf70bf",
                  "dbfe9cfc7a4aaa8a",
                  "d2adcfa52fb2ee35"
                ],
                "status_id": 13,
                "text": "associated with a connection or cannot be decrypted."
              }
            ],
            "",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "aa5369403cd5ded2",
                  "248728abd3ae3fd7",
                  "a16fe2ddf32e7eaa",
                  "a4e61df46283768d"
                ],
                "status_id": 9,
                "text": "An endpoint MUST NOT check for any stateless reset tokens associated"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "aa5369403cd5ded2",
                  "248728abd3ae3fd7",
                  "a16fe2ddf32e7eaa",
                  "a4e61df46283768d"
                ],
                "status_id": 9,
                "text": "with connection IDs it has not used or for connection IDs that have"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "aa5369403cd5ded2",
                  "248728abd3ae3fd7",
                  "a16fe2ddf32e7eaa",
                  "a4e61df46283768d"
                ],
                "status_id": 9,
                "text": "been retired."
              }
            ],
            "",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "601925570238d5bf",
                  "5dd287c73cf67048",
                  "6b7dbb0ee15c9cf5",
                  "bc919b414dd7f3a2"
                ],
                "status_id": 9,
                "text": "When comparing a datagram to stateless reset token values, endpoints"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "601925570238d5bf",
                  "5dd287c73cf67048",
                  "6b7dbb0ee15c9cf5",
                  "bc919b414dd7f3a2"
                ],
                "status_id": 9,
                "text": "MUST perform the comparison without leaking information about the"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "601925570238d5bf",
                  "5dd287c73cf67048",
                  "6b7dbb0ee15c9cf5",
                  "bc919b414dd7f3a2"
                ],
                "status_id": 9,
                "text": "value of the token."
              },
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "  For example, performing this comparison in"
              }
            ],
            "   constant time protects the value of individual stateless reset tokens",
            "   from information leakage through timing side channels.  Another",
            "   approach would be to store and compare the transformed values of",
            "   stateless reset tokens instead of the raw token values, where the",
            "   transformation is defined as a cryptographically secure pseudorandom",
            "   function using a secret key (e.g., block cipher, Hashed Message",
            "   Authentication Code (HMAC) [RFC2104]).  An endpoint is not expected",
            "   to protect information about whether a packet was successfully",
            "   decrypted or the number of valid stateless reset tokens.",
            "",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "66c61b9778dcd6c2",
                  "4f51437d5e969329",
                  "4f192a1373346f03"
                ],
                "status_id": 13,
                "text": "If the last 16 bytes of the datagram are identical in value to a"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "66c61b9778dcd6c2",
                  "4f51437d5e969329",
                  "4f192a1373346f03"
                ],
                "status_id": 13,
                "text": "stateless reset token, the endpoint MUST enter the draining period"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "66c61b9778dcd6c2",
                  "4f51437d5e969329",
                  "4f192a1373346f03"
                ],
                "status_id": 13,
                "text": "and not send any further packets on this connection."
              }
            ]
          ],
          "requirements": [
            "d0e30ee6f9db55ef",
            "d0e30ee6f9db55ef",
            "d2adcfa52fb2ee35",
            "d2adcfa52fb2ee35",
            "d2adcfa52fb2ee35",
            "a4e61df46283768d",
            "a4e61df46283768d",
            "a4e61df46283768d",
            "bc919b414dd7f3a2",
            "bc919b414dd7f3a2",
            "bc919b414dd7f3a2",
            "4f192a1373346f03",
            "4f192a1373346f03",
            "4f192a1373346f03"
          ],
          "title": "Detecting a Stateless Reset"
        },
        {
          "id": "section-10.3.2",
          "lines": [
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "8df72261e76d15ae",
                  "1b1544dce205ff50"
                ],
                "status_id": 12,
                "text": "The stateless reset token MUST be difficult to guess."
              },
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "  In order to"
              }
            ],
            "   create a stateless reset token, an endpoint could randomly generate",
            "   [RANDOM] a secret for every connection that it creates.  However,",
            "   this presents a coordination problem when there are multiple",
            "   instances in a cluster or a storage problem for an endpoint that",
            "   might lose state.  Stateless reset specifically exists to handle the",
            "   case where state is lost, so this approach is suboptimal.",
            "",
            "   A single static key can be used across all connections to the same",
            "   endpoint by generating the proof using a pseudorandom function that",
            "   takes a static key and the connection ID chosen by the endpoint (see",
            "   Section 5.1) as input.  An endpoint could use HMAC [RFC2104] (for",
            "   example, HMAC(static_key, connection_id)) or the HMAC-based Key",
            "   Derivation Function (HKDF) [RFC5869] (for example, using the static",
            "   key as input keying material, with the connection ID as salt).  The",
            "   output of this function is truncated to 16 bytes to produce the",
            "   stateless reset token for that connection.",
            "",
            "   An endpoint that loses state can use the same method to generate a",
            "   valid stateless reset token.  The connection ID comes from the packet",
            "   that the endpoint receives.",
            "",
            "   This design relies on the peer always sending a connection ID in its",
            "   packets so that the endpoint can use the connection ID from a packet",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   to reset the connection.  "
              },
              {
                "annotation_ids": [
                  "13daecf3a6a0d583",
                  "6ef1bb4f3e6d2a63",
                  "71fb3b8b4f3f0976"
                ],
                "status_id": 9,
                "text": "An endpoint that uses this design MUST"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "13daecf3a6a0d583",
                  "6ef1bb4f3e6d2a63",
                  "71fb3b8b4f3f0976"
                ],
                "status_id": 9,
                "text": "either use the same connection ID length for all connections or"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "13daecf3a6a0d583",
                  "6ef1bb4f3e6d2a63",
                  "71fb3b8b4f3f0976"
                ],
                "status_id": 9,
                "text": "encode the length of the connection ID such that it can be recovered"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "13daecf3a6a0d583",
                  "6ef1bb4f3e6d2a63",
                  "71fb3b8b4f3f0976"
                ],
                "status_id": 9,
                "text": "without state."
              },
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "  In addition, it cannot provide a zero-length"
              }
            ],
            "   connection ID.",
            "",
            "   Revealing the stateless reset token allows any entity to terminate",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   the connection, so a value can only be used once.  "
              },
              {
                "annotation_ids": [
                  "a5b99874916cdb3b",
                  "5ae68823a27a9cb2"
                ],
                "status_id": 12,
                "text": "This method for"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "a5b99874916cdb3b",
                  "5ae68823a27a9cb2"
                ],
                "status_id": 12,
                "text": "choosing the stateless reset token means that the combination of"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "a5b99874916cdb3b",
                  "5ae68823a27a9cb2"
                ],
                "status_id": 12,
                "text": "connection ID and static key MUST NOT be used for another connection."
              }
            ],
            "   A denial-of-service attack is possible if the same connection ID is",
            "   used by instances that share a static key or if an attacker can cause",
            "   a packet to be routed to an instance that has no state but the same",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   static key; see Section 21.11.  "
              },
              {
                "annotation_ids": [
                  "5c8fcde14e74ba7e",
                  "40d93bee906c33a7"
                ],
                "status_id": 12,
                "text": "A connection ID from a connection"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "5c8fcde14e74ba7e",
                  "40d93bee906c33a7"
                ],
                "status_id": 12,
                "text": "that is reset by revealing the stateless reset token MUST NOT be"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "5c8fcde14e74ba7e",
                  "40d93bee906c33a7"
                ],
                "status_id": 12,
                "text": "reused for new connections at nodes that share a static key."
              }
            ],
            "",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "a252e9e4d82385de",
                  "9e77284acc696c60"
                ],
                "status_id": 12,
                "text": "The same stateless reset token MUST NOT be used for multiple"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "a252e9e4d82385de",
                  "9e77284acc696c60"
                ],
                "status_id": 12,
                "text": "connection IDs."
              },
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "  "
              },
              {
                "annotation_ids": [
                  "0107ef730f1782fd",
                  "2d3838d3153746b0",
                  "2295b7ab5640552a"
                ],
                "status_id": 11,
                "text": "Endpoints are not required to compare new values"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "0107ef730f1782fd",
                  "2d3838d3153746b0",
                  "2295b7ab5640552a"
                ],
                "status_id": 11,
                "text": "against all previous values, but a duplicate value MAY be treated as"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "0107ef730f1782fd",
                  "2d3838d3153746b0",
                  "2295b7ab5640552a"
                ],
                "status_id": 11,
                "text": "a connection error of type PROTOCOL_VIOLATION."
              }
            ],
            "",
            "   Note that Stateless Resets do not have any cryptographic protection."
          ],
          "requirements": [
            "1b1544dce205ff50",
            "71fb3b8b4f3f0976",
            "71fb3b8b4f3f0976",
            "71fb3b8b4f3f0976",
            "71fb3b8b4f3f0976",
            "5ae68823a27a9cb2",
            "5ae68823a27a9cb2",
            "5ae68823a27a9cb2",
            "40d93bee906c33a7",
            "40d93bee906c33a7",
            "40d93bee906c33a7",
            "9e77284acc696c60",
            "9e77284acc696c60",
            "2295b7ab5640552a",
            "2295b7ab5640552a",
            "2295b7ab5640552a"
          ],
          "title": "Calculating a Stateless Reset Token"
        },
        {
          "id": "section-10.3.3",
          "lines": [
            "   The design of a Stateless Reset is such that without knowing the",
            "   stateless reset token it is indistinguishable from a valid packet.",
            "   For instance, if a server sends a Stateless Reset to another server,",
            "   it might receive another Stateless Reset in response, which could",
            "   lead to an infinite exchange.",
            "",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "5001b9bc0e78bf57",
                  "eade741f92225356",
                  "0b802499a0d09048"
                ],
                "status_id": 9,
                "text": "An endpoint MUST ensure that every Stateless Reset that it sends is"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "5001b9bc0e78bf57",
                  "eade741f92225356",
                  "0b802499a0d09048"
                ],
                "status_id": 9,
                "text": "smaller than the packet that triggered it, unless it maintains state"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "5001b9bc0e78bf57",
                  "eade741f92225356",
                  "0b802499a0d09048"
                ],
                "status_id": 9,
                "text": "sufficient to prevent looping."
              },
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "  In the event of a loop, this results"
              }
            ],
            "   in packets eventually being too small to trigger a response.",
            "",
            "   An endpoint can remember the number of Stateless Resets that it has",
            "   sent and stop generating new Stateless Resets once a limit is",
            "   reached.  Using separate limits for different remote addresses will",
            "   ensure that Stateless Resets can be used to close connections when",
            "   other peers or connections have exhausted limits.",
            "",
            "   A Stateless Reset that is smaller than 41 bytes might be identifiable",
            "   as a Stateless Reset by an observer, depending upon the length of the",
            "   peer's connection IDs.  Conversely, not sending a Stateless Reset in",
            "   response to a small packet might result in Stateless Resets not being",
            "   useful in detecting cases of broken connections where only very small",
            "   packets are sent; such failures might only be detected by other",
            "   means, such as timers."
          ],
          "requirements": [
            "0b802499a0d09048",
            "0b802499a0d09048",
            "0b802499a0d09048"
          ],
          "title": "Looping"
        },
        {
          "id": "section-11",
          "lines": [
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "d443e28b6f43ba03"
                ],
                "status_id": 14,
                "text": "An endpoint that detects an error SHOULD signal the existence of that"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "d443e28b6f43ba03"
                ],
                "status_id": 14,
                "text": "error to its peer."
              },
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "  Both transport-level and application-level errors"
              }
            ],
            "   can affect an entire connection; see Section 11.1.  Only application-",
            "   level errors can be isolated to a single stream; see Section 11.2.",
            "",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "4e87d964447c43eb"
                ],
                "status_id": 14,
                "text": "The most appropriate error code (Section 20) SHOULD be included in"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "4e87d964447c43eb"
                ],
                "status_id": 14,
                "text": "the frame that signals the error."
              },
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "  Where this specification"
              }
            ],
            "   identifies error conditions, it also identifies the error code that",
            "   is used; though these are worded as requirements, different",
            "   implementation strategies might lead to different errors being",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   reported.  "
              },
              {
                "annotation_ids": [
                  "4851646b57ece490"
                ],
                "status_id": 19,
                "text": "In particular, an endpoint MAY use any applicable error"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "4851646b57ece490"
                ],
                "status_id": 19,
                "text": "code when it detects an error condition; a generic error code (such"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "4851646b57ece490"
                ],
                "status_id": 19,
                "text": "as PROTOCOL_VIOLATION or INTERNAL_ERROR) can always be used in place"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "4851646b57ece490"
                ],
                "status_id": 19,
                "text": "of specific error codes."
              }
            ],
            "",
            "   A stateless reset (Section 10.3) is not suitable for any error that",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   can be signaled with a CONNECTION_CLOSE or RESET_STREAM frame.  "
              },
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "A"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "47df2f0ddbb1541c"
                ],
                "status_id": 20,
                "text": "stateless reset MUST NOT be used by an endpoint that has the state"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "47df2f0ddbb1541c"
                ],
                "status_id": 20,
                "text": "necessary to send a frame on the connection."
              }
            ]
          ],
          "requirements": [
            "d443e28b6f43ba03",
            "d443e28b6f43ba03",
            "4e87d964447c43eb",
            "4e87d964447c43eb",
            "4851646b57ece490",
            "4851646b57ece490",
            "4851646b57ece490",
            "4851646b57ece490",
            "47df2f0ddbb1541c",
            "47df2f0ddbb1541c",
            "47df2f0ddbb1541c"
          ],
          "title": "Error Handling"
        },
        {
          "id": "section-11.1",
          "lines": [
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "a97212b8bde7b75a"
                ],
                "status_id": 20,
                "text": "Errors that result in the connection being unusable, such as an"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "a97212b8bde7b75a"
                ],
                "status_id": 20,
                "text": "obvious violation of protocol semantics or corruption of state that"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "a97212b8bde7b75a"
                ],
                "status_id": 20,
                "text": "affects an entire connection, MUST be signaled using a"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "a97212b8bde7b75a"
                ],
                "status_id": 20,
                "text": "CONNECTION_CLOSE frame (Section 19.19)."
              }
            ],
            "",
            "   Application-specific protocol errors are signaled using the",
            "   CONNECTION_CLOSE frame with a frame type of 0x1d.  Errors that are",
            "   specific to the transport, including all those described in this",
            "   document, are carried in the CONNECTION_CLOSE frame with a frame type",
            "   of 0x1c.",
            "",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   A CONNECTION_CLOSE frame could be sent in a packet that is lost.  "
              },
              {
                "annotation_ids": [
                  "5c2c98c926f30700"
                ],
                "status_id": 14,
                "text": "An"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "5c2c98c926f30700"
                ],
                "status_id": 14,
                "text": "endpoint SHOULD be prepared to retransmit a packet containing a"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "5c2c98c926f30700"
                ],
                "status_id": 14,
                "text": "CONNECTION_CLOSE frame if it receives more packets on a terminated"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "5c2c98c926f30700"
                ],
                "status_id": 14,
                "text": "connection."
              },
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "  Limiting the number of retransmissions and the time over"
              }
            ],
            "   which this final packet is sent limits the effort expended on",
            "   terminated connections.",
            "",
            "   An endpoint that chooses not to retransmit packets containing a",
            "   CONNECTION_CLOSE frame risks a peer missing the first such packet.",
            "   The only mechanism available to an endpoint that continues to receive",
            "   data for a terminated connection is to attempt the stateless reset",
            "   process (Section 10.3).",
            "",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "abc116b96cbf731e"
                ],
                "status_id": 19,
                "text": "As the AEAD for Initial packets does not provide strong"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "abc116b96cbf731e"
                ],
                "status_id": 19,
                "text": "authentication, an endpoint MAY discard an invalid Initial packet."
              }
            ],
            "   Discarding an Initial packet is permitted even where this",
            "   specification otherwise mandates a connection error.  An endpoint can",
            "   only discard a packet if it does not process the frames in the packet",
            "   or reverts the effects of any processing.  Discarding invalid Initial",
            "   packets might be used to reduce exposure to denial of service; see",
            "   Section 21.2."
          ],
          "requirements": [
            "a97212b8bde7b75a",
            "a97212b8bde7b75a",
            "a97212b8bde7b75a",
            "a97212b8bde7b75a",
            "5c2c98c926f30700",
            "5c2c98c926f30700",
            "5c2c98c926f30700",
            "5c2c98c926f30700",
            "abc116b96cbf731e",
            "abc116b96cbf731e"
          ],
          "title": "Connection Errors"
        },
        {
          "id": "section-11.2",
          "lines": [
            "   If an application-level error affects a single stream but otherwise",
            "   leaves the connection in a recoverable state, the endpoint can send a",
            "   RESET_STREAM frame (Section 19.4) with an appropriate error code to",
            "   terminate just the affected stream.",
            "",
            "   Resetting a stream without the involvement of the application",
            "   protocol could cause the application protocol to enter an",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   unrecoverable state.  "
              },
              {
                "annotation_ids": [
                  "0fd96d89d90290cb"
                ],
                "status_id": 20,
                "text": "RESET_STREAM MUST only be instigated by the"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "0fd96d89d90290cb"
                ],
                "status_id": 20,
                "text": "application protocol that uses QUIC."
              }
            ],
            "",
            "   The semantics of the application error code carried in RESET_STREAM",
            "   are defined by the application protocol.  Only the application",
            "   protocol is able to cause a stream to be terminated.  A local",
            "   instance of the application protocol uses a direct API call, and a",
            "   remote instance uses the STOP_SENDING frame, which triggers an",
            "   automatic RESET_STREAM.",
            "",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "cd19b17307068d73"
                ],
                "status_id": 14,
                "text": "Application protocols SHOULD define rules for handling streams that"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "cd19b17307068d73"
                ],
                "status_id": 14,
                "text": "are prematurely canceled by either endpoint."
              }
            ]
          ],
          "requirements": [
            "0fd96d89d90290cb",
            "0fd96d89d90290cb",
            "cd19b17307068d73",
            "cd19b17307068d73"
          ],
          "title": "Stream Errors"
        },
        {
          "id": "section-12",
          "lines": [
            "   QUIC endpoints communicate by exchanging packets.  Packets have",
            "   confidentiality and integrity protection; see Section 12.1.  Packets",
            "   are carried in UDP datagrams; see Section 12.2.",
            "",
            "   This version of QUIC uses the long packet header during connection",
            "   establishment; see Section 17.2.  Packets with the long header are",
            "   Initial (Section 17.2.2), 0-RTT (Section 17.2.3), Handshake",
            "   (Section 17.2.4), and Retry (Section 17.2.5).  Version negotiation",
            "   uses a version-independent packet with a long header; see",
            "   Section 17.2.1.",
            "",
            "   Packets with the short header are designed for minimal overhead and",
            "   are used after a connection is established and 1-RTT keys are",
            "   available; see Section 17.3."
          ],
          "title": "Packets and Frames"
        },
        {
          "id": "section-12.1",
          "lines": [
            "   QUIC packets have different levels of cryptographic protection based",
            "   on the type of packet.  Details of packet protection are found in",
            "   [QUIC-TLS]; this section includes an overview of the protections that",
            "   are provided.",
            "",
            "   Version Negotiation packets have no cryptographic protection; see",
            "   [QUIC-INVARIANTS].",
            "",
            "   Retry packets use an AEAD function [AEAD] to protect against",
            "   accidental modification.",
            "",
            "   Initial packets use an AEAD function, the keys for which are derived",
            "   using a value that is visible on the wire.  Initial packets therefore",
            "   do not have effective confidentiality protection.  Initial protection",
            "   exists to ensure that the sender of the packet is on the network",
            "   path.  Any entity that receives an Initial packet from a client can",
            "   recover the keys that will allow them to both read the contents of",
            "   the packet and generate Initial packets that will be successfully",
            "   authenticated at either endpoint.  The AEAD also protects Initial",
            "   packets against accidental modification.",
            "",
            "   All other packets are protected with keys derived from the",
            "   cryptographic handshake.  The cryptographic handshake ensures that",
            "   only the communicating endpoints receive the corresponding keys for",
            "   Handshake, 0-RTT, and 1-RTT packets.  Packets protected with 0-RTT",
            "   and 1-RTT keys have strong confidentiality and integrity protection.",
            "",
            "   The Packet Number field that appears in some packet types has",
            "   alternative confidentiality protection that is applied as part of",
            "   header protection; see Section 5.4 of [QUIC-TLS] for details.  The",
            "   underlying packet number increases with each packet sent in a given",
            "   packet number space; see Section 12.3 for details."
          ],
          "title": "Protected Packets"
        },
        {
          "id": "section-12.2",
          "lines": [
            "   Initial (Section 17.2.2), 0-RTT (Section 17.2.3), and Handshake",
            "   (Section 17.2.4) packets contain a Length field that determines the",
            "   end of the packet.  The length includes both the Packet Number and",
            "   Payload fields, both of which are confidentiality protected and",
            "   initially of unknown length.  The length of the Payload field is",
            "   learned once header protection is removed.",
            "",
            "   Using the Length field, a sender can coalesce multiple QUIC packets",
            "   into one UDP datagram.  This can reduce the number of UDP datagrams",
            "   needed to complete the cryptographic handshake and start sending",
            "   data.  This can also be used to construct Path Maximum Transmission",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   Unit (PMTU) probes; see Section 14.4.1.  "
              },
              {
                "annotation_ids": [
                  "096995d733046340"
                ],
                "status_id": 20,
                "text": "Receivers MUST be able to"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "096995d733046340"
                ],
                "status_id": 20,
                "text": "process coalesced packets."
              }
            ],
            "",
            "   Coalescing packets in order of increasing encryption levels (Initial,",
            "   0-RTT, Handshake, 1-RTT; see Section 4.1.4 of [QUIC-TLS]) makes it",
            "   more likely that the receiver will be able to process all the packets",
            "   in a single pass.  A packet with a short header does not include a",
            "   length, so it can only be the last packet included in a UDP datagram.",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "bdf8dbf5bd174d7f"
                ],
                "status_id": 14,
                "text": "An endpoint SHOULD include multiple frames in a single packet if they"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "bdf8dbf5bd174d7f"
                ],
                "status_id": 14,
                "text": "are to be sent at the same encryption level, instead of coalescing"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "bdf8dbf5bd174d7f"
                ],
                "status_id": 14,
                "text": "multiple packets at the same encryption level."
              }
            ],
            "",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "74d27e5d76a69ce4"
                ],
                "status_id": 19,
                "text": "Receivers MAY route based on the information in the first packet"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "74d27e5d76a69ce4"
                ],
                "status_id": 19,
                "text": "contained in a UDP datagram."
              },
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "  "
              },
              {
                "annotation_ids": [
                  "70382cc8764cdd2f",
                  "2ddaf28f87de81dc"
                ],
                "status_id": 13,
                "text": "Senders MUST NOT coalesce QUIC packets"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "70382cc8764cdd2f",
                  "2ddaf28f87de81dc"
                ],
                "status_id": 13,
                "text": "with different connection IDs into a single UDP datagram."
              },
              {
                "annotation_ids": [
                  "70382cc8764cdd2f"
                ],
                "status_id": 1,
                "text": "  "
              },
              {
                "annotation_ids": [
                  "70382cc8764cdd2f",
                  "a2b493ace874f9d7"
                ],
                "status_id": 22,
                "text": "Receivers"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "70382cc8764cdd2f",
                  "a2b493ace874f9d7"
                ],
                "status_id": 22,
                "text": "SHOULD ignore any subsequent packets with a different Destination"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "70382cc8764cdd2f",
                  "a2b493ace874f9d7"
                ],
                "status_id": 22,
                "text": "Connection ID than the first packet in the datagram."
              }
            ],
            "",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "94151aa34ed286a2"
                ],
                "status_id": 1,
                "text": "Every QUIC packet that is coalesced into a single UDP datagram is"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "94151aa34ed286a2"
                ],
                "status_id": 1,
                "text": "separate and complete.  "
              },
              {
                "annotation_ids": [
                  "94151aa34ed286a2",
                  "5497024bdee02670"
                ],
                "status_id": 13,
                "text": "The receiver of coalesced QUIC packets MUST"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "94151aa34ed286a2",
                  "5497024bdee02670"
                ],
                "status_id": 13,
                "text": "individually process each QUIC packet and separately acknowledge"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "94151aa34ed286a2",
                  "5497024bdee02670"
                ],
                "status_id": 13,
                "text": "them, as if they were received as the payload of different UDP"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "94151aa34ed286a2",
                  "5497024bdee02670"
                ],
                "status_id": 13,
                "text": "datagrams."
              },
              {
                "annotation_ids": [
                  "94151aa34ed286a2"
                ],
                "status_id": 1,
                "text": "  "
              },
              {
                "annotation_ids": [
                  "94151aa34ed286a2",
                  "b2f62b954c93758e"
                ],
                "status_id": 13,
                "text": "For example, if decryption fails (because the keys are"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "94151aa34ed286a2",
                  "b2f62b954c93758e"
                ],
                "status_id": 13,
                "text": "not available or for any other reason), the receiver MAY either"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "94151aa34ed286a2",
                  "b2f62b954c93758e"
                ],
                "status_id": 13,
                "text": "discard or buffer the packet for later processing and MUST attempt to"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "94151aa34ed286a2",
                  "b2f62b954c93758e"
                ],
                "status_id": 13,
                "text": "process the remaining packets."
              }
            ],
            "",
            "   Retry packets (Section 17.2.5), Version Negotiation packets",
            "   (Section 17.2.1), and packets with a short header (Section 17.3) do",
            "   not contain a Length field and so cannot be followed by other packets",
            "   in the same UDP datagram.  Note also that there is no situation where",
            "   a Retry or Version Negotiation packet is coalesced with another",
            "   packet."
          ],
          "requirements": [
            "096995d733046340",
            "096995d733046340",
            "bdf8dbf5bd174d7f",
            "bdf8dbf5bd174d7f",
            "bdf8dbf5bd174d7f",
            "74d27e5d76a69ce4",
            "74d27e5d76a69ce4",
            "2ddaf28f87de81dc",
            "2ddaf28f87de81dc",
            "a2b493ace874f9d7",
            "a2b493ace874f9d7",
            "a2b493ace874f9d7",
            "5497024bdee02670",
            "5497024bdee02670",
            "5497024bdee02670",
            "5497024bdee02670",
            "b2f62b954c93758e",
            "b2f62b954c93758e",
            "b2f62b954c93758e",
            "b2f62b954c93758e"
          ],
          "title": "Coalescing Packets"
        },
        {
          "id": "section-12.3",
          "lines": [
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "c2f5a513618525e3"
                ],
                "status_id": 1,
                "text": "The packet number is an integer in the range 0 to 2^62-1.  This"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "c2f5a513618525e3"
                ],
                "status_id": 1,
                "text": "number is used in determining the cryptographic nonce for packet"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "c2f5a513618525e3"
                ],
                "status_id": 1,
                "text": "protection.  Each endpoint maintains a separate packet number for"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "c2f5a513618525e3"
                ],
                "status_id": 1,
                "text": "sending and receiving."
              }
            ],
            "",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "8cd0b29dedbdf4ef"
                ],
                "status_id": 1,
                "text": "Packet numbers are limited to this range because they need to be"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "8cd0b29dedbdf4ef"
                ],
                "status_id": 1,
                "text": "representable in whole in the Largest Acknowledged field of an ACK"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "8cd0b29dedbdf4ef"
                ],
                "status_id": 1,
                "text": "frame (Section 19.3).  When present in a long or short header,"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "8cd0b29dedbdf4ef"
                ],
                "status_id": 1,
                "text": "however, packet numbers are reduced and encoded in 1 to 4 bytes; see"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "8cd0b29dedbdf4ef"
                ],
                "status_id": 1,
                "text": "Section 17.1."
              }
            ],
            "",
            "   Version Negotiation (Section 17.2.1) and Retry (Section 17.2.5)",
            "   packets do not include a packet number.",
            "",
            "   Packet numbers are divided into three spaces in QUIC:",
            "",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "56e65a30bc3c6b38"
                ],
                "status_id": 1,
                "text": "Initial space:  All Initial packets (Section 17.2.2) are in this"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "      "
              },
              {
                "annotation_ids": [
                  "56e65a30bc3c6b38"
                ],
                "status_id": 1,
                "text": "space."
              }
            ],
            "",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "56e65a30bc3c6b38"
                ],
                "status_id": 1,
                "text": "Handshake space:  All Handshake packets (Section 17.2.4) are in this"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "      "
              },
              {
                "annotation_ids": [
                  "56e65a30bc3c6b38"
                ],
                "status_id": 1,
                "text": "space."
              }
            ],
            "",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "56e65a30bc3c6b38"
                ],
                "status_id": 1,
                "text": "Application data space:  All 0-RTT (Section 17.2.3) and 1-RTT"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "      "
              },
              {
                "annotation_ids": [
                  "56e65a30bc3c6b38"
                ],
                "status_id": 1,
                "text": "(Section 17.3.1) packets are in this space."
              }
            ],
            "",
            "   As described in [QUIC-TLS], each packet type uses different",
            "   protection keys.",
            "",
            "   Conceptually, a packet number space is the context in which a packet",
            "   can be processed and acknowledged.  Initial packets can only be sent",
            "   with Initial packet protection keys and acknowledged in packets that",
            "   are also Initial packets.  Similarly, Handshake packets are sent at",
            "   the Handshake encryption level and can only be acknowledged in",
            "   Handshake packets.",
            "",
            "   This enforces cryptographic separation between the data sent in the",
            "   different packet number spaces.  Packet numbers in each space start",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   at packet number 0.  "
              },
              {
                "annotation_ids": [
                  "2ab17ec3d5552d8f"
                ],
                "status_id": 20,
                "text": "Subsequent packets sent in the same packet"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "2ab17ec3d5552d8f"
                ],
                "status_id": 20,
                "text": "number space MUST increase the packet number by at least one."
              }
            ],
            "",
            "   0-RTT and 1-RTT data exist in the same packet number space to make",
            "   loss recovery algorithms easier to implement between the two packet",
            "   types.",
            "",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "7879c41e9d96a1be",
                  "ae02d5e1facba69b"
                ],
                "status_id": 13,
                "text": "A QUIC endpoint MUST NOT reuse a packet number within the same packet"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "7879c41e9d96a1be",
                  "ae02d5e1facba69b"
                ],
                "status_id": 13,
                "text": "number space in one connection."
              },
              {
                "annotation_ids": [
                  "7879c41e9d96a1be"
                ],
                "status_id": 1,
                "text": "  "
              },
              {
                "annotation_ids": [
                  "7879c41e9d96a1be",
                  "de7948abd33ab26e"
                ],
                "status_id": 13,
                "text": "If the packet number for sending"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "7879c41e9d96a1be",
                  "de7948abd33ab26e"
                ],
                "status_id": 13,
                "text": "reaches 2^62-1, the sender MUST close the connection without sending"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "7879c41e9d96a1be",
                  "de7948abd33ab26e"
                ],
                "status_id": 13,
                "text": "a CONNECTION_CLOSE frame or any further packets; an endpoint MAY send"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "7879c41e9d96a1be",
                  "de7948abd33ab26e"
                ],
                "status_id": 13,
                "text": "a Stateless Reset (Section 10.3) in response to further packets that"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "7879c41e9d96a1be",
                  "de7948abd33ab26e"
                ],
                "status_id": 13,
                "text": "it receives."
              }
            ],
            "",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "2299fefbe8438be1"
                ],
                "status_id": 20,
                "text": "A receiver MUST discard a newly unprotected packet unless it is"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "2299fefbe8438be1"
                ],
                "status_id": 20,
                "text": "certain that it has not processed another packet with the same packet"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "2299fefbe8438be1"
                ],
                "status_id": 20,
                "text": "number from the same packet number space."
              },
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "  "
              },
              {
                "annotation_ids": [
                  "05a3fbf24fae034d"
                ],
                "status_id": 20,
                "text": "Duplicate suppression MUST"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "05a3fbf24fae034d"
                ],
                "status_id": 20,
                "text": "happen after removing packet protection for the reasons described in"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "05a3fbf24fae034d"
                ],
                "status_id": 20,
                "text": "Section 9.5 of [QUIC-TLS]."
              }
            ],
            "",
            "   Endpoints that track all individual packets for the purposes of",
            "   detecting duplicates are at risk of accumulating excessive state.",
            "   The data required for detecting duplicates can be limited by",
            "   maintaining a minimum packet number below which all packets are",
            "   immediately dropped.  Any minimum needs to account for large",
            "   variations in round-trip time, which includes the possibility that a",
            "   peer might probe network paths with much larger round-trip times; see",
            "   Section 9.",
            "",
            "   Packet number encoding at a sender and decoding at a receiver are",
            "   described in Section 17.1."
          ],
          "requirements": [
            "2ab17ec3d5552d8f",
            "2ab17ec3d5552d8f",
            "ae02d5e1facba69b",
            "ae02d5e1facba69b",
            "de7948abd33ab26e",
            "de7948abd33ab26e",
            "de7948abd33ab26e",
            "de7948abd33ab26e",
            "de7948abd33ab26e",
            "2299fefbe8438be1",
            "2299fefbe8438be1",
            "2299fefbe8438be1",
            "05a3fbf24fae034d",
            "05a3fbf24fae034d",
            "05a3fbf24fae034d"
          ],
          "title": "Packet Numbers"
        },
        {
          "id": "section-12.4",
          "lines": [
            "   The payload of QUIC packets, after removing packet protection,",
            "   consists of a sequence of complete frames, as shown in Figure 11.",
            "   Version Negotiation, Stateless Reset, and Retry packets do not",
            "   contain frames.",
            "",
            "   Packet Payload {",
            "     Frame (8..) ...,",
            "   }",
            "",
            "                          Figure 11: QUIC Payload",
            "",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "4ba0e824087040bf",
                  "3fea2267a4ed4acc"
                ],
                "status_id": 13,
                "text": "The payload of a packet that contains frames MUST contain at least"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "4ba0e824087040bf",
                  "3fea2267a4ed4acc"
                ],
                "status_id": 13,
                "text": "one frame, and MAY contain multiple frames and multiple frame types."
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "4ba0e824087040bf",
                  "8bf875fa01f65359"
                ],
                "status_id": 13,
                "text": "An endpoint MUST treat receipt of a packet containing no frames as a"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "4ba0e824087040bf",
                  "8bf875fa01f65359"
                ],
                "status_id": 13,
                "text": "connection error of type PROTOCOL_VIOLATION."
              },
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "  Frames always fit"
              }
            ],
            "   within a single QUIC packet and cannot span multiple packets.",
            "",
            "   Each frame begins with a Frame Type, indicating its type, followed by",
            "   additional type-dependent fields:",
            "",
            "   Frame {",
            "     Frame Type (i),",
            "     Type-Dependent Fields (..),",
            "   }",
            "",
            "                      Figure 12: Generic Frame Layout",
            "",
            "   Table 3 lists and summarizes information about each frame type that",
            "   is defined in this specification.  A description of this summary is",
            "   included after the table.",
            "",
            "    +============+======================+===============+======+======+",
            "    | Type Value | Frame Type Name      | Definition    | Pkts | Spec |",
            "    +============+======================+===============+======+======+",
            "    | 0x00       | PADDING              | Section 19.1  | IH01 | NP   |",
            "    +------------+----------------------+---------------+------+------+",
            "    | 0x01       | PING                 | Section 19.2  | IH01 |      |",
            "    +------------+----------------------+---------------+------+------+",
            "    | 0x02-0x03  | ACK                  | Section 19.3  | IH_1 | NC   |",
            "    +------------+----------------------+---------------+------+------+",
            "    | 0x04       | RESET_STREAM         | Section 19.4  | __01 |      |",
            "    +------------+----------------------+---------------+------+------+",
            "    | 0x05       | STOP_SENDING         | Section 19.5  | __01 |      |",
            "    +------------+----------------------+---------------+------+------+",
            "    | 0x06       | CRYPTO               | Section 19.6  | IH_1 |      |",
            "    +------------+----------------------+---------------+------+------+",
            "    | 0x07       | NEW_TOKEN            | Section 19.7  | ___1 |      |",
            "    +------------+----------------------+---------------+------+------+",
            "    | 0x08-0x0f  | STREAM               | Section 19.8  | __01 | F    |",
            "    +------------+----------------------+---------------+------+------+",
            "    | 0x10       | MAX_DATA             | Section 19.9  | __01 |      |",
            "    +------------+----------------------+---------------+------+------+",
            "    | 0x11       | MAX_STREAM_DATA      | Section 19.10 | __01 |      |",
            "    +------------+----------------------+---------------+------+------+",
            "    | 0x12-0x13  | MAX_STREAMS          | Section 19.11 | __01 |      |",
            "    +------------+----------------------+---------------+------+------+",
            "    | 0x14       | DATA_BLOCKED         | Section 19.12 | __01 |      |",
            "    +------------+----------------------+---------------+------+------+",
            "    | 0x15       | STREAM_DATA_BLOCKED  | Section 19.13 | __01 |      |",
            "    +------------+----------------------+---------------+------+------+",
            "    | 0x16-0x17  | STREAMS_BLOCKED      | Section 19.14 | __01 |      |",
            "    +------------+----------------------+---------------+------+------+",
            "    | 0x18       | NEW_CONNECTION_ID    | Section 19.15 | __01 | P    |",
            "    +------------+----------------------+---------------+------+------+",
            "    | 0x19       | RETIRE_CONNECTION_ID | Section 19.16 | __01 |      |",
            "    +------------+----------------------+---------------+------+------+",
            "    | 0x1a       | PATH_CHALLENGE       | Section 19.17 | __01 | P    |",
            "    +------------+----------------------+---------------+------+------+",
            "    | 0x1b       | PATH_RESPONSE        | Section 19.18 | ___1 | P    |",
            "    +------------+----------------------+---------------+------+------+",
            "    | 0x1c-0x1d  | CONNECTION_CLOSE     | Section 19.19 | ih01 | N    |",
            "    +------------+----------------------+---------------+------+------+",
            "    | 0x1e       | HANDSHAKE_DONE       | Section 19.20 | ___1 |      |",
            "    +------------+----------------------+---------------+------+------+",
            "",
            "                            Table 3: Frame Types",
            "",
            "   The format and semantics of each frame type are explained in more",
            "   detail in Section 19.  The remainder of this section provides a",
            "   summary of important and general information.",
            "",
            "   The Frame Type in ACK, STREAM, MAX_STREAMS, STREAMS_BLOCKED, and",
            "   CONNECTION_CLOSE frames is used to carry other frame-specific flags.",
            "   For all other frames, the Frame Type field simply identifies the",
            "   frame.",
            "",
            "   The \"Pkts\" column in Table 3 lists the types of packets that each",
            "   frame type could appear in, indicated by the following characters:",
            "",
            "   I:   Initial (Section 17.2.2)",
            "",
            "   H:   Handshake (Section 17.2.4)",
            "",
            "   0:   0-RTT (Section 17.2.3)",
            "",
            "   1:   1-RTT (Section 17.3.1)",
            "",
            "   ih:  Only a CONNECTION_CLOSE frame of type 0x1c can appear in Initial",
            "        or Handshake packets.",
            "",
            "   For more details about these restrictions, see Section 12.5.  Note",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   that all frames can appear in 1-RTT packets.  "
              },
              {
                "annotation_ids": [
                  "c31deb3361ccc09d"
                ],
                "status_id": 20,
                "text": "An endpoint MUST treat"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "c31deb3361ccc09d"
                ],
                "status_id": 20,
                "text": "receipt of a frame in a packet type that is not permitted as a"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "c31deb3361ccc09d"
                ],
                "status_id": 20,
                "text": "connection error of type PROTOCOL_VIOLATION."
              }
            ],
            "",
            "   The \"Spec\" column in Table 3 summarizes any special rules governing",
            "   the processing or generation of the frame type, as indicated by the",
            "   following characters:",
            "",
            "   N:   Packets containing only frames with this marking are not ack-",
            "        eliciting; see Section 13.2.",
            "",
            "   C:   Packets containing only frames with this marking do not count",
            "        toward bytes in flight for congestion control purposes; see",
            "        [QUIC-RECOVERY].",
            "",
            "   P:   Packets containing only frames with this marking can be used to",
            "        probe new network paths during connection migration; see",
            "        Section 9.1.",
            "",
            "   F:   The contents of frames with this marking are flow controlled;",
            "        see Section 4.",
            "",
            "   The \"Pkts\" and \"Spec\" columns in Table 3 do not form part of the IANA",
            "   registry; see Section 22.4.",
            "",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "7fa35a10de132b74"
                ],
                "status_id": 20,
                "text": "An endpoint MUST treat the receipt of a frame of unknown type as a"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "7fa35a10de132b74"
                ],
                "status_id": 20,
                "text": "connection error of type FRAME_ENCODING_ERROR."
              }
            ],
            "",
            "   All frames are idempotent in this version of QUIC.  That is, a valid",
            "   frame does not cause undesirable side effects or errors when received",
            "   more than once.",
            "",
            "   The Frame Type field uses a variable-length integer encoding (see",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   Section 16), with one exception.  "
              },
              {
                "annotation_ids": [
                  "1587d38fd5f2a692"
                ],
                "status_id": 20,
                "text": "To ensure simple and efficient"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "1587d38fd5f2a692"
                ],
                "status_id": 20,
                "text": "implementations of frame parsing, a frame type MUST use the shortest"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "1587d38fd5f2a692"
                ],
                "status_id": 20,
                "text": "possible encoding."
              },
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "  For frame types defined in this document, this"
              }
            ],
            "   means a single-byte encoding, even though it is possible to encode",
            "   these values as a two-, four-, or eight-byte variable-length integer.",
            "   For instance, though 0x4001 is a legitimate two-byte encoding for a",
            "   variable-length integer with a value of 1, PING frames are always",
            "   encoded as a single byte with the value 0x01.  This rule applies to",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   all current and future QUIC frame types.  "
              },
              {
                "annotation_ids": [
                  "77a062f7e8eddafa"
                ],
                "status_id": 19,
                "text": "An endpoint MAY treat the"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "77a062f7e8eddafa"
                ],
                "status_id": 19,
                "text": "receipt of a frame type that uses a longer encoding than necessary as"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "77a062f7e8eddafa"
                ],
                "status_id": 19,
                "text": "a connection error of type PROTOCOL_VIOLATION."
              }
            ]
          ],
          "requirements": [
            "3fea2267a4ed4acc",
            "3fea2267a4ed4acc",
            "8bf875fa01f65359",
            "8bf875fa01f65359",
            "c31deb3361ccc09d",
            "c31deb3361ccc09d",
            "c31deb3361ccc09d",
            "7fa35a10de132b74",
            "7fa35a10de132b74",
            "1587d38fd5f2a692",
            "1587d38fd5f2a692",
            "1587d38fd5f2a692",
            "77a062f7e8eddafa",
            "77a062f7e8eddafa",
            "77a062f7e8eddafa"
          ],
          "title": "Frames and Frame Types"
        },
        {
          "id": "section-12.5",
          "lines": [
            "   Some frames are prohibited in different packet number spaces.  The",
            "   rules here generalize those of TLS, in that frames associated with",
            "   establishing the connection can usually appear in packets in any",
            "   packet number space, whereas those associated with transferring data",
            "   can only appear in the application data packet number space:",
            "",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "96e6cfb24e89a5cb"
                ],
                "status_id": 19,
                "text": "*  PADDING, PING, and CRYPTO frames MAY appear in any packet number"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "      "
              },
              {
                "annotation_ids": [
                  "96e6cfb24e89a5cb"
                ],
                "status_id": 19,
                "text": "space."
              }
            ],
            "",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "d13adf1d8ad9d3f0"
                ],
                "status_id": 19,
                "text": "*  CONNECTION_CLOSE frames signaling errors at the QUIC layer (type"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "      "
              },
              {
                "annotation_ids": [
                  "d13adf1d8ad9d3f0"
                ],
                "status_id": 19,
                "text": "0x1c) MAY appear in any packet number space."
              },
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "  "
              },
              {
                "annotation_ids": [
                  "aecc66925f70e3a6"
                ],
                "status_id": 20,
                "text": "CONNECTION_CLOSE"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "      "
              },
              {
                "annotation_ids": [
                  "aecc66925f70e3a6"
                ],
                "status_id": 20,
                "text": "frames signaling application errors (type 0x1d) MUST only appear"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "      "
              },
              {
                "annotation_ids": [
                  "aecc66925f70e3a6"
                ],
                "status_id": 20,
                "text": "in the application data packet number space."
              }
            ],
            "",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "4a4e246d4f4a04eb"
                ],
                "status_id": 19,
                "text": "*  ACK frames MAY appear in any packet number space but can only"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "      "
              },
              {
                "annotation_ids": [
                  "4a4e246d4f4a04eb"
                ],
                "status_id": 19,
                "text": "acknowledge packets that appeared in that packet number space."
              }
            ],
            "      However, as noted below, 0-RTT packets cannot contain ACK frames.",
            "",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "e4361354d7929b13"
                ],
                "status_id": 20,
                "text": "*  All other frame types MUST only be sent in the application data"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "      "
              },
              {
                "annotation_ids": [
                  "e4361354d7929b13"
                ],
                "status_id": 20,
                "text": "packet number space."
              }
            ],
            "",
            "   Note that it is not possible to send the following frames in 0-RTT",
            "   packets for various reasons: ACK, CRYPTO, HANDSHAKE_DONE, NEW_TOKEN,",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   PATH_RESPONSE, and RETIRE_CONNECTION_ID.  "
              },
              {
                "annotation_ids": [
                  "c997b4b4e691e176"
                ],
                "status_id": 19,
                "text": "A server MAY treat receipt"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "c997b4b4e691e176"
                ],
                "status_id": 19,
                "text": "of these frames in 0-RTT packets as a connection error of type"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "c997b4b4e691e176"
                ],
                "status_id": 19,
                "text": "PROTOCOL_VIOLATION."
              }
            ]
          ],
          "requirements": [
            "96e6cfb24e89a5cb",
            "96e6cfb24e89a5cb",
            "d13adf1d8ad9d3f0",
            "d13adf1d8ad9d3f0",
            "aecc66925f70e3a6",
            "aecc66925f70e3a6",
            "aecc66925f70e3a6",
            "4a4e246d4f4a04eb",
            "4a4e246d4f4a04eb",
            "e4361354d7929b13",
            "e4361354d7929b13",
            "c997b4b4e691e176",
            "c997b4b4e691e176",
            "c997b4b4e691e176"
          ],
          "title": "Frames and Number Spaces"
        },
        {
          "id": "section-13",
          "lines": [
            "   A sender sends one or more frames in a QUIC packet; see Section 12.4.",
            "",
            "   A sender can minimize per-packet bandwidth and computational costs by",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   including as many frames as possible in each QUIC packet.  "
              },
              {
                "annotation_ids": [
                  "48397a861d02ef05"
                ],
                "status_id": 19,
                "text": "A sender"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "48397a861d02ef05"
                ],
                "status_id": 19,
                "text": "MAY wait for a short period of time to collect multiple frames before"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "48397a861d02ef05"
                ],
                "status_id": 19,
                "text": "sending a packet that is not maximally packed, to avoid sending out"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "48397a861d02ef05"
                ],
                "status_id": 19,
                "text": "large numbers of small packets."
              },
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "  "
              },
              {
                "annotation_ids": [
                  "c0bce6195ef87f33"
                ],
                "status_id": 19,
                "text": "An implementation MAY use knowledge"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "c0bce6195ef87f33"
                ],
                "status_id": 19,
                "text": "about application sending behavior or heuristics to determine whether"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "c0bce6195ef87f33"
                ],
                "status_id": 19,
                "text": "and for how long to wait."
              },
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "  This waiting period is an implementation"
              }
            ],
            "   decision, and an implementation should be careful to delay",
            "   conservatively, since any delay is likely to increase application-",
            "   visible latency.",
            "",
            "   Stream multiplexing is achieved by interleaving STREAM frames from",
            "   multiple streams into one or more QUIC packets.  A single QUIC packet",
            "   can include multiple STREAM frames from one or more streams.",
            "",
            "   One of the benefits of QUIC is avoidance of head-of-line blocking",
            "   across multiple streams.  When a packet loss occurs, only streams",
            "   with data in that packet are blocked waiting for a retransmission to",
            "   be received, while other streams can continue making progress.  Note",
            "   that when data from multiple streams is included in a single QUIC",
            "   packet, loss of that packet blocks all those streams from making",
            "   progress.  Implementations are advised to include as few streams as",
            "   necessary in outgoing packets without losing transmission efficiency",
            "   to underfilled packets."
          ],
          "requirements": [
            "48397a861d02ef05",
            "48397a861d02ef05",
            "48397a861d02ef05",
            "48397a861d02ef05",
            "c0bce6195ef87f33",
            "c0bce6195ef87f33",
            "c0bce6195ef87f33"
          ],
          "title": "Packetization and Reliability"
        },
        {
          "id": "section-13.1",
          "lines": [
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "fbc0ebf9a740c98b",
                  "3aeadc07c91094af"
                ],
                "status_id": 13,
                "text": "A packet MUST NOT be acknowledged until packet protection has been"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "fbc0ebf9a740c98b",
                  "3aeadc07c91094af"
                ],
                "status_id": 13,
                "text": "successfully removed and all frames contained in the packet have been"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "fbc0ebf9a740c98b",
                  "3aeadc07c91094af"
                ],
                "status_id": 13,
                "text": "processed."
              },
              {
                "annotation_ids": [
                  "fbc0ebf9a740c98b"
                ],
                "status_id": 1,
                "text": "  For STREAM frames, this means the data has been enqueued"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "fbc0ebf9a740c98b"
                ],
                "status_id": 1,
                "text": "in preparation to be received by the application protocol, but it"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "fbc0ebf9a740c98b"
                ],
                "status_id": 1,
                "text": "does not require that data be delivered and consumed."
              }
            ],
            "",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "fbc0ebf9a740c98b"
                ],
                "status_id": 1,
                "text": "Once the packet has been fully processed, a receiver acknowledges"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "fbc0ebf9a740c98b"
                ],
                "status_id": 1,
                "text": "receipt by sending one or more ACK frames containing the packet"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "fbc0ebf9a740c98b"
                ],
                "status_id": 1,
                "text": "number of the received packet."
              }
            ],
            "",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "695c4b8157e4ff92",
                  "6a86f74e109e20e7"
                ],
                "status_id": 22,
                "text": "An endpoint SHOULD treat receipt of an acknowledgment for a packet it"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "695c4b8157e4ff92",
                  "6a86f74e109e20e7"
                ],
                "status_id": 22,
                "text": "did not send as a connection error of type PROTOCOL_VIOLATION, if it"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "695c4b8157e4ff92",
                  "6a86f74e109e20e7"
                ],
                "status_id": 22,
                "text": "is able to detect the condition."
              },
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "  For further discussion of how this"
              }
            ],
            "   might be achieved, see Section 21.4."
          ],
          "requirements": [
            "3aeadc07c91094af",
            "3aeadc07c91094af",
            "3aeadc07c91094af",
            "6a86f74e109e20e7",
            "6a86f74e109e20e7",
            "6a86f74e109e20e7"
          ],
          "title": "Packet Processing"
        },
        {
          "id": "section-13.2",
          "lines": [
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "292abe3e1573764c",
                  "0ff2403b0a37f417"
                ],
                "status_id": 1,
                "text": "Endpoints acknowledge all packets they receive and process.  However,"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "292abe3e1573764c",
                  "0ff2403b0a37f417"
                ],
                "status_id": 1,
                "text": "only ack-eliciting packets cause an ACK frame to be sent within the"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "292abe3e1573764c",
                  "0ff2403b0a37f417"
                ],
                "status_id": 1,
                "text": "maximum ack delay.  Packets that are not ack-eliciting are only"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "292abe3e1573764c",
                  "0ff2403b0a37f417"
                ],
                "status_id": 1,
                "text": "acknowledged when an ACK frame is sent for other reasons."
              }
            ],
            "",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "292abe3e1573764c",
                  "e340f9bc61c4f8d8"
                ],
                "status_id": 22,
                "text": "When sending a packet for any reason, an endpoint SHOULD attempt to"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "292abe3e1573764c",
                  "e340f9bc61c4f8d8"
                ],
                "status_id": 22,
                "text": "include an ACK frame if one has not been sent recently."
              },
              {
                "annotation_ids": [
                  "292abe3e1573764c"
                ],
                "status_id": 1,
                "text": "  Doing so"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "292abe3e1573764c"
                ],
                "status_id": 1,
                "text": "helps with timely loss detection at the peer."
              }
            ],
            "",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "292abe3e1573764c",
                  "ffad9e080e9fe78f"
                ],
                "status_id": 1,
                "text": "In general, frequent feedback from a receiver improves loss and"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "292abe3e1573764c",
                  "ffad9e080e9fe78f"
                ],
                "status_id": 1,
                "text": "congestion response, but this has to be balanced against excessive"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "292abe3e1573764c",
                  "ffad9e080e9fe78f"
                ],
                "status_id": 1,
                "text": "load generated by a receiver that sends an ACK frame in response to"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "292abe3e1573764c",
                  "ffad9e080e9fe78f"
                ],
                "status_id": 1,
                "text": "every ack-eliciting packet."
              },
              {
                "annotation_ids": [
                  "292abe3e1573764c"
                ],
                "status_id": 1,
                "text": "  The guidance offered below seeks to"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "292abe3e1573764c"
                ],
                "status_id": 1,
                "text": "strike this balance."
              }
            ]
          ],
          "requirements": [
            "e340f9bc61c4f8d8",
            "e340f9bc61c4f8d8"
          ],
          "title": "Generating Acknowledgments"
        },
        {
          "id": "section-13.2.1",
          "lines": [
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "624bf1d4ec9659de"
                ],
                "status_id": 20,
                "text": "Every packet SHOULD be acknowledged at least once, and ack-eliciting"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "624bf1d4ec9659de"
                ],
                "status_id": 20,
                "text": "packets MUST be acknowledged at least once within the maximum delay"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "624bf1d4ec9659de"
                ],
                "status_id": 20,
                "text": "an endpoint communicated using the max_ack_delay transport parameter;"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "624bf1d4ec9659de"
                ],
                "status_id": 20,
                "text": "see Section 18.2."
              },
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "  max_ack_delay declares an explicit contract: an"
              }
            ],
            "   endpoint promises to never intentionally delay acknowledgments of an",
            "   ack-eliciting packet by more than the indicated value.  If it does,",
            "   any excess accrues to the RTT estimate and could result in spurious",
            "   or delayed retransmissions from the peer.  A sender uses the",
            "   receiver's max_ack_delay value in determining timeouts for timer-",
            "   based retransmission, as detailed in Section 6.2 of [QUIC-RECOVERY].",
            "",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "c5aefea42a68e0c7",
                  "7510ff8cb2a15d34"
                ],
                "status_id": 13,
                "text": "An endpoint MUST acknowledge all ack-eliciting Initial and Handshake"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "c5aefea42a68e0c7",
                  "7510ff8cb2a15d34"
                ],
                "status_id": 13,
                "text": "packets immediately"
              },
              {
                "annotation_ids": [
                  "7510ff8cb2a15d34"
                ],
                "status_id": 20,
                "text": " and all ack-eliciting 0-RTT and 1-RTT packets"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "7510ff8cb2a15d34"
                ],
                "status_id": 20,
                "text": "within its advertised max_ack_delay, with the following exception."
              }
            ],
            "   Prior to handshake confirmation, an endpoint might not have packet",
            "   protection keys for decrypting Handshake, 0-RTT, or 1-RTT packets",
            "   when they are received.  It might therefore buffer them and",
            "   acknowledge them when the requisite keys become available.",
            "",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "a49840b2bcb6a47c"
                ],
                "status_id": 20,
                "text": "Since packets containing only ACK frames are not congestion"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "a49840b2bcb6a47c"
                ],
                "status_id": 20,
                "text": "controlled, an endpoint MUST NOT send more than one such packet in"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "a49840b2bcb6a47c"
                ],
                "status_id": 20,
                "text": "response to receiving an ack-eliciting packet."
              }
            ],
            "",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "8e51930e72aef839"
                ],
                "status_id": 20,
                "text": "An endpoint MUST NOT send a non-ack-eliciting packet in response to a"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "8e51930e72aef839"
                ],
                "status_id": 20,
                "text": "non-ack-eliciting packet, even if there are packet gaps that precede"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "8e51930e72aef839"
                ],
                "status_id": 20,
                "text": "the received packet."
              },
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "  This avoids an infinite feedback loop of"
              }
            ],
            "   acknowledgments, which could prevent the connection from ever",
            "   becoming idle.  Non-ack-eliciting packets are eventually acknowledged",
            "   when the endpoint sends an ACK frame in response to other events.",
            "",
            "   An endpoint that is only sending ACK frames will not receive",
            "   acknowledgments from its peer unless those acknowledgments are",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   included in packets with ack-eliciting frames.  "
              },
              {
                "annotation_ids": [
                  "a0b28d7fd0268253"
                ],
                "status_id": 14,
                "text": "An endpoint SHOULD"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "a0b28d7fd0268253"
                ],
                "status_id": 14,
                "text": "send an ACK frame with other frames when there are new ack-eliciting"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "a0b28d7fd0268253"
                ],
                "status_id": 14,
                "text": "packets to acknowledge."
              },
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "  "
              },
              {
                "annotation_ids": [
                  "7b5ff51fc5772ac6"
                ],
                "status_id": 19,
                "text": "When only non-ack-eliciting packets need to"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "7b5ff51fc5772ac6"
                ],
                "status_id": 19,
                "text": "be acknowledged, an endpoint MAY choose not to send an ACK frame with"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "7b5ff51fc5772ac6"
                ],
                "status_id": 19,
                "text": "outgoing frames until an ack-eliciting packet has been received."
              }
            ],
            "",
            "   An endpoint that is only sending non-ack-eliciting packets might",
            "   choose to occasionally add an ack-eliciting frame to those packets to",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   ensure that it receives an acknowledgment; see Section 13.2.4.  "
              },
              {
                "annotation_ids": [
                  "d805d94f04eedb05"
                ],
                "status_id": 20,
                "text": "In"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "d805d94f04eedb05"
                ],
                "status_id": 20,
                "text": "that case, an endpoint MUST NOT send an ack-eliciting frame in all"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "d805d94f04eedb05"
                ],
                "status_id": 20,
                "text": "packets that would otherwise be non-ack-eliciting, to avoid an"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "d805d94f04eedb05"
                ],
                "status_id": 20,
                "text": "infinite feedback loop of acknowledgments."
              }
            ],
            "",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "0cfe39d56ea66c19",
                  "a0a2ad035e109503"
                ],
                "status_id": 22,
                "text": "In order to assist loss detection at the sender, an endpoint SHOULD"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "0cfe39d56ea66c19",
                  "a0a2ad035e109503"
                ],
                "status_id": 22,
                "text": "generate and send an ACK frame without delay when it receives an ack-"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "0cfe39d56ea66c19",
                  "a0a2ad035e109503"
                ],
                "status_id": 22,
                "text": "eliciting packet either:"
              }
            ],
            "",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "0cfe39d56ea66c19"
                ],
                "status_id": 1,
                "text": "*  when the received packet has a packet number less than another"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "      "
              },
              {
                "annotation_ids": [
                  "0cfe39d56ea66c19"
                ],
                "status_id": 1,
                "text": "ack-eliciting packet that has been received, or"
              }
            ],
            "",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "c521257aa9f28feb"
                ],
                "status_id": 1,
                "text": "*  when the packet has a packet number larger than the highest-"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "      "
              },
              {
                "annotation_ids": [
                  "c521257aa9f28feb"
                ],
                "status_id": 1,
                "text": "numbered ack-eliciting packet that has been received and there are"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "      "
              },
              {
                "annotation_ids": [
                  "c521257aa9f28feb"
                ],
                "status_id": 1,
                "text": "missing packets between that packet and this packet."
              }
            ],
            "",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "f28a2184b0005084",
                  "4c8e5eaf0e401d5b"
                ],
                "status_id": 22,
                "text": "Similarly, packets marked with the ECN Congestion Experienced (CE)"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "f28a2184b0005084",
                  "4c8e5eaf0e401d5b"
                ],
                "status_id": 22,
                "text": "codepoint in the IP header SHOULD be acknowledged immediately, to"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "f28a2184b0005084",
                  "4c8e5eaf0e401d5b"
                ],
                "status_id": 22,
                "text": "reduce the peer's response time to congestion events."
              }
            ],
            "",
            "   The algorithms in [QUIC-RECOVERY] are expected to be resilient to",
            "   receivers that do not follow the guidance offered above.  However, an",
            "   implementation should only deviate from these requirements after",
            "   careful consideration of the performance implications of a change,",
            "   for connections made by the endpoint and for other users of the",
            "   network."
          ],
          "requirements": [
            "624bf1d4ec9659de",
            "624bf1d4ec9659de",
            "624bf1d4ec9659de",
            "624bf1d4ec9659de",
            "7510ff8cb2a15d34",
            "7510ff8cb2a15d34",
            "7510ff8cb2a15d34",
            "a49840b2bcb6a47c",
            "a49840b2bcb6a47c",
            "a49840b2bcb6a47c",
            "8e51930e72aef839",
            "8e51930e72aef839",
            "8e51930e72aef839",
            "a0b28d7fd0268253",
            "a0b28d7fd0268253",
            "a0b28d7fd0268253",
            "7b5ff51fc5772ac6",
            "7b5ff51fc5772ac6",
            "7b5ff51fc5772ac6",
            "d805d94f04eedb05",
            "d805d94f04eedb05",
            "d805d94f04eedb05",
            "d805d94f04eedb05",
            "a0a2ad035e109503",
            "a0a2ad035e109503",
            "a0a2ad035e109503",
            "4c8e5eaf0e401d5b",
            "4c8e5eaf0e401d5b",
            "4c8e5eaf0e401d5b"
          ],
          "title": "Sending ACK Frames"
        },
        {
          "id": "section-13.2.2",
          "lines": [
            "   A receiver determines how frequently to send acknowledgments in",
            "   response to ack-eliciting packets.  This determination involves a",
            "   trade-off.",
            "",
            "   Endpoints rely on timely acknowledgment to detect loss; see Section 6",
            "   of [QUIC-RECOVERY].  Window-based congestion controllers, such as the",
            "   one described in Section 7 of [QUIC-RECOVERY], rely on",
            "   acknowledgments to manage their congestion window.  In both cases,",
            "   delaying acknowledgments can adversely affect performance.",
            "",
            "   On the other hand, reducing the frequency of packets that carry only",
            "   acknowledgments reduces packet transmission and processing cost at",
            "   both endpoints.  It can improve connection throughput on severely",
            "   asymmetric links and reduce the volume of acknowledgment traffic",
            "   using return path capacity; see Section 3 of [RFC3449].",
            "",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "2068ec42a8a04be5"
                ],
                "status_id": 14,
                "text": "A receiver SHOULD send an ACK frame after receiving at least two ack-"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "2068ec42a8a04be5"
                ],
                "status_id": 14,
                "text": "eliciting packets."
              },
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "  This recommendation is general in nature and"
              }
            ],
            "   consistent with recommendations for TCP endpoint behavior [RFC5681].",
            "   Knowledge of network conditions, knowledge of the peer's congestion",
            "   controller, or further research and experimentation might suggest",
            "   alternative acknowledgment strategies with better performance",
            "   characteristics.",
            "",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "70e9680900d746f6"
                ],
                "status_id": 19,
                "text": "A receiver MAY process multiple available packets before determining"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "70e9680900d746f6"
                ],
                "status_id": 19,
                "text": "whether to send an ACK frame in response."
              }
            ]
          ],
          "requirements": [
            "2068ec42a8a04be5",
            "2068ec42a8a04be5",
            "70e9680900d746f6",
            "70e9680900d746f6"
          ],
          "title": "Acknowledgment Frequency"
        },
        {
          "id": "section-13.2.3",
          "lines": [
            "   When an ACK frame is sent, one or more ranges of acknowledged packets",
            "   are included.  Including acknowledgments for older packets reduces",
            "   the chance of spurious retransmissions caused by losing previously",
            "   sent ACK frames, at the cost of larger ACK frames.",
            "",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "baea631b6a5a87fd"
                ],
                "status_id": 14,
                "text": "ACK frames SHOULD always acknowledge the most recently received"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "baea631b6a5a87fd"
                ],
                "status_id": 14,
                "text": "packets, and the more out of order the packets are, the more"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "baea631b6a5a87fd"
                ],
                "status_id": 14,
                "text": "important it is to send an updated ACK frame quickly, to prevent the"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "baea631b6a5a87fd"
                ],
                "status_id": 14,
                "text": "peer from declaring a packet as lost and spuriously retransmitting"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "baea631b6a5a87fd"
                ],
                "status_id": 14,
                "text": "the frames it contains."
              },
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "  An ACK frame is expected to fit within a"
              }
            ],
            "   single QUIC packet.  If it does not, then older ranges (those with",
            "   the smallest packet numbers) are omitted.",
            "",
            "   A receiver limits the number of ACK Ranges (Section 19.3.1) it",
            "   remembers and sends in ACK frames, both to limit the size of ACK",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   frames and to avoid resource exhaustion.  "
              },
              {
                "annotation_ids": [
                  "e953848e7c0495f0"
                ],
                "status_id": 14,
                "text": "After receiving"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "e953848e7c0495f0"
                ],
                "status_id": 14,
                "text": "acknowledgments for an ACK frame, the receiver SHOULD stop tracking"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "e953848e7c0495f0"
                ],
                "status_id": 14,
                "text": "those acknowledged ACK Ranges."
              },
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "  Senders can expect acknowledgments"
              }
            ],
            "   for most packets, but QUIC does not guarantee receipt of an",
            "   acknowledgment for every packet that the receiver processes.",
            "",
            "   It is possible that retaining many ACK Ranges could cause an ACK",
            "   frame to become too large.  A receiver can discard unacknowledged ACK",
            "   Ranges to limit ACK frame size, at the cost of increased",
            "   retransmissions from the sender.  This is necessary if an ACK frame",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   would be too large to fit in a packet.  "
              },
              {
                "annotation_ids": [
                  "6bb7789727babc35"
                ],
                "status_id": 19,
                "text": "Receivers MAY also limit ACK"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "6bb7789727babc35"
                ],
                "status_id": 19,
                "text": "frame size further to preserve space for other frames or to limit the"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "6bb7789727babc35"
                ],
                "status_id": 19,
                "text": "capacity that acknowledgments consume."
              }
            ],
            "",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "aa6fdf392b1160b6"
                ],
                "status_id": 20,
                "text": "A receiver MUST retain an ACK Range unless it can ensure that it will"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "aa6fdf392b1160b6"
                ],
                "status_id": 20,
                "text": "not subsequently accept packets with numbers in that range."
              }
            ],
            "   Maintaining a minimum packet number that increases as ranges are",
            "   discarded is one way to achieve this with minimal state.",
            "",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "e832b381dd522a53"
                ],
                "status_id": 20,
                "text": "Receivers can discard all ACK Ranges, but they MUST retain the"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "e832b381dd522a53"
                ],
                "status_id": 20,
                "text": "largest packet number that has been successfully processed, as that"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "e832b381dd522a53"
                ],
                "status_id": 20,
                "text": "is used to recover packet numbers from subsequent packets; see"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "e832b381dd522a53"
                ],
                "status_id": 20,
                "text": "Section 17.1."
              }
            ],
            "",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "664a97448c32bc77"
                ],
                "status_id": 14,
                "text": "A receiver SHOULD include an ACK Range containing the largest"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "664a97448c32bc77"
                ],
                "status_id": 14,
                "text": "received packet number in every ACK frame."
              },
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "  The Largest Acknowledged"
              }
            ],
            "   field is used in ECN validation at a sender, and including a lower",
            "   value than what was included in a previous ACK frame could cause ECN",
            "   to be unnecessarily disabled; see Section 13.4.2.",
            "",
            "   Section 13.2.4 describes an exemplary approach for determining what",
            "   packets to acknowledge in each ACK frame.  Though the goal of this",
            "   algorithm is to generate an acknowledgment for every packet that is",
            "   processed, it is still possible for acknowledgments to be lost."
          ],
          "requirements": [
            "baea631b6a5a87fd",
            "baea631b6a5a87fd",
            "baea631b6a5a87fd",
            "baea631b6a5a87fd",
            "baea631b6a5a87fd",
            "e953848e7c0495f0",
            "e953848e7c0495f0",
            "e953848e7c0495f0",
            "6bb7789727babc35",
            "6bb7789727babc35",
            "6bb7789727babc35",
            "aa6fdf392b1160b6",
            "aa6fdf392b1160b6",
            "e832b381dd522a53",
            "e832b381dd522a53",
            "e832b381dd522a53",
            "e832b381dd522a53",
            "664a97448c32bc77",
            "664a97448c32bc77"
          ],
          "title": "Managing ACK Ranges"
        },
        {
          "id": "section-13.2.4",
          "lines": [
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "79b82353ddd2ce11"
                ],
                "status_id": 1,
                "text": "When a packet containing an ACK frame is sent, the Largest"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "79b82353ddd2ce11"
                ],
                "status_id": 1,
                "text": "Acknowledged field in that frame can be saved."
              },
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "  "
              },
              {
                "annotation_ids": [
                  "c246c5b85549720c"
                ],
                "status_id": 1,
                "text": "When a packet"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "c246c5b85549720c"
                ],
                "status_id": 1,
                "text": "containing an ACK frame is acknowledged, the receiver can stop"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "c246c5b85549720c"
                ],
                "status_id": 1,
                "text": "acknowledging packets less than or equal to the Largest Acknowledged"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "c246c5b85549720c"
                ],
                "status_id": 1,
                "text": "field in the sent ACK frame."
              }
            ],
            "",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "9f5438ba07719483"
                ],
                "status_id": 1,
                "text": "A receiver that sends only non-ack-eliciting packets, such as ACK"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "9f5438ba07719483"
                ],
                "status_id": 1,
                "text": "frames, might not receive an acknowledgment for a long period of"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "9f5438ba07719483"
                ],
                "status_id": 1,
                "text": "time.  This could cause the receiver to maintain state for a large"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "9f5438ba07719483"
                ],
                "status_id": 1,
                "text": "number of ACK frames for a long period of time, and ACK frames it"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "9f5438ba07719483"
                ],
                "status_id": 1,
                "text": "sends could be unnecessarily large.  In such a case, a receiver could"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "9f5438ba07719483"
                ],
                "status_id": 1,
                "text": "send a PING or other small ack-eliciting frame occasionally, such as"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "9f5438ba07719483"
                ],
                "status_id": 1,
                "text": "once per round trip, to elicit an ACK from the peer."
              }
            ],
            "",
            "   In cases without ACK frame loss, this algorithm allows for a minimum",
            "   of 1 RTT of reordering.  In cases with ACK frame loss and reordering,",
            "   this approach does not guarantee that every acknowledgment is seen by",
            "   the sender before it is no longer included in the ACK frame.  Packets",
            "   could be received out of order, and all subsequent ACK frames",
            "   containing them could be lost.  In this case, the loss recovery",
            "   algorithm could cause spurious retransmissions, but the sender will",
            "   continue making forward progress."
          ],
          "title": "Limiting Ranges by Tracking ACK Frames"
        },
        {
          "id": "section-13.2.5",
          "lines": [
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "c174f441a7b15fca"
                ],
                "status_id": 1,
                "text": "An endpoint measures the delays intentionally introduced between the"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "c174f441a7b15fca"
                ],
                "status_id": 1,
                "text": "time the packet with the largest packet number is received and the"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "c174f441a7b15fca"
                ],
                "status_id": 1,
                "text": "time an acknowledgment is sent.  The endpoint encodes this"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "c174f441a7b15fca"
                ],
                "status_id": 1,
                "text": "acknowledgment delay in the ACK Delay field of an ACK frame; see"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "c174f441a7b15fca"
                ],
                "status_id": 1,
                "text": "Section 19.3.  This allows the receiver of the ACK frame to adjust"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "c174f441a7b15fca"
                ],
                "status_id": 1,
                "text": "for any intentional delays, which is important for getting a better"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "c174f441a7b15fca"
                ],
                "status_id": 1,
                "text": "estimate of the path RTT when acknowledgments are delayed."
              }
            ],
            "",
            "   A packet might be held in the OS kernel or elsewhere on the host",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   before being processed.  "
              },
              {
                "annotation_ids": [
                  "e4e06b69acc0b3d2"
                ],
                "status_id": 20,
                "text": "An endpoint MUST NOT include delays that it"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "e4e06b69acc0b3d2"
                ],
                "status_id": 20,
                "text": "does not control when populating the ACK Delay field in an ACK frame."
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "76e91969a60b2a96"
                ],
                "status_id": 14,
                "text": "However, endpoints SHOULD include buffering delays caused by"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "76e91969a60b2a96"
                ],
                "status_id": 14,
                "text": "unavailability of decryption keys, since these delays can be large"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "76e91969a60b2a96"
                ],
                "status_id": 14,
                "text": "and are likely to be non-repeating."
              }
            ],
            "",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "d3db2eaac21becd9"
                ],
                "status_id": 14,
                "text": "When the measured acknowledgment delay is larger than its"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "d3db2eaac21becd9"
                ],
                "status_id": 14,
                "text": "max_ack_delay, an endpoint SHOULD report the measured delay."
              },
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "  This"
              }
            ],
            "   information is especially useful during the handshake when delays",
            "   might be large; see Section 13.2.1."
          ],
          "requirements": [
            "e4e06b69acc0b3d2",
            "e4e06b69acc0b3d2",
            "76e91969a60b2a96",
            "76e91969a60b2a96",
            "76e91969a60b2a96",
            "d3db2eaac21becd9",
            "d3db2eaac21becd9"
          ],
          "title": "Measuring and Reporting Host Delay"
        },
        {
          "id": "section-13.2.6",
          "lines": [
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "8b32ad028401db4e"
                ],
                "status_id": 20,
                "text": "ACK frames MUST only be carried in a packet that has the same packet"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "8b32ad028401db4e"
                ],
                "status_id": 20,
                "text": "number space as the packet being acknowledged; see Section 12.1."
              },
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "  "
              },
              {
                "annotation_ids": [
                  "2f6a8178daf9b2f8"
                ],
                "status_id": 20,
                "text": "For"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "2f6a8178daf9b2f8"
                ],
                "status_id": 20,
                "text": "instance, packets that are protected with 1-RTT keys MUST be"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "2f6a8178daf9b2f8"
                ],
                "status_id": 20,
                "text": "acknowledged in packets that are also protected with 1-RTT keys."
              }
            ],
            "",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "4bc37bcedec36d19"
                ],
                "status_id": 20,
                "text": "Packets that a client sends with 0-RTT packet protection MUST be"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "4bc37bcedec36d19"
                ],
                "status_id": 20,
                "text": "acknowledged by the server in packets protected by 1-RTT keys."
              },
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "  This"
              }
            ],
            "   can mean that the client is unable to use these acknowledgments if",
            "   the server cryptographic handshake messages are delayed or lost.",
            "   Note that the same limitation applies to other data sent by the",
            "   server protected by the 1-RTT keys."
          ],
          "requirements": [
            "8b32ad028401db4e",
            "8b32ad028401db4e",
            "2f6a8178daf9b2f8",
            "2f6a8178daf9b2f8",
            "2f6a8178daf9b2f8",
            "4bc37bcedec36d19",
            "4bc37bcedec36d19"
          ],
          "title": "ACK Frames and Packet Protection"
        },
        {
          "id": "section-13.2.7",
          "lines": [
            "   Packets containing PADDING frames are considered to be in flight for",
            "   congestion control purposes [QUIC-RECOVERY].  Packets containing only",
            "   PADDING frames therefore consume congestion window but do not",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   generate acknowledgments that will open the congestion window.  "
              },
              {
                "annotation_ids": [
                  "80824d603ba82977"
                ],
                "status_id": 14,
                "text": "To"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "80824d603ba82977"
                ],
                "status_id": 14,
                "text": "avoid a deadlock, a sender SHOULD ensure that other frames are sent"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "80824d603ba82977"
                ],
                "status_id": 14,
                "text": "periodically in addition to PADDING frames to elicit acknowledgments"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "80824d603ba82977"
                ],
                "status_id": 14,
                "text": "from the receiver."
              }
            ]
          ],
          "requirements": [
            "80824d603ba82977",
            "80824d603ba82977",
            "80824d603ba82977",
            "80824d603ba82977"
          ],
          "title": "PADDING Frames Consume Congestion Window"
        },
        {
          "id": "section-13.3",
          "lines": [
            "   QUIC packets that are determined to be lost are not retransmitted",
            "   whole.  The same applies to the frames that are contained within lost",
            "   packets.  Instead, the information that might be carried in frames is",
            "   sent again in new frames as needed.",
            "",
            "   New frames and packets are used to carry information that is",
            "   determined to have been lost.  In general, information is sent again",
            "   when a packet containing that information is determined to be lost,",
            "   and sending ceases when a packet containing that information is",
            "   acknowledged.",
            "",
            "   *  Data sent in CRYPTO frames is retransmitted according to the rules",
            "      in [QUIC-RECOVERY], until all data has been acknowledged.  Data in",
            "      CRYPTO frames for Initial and Handshake packets is discarded when",
            "      keys for the corresponding packet number space are discarded.",
            "",
            "   *  Application data sent in STREAM frames is retransmitted in new",
            "      STREAM frames unless the endpoint has sent a RESET_STREAM for that",
            "      stream.  Once an endpoint sends a RESET_STREAM frame, no further",
            "      STREAM frames are needed.",
            "",
            "   *  ACK frames carry the most recent set of acknowledgments and the",
            "      acknowledgment delay from the largest acknowledged packet, as",
            "      described in Section 13.2.1.  Delaying the transmission of packets",
            "      containing ACK frames or resending old ACK frames can cause the",
            "      peer to generate an inflated RTT sample or unnecessarily disable",
            "      ECN.",
            "",
            "   *  Cancellation of stream transmission, as carried in a RESET_STREAM",
            "      frame, is sent until acknowledged or until all stream data is",
            "      acknowledged by the peer (that is, either the \"Reset Recvd\" or",
            "      \"Data Recvd\" state is reached on the sending part of the stream).",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "      "
              },
              {
                "annotation_ids": [
                  "b0c97c0e57703bcc"
                ],
                "status_id": 20,
                "text": "The content of a RESET_STREAM frame MUST NOT change when it is"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "      "
              },
              {
                "annotation_ids": [
                  "b0c97c0e57703bcc"
                ],
                "status_id": 20,
                "text": "sent again."
              }
            ],
            "",
            "   *  Similarly, a request to cancel stream transmission, as encoded in",
            "      a STOP_SENDING frame, is sent until the receiving part of the",
            "      stream enters either a \"Data Recvd\" or \"Reset Recvd\" state; see",
            "      Section 3.5.",
            "",
            "   *  Connection close signals, including packets that contain",
            "      CONNECTION_CLOSE frames, are not sent again when packet loss is",
            "      detected.  Resending these signals is described in Section 10.",
            "",
            "   *  The current connection maximum data is sent in MAX_DATA frames.",
            "      An updated value is sent in a MAX_DATA frame if the packet",
            "      containing the most recently sent MAX_DATA frame is declared lost",
            "      or when the endpoint decides to update the limit.  Care is",
            "      necessary to avoid sending this frame too often, as the limit can",
            "      increase frequently and cause an unnecessarily large number of",
            "      MAX_DATA frames to be sent; see Section 4.2.",
            "",
            "   *  The current maximum stream data offset is sent in MAX_STREAM_DATA",
            "      frames.  Like MAX_DATA, an updated value is sent when the packet",
            "      containing the most recent MAX_STREAM_DATA frame for a stream is",
            "      lost or when the limit is updated, with care taken to prevent the",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "      frame from being sent too often.  "
              },
              {
                "annotation_ids": [
                  "efac6a875879dd5a"
                ],
                "status_id": 14,
                "text": "An endpoint SHOULD stop sending"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "      "
              },
              {
                "annotation_ids": [
                  "efac6a875879dd5a"
                ],
                "status_id": 14,
                "text": "MAX_STREAM_DATA frames when the receiving part of the stream"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "      "
              },
              {
                "annotation_ids": [
                  "efac6a875879dd5a"
                ],
                "status_id": 14,
                "text": "enters a \"Size Known\" or \"Reset Recvd\" state."
              }
            ],
            "",
            "   *  The limit on streams of a given type is sent in MAX_STREAMS",
            "      frames.  Like MAX_DATA, an updated value is sent when a packet",
            "      containing the most recent MAX_STREAMS for a stream type frame is",
            "      declared lost or when the limit is updated, with care taken to",
            "      prevent the frame from being sent too often.",
            "",
            "   *  Blocked signals are carried in DATA_BLOCKED, STREAM_DATA_BLOCKED,",
            "      and STREAMS_BLOCKED frames.  DATA_BLOCKED frames have connection",
            "      scope, STREAM_DATA_BLOCKED frames have stream scope, and",
            "      STREAMS_BLOCKED frames are scoped to a specific stream type.  A",
            "      new frame is sent if a packet containing the most recent frame for",
            "      a scope is lost, but only while the endpoint is blocked on the",
            "      corresponding limit.  These frames always include the limit that",
            "      is causing blocking at the time that they are transmitted.",
            "",
            "   *  A liveness or path validation check using PATH_CHALLENGE frames is",
            "      sent periodically until a matching PATH_RESPONSE frame is received",
            "      or until there is no remaining need for liveness or path",
            "      validation checking.  PATH_CHALLENGE frames include a different",
            "      payload each time they are sent.",
            "",
            "   *  Responses to path validation using PATH_RESPONSE frames are sent",
            "      just once.  The peer is expected to send more PATH_CHALLENGE",
            "      frames as necessary to evoke additional PATH_RESPONSE frames.",
            "",
            "   *  New connection IDs are sent in NEW_CONNECTION_ID frames and",
            "      retransmitted if the packet containing them is lost.",
            "      Retransmissions of this frame carry the same sequence number",
            "      value.  Likewise, retired connection IDs are sent in",
            "      RETIRE_CONNECTION_ID frames and retransmitted if the packet",
            "      containing them is lost.",
            "",
            "   *  NEW_TOKEN frames are retransmitted if the packet containing them",
            "      is lost.  No special support is made for detecting reordered and",
            "      duplicated NEW_TOKEN frames other than a direct comparison of the",
            "      frame contents.",
            "",
            "   *  PING and PADDING frames contain no information, so lost PING or",
            "      PADDING frames do not require repair.",
            "",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "8fa2d270bb2a5baf"
                ],
                "status_id": 20,
                "text": "*  "
              },
              {
                "annotation_ids": [
                  "522ae9597d9555fe",
                  "04ab829dbf990865",
                  "8fa2d270bb2a5baf"
                ],
                "status_id": 9,
                "text": "The HANDSHAKE_DONE frame MUST be retransmitted until it is"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "      "
              },
              {
                "annotation_ids": [
                  "522ae9597d9555fe",
                  "04ab829dbf990865",
                  "8fa2d270bb2a5baf"
                ],
                "status_id": 9,
                "text": "acknowledged."
              }
            ],
            "",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "48b434ccf3946eb0"
                ],
                "status_id": 14,
                "text": "Endpoints SHOULD prioritize retransmission of data over sending new"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "48b434ccf3946eb0"
                ],
                "status_id": 14,
                "text": "data, unless priorities specified by the application indicate"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "48b434ccf3946eb0"
                ],
                "status_id": 14,
                "text": "otherwise; see Section 2.3."
              }
            ],
            "",
            "   Even though a sender is encouraged to assemble frames containing up-",
            "   to-date information every time it sends a packet, it is not forbidden",
            "   to retransmit copies of frames from lost packets.  A sender that",
            "   retransmits copies of frames needs to handle decreases in available",
            "   payload size due to changes in packet number length, connection ID",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   length, and path MTU.  "
              },
              {
                "annotation_ids": [
                  "584bccb28ddec537"
                ],
                "status_id": 20,
                "text": "A receiver MUST accept packets containing an"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "584bccb28ddec537"
                ],
                "status_id": 20,
                "text": "outdated frame, such as a MAX_DATA frame carrying a smaller maximum"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "584bccb28ddec537"
                ],
                "status_id": 20,
                "text": "data value than one found in an older packet."
              }
            ],
            "",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "31df123045bb9162"
                ],
                "status_id": 14,
                "text": "A sender SHOULD avoid retransmitting information from packets once"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "31df123045bb9162"
                ],
                "status_id": 14,
                "text": "they are acknowledged."
              },
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "  This includes packets that are acknowledged"
              }
            ],
            "   after being declared lost, which can happen in the presence of",
            "   network reordering.  Doing so requires senders to retain information",
            "   about packets after they are declared lost.  A sender can discard",
            "   this information after a period of time elapses that adequately",
            "   allows for reordering, such as a PTO (Section 6.2 of",
            "   [QUIC-RECOVERY]), or based on other events, such as reaching a memory",
            "   limit.",
            "",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "c0775727c71e2380"
                ],
                "status_id": 20,
                "text": "Upon detecting losses, a sender MUST take appropriate congestion"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "c0775727c71e2380"
                ],
                "status_id": 20,
                "text": "control action."
              },
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "  The details of loss detection and congestion control"
              }
            ],
            "   are described in [QUIC-RECOVERY]."
          ],
          "requirements": [
            "b0c97c0e57703bcc",
            "b0c97c0e57703bcc",
            "efac6a875879dd5a",
            "efac6a875879dd5a",
            "efac6a875879dd5a",
            "8fa2d270bb2a5baf",
            "8fa2d270bb2a5baf",
            "48b434ccf3946eb0",
            "48b434ccf3946eb0",
            "48b434ccf3946eb0",
            "584bccb28ddec537",
            "584bccb28ddec537",
            "584bccb28ddec537",
            "31df123045bb9162",
            "31df123045bb9162",
            "c0775727c71e2380",
            "c0775727c71e2380"
          ],
          "title": "Retransmission of Information"
        },
        {
          "id": "section-13.4",
          "lines": [
            "   QUIC endpoints can use ECN [RFC3168] to detect and respond to network",
            "   congestion.  ECN allows an endpoint to set an ECN-Capable Transport",
            "   (ECT) codepoint in the ECN field of an IP packet.  A network node can",
            "   then indicate congestion by setting the ECN-CE codepoint in the ECN",
            "   field instead of dropping the packet [RFC8087].  Endpoints react to",
            "   reported congestion by reducing their sending rate in response, as",
            "   described in [QUIC-RECOVERY].",
            "",
            "   To enable ECN, a sending QUIC endpoint first determines whether a",
            "   path supports ECN marking and whether the peer reports the ECN values",
            "   in received IP headers; see Section 13.4.2."
          ],
          "title": "Explicit Congestion Notification"
        },
        {
          "id": "section-13.4.1",
          "lines": [
            "   The use of ECN requires the receiving endpoint to read the ECN field",
            "   from an IP packet, which is not possible on all platforms.  If an",
            "   endpoint does not implement ECN support or does not have access to",
            "   received ECN fields, it does not report ECN counts for packets it",
            "   receives.",
            "",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "3aeed290a77e7906",
                  "9ef49545a257a1f9"
                ],
                "status_id": 13,
                "text": "Even if an endpoint does not set an ECT field in packets it sends,"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "3aeed290a77e7906",
                  "9ef49545a257a1f9"
                ],
                "status_id": 13,
                "text": "the endpoint MUST provide feedback about ECN markings it receives, if"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "3aeed290a77e7906",
                  "9ef49545a257a1f9"
                ],
                "status_id": 13,
                "text": "these are accessible."
              },
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "  Failing to report the ECN counts will cause"
              }
            ],
            "   the sender to disable the use of ECN for this connection.",
            "",
            "   On receiving an IP packet with an ECT(0), ECT(1), or ECN-CE",
            "   codepoint, an ECN-enabled endpoint accesses the ECN field and",
            "   increases the corresponding ECT(0), ECT(1), or ECN-CE count.  These",
            "   ECN counts are included in subsequent ACK frames; see Sections 13.2",
            "   and 19.3.",
            "",
            "   Each packet number space maintains separate acknowledgment state and",
            "   separate ECN counts.  Coalesced QUIC packets (see Section 12.2) share",
            "   the same IP header so the ECN counts are incremented once for each",
            "   coalesced QUIC packet.",
            "",
            "   For example, if one each of an Initial, Handshake, and 1-RTT QUIC",
            "   packet are coalesced into a single UDP datagram, the ECN counts for",
            "   all three packet number spaces will be incremented by one each, based",
            "   on the ECN field of the single IP header.",
            "",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "905a86089439137c"
                ],
                "status_id": 1,
                "text": "ECN counts are only incremented when QUIC packets from the received"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "905a86089439137c"
                ],
                "status_id": 1,
                "text": "IP packet are processed.  As such, duplicate QUIC packets are not"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "905a86089439137c"
                ],
                "status_id": 1,
                "text": "processed and do not increase ECN counts; see Section 21.10 for"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "905a86089439137c"
                ],
                "status_id": 1,
                "text": "relevant security concerns."
              }
            ]
          ],
          "requirements": [
            "9ef49545a257a1f9",
            "9ef49545a257a1f9",
            "9ef49545a257a1f9"
          ],
          "title": "Reporting ECN Counts"
        },
        {
          "id": "section-13.4.2",
          "lines": [
            "   It is possible for faulty network devices to corrupt or erroneously",
            "   drop packets that carry a non-zero ECN codepoint.  To ensure",
            "   connectivity in the presence of such devices, an endpoint validates",
            "   the ECN counts for each network path and disables the use of ECN on",
            "   that path if errors are detected.",
            "",
            "   To perform ECN validation for a new path:",
            "",
            "   *  The endpoint sets an ECT(0) codepoint in the IP header of early",
            "      outgoing packets sent on a new path to the peer [RFC8311].",
            "",
            "   *  The endpoint monitors whether all packets sent with an ECT",
            "      codepoint are eventually deemed lost (Section 6 of",
            "      [QUIC-RECOVERY]), indicating that ECN validation has failed.",
            "",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "d64c386236e0be48"
                ],
                "status_id": 1,
                "text": "If an endpoint has cause to expect that IP packets with an ECT"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "d64c386236e0be48"
                ],
                "status_id": 1,
                "text": "codepoint might be dropped by a faulty network element, the endpoint"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "d64c386236e0be48"
                ],
                "status_id": 1,
                "text": "could set an ECT codepoint for only the first ten outgoing packets on"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "d64c386236e0be48"
                ],
                "status_id": 1,
                "text": "a path, or for a period of three PTOs"
              },
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": " (see Section 6.2 of"
              }
            ],
            "   [QUIC-RECOVERY]).  If all packets marked with non-zero ECN codepoints",
            "   are subsequently lost, it can disable marking on the assumption that",
            "   the marking caused the loss.",
            "",
            "   An endpoint thus attempts to use ECN and validates this for each new",
            "   connection, when switching to a server's preferred address, and on",
            "   active connection migration to a new path.  Appendix A.4 describes",
            "   one possible algorithm.",
            "",
            "   Other methods of probing paths for ECN support are possible, as are",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   different marking strategies.  "
              },
              {
                "annotation_ids": [
                  "133a9699048fcb5c"
                ],
                "status_id": 19,
                "text": "Implementations MAY use other methods"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "133a9699048fcb5c"
                ],
                "status_id": 19,
                "text": "defined in RFCs; see [RFC8311]."
              },
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "  Implementations that use the ECT(1)"
              }
            ],
            "   codepoint need to perform ECN validation using the reported ECT(1)",
            "   counts."
          ],
          "requirements": [
            "133a9699048fcb5c",
            "133a9699048fcb5c"
          ],
          "title": "ECN Validation"
        },
        {
          "id": "section-13.4.2.1",
          "lines": [
            "   Erroneous application of ECN-CE markings by the network can result in",
            "   degraded connection performance.  An endpoint that receives an ACK",
            "   frame with ECN counts therefore validates the counts before using",
            "   them.  It performs this validation by comparing newly received counts",
            "   against those from the last successfully processed ACK frame.  Any",
            "   increase in the ECN counts is validated based on the ECN markings",
            "   that were applied to packets that are newly acknowledged in the ACK",
            "   frame.",
            "",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "2b90c7715202709a",
                  "cde3d132192b4a99"
                ],
                "status_id": 2,
                "text": "If an ACK frame newly acknowledges a packet that the endpoint sent"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "2b90c7715202709a",
                  "cde3d132192b4a99"
                ],
                "status_id": 2,
                "text": "with either the ECT(0) or ECT(1) codepoint set, ECN validation fails"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "2b90c7715202709a",
                  "cde3d132192b4a99"
                ],
                "status_id": 2,
                "text": "if the corresponding ECN counts are not present in the ACK frame."
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "2b90c7715202709a",
                  "cde3d132192b4a99"
                ],
                "status_id": 2,
                "text": "This check detects a network element that zeroes the ECN field or a"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "2b90c7715202709a",
                  "cde3d132192b4a99"
                ],
                "status_id": 2,
                "text": "peer that does not report ECN markings."
              }
            ],
            "",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "e0e1f7ba810ad173",
                  "b15a20949f9a402e"
                ],
                "status_id": 2,
                "text": "ECN validation also fails if the sum of the increase in ECT(0) and"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "e0e1f7ba810ad173",
                  "b15a20949f9a402e"
                ],
                "status_id": 2,
                "text": "ECN-CE counts is less than the number of newly acknowledged packets"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "e0e1f7ba810ad173",
                  "b15a20949f9a402e"
                ],
                "status_id": 2,
                "text": "that were originally sent with an ECT(0) marking."
              },
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "  Similarly, ECN"
              }
            ],
            "   validation fails if the sum of the increases to ECT(1) and ECN-CE",
            "   counts is less than the number of newly acknowledged packets sent",
            "   with an ECT(1) marking.  These checks can detect remarking of ECN-CE",
            "   markings by the network.",
            "",
            "   An endpoint could miss acknowledgments for a packet when ACK frames",
            "   are lost.  It is therefore possible for the total increase in ECT(0),",
            "   ECT(1), and ECN-CE counts to be greater than the number of packets",
            "   that are newly acknowledged by an ACK frame.  This is why ECN counts",
            "   are permitted to be larger than the total number of packets that are",
            "   acknowledged.",
            "",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "922584cf16c40dd9",
                  "4ba41dc2b1e3fe54"
                ],
                "status_id": 2,
                "text": "Validating ECN counts from reordered ACK frames can result in"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "922584cf16c40dd9",
                  "4ba41dc2b1e3fe54"
                ],
                "status_id": 2,
                "text": "failure.  "
              },
              {
                "annotation_ids": [
                  "922584cf16c40dd9",
                  "4ba41dc2b1e3fe54",
                  "56ab6d07a112cea4"
                ],
                "status_id": 9,
                "text": "An endpoint MUST NOT fail ECN validation as a result of"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "922584cf16c40dd9",
                  "4ba41dc2b1e3fe54",
                  "56ab6d07a112cea4"
                ],
                "status_id": 9,
                "text": "processing an ACK frame that does not increase the largest"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "922584cf16c40dd9",
                  "4ba41dc2b1e3fe54",
                  "56ab6d07a112cea4"
                ],
                "status_id": 9,
                "text": "acknowledged packet number."
              }
            ],
            "",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "d2ce353c8770d425",
                  "9790033947b287fa"
                ],
                "status_id": 2,
                "text": "ECN validation can fail if the received total count for either ECT(0)"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "d2ce353c8770d425",
                  "9790033947b287fa"
                ],
                "status_id": 2,
                "text": "or ECT(1) exceeds the total number of packets sent with each"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "d2ce353c8770d425",
                  "9790033947b287fa"
                ],
                "status_id": 2,
                "text": "corresponding ECT codepoint."
              },
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "  In particular, validation will fail"
              }
            ],
            "   when an endpoint receives a non-zero ECN count corresponding to an",
            "   ECT codepoint that it never applied.  This check detects when packets",
            "   are remarked to ECT(0) or ECT(1) in the network."
          ],
          "requirements": [
            "56ab6d07a112cea4",
            "56ab6d07a112cea4",
            "56ab6d07a112cea4"
          ],
          "title": "Receiving ACK Frames with ECN Counts"
        },
        {
          "id": "section-13.4.2.2",
          "lines": [
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "f7dfa7290b21a623",
                  "b9a82b81e8920fa0",
                  "5c8fae2c42619812"
                ],
                "status_id": 9,
                "text": "If validation fails, then the endpoint MUST disable ECN."
              },
              {
                "annotation_ids": [
                  "f7dfa7290b21a623",
                  "b9a82b81e8920fa0"
                ],
                "status_id": 2,
                "text": "  It stops"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "f7dfa7290b21a623",
                  "b9a82b81e8920fa0"
                ],
                "status_id": 2,
                "text": "setting the ECT codepoint in IP packets that it sends, assuming that"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "f7dfa7290b21a623",
                  "b9a82b81e8920fa0"
                ],
                "status_id": 2,
                "text": "either the network path or the peer does not support ECN."
              }
            ],
            "",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "d53ca4cad5e97d8e",
                  "b96a93169bb27707"
                ],
                "status_id": 21,
                "text": "Even if validation fails, an endpoint MAY revalidate ECN for the same"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "d53ca4cad5e97d8e",
                  "b96a93169bb27707"
                ],
                "status_id": 21,
                "text": "path at any later time in the connection."
              },
              {
                "annotation_ids": [
                  "d53ca4cad5e97d8e"
                ],
                "status_id": 1,
                "text": "  An endpoint could continue"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "d53ca4cad5e97d8e"
                ],
                "status_id": 1,
                "text": "to periodically attempt validation."
              }
            ],
            "",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "b02d790926e04412",
                  "9112eb89c518e406",
                  "cf3efff22840c957"
                ],
                "status_id": 11,
                "text": "Upon successful validation, an endpoint MAY continue to set an ECT"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "b02d790926e04412",
                  "9112eb89c518e406",
                  "cf3efff22840c957"
                ],
                "status_id": 11,
                "text": "codepoint in subsequent packets it sends, with the expectation that"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "b02d790926e04412",
                  "9112eb89c518e406",
                  "cf3efff22840c957"
                ],
                "status_id": 11,
                "text": "the path is ECN capable."
              },
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "  "
              },
              {
                "annotation_ids": [
                  "ce615564d638536d",
                  "db406a7f5a9f72f8"
                ],
                "status_id": 13,
                "text": "Network routing and path elements can"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "ce615564d638536d",
                  "db406a7f5a9f72f8"
                ],
                "status_id": 13,
                "text": "change mid-connection; an endpoint MUST disable ECN if validation"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "ce615564d638536d",
                  "db406a7f5a9f72f8"
                ],
                "status_id": 13,
                "text": "later fails."
              }
            ]
          ],
          "requirements": [
            "5c8fae2c42619812",
            "b96a93169bb27707",
            "b96a93169bb27707",
            "cf3efff22840c957",
            "cf3efff22840c957",
            "cf3efff22840c957",
            "db406a7f5a9f72f8",
            "db406a7f5a9f72f8",
            "db406a7f5a9f72f8"
          ],
          "title": "ECN Validation Outcomes"
        },
        {
          "id": "section-14",
          "lines": [
            "   A UDP datagram can include one or more QUIC packets.  The datagram",
            "   size refers to the total UDP payload size of a single UDP datagram",
            "   carrying QUIC packets.  The datagram size includes one or more QUIC",
            "   packet headers and protected payloads, but not the UDP or IP headers.",
            "",
            "   The maximum datagram size is defined as the largest size of UDP",
            "   payload that can be sent across a network path using a single UDP",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   datagram.  "
              },
              {
                "annotation_ids": [
                  "cd9eb7a0d8f8fe09",
                  "70c522927b702ef2"
                ],
                "status_id": 13,
                "text": "QUIC MUST NOT be used if the network path cannot support a"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "cd9eb7a0d8f8fe09",
                  "70c522927b702ef2"
                ],
                "status_id": 13,
                "text": "maximum datagram size of at least 1200 bytes."
              }
            ],
            "",
            "   QUIC assumes a minimum IP packet size of at least 1280 bytes.  This",
            "   is the IPv6 minimum size [IPv6] and is also supported by most modern",
            "   IPv4 networks.  Assuming the minimum IP header size of 40 bytes for",
            "   IPv6 and 20 bytes for IPv4 and a UDP header size of 8 bytes, this",
            "   results in a maximum datagram size of 1232 bytes for IPv6 and 1252",
            "   bytes for IPv4.  Thus, modern IPv4 and all IPv6 network paths are",
            "   expected to be able to support QUIC.",
            "",
            "      |  Note: This requirement to support a UDP payload of 1200 bytes",
            "      |  limits the space available for IPv6 extension headers to 32",
            "      |  bytes or IPv4 options to 52 bytes if the path only supports the",
            "      |  IPv6 minimum MTU of 1280 bytes.  This affects Initial packets",
            "      |  and path validation.",
            "",
            "   Any maximum datagram size larger than 1200 bytes can be discovered",
            "   using Path Maximum Transmission Unit Discovery (PMTUD) (see",
            "   Section 14.2.1) or Datagram Packetization Layer PMTU Discovery",
            "   (DPLPMTUD) (see Section 14.3).",
            "",
            "   Enforcement of the max_udp_payload_size transport parameter",
            "   (Section 18.2) might act as an additional limit on the maximum",
            "   datagram size.  A sender can avoid exceeding this limit, once the",
            "   value is known.  However, prior to learning the value of the",
            "   transport parameter, endpoints risk datagrams being lost if they send",
            "   datagrams larger than the smallest allowed maximum datagram size of",
            "   1200 bytes.",
            "",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "978af1763dffa1cb",
                  "9941291c1e8f31ca"
                ],
                "status_id": 13,
                "text": "UDP datagrams MUST NOT be fragmented at the IP layer."
              },
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "  "
              },
              {
                "annotation_ids": [
                  "88ba38930e5af764",
                  "99543ea46bd4a090"
                ],
                "status_id": 13,
                "text": "In IPv4"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "88ba38930e5af764",
                  "99543ea46bd4a090"
                ],
                "status_id": 13,
                "text": "[IPv4], the Don't Fragment (DF) bit MUST be set if possible, to"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "88ba38930e5af764",
                  "99543ea46bd4a090"
                ],
                "status_id": 13,
                "text": "prevent fragmentation on the path."
              }
            ],
            "",
            "   QUIC sometimes requires datagrams to be no smaller than a certain",
            "   size; see Section 8.1 as an example.  However, the size of a datagram",
            "   is not authenticated.  That is, if an endpoint receives a datagram of",
            "   a certain size, it cannot know that the sender sent the datagram at",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   the same size.  "
              },
              {
                "annotation_ids": [
                  "10080a643f3bc955"
                ],
                "status_id": 20,
                "text": "Therefore, an endpoint MUST NOT close a connection"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "10080a643f3bc955"
                ],
                "status_id": 20,
                "text": "when it receives a datagram that does not meet size constraints; the"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "10080a643f3bc955"
                ],
                "status_id": 20,
                "text": "endpoint MAY discard such datagrams."
              }
            ]
          ],
          "requirements": [
            "70c522927b702ef2",
            "70c522927b702ef2",
            "9941291c1e8f31ca",
            "99543ea46bd4a090",
            "99543ea46bd4a090",
            "99543ea46bd4a090",
            "10080a643f3bc955",
            "10080a643f3bc955",
            "10080a643f3bc955"
          ],
          "title": "Datagram Size"
        },
        {
          "id": "section-14.1",
          "lines": [
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "e739fb20de3e6577",
                  "825e6e6afb4d4e7d",
                  "5adfe775da303680"
                ],
                "status_id": 13,
                "text": "A client MUST expand the payload of all UDP datagrams carrying"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "e739fb20de3e6577",
                  "825e6e6afb4d4e7d",
                  "5adfe775da303680"
                ],
                "status_id": 13,
                "text": "Initial packets to at least the smallest allowed maximum datagram"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "e739fb20de3e6577",
                  "825e6e6afb4d4e7d",
                  "5adfe775da303680"
                ],
                "status_id": 13,
                "text": "size of 1200 bytes"
              },
              {
                "annotation_ids": [
                  "e739fb20de3e6577",
                  "5adfe775da303680"
                ],
                "status_id": 13,
                "text": " by adding PADDING frames to the Initial packet or"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "e739fb20de3e6577",
                  "5adfe775da303680"
                ],
                "status_id": 13,
                "text": "by coalescing the Initial packet; see Section 12.2."
              },
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "  Initial packets"
              }
            ],
            "   can even be coalesced with invalid packets, which a receiver will",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   discard.  "
              },
              {
                "annotation_ids": [
                  "70ab4a9822ece151",
                  "ae6830965af01f60",
                  "a62fc545d8528f00"
                ],
                "status_id": 13,
                "text": "Similarly, a server MUST expand the payload of all UDP"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "70ab4a9822ece151",
                  "ae6830965af01f60",
                  "a62fc545d8528f00"
                ],
                "status_id": 13,
                "text": "datagrams carrying ack-eliciting Initial packets to at least the"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "70ab4a9822ece151",
                  "ae6830965af01f60",
                  "a62fc545d8528f00"
                ],
                "status_id": 13,
                "text": "smallest allowed maximum datagram size of 1200 bytes."
              }
            ],
            "",
            "   Sending UDP datagrams of this size ensures that the network path",
            "   supports a reasonable Path Maximum Transmission Unit (PMTU), in both",
            "   directions.  Additionally, a client that expands Initial packets",
            "   helps reduce the amplitude of amplification attacks caused by server",
            "   responses toward an unverified client address; see Section 8.",
            "",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "c0e618918fc2865a",
                  "0c13ca7a2b757ad3",
                  "b6a82e793b248221"
                ],
                "status_id": 11,
                "text": "Datagrams containing Initial packets MAY exceed 1200 bytes if the"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "c0e618918fc2865a",
                  "0c13ca7a2b757ad3",
                  "b6a82e793b248221"
                ],
                "status_id": 11,
                "text": "sender believes that the network path and peer both support the size"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "c0e618918fc2865a",
                  "0c13ca7a2b757ad3",
                  "b6a82e793b248221"
                ],
                "status_id": 11,
                "text": "that it chooses."
              }
            ],
            "",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "de8867cef7b26f4f",
                  "0bf3f367d952f584",
                  "4bf0821ec968fed9"
                ],
                "status_id": 13,
                "text": "A server MUST discard an Initial packet that is carried in a UDP"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "de8867cef7b26f4f",
                  "0bf3f367d952f584",
                  "4bf0821ec968fed9"
                ],
                "status_id": 13,
                "text": "datagram with a payload that is smaller than the smallest allowed"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "de8867cef7b26f4f",
                  "0bf3f367d952f584",
                  "4bf0821ec968fed9"
                ],
                "status_id": 13,
                "text": "maximum datagram size of 1200 bytes."
              },
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "  "
              },
              {
                "annotation_ids": [
                  "089afbdf59e3f0c4",
                  "8609e6a275962356"
                ],
                "status_id": 15,
                "text": "A server MAY also immediately"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "089afbdf59e3f0c4",
                  "8609e6a275962356"
                ],
                "status_id": 15,
                "text": "close the connection by sending a CONNECTION_CLOSE frame with an"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "089afbdf59e3f0c4",
                  "8609e6a275962356"
                ],
                "status_id": 15,
                "text": "error code of PROTOCOL_VIOLATION; see Section 10.2.3."
              }
            ],
            "",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "c60c84a98715819c",
                  "40f3e94aac5cfa79",
                  "81bd28cf220efd1b"
                ],
                "status_id": 9,
                "text": "The server MUST also limit the number of bytes it sends before"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "c60c84a98715819c",
                  "40f3e94aac5cfa79",
                  "81bd28cf220efd1b"
                ],
                "status_id": 9,
                "text": "validating the address of the client; see Section 8."
              }
            ]
          ],
          "requirements": [
            "5adfe775da303680",
            "5adfe775da303680",
            "5adfe775da303680",
            "5adfe775da303680",
            "a62fc545d8528f00",
            "a62fc545d8528f00",
            "a62fc545d8528f00",
            "b6a82e793b248221",
            "b6a82e793b248221",
            "b6a82e793b248221",
            "4bf0821ec968fed9",
            "4bf0821ec968fed9",
            "4bf0821ec968fed9",
            "8609e6a275962356",
            "8609e6a275962356",
            "8609e6a275962356",
            "81bd28cf220efd1b",
            "81bd28cf220efd1b"
          ],
          "title": "Initial Datagram Size"
        },
        {
          "id": "section-14.2",
          "lines": [
            "   The PMTU is the maximum size of the entire IP packet, including the",
            "   IP header, UDP header, and UDP payload.  The UDP payload includes one",
            "   or more QUIC packet headers and protected payloads.  The PMTU can",
            "   depend on path characteristics and can therefore change over time.",
            "   The largest UDP payload an endpoint sends at any given time is",
            "   referred to as the endpoint's maximum datagram size.",
            "",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "cd3f6fe45abb0cbd"
                ],
                "status_id": 14,
                "text": "An endpoint SHOULD use DPLPMTUD (Section 14.3) or PMTUD"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "cd3f6fe45abb0cbd"
                ],
                "status_id": 14,
                "text": "(Section 14.2.1) to determine whether the path to a destination will"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "cd3f6fe45abb0cbd"
                ],
                "status_id": 14,
                "text": "support a desired maximum datagram size without fragmentation."
              },
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "  "
              },
              {
                "annotation_ids": [
                  "2b7605d6acde88e5"
                ],
                "status_id": 14,
                "text": "In"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "2b7605d6acde88e5"
                ],
                "status_id": 14,
                "text": "the absence of these mechanisms, QUIC endpoints SHOULD NOT send"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "2b7605d6acde88e5"
                ],
                "status_id": 14,
                "text": "datagrams larger than the smallest allowed maximum datagram size."
              }
            ],
            "",
            "   Both DPLPMTUD and PMTUD send datagrams that are larger than the",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   current maximum datagram size, referred to as PMTU probes.  "
              },
              {
                "annotation_ids": [
                  "cf3daddda5799920",
                  "1a2cb7d2110bb8b7",
                  "1a5bd900f7e8bcc0"
                ],
                "status_id": 8,
                "text": "All QUIC"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "cf3daddda5799920",
                  "1a2cb7d2110bb8b7",
                  "1a5bd900f7e8bcc0"
                ],
                "status_id": 8,
                "text": "packets that are not sent in a PMTU probe SHOULD be sized to fit"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "cf3daddda5799920",
                  "1a2cb7d2110bb8b7",
                  "1a5bd900f7e8bcc0"
                ],
                "status_id": 8,
                "text": "within the maximum datagram size to avoid the datagram being"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "cf3daddda5799920",
                  "1a2cb7d2110bb8b7",
                  "1a5bd900f7e8bcc0"
                ],
                "status_id": 8,
                "text": "fragmented or dropped [RFC8085]."
              }
            ],
            "",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "eff7744f4f0bb3ea"
                ],
                "status_id": 20,
                "text": "If a QUIC endpoint determines that the PMTU between any pair of local"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "eff7744f4f0bb3ea"
                ],
                "status_id": 20,
                "text": "and remote IP addresses cannot support the smallest allowed maximum"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "eff7744f4f0bb3ea"
                ],
                "status_id": 20,
                "text": "datagram size of 1200 bytes, it MUST immediately cease sending QUIC"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "eff7744f4f0bb3ea"
                ],
                "status_id": 20,
                "text": "packets, except for those in PMTU probes or those containing"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "eff7744f4f0bb3ea"
                ],
                "status_id": 20,
                "text": "CONNECTION_CLOSE frames, on the affected path."
              },
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "  "
              },
              {
                "annotation_ids": [
                  "81a7bca2532b8271"
                ],
                "status_id": 19,
                "text": "An endpoint MAY"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "81a7bca2532b8271"
                ],
                "status_id": 19,
                "text": "terminate the connection if an alternative path cannot be found."
              }
            ],
            "",
            "   Each pair of local and remote addresses could have a different PMTU.",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "e1743da042875f27"
                ],
                "status_id": 14,
                "text": "QUIC implementations that implement any kind of PMTU discovery"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "e1743da042875f27"
                ],
                "status_id": 14,
                "text": "therefore SHOULD maintain a maximum datagram size for each"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "e1743da042875f27"
                ],
                "status_id": 14,
                "text": "combination of local and remote IP addresses."
              }
            ],
            "",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "3493f26cdd4f8806"
                ],
                "status_id": 19,
                "text": "A QUIC implementation MAY be more conservative in computing the"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "3493f26cdd4f8806"
                ],
                "status_id": 19,
                "text": "maximum datagram size to allow for unknown tunnel overheads or IP"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "3493f26cdd4f8806"
                ],
                "status_id": 19,
                "text": "header options/extensions."
              }
            ]
          ],
          "requirements": [
            "cd3f6fe45abb0cbd",
            "cd3f6fe45abb0cbd",
            "cd3f6fe45abb0cbd",
            "2b7605d6acde88e5",
            "2b7605d6acde88e5",
            "2b7605d6acde88e5",
            "1a5bd900f7e8bcc0",
            "1a5bd900f7e8bcc0",
            "1a5bd900f7e8bcc0",
            "1a5bd900f7e8bcc0",
            "eff7744f4f0bb3ea",
            "eff7744f4f0bb3ea",
            "eff7744f4f0bb3ea",
            "eff7744f4f0bb3ea",
            "eff7744f4f0bb3ea",
            "81a7bca2532b8271",
            "81a7bca2532b8271",
            "e1743da042875f27",
            "e1743da042875f27",
            "e1743da042875f27",
            "3493f26cdd4f8806",
            "3493f26cdd4f8806",
            "3493f26cdd4f8806"
          ],
          "title": "Path Maximum Transmission Unit"
        },
        {
          "id": "section-14.2.1",
          "lines": [
            "   PMTUD [RFC1191] [RFC8201] relies on reception of ICMP messages (that",
            "   is, IPv6 Packet Too Big (PTB) messages) that indicate when an IP",
            "   packet is dropped because it is larger than the local router MTU.",
            "   DPLPMTUD can also optionally use these messages.  This use of ICMP",
            "   messages is potentially vulnerable to attacks by entities that cannot",
            "   observe packets but might successfully guess the addresses used on",
            "   the path.  These attacks could reduce the PMTU to a bandwidth-",
            "   inefficient value.",
            "",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "e720208760a67191",
                  "92fbed1cb9a61e8a"
                ],
                "status_id": 17,
                "text": "An endpoint MUST ignore an ICMP message that claims the PMTU has"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "e720208760a67191",
                  "92fbed1cb9a61e8a"
                ],
                "status_id": 17,
                "text": "decreased below QUIC's smallest allowed maximum datagram size."
              }
            ],
            "",
            "   The requirements for generating ICMP [RFC1812] [RFC4443] state that",
            "   the quoted packet should contain as much of the original packet as",
            "   possible without exceeding the minimum MTU for the IP version.  The",
            "   size of the quoted packet can actually be smaller, or the information",
            "   unintelligible, as described in Section 1.1 of [DPLPMTUD].",
            "",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "ed0ae0d7085e09cc",
                  "77fb50c4e403f1a0"
                ],
                "status_id": 18,
                "text": "QUIC endpoints using PMTUD SHOULD validate ICMP messages to protect"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "ed0ae0d7085e09cc",
                  "77fb50c4e403f1a0"
                ],
                "status_id": 18,
                "text": "from packet injection as specified in [RFC8201] and Section 5.2 of"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "ed0ae0d7085e09cc",
                  "77fb50c4e403f1a0"
                ],
                "status_id": 18,
                "text": "[RFC8085]."
              },
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "  "
              },
              {
                "annotation_ids": [
                  "2be0727a15be7ba4",
                  "36650dd545d6d8f9"
                ],
                "status_id": 18,
                "text": "This validation SHOULD use the quoted packet supplied in"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "2be0727a15be7ba4",
                  "36650dd545d6d8f9"
                ],
                "status_id": 18,
                "text": "the payload of an ICMP message to associate the message with a"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "2be0727a15be7ba4",
                  "36650dd545d6d8f9"
                ],
                "status_id": 18,
                "text": "corresponding transport connection (see Section 4.6.1 of [DPLPMTUD])."
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "3cdcaab36b384c41",
                  "52d8fe8c43d7a52e"
                ],
                "status_id": 17,
                "text": "ICMP message validation MUST include matching IP addresses and UDP"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "3cdcaab36b384c41",
                  "52d8fe8c43d7a52e"
                ],
                "status_id": 17,
                "text": "ports [RFC8085] and, when possible, connection IDs to an active QUIC"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "3cdcaab36b384c41",
                  "52d8fe8c43d7a52e"
                ],
                "status_id": 17,
                "text": "session."
              },
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "  "
              },
              {
                "annotation_ids": [
                  "054c4e3df5c291ff",
                  "fb3ebb8acb482d53"
                ],
                "status_id": 18,
                "text": "The endpoint SHOULD ignore all ICMP messages that fail"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "054c4e3df5c291ff",
                  "fb3ebb8acb482d53"
                ],
                "status_id": 18,
                "text": "validation."
              }
            ],
            "",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "a8dbd43cd8000e10",
                  "681b8bb874170dcc"
                ],
                "status_id": 17,
                "text": "An endpoint MUST NOT increase the PMTU based on ICMP messages; see"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "a8dbd43cd8000e10",
                  "681b8bb874170dcc"
                ],
                "status_id": 17,
                "text": "Item 6 in Section 3 of [DPLPMTUD]."
              },
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "  "
              },
              {
                "annotation_ids": [
                  "b73694dd8e37db69",
                  "d458f880a1611a92"
                ],
                "status_id": 16,
                "text": "Any reduction in QUIC's maximum"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "b73694dd8e37db69",
                  "d458f880a1611a92"
                ],
                "status_id": 16,
                "text": "datagram size in response to ICMP messages MAY be provisional until"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "b73694dd8e37db69",
                  "d458f880a1611a92"
                ],
                "status_id": 16,
                "text": "QUIC's loss detection algorithm determines that the quoted packet has"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "b73694dd8e37db69",
                  "d458f880a1611a92"
                ],
                "status_id": 16,
                "text": "actually been lost."
              }
            ]
          ],
          "requirements": [
            "92fbed1cb9a61e8a",
            "92fbed1cb9a61e8a",
            "77fb50c4e403f1a0",
            "77fb50c4e403f1a0",
            "77fb50c4e403f1a0",
            "36650dd545d6d8f9",
            "36650dd545d6d8f9",
            "36650dd545d6d8f9",
            "52d8fe8c43d7a52e",
            "52d8fe8c43d7a52e",
            "52d8fe8c43d7a52e",
            "fb3ebb8acb482d53",
            "fb3ebb8acb482d53",
            "681b8bb874170dcc",
            "681b8bb874170dcc",
            "d458f880a1611a92",
            "d458f880a1611a92",
            "d458f880a1611a92",
            "d458f880a1611a92"
          ],
          "title": "Handling of ICMP Messages by PMTUD"
        },
        {
          "id": "section-14.3",
          "lines": [
            "   DPLPMTUD [DPLPMTUD] relies on tracking loss or acknowledgment of QUIC",
            "   packets that are carried in PMTU probes.  PMTU probes for DPLPMTUD",
            "   that use the PADDING frame implement \"Probing using padding data\", as",
            "   defined in Section 4.1 of [DPLPMTUD].",
            "",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "ce50f6317934b136",
                  "7db5417fdee39a66"
                ],
                "status_id": 22,
                "text": "Endpoints SHOULD set the initial value of BASE_PLPMTU (Section 5.1 of"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "ce50f6317934b136",
                  "7db5417fdee39a66"
                ],
                "status_id": 22,
                "text": "[DPLPMTUD]) to be consistent with QUIC's smallest allowed maximum"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "ce50f6317934b136",
                  "7db5417fdee39a66"
                ],
                "status_id": 22,
                "text": "datagram size."
              },
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "  The MIN_PLPMTU is the same as the BASE_PLPMTU."
              }
            ],
            "",
            "   QUIC endpoints implementing DPLPMTUD maintain a DPLPMTUD Maximum",
            "   Packet Size (MPS) (Section 4.4 of [DPLPMTUD]) for each combination of",
            "   local and remote IP addresses.  This corresponds to the maximum",
            "   datagram size."
          ],
          "requirements": [
            "7db5417fdee39a66",
            "7db5417fdee39a66",
            "7db5417fdee39a66"
          ],
          "title": "Datagram Packetization Layer PMTU Discovery"
        },
        {
          "id": "section-14.3.1",
          "lines": [
            "   From the perspective of DPLPMTUD, QUIC is an acknowledged",
            "   Packetization Layer (PL).  A QUIC sender can therefore enter the",
            "   DPLPMTUD BASE state (Section 5.2 of [DPLPMTUD]) when the QUIC",
            "   connection handshake has been completed."
          ],
          "title": "DPLPMTUD and Initial Connectivity"
        },
        {
          "id": "section-14.3.2",
          "lines": [
            "   QUIC is an acknowledged PL; therefore, a QUIC sender does not",
            "   implement a DPLPMTUD CONFIRMATION_TIMER while in the SEARCH_COMPLETE",
            "   state; see Section 5.2 of [DPLPMTUD]."
          ],
          "title": "Validating the Network Path with DPLPMTUD"
        },
        {
          "id": "section-14.3.3",
          "lines": [
            "   An endpoint using DPLPMTUD requires the validation of any received",
            "   ICMP PTB message before using the PTB information, as defined in",
            "   Section 4.6 of [DPLPMTUD].  In addition to UDP port validation, QUIC",
            "   validates an ICMP message by using other PL information (e.g.,",
            "   validation of connection IDs in the quoted packet of any received",
            "   ICMP message).",
            "",
            "   The considerations for processing ICMP messages described in",
            "   Section 14.2.1 also apply if these messages are used by DPLPMTUD."
          ],
          "title": "Handling of ICMP Messages by DPLPMTUD"
        },
        {
          "id": "section-14.4",
          "lines": [
            "   PMTU probes are ack-eliciting packets.",
            "",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "6266fe0da1b6d52b",
                  "be3ebb92de643d8a"
                ],
                "status_id": 2,
                "text": "Endpoints could limit the content of PMTU probes to PING and PADDING"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "6266fe0da1b6d52b",
                  "be3ebb92de643d8a"
                ],
                "status_id": 2,
                "text": "frames, since packets that are larger than the current maximum"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "6266fe0da1b6d52b",
                  "be3ebb92de643d8a"
                ],
                "status_id": 2,
                "text": "datagram size are more likely to be dropped by the network."
              },
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "  "
              },
              {
                "annotation_ids": [
                  "219350f31870747c",
                  "d45397aced5a93c7",
                  "813a74249548647e",
                  "6d1cb17c91b96072",
                  "b1813910ffb33996"
                ],
                "status_id": 8,
                "text": "Loss of"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "219350f31870747c",
                  "d45397aced5a93c7",
                  "813a74249548647e",
                  "6d1cb17c91b96072",
                  "b1813910ffb33996"
                ],
                "status_id": 8,
                "text": "a QUIC packet that is carried in a PMTU probe is therefore not a"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "219350f31870747c",
                  "d45397aced5a93c7",
                  "813a74249548647e",
                  "6d1cb17c91b96072",
                  "b1813910ffb33996"
                ],
                "status_id": 8,
                "text": "reliable indication of congestion and SHOULD NOT trigger a congestion"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "219350f31870747c",
                  "d45397aced5a93c7",
                  "813a74249548647e",
                  "6d1cb17c91b96072",
                  "b1813910ffb33996"
                ],
                "status_id": 8,
                "text": "control reaction; see Item 7 in Section 3 of [DPLPMTUD]."
              },
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "  However,"
              }
            ],
            "   PMTU probes consume congestion window, which could delay subsequent",
            "   transmission by an application."
          ],
          "requirements": [
            "b1813910ffb33996",
            "b1813910ffb33996",
            "b1813910ffb33996",
            "b1813910ffb33996"
          ],
          "title": "Sending QUIC PMTU Probes"
        },
        {
          "id": "section-14.4.1",
          "lines": [
            "   Endpoints that rely on the Destination Connection ID field for",
            "   routing incoming QUIC packets are likely to require that the",
            "   connection ID be included in PMTU probes to route any resulting ICMP",
            "   messages (Section 14.2.1) back to the correct endpoint.  However,",
            "   only long header packets (Section 17.2) contain the Source Connection",
            "   ID field, and long header packets are not decrypted or acknowledged",
            "   by the peer once the handshake is complete.",
            "",
            "   One way to construct a PMTU probe is to coalesce (see Section 12.2) a",
            "   packet with a long header, such as a Handshake or 0-RTT packet",
            "   (Section 17.2), with a short header packet in a single UDP datagram.",
            "   If the resulting PMTU probe reaches the endpoint, the packet with the",
            "   long header will be ignored, but the short header packet will be",
            "   acknowledged.  If the PMTU probe causes an ICMP message to be sent,",
            "   the first part of the probe will be quoted in that message.  If the",
            "   Source Connection ID field is within the quoted portion of the probe,",
            "   that could be used for routing or validation of the ICMP message.",
            "",
            "      |  Note: The purpose of using a packet with a long header is only",
            "      |  to ensure that the quoted packet contained in the ICMP message",
            "      |  contains a Source Connection ID field.  This packet does not",
            "      |  need to be a valid packet, and it can be sent even if there is",
            "      |  no current use for packets of that type."
          ],
          "title": "PMTU Probes Containing Source Connection ID"
        },
        {
          "id": "section-15",
          "lines": [
            "   QUIC versions are identified using a 32-bit unsigned number.",
            "",
            "   The version 0x00000000 is reserved to represent version negotiation.",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "7a2445ba52a1de29"
                ],
                "status_id": 1,
                "text": "This version of the specification is identified by the number"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "7a2445ba52a1de29"
                ],
                "status_id": 1,
                "text": "0x00000001."
              }
            ],
            "",
            "   Other versions of QUIC might have different properties from this",
            "   version.  The properties of QUIC that are guaranteed to be consistent",
            "   across all versions of the protocol are described in",
            "   [QUIC-INVARIANTS].",
            "",
            "   Version 0x00000001 of QUIC uses TLS as a cryptographic handshake",
            "   protocol, as described in [QUIC-TLS].",
            "",
            "   Versions with the most significant 16 bits of the version number",
            "   cleared are reserved for use in future IETF consensus documents.",
            "",
            "   Versions that follow the pattern 0x?a?a?a?a are reserved for use in",
            "   forcing version negotiation to be exercised -- that is, any version",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   number where the low four bits of all bytes is 1010 (in binary).  "
              },
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "A"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "940c9fdf86b20935"
                ],
                "status_id": 19,
                "text": "client or server MAY advertise support for any of these reserved"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "940c9fdf86b20935"
                ],
                "status_id": 19,
                "text": "versions."
              }
            ],
            "",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "606a62f6580eecee",
                  "22e54a07e2384465"
                ],
                "status_id": 19,
                "text": "Reserved version numbers will never represent a real protocol; a"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "606a62f6580eecee",
                  "22e54a07e2384465"
                ],
                "status_id": 19,
                "text": "client MAY use one of these version numbers with the expectation that"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "606a62f6580eecee",
                  "22e54a07e2384465"
                ],
                "status_id": 19,
                "text": "the server will initiate version negotiation; a server MAY advertise"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "606a62f6580eecee",
                  "22e54a07e2384465"
                ],
                "status_id": 19,
                "text": "support for one of these versions and can expect that clients ignore"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "606a62f6580eecee",
                  "22e54a07e2384465"
                ],
                "status_id": 19,
                "text": "the value."
              }
            ]
          ],
          "requirements": [
            "940c9fdf86b20935",
            "940c9fdf86b20935",
            "940c9fdf86b20935",
            "606a62f6580eecee",
            "606a62f6580eecee",
            "606a62f6580eecee",
            "606a62f6580eecee",
            "606a62f6580eecee",
            "22e54a07e2384465",
            "22e54a07e2384465",
            "22e54a07e2384465",
            "22e54a07e2384465",
            "22e54a07e2384465"
          ],
          "title": "Versions"
        },
        {
          "id": "section-16",
          "lines": [
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "d9c58bbb53c329eb"
                ],
                "status_id": 1,
                "text": "QUIC packets and frames commonly use a variable-length encoding for"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "d9c58bbb53c329eb"
                ],
                "status_id": 1,
                "text": "non-negative integer values.  This encoding ensures that smaller"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "d9c58bbb53c329eb"
                ],
                "status_id": 1,
                "text": "integer values need fewer bytes to encode."
              }
            ],
            "",
            "   The QUIC variable-length integer encoding reserves the two most",
            "   significant bits of the first byte to encode the base-2 logarithm of",
            "   the integer encoding length in bytes.  The integer value is encoded",
            "   on the remaining bits, in network byte order.",
            "",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "1d42064b937fd4be",
                  "c12f58a9e9ef1fe1"
                ],
                "status_id": 2,
                "text": "This means that integers are encoded on 1, 2, 4, or 8 bytes and can"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "1d42064b937fd4be",
                  "c12f58a9e9ef1fe1"
                ],
                "status_id": 2,
                "text": "encode 6-, 14-, 30-, or 62-bit values, respectively.  Table 4"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "1d42064b937fd4be",
                  "c12f58a9e9ef1fe1"
                ],
                "status_id": 2,
                "text": "summarizes the encoding properties."
              }
            ],
            "",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "          "
              },
              {
                "annotation_ids": [
                  "1d42064b937fd4be",
                  "c12f58a9e9ef1fe1"
                ],
                "status_id": 2,
                "text": "+======+========+=============+=======================+"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "          "
              },
              {
                "annotation_ids": [
                  "1d42064b937fd4be",
                  "c12f58a9e9ef1fe1"
                ],
                "status_id": 2,
                "text": "| 2MSB | Length | Usable Bits | Range                 |"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "          "
              },
              {
                "annotation_ids": [
                  "1d42064b937fd4be",
                  "c12f58a9e9ef1fe1"
                ],
                "status_id": 2,
                "text": "+======+========+=============+=======================+"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "          "
              },
              {
                "annotation_ids": [
                  "1d42064b937fd4be",
                  "c12f58a9e9ef1fe1"
                ],
                "status_id": 2,
                "text": "| 00   | 1      | 6           | 0-63                  |"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "          "
              },
              {
                "annotation_ids": [
                  "1d42064b937fd4be",
                  "c12f58a9e9ef1fe1"
                ],
                "status_id": 2,
                "text": "+------+--------+-------------+-----------------------+"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "          "
              },
              {
                "annotation_ids": [
                  "1d42064b937fd4be",
                  "c12f58a9e9ef1fe1"
                ],
                "status_id": 2,
                "text": "| 01   | 2      | 14          | 0-16383               |"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "          "
              },
              {
                "annotation_ids": [
                  "1d42064b937fd4be",
                  "c12f58a9e9ef1fe1"
                ],
                "status_id": 2,
                "text": "+------+--------+-------------+-----------------------+"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "          "
              },
              {
                "annotation_ids": [
                  "1d42064b937fd4be",
                  "c12f58a9e9ef1fe1"
                ],
                "status_id": 2,
                "text": "| 10   | 4      | 30          | 0-1073741823          |"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "          "
              },
              {
                "annotation_ids": [
                  "1d42064b937fd4be",
                  "c12f58a9e9ef1fe1"
                ],
                "status_id": 2,
                "text": "+------+--------+-------------+-----------------------+"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "          "
              },
              {
                "annotation_ids": [
                  "1d42064b937fd4be",
                  "c12f58a9e9ef1fe1"
                ],
                "status_id": 2,
                "text": "| 11   | 8      | 62          | 0-4611686018427387903 |"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "          "
              },
              {
                "annotation_ids": [
                  "1d42064b937fd4be",
                  "c12f58a9e9ef1fe1"
                ],
                "status_id": 2,
                "text": "+------+--------+-------------+-----------------------+"
              }
            ],
            "",
            "                   Table 4: Summary of Integer Encodings",
            "",
            "   An example of a decoding algorithm and sample encodings are shown in",
            "   Appendix A.1.",
            "",
            "   Values do not need to be encoded on the minimum number of bytes",
            "   necessary, with the sole exception of the Frame Type field; see",
            "   Section 12.4.",
            "",
            "   Versions (Section 15), packet numbers sent in the header",
            "   (Section 17.1), and the length of connection IDs in long header",
            "   packets (Section 17.2) are described using integers but do not use",
            "   this encoding."
          ],
          "title": "Variable-Length Integer Encoding"
        },
        {
          "id": "section-17",
          "lines": [
            "   All numeric values are encoded in network byte order (that is, big",
            "   endian), and all field sizes are in bits.  Hexadecimal notation is",
            "   used for describing the value of fields."
          ],
          "title": "Packet Formats"
        },
        {
          "id": "section-17.1",
          "lines": [
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "3dfa9db26e0eb6c8"
                ],
                "status_id": 1,
                "text": "Packet numbers are integers in the range 0 to 2^62-1 (Section 12.3)."
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "3dfa9db26e0eb6c8"
                ],
                "status_id": 1,
                "text": "When present in long or short packet headers, they are encoded in 1"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "3dfa9db26e0eb6c8"
                ],
                "status_id": 1,
                "text": "to 4 bytes.  The number of bits required to represent the packet"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "3dfa9db26e0eb6c8"
                ],
                "status_id": 1,
                "text": "number is reduced by including only the least significant bits of the"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "3dfa9db26e0eb6c8"
                ],
                "status_id": 1,
                "text": "packet number."
              }
            ],
            "",
            "   The encoded packet number is protected as described in Section 5.4 of",
            "   [QUIC-TLS].",
            "",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "b7db0289e531e76c"
                ],
                "status_id": 20,
                "text": "Prior to receiving an acknowledgment for a packet number space, the"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "b7db0289e531e76c"
                ],
                "status_id": 20,
                "text": "full packet number MUST be included; it is not to be truncated, as"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "b7db0289e531e76c"
                ],
                "status_id": 20,
                "text": "described below."
              }
            ],
            "",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "1d04012921950b69"
                ],
                "status_id": 20,
                "text": "After an acknowledgment is received for a packet number space, "
              },
              {
                "annotation_ids": [
                  "18ead20c6a92bd81",
                  "1d04012921950b69"
                ],
                "status_id": 13,
                "text": "the"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "18ead20c6a92bd81",
                  "1d04012921950b69"
                ],
                "status_id": 13,
                "text": "sender MUST use a packet number size able to represent more than"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "18ead20c6a92bd81",
                  "1d04012921950b69"
                ],
                "status_id": 13,
                "text": "twice as large a range as the difference between the largest"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "18ead20c6a92bd81",
                  "1d04012921950b69"
                ],
                "status_id": 13,
                "text": "acknowledged packet number and the packet number being sent."
              },
              {
                "annotation_ids": [
                  "18ead20c6a92bd81"
                ],
                "status_id": 1,
                "text": "  A peer"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "18ead20c6a92bd81"
                ],
                "status_id": 1,
                "text": "receiving the packet will then correctly decode the packet number,"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "18ead20c6a92bd81"
                ],
                "status_id": 1,
                "text": "unless the packet is delayed in transit such that it arrives after"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "18ead20c6a92bd81"
                ],
                "status_id": 1,
                "text": "many higher-numbered packets have been received.  "
              },
              {
                "annotation_ids": [
                  "18ead20c6a92bd81",
                  "4950db9faa790a25"
                ],
                "status_id": 22,
                "text": "An endpoint SHOULD"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "18ead20c6a92bd81",
                  "4950db9faa790a25"
                ],
                "status_id": 22,
                "text": "use a large enough packet number encoding to allow the packet number"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "18ead20c6a92bd81",
                  "4950db9faa790a25"
                ],
                "status_id": 22,
                "text": "to be recovered even if the packet arrives after packets that are"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "18ead20c6a92bd81",
                  "4950db9faa790a25"
                ],
                "status_id": 22,
                "text": "sent afterwards."
              }
            ],
            "",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "c3cf1cc83fdceb22"
                ],
                "status_id": 1,
                "text": "As a result, the size of the packet number encoding is at least one"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "c3cf1cc83fdceb22"
                ],
                "status_id": 1,
                "text": "bit more than the base-2 logarithm of the number of contiguous"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "c3cf1cc83fdceb22"
                ],
                "status_id": 1,
                "text": "unacknowledged packet numbers, including the new packet."
              },
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "  Pseudocode"
              }
            ],
            "   and an example for packet number encoding can be found in",
            "   Appendix A.2.",
            "",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "708d2fe00c64a0a1"
                ],
                "status_id": 1,
                "text": "At a receiver, protection of the packet number is removed prior to"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "708d2fe00c64a0a1"
                ],
                "status_id": 1,
                "text": "recovering the full packet number.  The full packet number is then"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "708d2fe00c64a0a1"
                ],
                "status_id": 1,
                "text": "reconstructed based on the number of significant bits present, the"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "708d2fe00c64a0a1"
                ],
                "status_id": 1,
                "text": "value of those bits, and the largest packet number received in a"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "708d2fe00c64a0a1"
                ],
                "status_id": 1,
                "text": "successfully authenticated packet.  Recovering the full packet number"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "708d2fe00c64a0a1"
                ],
                "status_id": 1,
                "text": "is necessary to successfully complete the removal of packet"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "708d2fe00c64a0a1"
                ],
                "status_id": 1,
                "text": "protection."
              }
            ],
            "",
            "   Once header protection is removed, the packet number is decoded by",
            "   finding the packet number value that is closest to the next expected",
            "   packet.  The next expected packet is the highest received packet",
            "   number plus one.  Pseudocode and an example for packet number",
            "   decoding can be found in Appendix A.3."
          ],
          "requirements": [
            "b7db0289e531e76c",
            "b7db0289e531e76c",
            "b7db0289e531e76c",
            "1d04012921950b69",
            "1d04012921950b69",
            "1d04012921950b69",
            "1d04012921950b69",
            "4950db9faa790a25",
            "4950db9faa790a25",
            "4950db9faa790a25",
            "4950db9faa790a25"
          ],
          "title": "Packet Number Encoding and Decoding"
        },
        {
          "id": "section-17.2",
          "lines": [
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "d50d3997f620be7d"
                ],
                "status_id": 1,
                "text": "Long Header Packet {"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "     "
              },
              {
                "annotation_ids": [
                  "d50d3997f620be7d"
                ],
                "status_id": 1,
                "text": "Header Form (1) = 1,"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "     "
              },
              {
                "annotation_ids": [
                  "d50d3997f620be7d"
                ],
                "status_id": 1,
                "text": "Fixed Bit (1) = 1,"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "     "
              },
              {
                "annotation_ids": [
                  "d50d3997f620be7d"
                ],
                "status_id": 1,
                "text": "Long Packet Type (2),"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "     "
              },
              {
                "annotation_ids": [
                  "d50d3997f620be7d"
                ],
                "status_id": 1,
                "text": "Type-Specific Bits (4),"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "     "
              },
              {
                "annotation_ids": [
                  "d50d3997f620be7d"
                ],
                "status_id": 1,
                "text": "Version (32),"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "     "
              },
              {
                "annotation_ids": [
                  "d50d3997f620be7d"
                ],
                "status_id": 1,
                "text": "Destination Connection ID Length (8),"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "     "
              },
              {
                "annotation_ids": [
                  "d50d3997f620be7d"
                ],
                "status_id": 1,
                "text": "Destination Connection ID (0..160),"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "     "
              },
              {
                "annotation_ids": [
                  "d50d3997f620be7d"
                ],
                "status_id": 1,
                "text": "Source Connection ID Length (8),"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "     "
              },
              {
                "annotation_ids": [
                  "d50d3997f620be7d"
                ],
                "status_id": 1,
                "text": "Source Connection ID (0..160),"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "     "
              },
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "Type-Specific Payload (..),"
              }
            ],
            "   }",
            "",
            "                    Figure 13: Long Header Packet Format",
            "",
            "   Long headers are used for packets that are sent prior to the",
            "   establishment of 1-RTT keys.  Once 1-RTT keys are available, a sender",
            "   switches to sending packets using the short header (Section 17.3).",
            "   The long form allows for special packets -- such as the Version",
            "   Negotiation packet -- to be represented in this uniform fixed-length",
            "   packet format.  Packets that use the long header contain the",
            "   following fields:",
            "",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "a4bf6e2f9fb43bfb"
                ],
                "status_id": 1,
                "text": "Header Form:  The most significant bit (0x80) of byte 0 (the first"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "      "
              },
              {
                "annotation_ids": [
                  "a4bf6e2f9fb43bfb"
                ],
                "status_id": 1,
                "text": "byte) is set to 1 for long headers."
              }
            ],
            "",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "d4084818ce02b1df"
                ],
                "status_id": 1,
                "text": "Fixed Bit:  The next bit (0x40) of byte 0 is set to 1,"
              },
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": " unless the"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "      packet is a Version Negotiation packet.  "
              },
              {
                "annotation_ids": [
                  "eda972c6e9080d51"
                ],
                "status_id": 20,
                "text": "Packets containing a zero"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "      "
              },
              {
                "annotation_ids": [
                  "eda972c6e9080d51"
                ],
                "status_id": 20,
                "text": "value for this bit are not valid packets in this version and MUST"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "      "
              },
              {
                "annotation_ids": [
                  "eda972c6e9080d51"
                ],
                "status_id": 20,
                "text": "be discarded."
              },
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "  A value of 1 for this bit allows QUIC to coexist"
              }
            ],
            "      with other protocols; see [RFC7983].",
            "",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "ba3480caf1708b63"
                ],
                "status_id": 1,
                "text": "Long Packet Type:  The next two bits (those with a mask of 0x30) of"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "      "
              },
              {
                "annotation_ids": [
                  "ba3480caf1708b63"
                ],
                "status_id": 1,
                "text": "byte 0 contain a packet type.  Packet types are listed in Table 5."
              }
            ],
            "",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "92f7b92b5efdfdac"
                ],
                "status_id": 1,
                "text": "Type-Specific Bits:  The semantics of the lower four bits (those with"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "      "
              },
              {
                "annotation_ids": [
                  "92f7b92b5efdfdac"
                ],
                "status_id": 1,
                "text": "a mask of 0x0f) of byte 0 are determined by the packet type."
              }
            ],
            "",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "03765b0b07cacc70"
                ],
                "status_id": 1,
                "text": "Version:  The QUIC Version is a 32-bit field that follows the first"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "      "
              },
              {
                "annotation_ids": [
                  "03765b0b07cacc70"
                ],
                "status_id": 1,
                "text": "byte.  This field indicates the version of QUIC that is in use and"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "      "
              },
              {
                "annotation_ids": [
                  "03765b0b07cacc70"
                ],
                "status_id": 1,
                "text": "determines how the rest of the protocol fields are interpreted."
              }
            ],
            "",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "e3b6e6795ee671ba"
                ],
                "status_id": 1,
                "text": "Destination Connection ID Length:  The byte following the version"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "      "
              },
              {
                "annotation_ids": [
                  "e3b6e6795ee671ba"
                ],
                "status_id": 1,
                "text": "contains the length in bytes of the Destination Connection ID"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "      "
              },
              {
                "annotation_ids": [
                  "e3b6e6795ee671ba"
                ],
                "status_id": 1,
                "text": "field that follows it.  This length is encoded as an 8-bit"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "      "
              },
              {
                "annotation_ids": [
                  "e3b6e6795ee671ba"
                ],
                "status_id": 1,
                "text": "unsigned integer.  "
              },
              {
                "annotation_ids": [
                  "e3b6e6795ee671ba",
                  "7c31be37ed24b7ba",
                  "e63ee70e7d857272"
                ],
                "status_id": 13,
                "text": "In QUIC version 1, this value MUST NOT exceed"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "      "
              },
              {
                "annotation_ids": [
                  "e3b6e6795ee671ba",
                  "7c31be37ed24b7ba",
                  "e63ee70e7d857272"
                ],
                "status_id": 13,
                "text": "20"
              },
              {
                "annotation_ids": [
                  "7c31be37ed24b7ba",
                  "e63ee70e7d857272"
                ],
                "status_id": 20,
                "text": " bytes."
              },
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "  "
              },
              {
                "annotation_ids": [
                  "9a836fc548e1b87c",
                  "8136b9581c6007cd",
                  "c785418efd77a9be",
                  "ce76977a92045f60",
                  "03c6fa72b69596c4",
                  "db442ee8bfbf7636",
                  "fd8f469451e48c1e",
                  "2680f24e55c07ebe"
                ],
                "status_id": 13,
                "text": "Endpoints that receive a version 1 long header with a"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "      "
              },
              {
                "annotation_ids": [
                  "9a836fc548e1b87c",
                  "8136b9581c6007cd",
                  "c785418efd77a9be",
                  "ce76977a92045f60",
                  "03c6fa72b69596c4",
                  "db442ee8bfbf7636",
                  "fd8f469451e48c1e",
                  "2680f24e55c07ebe"
                ],
                "status_id": 13,
                "text": "value larger than 20 MUST drop the packet."
              },
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "  "
              },
              {
                "annotation_ids": [
                  "a2b8a77dcac3dbfc",
                  "8cf958d23f7e3cdd",
                  "dd2fdc039d73d9da"
                ],
                "status_id": 22,
                "text": "In order to properly"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "      "
              },
              {
                "annotation_ids": [
                  "a2b8a77dcac3dbfc",
                  "8cf958d23f7e3cdd",
                  "dd2fdc039d73d9da"
                ],
                "status_id": 22,
                "text": "form a Version Negotiation packet, servers SHOULD be able to read"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "      "
              },
              {
                "annotation_ids": [
                  "a2b8a77dcac3dbfc",
                  "8cf958d23f7e3cdd",
                  "dd2fdc039d73d9da"
                ],
                "status_id": 22,
                "text": "longer connection IDs from other QUIC versions."
              }
            ],
            "",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "7c89a05acc3afd6b"
                ],
                "status_id": 1,
                "text": "Destination Connection ID:  The Destination Connection ID field"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "      "
              },
              {
                "annotation_ids": [
                  "7c89a05acc3afd6b"
                ],
                "status_id": 1,
                "text": "follows the Destination Connection ID Length field, which"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "      "
              },
              {
                "annotation_ids": [
                  "7c89a05acc3afd6b"
                ],
                "status_id": 1,
                "text": "indicates the length of this field.  Section 7.2 describes the use"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "      "
              },
              {
                "annotation_ids": [
                  "7c89a05acc3afd6b"
                ],
                "status_id": 1,
                "text": "of this field in more detail."
              }
            ],
            "",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "556d45bf71d7ec8c"
                ],
                "status_id": 1,
                "text": "Source Connection ID Length:  The byte following the Destination"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "      "
              },
              {
                "annotation_ids": [
                  "556d45bf71d7ec8c"
                ],
                "status_id": 1,
                "text": "Connection ID contains the length in bytes of the Source"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "      "
              },
              {
                "annotation_ids": [
                  "556d45bf71d7ec8c"
                ],
                "status_id": 1,
                "text": "Connection ID field that follows it.  This length is encoded as an"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "      "
              },
              {
                "annotation_ids": [
                  "556d45bf71d7ec8c"
                ],
                "status_id": 1,
                "text": "8-bit unsigned integer.  In QUIC version 1, this value MUST NOT"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "      "
              },
              {
                "annotation_ids": [
                  "556d45bf71d7ec8c"
                ],
                "status_id": 1,
                "text": "exceed 20 bytes."
              },
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "  Endpoints that receive a version 1 long header"
              }
            ],
            "      with a value larger than 20 MUST drop the packet.  In order to",
            "      properly form a Version Negotiation packet, servers SHOULD be able",
            "      to read longer connection IDs from other QUIC versions.",
            "",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "0a1dac283102149f"
                ],
                "status_id": 1,
                "text": "Source Connection ID:  The Source Connection ID field follows the"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "      "
              },
              {
                "annotation_ids": [
                  "0a1dac283102149f"
                ],
                "status_id": 1,
                "text": "Source Connection ID Length field, which indicates the length of"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "      "
              },
              {
                "annotation_ids": [
                  "0a1dac283102149f"
                ],
                "status_id": 1,
                "text": "this field.  Section 7.2 describes the use of this field in more"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "      "
              },
              {
                "annotation_ids": [
                  "0a1dac283102149f"
                ],
                "status_id": 1,
                "text": "detail."
              }
            ],
            "",
            "   Type-Specific Payload:  The remainder of the packet, if any, is type",
            "      specific.",
            "",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "bf473f570e00a03d"
                ],
                "status_id": 1,
                "text": "In this version of QUIC, the following packet types with the long"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "bf473f570e00a03d"
                ],
                "status_id": 1,
                "text": "header are defined:"
              }
            ],
            "",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "                   "
              },
              {
                "annotation_ids": [
                  "bf473f570e00a03d"
                ],
                "status_id": 1,
                "text": "+======+===========+================+"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "                   "
              },
              {
                "annotation_ids": [
                  "bf473f570e00a03d"
                ],
                "status_id": 1,
                "text": "| Type | Name      | Section        |"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "                   "
              },
              {
                "annotation_ids": [
                  "bf473f570e00a03d"
                ],
                "status_id": 1,
                "text": "+======+===========+================+"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "                   "
              },
              {
                "annotation_ids": [
                  "bf473f570e00a03d"
                ],
                "status_id": 1,
                "text": "| 0x00 | Initial   | Section 17.2.2 |"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "                   "
              },
              {
                "annotation_ids": [
                  "bf473f570e00a03d"
                ],
                "status_id": 1,
                "text": "+------+-----------+----------------+"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "                   "
              },
              {
                "annotation_ids": [
                  "bf473f570e00a03d"
                ],
                "status_id": 1,
                "text": "| 0x01 | 0-RTT     | Section 17.2.3 |"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "                   "
              },
              {
                "annotation_ids": [
                  "bf473f570e00a03d"
                ],
                "status_id": 1,
                "text": "+------+-----------+----------------+"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "                   "
              },
              {
                "annotation_ids": [
                  "bf473f570e00a03d"
                ],
                "status_id": 1,
                "text": "| 0x02 | Handshake | Section 17.2.4 |"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "                   "
              },
              {
                "annotation_ids": [
                  "bf473f570e00a03d"
                ],
                "status_id": 1,
                "text": "+------+-----------+----------------+"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "                   "
              },
              {
                "annotation_ids": [
                  "bf473f570e00a03d"
                ],
                "status_id": 1,
                "text": "| 0x03 | Retry     | Section 17.2.5 |"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "                   "
              },
              {
                "annotation_ids": [
                  "bf473f570e00a03d"
                ],
                "status_id": 1,
                "text": "+------+-----------+----------------+"
              }
            ],
            "",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "                     "
              },
              {
                "annotation_ids": [
                  "bf473f570e00a03d"
                ],
                "status_id": 1,
                "text": "Table 5: Long Header Packet Types"
              }
            ],
            "",
            "   The header form bit, Destination and Source Connection ID lengths,",
            "   Destination and Source Connection ID fields, and Version fields of a",
            "   long header packet are version independent.  The other fields in the",
            "   first byte are version specific.  See [QUIC-INVARIANTS] for details",
            "   on how packets from different versions of QUIC are interpreted.",
            "",
            "   The interpretation of the fields and the payload are specific to a",
            "   version and packet type.  While type-specific semantics for this",
            "   version are described in the following sections, several long header",
            "   packets in this version of QUIC contain these additional fields:",
            "",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "e7946fa448e653da"
                ],
                "status_id": 1,
                "text": "Reserved Bits:  Two bits (those with a mask of 0x0c) of byte 0 are"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "      "
              },
              {
                "annotation_ids": [
                  "e7946fa448e653da"
                ],
                "status_id": 1,
                "text": "reserved across multiple packet types.  These bits are protected"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "      "
              },
              {
                "annotation_ids": [
                  "e7946fa448e653da"
                ],
                "status_id": 1,
                "text": "using header protection; see Section 5.4 of [QUIC-TLS]."
              },
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "  "
              },
              {
                "annotation_ids": [
                  "50e0153302d7b9d6",
                  "7cdea2ae79ca2372"
                ],
                "status_id": 13,
                "text": "The value"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "      "
              },
              {
                "annotation_ids": [
                  "50e0153302d7b9d6",
                  "7cdea2ae79ca2372"
                ],
                "status_id": 13,
                "text": "included prior to protection MUST be set to 0."
              },
              {
                "annotation_ids": [
                  "50e0153302d7b9d6"
                ],
                "status_id": 1,
                "text": "  "
              },
              {
                "annotation_ids": [
                  "50e0153302d7b9d6",
                  "bd20adee52052fbe"
                ],
                "status_id": 13,
                "text": "An endpoint MUST"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "      "
              },
              {
                "annotation_ids": [
                  "50e0153302d7b9d6",
                  "bd20adee52052fbe"
                ],
                "status_id": 13,
                "text": "treat receipt of a packet that has a non-zero value for these bits"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "      "
              },
              {
                "annotation_ids": [
                  "50e0153302d7b9d6",
                  "bd20adee52052fbe"
                ],
                "status_id": 13,
                "text": "after removing both packet and header protection as a connection"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "      "
              },
              {
                "annotation_ids": [
                  "50e0153302d7b9d6",
                  "bd20adee52052fbe"
                ],
                "status_id": 13,
                "text": "error of type PROTOCOL_VIOLATION."
              },
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "  Discarding such a packet after"
              }
            ],
            "      only removing header protection can expose the endpoint to",
            "      attacks; see Section 9.5 of [QUIC-TLS].",
            "",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "b27bba68ccb8b854"
                ],
                "status_id": 1,
                "text": "Packet Number Length:  In packet types that contain a Packet Number"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "      "
              },
              {
                "annotation_ids": [
                  "b27bba68ccb8b854"
                ],
                "status_id": 1,
                "text": "field, the least significant two bits (those with a mask of 0x03)"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "      "
              },
              {
                "annotation_ids": [
                  "b27bba68ccb8b854"
                ],
                "status_id": 1,
                "text": "of byte 0 contain the length of the Packet Number field, encoded"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "      "
              },
              {
                "annotation_ids": [
                  "b27bba68ccb8b854"
                ],
                "status_id": 1,
                "text": "as an unsigned two-bit integer that is one less than the length of"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "      "
              },
              {
                "annotation_ids": [
                  "b27bba68ccb8b854"
                ],
                "status_id": 1,
                "text": "the Packet Number field in bytes."
              },
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "  That is, the length of the"
              }
            ],
            "      Packet Number field is the value of this field plus one.  These",
            "      bits are protected using header protection; see Section 5.4 of",
            "      [QUIC-TLS].",
            "",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "9c3734fe571acba4"
                ],
                "status_id": 1,
                "text": "Length:  This is the length of the remainder of the packet (that is,"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "      "
              },
              {
                "annotation_ids": [
                  "9c3734fe571acba4"
                ],
                "status_id": 1,
                "text": "the Packet Number and Payload fields) in bytes, encoded as a"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "      "
              },
              {
                "annotation_ids": [
                  "9c3734fe571acba4"
                ],
                "status_id": 1,
                "text": "variable-length integer (Section 16)."
              }
            ],
            "",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "50f4b4044ca1a2da"
                ],
                "status_id": 1,
                "text": "Packet Number:  This field is 1 to 4 bytes long.  The packet number"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "      "
              },
              {
                "annotation_ids": [
                  "50f4b4044ca1a2da"
                ],
                "status_id": 1,
                "text": "is protected using header protection; see Section 5.4 of"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "      "
              },
              {
                "annotation_ids": [
                  "50f4b4044ca1a2da"
                ],
                "status_id": 1,
                "text": "[QUIC-TLS].  The length of the Packet Number field is encoded in"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "      "
              },
              {
                "annotation_ids": [
                  "50f4b4044ca1a2da"
                ],
                "status_id": 1,
                "text": "the Packet Number Length bits of byte 0; see above."
              }
            ],
            "",
            "   Packet Payload:  This is the payload of the packet -- containing a",
            "      sequence of frames -- that is protected using packet protection."
          ],
          "requirements": [
            "eda972c6e9080d51",
            "eda972c6e9080d51",
            "eda972c6e9080d51",
            "7c31be37ed24b7ba",
            "7c31be37ed24b7ba",
            "fd8f469451e48c1e",
            "fd8f469451e48c1e",
            "8cf958d23f7e3cdd",
            "8cf958d23f7e3cdd",
            "8cf958d23f7e3cdd",
            "e63ee70e7d857272",
            "e63ee70e7d857272",
            "2680f24e55c07ebe",
            "2680f24e55c07ebe",
            "dd2fdc039d73d9da",
            "dd2fdc039d73d9da",
            "dd2fdc039d73d9da",
            "7cdea2ae79ca2372",
            "7cdea2ae79ca2372",
            "bd20adee52052fbe",
            "bd20adee52052fbe",
            "bd20adee52052fbe",
            "bd20adee52052fbe"
          ],
          "title": "Long Header Packets"
        },
        {
          "id": "section-17.2.1",
          "lines": [
            "   A Version Negotiation packet is inherently not version specific.",
            "   Upon receipt by a client, it will be identified as a Version",
            "   Negotiation packet based on the Version field having a value of 0.",
            "",
            "   The Version Negotiation packet is a response to a client packet that",
            "   contains a version that is not supported by the server.  It is only",
            "   sent by servers.",
            "",
            "   The layout of a Version Negotiation packet is:",
            "",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "4123fc4d3937faa5"
                ],
                "status_id": 1,
                "text": "Version Negotiation Packet {"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "     "
              },
              {
                "annotation_ids": [
                  "4123fc4d3937faa5"
                ],
                "status_id": 1,
                "text": "Header Form (1) = 1,"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "     "
              },
              {
                "annotation_ids": [
                  "4123fc4d3937faa5"
                ],
                "status_id": 1,
                "text": "Unused (7),"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "     "
              },
              {
                "annotation_ids": [
                  "4123fc4d3937faa5"
                ],
                "status_id": 1,
                "text": "Version (32) = 0,"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "     "
              },
              {
                "annotation_ids": [
                  "4123fc4d3937faa5"
                ],
                "status_id": 1,
                "text": "Destination Connection ID Length (8),"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "     "
              },
              {
                "annotation_ids": [
                  "4123fc4d3937faa5"
                ],
                "status_id": 1,
                "text": "Destination Connection ID (0..2040),"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "     "
              },
              {
                "annotation_ids": [
                  "4123fc4d3937faa5"
                ],
                "status_id": 1,
                "text": "Source Connection ID Length (8),"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "     "
              },
              {
                "annotation_ids": [
                  "4123fc4d3937faa5"
                ],
                "status_id": 1,
                "text": "Source Connection ID (0..2040),"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "     "
              },
              {
                "annotation_ids": [
                  "4123fc4d3937faa5"
                ],
                "status_id": 1,
                "text": "Supported Version (32) ...,"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "}"
              }
            ],
            "",
            "                   Figure 14: Version Negotiation Packet",
            "",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "f7059964fc2481b3"
                ],
                "status_id": 1,
                "text": "The value in the Unused field is set to an arbitrary value by the"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "f7059964fc2481b3"
                ],
                "status_id": 1,
                "text": "server.  "
              },
              {
                "annotation_ids": [
                  "f7059964fc2481b3",
                  "53cf34f256293c7c"
                ],
                "status_id": 13,
                "text": "Clients MUST ignore the value of this field."
              },
              {
                "annotation_ids": [
                  "f7059964fc2481b3"
                ],
                "status_id": 1,
                "text": "  "
              },
              {
                "annotation_ids": [
                  "f7059964fc2481b3",
                  "68995a51b8e3322e"
                ],
                "status_id": 22,
                "text": "Where QUIC"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "f7059964fc2481b3",
                  "68995a51b8e3322e"
                ],
                "status_id": 22,
                "text": "might be multiplexed with other protocols (see [RFC7983]), servers"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "f7059964fc2481b3",
                  "68995a51b8e3322e"
                ],
                "status_id": 22,
                "text": "SHOULD set the most significant bit of this field (0x40) to 1 so that"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "f7059964fc2481b3",
                  "68995a51b8e3322e"
                ],
                "status_id": 22,
                "text": "Version Negotiation packets appear to have the Fixed Bit field."
              },
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "  Note"
              }
            ],
            "   that other versions of QUIC might not make a similar recommendation.",
            "",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "5f88a1f9963c436f",
                  "21fc6e16ad3f6684"
                ],
                "status_id": 13,
                "text": "The Version field of a Version Negotiation packet MUST be set to"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "5f88a1f9963c436f",
                  "21fc6e16ad3f6684"
                ],
                "status_id": 13,
                "text": "0x00000000."
              }
            ],
            "",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "efa3b0e579fd0276",
                  "bd2f795259e48b7c"
                ],
                "status_id": 13,
                "text": "The server MUST include the value from the Source Connection ID field"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "efa3b0e579fd0276",
                  "bd2f795259e48b7c"
                ],
                "status_id": 13,
                "text": "of the packet it receives in the Destination Connection ID field."
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "09e7649550eb558a",
                  "f8773f72f2ef9b77"
                ],
                "status_id": 13,
                "text": "The value for Source Connection ID MUST be copied from the"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "09e7649550eb558a",
                  "f8773f72f2ef9b77"
                ],
                "status_id": 13,
                "text": "Destination Connection ID of the received packet, which is initially"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "09e7649550eb558a",
                  "f8773f72f2ef9b77"
                ],
                "status_id": 13,
                "text": "randomly selected by a client."
              },
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "  Echoing both connection IDs gives"
              }
            ],
            "   clients some assurance that the server received the packet and that",
            "   the Version Negotiation packet was not generated by an entity that",
            "   did not observe the Initial packet.",
            "",
            "   Future versions of QUIC could have different requirements for the",
            "   lengths of connection IDs.  In particular, connection IDs might have",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   a smaller minimum length or a greater maximum length.  "
              },
              {
                "annotation_ids": [
                  "a39b31f347560ea9"
                ],
                "status_id": 20,
                "text": "Version-"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "a39b31f347560ea9"
                ],
                "status_id": 20,
                "text": "specific rules for the connection ID therefore MUST NOT influence a"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "a39b31f347560ea9"
                ],
                "status_id": 20,
                "text": "decision about whether to send a Version Negotiation packet."
              }
            ],
            "",
            "   The remainder of the Version Negotiation packet is a list of 32-bit",
            "   versions that the server supports.",
            "",
            "   A Version Negotiation packet is not acknowledged.  It is only sent in",
            "   response to a packet that indicates an unsupported version; see",
            "   Section 5.2.2.",
            "",
            "   The Version Negotiation packet does not include the Packet Number and",
            "   Length fields present in other packets that use the long header form.",
            "   Consequently, a Version Negotiation packet consumes an entire UDP",
            "   datagram.",
            "",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "0bb0e9a87b01eca8"
                ],
                "status_id": 20,
                "text": "A server MUST NOT send more than one Version Negotiation packet in"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "0bb0e9a87b01eca8"
                ],
                "status_id": 20,
                "text": "response to a single UDP datagram."
              }
            ],
            "",
            "   See Section 6 for a description of the version negotiation process."
          ],
          "requirements": [
            "53cf34f256293c7c",
            "68995a51b8e3322e",
            "68995a51b8e3322e",
            "68995a51b8e3322e",
            "68995a51b8e3322e",
            "21fc6e16ad3f6684",
            "21fc6e16ad3f6684",
            "bd2f795259e48b7c",
            "bd2f795259e48b7c",
            "f8773f72f2ef9b77",
            "f8773f72f2ef9b77",
            "f8773f72f2ef9b77",
            "a39b31f347560ea9",
            "a39b31f347560ea9",
            "a39b31f347560ea9",
            "0bb0e9a87b01eca8",
            "0bb0e9a87b01eca8"
          ],
          "title": "Version Negotiation Packet"
        },
        {
          "id": "section-17.2.2",
          "lines": [
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "a24804225b0b8cda"
                ],
                "status_id": 1,
                "text": "An Initial packet uses long headers with a type value of 0x00."
              },
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "  It"
              }
            ],
            "   carries the first CRYPTO frames sent by the client and server to",
            "   perform key exchange, and it carries ACK frames in either direction.",
            "",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "d40c7d7aa70edc19"
                ],
                "status_id": 1,
                "text": "Initial Packet {"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "     "
              },
              {
                "annotation_ids": [
                  "d40c7d7aa70edc19"
                ],
                "status_id": 1,
                "text": "Header Form (1) = 1,"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "     "
              },
              {
                "annotation_ids": [
                  "d40c7d7aa70edc19"
                ],
                "status_id": 1,
                "text": "Fixed Bit (1) = 1,"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "     "
              },
              {
                "annotation_ids": [
                  "d40c7d7aa70edc19"
                ],
                "status_id": 1,
                "text": "Long Packet Type (2) = 0,"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "     "
              },
              {
                "annotation_ids": [
                  "d40c7d7aa70edc19"
                ],
                "status_id": 1,
                "text": "Reserved Bits (2),"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "     "
              },
              {
                "annotation_ids": [
                  "d40c7d7aa70edc19"
                ],
                "status_id": 1,
                "text": "Packet Number Length (2),"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "     "
              },
              {
                "annotation_ids": [
                  "d40c7d7aa70edc19"
                ],
                "status_id": 1,
                "text": "Version (32),"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "     "
              },
              {
                "annotation_ids": [
                  "d40c7d7aa70edc19"
                ],
                "status_id": 1,
                "text": "Destination Connection ID Length (8),"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "     "
              },
              {
                "annotation_ids": [
                  "d40c7d7aa70edc19"
                ],
                "status_id": 1,
                "text": "Destination Connection ID (0..160),"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "     "
              },
              {
                "annotation_ids": [
                  "d40c7d7aa70edc19"
                ],
                "status_id": 1,
                "text": "Source Connection ID Length (8),"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "     "
              },
              {
                "annotation_ids": [
                  "d40c7d7aa70edc19"
                ],
                "status_id": 1,
                "text": "Source Connection ID (0..160),"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "     "
              },
              {
                "annotation_ids": [
                  "d40c7d7aa70edc19"
                ],
                "status_id": 1,
                "text": "Token Length (i),"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "     "
              },
              {
                "annotation_ids": [
                  "d40c7d7aa70edc19"
                ],
                "status_id": 1,
                "text": "Token (..),"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "     "
              },
              {
                "annotation_ids": [
                  "d40c7d7aa70edc19"
                ],
                "status_id": 1,
                "text": "Length (i),"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "     "
              },
              {
                "annotation_ids": [
                  "d40c7d7aa70edc19"
                ],
                "status_id": 1,
                "text": "Packet Number (8..32),"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "     "
              },
              {
                "annotation_ids": [
                  "d40c7d7aa70edc19"
                ],
                "status_id": 1,
                "text": "Packet Payload (8..),"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "}"
              }
            ],
            "",
            "                         Figure 15: Initial Packet",
            "",
            "   The Initial packet contains a long header as well as the Length and",
            "   Packet Number fields; see Section 17.2.  The first byte contains the",
            "   Reserved and Packet Number Length bits; see also Section 17.2.",
            "   Between the Source Connection ID and Length fields, there are two",
            "   additional fields specific to the Initial packet.",
            "",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "423e6c0bbdbc0b2f"
                ],
                "status_id": 1,
                "text": "Token Length:  A variable-length integer specifying the length of the"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "      "
              },
              {
                "annotation_ids": [
                  "423e6c0bbdbc0b2f"
                ],
                "status_id": 1,
                "text": "Token field, in bytes.  This value is 0 if no token is present."
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "      "
              },
              {
                "annotation_ids": [
                  "cded1b19c48bebd5",
                  "9e8414e5b278cf98",
                  "99462de191887864"
                ],
                "status_id": 13,
                "text": "Initial packets sent by the server MUST set the Token Length field"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "      "
              },
              {
                "annotation_ids": [
                  "cded1b19c48bebd5",
                  "9e8414e5b278cf98",
                  "99462de191887864"
                ],
                "status_id": 13,
                "text": "to 0; clients that receive an Initial packet with a non-zero Token"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "      "
              },
              {
                "annotation_ids": [
                  "cded1b19c48bebd5",
                  "9e8414e5b278cf98",
                  "99462de191887864"
                ],
                "status_id": 13,
                "text": "Length field MUST either discard the packet or generate a"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "      "
              },
              {
                "annotation_ids": [
                  "cded1b19c48bebd5",
                  "9e8414e5b278cf98",
                  "99462de191887864"
                ],
                "status_id": 13,
                "text": "connection error of type PROTOCOL_VIOLATION."
              }
            ],
            "",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "fe9122445e9e69f3"
                ],
                "status_id": 1,
                "text": "Token:  The value of the token that was previously provided in a"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "      "
              },
              {
                "annotation_ids": [
                  "fe9122445e9e69f3"
                ],
                "status_id": 1,
                "text": "Retry packet or NEW_TOKEN frame; see Section 8.1."
              }
            ],
            "",
            "   In order to prevent tampering by version-unaware middleboxes, Initial",
            "   packets are protected with connection- and version-specific keys",
            "   (Initial keys) as described in [QUIC-TLS].  This protection does not",
            "   provide confidentiality or integrity against attackers that can",
            "   observe packets, but it does prevent attackers that cannot observe",
            "   packets from spoofing Initial packets.",
            "",
            "   The client and server use the Initial packet type for any packet that",
            "   contains an initial cryptographic handshake message.  This includes",
            "   all cases where a new packet containing the initial cryptographic",
            "   message needs to be created, such as the packets sent after receiving",
            "   a Retry packet; see Section 17.2.5.",
            "",
            "   A server sends its first Initial packet in response to a client",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   Initial.  "
              },
              {
                "annotation_ids": [
                  "48be3420319a4537"
                ],
                "status_id": 19,
                "text": "A server MAY send multiple Initial packets."
              },
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "  The"
              }
            ],
            "   cryptographic key exchange could require multiple round trips or",
            "   retransmissions of this data.",
            "",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "847223e87e93d050"
                ],
                "status_id": 1,
                "text": "The payload of an Initial packet includes a CRYPTO frame (or frames)"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "847223e87e93d050"
                ],
                "status_id": 1,
                "text": "containing a cryptographic handshake message, ACK frames, or both."
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "847223e87e93d050"
                ],
                "status_id": 1,
                "text": "PING, PADDING, and "
              },
              {
                "annotation_ids": [
                  "847223e87e93d050",
                  "51272c9d0f5a5518"
                ],
                "status_id": 1,
                "text": "CONNECTION_CLOSE frames of type 0x1c are also"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "847223e87e93d050",
                  "51272c9d0f5a5518"
                ],
                "status_id": 1,
                "text": "permitted."
              },
              {
                "annotation_ids": [
                  "847223e87e93d050"
                ],
                "status_id": 1,
                "text": "  An endpoint that receives an Initial packet containing"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "847223e87e93d050"
                ],
                "status_id": 1,
                "text": "other frames can either discard the packet as spurious or treat it as"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "847223e87e93d050"
                ],
                "status_id": 1,
                "text": "a connection error."
              }
            ],
            "",
            "   The first packet sent by a client always includes a CRYPTO frame that",
            "   contains the start or all of the first cryptographic handshake",
            "   message.  The first CRYPTO frame sent always begins at an offset of",
            "   0; see Section 7.",
            "",
            "   Note that if the server sends a TLS HelloRetryRequest (see",
            "   Section 4.7 of [QUIC-TLS]), the client will send another series of",
            "   Initial packets.  These Initial packets will continue the",
            "   cryptographic handshake and will contain CRYPTO frames starting at an",
            "   offset matching the size of the CRYPTO frames sent in the first",
            "   flight of Initial packets."
          ],
          "requirements": [
            "9e8414e5b278cf98",
            "9e8414e5b278cf98",
            "9e8414e5b278cf98",
            "9e8414e5b278cf98",
            "99462de191887864",
            "99462de191887864",
            "99462de191887864",
            "99462de191887864",
            "48be3420319a4537"
          ],
          "title": "Initial Packet"
        },
        {
          "id": "section-17.2.2.1",
          "lines": [
            "   A client stops both sending and processing Initial packets when it",
            "   sends its first Handshake packet.  A server stops sending and",
            "   processing Initial packets when it receives its first Handshake",
            "   packet.  Though packets might still be in flight or awaiting",
            "   acknowledgment, no further Initial packets need to be exchanged",
            "   beyond this point.  Initial packet protection keys are discarded (see",
            "   Section 4.9.1 of [QUIC-TLS]) along with any loss recovery and",
            "   congestion control state; see Section 6.4 of [QUIC-RECOVERY].",
            "",
            "   Any data in CRYPTO frames is discarded -- and no longer retransmitted",
            "   -- when Initial keys are discarded."
          ],
          "title": "Abandoning Initial Packets"
        },
        {
          "id": "section-17.2.3",
          "lines": [
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "d7e89e7e61c1cd9b"
                ],
                "status_id": 1,
                "text": "A 0-RTT packet uses long headers with a type value of 0x01,"
              },
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": " followed"
              }
            ],
            "   by the Length and Packet Number fields; see Section 17.2.  The first",
            "   byte contains the Reserved and Packet Number Length bits; see",
            "   Section 17.2.  A 0-RTT packet is used to carry \"early\" data from the",
            "   client to the server as part of the first flight, prior to handshake",
            "   completion.  As part of the TLS handshake, the server can accept or",
            "   reject this early data.",
            "",
            "   See Section 2.3 of [TLS13] for a discussion of 0-RTT data and its",
            "   limitations.",
            "",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "d7233a5d9a5e1c62"
                ],
                "status_id": 1,
                "text": "0-RTT Packet {"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "     "
              },
              {
                "annotation_ids": [
                  "d7233a5d9a5e1c62"
                ],
                "status_id": 1,
                "text": "Header Form (1) = 1,"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "     "
              },
              {
                "annotation_ids": [
                  "d7233a5d9a5e1c62"
                ],
                "status_id": 1,
                "text": "Fixed Bit (1) = 1,"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "     "
              },
              {
                "annotation_ids": [
                  "d7233a5d9a5e1c62"
                ],
                "status_id": 1,
                "text": "Long Packet Type (2) = 1,"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "     "
              },
              {
                "annotation_ids": [
                  "d7233a5d9a5e1c62"
                ],
                "status_id": 1,
                "text": "Reserved Bits (2),"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "     "
              },
              {
                "annotation_ids": [
                  "d7233a5d9a5e1c62"
                ],
                "status_id": 1,
                "text": "Packet Number Length (2),"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "     "
              },
              {
                "annotation_ids": [
                  "d7233a5d9a5e1c62"
                ],
                "status_id": 1,
                "text": "Version (32),"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "     "
              },
              {
                "annotation_ids": [
                  "d7233a5d9a5e1c62"
                ],
                "status_id": 1,
                "text": "Destination Connection ID Length (8),"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "     "
              },
              {
                "annotation_ids": [
                  "d7233a5d9a5e1c62"
                ],
                "status_id": 1,
                "text": "Destination Connection ID (0..160),"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "     "
              },
              {
                "annotation_ids": [
                  "d7233a5d9a5e1c62"
                ],
                "status_id": 1,
                "text": "Source Connection ID Length (8),"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "     "
              },
              {
                "annotation_ids": [
                  "d7233a5d9a5e1c62"
                ],
                "status_id": 1,
                "text": "Source Connection ID (0..160),"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "     "
              },
              {
                "annotation_ids": [
                  "d7233a5d9a5e1c62"
                ],
                "status_id": 1,
                "text": "Length (i),"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "     "
              },
              {
                "annotation_ids": [
                  "d7233a5d9a5e1c62"
                ],
                "status_id": 1,
                "text": "Packet Number (8..32),"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "     "
              },
              {
                "annotation_ids": [
                  "d7233a5d9a5e1c62"
                ],
                "status_id": 1,
                "text": "Packet Payload (8..),"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "}"
              }
            ],
            "",
            "                          Figure 16: 0-RTT Packet",
            "",
            "   Packet numbers for 0-RTT protected packets use the same space as",
            "   1-RTT protected packets.",
            "",
            "   After a client receives a Retry packet, 0-RTT packets are likely to",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   have been lost or discarded by the server.  "
              },
              {
                "annotation_ids": [
                  "f975fea46f3ad398"
                ],
                "status_id": 14,
                "text": "A client SHOULD attempt"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "f975fea46f3ad398"
                ],
                "status_id": 14,
                "text": "to resend data in 0-RTT packets after it sends a new Initial packet."
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "e3d9214884bd4684"
                ],
                "status_id": 20,
                "text": "New packet numbers MUST be used for any new packets that are sent; as"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "e3d9214884bd4684"
                ],
                "status_id": 20,
                "text": "described in Section 17.2.5.3, reusing packet numbers could"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "e3d9214884bd4684"
                ],
                "status_id": 20,
                "text": "compromise packet protection."
              }
            ],
            "",
            "   A client only receives acknowledgments for its 0-RTT packets once the",
            "   handshake is complete, as defined in Section 4.1.1 of [QUIC-TLS].",
            "",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "43c5421c0f1bf751"
                ],
                "status_id": 20,
                "text": "A client MUST NOT send 0-RTT packets once it starts processing 1-RTT"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "43c5421c0f1bf751"
                ],
                "status_id": 20,
                "text": "packets from the server."
              },
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "  This means that 0-RTT packets cannot"
              }
            ],
            "   contain any response to frames from 1-RTT packets.  For instance, a",
            "   client cannot send an ACK frame in a 0-RTT packet, because that can",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   only acknowledge a 1-RTT packet.  "
              },
              {
                "annotation_ids": [
                  "2031d7444b40120f"
                ],
                "status_id": 20,
                "text": "An acknowledgment for a 1-RTT"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "2031d7444b40120f"
                ],
                "status_id": 20,
                "text": "packet MUST be carried in a 1-RTT packet."
              }
            ],
            "",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "46d96be58e64d790"
                ],
                "status_id": 14,
                "text": "A server SHOULD treat a violation of remembered limits"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "46d96be58e64d790"
                ],
                "status_id": 14,
                "text": "(Section 7.4.1) as a connection error of an appropriate type (for"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "46d96be58e64d790"
                ],
                "status_id": 14,
                "text": "instance, a FLOW_CONTROL_ERROR for exceeding stream data limits)."
              }
            ]
          ],
          "requirements": [
            "f975fea46f3ad398",
            "f975fea46f3ad398",
            "e3d9214884bd4684",
            "e3d9214884bd4684",
            "e3d9214884bd4684",
            "43c5421c0f1bf751",
            "43c5421c0f1bf751",
            "2031d7444b40120f",
            "2031d7444b40120f",
            "46d96be58e64d790",
            "46d96be58e64d790",
            "46d96be58e64d790"
          ],
          "title": "0-RTT"
        },
        {
          "id": "section-17.2.4",
          "lines": [
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "466b1c93918a1d9b"
                ],
                "status_id": 1,
                "text": "A Handshake packet uses long headers with a type value of 0x02"
              },
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": ","
              }
            ],
            "   followed by the Length and Packet Number fields; see Section 17.2.",
            "   The first byte contains the Reserved and Packet Number Length bits;",
            "   see Section 17.2.  It is used to carry cryptographic handshake",
            "   messages and acknowledgments from the server and client.",
            "",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "57d1f9a4bb18a972"
                ],
                "status_id": 1,
                "text": "Handshake Packet {"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "     "
              },
              {
                "annotation_ids": [
                  "57d1f9a4bb18a972"
                ],
                "status_id": 1,
                "text": "Header Form (1) = 1,"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "     "
              },
              {
                "annotation_ids": [
                  "57d1f9a4bb18a972"
                ],
                "status_id": 1,
                "text": "Fixed Bit (1) = 1,"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "     "
              },
              {
                "annotation_ids": [
                  "57d1f9a4bb18a972"
                ],
                "status_id": 1,
                "text": "Long Packet Type (2) = 2,"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "     "
              },
              {
                "annotation_ids": [
                  "57d1f9a4bb18a972"
                ],
                "status_id": 1,
                "text": "Reserved Bits (2),"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "     "
              },
              {
                "annotation_ids": [
                  "57d1f9a4bb18a972"
                ],
                "status_id": 1,
                "text": "Packet Number Length (2),"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "     "
              },
              {
                "annotation_ids": [
                  "57d1f9a4bb18a972"
                ],
                "status_id": 1,
                "text": "Version (32),"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "     "
              },
              {
                "annotation_ids": [
                  "57d1f9a4bb18a972"
                ],
                "status_id": 1,
                "text": "Destination Connection ID Length (8),"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "     "
              },
              {
                "annotation_ids": [
                  "57d1f9a4bb18a972"
                ],
                "status_id": 1,
                "text": "Destination Connection ID (0..160),"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "     "
              },
              {
                "annotation_ids": [
                  "57d1f9a4bb18a972"
                ],
                "status_id": 1,
                "text": "Source Connection ID Length (8),"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "     "
              },
              {
                "annotation_ids": [
                  "57d1f9a4bb18a972"
                ],
                "status_id": 1,
                "text": "Source Connection ID (0..160),"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "     "
              },
              {
                "annotation_ids": [
                  "57d1f9a4bb18a972"
                ],
                "status_id": 1,
                "text": "Length (i),"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "     "
              },
              {
                "annotation_ids": [
                  "57d1f9a4bb18a972"
                ],
                "status_id": 1,
                "text": "Packet Number (8..32),"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "     "
              },
              {
                "annotation_ids": [
                  "57d1f9a4bb18a972"
                ],
                "status_id": 1,
                "text": "Packet Payload (8..),"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "}"
              }
            ],
            "",
            "                   Figure 17: Handshake Protected Packet",
            "",
            "   Once a client has received a Handshake packet from a server, it uses",
            "   Handshake packets to send subsequent cryptographic handshake messages",
            "   and acknowledgments to the server.",
            "",
            "   The Destination Connection ID field in a Handshake packet contains a",
            "   connection ID that is chosen by the recipient of the packet; the",
            "   Source Connection ID includes the connection ID that the sender of",
            "   the packet wishes to use; see Section 7.2.",
            "",
            "   Handshake packets have their own packet number space, and thus the",
            "   first Handshake packet sent by a server contains a packet number of",
            "   0.",
            "",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "a1f926a0db764279"
                ],
                "status_id": 1,
                "text": "The payload of this packet contains CRYPTO frames and could contain"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "a1f926a0db764279"
                ],
                "status_id": 1,
                "text": "PING, PADDING, or ACK frames.  "
              },
              {
                "annotation_ids": [
                  "a1f926a0db764279",
                  "238bd34f10309d73",
                  "fb228f61a6faa9f9"
                ],
                "status_id": 21,
                "text": "Handshake packets MAY contain"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "a1f926a0db764279",
                  "238bd34f10309d73",
                  "fb228f61a6faa9f9"
                ],
                "status_id": 21,
                "text": "CONNECTION_CLOSE frames of type 0x1c."
              },
              {
                "annotation_ids": [
                  "a1f926a0db764279"
                ],
                "status_id": 1,
                "text": "  "
              },
              {
                "annotation_ids": [
                  "a1f926a0db764279",
                  "b176adab8dd1cc6a"
                ],
                "status_id": 13,
                "text": "Endpoints MUST treat receipt"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "a1f926a0db764279",
                  "b176adab8dd1cc6a"
                ],
                "status_id": 13,
                "text": "of Handshake packets with other frames as a connection error"
              },
              {
                "annotation_ids": [
                  "b176adab8dd1cc6a"
                ],
                "status_id": 20,
                "text": " of type"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "b176adab8dd1cc6a"
                ],
                "status_id": 20,
                "text": "PROTOCOL_VIOLATION."
              }
            ],
            "",
            "   Like Initial packets (see Section 17.2.2.1), data in CRYPTO frames",
            "   for Handshake packets is discarded -- and no longer retransmitted --",
            "   when Handshake protection keys are discarded."
          ],
          "requirements": [
            "fb228f61a6faa9f9",
            "fb228f61a6faa9f9",
            "b176adab8dd1cc6a",
            "b176adab8dd1cc6a",
            "b176adab8dd1cc6a"
          ],
          "title": "Handshake Packet"
        },
        {
          "id": "section-17.2.5",
          "lines": [
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   As shown in Figure 18, "
              },
              {
                "annotation_ids": [
                  "cb86159aa3bec88b"
                ],
                "status_id": 1,
                "text": "a Retry packet uses a long packet header with"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "cb86159aa3bec88b"
                ],
                "status_id": 1,
                "text": "a type value of 0x03."
              },
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "  It carries an address validation token created"
              }
            ],
            "   by the server.  It is used by a server that wishes to perform a",
            "   retry; see Section 8.1.",
            "",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "5646229325539c72"
                ],
                "status_id": 1,
                "text": "Retry Packet {"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "     "
              },
              {
                "annotation_ids": [
                  "5646229325539c72"
                ],
                "status_id": 1,
                "text": "Header Form (1) = 1,"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "     "
              },
              {
                "annotation_ids": [
                  "5646229325539c72"
                ],
                "status_id": 1,
                "text": "Fixed Bit (1) = 1,"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "     "
              },
              {
                "annotation_ids": [
                  "5646229325539c72"
                ],
                "status_id": 1,
                "text": "Long Packet Type (2) = 3,"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "     "
              },
              {
                "annotation_ids": [
                  "5646229325539c72"
                ],
                "status_id": 1,
                "text": "Unused (4),"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "     "
              },
              {
                "annotation_ids": [
                  "5646229325539c72"
                ],
                "status_id": 1,
                "text": "Version (32),"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "     "
              },
              {
                "annotation_ids": [
                  "5646229325539c72"
                ],
                "status_id": 1,
                "text": "Destination Connection ID Length (8),"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "     "
              },
              {
                "annotation_ids": [
                  "5646229325539c72"
                ],
                "status_id": 1,
                "text": "Destination Connection ID (0..160),"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "     "
              },
              {
                "annotation_ids": [
                  "5646229325539c72"
                ],
                "status_id": 1,
                "text": "Source Connection ID Length (8),"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "     "
              },
              {
                "annotation_ids": [
                  "5646229325539c72"
                ],
                "status_id": 1,
                "text": "Source Connection ID (0..160),"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "     "
              },
              {
                "annotation_ids": [
                  "5646229325539c72"
                ],
                "status_id": 1,
                "text": "Retry Token (..),"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "     "
              },
              {
                "annotation_ids": [
                  "5646229325539c72"
                ],
                "status_id": 1,
                "text": "Retry Integrity Tag (128),"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "}"
              }
            ],
            "",
            "                          Figure 18: Retry Packet",
            "",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   A Retry packet does not contain any protected fields.  "
              },
              {
                "annotation_ids": [
                  "04eeee7e4ba36949",
                  "7c944cd058b84aeb"
                ],
                "status_id": 13,
                "text": "The value in"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "04eeee7e4ba36949",
                  "7c944cd058b84aeb"
                ],
                "status_id": 13,
                "text": "the Unused field is set to an arbitrary value by the server; a client"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "04eeee7e4ba36949",
                  "7c944cd058b84aeb"
                ],
                "status_id": 13,
                "text": "MUST ignore these bits."
              },
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "  In addition to the fields from the long"
              }
            ],
            "   header, it contains these additional fields:",
            "",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "5e3057da4ab28873"
                ],
                "status_id": 1,
                "text": "Retry Token:  An opaque token that the server can use to validate the"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "      "
              },
              {
                "annotation_ids": [
                  "5e3057da4ab28873"
                ],
                "status_id": 1,
                "text": "client's address."
              }
            ],
            "",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "98a1fc67771b6592"
                ],
                "status_id": 1,
                "text": "Retry Integrity Tag:  Defined in Section 5.8 (\"Retry Packet"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "      "
              },
              {
                "annotation_ids": [
                  "98a1fc67771b6592"
                ],
                "status_id": 1,
                "text": "Integrity\") of [QUIC-TLS]."
              }
            ]
          ],
          "requirements": [
            "7c944cd058b84aeb",
            "7c944cd058b84aeb",
            "7c944cd058b84aeb"
          ],
          "title": "Retry Packet"
        },
        {
          "id": "section-17.2.5.1",
          "lines": [
            "   The server populates the Destination Connection ID with the",
            "   connection ID that the client included in the Source Connection ID of",
            "   the Initial packet.",
            "",
            "   The server includes a connection ID of its choice in the Source",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   Connection ID field.  "
              },
              {
                "annotation_ids": [
                  "5fdf8ba0180d97d7",
                  "b8f361df698570d4",
                  "77c827c165dc4208"
                ],
                "status_id": 9,
                "text": "This value MUST NOT be equal to the Destination"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "5fdf8ba0180d97d7",
                  "b8f361df698570d4",
                  "77c827c165dc4208"
                ],
                "status_id": 9,
                "text": "Connection ID field of the packet sent by the client."
              },
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "  "
              },
              {
                "annotation_ids": [
                  "7b29aadd5fd5e946",
                  "329899c07d9c8fff",
                  "7532b9f6f2be3932"
                ],
                "status_id": 25,
                "text": "A client MUST"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "7b29aadd5fd5e946",
                  "329899c07d9c8fff",
                  "7532b9f6f2be3932"
                ],
                "status_id": 25,
                "text": "discard a Retry packet that contains a Source Connection ID field"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "7b29aadd5fd5e946",
                  "329899c07d9c8fff",
                  "7532b9f6f2be3932"
                ],
                "status_id": 25,
                "text": "that is identical to the Destination Connection ID field of its"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "7b29aadd5fd5e946",
                  "329899c07d9c8fff",
                  "7532b9f6f2be3932"
                ],
                "status_id": 25,
                "text": "Initial packet."
              },
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "  "
              },
              {
                "annotation_ids": [
                  "ebcc210d68a79953",
                  "00486010e978d5ea"
                ],
                "status_id": 13,
                "text": "The client MUST use the value from the Source"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "ebcc210d68a79953",
                  "00486010e978d5ea"
                ],
                "status_id": 13,
                "text": "Connection ID field of the Retry packet in the Destination Connection"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "ebcc210d68a79953",
                  "00486010e978d5ea"
                ],
                "status_id": 13,
                "text": "ID field of subsequent packets that it sends."
              }
            ],
            "",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "b0f75b91ed138c42"
                ],
                "status_id": 19,
                "text": "A server MAY send Retry packets in response to Initial and 0-RTT"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "b0f75b91ed138c42"
                ],
                "status_id": 19,
                "text": "packets."
              },
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "  A server can either discard or buffer 0-RTT packets that it"
              }
            ],
            "   receives.  A server can send multiple Retry packets as it receives",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   Initial or 0-RTT packets.  "
              },
              {
                "annotation_ids": [
                  "ee1085a6d69698ad",
                  "06b3d523682a2174"
                ],
                "status_id": 13,
                "text": "A server MUST NOT send more than one Retry"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "ee1085a6d69698ad",
                  "06b3d523682a2174"
                ],
                "status_id": 13,
                "text": "packet in response to a single UDP datagram."
              }
            ]
          ],
          "requirements": [
            "77c827c165dc4208",
            "77c827c165dc4208",
            "7532b9f6f2be3932",
            "7532b9f6f2be3932",
            "7532b9f6f2be3932",
            "7532b9f6f2be3932",
            "00486010e978d5ea",
            "00486010e978d5ea",
            "00486010e978d5ea",
            "b0f75b91ed138c42",
            "b0f75b91ed138c42",
            "06b3d523682a2174",
            "06b3d523682a2174"
          ],
          "title": "Sending a Retry Packet"
        },
        {
          "id": "section-17.2.5.2",
          "lines": [
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "aaa2cfbf95a7ecd1",
                  "c656a858ccf2120f",
                  "f251a47e1738a9e6"
                ],
                "status_id": 25,
                "text": "A client MUST accept and process at most one Retry packet for each"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "aaa2cfbf95a7ecd1",
                  "c656a858ccf2120f",
                  "f251a47e1738a9e6"
                ],
                "status_id": 25,
                "text": "connection attempt."
              },
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "  "
              },
              {
                "annotation_ids": [
                  "6556c83cefd81536",
                  "420fde987a9eabb7",
                  "319a0a4edd982b95"
                ],
                "status_id": 25,
                "text": "After the client has received and processed an"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "6556c83cefd81536",
                  "420fde987a9eabb7",
                  "319a0a4edd982b95"
                ],
                "status_id": 25,
                "text": "Initial or Retry packet from the server, it MUST discard any"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "6556c83cefd81536",
                  "420fde987a9eabb7",
                  "319a0a4edd982b95"
                ],
                "status_id": 25,
                "text": "subsequent Retry packets that it receives."
              }
            ],
            "",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "68d7101115efed79",
                  "5f17309ba827a886"
                ],
                "status_id": 17,
                "text": "Clients MUST discard Retry packets that have a Retry Integrity Tag"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "68d7101115efed79",
                  "5f17309ba827a886"
                ],
                "status_id": 17,
                "text": "that cannot be validated; see Section 5.8 of [QUIC-TLS]."
              },
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "  This"
              }
            ],
            "   diminishes an attacker's ability to inject a Retry packet and",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   protects against accidental corruption of Retry packets.  "
              },
              {
                "annotation_ids": [
                  "4268a64547941fe4",
                  "7544f314f0c43c76",
                  "ad9263d94bdced62"
                ],
                "status_id": 9,
                "text": "A client"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "4268a64547941fe4",
                  "7544f314f0c43c76",
                  "ad9263d94bdced62"
                ],
                "status_id": 9,
                "text": "MUST discard a Retry packet with a zero-length Retry Token field."
              }
            ],
            "",
            "   The client responds to a Retry packet with an Initial packet that",
            "   includes the provided Retry token to continue connection",
            "   establishment.",
            "",
            "   A client sets the Destination Connection ID field of this Initial",
            "   packet to the value from the Source Connection ID field in the Retry",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   packet.  "
              },
              {
                "annotation_ids": [
                  "9359508c7528f8d8",
                  "7234a23e783bb5ca"
                ],
                "status_id": 1,
                "text": "Changing the Destination Connection ID field also results in"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "9359508c7528f8d8",
                  "7234a23e783bb5ca"
                ],
                "status_id": 1,
                "text": "a change to the keys used to protect the Initial packet."
              },
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "  It also"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   sets the Token field to the token provided in the Retry packet.  "
              },
              {
                "annotation_ids": [
                  "64330e47a19227fa"
                ],
                "status_id": 20,
                "text": "The"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "64330e47a19227fa"
                ],
                "status_id": 20,
                "text": "client MUST NOT change the Source Connection ID because the server"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "64330e47a19227fa"
                ],
                "status_id": 20,
                "text": "could include the connection ID as part of its token validation"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "64330e47a19227fa"
                ],
                "status_id": 20,
                "text": "logic; see Section 8.1.4."
              }
            ],
            "",
            "   A Retry packet does not include a packet number and cannot be",
            "   explicitly acknowledged by a client."
          ],
          "requirements": [
            "f251a47e1738a9e6",
            "f251a47e1738a9e6",
            "319a0a4edd982b95",
            "319a0a4edd982b95",
            "319a0a4edd982b95",
            "5f17309ba827a886",
            "5f17309ba827a886",
            "ad9263d94bdced62",
            "ad9263d94bdced62",
            "64330e47a19227fa",
            "64330e47a19227fa",
            "64330e47a19227fa",
            "64330e47a19227fa"
          ],
          "title": "Handling a Retry Packet"
        },
        {
          "id": "section-17.2.5.3",
          "lines": [
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "f9cf8edf7e586edd"
                ],
                "status_id": 1,
                "text": "Subsequent Initial packets from the client include the connection ID"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "f9cf8edf7e586edd"
                ],
                "status_id": 1,
                "text": "and token values from the Retry packet."
              },
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "  The client copies the Source"
              }
            ],
            "   Connection ID field from the Retry packet to the Destination",
            "   Connection ID field and uses this value until an Initial packet with",
            "   an updated value is received; see Section 7.2.  The value of the",
            "   Token field is copied to all subsequent Initial packets; see",
            "   Section 8.1.2.",
            "",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "dfab72de44bbf83a"
                ],
                "status_id": 1,
                "text": "Other than updating the Destination Connection ID and Token fields,"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "dfab72de44bbf83a"
                ],
                "status_id": 1,
                "text": "the Initial packet sent by the client is subject to the same"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "dfab72de44bbf83a"
                ],
                "status_id": 1,
                "text": "restrictions as the first Initial packet.  "
              },
              {
                "annotation_ids": [
                  "dfab72de44bbf83a",
                  "3dc1972002816b5e"
                ],
                "status_id": 13,
                "text": "A client MUST use the same"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "dfab72de44bbf83a",
                  "3dc1972002816b5e"
                ],
                "status_id": 13,
                "text": "cryptographic handshake message it included in this packet."
              },
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "  "
              },
              {
                "annotation_ids": [
                  "12b2ce770930b41d"
                ],
                "status_id": 19,
                "text": "A server"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "12b2ce770930b41d"
                ],
                "status_id": 19,
                "text": "MAY treat a packet that contains a different cryptographic handshake"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "12b2ce770930b41d"
                ],
                "status_id": 19,
                "text": "message as a connection error or discard it."
              },
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "  Note that including a"
              }
            ],
            "   Token field reduces the available space for the cryptographic",
            "   handshake message, which might result in the client needing to send",
            "   multiple Initial packets.",
            "",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "b199e06d7b06763c"
                ],
                "status_id": 19,
                "text": "A client MAY attempt 0-RTT after receiving a Retry packet by sending"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "b199e06d7b06763c"
                ],
                "status_id": 19,
                "text": "0-RTT packets to the connection ID provided by the server."
              }
            ],
            "",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "f7fe7b1c78d29ffe"
                ],
                "status_id": 20,
                "text": "A client MUST NOT reset the packet number for any packet number space"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "f7fe7b1c78d29ffe"
                ],
                "status_id": 20,
                "text": "after processing a Retry packet."
              },
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "  In particular, 0-RTT packets"
              }
            ],
            "   contain confidential information that will most likely be",
            "   retransmitted on receiving a Retry packet.  The keys used to protect",
            "   these new 0-RTT packets will not change as a result of responding to",
            "   a Retry packet.  However, the data sent in these packets could be",
            "   different than what was sent earlier.  Sending these new packets with",
            "   the same packet number is likely to compromise the packet protection",
            "   for those packets because the same key and nonce could be used to",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   protect different content.  "
              },
              {
                "annotation_ids": [
                  "63d7fc7e14356d18"
                ],
                "status_id": 19,
                "text": "A server MAY abort the connection if it"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "63d7fc7e14356d18"
                ],
                "status_id": 19,
                "text": "detects that the client reset the packet number."
              }
            ],
            "",
            "   The connection IDs used in Initial and Retry packets exchanged",
            "   between client and server are copied to the transport parameters and",
            "   validated as described in Section 7.3."
          ],
          "requirements": [
            "3dc1972002816b5e",
            "3dc1972002816b5e",
            "12b2ce770930b41d",
            "12b2ce770930b41d",
            "12b2ce770930b41d",
            "b199e06d7b06763c",
            "b199e06d7b06763c",
            "f7fe7b1c78d29ffe",
            "f7fe7b1c78d29ffe",
            "63d7fc7e14356d18",
            "63d7fc7e14356d18"
          ],
          "title": "Continuing a Handshake after Retry"
        },
        {
          "id": "section-17.3",
          "lines": [
            "   This version of QUIC defines a single packet type that uses the short",
            "   packet header."
          ],
          "title": "Short Header Packets"
        },
        {
          "id": "section-17.3.1",
          "lines": [
            "   A 1-RTT packet uses a short packet header.  It is used after the",
            "   version and 1-RTT keys are negotiated.",
            "",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "fc9bb5b7a00331f1"
                ],
                "status_id": 1,
                "text": "1-RTT Packet {"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "     "
              },
              {
                "annotation_ids": [
                  "fc9bb5b7a00331f1"
                ],
                "status_id": 1,
                "text": "Header Form (1) = 0,"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "     "
              },
              {
                "annotation_ids": [
                  "fc9bb5b7a00331f1"
                ],
                "status_id": 1,
                "text": "Fixed Bit (1) = 1,"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "     "
              },
              {
                "annotation_ids": [
                  "fc9bb5b7a00331f1"
                ],
                "status_id": 1,
                "text": "Spin Bit (1),"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "     "
              },
              {
                "annotation_ids": [
                  "fc9bb5b7a00331f1"
                ],
                "status_id": 1,
                "text": "Reserved Bits (2),"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "     "
              },
              {
                "annotation_ids": [
                  "fc9bb5b7a00331f1"
                ],
                "status_id": 1,
                "text": "Key Phase (1),"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "     "
              },
              {
                "annotation_ids": [
                  "fc9bb5b7a00331f1"
                ],
                "status_id": 1,
                "text": "Packet Number Length (2),"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "     "
              },
              {
                "annotation_ids": [
                  "fc9bb5b7a00331f1"
                ],
                "status_id": 1,
                "text": "Destination Connection ID (0..160),"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "     "
              },
              {
                "annotation_ids": [
                  "fc9bb5b7a00331f1"
                ],
                "status_id": 1,
                "text": "Packet Number (8..32),"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "     "
              },
              {
                "annotation_ids": [
                  "fc9bb5b7a00331f1"
                ],
                "status_id": 1,
                "text": "Packet Payload (8..),"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "}"
              }
            ],
            "",
            "                          Figure 19: 1-RTT Packet",
            "",
            "   1-RTT packets contain the following fields:",
            "",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "8179d998e7e8f473"
                ],
                "status_id": 1,
                "text": "Header Form:  The most significant bit (0x80) of byte 0 is set to 0"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "      "
              },
              {
                "annotation_ids": [
                  "8179d998e7e8f473"
                ],
                "status_id": 1,
                "text": "for the short header."
              }
            ],
            "",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "8179d998e7e8f473"
                ],
                "status_id": 1,
                "text": "Fixed Bit:  The next bit (0x40) of byte 0 is set to 1."
              },
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "  "
              },
              {
                "annotation_ids": [
                  "b52d95f1aef97c69"
                ],
                "status_id": 20,
                "text": "Packets"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "      "
              },
              {
                "annotation_ids": [
                  "b52d95f1aef97c69"
                ],
                "status_id": 20,
                "text": "containing a zero value for this bit are not valid packets in this"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "      "
              },
              {
                "annotation_ids": [
                  "b52d95f1aef97c69"
                ],
                "status_id": 20,
                "text": "version and MUST be discarded."
              },
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "  A value of 1 for this bit allows"
              }
            ],
            "      QUIC to coexist with other protocols; see [RFC7983].",
            "",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "c5de50922ab92e0a"
                ],
                "status_id": 1,
                "text": "Spin Bit:  The third most significant bit (0x20) of byte 0 is the"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "      "
              },
              {
                "annotation_ids": [
                  "c5de50922ab92e0a"
                ],
                "status_id": 1,
                "text": "latency spin bit, set as described in Section 17.4."
              }
            ],
            "",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "9d13cceab21101a1",
                  "a855355c9f7dd96b"
                ],
                "status_id": 1,
                "text": "Reserved Bits:  The next two bits (those with a mask of 0x18) of byte"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "      "
              },
              {
                "annotation_ids": [
                  "9d13cceab21101a1",
                  "a855355c9f7dd96b"
                ],
                "status_id": 1,
                "text": "0 are reserved."
              },
              {
                "annotation_ids": [
                  "a855355c9f7dd96b"
                ],
                "status_id": 1,
                "text": "  These bits are protected using header protection;"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "      "
              },
              {
                "annotation_ids": [
                  "a855355c9f7dd96b"
                ],
                "status_id": 1,
                "text": "see Section 5.4 of [QUIC-TLS]."
              },
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "  "
              },
              {
                "annotation_ids": [
                  "d4fea002e72ef642"
                ],
                "status_id": 20,
                "text": "The value included prior to"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "      "
              },
              {
                "annotation_ids": [
                  "d4fea002e72ef642"
                ],
                "status_id": 20,
                "text": "protection MUST be set to 0."
              },
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "  "
              },
              {
                "annotation_ids": [
                  "b1d5caa43e12a7d4",
                  "3f504f667262e178"
                ],
                "status_id": 13,
                "text": "An endpoint MUST treat receipt of a"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "      "
              },
              {
                "annotation_ids": [
                  "b1d5caa43e12a7d4",
                  "3f504f667262e178"
                ],
                "status_id": 13,
                "text": "packet that has a non-zero value for these bits, after removing"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "      "
              },
              {
                "annotation_ids": [
                  "b1d5caa43e12a7d4",
                  "3f504f667262e178"
                ],
                "status_id": 13,
                "text": "both packet and header protection, as a connection error of type"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "      "
              },
              {
                "annotation_ids": [
                  "b1d5caa43e12a7d4",
                  "3f504f667262e178"
                ],
                "status_id": 13,
                "text": "PROTOCOL_VIOLATION."
              },
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "  Discarding such a packet after only removing"
              }
            ],
            "      header protection can expose the endpoint to attacks; see",
            "      Section 9.5 of [QUIC-TLS].",
            "",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "2ceda4602f8c6ba1"
                ],
                "status_id": 1,
                "text": "Key Phase:  The next bit (0x04) of byte 0 indicates the key phase,"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "      "
              },
              {
                "annotation_ids": [
                  "2ceda4602f8c6ba1"
                ],
                "status_id": 1,
                "text": "which allows a recipient of a packet to identify the packet"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "      "
              },
              {
                "annotation_ids": [
                  "2ceda4602f8c6ba1"
                ],
                "status_id": 1,
                "text": "protection keys that are used to protect the packet."
              },
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "  See"
              }
            ],
            "      [QUIC-TLS] for details.  This bit is protected using header",
            "      protection; see Section 5.4 of [QUIC-TLS].",
            "",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "5e73206911079475"
                ],
                "status_id": 1,
                "text": "Packet Number Length:  The least significant two bits (those with a"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "      "
              },
              {
                "annotation_ids": [
                  "5e73206911079475"
                ],
                "status_id": 1,
                "text": "mask of 0x03) of byte 0 contain the length of the Packet Number"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "      "
              },
              {
                "annotation_ids": [
                  "5e73206911079475"
                ],
                "status_id": 1,
                "text": "field, encoded as an unsigned two-bit integer that is one less"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "      "
              },
              {
                "annotation_ids": [
                  "5e73206911079475"
                ],
                "status_id": 1,
                "text": "than the length of the Packet Number field in bytes."
              },
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "  That is, the"
              }
            ],
            "      length of the Packet Number field is the value of this field plus",
            "      one.  These bits are protected using header protection; see",
            "      Section 5.4 of [QUIC-TLS].",
            "",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "bbaca64b7694416f"
                ],
                "status_id": 1,
                "text": "Destination Connection ID:  The Destination Connection ID is a"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "      "
              },
              {
                "annotation_ids": [
                  "bbaca64b7694416f"
                ],
                "status_id": 1,
                "text": "connection ID that is chosen by the intended recipient of the"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "      "
              },
              {
                "annotation_ids": [
                  "bbaca64b7694416f"
                ],
                "status_id": 1,
                "text": "packet."
              },
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "  See Section 5.1 for more details."
              }
            ],
            "",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "9cb186cbbc912d1e"
                ],
                "status_id": 1,
                "text": "Packet Number:  The Packet Number field is 1 to 4 bytes long.  The"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "      "
              },
              {
                "annotation_ids": [
                  "9cb186cbbc912d1e"
                ],
                "status_id": 1,
                "text": "packet number is protected using header protection; see"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "      "
              },
              {
                "annotation_ids": [
                  "9cb186cbbc912d1e"
                ],
                "status_id": 1,
                "text": "Section 5.4 of [QUIC-TLS].  The length of the Packet Number field"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "      "
              },
              {
                "annotation_ids": [
                  "9cb186cbbc912d1e"
                ],
                "status_id": 1,
                "text": "is encoded in Packet Number Length field.  See Section 17.1 for"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "      "
              },
              {
                "annotation_ids": [
                  "9cb186cbbc912d1e"
                ],
                "status_id": 1,
                "text": "details."
              }
            ],
            "",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "25e7635c143e951a"
                ],
                "status_id": 1,
                "text": "Packet Payload:  1-RTT packets always include a 1-RTT protected"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "      "
              },
              {
                "annotation_ids": [
                  "25e7635c143e951a"
                ],
                "status_id": 1,
                "text": "payload."
              }
            ],
            "",
            "   The header form bit and the Destination Connection ID field of a",
            "   short header packet are version independent.  The remaining fields",
            "   are specific to the selected QUIC version.  See [QUIC-INVARIANTS] for",
            "   details on how packets from different versions of QUIC are",
            "   interpreted."
          ],
          "requirements": [
            "b52d95f1aef97c69",
            "b52d95f1aef97c69",
            "b52d95f1aef97c69",
            "d4fea002e72ef642",
            "d4fea002e72ef642",
            "3f504f667262e178",
            "3f504f667262e178",
            "3f504f667262e178",
            "3f504f667262e178"
          ],
          "title": "1-RTT Packet"
        },
        {
          "id": "section-17.4",
          "lines": [
            "   The latency spin bit, which is defined for 1-RTT packets",
            "   (Section 17.3.1), enables passive latency monitoring from observation",
            "   points on the network path throughout the duration of a connection.",
            "   The server reflects the spin value received, while the client \"spins\"",
            "   it after one RTT.  On-path observers can measure the time between two",
            "   spin bit toggle events to estimate the end-to-end RTT of a",
            "   connection.",
            "",
            "   The spin bit is only present in 1-RTT packets, since it is possible",
            "   to measure the initial RTT of a connection by observing the",
            "   handshake.  Therefore, the spin bit is available after version",
            "   negotiation and connection establishment are completed.  On-path",
            "   measurement and use of the latency spin bit are further discussed in",
            "   [QUIC-MANAGEABILITY].",
            "",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "c0a61b142c87b055",
                  "961973c87db708f0"
                ],
                "status_id": 16,
                "text": "The spin bit is an OPTIONAL feature of this version of QUIC."
              },
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "  "
              },
              {
                "annotation_ids": [
                  "3c418f0ac6ee1c96"
                ],
                "status_id": 20,
                "text": "An"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "3c418f0ac6ee1c96"
                ],
                "status_id": 20,
                "text": "endpoint that does not support this feature MUST disable it, as"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "3c418f0ac6ee1c96"
                ],
                "status_id": 20,
                "text": "defined below."
              }
            ],
            "",
            "   Each endpoint unilaterally decides if the spin bit is enabled or",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   disabled for a connection.  "
              },
              {
                "annotation_ids": [
                  "b078131f120fac2d",
                  "94e8c23f6ceeb003"
                ],
                "status_id": 17,
                "text": "Implementations MUST allow administrators"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "b078131f120fac2d",
                  "94e8c23f6ceeb003"
                ],
                "status_id": 17,
                "text": "of clients and servers to disable the spin bit either globally or on"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "b078131f120fac2d",
                  "94e8c23f6ceeb003"
                ],
                "status_id": 17,
                "text": "a per-connection basis."
              },
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "  "
              },
              {
                "annotation_ids": [
                  "9885aeab6f1c8866",
                  "3c95b5224834fa84"
                ],
                "status_id": 17,
                "text": "Even when the spin bit is not disabled by"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "9885aeab6f1c8866",
                  "3c95b5224834fa84"
                ],
                "status_id": 17,
                "text": "the administrator, endpoints MUST disable their use of the spin bit"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "9885aeab6f1c8866",
                  "3c95b5224834fa84"
                ],
                "status_id": 17,
                "text": "for a random selection of at least one in every 16 network paths, or"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "9885aeab6f1c8866",
                  "3c95b5224834fa84"
                ],
                "status_id": 17,
                "text": "for one in every 16 connection IDs,"
              },
              {
                "annotation_ids": [
                  "3c95b5224834fa84"
                ],
                "status_id": 20,
                "text": " in order to ensure that QUIC"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "3c95b5224834fa84"
                ],
                "status_id": 20,
                "text": "connections that disable the spin bit are commonly observed on the"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "3c95b5224834fa84"
                ],
                "status_id": 20,
                "text": "network."
              },
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "  As each endpoint disables the spin bit independently, this"
              }
            ],
            "   ensures that the spin bit signal is disabled on approximately one in",
            "   eight network paths.",
            "",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "3f8cf259a6e4d50d",
                  "e067280d653368f2"
                ],
                "status_id": 17,
                "text": "When the spin bit is disabled, endpoints MAY set the spin bit to any"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "3f8cf259a6e4d50d",
                  "e067280d653368f2"
                ],
                "status_id": 17,
                "text": "value and MUST ignore any incoming value."
              },
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "  "
              },
              {
                "annotation_ids": [
                  "2dd9d8e8a6d98d60",
                  "a1eeb8e7ece9f56b"
                ],
                "status_id": 18,
                "text": "It is RECOMMENDED that"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "2dd9d8e8a6d98d60",
                  "a1eeb8e7ece9f56b"
                ],
                "status_id": 18,
                "text": "endpoints set the spin bit to a random value either chosen"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "2dd9d8e8a6d98d60",
                  "a1eeb8e7ece9f56b"
                ],
                "status_id": 18,
                "text": "independently for each packet or chosen independently for each"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "2dd9d8e8a6d98d60",
                  "a1eeb8e7ece9f56b"
                ],
                "status_id": 18,
                "text": "connection ID."
              }
            ],
            "",
            "   If the spin bit is enabled for the connection, the endpoint maintains",
            "   a spin value for each network path and sets the spin bit in the",
            "   packet header to the currently stored value when a 1-RTT packet is",
            "   sent on that path.  The spin value is initialized to 0 in the",
            "   endpoint for each network path.  Each endpoint also remembers the",
            "   highest packet number seen from its peer on each path.",
            "",
            "   When a server receives a 1-RTT packet that increases the highest",
            "   packet number seen by the server from the client on a given network",
            "   path, it sets the spin value for that path to be equal to the spin",
            "   bit in the received packet.",
            "",
            "   When a client receives a 1-RTT packet that increases the highest",
            "   packet number seen by the client from the server on a given network",
            "   path, it sets the spin value for that path to the inverse of the spin",
            "   bit in the received packet.",
            "",
            "   An endpoint resets the spin value for a network path to 0 when",
            "   changing the connection ID being used on that network path."
          ],
          "requirements": [
            "961973c87db708f0",
            "3c418f0ac6ee1c96",
            "3c418f0ac6ee1c96",
            "3c418f0ac6ee1c96",
            "94e8c23f6ceeb003",
            "94e8c23f6ceeb003",
            "94e8c23f6ceeb003",
            "3c95b5224834fa84",
            "3c95b5224834fa84",
            "3c95b5224834fa84",
            "3c95b5224834fa84",
            "3c95b5224834fa84",
            "3c95b5224834fa84",
            "e067280d653368f2",
            "e067280d653368f2",
            "a1eeb8e7ece9f56b",
            "a1eeb8e7ece9f56b",
            "a1eeb8e7ece9f56b",
            "a1eeb8e7ece9f56b"
          ],
          "title": "Latency Spin Bit"
        },
        {
          "id": "section-18",
          "lines": [
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "d3b891980038aeba"
                ],
                "status_id": 1,
                "text": "The extension_data field of the quic_transport_parameters extension"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "d3b891980038aeba"
                ],
                "status_id": 1,
                "text": "defined in [QUIC-TLS] contains the QUIC transport parameters.  They"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "d3b891980038aeba"
                ],
                "status_id": 1,
                "text": "are encoded as a sequence of transport parameters, as shown in"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "d3b891980038aeba"
                ],
                "status_id": 1,
                "text": "Figure 20:"
              }
            ],
            "",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "d3b891980038aeba"
                ],
                "status_id": 1,
                "text": "Transport Parameters {"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "     "
              },
              {
                "annotation_ids": [
                  "d3b891980038aeba"
                ],
                "status_id": 1,
                "text": "Transport Parameter (..) ...,"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "}"
              }
            ],
            "",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "                "
              },
              {
                "annotation_ids": [
                  "d3b891980038aeba"
                ],
                "status_id": 1,
                "text": "Figure 20: Sequence of Transport Parameters"
              }
            ],
            "",
            "   Each transport parameter is encoded as an (identifier, length, value)",
            "   tuple, as shown in Figure 21:",
            "",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "62b198458473b328"
                ],
                "status_id": 1,
                "text": "Transport Parameter {"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "     "
              },
              {
                "annotation_ids": [
                  "62b198458473b328"
                ],
                "status_id": 1,
                "text": "Transport Parameter ID (i),"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "     "
              },
              {
                "annotation_ids": [
                  "62b198458473b328"
                ],
                "status_id": 1,
                "text": "Transport Parameter Length (i),"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "     "
              },
              {
                "annotation_ids": [
                  "62b198458473b328"
                ],
                "status_id": 1,
                "text": "Transport Parameter Value (..),"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "}"
              }
            ],
            "",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "                  "
              },
              {
                "annotation_ids": [
                  "62b198458473b328"
                ],
                "status_id": 1,
                "text": "Figure 21: Transport Parameter Encoding"
              }
            ],
            "",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "62b198458473b328"
                ],
                "status_id": 1,
                "text": "The Transport Parameter Length field contains the length of the"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "62b198458473b328"
                ],
                "status_id": 1,
                "text": "Transport Parameter Value field in bytes."
              }
            ],
            "",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "62b198458473b328"
                ],
                "status_id": 1,
                "text": "QUIC encodes transport parameters into a sequence of bytes, which is"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "62b198458473b328"
                ],
                "status_id": 1,
                "text": "then included in the cryptographic handshake."
              }
            ]
          ],
          "title": "Transport Parameter Encoding"
        },
        {
          "id": "section-18.1",
          "lines": [
            "   Transport parameters with an identifier of the form \"31 * N + 27\" for",
            "   integer values of N are reserved to exercise the requirement that",
            "   unknown transport parameters be ignored.  These transport parameters",
            "   have no semantics and can carry arbitrary values."
          ],
          "title": "Reserved Transport Parameters"
        },
        {
          "id": "section-18.2",
          "lines": [
            "   This section details the transport parameters defined in this",
            "   document.",
            "",
            "   Many transport parameters listed here have integer values.  Those",
            "   transport parameters that are identified as integers use a variable-",
            "   length integer encoding; see Section 16.  Transport parameters have a",
            "   default value of 0 if the transport parameter is absent, unless",
            "   otherwise stated.",
            "",
            "   The following transport parameters are defined:",
            "",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "dc0e14b86d957887"
                ],
                "status_id": 1,
                "text": "original_destination_connection_id (0x00):  This parameter is the"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "      "
              },
              {
                "annotation_ids": [
                  "dc0e14b86d957887"
                ],
                "status_id": 1,
                "text": "value of the Destination Connection ID field from the first"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "      "
              },
              {
                "annotation_ids": [
                  "dc0e14b86d957887"
                ],
                "status_id": 1,
                "text": "Initial packet sent by the client; see Section 7.3.  This"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "      "
              },
              {
                "annotation_ids": [
                  "dc0e14b86d957887"
                ],
                "status_id": 1,
                "text": "transport parameter is only sent by a server."
              }
            ],
            "",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "c8f931299dd2b9a9"
                ],
                "status_id": 1,
                "text": "max_idle_timeout (0x01):  The maximum idle timeout is a value in"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "      "
              },
              {
                "annotation_ids": [
                  "c8f931299dd2b9a9"
                ],
                "status_id": 1,
                "text": "milliseconds that is encoded as an integer; see (Section 10.1)."
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "      "
              },
              {
                "annotation_ids": [
                  "c8f931299dd2b9a9",
                  "ca6603c3c311f958"
                ],
                "status_id": 1,
                "text": "Idle timeout is disabled when both endpoints omit this transport"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "      "
              },
              {
                "annotation_ids": [
                  "c8f931299dd2b9a9",
                  "ca6603c3c311f958"
                ],
                "status_id": 1,
                "text": "parameter or specify a value of 0."
              }
            ],
            "",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "475642a14b22f605"
                ],
                "status_id": 1,
                "text": "stateless_reset_token (0x02):  A stateless reset token is used in"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "      "
              },
              {
                "annotation_ids": [
                  "475642a14b22f605"
                ],
                "status_id": 1,
                "text": "verifying a stateless reset; see Section 10.3.  This parameter is"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "      "
              },
              {
                "annotation_ids": [
                  "475642a14b22f605"
                ],
                "status_id": 1,
                "text": "a sequence of 16 bytes.  "
              },
              {
                "annotation_ids": [
                  "475642a14b22f605",
                  "c0906d958d1a4455"
                ],
                "status_id": 13,
                "text": "This transport parameter MUST NOT be sent"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "      "
              },
              {
                "annotation_ids": [
                  "475642a14b22f605",
                  "c0906d958d1a4455"
                ],
                "status_id": 13,
                "text": "by a client but MAY be sent by a server."
              },
              {
                "annotation_ids": [
                  "475642a14b22f605"
                ],
                "status_id": 1,
                "text": "  A server that does not"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "      "
              },
              {
                "annotation_ids": [
                  "475642a14b22f605"
                ],
                "status_id": 1,
                "text": "send this transport parameter cannot use stateless reset"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "      "
              },
              {
                "annotation_ids": [
                  "475642a14b22f605"
                ],
                "status_id": 1,
                "text": "(Section 10.3) for the connection ID negotiated during the"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "      "
              },
              {
                "annotation_ids": [
                  "475642a14b22f605"
                ],
                "status_id": 1,
                "text": "handshake."
              }
            ],
            "",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "178c2a0c09e9ab51"
                ],
                "status_id": 1,
                "text": "max_udp_payload_size (0x03):  The maximum UDP payload size parameter"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "      "
              },
              {
                "annotation_ids": [
                  "178c2a0c09e9ab51"
                ],
                "status_id": 1,
                "text": "is an integer value that limits the size of UDP payloads that the"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "      "
              },
              {
                "annotation_ids": [
                  "178c2a0c09e9ab51"
                ],
                "status_id": 1,
                "text": "endpoint is willing to receive.  UDP datagrams with payloads"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "      "
              },
              {
                "annotation_ids": [
                  "178c2a0c09e9ab51"
                ],
                "status_id": 1,
                "text": "larger than this limit are not likely to be processed by the"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "      "
              },
              {
                "annotation_ids": [
                  "178c2a0c09e9ab51"
                ],
                "status_id": 1,
                "text": "receiver."
              }
            ],
            "",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "      "
              },
              {
                "annotation_ids": [
                  "178c2a0c09e9ab51"
                ],
                "status_id": 1,
                "text": "The default for this parameter is the maximum permitted UDP"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "      "
              },
              {
                "annotation_ids": [
                  "178c2a0c09e9ab51"
                ],
                "status_id": 1,
                "text": "payload of 65527.  Values below 1200 are invalid."
              }
            ],
            "",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "      "
              },
              {
                "annotation_ids": [
                  "178c2a0c09e9ab51"
                ],
                "status_id": 1,
                "text": "This limit does act as an additional constraint on datagram size"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "      "
              },
              {
                "annotation_ids": [
                  "178c2a0c09e9ab51"
                ],
                "status_id": 1,
                "text": "in the same way as the path MTU, but it is a property of the"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "      "
              },
              {
                "annotation_ids": [
                  "178c2a0c09e9ab51"
                ],
                "status_id": 1,
                "text": "endpoint and not the path; see Section 14.  It is expected that"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "      "
              },
              {
                "annotation_ids": [
                  "178c2a0c09e9ab51"
                ],
                "status_id": 1,
                "text": "this is the space an endpoint dedicates to holding incoming"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "      "
              },
              {
                "annotation_ids": [
                  "178c2a0c09e9ab51"
                ],
                "status_id": 1,
                "text": "packets."
              }
            ],
            "",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "6c244d56c43882af"
                ],
                "status_id": 1,
                "text": "initial_max_data (0x04):  The initial maximum data parameter is an"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "      "
              },
              {
                "annotation_ids": [
                  "6c244d56c43882af"
                ],
                "status_id": 1,
                "text": "integer value that contains the initial value for the maximum"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "      "
              },
              {
                "annotation_ids": [
                  "6c244d56c43882af"
                ],
                "status_id": 1,
                "text": "amount of data that can be sent on the connection.  This is"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "      "
              },
              {
                "annotation_ids": [
                  "6c244d56c43882af"
                ],
                "status_id": 1,
                "text": "equivalent to sending a MAX_DATA (Section 19.9) for the connection"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "      "
              },
              {
                "annotation_ids": [
                  "6c244d56c43882af"
                ],
                "status_id": 1,
                "text": "immediately after completing the handshake."
              }
            ],
            "",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "098644fc326c1f68"
                ],
                "status_id": 1,
                "text": "initial_max_stream_data_bidi_local (0x05):  This parameter is an"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "      "
              },
              {
                "annotation_ids": [
                  "098644fc326c1f68"
                ],
                "status_id": 1,
                "text": "integer value specifying the initial flow control limit for"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "      "
              },
              {
                "annotation_ids": [
                  "098644fc326c1f68"
                ],
                "status_id": 1,
                "text": "locally initiated bidirectional streams.  This limit applies to"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "      "
              },
              {
                "annotation_ids": [
                  "098644fc326c1f68"
                ],
                "status_id": 1,
                "text": "newly created bidirectional streams opened by the endpoint that"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "      "
              },
              {
                "annotation_ids": [
                  "098644fc326c1f68"
                ],
                "status_id": 1,
                "text": "sends the transport parameter.  In client transport parameters,"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "      "
              },
              {
                "annotation_ids": [
                  "098644fc326c1f68"
                ],
                "status_id": 1,
                "text": "this applies to streams with an identifier with the least"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "      "
              },
              {
                "annotation_ids": [
                  "098644fc326c1f68"
                ],
                "status_id": 1,
                "text": "significant two bits set to 0x00; in server transport parameters,"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "      "
              },
              {
                "annotation_ids": [
                  "098644fc326c1f68"
                ],
                "status_id": 1,
                "text": "this applies to streams with the least significant two bits set to"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "      "
              },
              {
                "annotation_ids": [
                  "098644fc326c1f68"
                ],
                "status_id": 1,
                "text": "0x01."
              }
            ],
            "",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "c310af4650a75fe2"
                ],
                "status_id": 1,
                "text": "initial_max_stream_data_bidi_remote (0x06):  This parameter is an"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "      "
              },
              {
                "annotation_ids": [
                  "c310af4650a75fe2"
                ],
                "status_id": 1,
                "text": "integer value specifying the initial flow control limit for peer-"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "      "
              },
              {
                "annotation_ids": [
                  "c310af4650a75fe2"
                ],
                "status_id": 1,
                "text": "initiated bidirectional streams.  This limit applies to newly"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "      "
              },
              {
                "annotation_ids": [
                  "c310af4650a75fe2"
                ],
                "status_id": 1,
                "text": "created bidirectional streams opened by the endpoint that receives"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "      "
              },
              {
                "annotation_ids": [
                  "c310af4650a75fe2"
                ],
                "status_id": 1,
                "text": "the transport parameter.  In client transport parameters, this"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "      "
              },
              {
                "annotation_ids": [
                  "c310af4650a75fe2"
                ],
                "status_id": 1,
                "text": "applies to streams with an identifier with the least significant"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "      "
              },
              {
                "annotation_ids": [
                  "c310af4650a75fe2"
                ],
                "status_id": 1,
                "text": "two bits set to 0x01; in server transport parameters, this applies"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "      "
              },
              {
                "annotation_ids": [
                  "c310af4650a75fe2"
                ],
                "status_id": 1,
                "text": "to streams with the least significant two bits set to 0x00."
              }
            ],
            "",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "535216324c913dc8"
                ],
                "status_id": 1,
                "text": "initial_max_stream_data_uni (0x07):  This parameter is an integer"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "      "
              },
              {
                "annotation_ids": [
                  "535216324c913dc8"
                ],
                "status_id": 1,
                "text": "value specifying the initial flow control limit for unidirectional"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "      "
              },
              {
                "annotation_ids": [
                  "535216324c913dc8"
                ],
                "status_id": 1,
                "text": "streams.  This limit applies to newly created unidirectional"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "      "
              },
              {
                "annotation_ids": [
                  "535216324c913dc8"
                ],
                "status_id": 1,
                "text": "streams opened by the endpoint that receives the transport"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "      "
              },
              {
                "annotation_ids": [
                  "535216324c913dc8"
                ],
                "status_id": 1,
                "text": "parameter.  In client transport parameters, this applies to"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "      "
              },
              {
                "annotation_ids": [
                  "535216324c913dc8"
                ],
                "status_id": 1,
                "text": "streams with an identifier with the least significant two bits set"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "      "
              },
              {
                "annotation_ids": [
                  "535216324c913dc8"
                ],
                "status_id": 1,
                "text": "to 0x03; in server transport parameters, this applies to streams"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "      "
              },
              {
                "annotation_ids": [
                  "535216324c913dc8"
                ],
                "status_id": 1,
                "text": "with the least significant two bits set to 0x02."
              }
            ],
            "",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "c5a1db4b0aad58cf"
                ],
                "status_id": 1,
                "text": "initial_max_streams_bidi (0x08):  The initial maximum bidirectional"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "      "
              },
              {
                "annotation_ids": [
                  "c5a1db4b0aad58cf"
                ],
                "status_id": 1,
                "text": "streams parameter is an integer value that contains the initial"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "      "
              },
              {
                "annotation_ids": [
                  "c5a1db4b0aad58cf"
                ],
                "status_id": 1,
                "text": "maximum number of bidirectional streams the endpoint that receives"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "      "
              },
              {
                "annotation_ids": [
                  "c5a1db4b0aad58cf"
                ],
                "status_id": 1,
                "text": "this transport parameter is permitted to initiate.  If this"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "      "
              },
              {
                "annotation_ids": [
                  "c5a1db4b0aad58cf"
                ],
                "status_id": 1,
                "text": "parameter is absent or zero, the peer cannot open bidirectional"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "      "
              },
              {
                "annotation_ids": [
                  "c5a1db4b0aad58cf"
                ],
                "status_id": 1,
                "text": "streams until a MAX_STREAMS frame is sent.  Setting this parameter"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "      "
              },
              {
                "annotation_ids": [
                  "c5a1db4b0aad58cf"
                ],
                "status_id": 1,
                "text": "is equivalent to sending a MAX_STREAMS (Section 19.11) of the"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "      "
              },
              {
                "annotation_ids": [
                  "c5a1db4b0aad58cf"
                ],
                "status_id": 1,
                "text": "corresponding type with the same value."
              }
            ],
            "",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "09d43b7db6c1e485"
                ],
                "status_id": 1,
                "text": "initial_max_streams_uni (0x09):  The initial maximum unidirectional"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "      "
              },
              {
                "annotation_ids": [
                  "09d43b7db6c1e485"
                ],
                "status_id": 1,
                "text": "streams parameter is an integer value that contains the initial"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "      "
              },
              {
                "annotation_ids": [
                  "09d43b7db6c1e485"
                ],
                "status_id": 1,
                "text": "maximum number of unidirectional streams the endpoint that"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "      "
              },
              {
                "annotation_ids": [
                  "09d43b7db6c1e485"
                ],
                "status_id": 1,
                "text": "receives this transport parameter is permitted to initiate.  If"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "      "
              },
              {
                "annotation_ids": [
                  "09d43b7db6c1e485"
                ],
                "status_id": 1,
                "text": "this parameter is absent or zero, the peer cannot open"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "      "
              },
              {
                "annotation_ids": [
                  "09d43b7db6c1e485"
                ],
                "status_id": 1,
                "text": "unidirectional streams until a MAX_STREAMS frame is sent.  Setting"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "      "
              },
              {
                "annotation_ids": [
                  "09d43b7db6c1e485"
                ],
                "status_id": 1,
                "text": "this parameter is equivalent to sending a MAX_STREAMS"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "      "
              },
              {
                "annotation_ids": [
                  "09d43b7db6c1e485"
                ],
                "status_id": 1,
                "text": "(Section 19.11) of the corresponding type with the same value."
              }
            ],
            "",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "6fe7ba1f8320f7e9"
                ],
                "status_id": 1,
                "text": "ack_delay_exponent (0x0a):  The acknowledgment delay exponent is an"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "      "
              },
              {
                "annotation_ids": [
                  "6fe7ba1f8320f7e9"
                ],
                "status_id": 1,
                "text": "integer value indicating an exponent used to decode the ACK Delay"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "      "
              },
              {
                "annotation_ids": [
                  "6fe7ba1f8320f7e9"
                ],
                "status_id": 1,
                "text": "field in the ACK frame (Section 19.3).  If this value is absent, a"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "      "
              },
              {
                "annotation_ids": [
                  "6fe7ba1f8320f7e9"
                ],
                "status_id": 1,
                "text": "default value of 3 is assumed (indicating a multiplier of 8)."
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "      "
              },
              {
                "annotation_ids": [
                  "6fe7ba1f8320f7e9"
                ],
                "status_id": 1,
                "text": "Values above 20 are invalid."
              }
            ],
            "",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "45299b1ccee5652e"
                ],
                "status_id": 1,
                "text": "max_ack_delay (0x0b):  The maximum acknowledgment delay is an integer"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "      "
              },
              {
                "annotation_ids": [
                  "45299b1ccee5652e"
                ],
                "status_id": 1,
                "text": "value indicating the maximum amount of time in milliseconds by"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "      "
              },
              {
                "annotation_ids": [
                  "45299b1ccee5652e"
                ],
                "status_id": 1,
                "text": "which the endpoint will delay sending acknowledgments.  "
              },
              {
                "annotation_ids": [
                  "45299b1ccee5652e",
                  "3a65da04bbbb6eb3"
                ],
                "status_id": 22,
                "text": "This value"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "      "
              },
              {
                "annotation_ids": [
                  "45299b1ccee5652e",
                  "3a65da04bbbb6eb3"
                ],
                "status_id": 22,
                "text": "SHOULD include the receiver's expected delays in alarms firing."
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "      "
              },
              {
                "annotation_ids": [
                  "45299b1ccee5652e"
                ],
                "status_id": 1,
                "text": "For example, if a receiver sets a timer for 5ms and alarms"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "      "
              },
              {
                "annotation_ids": [
                  "45299b1ccee5652e"
                ],
                "status_id": 1,
                "text": "commonly fire up to 1ms late, then it should send a max_ack_delay"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "      "
              },
              {
                "annotation_ids": [
                  "45299b1ccee5652e"
                ],
                "status_id": 1,
                "text": "of 6ms.  If this value is absent, a default of 25 milliseconds is"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "      "
              },
              {
                "annotation_ids": [
                  "45299b1ccee5652e"
                ],
                "status_id": 1,
                "text": "assumed.  Values of 2^14 or greater are invalid."
              }
            ],
            "",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "80f1d2cccb7d1026"
                ],
                "status_id": 1,
                "text": "disable_active_migration (0x0c):  The disable active migration"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "      "
              },
              {
                "annotation_ids": [
                  "80f1d2cccb7d1026"
                ],
                "status_id": 1,
                "text": "transport parameter is included if the endpoint does not support"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "      "
              },
              {
                "annotation_ids": [
                  "80f1d2cccb7d1026"
                ],
                "status_id": 1,
                "text": "active connection migration (Section 9) on the address being used"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "      "
              },
              {
                "annotation_ids": [
                  "80f1d2cccb7d1026"
                ],
                "status_id": 1,
                "text": "during the handshake."
              },
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "  "
              },
              {
                "annotation_ids": [
                  "5963c5878d887035"
                ],
                "status_id": 20,
                "text": "An endpoint that receives this transport"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "      "
              },
              {
                "annotation_ids": [
                  "5963c5878d887035"
                ],
                "status_id": 20,
                "text": "parameter MUST NOT use a new local address when sending to the"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "      "
              },
              {
                "annotation_ids": [
                  "5963c5878d887035"
                ],
                "status_id": 20,
                "text": "address that the peer used during the handshake."
              },
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "  This transport"
              }
            ],
            "      parameter does not prohibit connection migration after a client",
            "      has acted on a preferred_address transport parameter.  This",
            "      parameter is a zero-length value.",
            "",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "d483ac1f27888320"
                ],
                "status_id": 1,
                "text": "preferred_address (0x0d):  The server's preferred address is used to"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "      "
              },
              {
                "annotation_ids": [
                  "d483ac1f27888320"
                ],
                "status_id": 1,
                "text": "effect a change in server address at the end of the handshake, as"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "      "
              },
              {
                "annotation_ids": [
                  "d483ac1f27888320"
                ],
                "status_id": 1,
                "text": "described in Section 9.6.  This transport parameter is only sent"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "      "
              },
              {
                "annotation_ids": [
                  "d483ac1f27888320"
                ],
                "status_id": 1,
                "text": "by a server.  "
              },
              {
                "annotation_ids": [
                  "d483ac1f27888320",
                  "2d26d297d22ef4d0"
                ],
                "status_id": 21,
                "text": "Servers MAY choose to only send a preferred address"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "      "
              },
              {
                "annotation_ids": [
                  "d483ac1f27888320",
                  "2d26d297d22ef4d0"
                ],
                "status_id": 21,
                "text": "of one address family by sending an all-zero address and port"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "      "
              },
              {
                "annotation_ids": [
                  "d483ac1f27888320",
                  "2d26d297d22ef4d0"
                ],
                "status_id": 21,
                "text": "(0.0.0.0:0 or [::]:0) for the other family."
              },
              {
                "annotation_ids": [
                  "d483ac1f27888320"
                ],
                "status_id": 1,
                "text": "  IP addresses are"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "      "
              },
              {
                "annotation_ids": [
                  "d483ac1f27888320"
                ],
                "status_id": 1,
                "text": "encoded in network byte order."
              }
            ],
            "",
            "      The preferred_address transport parameter contains an address and",
            "      port for both IPv4 and IPv6.  The four-byte IPv4 Address field is",
            "      followed by the associated two-byte IPv4 Port field.  This is",
            "      followed by a 16-byte IPv6 Address field and two-byte IPv6 Port",
            "      field.  After address and port pairs, a Connection ID Length field",
            "      describes the length of the following Connection ID field.",
            "      Finally, a 16-byte Stateless Reset Token field includes the",
            "      stateless reset token associated with the connection ID.  The",
            "      format of this transport parameter is shown in Figure 22 below.",
            "",
            "      The Connection ID field and the Stateless Reset Token field",
            "      contain an alternative connection ID that has a sequence number of",
            "      1; see Section 5.1.1.  Having these values sent alongside the",
            "      preferred address ensures that there will be at least one unused",
            "      active connection ID when the client initiates migration to the",
            "      preferred address.",
            "",
            "      The Connection ID and Stateless Reset Token fields of a preferred",
            "      address are identical in syntax and semantics to the corresponding",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "      fields of a NEW_CONNECTION_ID frame (Section 19.15).  "
              },
              {
                "annotation_ids": [
                  "6f8d83a905c19b08"
                ],
                "status_id": 20,
                "text": "A server"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "      "
              },
              {
                "annotation_ids": [
                  "6f8d83a905c19b08"
                ],
                "status_id": 20,
                "text": "that chooses a zero-length connection ID MUST NOT provide a"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "      "
              },
              {
                "annotation_ids": [
                  "6f8d83a905c19b08"
                ],
                "status_id": 20,
                "text": "preferred address."
              },
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "  "
              },
              {
                "annotation_ids": [
                  "85b5b7d4b9ddc733"
                ],
                "status_id": 20,
                "text": "Similarly, a server MUST NOT include a zero-"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "      "
              },
              {
                "annotation_ids": [
                  "85b5b7d4b9ddc733"
                ],
                "status_id": 20,
                "text": "length connection ID in this transport parameter."
              },
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "  "
              },
              {
                "annotation_ids": [
                  "a4b3a3578baac8b5"
                ],
                "status_id": 20,
                "text": "A client MUST"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "      "
              },
              {
                "annotation_ids": [
                  "a4b3a3578baac8b5"
                ],
                "status_id": 20,
                "text": "treat a violation of these requirements as a connection error of"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "      "
              },
              {
                "annotation_ids": [
                  "a4b3a3578baac8b5"
                ],
                "status_id": 20,
                "text": "type TRANSPORT_PARAMETER_ERROR."
              }
            ],
            "",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "c4a3e712b79b9f4c"
                ],
                "status_id": 1,
                "text": "Preferred Address {"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "     "
              },
              {
                "annotation_ids": [
                  "c4a3e712b79b9f4c"
                ],
                "status_id": 1,
                "text": "IPv4 Address (32),"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "     "
              },
              {
                "annotation_ids": [
                  "c4a3e712b79b9f4c"
                ],
                "status_id": 1,
                "text": "IPv4 Port (16),"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "     "
              },
              {
                "annotation_ids": [
                  "c4a3e712b79b9f4c"
                ],
                "status_id": 1,
                "text": "IPv6 Address (128),"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "     "
              },
              {
                "annotation_ids": [
                  "c4a3e712b79b9f4c"
                ],
                "status_id": 1,
                "text": "IPv6 Port (16),"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "     "
              },
              {
                "annotation_ids": [
                  "c4a3e712b79b9f4c"
                ],
                "status_id": 1,
                "text": "Connection ID Length (8),"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "     "
              },
              {
                "annotation_ids": [
                  "c4a3e712b79b9f4c"
                ],
                "status_id": 1,
                "text": "Connection ID (..),"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "     "
              },
              {
                "annotation_ids": [
                  "c4a3e712b79b9f4c"
                ],
                "status_id": 1,
                "text": "Stateless Reset Token (128),"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "}"
              }
            ],
            "",
            "                    Figure 22: Preferred Address Format",
            "",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "d72c9aae7e699b1d",
                  "349a88a6b74d7ef7"
                ],
                "status_id": 1,
                "text": "active_connection_id_limit (0x0e):  "
              },
              {
                "annotation_ids": [
                  "d72c9aae7e699b1d",
                  "bb73aac7171f8307",
                  "349a88a6b74d7ef7"
                ],
                "status_id": 1,
                "text": "This is an integer value"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "      "
              },
              {
                "annotation_ids": [
                  "d72c9aae7e699b1d",
                  "bb73aac7171f8307",
                  "349a88a6b74d7ef7"
                ],
                "status_id": 1,
                "text": "specifying the maximum number of connection IDs from the peer that"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "      "
              },
              {
                "annotation_ids": [
                  "d72c9aae7e699b1d",
                  "bb73aac7171f8307",
                  "349a88a6b74d7ef7"
                ],
                "status_id": 1,
                "text": "an endpoint is willing to store.  This value includes the"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "      "
              },
              {
                "annotation_ids": [
                  "d72c9aae7e699b1d",
                  "bb73aac7171f8307",
                  "349a88a6b74d7ef7"
                ],
                "status_id": 1,
                "text": "connection ID received during the handshake, that received in the"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "      "
              },
              {
                "annotation_ids": [
                  "d72c9aae7e699b1d",
                  "bb73aac7171f8307",
                  "349a88a6b74d7ef7"
                ],
                "status_id": 1,
                "text": "preferred_address transport parameter, and those received in"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "      "
              },
              {
                "annotation_ids": [
                  "d72c9aae7e699b1d",
                  "bb73aac7171f8307",
                  "349a88a6b74d7ef7"
                ],
                "status_id": 1,
                "text": "NEW_CONNECTION_ID frames."
              },
              {
                "annotation_ids": [
                  "d72c9aae7e699b1d",
                  "bb73aac7171f8307"
                ],
                "status_id": 1,
                "text": "  "
              },
              {
                "annotation_ids": [
                  "d72c9aae7e699b1d",
                  "6db20d63130f81dc",
                  "bb73aac7171f8307",
                  "214d85c3c94ea9f2"
                ],
                "status_id": 9,
                "text": "The value of the"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "      "
              },
              {
                "annotation_ids": [
                  "d72c9aae7e699b1d",
                  "6db20d63130f81dc",
                  "bb73aac7171f8307",
                  "214d85c3c94ea9f2"
                ],
                "status_id": 9,
                "text": "active_connection_id_limit parameter MUST be at least 2."
              },
              {
                "annotation_ids": [
                  "d72c9aae7e699b1d"
                ],
                "status_id": 1,
                "text": "  "
              },
              {
                "annotation_ids": [
                  "d72c9aae7e699b1d",
                  "f2e19c5ca62c87df"
                ],
                "status_id": 13,
                "text": "An"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "      "
              },
              {
                "annotation_ids": [
                  "d72c9aae7e699b1d",
                  "f2e19c5ca62c87df"
                ],
                "status_id": 13,
                "text": "endpoint that receives a value less than 2 MUST close the"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "      "
              },
              {
                "annotation_ids": [
                  "d72c9aae7e699b1d",
                  "f2e19c5ca62c87df"
                ],
                "status_id": 13,
                "text": "connection with an error of type TRANSPORT_PARAMETER_ERROR."
              },
              {
                "annotation_ids": [
                  "d72c9aae7e699b1d"
                ],
                "status_id": 1,
                "text": "  If"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "      "
              },
              {
                "annotation_ids": [
                  "d72c9aae7e699b1d"
                ],
                "status_id": 1,
                "text": "this transport parameter is absent, a default of 2 is assumed.  If"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "      "
              },
              {
                "annotation_ids": [
                  "d72c9aae7e699b1d"
                ],
                "status_id": 1,
                "text": "an endpoint issues a zero-length connection ID, it will never send"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "      "
              },
              {
                "annotation_ids": [
                  "d72c9aae7e699b1d"
                ],
                "status_id": 1,
                "text": "a NEW_CONNECTION_ID frame and therefore ignores the"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "      "
              },
              {
                "annotation_ids": [
                  "d72c9aae7e699b1d"
                ],
                "status_id": 1,
                "text": "active_connection_id_limit value received from its peer."
              }
            ],
            "",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "5dc30b2046662b54"
                ],
                "status_id": 1,
                "text": "initial_source_connection_id (0x0f):  This is the value that the"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "      "
              },
              {
                "annotation_ids": [
                  "5dc30b2046662b54"
                ],
                "status_id": 1,
                "text": "endpoint included in the Source Connection ID field of the first"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "      "
              },
              {
                "annotation_ids": [
                  "5dc30b2046662b54"
                ],
                "status_id": 1,
                "text": "Initial packet it sends for the connection; see Section 7.3."
              }
            ],
            "",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "29ec1f572e90c6fc"
                ],
                "status_id": 1,
                "text": "retry_source_connection_id (0x10):  This is the value that the server"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "      "
              },
              {
                "annotation_ids": [
                  "29ec1f572e90c6fc"
                ],
                "status_id": 1,
                "text": "included in the Source Connection ID field of a Retry packet; see"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "      "
              },
              {
                "annotation_ids": [
                  "29ec1f572e90c6fc"
                ],
                "status_id": 1,
                "text": "Section 7.3.  This transport parameter is only sent by a server."
              }
            ],
            "",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "3ab9d535d0447885"
                ],
                "status_id": 1,
                "text": "If present, transport parameters that set initial per-stream flow"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "3ab9d535d0447885"
                ],
                "status_id": 1,
                "text": "control limits (initial_max_stream_data_bidi_local,"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "3ab9d535d0447885"
                ],
                "status_id": 1,
                "text": "initial_max_stream_data_bidi_remote, and initial_max_stream_data_uni)"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "3ab9d535d0447885"
                ],
                "status_id": 1,
                "text": "are equivalent to sending a MAX_STREAM_DATA frame (Section 19.10) on"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "3ab9d535d0447885"
                ],
                "status_id": 1,
                "text": "every stream of the corresponding type immediately after opening.  If"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "3ab9d535d0447885"
                ],
                "status_id": 1,
                "text": "the transport parameter is absent, streams of that type start with a"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "3ab9d535d0447885"
                ],
                "status_id": 1,
                "text": "flow control limit of 0."
              }
            ],
            "",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "61faf210d04e2893",
                  "981c2c2990df14b6"
                ],
                "status_id": 13,
                "text": "A client MUST NOT include any server-only transport parameter:"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "61faf210d04e2893",
                  "981c2c2990df14b6"
                ],
                "status_id": 13,
                "text": "original_destination_connection_id, preferred_address,"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "61faf210d04e2893",
                  "981c2c2990df14b6"
                ],
                "status_id": 13,
                "text": "retry_source_connection_id, or stateless_reset_token."
              },
              {
                "annotation_ids": [
                  "61faf210d04e2893"
                ],
                "status_id": 1,
                "text": "  "
              },
              {
                "annotation_ids": [
                  "61faf210d04e2893",
                  "0a5bc3b881201331"
                ],
                "status_id": 13,
                "text": "A server MUST"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "61faf210d04e2893",
                  "0a5bc3b881201331"
                ],
                "status_id": 13,
                "text": "treat receipt of any of these transport parameters as a connection"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "61faf210d04e2893",
                  "0a5bc3b881201331"
                ],
                "status_id": 13,
                "text": "error of type TRANSPORT_PARAMETER_ERROR."
              }
            ]
          ],
          "requirements": [
            "c0906d958d1a4455",
            "c0906d958d1a4455",
            "3a65da04bbbb6eb3",
            "3a65da04bbbb6eb3",
            "5963c5878d887035",
            "5963c5878d887035",
            "5963c5878d887035",
            "2d26d297d22ef4d0",
            "2d26d297d22ef4d0",
            "2d26d297d22ef4d0",
            "6f8d83a905c19b08",
            "6f8d83a905c19b08",
            "6f8d83a905c19b08",
            "85b5b7d4b9ddc733",
            "85b5b7d4b9ddc733",
            "a4b3a3578baac8b5",
            "a4b3a3578baac8b5",
            "a4b3a3578baac8b5",
            "214d85c3c94ea9f2",
            "214d85c3c94ea9f2",
            "f2e19c5ca62c87df",
            "f2e19c5ca62c87df",
            "f2e19c5ca62c87df",
            "981c2c2990df14b6",
            "981c2c2990df14b6",
            "981c2c2990df14b6",
            "0a5bc3b881201331",
            "0a5bc3b881201331",
            "0a5bc3b881201331"
          ],
          "title": "Transport Parameter Definitions"
        },
        {
          "id": "section-19",
          "lines": [
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "0c34522bfe95fd4d"
                ],
                "status_id": 1,
                "text": "As described in Section 12.4, packets contain one or more frames."
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "0c34522bfe95fd4d"
                ],
                "status_id": 1,
                "text": "This section describes the format and semantics of the core QUIC"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "0c34522bfe95fd4d"
                ],
                "status_id": 1,
                "text": "frame types."
              }
            ]
          ],
          "title": "Frame Types and Formats"
        },
        {
          "id": "section-19.1",
          "lines": [
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "ff8c38ba26f9494b",
                  "25b9b5560c9fae5c"
                ],
                "status_id": 1,
                "text": "A PADDING frame (type=0x00) has no semantic value.  PADDING frames"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "ff8c38ba26f9494b",
                  "25b9b5560c9fae5c"
                ],
                "status_id": 1,
                "text": "can be used to increase the size of a packet.  Padding can be used to"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "ff8c38ba26f9494b",
                  "25b9b5560c9fae5c"
                ],
                "status_id": 1,
                "text": "increase an Initial packet to the minimum required size or to provide"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "ff8c38ba26f9494b",
                  "25b9b5560c9fae5c"
                ],
                "status_id": 1,
                "text": "protection against traffic analysis for protected packets."
              }
            ],
            "",
            "   PADDING frames are formatted as shown in Figure 23, which shows that",
            "   PADDING frames have no content.  That is, a PADDING frame consists of",
            "   the single byte that identifies the frame as a PADDING frame.",
            "",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "241ab123dac7c622"
                ],
                "status_id": 1,
                "text": "PADDING Frame {"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "     "
              },
              {
                "annotation_ids": [
                  "241ab123dac7c622"
                ],
                "status_id": 1,
                "text": "Type (i) = 0x00,"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "}"
              }
            ],
            "",
            "                      Figure 23: PADDING Frame Format"
          ],
          "title": "PADDING Frames"
        },
        {
          "id": "section-19.2",
          "lines": [
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "9f6dbebf1629e839",
                  "a95bcddddb0d5864"
                ],
                "status_id": 1,
                "text": "Endpoints can use PING frames (type=0x01) to verify that their peers"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "9f6dbebf1629e839",
                  "a95bcddddb0d5864"
                ],
                "status_id": 1,
                "text": "are still alive or to check reachability to the peer."
              }
            ],
            "",
            "   PING frames are formatted as shown in Figure 24, which shows that",
            "   PING frames have no content.",
            "",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "a4a048642b123f04"
                ],
                "status_id": 1,
                "text": "PING Frame {"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "     "
              },
              {
                "annotation_ids": [
                  "a4a048642b123f04"
                ],
                "status_id": 1,
                "text": "Type (i) = 0x01,"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "}"
              }
            ],
            "",
            "                        Figure 24: PING Frame Format",
            "",
            "   The receiver of a PING frame simply needs to acknowledge the packet",
            "   containing this frame.",
            "",
            "   The PING frame can be used to keep a connection alive when an",
            "   application or application protocol wishes to prevent the connection",
            "   from timing out; see Section 10.1.2."
          ],
          "title": "PING Frames"
        },
        {
          "id": "section-19.3",
          "lines": [
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "aa2151730d864c68"
                ],
                "status_id": 1,
                "text": "Receivers send ACK frames (types 0x02 and 0x03) to inform senders of"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "aa2151730d864c68"
                ],
                "status_id": 1,
                "text": "packets they have received and processed.  The ACK frame contains one"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "aa2151730d864c68"
                ],
                "status_id": 1,
                "text": "or more ACK Ranges.  ACK Ranges identify acknowledged packets.  If"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "aa2151730d864c68"
                ],
                "status_id": 1,
                "text": "the frame type is 0x03, ACK frames also contain the cumulative count"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "aa2151730d864c68"
                ],
                "status_id": 1,
                "text": "of QUIC packets with associated ECN marks received on the connection"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "aa2151730d864c68"
                ],
                "status_id": 1,
                "text": "up until this point."
              },
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "  "
              },
              {
                "annotation_ids": [
                  "7ed99c1b1e7726ef"
                ],
                "status_id": 20,
                "text": "QUIC implementations MUST properly handle both"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "7ed99c1b1e7726ef"
                ],
                "status_id": 20,
                "text": "types, and, if they have enabled ECN for packets they send, they"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "7ed99c1b1e7726ef"
                ],
                "status_id": 20,
                "text": "SHOULD use the information in the ECN section to manage their"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "7ed99c1b1e7726ef"
                ],
                "status_id": 20,
                "text": "congestion state."
              }
            ],
            "",
            "   QUIC acknowledgments are irrevocable.  Once acknowledged, a packet",
            "   remains acknowledged, even if it does not appear in a future ACK",
            "   frame.  This is unlike reneging for TCP Selective Acknowledgments",
            "   (SACKs) [RFC2018].",
            "",
            "   Packets from different packet number spaces can be identified using",
            "   the same numeric value.  An acknowledgment for a packet needs to",
            "   indicate both a packet number and a packet number space.  This is",
            "   accomplished by having each ACK frame only acknowledge packet numbers",
            "   in the same space as the packet in which the ACK frame is contained.",
            "",
            "   Version Negotiation and Retry packets cannot be acknowledged because",
            "   they do not contain a packet number.  Rather than relying on ACK",
            "   frames, these packets are implicitly acknowledged by the next Initial",
            "   packet sent by the client.",
            "",
            "   ACK frames are formatted as shown in Figure 25.",
            "",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "462770d228fd17ff"
                ],
                "status_id": 1,
                "text": "ACK Frame {"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "     "
              },
              {
                "annotation_ids": [
                  "462770d228fd17ff"
                ],
                "status_id": 1,
                "text": "Type (i) = 0x02..0x03,"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "     "
              },
              {
                "annotation_ids": [
                  "462770d228fd17ff"
                ],
                "status_id": 1,
                "text": "Largest Acknowledged (i),"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "     "
              },
              {
                "annotation_ids": [
                  "462770d228fd17ff"
                ],
                "status_id": 1,
                "text": "ACK Delay (i),"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "     "
              },
              {
                "annotation_ids": [
                  "462770d228fd17ff"
                ],
                "status_id": 1,
                "text": "ACK Range Count (i),"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "     "
              },
              {
                "annotation_ids": [
                  "462770d228fd17ff"
                ],
                "status_id": 1,
                "text": "First ACK Range (i),"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "     "
              },
              {
                "annotation_ids": [
                  "462770d228fd17ff"
                ],
                "status_id": 1,
                "text": "ACK Range (..) ...,"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "     "
              },
              {
                "annotation_ids": [
                  "462770d228fd17ff"
                ],
                "status_id": 1,
                "text": "[ECN Counts (..)],"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "}"
              }
            ],
            "",
            "                        Figure 25: ACK Frame Format",
            "",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "2de6036b3b988fcc"
                ],
                "status_id": 1,
                "text": "ACK frames contain the following fields:"
              }
            ],
            "",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "2de6036b3b988fcc"
                ],
                "status_id": 1,
                "text": "Largest Acknowledged:  A variable-length integer representing the"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "      "
              },
              {
                "annotation_ids": [
                  "2de6036b3b988fcc"
                ],
                "status_id": 1,
                "text": "largest packet number the peer is acknowledging; this is usually"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "      "
              },
              {
                "annotation_ids": [
                  "2de6036b3b988fcc"
                ],
                "status_id": 1,
                "text": "the largest packet number that the peer has received prior to"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "      "
              },
              {
                "annotation_ids": [
                  "2de6036b3b988fcc"
                ],
                "status_id": 1,
                "text": "generating the ACK frame.  Unlike the packet number in the QUIC"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "      "
              },
              {
                "annotation_ids": [
                  "2de6036b3b988fcc"
                ],
                "status_id": 1,
                "text": "long or short header, the value in an ACK frame is not truncated."
              }
            ],
            "",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "fff00c95b97ec45b",
                  "2de6036b3b988fcc"
                ],
                "status_id": 1,
                "text": "ACK Delay:  A variable-length integer encoding the acknowledgment"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "      "
              },
              {
                "annotation_ids": [
                  "fff00c95b97ec45b",
                  "2de6036b3b988fcc"
                ],
                "status_id": 1,
                "text": "delay in microseconds; see Section 13.2.5.  It is decoded by"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "      "
              },
              {
                "annotation_ids": [
                  "fff00c95b97ec45b",
                  "2de6036b3b988fcc"
                ],
                "status_id": 1,
                "text": "multiplying the value in the field by 2 to the power of the"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "      "
              },
              {
                "annotation_ids": [
                  "fff00c95b97ec45b",
                  "2de6036b3b988fcc"
                ],
                "status_id": 1,
                "text": "ack_delay_exponent transport parameter sent by the sender of the"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "      "
              },
              {
                "annotation_ids": [
                  "fff00c95b97ec45b",
                  "2de6036b3b988fcc"
                ],
                "status_id": 1,
                "text": "ACK frame; see Section 18.2.  Compared to simply expressing the"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "      "
              },
              {
                "annotation_ids": [
                  "fff00c95b97ec45b",
                  "2de6036b3b988fcc"
                ],
                "status_id": 1,
                "text": "delay as an integer, this encoding allows for a larger range of"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "      "
              },
              {
                "annotation_ids": [
                  "fff00c95b97ec45b",
                  "2de6036b3b988fcc"
                ],
                "status_id": 1,
                "text": "values within the same number of bytes, at the cost of lower"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "      "
              },
              {
                "annotation_ids": [
                  "fff00c95b97ec45b",
                  "2de6036b3b988fcc"
                ],
                "status_id": 1,
                "text": "resolution."
              }
            ],
            "",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "2de6036b3b988fcc"
                ],
                "status_id": 1,
                "text": "ACK Range Count:  A variable-length integer specifying the number of"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "      "
              },
              {
                "annotation_ids": [
                  "2de6036b3b988fcc"
                ],
                "status_id": 1,
                "text": "ACK Range fields in the frame."
              }
            ],
            "",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "2de6036b3b988fcc"
                ],
                "status_id": 1,
                "text": "First ACK Range:  A variable-length integer indicating the number of"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "      "
              },
              {
                "annotation_ids": [
                  "2de6036b3b988fcc"
                ],
                "status_id": 1,
                "text": "contiguous packets preceding the Largest Acknowledged that are"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "      "
              },
              {
                "annotation_ids": [
                  "2de6036b3b988fcc"
                ],
                "status_id": 1,
                "text": "being acknowledged.  That is, the smallest packet acknowledged in"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "      "
              },
              {
                "annotation_ids": [
                  "2de6036b3b988fcc"
                ],
                "status_id": 1,
                "text": "the range is determined by subtracting the First ACK Range value"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "      "
              },
              {
                "annotation_ids": [
                  "2de6036b3b988fcc"
                ],
                "status_id": 1,
                "text": "from the Largest Acknowledged field."
              }
            ],
            "",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "2de6036b3b988fcc"
                ],
                "status_id": 1,
                "text": "ACK Ranges:  Contains additional ranges of packets that are"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "      "
              },
              {
                "annotation_ids": [
                  "2de6036b3b988fcc"
                ],
                "status_id": 1,
                "text": "alternately not acknowledged (Gap) and acknowledged (ACK Range);"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "      "
              },
              {
                "annotation_ids": [
                  "2de6036b3b988fcc"
                ],
                "status_id": 1,
                "text": "see Section 19.3.1."
              }
            ],
            "",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "2de6036b3b988fcc"
                ],
                "status_id": 1,
                "text": "ECN Counts:  The three ECN counts; see Section 19.3.2."
              }
            ]
          ],
          "requirements": [
            "7ed99c1b1e7726ef",
            "7ed99c1b1e7726ef",
            "7ed99c1b1e7726ef",
            "7ed99c1b1e7726ef"
          ],
          "title": "ACK Frames"
        },
        {
          "id": "section-19.3.1",
          "lines": [
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "9556e5c71d8dee76",
                  "a28af31491857c09"
                ],
                "status_id": 1,
                "text": "Each ACK Range consists of alternating Gap and ACK Range Length"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "9556e5c71d8dee76",
                  "a28af31491857c09"
                ],
                "status_id": 1,
                "text": "values in descending packet number order.  ACK Ranges can be"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "9556e5c71d8dee76",
                  "a28af31491857c09"
                ],
                "status_id": 1,
                "text": "repeated.  The number of Gap and ACK Range Length values is"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "9556e5c71d8dee76",
                  "a28af31491857c09"
                ],
                "status_id": 1,
                "text": "determined by the ACK Range Count field; one of each value is present"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "9556e5c71d8dee76",
                  "a28af31491857c09"
                ],
                "status_id": 1,
                "text": "for each value in the ACK Range Count field."
              }
            ],
            "",
            "   ACK Ranges are structured as shown in Figure 26.",
            "",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "4b41599016a770d5"
                ],
                "status_id": 1,
                "text": "ACK Range {"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "     "
              },
              {
                "annotation_ids": [
                  "4b41599016a770d5"
                ],
                "status_id": 1,
                "text": "Gap (i),"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "     "
              },
              {
                "annotation_ids": [
                  "4b41599016a770d5"
                ],
                "status_id": 1,
                "text": "ACK Range Length (i),"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "}"
              }
            ],
            "",
            "                           Figure 26: ACK Ranges",
            "",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "bc6e3ec03098d23f"
                ],
                "status_id": 1,
                "text": "The fields that form each ACK Range are:"
              }
            ],
            "",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "bc6e3ec03098d23f"
                ],
                "status_id": 1,
                "text": "Gap:  A variable-length integer indicating the number of contiguous"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "      "
              },
              {
                "annotation_ids": [
                  "bc6e3ec03098d23f"
                ],
                "status_id": 1,
                "text": "unacknowledged packets preceding the packet number one lower than"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "      "
              },
              {
                "annotation_ids": [
                  "bc6e3ec03098d23f"
                ],
                "status_id": 1,
                "text": "the smallest in the preceding ACK Range."
              }
            ],
            "",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "bc6e3ec03098d23f"
                ],
                "status_id": 1,
                "text": "ACK Range Length:  A variable-length integer indicating the number of"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "      "
              },
              {
                "annotation_ids": [
                  "bc6e3ec03098d23f"
                ],
                "status_id": 1,
                "text": "contiguous acknowledged packets preceding the largest packet"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "      "
              },
              {
                "annotation_ids": [
                  "bc6e3ec03098d23f"
                ],
                "status_id": 1,
                "text": "number, as determined by the preceding Gap."
              }
            ],
            "",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "bc6e3ec03098d23f"
                ],
                "status_id": 1,
                "text": "Gap and ACK Range Length values use a relative integer encoding for"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "bc6e3ec03098d23f"
                ],
                "status_id": 1,
                "text": "efficiency.  Though each encoded value is positive, the values are"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "bc6e3ec03098d23f"
                ],
                "status_id": 1,
                "text": "subtracted, so that each ACK Range describes progressively lower-"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "bc6e3ec03098d23f"
                ],
                "status_id": 1,
                "text": "numbered packets."
              }
            ],
            "",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "bc6e3ec03098d23f"
                ],
                "status_id": 1,
                "text": "Each ACK Range acknowledges a contiguous range of packets by"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "bc6e3ec03098d23f"
                ],
                "status_id": 1,
                "text": "indicating the number of acknowledged packets that precede the"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "bc6e3ec03098d23f"
                ],
                "status_id": 1,
                "text": "largest packet number in that range.  A value of 0 indicates that"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "bc6e3ec03098d23f"
                ],
                "status_id": 1,
                "text": "only the largest packet number is acknowledged.  Larger ACK Range"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "bc6e3ec03098d23f"
                ],
                "status_id": 1,
                "text": "values indicate a larger range, with corresponding lower values for"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "bc6e3ec03098d23f"
                ],
                "status_id": 1,
                "text": "the smallest packet number in the range.  Thus, given a largest"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "bc6e3ec03098d23f"
                ],
                "status_id": 1,
                "text": "packet number for the range, the smallest value is determined by the"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "bc6e3ec03098d23f"
                ],
                "status_id": 1,
                "text": "following formula:"
              }
            ],
            "",
            "      smallest = largest - ack_range",
            "",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "7ff17e5244d749d7"
                ],
                "status_id": 1,
                "text": "An ACK Range acknowledges all packets between the smallest packet"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "7ff17e5244d749d7"
                ],
                "status_id": 1,
                "text": "number and the largest, inclusive."
              }
            ],
            "",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "7ff17e5244d749d7"
                ],
                "status_id": 1,
                "text": "The largest value for an ACK Range is determined by cumulatively"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "7ff17e5244d749d7"
                ],
                "status_id": 1,
                "text": "subtracting the size of all preceding ACK Range Lengths and Gaps."
              }
            ],
            "",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "7ff17e5244d749d7"
                ],
                "status_id": 1,
                "text": "Each Gap indicates a range of packets that are not being"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "7ff17e5244d749d7"
                ],
                "status_id": 1,
                "text": "acknowledged.  The number of packets in the gap is one higher than"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "7ff17e5244d749d7"
                ],
                "status_id": 1,
                "text": "the encoded value of the Gap field."
              }
            ],
            "",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "7ff17e5244d749d7"
                ],
                "status_id": 1,
                "text": "The value of the Gap field establishes the largest packet number"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "7ff17e5244d749d7"
                ],
                "status_id": 1,
                "text": "value for the subsequent ACK Range using the following formula:"
              }
            ],
            "",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "      "
              },
              {
                "annotation_ids": [
                  "7ff17e5244d749d7"
                ],
                "status_id": 1,
                "text": "largest = previous_smallest - gap - 2"
              }
            ],
            "",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "5721fcde251456bc",
                  "b3e143e567183bec"
                ],
                "status_id": 13,
                "text": "If any computed packet number is negative, an endpoint MUST generate"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "5721fcde251456bc",
                  "b3e143e567183bec"
                ],
                "status_id": 13,
                "text": "a connection error of type FRAME_ENCODING_ERROR."
              }
            ]
          ],
          "requirements": [
            "b3e143e567183bec",
            "b3e143e567183bec"
          ],
          "title": "ACK Ranges"
        },
        {
          "id": "section-19.3.2",
          "lines": [
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "fa53f20066dd83f6"
                ],
                "status_id": 1,
                "text": "The ACK frame uses the least significant bit of the type value (that"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "fa53f20066dd83f6"
                ],
                "status_id": 1,
                "text": "is, type 0x03) to indicate ECN feedback and report receipt of QUIC"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "fa53f20066dd83f6"
                ],
                "status_id": 1,
                "text": "packets with associated ECN codepoints of ECT(0), ECT(1), or ECN-CE"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "fa53f20066dd83f6"
                ],
                "status_id": 1,
                "text": "in the packet's IP header.  ECN counts are only present when the ACK"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "fa53f20066dd83f6"
                ],
                "status_id": 1,
                "text": "frame type is 0x03."
              }
            ],
            "",
            "   When present, there are three ECN counts, as shown in Figure 27.",
            "",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "3c27f351c4237b90"
                ],
                "status_id": 1,
                "text": "ECN Counts {"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "     "
              },
              {
                "annotation_ids": [
                  "3c27f351c4237b90"
                ],
                "status_id": 1,
                "text": "ECT0 Count (i),"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "     "
              },
              {
                "annotation_ids": [
                  "3c27f351c4237b90"
                ],
                "status_id": 1,
                "text": "ECT1 Count (i),"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "     "
              },
              {
                "annotation_ids": [
                  "3c27f351c4237b90"
                ],
                "status_id": 1,
                "text": "ECN-CE Count (i),"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "}"
              }
            ],
            "",
            "                        Figure 27: ECN Count Format",
            "",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "425e684ab0b2daeb"
                ],
                "status_id": 1,
                "text": "The ECN count fields are:"
              }
            ],
            "",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "425e684ab0b2daeb"
                ],
                "status_id": 1,
                "text": "ECT0 Count:  A variable-length integer representing the total number"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "      "
              },
              {
                "annotation_ids": [
                  "425e684ab0b2daeb"
                ],
                "status_id": 1,
                "text": "of packets received with the ECT(0) codepoint in the packet number"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "      "
              },
              {
                "annotation_ids": [
                  "425e684ab0b2daeb"
                ],
                "status_id": 1,
                "text": "space of the ACK frame."
              }
            ],
            "",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "425e684ab0b2daeb"
                ],
                "status_id": 1,
                "text": "ECT1 Count:  A variable-length integer representing the total number"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "      "
              },
              {
                "annotation_ids": [
                  "425e684ab0b2daeb"
                ],
                "status_id": 1,
                "text": "of packets received with the ECT(1) codepoint in the packet number"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "      "
              },
              {
                "annotation_ids": [
                  "425e684ab0b2daeb"
                ],
                "status_id": 1,
                "text": "space of the ACK frame."
              }
            ],
            "",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "425e684ab0b2daeb"
                ],
                "status_id": 1,
                "text": "ECN-CE Count:  A variable-length integer representing the total"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "      "
              },
              {
                "annotation_ids": [
                  "425e684ab0b2daeb"
                ],
                "status_id": 1,
                "text": "number of packets received with the ECN-CE codepoint in the packet"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "      "
              },
              {
                "annotation_ids": [
                  "425e684ab0b2daeb"
                ],
                "status_id": 1,
                "text": "number space of the ACK frame."
              }
            ],
            "",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "425e684ab0b2daeb"
                ],
                "status_id": 1,
                "text": "ECN counts are maintained separately for each packet number space."
              }
            ]
          ],
          "title": "ECN Counts"
        },
        {
          "id": "section-19.4",
          "lines": [
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "8e566a3459531933"
                ],
                "status_id": 1,
                "text": "An endpoint uses a RESET_STREAM frame (type=0x04) to abruptly"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "8e566a3459531933"
                ],
                "status_id": 1,
                "text": "terminate the sending part of a stream."
              }
            ],
            "",
            "   After sending a RESET_STREAM, an endpoint ceases transmission and",
            "   retransmission of STREAM frames on the identified stream.  A receiver",
            "   of RESET_STREAM can discard any data that it already received on that",
            "   stream.",
            "",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "10270cc91771ca1a"
                ],
                "status_id": 20,
                "text": "An endpoint that receives a RESET_STREAM frame for a send-only stream"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "10270cc91771ca1a"
                ],
                "status_id": 20,
                "text": "MUST terminate the connection with error STREAM_STATE_ERROR."
              }
            ],
            "",
            "   RESET_STREAM frames are formatted as shown in Figure 28.",
            "",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "b998306d367a8d46"
                ],
                "status_id": 1,
                "text": "RESET_STREAM Frame {"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "     "
              },
              {
                "annotation_ids": [
                  "b998306d367a8d46"
                ],
                "status_id": 1,
                "text": "Type (i) = 0x04,"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "     "
              },
              {
                "annotation_ids": [
                  "b998306d367a8d46"
                ],
                "status_id": 1,
                "text": "Stream ID (i),"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "     "
              },
              {
                "annotation_ids": [
                  "b998306d367a8d46"
                ],
                "status_id": 1,
                "text": "Application Protocol Error Code (i),"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "     "
              },
              {
                "annotation_ids": [
                  "b998306d367a8d46"
                ],
                "status_id": 1,
                "text": "Final Size (i),"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "}"
              }
            ],
            "",
            "                    Figure 28: RESET_STREAM Frame Format",
            "",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "14ec13c08946a355"
                ],
                "status_id": 1,
                "text": "RESET_STREAM frames contain the following fields:"
              }
            ],
            "",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "14ec13c08946a355"
                ],
                "status_id": 1,
                "text": "Stream ID:  A variable-length integer encoding of the stream ID of"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "      "
              },
              {
                "annotation_ids": [
                  "14ec13c08946a355"
                ],
                "status_id": 1,
                "text": "the stream being terminated."
              }
            ],
            "",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "14ec13c08946a355"
                ],
                "status_id": 1,
                "text": "Application Protocol Error Code:  A variable-length integer"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "      "
              },
              {
                "annotation_ids": [
                  "14ec13c08946a355"
                ],
                "status_id": 1,
                "text": "containing the application protocol error code (see Section 20.2)"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "      "
              },
              {
                "annotation_ids": [
                  "14ec13c08946a355"
                ],
                "status_id": 1,
                "text": "that indicates why the stream is being closed."
              }
            ],
            "",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "14ec13c08946a355"
                ],
                "status_id": 1,
                "text": "Final Size:  A variable-length integer indicating the final size of"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "      "
              },
              {
                "annotation_ids": [
                  "14ec13c08946a355"
                ],
                "status_id": 1,
                "text": "the stream by the RESET_STREAM sender, in units of bytes; see"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "      "
              },
              {
                "annotation_ids": [
                  "14ec13c08946a355"
                ],
                "status_id": 1,
                "text": "Section 4.5."
              }
            ]
          ],
          "requirements": [
            "10270cc91771ca1a",
            "10270cc91771ca1a"
          ],
          "title": "RESET_STREAM Frames"
        },
        {
          "id": "section-19.5",
          "lines": [
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "888e398948a8a5ca"
                ],
                "status_id": 1,
                "text": "An endpoint uses a STOP_SENDING frame (type=0x05) to communicate that"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "888e398948a8a5ca"
                ],
                "status_id": 1,
                "text": "incoming data is being discarded on receipt per application request."
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "888e398948a8a5ca"
                ],
                "status_id": 1,
                "text": "STOP_SENDING requests that a peer cease transmission on a stream."
              }
            ],
            "",
            "   A STOP_SENDING frame can be sent for streams in the \"Recv\" or \"Size",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   Known\" states; see Section 3.2.  "
              },
              {
                "annotation_ids": [
                  "bc862f05dfe4fb8f"
                ],
                "status_id": 20,
                "text": "Receiving a STOP_SENDING frame for a"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "bc862f05dfe4fb8f"
                ],
                "status_id": 20,
                "text": "locally initiated stream that has not yet been created MUST be"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "bc862f05dfe4fb8f"
                ],
                "status_id": 20,
                "text": "treated as a connection error of type STREAM_STATE_ERROR."
              },
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "  "
              },
              {
                "annotation_ids": [
                  "97dde5d724e76890"
                ],
                "status_id": 20,
                "text": "An"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "97dde5d724e76890"
                ],
                "status_id": 20,
                "text": "endpoint that receives a STOP_SENDING frame for a receive-only stream"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "97dde5d724e76890"
                ],
                "status_id": 20,
                "text": "MUST terminate the connection with error STREAM_STATE_ERROR."
              }
            ],
            "",
            "   STOP_SENDING frames are formatted as shown in Figure 29.",
            "",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "8a5d518ad2e3be4c"
                ],
                "status_id": 1,
                "text": "STOP_SENDING Frame {"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "     "
              },
              {
                "annotation_ids": [
                  "8a5d518ad2e3be4c"
                ],
                "status_id": 1,
                "text": "Type (i) = 0x05,"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "     "
              },
              {
                "annotation_ids": [
                  "8a5d518ad2e3be4c"
                ],
                "status_id": 1,
                "text": "Stream ID (i),"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "     "
              },
              {
                "annotation_ids": [
                  "8a5d518ad2e3be4c"
                ],
                "status_id": 1,
                "text": "Application Protocol Error Code (i),"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "}"
              }
            ],
            "",
            "                    Figure 29: STOP_SENDING Frame Format",
            "",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "3a73ea8fc52f1d4e"
                ],
                "status_id": 1,
                "text": "STOP_SENDING frames contain the following fields:"
              }
            ],
            "",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "3a73ea8fc52f1d4e"
                ],
                "status_id": 1,
                "text": "Stream ID:  A variable-length integer carrying the stream ID of the"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "      "
              },
              {
                "annotation_ids": [
                  "3a73ea8fc52f1d4e"
                ],
                "status_id": 1,
                "text": "stream being ignored."
              }
            ],
            "",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "3a73ea8fc52f1d4e"
                ],
                "status_id": 1,
                "text": "Application Protocol Error Code:  A variable-length integer"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "      "
              },
              {
                "annotation_ids": [
                  "3a73ea8fc52f1d4e"
                ],
                "status_id": 1,
                "text": "containing the application-specified reason the sender is ignoring"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "      "
              },
              {
                "annotation_ids": [
                  "3a73ea8fc52f1d4e"
                ],
                "status_id": 1,
                "text": "the stream; see Section 20.2."
              }
            ]
          ],
          "requirements": [
            "bc862f05dfe4fb8f",
            "bc862f05dfe4fb8f",
            "bc862f05dfe4fb8f",
            "97dde5d724e76890",
            "97dde5d724e76890",
            "97dde5d724e76890"
          ],
          "title": "STOP_SENDING Frames"
        },
        {
          "id": "section-19.6",
          "lines": [
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "d4b2957b8c4f8518"
                ],
                "status_id": 1,
                "text": "A CRYPTO frame (type=0x06) is used to transmit cryptographic"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "d4b2957b8c4f8518"
                ],
                "status_id": 1,
                "text": "handshake messages."
              },
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "  It can be sent in all packet types except 0-RTT."
              }
            ],
            "   The CRYPTO frame offers the cryptographic protocol an in-order stream",
            "   of bytes.  CRYPTO frames are functionally identical to STREAM frames,",
            "   except that they do not bear a stream identifier; they are not flow",
            "   controlled; and they do not carry markers for optional offset,",
            "   optional length, and the end of the stream.",
            "",
            "   CRYPTO frames are formatted as shown in Figure 30.",
            "",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "440215b7046f70b9"
                ],
                "status_id": 1,
                "text": "CRYPTO Frame {"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "     "
              },
              {
                "annotation_ids": [
                  "440215b7046f70b9"
                ],
                "status_id": 1,
                "text": "Type (i) = 0x06,"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "     "
              },
              {
                "annotation_ids": [
                  "440215b7046f70b9"
                ],
                "status_id": 1,
                "text": "Offset (i),"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "     "
              },
              {
                "annotation_ids": [
                  "440215b7046f70b9"
                ],
                "status_id": 1,
                "text": "Length (i),"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "     "
              },
              {
                "annotation_ids": [
                  "440215b7046f70b9"
                ],
                "status_id": 1,
                "text": "Crypto Data (..),"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "}"
              }
            ],
            "",
            "                       Figure 30: CRYPTO Frame Format",
            "",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "98445767608f8930"
                ],
                "status_id": 1,
                "text": "CRYPTO frames contain the following fields:"
              }
            ],
            "",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "98445767608f8930"
                ],
                "status_id": 1,
                "text": "Offset:  A variable-length integer specifying the byte offset in the"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "      "
              },
              {
                "annotation_ids": [
                  "98445767608f8930"
                ],
                "status_id": 1,
                "text": "stream for the data in this CRYPTO frame."
              }
            ],
            "",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "98445767608f8930"
                ],
                "status_id": 1,
                "text": "Length:  A variable-length integer specifying the length of the"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "      "
              },
              {
                "annotation_ids": [
                  "98445767608f8930"
                ],
                "status_id": 1,
                "text": "Crypto Data field in this CRYPTO frame."
              }
            ],
            "",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "98445767608f8930"
                ],
                "status_id": 1,
                "text": "Crypto Data:  The cryptographic message data."
              }
            ],
            "",
            "   There is a separate flow of cryptographic handshake data in each",
            "   encryption level, each of which starts at an offset of 0.  This",
            "   implies that each encryption level is treated as a separate CRYPTO",
            "   stream of data.",
            "",
            "   The largest offset delivered on a stream -- the sum of the offset and",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   data length -- cannot exceed 2^62-1.  "
              },
              {
                "annotation_ids": [
                  "c7f4122ac9b7608d"
                ],
                "status_id": 20,
                "text": "Receipt of a frame that exceeds"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "c7f4122ac9b7608d"
                ],
                "status_id": 20,
                "text": "this limit MUST be treated as a connection error of type"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "c7f4122ac9b7608d"
                ],
                "status_id": 20,
                "text": "FRAME_ENCODING_ERROR or CRYPTO_BUFFER_EXCEEDED."
              }
            ],
            "",
            "   Unlike STREAM frames, which include a stream ID indicating to which",
            "   stream the data belongs, the CRYPTO frame carries data for a single",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   stream per encryption level.  "
              },
              {
                "annotation_ids": [
                  "e19d3e2b6f5ea2c6",
                  "3ee20c367b665f9b"
                ],
                "status_id": 1,
                "text": "The stream does not have an explicit"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "e19d3e2b6f5ea2c6",
                  "3ee20c367b665f9b"
                ],
                "status_id": 1,
                "text": "end, so CRYPTO frames do not have a FIN bit."
              }
            ]
          ],
          "requirements": [
            "c7f4122ac9b7608d",
            "c7f4122ac9b7608d",
            "c7f4122ac9b7608d"
          ],
          "title": "CRYPTO Frames"
        },
        {
          "id": "section-19.7",
          "lines": [
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "3165418885f1a13e"
                ],
                "status_id": 1,
                "text": "A server sends a NEW_TOKEN frame (type=0x07) to provide the client"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "3165418885f1a13e"
                ],
                "status_id": 1,
                "text": "with a token to send in the header of an Initial packet for a future"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "3165418885f1a13e"
                ],
                "status_id": 1,
                "text": "connection."
              }
            ],
            "",
            "   NEW_TOKEN frames are formatted as shown in Figure 31.",
            "",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "a4a29f35e41a84bc"
                ],
                "status_id": 1,
                "text": "NEW_TOKEN Frame {"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "     "
              },
              {
                "annotation_ids": [
                  "a4a29f35e41a84bc"
                ],
                "status_id": 1,
                "text": "Type (i) = 0x07,"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "     "
              },
              {
                "annotation_ids": [
                  "a4a29f35e41a84bc"
                ],
                "status_id": 1,
                "text": "Token Length (i),"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "     "
              },
              {
                "annotation_ids": [
                  "a4a29f35e41a84bc"
                ],
                "status_id": 1,
                "text": "Token (..),"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "}"
              }
            ],
            "",
            "                     Figure 31: NEW_TOKEN Frame Format",
            "",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "92678980255230a0"
                ],
                "status_id": 1,
                "text": "NEW_TOKEN frames contain the following fields:"
              }
            ],
            "",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "92678980255230a0"
                ],
                "status_id": 1,
                "text": "Token Length:  A variable-length integer specifying the length of the"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "      "
              },
              {
                "annotation_ids": [
                  "92678980255230a0"
                ],
                "status_id": 1,
                "text": "token in bytes."
              }
            ],
            "",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "92678980255230a0"
                ],
                "status_id": 1,
                "text": "Token:  An opaque blob that the client can use with a future Initial"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "      "
              },
              {
                "annotation_ids": [
                  "92678980255230a0"
                ],
                "status_id": 1,
                "text": "packet.  "
              },
              {
                "annotation_ids": [
                  "92678980255230a0",
                  "4dc1da7770966ec5"
                ],
                "status_id": 13,
                "text": "The token MUST NOT be empty."
              },
              {
                "annotation_ids": [
                  "92678980255230a0"
                ],
                "status_id": 1,
                "text": "  "
              },
              {
                "annotation_ids": [
                  "92678980255230a0",
                  "0d2b3418244995fc",
                  "537fcd2680d4c808"
                ],
                "status_id": 13,
                "text": "A client MUST treat receipt"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "      "
              },
              {
                "annotation_ids": [
                  "92678980255230a0",
                  "0d2b3418244995fc",
                  "537fcd2680d4c808"
                ],
                "status_id": 13,
                "text": "of a NEW_TOKEN frame with an empty Token field as a connection"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "      "
              },
              {
                "annotation_ids": [
                  "92678980255230a0",
                  "0d2b3418244995fc",
                  "537fcd2680d4c808"
                ],
                "status_id": 13,
                "text": "error of type FRAME_ENCODING_ERROR."
              }
            ],
            "",
            "   A client might receive multiple NEW_TOKEN frames that contain the",
            "   same token value if packets containing the frame are incorrectly",
            "   determined to be lost.  Clients are responsible for discarding",
            "   duplicate values, which might be used to link connection attempts;",
            "   see Section 8.1.3.",
            "",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "2d55a27d61bb0686",
                  "13d72ee35416c06d"
                ],
                "status_id": 17,
                "text": "Clients MUST NOT send NEW_TOKEN frames."
              },
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "  "
              },
              {
                "annotation_ids": [
                  "6ab474a75f1720b7",
                  "f6ec6de0ac5a1343"
                ],
                "status_id": 13,
                "text": "A server MUST treat receipt"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "6ab474a75f1720b7",
                  "f6ec6de0ac5a1343"
                ],
                "status_id": 13,
                "text": "of a NEW_TOKEN frame as a connection error of type"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "6ab474a75f1720b7",
                  "f6ec6de0ac5a1343"
                ],
                "status_id": 13,
                "text": "PROTOCOL_VIOLATION."
              }
            ]
          ],
          "requirements": [
            "4dc1da7770966ec5",
            "537fcd2680d4c808",
            "537fcd2680d4c808",
            "537fcd2680d4c808",
            "13d72ee35416c06d",
            "f6ec6de0ac5a1343",
            "f6ec6de0ac5a1343",
            "f6ec6de0ac5a1343"
          ],
          "title": "NEW_TOKEN Frames"
        },
        {
          "id": "section-19.8",
          "lines": [
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "72825027801be3db"
                ],
                "status_id": 1,
                "text": "STREAM frames implicitly create a stream and carry stream data.  The"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "72825027801be3db"
                ],
                "status_id": 1,
                "text": "Type field in the STREAM frame takes the form 0b00001XXX (or the set"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "72825027801be3db"
                ],
                "status_id": 1,
                "text": "of values from 0x08 to 0x0f)."
              },
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "  The three low-order bits of the frame"
              }
            ],
            "   type determine the fields that are present in the frame:",
            "",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "b05e3a920453061f"
                ],
                "status_id": 1,
                "text": "*  The OFF bit (0x04) in the frame type is set to indicate that there"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "      "
              },
              {
                "annotation_ids": [
                  "b05e3a920453061f"
                ],
                "status_id": 1,
                "text": "is an Offset field present.  When set to 1, the Offset field is"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "      "
              },
              {
                "annotation_ids": [
                  "b05e3a920453061f"
                ],
                "status_id": 1,
                "text": "present.  When set to 0, the Offset field is absent and the Stream"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "      "
              },
              {
                "annotation_ids": [
                  "b05e3a920453061f"
                ],
                "status_id": 1,
                "text": "Data starts at an offset of 0 (that is, the frame contains the"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "      "
              },
              {
                "annotation_ids": [
                  "b05e3a920453061f"
                ],
                "status_id": 1,
                "text": "first bytes of the stream, or the end of a stream that includes no"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "      "
              },
              {
                "annotation_ids": [
                  "b05e3a920453061f"
                ],
                "status_id": 1,
                "text": "data)."
              }
            ],
            "",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "81098be9eeb9a4d8"
                ],
                "status_id": 1,
                "text": "*  The LEN bit (0x02) in the frame type is set to indicate that there"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "      "
              },
              {
                "annotation_ids": [
                  "81098be9eeb9a4d8"
                ],
                "status_id": 1,
                "text": "is a Length field present.  If this bit is set to 0, the Length"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "      "
              },
              {
                "annotation_ids": [
                  "81098be9eeb9a4d8"
                ],
                "status_id": 1,
                "text": "field is absent and the Stream Data field extends to the end of"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "      "
              },
              {
                "annotation_ids": [
                  "81098be9eeb9a4d8"
                ],
                "status_id": 1,
                "text": "the packet.  If this bit is set to 1, the Length field is present."
              }
            ],
            "",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "11e67c4bce0eb403"
                ],
                "status_id": 1,
                "text": "*  The FIN bit (0x01) indicates that the frame marks the end of the"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "      "
              },
              {
                "annotation_ids": [
                  "11e67c4bce0eb403"
                ],
                "status_id": 1,
                "text": "stream.  The final size of the stream is the sum of the offset and"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "      "
              },
              {
                "annotation_ids": [
                  "11e67c4bce0eb403"
                ],
                "status_id": 1,
                "text": "the length of this frame."
              }
            ],
            "",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "eb5ca35112c5ebaf"
                ],
                "status_id": 20,
                "text": "An endpoint MUST terminate the connection with error"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "eb5ca35112c5ebaf"
                ],
                "status_id": 20,
                "text": "STREAM_STATE_ERROR if it receives a STREAM frame for a locally"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "eb5ca35112c5ebaf"
                ],
                "status_id": 20,
                "text": "initiated stream that has not yet been created, or for a send-only"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "eb5ca35112c5ebaf"
                ],
                "status_id": 20,
                "text": "stream."
              }
            ],
            "",
            "   STREAM frames are formatted as shown in Figure 32.",
            "",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "d47aa2bdd3680b01"
                ],
                "status_id": 1,
                "text": "STREAM Frame {"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "     "
              },
              {
                "annotation_ids": [
                  "d47aa2bdd3680b01"
                ],
                "status_id": 1,
                "text": "Type (i) = 0x08..0x0f,"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "     "
              },
              {
                "annotation_ids": [
                  "d47aa2bdd3680b01"
                ],
                "status_id": 1,
                "text": "Stream ID (i),"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "     "
              },
              {
                "annotation_ids": [
                  "d47aa2bdd3680b01"
                ],
                "status_id": 1,
                "text": "[Offset (i)],"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "     "
              },
              {
                "annotation_ids": [
                  "d47aa2bdd3680b01"
                ],
                "status_id": 1,
                "text": "[Length (i)],"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "     "
              },
              {
                "annotation_ids": [
                  "d47aa2bdd3680b01"
                ],
                "status_id": 1,
                "text": "Stream Data (..),"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "}"
              }
            ],
            "",
            "                       Figure 32: STREAM Frame Format",
            "",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "944ebecc6cefabe9"
                ],
                "status_id": 1,
                "text": "STREAM frames contain the following fields:"
              }
            ],
            "",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "944ebecc6cefabe9"
                ],
                "status_id": 1,
                "text": "Stream ID:  A variable-length integer indicating the stream ID of the"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "      "
              },
              {
                "annotation_ids": [
                  "944ebecc6cefabe9"
                ],
                "status_id": 1,
                "text": "stream; see Section 2.1."
              }
            ],
            "",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "944ebecc6cefabe9"
                ],
                "status_id": 1,
                "text": "Offset:  A variable-length integer specifying the byte offset in the"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "      "
              },
              {
                "annotation_ids": [
                  "944ebecc6cefabe9"
                ],
                "status_id": 1,
                "text": "stream for the data in this STREAM frame.  This field is present"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "      "
              },
              {
                "annotation_ids": [
                  "944ebecc6cefabe9"
                ],
                "status_id": 1,
                "text": "when the OFF bit is set to 1.  When the Offset field is absent,"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "      "
              },
              {
                "annotation_ids": [
                  "944ebecc6cefabe9"
                ],
                "status_id": 1,
                "text": "the offset is 0."
              }
            ],
            "",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "944ebecc6cefabe9"
                ],
                "status_id": 1,
                "text": "Length:  A variable-length integer specifying the length of the"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "      "
              },
              {
                "annotation_ids": [
                  "944ebecc6cefabe9"
                ],
                "status_id": 1,
                "text": "Stream Data field in this STREAM frame.  This field is present"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "      "
              },
              {
                "annotation_ids": [
                  "944ebecc6cefabe9"
                ],
                "status_id": 1,
                "text": "when the LEN bit is set to 1.  When the LEN bit is set to 0, the"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "      "
              },
              {
                "annotation_ids": [
                  "944ebecc6cefabe9"
                ],
                "status_id": 1,
                "text": "Stream Data field consumes all the remaining bytes in the packet."
              }
            ],
            "",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "944ebecc6cefabe9"
                ],
                "status_id": 1,
                "text": "Stream Data:  The bytes from the designated stream to be delivered."
              }
            ],
            "",
            "   When a Stream Data field has a length of 0, the offset in the STREAM",
            "   frame is the offset of the next byte that would be sent.",
            "",
            "   The first byte in the stream has an offset of 0.  The largest offset",
            "   delivered on a stream -- the sum of the offset and data length --",
            "   cannot exceed 2^62-1, as it is not possible to provide flow control",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   credit for that data.  "
              },
              {
                "annotation_ids": [
                  "41cfe8d66b3d6fc2"
                ],
                "status_id": 20,
                "text": "Receipt of a frame that exceeds this limit"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "41cfe8d66b3d6fc2"
                ],
                "status_id": 20,
                "text": "MUST be treated as a connection error of type FRAME_ENCODING_ERROR or"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "41cfe8d66b3d6fc2"
                ],
                "status_id": 20,
                "text": "FLOW_CONTROL_ERROR."
              }
            ]
          ],
          "requirements": [
            "eb5ca35112c5ebaf",
            "eb5ca35112c5ebaf",
            "eb5ca35112c5ebaf",
            "eb5ca35112c5ebaf",
            "41cfe8d66b3d6fc2",
            "41cfe8d66b3d6fc2",
            "41cfe8d66b3d6fc2"
          ],
          "title": "STREAM Frames"
        },
        {
          "id": "section-19.9",
          "lines": [
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "780a672399abdb30"
                ],
                "status_id": 1,
                "text": "A MAX_DATA frame (type=0x10) is used in flow control to inform the"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "780a672399abdb30"
                ],
                "status_id": 1,
                "text": "peer of the maximum amount of data that can be sent on the connection"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "780a672399abdb30"
                ],
                "status_id": 1,
                "text": "as a whole."
              }
            ],
            "",
            "   MAX_DATA frames are formatted as shown in Figure 33.",
            "",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "afcfcf9096f2f76e"
                ],
                "status_id": 1,
                "text": "MAX_DATA Frame {"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "     "
              },
              {
                "annotation_ids": [
                  "afcfcf9096f2f76e"
                ],
                "status_id": 1,
                "text": "Type (i) = 0x10,"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "     "
              },
              {
                "annotation_ids": [
                  "afcfcf9096f2f76e"
                ],
                "status_id": 1,
                "text": "Maximum Data (i),"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "}"
              }
            ],
            "",
            "                      Figure 33: MAX_DATA Frame Format",
            "",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "af2ba9d22374c0d7"
                ],
                "status_id": 1,
                "text": "MAX_DATA frames contain the following field:"
              }
            ],
            "",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "af2ba9d22374c0d7"
                ],
                "status_id": 1,
                "text": "Maximum Data:  A variable-length integer indicating the maximum"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "      "
              },
              {
                "annotation_ids": [
                  "af2ba9d22374c0d7"
                ],
                "status_id": 1,
                "text": "amount of data that can be sent on the entire connection, in units"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "      "
              },
              {
                "annotation_ids": [
                  "af2ba9d22374c0d7"
                ],
                "status_id": 1,
                "text": "of bytes."
              }
            ],
            "",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   All data sent in STREAM frames counts toward this limit.  "
              },
              {
                "annotation_ids": [
                  "f813d00c91f31db4"
                ],
                "status_id": 20,
                "text": "The sum of"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "f813d00c91f31db4"
                ],
                "status_id": 20,
                "text": "the final sizes on all streams -- including streams in terminal"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "f813d00c91f31db4"
                ],
                "status_id": 20,
                "text": "states -- MUST NOT exceed the value advertised by a receiver."
              },
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "  "
              },
              {
                "annotation_ids": [
                  "adef24b0501443a1",
                  "ce82af2a4883a01f"
                ],
                "status_id": 13,
                "text": "An"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "adef24b0501443a1",
                  "ce82af2a4883a01f"
                ],
                "status_id": 13,
                "text": "endpoint MUST terminate a connection with an error of type"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "adef24b0501443a1",
                  "ce82af2a4883a01f"
                ],
                "status_id": 13,
                "text": "FLOW_CONTROL_ERROR if it receives more data than the maximum data"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "adef24b0501443a1",
                  "ce82af2a4883a01f"
                ],
                "status_id": 13,
                "text": "value that it has sent."
              },
              {
                "annotation_ids": [
                  "adef24b0501443a1"
                ],
                "status_id": 1,
                "text": "  This includes violations of remembered"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "adef24b0501443a1"
                ],
                "status_id": 1,
                "text": "limits in Early Data; see Section 7.4.1."
              }
            ]
          ],
          "requirements": [
            "f813d00c91f31db4",
            "f813d00c91f31db4",
            "f813d00c91f31db4",
            "ce82af2a4883a01f",
            "ce82af2a4883a01f",
            "ce82af2a4883a01f",
            "ce82af2a4883a01f"
          ],
          "title": "MAX_DATA Frames"
        },
        {
          "id": "section-19.10",
          "lines": [
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "1aa9098ca9c7830f"
                ],
                "status_id": 1,
                "text": "A MAX_STREAM_DATA frame (type=0x11) is used in flow control to inform"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "1aa9098ca9c7830f"
                ],
                "status_id": 1,
                "text": "a peer of the maximum amount of data that can be sent on a stream."
              }
            ],
            "",
            "   A MAX_STREAM_DATA frame can be sent for streams in the \"Recv\" state;",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   see Section 3.2.  "
              },
              {
                "annotation_ids": [
                  "638b0962e1f0e445"
                ],
                "status_id": 20,
                "text": "Receiving a MAX_STREAM_DATA frame for a locally"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "638b0962e1f0e445"
                ],
                "status_id": 20,
                "text": "initiated stream that has not yet been created MUST be treated as a"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "638b0962e1f0e445"
                ],
                "status_id": 20,
                "text": "connection error of type STREAM_STATE_ERROR."
              },
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "  "
              },
              {
                "annotation_ids": [
                  "ee479cc85a64a4fa",
                  "31bb7b372eff6f20"
                ],
                "status_id": 13,
                "text": "An endpoint that"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "ee479cc85a64a4fa",
                  "31bb7b372eff6f20"
                ],
                "status_id": 13,
                "text": "receives a MAX_STREAM_DATA frame for a receive-only stream MUST"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "ee479cc85a64a4fa",
                  "31bb7b372eff6f20"
                ],
                "status_id": 13,
                "text": "terminate the connection with error STREAM_STATE_ERROR."
              }
            ],
            "",
            "   MAX_STREAM_DATA frames are formatted as shown in Figure 34.",
            "",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "cef94afff1d54aba"
                ],
                "status_id": 1,
                "text": "MAX_STREAM_DATA Frame {"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "     "
              },
              {
                "annotation_ids": [
                  "cef94afff1d54aba"
                ],
                "status_id": 1,
                "text": "Type (i) = 0x11,"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "     "
              },
              {
                "annotation_ids": [
                  "cef94afff1d54aba"
                ],
                "status_id": 1,
                "text": "Stream ID (i),"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "     "
              },
              {
                "annotation_ids": [
                  "cef94afff1d54aba"
                ],
                "status_id": 1,
                "text": "Maximum Stream Data (i),"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "}"
              }
            ],
            "",
            "                  Figure 34: MAX_STREAM_DATA Frame Format",
            "",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "2bec5498ac2e9fd6"
                ],
                "status_id": 1,
                "text": "MAX_STREAM_DATA frames contain the following fields:"
              }
            ],
            "",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "2bec5498ac2e9fd6"
                ],
                "status_id": 1,
                "text": "Stream ID:  The stream ID of the affected stream, encoded as a"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "      "
              },
              {
                "annotation_ids": [
                  "2bec5498ac2e9fd6"
                ],
                "status_id": 1,
                "text": "variable-length integer."
              }
            ],
            "",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "2bec5498ac2e9fd6"
                ],
                "status_id": 1,
                "text": "Maximum Stream Data:  A variable-length integer indicating the"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "      "
              },
              {
                "annotation_ids": [
                  "2bec5498ac2e9fd6"
                ],
                "status_id": 1,
                "text": "maximum amount of data that can be sent on the identified stream,"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "      "
              },
              {
                "annotation_ids": [
                  "2bec5498ac2e9fd6"
                ],
                "status_id": 1,
                "text": "in units of bytes."
              }
            ],
            "",
            "   When counting data toward this limit, an endpoint accounts for the",
            "   largest received offset of data that is sent or received on the",
            "   stream.  Loss or reordering can mean that the largest received offset",
            "   on a stream can be greater than the total size of data received on",
            "   that stream.  Receiving STREAM frames might not increase the largest",
            "   received offset.",
            "",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "00f272e98156ea11",
                  "0254f2bf49b2228f"
                ],
                "status_id": 13,
                "text": "The data sent on a stream MUST NOT exceed the largest maximum stream"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "00f272e98156ea11",
                  "0254f2bf49b2228f"
                ],
                "status_id": 13,
                "text": "data value advertised by the receiver."
              },
              {
                "annotation_ids": [
                  "00f272e98156ea11"
                ],
                "status_id": 1,
                "text": "  "
              },
              {
                "annotation_ids": [
                  "00f272e98156ea11",
                  "9fb05320603e10d5"
                ],
                "status_id": 13,
                "text": "An endpoint MUST terminate a"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "00f272e98156ea11",
                  "9fb05320603e10d5"
                ],
                "status_id": 13,
                "text": "connection with an error of type FLOW_CONTROL_ERROR if it receives"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "00f272e98156ea11",
                  "9fb05320603e10d5"
                ],
                "status_id": 13,
                "text": "more data than the largest maximum stream data that it has sent for"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "00f272e98156ea11",
                  "9fb05320603e10d5"
                ],
                "status_id": 13,
                "text": "the affected stream."
              },
              {
                "annotation_ids": [
                  "00f272e98156ea11"
                ],
                "status_id": 1,
                "text": "  This includes violations of remembered limits"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "00f272e98156ea11"
                ],
                "status_id": 1,
                "text": "in Early Data; see Section 7.4.1."
              }
            ]
          ],
          "requirements": [
            "638b0962e1f0e445",
            "638b0962e1f0e445",
            "638b0962e1f0e445",
            "31bb7b372eff6f20",
            "31bb7b372eff6f20",
            "31bb7b372eff6f20",
            "0254f2bf49b2228f",
            "0254f2bf49b2228f",
            "9fb05320603e10d5",
            "9fb05320603e10d5",
            "9fb05320603e10d5",
            "9fb05320603e10d5"
          ],
          "title": "MAX_STREAM_DATA Frames"
        },
        {
          "id": "section-19.11",
          "lines": [
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "f93d6f2e9fbd87ae"
                ],
                "status_id": 1,
                "text": "A MAX_STREAMS frame (type=0x12 or 0x13) informs the peer of the"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "f93d6f2e9fbd87ae"
                ],
                "status_id": 1,
                "text": "cumulative number of streams of a given type it is permitted to open."
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "f93d6f2e9fbd87ae"
                ],
                "status_id": 1,
                "text": "A MAX_STREAMS frame with a type of 0x12 applies to bidirectional"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "f93d6f2e9fbd87ae"
                ],
                "status_id": 1,
                "text": "streams, and a MAX_STREAMS frame with a type of 0x13 applies to"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "f93d6f2e9fbd87ae"
                ],
                "status_id": 1,
                "text": "unidirectional streams."
              }
            ],
            "",
            "   MAX_STREAMS frames are formatted as shown in Figure 35.",
            "",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "5bed7843f918b5cf"
                ],
                "status_id": 1,
                "text": "MAX_STREAMS Frame {"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "     "
              },
              {
                "annotation_ids": [
                  "5bed7843f918b5cf"
                ],
                "status_id": 1,
                "text": "Type (i) = 0x12..0x13,"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "     "
              },
              {
                "annotation_ids": [
                  "5bed7843f918b5cf"
                ],
                "status_id": 1,
                "text": "Maximum Streams (i),"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "}"
              }
            ],
            "",
            "                    Figure 35: MAX_STREAMS Frame Format",
            "",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "48ee1dee9dd45819"
                ],
                "status_id": 1,
                "text": "MAX_STREAMS frames contain the following field:"
              }
            ],
            "",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "48ee1dee9dd45819",
                  "6a9036bb0c417178"
                ],
                "status_id": 1,
                "text": "Maximum Streams:  A count of the cumulative number of streams of the"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "      "
              },
              {
                "annotation_ids": [
                  "48ee1dee9dd45819",
                  "6a9036bb0c417178"
                ],
                "status_id": 1,
                "text": "corresponding type that can be opened over the lifetime of the"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "      "
              },
              {
                "annotation_ids": [
                  "48ee1dee9dd45819",
                  "6a9036bb0c417178"
                ],
                "status_id": 1,
                "text": "connection."
              },
              {
                "annotation_ids": [
                  "6a9036bb0c417178"
                ],
                "status_id": 1,
                "text": "  "
              },
              {
                "annotation_ids": [
                  "f5764dbe7f26707e",
                  "6a9036bb0c417178"
                ],
                "status_id": 1,
                "text": "This value cannot exceed 2^60, as it is not possible"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "      "
              },
              {
                "annotation_ids": [
                  "f5764dbe7f26707e",
                  "6a9036bb0c417178"
                ],
                "status_id": 1,
                "text": "to encode stream IDs larger than 2^62-1."
              },
              {
                "annotation_ids": [
                  "f5764dbe7f26707e"
                ],
                "status_id": 1,
                "text": "  "
              },
              {
                "annotation_ids": [
                  "f5764dbe7f26707e",
                  "9ef31dcec7c4d8ab"
                ],
                "status_id": 13,
                "text": "Receipt of a frame that"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "      "
              },
              {
                "annotation_ids": [
                  "f5764dbe7f26707e",
                  "9ef31dcec7c4d8ab"
                ],
                "status_id": 13,
                "text": "permits opening of a stream larger than this limit MUST be treated"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "      "
              },
              {
                "annotation_ids": [
                  "f5764dbe7f26707e",
                  "9ef31dcec7c4d8ab"
                ],
                "status_id": 13,
                "text": "as a connection error of type FRAME_ENCODING_ERROR."
              }
            ],
            "",
            "   Loss or reordering can cause an endpoint to receive a MAX_STREAMS",
            "   frame with a lower stream limit than was previously received.",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "8f172bfd7f29baff",
                  "6deb953f1b537f79",
                  "08fa12fc8c5a2c86"
                ],
                "status_id": 9,
                "text": "MAX_STREAMS frames that do not increase the stream limit MUST be"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "8f172bfd7f29baff",
                  "6deb953f1b537f79",
                  "08fa12fc8c5a2c86"
                ],
                "status_id": 9,
                "text": "ignored."
              }
            ],
            "",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "d23c76069429c506",
                  "f9115852d03ca76b",
                  "318f52f4afd35820"
                ],
                "status_id": 9,
                "text": "An endpoint MUST NOT open more streams than permitted by the current"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "d23c76069429c506",
                  "f9115852d03ca76b",
                  "318f52f4afd35820"
                ],
                "status_id": 9,
                "text": "stream limit set by its peer."
              },
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "  For instance, a server that receives a"
              }
            ],
            "   unidirectional stream limit of 3 is permitted to open streams 3, 7,",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   and 11, but not stream 15.  "
              },
              {
                "annotation_ids": [
                  "2de49f147ce9b6de",
                  "65bd9a53cabbdddc",
                  "a28c7fbbcbd5c77b"
                ],
                "status_id": 9,
                "text": "An endpoint MUST terminate a connection"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "2de49f147ce9b6de",
                  "65bd9a53cabbdddc",
                  "a28c7fbbcbd5c77b"
                ],
                "status_id": 9,
                "text": "with an error of type STREAM_LIMIT_ERROR if a peer opens more streams"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "2de49f147ce9b6de",
                  "65bd9a53cabbdddc",
                  "a28c7fbbcbd5c77b"
                ],
                "status_id": 9,
                "text": "than was permitted."
              },
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "  This includes violations of remembered limits in"
              }
            ],
            "   Early Data; see Section 7.4.1.",
            "",
            "   Note that these frames (and the corresponding transport parameters)",
            "   do not describe the number of streams that can be opened",
            "   concurrently.  The limit includes streams that have been closed as",
            "   well as those that are open."
          ],
          "requirements": [
            "9ef31dcec7c4d8ab",
            "9ef31dcec7c4d8ab",
            "9ef31dcec7c4d8ab",
            "08fa12fc8c5a2c86",
            "08fa12fc8c5a2c86",
            "318f52f4afd35820",
            "318f52f4afd35820",
            "a28c7fbbcbd5c77b",
            "a28c7fbbcbd5c77b",
            "a28c7fbbcbd5c77b"
          ],
          "title": "MAX_STREAMS Frames"
        },
        {
          "id": "section-19.12",
          "lines": [
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "1dd8f9cb0a8e0c78",
                  "863452a5594ffe29",
                  "eac3b2e75e6612e1",
                  "e9eced689e4aad19"
                ],
                "status_id": 8,
                "text": "A sender SHOULD send a DATA_BLOCKED frame (type=0x14) when it wishes"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "1dd8f9cb0a8e0c78",
                  "863452a5594ffe29",
                  "eac3b2e75e6612e1",
                  "e9eced689e4aad19"
                ],
                "status_id": 8,
                "text": "to send data but is unable to do so due to connection-level flow"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "1dd8f9cb0a8e0c78",
                  "863452a5594ffe29",
                  "eac3b2e75e6612e1",
                  "e9eced689e4aad19"
                ],
                "status_id": 8,
                "text": "control; see Section 4."
              },
              {
                "annotation_ids": [
                  "1dd8f9cb0a8e0c78"
                ],
                "status_id": 1,
                "text": "  DATA_BLOCKED frames can be used as input to"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "1dd8f9cb0a8e0c78"
                ],
                "status_id": 1,
                "text": "tuning of flow control algorithms; see Section 4.2."
              }
            ],
            "",
            "   DATA_BLOCKED frames are formatted as shown in Figure 36.",
            "",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "1e5b2ec12630ea91"
                ],
                "status_id": 1,
                "text": "DATA_BLOCKED Frame {"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "     "
              },
              {
                "annotation_ids": [
                  "1e5b2ec12630ea91"
                ],
                "status_id": 1,
                "text": "Type (i) = 0x14,"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "     "
              },
              {
                "annotation_ids": [
                  "1e5b2ec12630ea91"
                ],
                "status_id": 1,
                "text": "Maximum Data (i),"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "}"
              }
            ],
            "",
            "                    Figure 36: DATA_BLOCKED Frame Format",
            "",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "ff682a1f712d3a10"
                ],
                "status_id": 1,
                "text": "DATA_BLOCKED frames contain the following field:"
              }
            ],
            "",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "ff682a1f712d3a10"
                ],
                "status_id": 1,
                "text": "Maximum Data:  A variable-length integer indicating the connection-"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "      "
              },
              {
                "annotation_ids": [
                  "ff682a1f712d3a10"
                ],
                "status_id": 1,
                "text": "level limit at which blocking occurred."
              }
            ]
          ],
          "requirements": [
            "e9eced689e4aad19",
            "e9eced689e4aad19",
            "e9eced689e4aad19"
          ],
          "title": "DATA_BLOCKED Frames"
        },
        {
          "id": "section-19.13",
          "lines": [
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "1403bd14b132a299",
                  "82aa70f8fc1eb52f",
                  "924c82ed1bb7cf63"
                ],
                "status_id": 8,
                "text": "A sender SHOULD send a STREAM_DATA_BLOCKED frame (type=0x15) when it"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "1403bd14b132a299",
                  "82aa70f8fc1eb52f",
                  "924c82ed1bb7cf63"
                ],
                "status_id": 8,
                "text": "wishes to send data but is unable to do so due to stream-level flow"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "1403bd14b132a299",
                  "82aa70f8fc1eb52f",
                  "924c82ed1bb7cf63"
                ],
                "status_id": 8,
                "text": "control."
              },
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "  "
              },
              {
                "annotation_ids": [
                  "68b6a899446c0849"
                ],
                "status_id": 1,
                "text": "This frame is analogous to DATA_BLOCKED (Section 19.12)."
              }
            ],
            "",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "74f7c5148ea2e2bb"
                ],
                "status_id": 20,
                "text": "An endpoint that receives a STREAM_DATA_BLOCKED frame for a send-only"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "74f7c5148ea2e2bb"
                ],
                "status_id": 20,
                "text": "stream MUST terminate the connection with error STREAM_STATE_ERROR."
              }
            ],
            "",
            "   STREAM_DATA_BLOCKED frames are formatted as shown in Figure 37.",
            "",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "0bfbfd93c0ed795b"
                ],
                "status_id": 1,
                "text": "STREAM_DATA_BLOCKED Frame {"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "     "
              },
              {
                "annotation_ids": [
                  "0bfbfd93c0ed795b"
                ],
                "status_id": 1,
                "text": "Type (i) = 0x15,"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "     "
              },
              {
                "annotation_ids": [
                  "0bfbfd93c0ed795b"
                ],
                "status_id": 1,
                "text": "Stream ID (i),"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "     "
              },
              {
                "annotation_ids": [
                  "0bfbfd93c0ed795b"
                ],
                "status_id": 1,
                "text": "Maximum Stream Data (i),"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "}"
              }
            ],
            "",
            "                Figure 37: STREAM_DATA_BLOCKED Frame Format",
            "",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "52492379cafb745d"
                ],
                "status_id": 1,
                "text": "STREAM_DATA_BLOCKED frames contain the following fields:"
              }
            ],
            "",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "52492379cafb745d"
                ],
                "status_id": 1,
                "text": "Stream ID:  A variable-length integer indicating the stream that is"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "      "
              },
              {
                "annotation_ids": [
                  "52492379cafb745d"
                ],
                "status_id": 1,
                "text": "blocked due to flow control."
              }
            ],
            "",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "52492379cafb745d"
                ],
                "status_id": 1,
                "text": "Maximum Stream Data:  A variable-length integer indicating the offset"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "      "
              },
              {
                "annotation_ids": [
                  "52492379cafb745d"
                ],
                "status_id": 1,
                "text": "of the stream at which the blocking occurred."
              }
            ]
          ],
          "requirements": [
            "924c82ed1bb7cf63",
            "924c82ed1bb7cf63",
            "924c82ed1bb7cf63",
            "74f7c5148ea2e2bb",
            "74f7c5148ea2e2bb"
          ],
          "title": "STREAM_DATA_BLOCKED Frames"
        },
        {
          "id": "section-19.14",
          "lines": [
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "2533e31aa8e96d43",
                  "a104c457ba4e0cbd",
                  "6a243a43a0107b34"
                ],
                "status_id": 8,
                "text": "A sender SHOULD send a STREAMS_BLOCKED frame (type=0x16 or 0x17) when"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "2533e31aa8e96d43",
                  "a104c457ba4e0cbd",
                  "6a243a43a0107b34"
                ],
                "status_id": 8,
                "text": "it wishes to open a stream but is unable to do so due to the maximum"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "2533e31aa8e96d43",
                  "a104c457ba4e0cbd",
                  "6a243a43a0107b34"
                ],
                "status_id": 8,
                "text": "stream limit set by its peer; see Section 19.11."
              },
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "  "
              },
              {
                "annotation_ids": [
                  "d0b6bfffc3f28178"
                ],
                "status_id": 1,
                "text": "A STREAMS_BLOCKED"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "d0b6bfffc3f28178"
                ],
                "status_id": 1,
                "text": "frame of type 0x16 is used to indicate reaching the bidirectional"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "d0b6bfffc3f28178"
                ],
                "status_id": 1,
                "text": "stream limit, and a STREAMS_BLOCKED frame of type 0x17 is used to"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "d0b6bfffc3f28178"
                ],
                "status_id": 1,
                "text": "indicate reaching the unidirectional stream limit."
              }
            ],
            "",
            "   A STREAMS_BLOCKED frame does not open the stream, but informs the",
            "   peer that a new stream was needed and the stream limit prevented the",
            "   creation of the stream.",
            "",
            "   STREAMS_BLOCKED frames are formatted as shown in Figure 38.",
            "",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "8a7712f9aa254dda"
                ],
                "status_id": 1,
                "text": "STREAMS_BLOCKED Frame {"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "     "
              },
              {
                "annotation_ids": [
                  "8a7712f9aa254dda"
                ],
                "status_id": 1,
                "text": "Type (i) = 0x16..0x17,"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "     "
              },
              {
                "annotation_ids": [
                  "8a7712f9aa254dda"
                ],
                "status_id": 1,
                "text": "Maximum Streams (i),"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "}"
              }
            ],
            "",
            "                  Figure 38: STREAMS_BLOCKED Frame Format",
            "",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "5b73e98d19089020"
                ],
                "status_id": 1,
                "text": "STREAMS_BLOCKED frames contain the following field:"
              }
            ],
            "",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "5b73e98d19089020"
                ],
                "status_id": 1,
                "text": "Maximum Streams:  A variable-length integer indicating the maximum"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "      "
              },
              {
                "annotation_ids": [
                  "5b73e98d19089020"
                ],
                "status_id": 1,
                "text": "number of streams allowed at the time the frame was sent."
              },
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "  "
              },
              {
                "annotation_ids": [
                  "cec7ed4c65fb221d"
                ],
                "status_id": 1,
                "text": "This"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "      "
              },
              {
                "annotation_ids": [
                  "cec7ed4c65fb221d"
                ],
                "status_id": 1,
                "text": "value cannot exceed 2^60, as it is not possible to encode stream"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "      "
              },
              {
                "annotation_ids": [
                  "cec7ed4c65fb221d"
                ],
                "status_id": 1,
                "text": "IDs larger than 2^62-1.  "
              },
              {
                "annotation_ids": [
                  "cec7ed4c65fb221d",
                  "67306cb455da9997"
                ],
                "status_id": 13,
                "text": "Receipt of a frame that encodes a larger"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "      "
              },
              {
                "annotation_ids": [
                  "cec7ed4c65fb221d",
                  "67306cb455da9997"
                ],
                "status_id": 13,
                "text": "stream ID MUST be treated as a connection error of type"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "      "
              },
              {
                "annotation_ids": [
                  "cec7ed4c65fb221d",
                  "67306cb455da9997"
                ],
                "status_id": 13,
                "text": "STREAM_LIMIT_ERROR or FRAME_ENCODING_ERROR."
              }
            ]
          ],
          "requirements": [
            "6a243a43a0107b34",
            "6a243a43a0107b34",
            "6a243a43a0107b34",
            "67306cb455da9997",
            "67306cb455da9997",
            "67306cb455da9997"
          ],
          "title": "STREAMS_BLOCKED Frames"
        },
        {
          "id": "section-19.15",
          "lines": [
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "60cadbfea544e894"
                ],
                "status_id": 1,
                "text": "An endpoint sends a NEW_CONNECTION_ID frame (type=0x18) to provide"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "60cadbfea544e894"
                ],
                "status_id": 1,
                "text": "its peer with alternative connection IDs that can be used to break"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "60cadbfea544e894"
                ],
                "status_id": 1,
                "text": "linkability when migrating connections; see Section 9.5."
              }
            ],
            "",
            "   NEW_CONNECTION_ID frames are formatted as shown in Figure 39.",
            "",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "07bef10ca912259a"
                ],
                "status_id": 1,
                "text": "NEW_CONNECTION_ID Frame {"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "     "
              },
              {
                "annotation_ids": [
                  "07bef10ca912259a"
                ],
                "status_id": 1,
                "text": "Type (i) = 0x18,"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "     "
              },
              {
                "annotation_ids": [
                  "07bef10ca912259a"
                ],
                "status_id": 1,
                "text": "Sequence Number (i),"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "     "
              },
              {
                "annotation_ids": [
                  "07bef10ca912259a"
                ],
                "status_id": 1,
                "text": "Retire Prior To (i),"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "     "
              },
              {
                "annotation_ids": [
                  "07bef10ca912259a"
                ],
                "status_id": 1,
                "text": "Length (8),"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "     "
              },
              {
                "annotation_ids": [
                  "07bef10ca912259a"
                ],
                "status_id": 1,
                "text": "Connection ID (8..160),"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "     "
              },
              {
                "annotation_ids": [
                  "07bef10ca912259a"
                ],
                "status_id": 1,
                "text": "Stateless Reset Token (128),"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "}"
              }
            ],
            "",
            "                 Figure 39: NEW_CONNECTION_ID Frame Format",
            "",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "85881a680e8fe6fb"
                ],
                "status_id": 1,
                "text": "NEW_CONNECTION_ID frames contain the following fields:"
              }
            ],
            "",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "85881a680e8fe6fb"
                ],
                "status_id": 1,
                "text": "Sequence Number:  The sequence number assigned to the connection ID"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "      "
              },
              {
                "annotation_ids": [
                  "85881a680e8fe6fb"
                ],
                "status_id": 1,
                "text": "by the sender, encoded as a variable-length integer; see"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "      "
              },
              {
                "annotation_ids": [
                  "85881a680e8fe6fb"
                ],
                "status_id": 1,
                "text": "Section 5.1.1."
              }
            ],
            "",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "85881a680e8fe6fb"
                ],
                "status_id": 1,
                "text": "Retire Prior To:  A variable-length integer indicating which"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "      "
              },
              {
                "annotation_ids": [
                  "85881a680e8fe6fb"
                ],
                "status_id": 1,
                "text": "connection IDs should be retired; see Section 5.1.2."
              }
            ],
            "",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "85881a680e8fe6fb"
                ],
                "status_id": 1,
                "text": "Length:  An 8-bit unsigned integer containing the length of the"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "      "
              },
              {
                "annotation_ids": [
                  "85881a680e8fe6fb"
                ],
                "status_id": 1,
                "text": "connection ID.  "
              },
              {
                "annotation_ids": [
                  "85881a680e8fe6fb",
                  "a06820cbfeebd895",
                  "ea84b8e420be738f"
                ],
                "status_id": 13,
                "text": "Values less than 1 and greater than 20 are invalid"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "      "
              },
              {
                "annotation_ids": [
                  "85881a680e8fe6fb",
                  "a06820cbfeebd895",
                  "ea84b8e420be738f"
                ],
                "status_id": 13,
                "text": "and MUST be treated as a connection error of type"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "      "
              },
              {
                "annotation_ids": [
                  "85881a680e8fe6fb",
                  "a06820cbfeebd895",
                  "ea84b8e420be738f"
                ],
                "status_id": 13,
                "text": "FRAME_ENCODING_ERROR."
              }
            ],
            "",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "85881a680e8fe6fb"
                ],
                "status_id": 1,
                "text": "Connection ID:  A connection ID of the specified length."
              }
            ],
            "",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "85881a680e8fe6fb"
                ],
                "status_id": 1,
                "text": "Stateless Reset Token:  "
              },
              {
                "annotation_ids": [
                  "85881a680e8fe6fb",
                  "9cde603b10ec5dab"
                ],
                "status_id": 1,
                "text": "A 128-bit value that will be used for a"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "      "
              },
              {
                "annotation_ids": [
                  "85881a680e8fe6fb",
                  "9cde603b10ec5dab"
                ],
                "status_id": 1,
                "text": "stateless reset when the associated connection ID is used;"
              },
              {
                "annotation_ids": [
                  "85881a680e8fe6fb"
                ],
                "status_id": 1,
                "text": " see"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "      "
              },
              {
                "annotation_ids": [
                  "85881a680e8fe6fb"
                ],
                "status_id": 1,
                "text": "Section 10.3."
              }
            ],
            "",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "7606a81dc73c7b34",
                  "48ee6ac897287dda"
                ],
                "status_id": 12,
                "text": "An endpoint MUST NOT send this frame if it currently requires that"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "7606a81dc73c7b34",
                  "48ee6ac897287dda"
                ],
                "status_id": 12,
                "text": "its peer send packets with a zero-length Destination Connection ID."
              }
            ],
            "   Changing the length of a connection ID to or from zero length makes",
            "   it difficult to identify when the value of the connection ID changed.",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "d311e90f98957b20",
                  "6233dd3eb0b7fc97"
                ],
                "status_id": 13,
                "text": "An endpoint that is sending packets with a zero-length Destination"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "d311e90f98957b20",
                  "6233dd3eb0b7fc97"
                ],
                "status_id": 13,
                "text": "Connection ID MUST treat receipt of a NEW_CONNECTION_ID frame as a"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "d311e90f98957b20",
                  "6233dd3eb0b7fc97"
                ],
                "status_id": 13,
                "text": "connection error of type PROTOCOL_VIOLATION."
              }
            ],
            "",
            "   Transmission errors, timeouts, and retransmissions might cause the",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   same NEW_CONNECTION_ID frame to be received multiple times.  "
              },
              {
                "annotation_ids": [
                  "97dff66ee901d7ee",
                  "d92961ee53f39fc0",
                  "198218462724e69b"
                ],
                "status_id": 9,
                "text": "Receipt"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "97dff66ee901d7ee",
                  "d92961ee53f39fc0",
                  "198218462724e69b"
                ],
                "status_id": 9,
                "text": "of the same frame multiple times MUST NOT be treated as a connection"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "97dff66ee901d7ee",
                  "d92961ee53f39fc0",
                  "198218462724e69b"
                ],
                "status_id": 9,
                "text": "error."
              },
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "  A receiver can use the sequence number supplied in the"
              }
            ],
            "   NEW_CONNECTION_ID frame to handle receiving the same",
            "   NEW_CONNECTION_ID frame multiple times.",
            "",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "d730f5a0fe9c6bad",
                  "f3d93f720b55fd5b",
                  "c19c9aef1a04ac39",
                  "d15970a4588be94f",
                  "a7964905f1372b94",
                  "1084c3c1e2aafb55",
                  "81a3dc1b2f852b42"
                ],
                "status_id": 11,
                "text": "If an endpoint receives a NEW_CONNECTION_ID frame that repeats a"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "d730f5a0fe9c6bad",
                  "f3d93f720b55fd5b",
                  "c19c9aef1a04ac39",
                  "d15970a4588be94f",
                  "a7964905f1372b94",
                  "1084c3c1e2aafb55",
                  "81a3dc1b2f852b42"
                ],
                "status_id": 11,
                "text": "previously issued connection ID with a different Stateless Reset"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "d730f5a0fe9c6bad",
                  "f3d93f720b55fd5b",
                  "c19c9aef1a04ac39",
                  "d15970a4588be94f",
                  "a7964905f1372b94",
                  "1084c3c1e2aafb55",
                  "81a3dc1b2f852b42"
                ],
                "status_id": 11,
                "text": "Token field value or a different Sequence Number field value, or if a"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "d730f5a0fe9c6bad",
                  "f3d93f720b55fd5b",
                  "c19c9aef1a04ac39",
                  "d15970a4588be94f",
                  "a7964905f1372b94",
                  "1084c3c1e2aafb55",
                  "81a3dc1b2f852b42"
                ],
                "status_id": 11,
                "text": "sequence number is used for different connection IDs, the endpoint"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "d730f5a0fe9c6bad",
                  "f3d93f720b55fd5b",
                  "c19c9aef1a04ac39",
                  "d15970a4588be94f",
                  "a7964905f1372b94",
                  "1084c3c1e2aafb55",
                  "81a3dc1b2f852b42"
                ],
                "status_id": 11,
                "text": "MAY treat that receipt as a connection error of type"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "d730f5a0fe9c6bad",
                  "f3d93f720b55fd5b",
                  "c19c9aef1a04ac39",
                  "d15970a4588be94f",
                  "a7964905f1372b94",
                  "1084c3c1e2aafb55",
                  "81a3dc1b2f852b42"
                ],
                "status_id": 11,
                "text": "PROTOCOL_VIOLATION."
              }
            ],
            "",
            "   The Retire Prior To field applies to connection IDs established",
            "   during connection setup and the preferred_address transport",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   parameter; see Section 5.1.2.  "
              },
              {
                "annotation_ids": [
                  "eb1cae10e1bf8741",
                  "fc6dd938659ee64e"
                ],
                "status_id": 13,
                "text": "The value in the Retire Prior To field"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "eb1cae10e1bf8741",
                  "fc6dd938659ee64e"
                ],
                "status_id": 13,
                "text": "MUST be less than or equal to the value in the Sequence Number field."
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "91aa599ca3a14545",
                  "5364fbe0f3d2754a"
                ],
                "status_id": 13,
                "text": "Receiving a value in the Retire Prior To field that is greater than"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "91aa599ca3a14545",
                  "5364fbe0f3d2754a"
                ],
                "status_id": 13,
                "text": "that in the Sequence Number field MUST be treated as a connection"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "91aa599ca3a14545",
                  "5364fbe0f3d2754a"
                ],
                "status_id": 13,
                "text": "error of type FRAME_ENCODING_ERROR."
              }
            ],
            "",
            "   Once a sender indicates a Retire Prior To value, smaller values sent",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   in subsequent NEW_CONNECTION_ID frames have no effect.  "
              },
              {
                "annotation_ids": [
                  "bdadc9a9793d7546",
                  "0f2abebe1358449a",
                  "ca2bdd29147f0cd5"
                ],
                "status_id": 9,
                "text": "A receiver"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "bdadc9a9793d7546",
                  "0f2abebe1358449a",
                  "ca2bdd29147f0cd5"
                ],
                "status_id": 9,
                "text": "MUST ignore any Retire Prior To fields that do not increase the"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "bdadc9a9793d7546",
                  "0f2abebe1358449a",
                  "ca2bdd29147f0cd5"
                ],
                "status_id": 9,
                "text": "largest received Retire Prior To value."
              }
            ],
            "",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "0dfb890a1a0afec1",
                  "b9fdd533fa0708ad"
                ],
                "status_id": 13,
                "text": "An endpoint that receives a NEW_CONNECTION_ID frame with a sequence"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "0dfb890a1a0afec1",
                  "b9fdd533fa0708ad"
                ],
                "status_id": 13,
                "text": "number smaller than the Retire Prior To field of a previously"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "0dfb890a1a0afec1",
                  "b9fdd533fa0708ad"
                ],
                "status_id": 13,
                "text": "received NEW_CONNECTION_ID frame MUST send a corresponding"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "0dfb890a1a0afec1",
                  "b9fdd533fa0708ad"
                ],
                "status_id": 13,
                "text": "RETIRE_CONNECTION_ID frame that retires the newly received connection"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "0dfb890a1a0afec1",
                  "b9fdd533fa0708ad"
                ],
                "status_id": 13,
                "text": "ID, unless it has already done so for that sequence number."
              }
            ]
          ],
          "requirements": [
            "ea84b8e420be738f",
            "ea84b8e420be738f",
            "ea84b8e420be738f",
            "48ee6ac897287dda",
            "48ee6ac897287dda",
            "6233dd3eb0b7fc97",
            "6233dd3eb0b7fc97",
            "6233dd3eb0b7fc97",
            "198218462724e69b",
            "198218462724e69b",
            "198218462724e69b",
            "81a3dc1b2f852b42",
            "81a3dc1b2f852b42",
            "81a3dc1b2f852b42",
            "81a3dc1b2f852b42",
            "81a3dc1b2f852b42",
            "81a3dc1b2f852b42",
            "fc6dd938659ee64e",
            "fc6dd938659ee64e",
            "5364fbe0f3d2754a",
            "5364fbe0f3d2754a",
            "5364fbe0f3d2754a",
            "ca2bdd29147f0cd5",
            "ca2bdd29147f0cd5",
            "ca2bdd29147f0cd5",
            "b9fdd533fa0708ad",
            "b9fdd533fa0708ad",
            "b9fdd533fa0708ad",
            "b9fdd533fa0708ad",
            "b9fdd533fa0708ad"
          ],
          "title": "NEW_CONNECTION_ID Frames"
        },
        {
          "id": "section-19.16",
          "lines": [
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "e2cf795290568733"
                ],
                "status_id": 1,
                "text": "An endpoint sends a RETIRE_CONNECTION_ID frame (type=0x19) to"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "e2cf795290568733"
                ],
                "status_id": 1,
                "text": "indicate that it will no longer use a connection ID that was issued"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "e2cf795290568733"
                ],
                "status_id": 1,
                "text": "by its peer."
              },
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "  This includes the connection ID provided during the"
              }
            ],
            "   handshake.  Sending a RETIRE_CONNECTION_ID frame also serves as a",
            "   request to the peer to send additional connection IDs for future use;",
            "   see Section 5.1.  New connection IDs can be delivered to a peer using",
            "   the NEW_CONNECTION_ID frame (Section 19.15).",
            "",
            "   Retiring a connection ID invalidates the stateless reset token",
            "   associated with that connection ID.",
            "",
            "   RETIRE_CONNECTION_ID frames are formatted as shown in Figure 40.",
            "",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "59c73b25f0bc027b"
                ],
                "status_id": 1,
                "text": "RETIRE_CONNECTION_ID Frame {"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "     "
              },
              {
                "annotation_ids": [
                  "59c73b25f0bc027b"
                ],
                "status_id": 1,
                "text": "Type (i) = 0x19,"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "     "
              },
              {
                "annotation_ids": [
                  "59c73b25f0bc027b"
                ],
                "status_id": 1,
                "text": "Sequence Number (i),"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "}"
              }
            ],
            "",
            "                Figure 40: RETIRE_CONNECTION_ID Frame Format",
            "",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "98beb36fafee383a"
                ],
                "status_id": 1,
                "text": "RETIRE_CONNECTION_ID frames contain the following field:"
              }
            ],
            "",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "98beb36fafee383a"
                ],
                "status_id": 1,
                "text": "Sequence Number:  The sequence number of the connection ID being"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "      "
              },
              {
                "annotation_ids": [
                  "98beb36fafee383a"
                ],
                "status_id": 1,
                "text": "retired; see Section 5.1.2."
              }
            ],
            "",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "8e623f9de67c5d59",
                  "a95a74f12dc1b290",
                  "ba5d564bdf8b3191",
                  "8846fd20551610df"
                ],
                "status_id": 9,
                "text": "Receipt of a RETIRE_CONNECTION_ID frame containing a sequence number"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "8e623f9de67c5d59",
                  "a95a74f12dc1b290",
                  "ba5d564bdf8b3191",
                  "8846fd20551610df"
                ],
                "status_id": 9,
                "text": "greater than any previously sent to the peer MUST be treated as a"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "8e623f9de67c5d59",
                  "a95a74f12dc1b290",
                  "ba5d564bdf8b3191",
                  "8846fd20551610df"
                ],
                "status_id": 9,
                "text": "connection error of type PROTOCOL_VIOLATION."
              }
            ],
            "",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "d697ecea7f56dff0",
                  "f753bac8e2fbb454",
                  "5040c615a7f26d99",
                  "f6f4f1c750733f3e"
                ],
                "status_id": 9,
                "text": "The sequence number specified in a RETIRE_CONNECTION_ID frame MUST"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "d697ecea7f56dff0",
                  "f753bac8e2fbb454",
                  "5040c615a7f26d99",
                  "f6f4f1c750733f3e"
                ],
                "status_id": 9,
                "text": "NOT refer to the Destination Connection ID field of the packet in"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "d697ecea7f56dff0",
                  "f753bac8e2fbb454",
                  "5040c615a7f26d99",
                  "f6f4f1c750733f3e"
                ],
                "status_id": 9,
                "text": "which the frame is contained."
              },
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "  "
              },
              {
                "annotation_ids": [
                  "7cc0082cc88df396",
                  "f4973d38de9e9c4a",
                  "e4b69adbdaec1095",
                  "9495fb37a31499ed"
                ],
                "status_id": 11,
                "text": "The peer MAY treat this as a"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "7cc0082cc88df396",
                  "f4973d38de9e9c4a",
                  "e4b69adbdaec1095",
                  "9495fb37a31499ed"
                ],
                "status_id": 11,
                "text": "connection error of type PROTOCOL_VIOLATION."
              }
            ],
            "",
            "   An endpoint cannot send this frame if it was provided with a zero-",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   length connection ID by its peer.  "
              },
              {
                "annotation_ids": [
                  "17fa259b1b17515d",
                  "adbee28bcbdda392"
                ],
                "status_id": 12,
                "text": "An endpoint that provides a zero-"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "17fa259b1b17515d",
                  "adbee28bcbdda392"
                ],
                "status_id": 12,
                "text": "length connection ID MUST treat receipt of a RETIRE_CONNECTION_ID"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "17fa259b1b17515d",
                  "adbee28bcbdda392"
                ],
                "status_id": 12,
                "text": "frame as a connection error of type PROTOCOL_VIOLATION."
              }
            ]
          ],
          "requirements": [
            "8846fd20551610df",
            "8846fd20551610df",
            "8846fd20551610df",
            "f6f4f1c750733f3e",
            "f6f4f1c750733f3e",
            "f6f4f1c750733f3e",
            "9495fb37a31499ed",
            "9495fb37a31499ed",
            "adbee28bcbdda392",
            "adbee28bcbdda392",
            "adbee28bcbdda392"
          ],
          "title": "RETIRE_CONNECTION_ID Frames"
        },
        {
          "id": "section-19.17",
          "lines": [
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "31f9a11ce5326fbc"
                ],
                "status_id": 1,
                "text": "Endpoints can use PATH_CHALLENGE frames (type=0x1a) to check"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "31f9a11ce5326fbc"
                ],
                "status_id": 1,
                "text": "reachability to the peer and for path validation during connection"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "31f9a11ce5326fbc"
                ],
                "status_id": 1,
                "text": "migration."
              }
            ],
            "",
            "   PATH_CHALLENGE frames are formatted as shown in Figure 41.",
            "",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "8a59aeac25654e72"
                ],
                "status_id": 1,
                "text": "PATH_CHALLENGE Frame {"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "     "
              },
              {
                "annotation_ids": [
                  "8a59aeac25654e72"
                ],
                "status_id": 1,
                "text": "Type (i) = 0x1a,"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "     "
              },
              {
                "annotation_ids": [
                  "8a59aeac25654e72"
                ],
                "status_id": 1,
                "text": "Data (64),"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "}"
              }
            ],
            "",
            "                   Figure 41: PATH_CHALLENGE Frame Format",
            "",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "ba3d6b30f34d0f67"
                ],
                "status_id": 1,
                "text": "PATH_CHALLENGE frames contain the following field:"
              }
            ],
            "",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "ba3d6b30f34d0f67"
                ],
                "status_id": 1,
                "text": "Data:  This 8-byte field contains arbitrary data."
              }
            ],
            "",
            "   Including 64 bits of entropy in a PATH_CHALLENGE frame ensures that",
            "   it is easier to receive the packet than it is to guess the value",
            "   correctly.",
            "",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "14fbfda4dd5655a1"
                ],
                "status_id": 20,
                "text": "The recipient of this frame MUST generate a PATH_RESPONSE frame"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "14fbfda4dd5655a1"
                ],
                "status_id": 20,
                "text": "(Section 19.18) containing the same Data value."
              }
            ]
          ],
          "requirements": [
            "14fbfda4dd5655a1",
            "14fbfda4dd5655a1"
          ],
          "title": "PATH_CHALLENGE Frames"
        },
        {
          "id": "section-19.18",
          "lines": [
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "acdda1fd580bb199"
                ],
                "status_id": 1,
                "text": "A PATH_RESPONSE frame (type=0x1b) is sent in response to a"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "acdda1fd580bb199"
                ],
                "status_id": 1,
                "text": "PATH_CHALLENGE frame."
              }
            ],
            "",
            "   PATH_RESPONSE frames are formatted as shown in Figure 42.  The format",
            "   of a PATH_RESPONSE frame is identical to that of the PATH_CHALLENGE",
            "   frame; see Section 19.17.",
            "",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "ca977610538a00bd"
                ],
                "status_id": 1,
                "text": "PATH_RESPONSE Frame {"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "     "
              },
              {
                "annotation_ids": [
                  "ca977610538a00bd"
                ],
                "status_id": 1,
                "text": "Type (i) = 0x1b,"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "     "
              },
              {
                "annotation_ids": [
                  "ca977610538a00bd"
                ],
                "status_id": 1,
                "text": "Data (64),"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "}"
              }
            ],
            "",
            "                   Figure 42: PATH_RESPONSE Frame Format",
            "",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "9e451ef7e7400a0c"
                ],
                "status_id": 19,
                "text": "If the content of a PATH_RESPONSE frame does not match the content of"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "9e451ef7e7400a0c"
                ],
                "status_id": 19,
                "text": "a PATH_CHALLENGE frame previously sent by the endpoint, the endpoint"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "9e451ef7e7400a0c"
                ],
                "status_id": 19,
                "text": "MAY generate a connection error of type PROTOCOL_VIOLATION."
              }
            ]
          ],
          "requirements": [
            "9e451ef7e7400a0c",
            "9e451ef7e7400a0c",
            "9e451ef7e7400a0c"
          ],
          "title": "PATH_RESPONSE Frames"
        },
        {
          "id": "section-19.19",
          "lines": [
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "53af201ba3926595"
                ],
                "status_id": 1,
                "text": "An endpoint sends a CONNECTION_CLOSE frame (type=0x1c or 0x1d) to"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "53af201ba3926595"
                ],
                "status_id": 1,
                "text": "notify its peer that the connection is being closed.  The"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "53af201ba3926595"
                ],
                "status_id": 1,
                "text": "CONNECTION_CLOSE frame with a type of 0x1c is used to signal errors"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "53af201ba3926595"
                ],
                "status_id": 1,
                "text": "at only the QUIC layer, or the absence of errors (with the NO_ERROR"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "53af201ba3926595"
                ],
                "status_id": 1,
                "text": "code).  The CONNECTION_CLOSE frame with a type of 0x1d is used to"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "53af201ba3926595"
                ],
                "status_id": 1,
                "text": "signal an error with the application that uses QUIC."
              }
            ],
            "",
            "   If there are open streams that have not been explicitly closed, they",
            "   are implicitly closed when the connection is closed.",
            "",
            "   CONNECTION_CLOSE frames are formatted as shown in Figure 43.",
            "",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "bc923cf546d80c67"
                ],
                "status_id": 1,
                "text": "CONNECTION_CLOSE Frame {"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "     "
              },
              {
                "annotation_ids": [
                  "bc923cf546d80c67"
                ],
                "status_id": 1,
                "text": "Type (i) = 0x1c..0x1d,"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "     "
              },
              {
                "annotation_ids": [
                  "bc923cf546d80c67"
                ],
                "status_id": 1,
                "text": "Error Code (i),"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "     "
              },
              {
                "annotation_ids": [
                  "bc923cf546d80c67"
                ],
                "status_id": 1,
                "text": "[Frame Type (i)],"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "     "
              },
              {
                "annotation_ids": [
                  "bc923cf546d80c67"
                ],
                "status_id": 1,
                "text": "Reason Phrase Length (i),"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "     "
              },
              {
                "annotation_ids": [
                  "bc923cf546d80c67"
                ],
                "status_id": 1,
                "text": "Reason Phrase (..),"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "}"
              }
            ],
            "",
            "                  Figure 43: CONNECTION_CLOSE Frame Format",
            "",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "ce8adf96b5bc4989"
                ],
                "status_id": 1,
                "text": "CONNECTION_CLOSE frames contain the following fields:"
              }
            ],
            "",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "ce8adf96b5bc4989"
                ],
                "status_id": 1,
                "text": "Error Code:  A variable-length integer that indicates the reason for"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "      "
              },
              {
                "annotation_ids": [
                  "ce8adf96b5bc4989"
                ],
                "status_id": 1,
                "text": "closing this connection.  A CONNECTION_CLOSE frame of type 0x1c"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "      "
              },
              {
                "annotation_ids": [
                  "ce8adf96b5bc4989"
                ],
                "status_id": 1,
                "text": "uses codes from the space defined in Section 20.1.  A"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "      "
              },
              {
                "annotation_ids": [
                  "ce8adf96b5bc4989"
                ],
                "status_id": 1,
                "text": "CONNECTION_CLOSE frame of type 0x1d uses codes defined by the"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "      "
              },
              {
                "annotation_ids": [
                  "ce8adf96b5bc4989"
                ],
                "status_id": 1,
                "text": "application protocol; see Section 20.2."
              }
            ],
            "",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "ce8adf96b5bc4989"
                ],
                "status_id": 1,
                "text": "Frame Type:  A variable-length integer encoding the type of frame"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "      "
              },
              {
                "annotation_ids": [
                  "ce8adf96b5bc4989"
                ],
                "status_id": 1,
                "text": "that triggered the error.  "
              },
              {
                "annotation_ids": [
                  "ce8adf96b5bc4989",
                  "c2d800e2dbe76f25"
                ],
                "status_id": 1,
                "text": "A value of 0 (equivalent to the mention"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "      "
              },
              {
                "annotation_ids": [
                  "ce8adf96b5bc4989",
                  "c2d800e2dbe76f25"
                ],
                "status_id": 1,
                "text": "of the PADDING frame) is used when the frame type is unknown."
              },
              {
                "annotation_ids": [
                  "ce8adf96b5bc4989"
                ],
                "status_id": 1,
                "text": "  The"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "      "
              },
              {
                "annotation_ids": [
                  "ce8adf96b5bc4989"
                ],
                "status_id": 1,
                "text": "application-specific variant of CONNECTION_CLOSE (type 0x1d) does"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "      "
              },
              {
                "annotation_ids": [
                  "ce8adf96b5bc4989"
                ],
                "status_id": 1,
                "text": "not include this field."
              }
            ],
            "",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "ce8adf96b5bc4989"
                ],
                "status_id": 1,
                "text": "Reason Phrase Length:  A variable-length integer specifying the"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "      "
              },
              {
                "annotation_ids": [
                  "ce8adf96b5bc4989"
                ],
                "status_id": 1,
                "text": "length of the reason phrase in bytes.  Because a CONNECTION_CLOSE"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "      "
              },
              {
                "annotation_ids": [
                  "ce8adf96b5bc4989"
                ],
                "status_id": 1,
                "text": "frame cannot be split between packets, any limits on packet size"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "      "
              },
              {
                "annotation_ids": [
                  "ce8adf96b5bc4989"
                ],
                "status_id": 1,
                "text": "will also limit the space available for a reason phrase."
              }
            ],
            "",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "ce8adf96b5bc4989"
                ],
                "status_id": 1,
                "text": "Reason Phrase:  Additional diagnostic information for the closure."
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "      "
              },
              {
                "annotation_ids": [
                  "ce8adf96b5bc4989"
                ],
                "status_id": 1,
                "text": "This can be zero length if the sender chooses not to give details"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "      "
              },
              {
                "annotation_ids": [
                  "ce8adf96b5bc4989"
                ],
                "status_id": 1,
                "text": "beyond the Error Code value.  "
              },
              {
                "annotation_ids": [
                  "ce8adf96b5bc4989",
                  "bdb1386b53f55e52"
                ],
                "status_id": 22,
                "text": "This SHOULD be a UTF-8 encoded"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "      "
              },
              {
                "annotation_ids": [
                  "ce8adf96b5bc4989",
                  "bdb1386b53f55e52"
                ],
                "status_id": 22,
                "text": "string [RFC3629], though the frame does not carry information,"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "      "
              },
              {
                "annotation_ids": [
                  "ce8adf96b5bc4989",
                  "bdb1386b53f55e52"
                ],
                "status_id": 22,
                "text": "such as language tags, that would aid comprehension by any entity"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "      "
              },
              {
                "annotation_ids": [
                  "ce8adf96b5bc4989",
                  "bdb1386b53f55e52"
                ],
                "status_id": 22,
                "text": "other than the one that created the text."
              }
            ],
            "",
            "   The application-specific variant of CONNECTION_CLOSE (type 0x1d) can",
            "   only be sent using 0-RTT or 1-RTT packets; see Section 12.5.  When an",
            "   application wishes to abandon a connection during the handshake, an",
            "   endpoint can send a CONNECTION_CLOSE frame (type 0x1c) with an error",
            "   code of APPLICATION_ERROR in an Initial or Handshake packet."
          ],
          "requirements": [
            "bdb1386b53f55e52",
            "bdb1386b53f55e52",
            "bdb1386b53f55e52",
            "bdb1386b53f55e52"
          ],
          "title": "CONNECTION_CLOSE Frames"
        },
        {
          "id": "section-19.20",
          "lines": [
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "9affd75924e8db33"
                ],
                "status_id": 1,
                "text": "The server uses a HANDSHAKE_DONE frame (type=0x1e) to signal"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "9affd75924e8db33"
                ],
                "status_id": 1,
                "text": "confirmation of the handshake to the client."
              }
            ],
            "",
            "   HANDSHAKE_DONE frames are formatted as shown in Figure 44, which",
            "   shows that HANDSHAKE_DONE frames have no content.",
            "",
            "   HANDSHAKE_DONE Frame {",
            "     Type (i) = 0x1e,",
            "   }",
            "",
            "                   Figure 44: HANDSHAKE_DONE Frame Format",
            "",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "863ea3e7cc0d9ec5"
                ],
                "status_id": 1,
                "text": "A HANDSHAKE_DONE frame can only be sent by the server."
              },
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "  "
              },
              {
                "annotation_ids": [
                  "49098b523f8eb4b0"
                ],
                "status_id": 20,
                "text": "Servers MUST"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "49098b523f8eb4b0"
                ],
                "status_id": 20,
                "text": "NOT send a HANDSHAKE_DONE frame before completing the handshake."
              },
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "  "
              },
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "A"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "d92158911cc1cdb2",
                  "b9a09cef0113408b"
                ],
                "status_id": 13,
                "text": "server MUST treat receipt of a HANDSHAKE_DONE frame as a connection"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "d92158911cc1cdb2",
                  "b9a09cef0113408b"
                ],
                "status_id": 13,
                "text": "error of type PROTOCOL_VIOLATION."
              }
            ]
          ],
          "requirements": [
            "49098b523f8eb4b0",
            "49098b523f8eb4b0",
            "b9a09cef0113408b",
            "b9a09cef0113408b",
            "b9a09cef0113408b"
          ],
          "title": "HANDSHAKE_DONE Frames"
        },
        {
          "id": "section-19.21",
          "lines": [
            "   QUIC frames do not use a self-describing encoding.  An endpoint",
            "   therefore needs to understand the syntax of all frames before it can",
            "   successfully process a packet.  This allows for efficient encoding of",
            "   frames, but it means that an endpoint cannot send a frame of a type",
            "   that is unknown to its peer.",
            "",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "ee65cf1d92ba3e96"
                ],
                "status_id": 20,
                "text": "An extension to QUIC that wishes to use a new type of frame MUST"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "ee65cf1d92ba3e96"
                ],
                "status_id": 20,
                "text": "first ensure that a peer is able to understand the frame."
              },
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "  An"
              }
            ],
            "   endpoint can use a transport parameter to signal its willingness to",
            "   receive extension frame types.  One transport parameter can indicate",
            "   support for one or more extension frame types.",
            "",
            "   Extensions that modify or replace core protocol functionality",
            "   (including frame types) will be difficult to combine with other",
            "   extensions that modify or replace the same functionality unless the",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   behavior of the combination is explicitly defined.  "
              },
              {
                "annotation_ids": [
                  "7e702e9ddf991805"
                ],
                "status_id": 14,
                "text": "Such extensions"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "7e702e9ddf991805"
                ],
                "status_id": 14,
                "text": "SHOULD define their interaction with previously defined extensions"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "7e702e9ddf991805"
                ],
                "status_id": 14,
                "text": "modifying the same protocol components."
              }
            ],
            "",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "9f3d2bf711e323a0",
                  "9c959994bda7f03f",
                  "54a9ec55f6b24e36",
                  "a7acfeed97922052"
                ],
                "status_id": 13,
                "text": "Extension frames MUST be congestion controlled and MUST cause an ACK"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "9f3d2bf711e323a0",
                  "9c959994bda7f03f",
                  "54a9ec55f6b24e36",
                  "a7acfeed97922052"
                ],
                "status_id": 13,
                "text": "frame to be sent."
              },
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "  The exception is extension frames that replace or"
              }
            ],
            "   supplement the ACK frame.  Extension frames are not included in flow",
            "   control unless specified in the extension.",
            "",
            "   An IANA registry is used to manage the assignment of frame types; see",
            "   Section 22.4."
          ],
          "requirements": [
            "ee65cf1d92ba3e96",
            "ee65cf1d92ba3e96",
            "7e702e9ddf991805",
            "7e702e9ddf991805",
            "7e702e9ddf991805",
            "54a9ec55f6b24e36",
            "54a9ec55f6b24e36",
            "a7acfeed97922052",
            "a7acfeed97922052"
          ],
          "title": "Extension Frames"
        },
        {
          "id": "section-20",
          "lines": [
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "46523bd428dff84a"
                ],
                "status_id": 1,
                "text": "QUIC transport error codes and application error codes are 62-bit"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "46523bd428dff84a"
                ],
                "status_id": 1,
                "text": "unsigned integers."
              }
            ]
          ],
          "title": "Error Codes"
        },
        {
          "id": "section-20.1",
          "lines": [
            "   This section lists the defined QUIC transport error codes that can be",
            "   used in a CONNECTION_CLOSE frame with a type of 0x1c.  These errors",
            "   apply to the entire connection.",
            "",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "d380439b9aedfb90"
                ],
                "status_id": 1,
                "text": "NO_ERROR (0x00):  An endpoint uses this with CONNECTION_CLOSE to"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "      "
              },
              {
                "annotation_ids": [
                  "d380439b9aedfb90"
                ],
                "status_id": 1,
                "text": "signal that the connection is being closed abruptly in the absence"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "      "
              },
              {
                "annotation_ids": [
                  "d380439b9aedfb90"
                ],
                "status_id": 1,
                "text": "of any error."
              }
            ],
            "",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "17964b8e757724d9"
                ],
                "status_id": 1,
                "text": "INTERNAL_ERROR (0x01):  The endpoint encountered an internal error"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "      "
              },
              {
                "annotation_ids": [
                  "17964b8e757724d9"
                ],
                "status_id": 1,
                "text": "and cannot continue with the connection."
              }
            ],
            "",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "20e85385bd5e7236"
                ],
                "status_id": 1,
                "text": "CONNECTION_REFUSED (0x02):  The server refused to accept a new"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "      "
              },
              {
                "annotation_ids": [
                  "20e85385bd5e7236"
                ],
                "status_id": 1,
                "text": "connection."
              }
            ],
            "",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "73eb661d5e3e4452"
                ],
                "status_id": 1,
                "text": "FLOW_CONTROL_ERROR (0x03):  An endpoint received more data than it"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "      "
              },
              {
                "annotation_ids": [
                  "73eb661d5e3e4452"
                ],
                "status_id": 1,
                "text": "permitted in its advertised data limits; see Section 4."
              }
            ],
            "",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "26d3b12276a3f72a"
                ],
                "status_id": 1,
                "text": "STREAM_LIMIT_ERROR (0x04):  An endpoint received a frame for a stream"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "      "
              },
              {
                "annotation_ids": [
                  "26d3b12276a3f72a"
                ],
                "status_id": 1,
                "text": "identifier that exceeded its advertised stream limit for the"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "      "
              },
              {
                "annotation_ids": [
                  "26d3b12276a3f72a"
                ],
                "status_id": 1,
                "text": "corresponding stream type."
              }
            ],
            "",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "cfafa4beb394b3dc"
                ],
                "status_id": 1,
                "text": "STREAM_STATE_ERROR (0x05):  An endpoint received a frame for a stream"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "      "
              },
              {
                "annotation_ids": [
                  "cfafa4beb394b3dc"
                ],
                "status_id": 1,
                "text": "that was not in a state that permitted that frame; see Section 3."
              }
            ],
            "",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "168a1e9af7f76663"
                ],
                "status_id": 1,
                "text": "FINAL_SIZE_ERROR (0x06):  (1) An endpoint received a STREAM frame"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "      "
              },
              {
                "annotation_ids": [
                  "168a1e9af7f76663"
                ],
                "status_id": 1,
                "text": "containing data that exceeded the previously established final"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "      "
              },
              {
                "annotation_ids": [
                  "168a1e9af7f76663"
                ],
                "status_id": 1,
                "text": "size, (2) an endpoint received a STREAM frame or a RESET_STREAM"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "      "
              },
              {
                "annotation_ids": [
                  "168a1e9af7f76663"
                ],
                "status_id": 1,
                "text": "frame containing a final size that was lower than the size of"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "      "
              },
              {
                "annotation_ids": [
                  "168a1e9af7f76663"
                ],
                "status_id": 1,
                "text": "stream data that was already received, or (3) an endpoint received"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "      "
              },
              {
                "annotation_ids": [
                  "168a1e9af7f76663"
                ],
                "status_id": 1,
                "text": "a STREAM frame or a RESET_STREAM frame containing a different"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "      "
              },
              {
                "annotation_ids": [
                  "168a1e9af7f76663"
                ],
                "status_id": 1,
                "text": "final size to the one already established."
              }
            ],
            "",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "80c3daafda0a7aa2"
                ],
                "status_id": 1,
                "text": "FRAME_ENCODING_ERROR (0x07):  An endpoint received a frame that was"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "      "
              },
              {
                "annotation_ids": [
                  "80c3daafda0a7aa2"
                ],
                "status_id": 1,
                "text": "badly formatted -- for instance, a frame of an unknown type or an"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "      "
              },
              {
                "annotation_ids": [
                  "80c3daafda0a7aa2"
                ],
                "status_id": 1,
                "text": "ACK frame that has more acknowledgment ranges than the remainder"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "      "
              },
              {
                "annotation_ids": [
                  "80c3daafda0a7aa2"
                ],
                "status_id": 1,
                "text": "of the packet could carry."
              }
            ],
            "",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "60b156c0a4eb5b0f"
                ],
                "status_id": 1,
                "text": "TRANSPORT_PARAMETER_ERROR (0x08):  An endpoint received transport"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "      "
              },
              {
                "annotation_ids": [
                  "60b156c0a4eb5b0f"
                ],
                "status_id": 1,
                "text": "parameters that were badly formatted, included an invalid value,"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "      "
              },
              {
                "annotation_ids": [
                  "60b156c0a4eb5b0f"
                ],
                "status_id": 1,
                "text": "omitted a mandatory transport parameter, included a forbidden"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "      "
              },
              {
                "annotation_ids": [
                  "60b156c0a4eb5b0f"
                ],
                "status_id": 1,
                "text": "transport parameter, or were otherwise in error."
              }
            ],
            "",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "134b6981ff66f603"
                ],
                "status_id": 1,
                "text": "CONNECTION_ID_LIMIT_ERROR (0x09):  The number of connection IDs"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "      "
              },
              {
                "annotation_ids": [
                  "134b6981ff66f603"
                ],
                "status_id": 1,
                "text": "provided by the peer exceeds the advertised"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "      "
              },
              {
                "annotation_ids": [
                  "134b6981ff66f603"
                ],
                "status_id": 1,
                "text": "active_connection_id_limit."
              }
            ],
            "",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "90671335aef22e27"
                ],
                "status_id": 1,
                "text": "PROTOCOL_VIOLATION (0x0a):  An endpoint detected an error with"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "      "
              },
              {
                "annotation_ids": [
                  "90671335aef22e27"
                ],
                "status_id": 1,
                "text": "protocol compliance that was not covered by more specific error"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "      "
              },
              {
                "annotation_ids": [
                  "90671335aef22e27"
                ],
                "status_id": 1,
                "text": "codes."
              }
            ],
            "",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "cb3a40caf9d50de3"
                ],
                "status_id": 1,
                "text": "INVALID_TOKEN (0x0b):  A server received a client Initial that"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "      "
              },
              {
                "annotation_ids": [
                  "cb3a40caf9d50de3"
                ],
                "status_id": 1,
                "text": "contained an invalid Token field."
              }
            ],
            "",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "7108970c158e08e5"
                ],
                "status_id": 1,
                "text": "APPLICATION_ERROR (0x0c):  The application or application protocol"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "      "
              },
              {
                "annotation_ids": [
                  "7108970c158e08e5"
                ],
                "status_id": 1,
                "text": "caused the connection to be closed."
              }
            ],
            "",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "19752f144e2412cc"
                ],
                "status_id": 1,
                "text": "CRYPTO_BUFFER_EXCEEDED (0x0d):  An endpoint has received more data in"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "      "
              },
              {
                "annotation_ids": [
                  "19752f144e2412cc"
                ],
                "status_id": 1,
                "text": "CRYPTO frames than it can buffer."
              }
            ],
            "",
            "   KEY_UPDATE_ERROR (0x0e):  An endpoint detected errors in performing",
            "      key updates; see Section 6 of [QUIC-TLS].",
            "",
            "   AEAD_LIMIT_REACHED (0x0f):  An endpoint has reached the",
            "      confidentiality or integrity limit for the AEAD algorithm used by",
            "      the given connection.",
            "",
            "   NO_VIABLE_PATH (0x10):  An endpoint has determined that the network",
            "      path is incapable of supporting QUIC.  An endpoint is unlikely to",
            "      receive a CONNECTION_CLOSE frame carrying this code except when",
            "      the path does not support a large enough MTU.",
            "",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "e1005aec1e3427e8"
                ],
                "status_id": 1,
                "text": "CRYPTO_ERROR (0x0100-0x01ff):  The cryptographic handshake failed.  A"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "      "
              },
              {
                "annotation_ids": [
                  "e1005aec1e3427e8"
                ],
                "status_id": 1,
                "text": "range of 256 values is reserved for carrying error codes specific"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "      "
              },
              {
                "annotation_ids": [
                  "e1005aec1e3427e8"
                ],
                "status_id": 1,
                "text": "to the cryptographic handshake that is used.  Codes for errors"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "      "
              },
              {
                "annotation_ids": [
                  "e1005aec1e3427e8"
                ],
                "status_id": 1,
                "text": "occurring when TLS is used for the cryptographic handshake are"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "      "
              },
              {
                "annotation_ids": [
                  "e1005aec1e3427e8"
                ],
                "status_id": 1,
                "text": "described in Section 4.8 of [QUIC-TLS]."
              }
            ],
            "",
            "   See Section 22.5 for details on registering new error codes.",
            "",
            "   In defining these error codes, several principles are applied.  Error",
            "   conditions that might require specific action on the part of a",
            "   recipient are given unique codes.  Errors that represent common",
            "   conditions are given specific codes.  Absent either of these",
            "   conditions, error codes are used to identify a general function of",
            "   the stack, like flow control or transport parameter handling.",
            "   Finally, generic errors are provided for conditions where",
            "   implementations are unable or unwilling to use more specific codes."
          ],
          "title": "Transport Error Codes"
        },
        {
          "id": "section-20.2",
          "lines": [
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "dea29a996a348895",
                  "919a827f7bdf3175"
                ],
                "status_id": 1,
                "text": "The management of application error codes is left to application"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "dea29a996a348895",
                  "919a827f7bdf3175"
                ],
                "status_id": 1,
                "text": "protocols."
              },
              {
                "annotation_ids": [
                  "919a827f7bdf3175"
                ],
                "status_id": 1,
                "text": "  Application protocol error codes are used for the"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "919a827f7bdf3175"
                ],
                "status_id": 1,
                "text": "RESET_STREAM frame (Section 19.4), the STOP_SENDING frame"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "919a827f7bdf3175"
                ],
                "status_id": 1,
                "text": "(Section 19.5), and the CONNECTION_CLOSE frame with a type of 0x1d"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "919a827f7bdf3175"
                ],
                "status_id": 1,
                "text": "(Section 19.19)."
              }
            ]
          ],
          "title": "Application Protocol Error Codes"
        },
        {
          "id": "section-21",
          "lines": [
            "   The goal of QUIC is to provide a secure transport connection.",
            "   Section 21.1 provides an overview of those properties; subsequent",
            "   sections discuss constraints and caveats regarding these properties,",
            "   including descriptions of known attacks and countermeasures."
          ],
          "title": "Security Considerations"
        },
        {
          "id": "section-21.1",
          "lines": [
            "   A complete security analysis of QUIC is outside the scope of this",
            "   document.  This section provides an informal description of the",
            "   desired security properties as an aid to implementers and to help",
            "   guide protocol analysis.",
            "",
            "   QUIC assumes the threat model described in [SEC-CONS] and provides",
            "   protections against many of the attacks that arise from that model.",
            "",
            "   For this purpose, attacks are divided into passive and active",
            "   attacks.  Passive attackers have the ability to read packets from the",
            "   network, while active attackers also have the ability to write",
            "   packets into the network.  However, a passive attack could involve an",
            "   attacker with the ability to cause a routing change or other",
            "   modification in the path taken by packets that comprise a connection.",
            "",
            "   Attackers are additionally categorized as either on-path attackers or",
            "   off-path attackers.  An on-path attacker can read, modify, or remove",
            "   any packet it observes such that the packet no longer reaches its",
            "   destination, while an off-path attacker observes the packets but",
            "   cannot prevent the original packet from reaching its intended",
            "   destination.  Both types of attackers can also transmit arbitrary",
            "   packets.  This definition differs from that of Section 3.5 of",
            "   [SEC-CONS] in that an off-path attacker is able to observe packets.",
            "",
            "   Properties of the handshake, protected packets, and connection",
            "   migration are considered separately."
          ],
          "title": "Overview of Security Properties"
        },
        {
          "id": "section-21.1.1",
          "lines": [
            "   The QUIC handshake incorporates the TLS 1.3 handshake and inherits",
            "   the cryptographic properties described in Appendix E.1 of [TLS13].",
            "   Many of the security properties of QUIC depend on the TLS handshake",
            "   providing these properties.  Any attack on the TLS handshake could",
            "   affect QUIC.",
            "",
            "   Any attack on the TLS handshake that compromises the secrecy or",
            "   uniqueness of session keys, or the authentication of the",
            "   participating peers, affects other security guarantees provided by",
            "   QUIC that depend on those keys.  For instance, migration (Section 9)",
            "   depends on the efficacy of confidentiality protections, both for the",
            "   negotiation of keys using the TLS handshake and for QUIC packet",
            "   protection, to avoid linkability across network paths.",
            "",
            "   An attack on the integrity of the TLS handshake might allow an",
            "   attacker to affect the selection of application protocol or QUIC",
            "   version.",
            "",
            "   In addition to the properties provided by TLS, the QUIC handshake",
            "   provides some defense against DoS attacks on the handshake."
          ],
          "title": "Handshake"
        },
        {
          "id": "section-21.1.1.1",
          "lines": [
            "   Address validation (Section 8) is used to verify that an entity that",
            "   claims a given address is able to receive packets at that address.",
            "   Address validation limits amplification attack targets to addresses",
            "   for which an attacker can observe packets.",
            "",
            "   Prior to address validation, endpoints are limited in what they are",
            "   able to send.  Endpoints cannot send data toward an unvalidated",
            "   address in excess of three times the data received from that address.",
            "",
            "      |  Note: The anti-amplification limit only applies when an",
            "      |  endpoint responds to packets received from an unvalidated",
            "      |  address.  The anti-amplification limit does not apply to",
            "      |  clients when establishing a new connection or when initiating",
            "      |  connection migration."
          ],
          "title": "Anti-Amplification"
        },
        {
          "id": "section-21.1.1.2",
          "lines": [
            "   Computing the server's first flight for a full handshake is",
            "   potentially expensive, requiring both a signature and a key exchange",
            "   computation.  In order to prevent computational DoS attacks, the",
            "   Retry packet provides a cheap token exchange mechanism that allows",
            "   servers to validate a client's IP address prior to doing any",
            "   expensive computations at the cost of a single round trip.  After a",
            "   successful handshake, servers can issue new tokens to a client, which",
            "   will allow new connection establishment without incurring this cost."
          ],
          "title": "Server-Side DoS"
        },
        {
          "id": "section-21.1.1.3",
          "lines": [
            "   An on-path or off-path attacker can force a handshake to fail by",
            "   replacing or racing Initial packets.  Once valid Initial packets have",
            "   been exchanged, subsequent Handshake packets are protected with the",
            "   Handshake keys, and an on-path attacker cannot force handshake",
            "   failure other than by dropping packets to cause endpoints to abandon",
            "   the attempt.",
            "",
            "   An on-path attacker can also replace the addresses of packets on",
            "   either side and therefore cause the client or server to have an",
            "   incorrect view of the remote addresses.  Such an attack is",
            "   indistinguishable from the functions performed by a NAT."
          ],
          "title": "On-Path Handshake Termination"
        },
        {
          "id": "section-21.1.1.4",
          "lines": [
            "   The entire handshake is cryptographically protected, with the Initial",
            "   packets being encrypted with per-version keys and the Handshake and",
            "   later packets being encrypted with keys derived from the TLS key",
            "   exchange.  Further, parameter negotiation is folded into the TLS",
            "   transcript and thus provides the same integrity guarantees as",
            "   ordinary TLS negotiation.  An attacker can observe the client's",
            "   transport parameters (as long as it knows the version-specific salt)",
            "   but cannot observe the server's transport parameters and cannot",
            "   influence parameter negotiation.",
            "",
            "   Connection IDs are unencrypted but integrity protected in all",
            "   packets.",
            "",
            "   This version of QUIC does not incorporate a version negotiation",
            "   mechanism; implementations of incompatible versions will simply fail",
            "   to establish a connection."
          ],
          "title": "Parameter Negotiation"
        },
        {
          "id": "section-21.1.2",
          "lines": [
            "   Packet protection (Section 12.1) applies authenticated encryption to",
            "   all packets except Version Negotiation packets, though Initial and",
            "   Retry packets have limited protection due to the use of version-",
            "   specific keying material; see [QUIC-TLS] for more details.  This",
            "   section considers passive and active attacks against protected",
            "   packets.",
            "",
            "   Both on-path and off-path attackers can mount a passive attack in",
            "   which they save observed packets for an offline attack against packet",
            "   protection at a future time; this is true for any observer of any",
            "   packet on any network.",
            "",
            "   An attacker that injects packets without being able to observe valid",
            "   packets for a connection is unlikely to be successful, since packet",
            "   protection ensures that valid packets are only generated by endpoints",
            "   that possess the key material established during the handshake; see",
            "   Sections 7 and 21.1.1.  Similarly, any active attacker that observes",
            "   packets and attempts to insert new data or modify existing data in",
            "   those packets should not be able to generate packets deemed valid by",
            "   the receiving endpoint, other than Initial packets.",
            "",
            "   A spoofing attack, in which an active attacker rewrites unprotected",
            "   parts of a packet that it forwards or injects, such as the source or",
            "   destination address, is only effective if the attacker can forward",
            "   packets to the original endpoint.  Packet protection ensures that the",
            "   packet payloads can only be processed by the endpoints that completed",
            "   the handshake, and invalid packets are ignored by those endpoints.",
            "",
            "   An attacker can also modify the boundaries between packets and UDP",
            "   datagrams, causing multiple packets to be coalesced into a single",
            "   datagram or splitting coalesced packets into multiple datagrams.",
            "   Aside from datagrams containing Initial packets, which require",
            "   padding, modification of how packets are arranged in datagrams has no",
            "   functional effect on a connection, although it might change some",
            "   performance characteristics."
          ],
          "title": "Protected Packets"
        },
        {
          "id": "section-21.1.3",
          "lines": [
            "   Connection migration (Section 9) provides endpoints with the ability",
            "   to transition between IP addresses and ports on multiple paths, using",
            "   one path at a time for transmission and receipt of non-probing",
            "   frames.  Path validation (Section 8.2) establishes that a peer is",
            "   both willing and able to receive packets sent on a particular path.",
            "   This helps reduce the effects of address spoofing by limiting the",
            "   number of packets sent to a spoofed address.",
            "",
            "   This section describes the intended security properties of connection",
            "   migration under various types of DoS attacks."
          ],
          "title": "Connection Migration"
        },
        {
          "id": "section-21.1.3.1",
          "lines": [
            "   An attacker that can cause a packet it observes to no longer reach",
            "   its intended destination is considered an on-path attacker.  When an",
            "   attacker is present between a client and server, endpoints are",
            "   required to send packets through the attacker to establish",
            "   connectivity on a given path.",
            "",
            "   An on-path attacker can:",
            "",
            "   *  Inspect packets",
            "",
            "   *  Modify IP and UDP packet headers",
            "",
            "   *  Inject new packets",
            "",
            "   *  Delay packets",
            "",
            "   *  Reorder packets",
            "",
            "   *  Drop packets",
            "",
            "   *  Split and merge datagrams along packet boundaries",
            "",
            "   An on-path attacker cannot:",
            "",
            "   *  Modify an authenticated portion of a packet and cause the",
            "      recipient to accept that packet",
            "",
            "   An on-path attacker has the opportunity to modify the packets that it",
            "   observes; however, any modifications to an authenticated portion of a",
            "   packet will cause it to be dropped by the receiving endpoint as",
            "   invalid, as packet payloads are both authenticated and encrypted.",
            "",
            "   QUIC aims to constrain the capabilities of an on-path attacker as",
            "   follows:",
            "",
            "   1.  An on-path attacker can prevent the use of a path for a",
            "       connection, causing the connection to fail if it cannot use a",
            "       different path that does not contain the attacker.  This can be",
            "       achieved by dropping all packets, modifying them so that they",
            "       fail to decrypt, or other methods.",
            "",
            "   2.  An on-path attacker can prevent migration to a new path for which",
            "       the attacker is also on-path by causing path validation to fail",
            "       on the new path.",
            "",
            "   3.  An on-path attacker cannot prevent a client from migrating to a",
            "       path for which the attacker is not on-path.",
            "",
            "   4.  An on-path attacker can reduce the throughput of a connection by",
            "       delaying packets or dropping them.",
            "",
            "   5.  An on-path attacker cannot cause an endpoint to accept a packet",
            "       for which it has modified an authenticated portion of that",
            "       packet."
          ],
          "title": "On-Path Active Attacks"
        },
        {
          "id": "section-21.1.3.2",
          "lines": [
            "   An off-path attacker is not directly on the path between a client and",
            "   server but could be able to obtain copies of some or all packets sent",
            "   between the client and the server.  It is also able to send copies of",
            "   those packets to either endpoint.",
            "",
            "   An off-path attacker can:",
            "",
            "   *  Inspect packets",
            "",
            "   *  Inject new packets",
            "",
            "   *  Reorder injected packets",
            "",
            "   An off-path attacker cannot:",
            "",
            "   *  Modify packets sent by endpoints",
            "",
            "   *  Delay packets",
            "",
            "   *  Drop packets",
            "",
            "   *  Reorder original packets",
            "",
            "   An off-path attacker can create modified copies of packets that it",
            "   has observed and inject those copies into the network, potentially",
            "   with spoofed source and destination addresses.",
            "",
            "   For the purposes of this discussion, it is assumed that an off-path",
            "   attacker has the ability to inject a modified copy of a packet into",
            "   the network that will reach the destination endpoint prior to the",
            "   arrival of the original packet observed by the attacker.  In other",
            "   words, an attacker has the ability to consistently \"win\" a race with",
            "   the legitimate packets between the endpoints, potentially causing the",
            "   original packet to be ignored by the recipient.",
            "",
            "   It is also assumed that an attacker has the resources necessary to",
            "   affect NAT state.  In particular, an attacker can cause an endpoint",
            "   to lose its NAT binding and then obtain the same port for use with",
            "   its own traffic.",
            "",
            "   QUIC aims to constrain the capabilities of an off-path attacker as",
            "   follows:",
            "",
            "   1.  An off-path attacker can race packets and attempt to become a",
            "       \"limited\" on-path attacker.",
            "",
            "   2.  An off-path attacker can cause path validation to succeed for",
            "       forwarded packets with the source address listed as the off-path",
            "       attacker as long as it can provide improved connectivity between",
            "       the client and the server.",
            "",
            "   3.  An off-path attacker cannot cause a connection to close once the",
            "       handshake has completed.",
            "",
            "   4.  An off-path attacker cannot cause migration to a new path to fail",
            "       if it cannot observe the new path.",
            "",
            "   5.  An off-path attacker can become a limited on-path attacker during",
            "       migration to a new path for which it is also an off-path",
            "       attacker.",
            "",
            "   6.  An off-path attacker can become a limited on-path attacker by",
            "       affecting shared NAT state such that it sends packets to the",
            "       server from the same IP address and port that the client",
            "       originally used."
          ],
          "title": "Off-Path Active Attacks"
        },
        {
          "id": "section-21.1.3.3",
          "lines": [
            "   A limited on-path attacker is an off-path attacker that has offered",
            "   improved routing of packets by duplicating and forwarding original",
            "   packets between the server and the client, causing those packets to",
            "   arrive before the original copies such that the original packets are",
            "   dropped by the destination endpoint.",
            "",
            "   A limited on-path attacker differs from an on-path attacker in that",
            "   it is not on the original path between endpoints, and therefore the",
            "   original packets sent by an endpoint are still reaching their",
            "   destination.  This means that a future failure to route copied",
            "   packets to the destination faster than their original path will not",
            "   prevent the original packets from reaching the destination.",
            "",
            "   A limited on-path attacker can:",
            "",
            "   *  Inspect packets",
            "",
            "   *  Inject new packets",
            "",
            "   *  Modify unencrypted packet headers",
            "",
            "   *  Reorder packets",
            "",
            "   A limited on-path attacker cannot:",
            "",
            "   *  Delay packets so that they arrive later than packets sent on the",
            "      original path",
            "",
            "   *  Drop packets",
            "",
            "   *  Modify the authenticated and encrypted portion of a packet and",
            "      cause the recipient to accept that packet",
            "",
            "   A limited on-path attacker can only delay packets up to the point",
            "   that the original packets arrive before the duplicate packets,",
            "   meaning that it cannot offer routing with worse latency than the",
            "   original path.  If a limited on-path attacker drops packets, the",
            "   original copy will still arrive at the destination endpoint.",
            "",
            "   QUIC aims to constrain the capabilities of a limited off-path",
            "   attacker as follows:",
            "",
            "   1.  A limited on-path attacker cannot cause a connection to close",
            "       once the handshake has completed.",
            "",
            "   2.  A limited on-path attacker cannot cause an idle connection to",
            "       close if the client is first to resume activity.",
            "",
            "   3.  A limited on-path attacker can cause an idle connection to be",
            "       deemed lost if the server is the first to resume activity.",
            "",
            "   Note that these guarantees are the same guarantees provided for any",
            "   NAT, for the same reasons."
          ],
          "title": "Limited On-Path Active Attacks"
        },
        {
          "id": "section-21.2",
          "lines": [
            "   As an encrypted and authenticated transport, QUIC provides a range of",
            "   protections against denial of service.  Once the cryptographic",
            "   handshake is complete, QUIC endpoints discard most packets that are",
            "   not authenticated, greatly limiting the ability of an attacker to",
            "   interfere with existing connections.",
            "",
            "   Once a connection is established, QUIC endpoints might accept some",
            "   unauthenticated ICMP packets (see Section 14.2.1), but the use of",
            "   these packets is extremely limited.  The only other type of packet",
            "   that an endpoint might accept is a stateless reset (Section 10.3),",
            "   which relies on the token being kept secret until it is used.",
            "",
            "   During the creation of a connection, QUIC only provides protection",
            "   against attacks from off the network path.  All QUIC packets contain",
            "   proof that the recipient saw a preceding packet from its peer.",
            "",
            "   Addresses cannot change during the handshake, so endpoints can",
            "   discard packets that are received on a different network path.",
            "",
            "   The Source and Destination Connection ID fields are the primary means",
            "   of protection against an off-path attack during the handshake; see",
            "   Section 8.1.  These are required to match those set by a peer.",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "9f89616d6c43513a",
                  "490de747181773fa",
                  "9cf59dbb6be870c5"
                ],
                "status_id": 1,
                "text": "Except for Initial and Stateless Resets, an endpoint only accepts"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "9f89616d6c43513a",
                  "490de747181773fa",
                  "9cf59dbb6be870c5"
                ],
                "status_id": 1,
                "text": "packets that include a Destination Connection ID field that matches a"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "9f89616d6c43513a",
                  "490de747181773fa",
                  "9cf59dbb6be870c5"
                ],
                "status_id": 1,
                "text": "value the endpoint previously chose."
              },
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "  This is the only protection"
              }
            ],
            "   offered for Version Negotiation packets.",
            "",
            "   The Destination Connection ID field in an Initial packet is selected",
            "   by a client to be unpredictable, which serves an additional purpose.",
            "   The packets that carry the cryptographic handshake are protected with",
            "   a key that is derived from this connection ID and a salt specific to",
            "   the QUIC version.  This allows endpoints to use the same process for",
            "   authenticating packets that they receive as they use after the",
            "   cryptographic handshake completes.  Packets that cannot be",
            "   authenticated are discarded.  Protecting packets in this fashion",
            "   provides a strong assurance that the sender of the packet saw the",
            "   Initial packet and understood it.",
            "",
            "   These protections are not intended to be effective against an",
            "   attacker that is able to receive QUIC packets prior to the connection",
            "   being established.  Such an attacker can potentially send packets",
            "   that will be accepted by QUIC endpoints.  This version of QUIC",
            "   attempts to detect this sort of attack, but it expects that endpoints",
            "   will fail to establish a connection rather than recovering.  For the",
            "   most part, the cryptographic handshake protocol [QUIC-TLS] is",
            "   responsible for detecting tampering during the handshake.",
            "",
            "   Endpoints are permitted to use other methods to detect and attempt to",
            "   recover from interference with the handshake.  Invalid packets can be",
            "   identified and discarded using other methods, but no specific method",
            "   is mandated in this document."
          ],
          "title": "Handshake Denial of Service"
        },
        {
          "id": "section-21.3",
          "lines": [
            "   An attacker might be able to receive an address validation token",
            "   (Section 8) from a server and then release the IP address it used to",
            "   acquire that token.  At a later time, the attacker can initiate a",
            "   0-RTT connection with a server by spoofing this same address, which",
            "   might now address a different (victim) endpoint.  The attacker can",
            "   thus potentially cause the server to send an initial congestion",
            "   window's worth of data towards the victim.",
            "",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "6a5b1fa270b71e0d",
                  "e276faca6a6d3b89",
                  "b31944c393726521"
                ],
                "status_id": 8,
                "text": "Servers SHOULD provide mitigations for this attack by limiting the"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "6a5b1fa270b71e0d",
                  "e276faca6a6d3b89",
                  "b31944c393726521"
                ],
                "status_id": 8,
                "text": "usage and lifetime of address validation tokens; see Section 8.1.3."
              }
            ]
          ],
          "requirements": [
            "b31944c393726521",
            "b31944c393726521"
          ],
          "title": "Amplification Attack"
        },
        {
          "id": "section-21.4",
          "lines": [
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "8e2799c27d515cec",
                  "be3a6794015ec967",
                  "5393047672012cba"
                ],
                "status_id": 1,
                "text": "An endpoint that acknowledges packets it has not received might cause"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "8e2799c27d515cec",
                  "be3a6794015ec967",
                  "5393047672012cba"
                ],
                "status_id": 1,
                "text": "a congestion controller to permit sending at rates beyond what the"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "8e2799c27d515cec",
                  "be3a6794015ec967",
                  "5393047672012cba"
                ],
                "status_id": 1,
                "text": "network supports.  "
              },
              {
                "annotation_ids": [
                  "8e2799c27d515cec",
                  "be3a6794015ec967",
                  "5393047672012cba",
                  "bead5d8d4d74d692"
                ],
                "status_id": 21,
                "text": "An endpoint MAY skip packet numbers when sending"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "8e2799c27d515cec",
                  "be3a6794015ec967",
                  "5393047672012cba",
                  "bead5d8d4d74d692"
                ],
                "status_id": 21,
                "text": "packets to detect this behavior."
              },
              {
                "annotation_ids": [
                  "be3a6794015ec967",
                  "5393047672012cba"
                ],
                "status_id": 1,
                "text": "  An endpoint can then immediately"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "be3a6794015ec967",
                  "5393047672012cba"
                ],
                "status_id": 1,
                "text": "close the connection with a connection error of type"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "be3a6794015ec967",
                  "5393047672012cba"
                ],
                "status_id": 1,
                "text": "PROTOCOL_VIOLATION"
              },
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "; see Section 10.2."
              }
            ]
          ],
          "requirements": [
            "bead5d8d4d74d692",
            "bead5d8d4d74d692"
          ],
          "title": "Optimistic ACK Attack"
        },
        {
          "id": "section-21.5",
          "lines": [
            "   A request forgery attack occurs where an endpoint causes its peer to",
            "   issue a request towards a victim, with the request controlled by the",
            "   endpoint.  Request forgery attacks aim to provide an attacker with",
            "   access to capabilities of its peer that might otherwise be",
            "   unavailable to the attacker.  For a networking protocol, a request",
            "   forgery attack is often used to exploit any implicit authorization",
            "   conferred on the peer by the victim due to the peer's location in the",
            "   network.",
            "",
            "   For request forgery to be effective, an attacker needs to be able to",
            "   influence what packets the peer sends and where these packets are",
            "   sent.  If an attacker can target a vulnerable service with a",
            "   controlled payload, that service might perform actions that are",
            "   attributed to the attacker's peer but are decided by the attacker.",
            "",
            "   For example, cross-site request forgery [CSRF] exploits on the Web",
            "   cause a client to issue requests that include authorization cookies",
            "   [COOKIE], allowing one site access to information and actions that",
            "   are intended to be restricted to a different site.",
            "",
            "   As QUIC runs over UDP, the primary attack modality of concern is one",
            "   where an attacker can select the address to which its peer sends UDP",
            "   datagrams and can control some of the unprotected content of those",
            "   packets.  As much of the data sent by QUIC endpoints is protected,",
            "   this includes control over ciphertext.  An attack is successful if an",
            "   attacker can cause a peer to send a UDP datagram to a host that will",
            "   perform some action based on content in the datagram.",
            "",
            "   This section discusses ways in which QUIC might be used for request",
            "   forgery attacks.",
            "",
            "   This section also describes limited countermeasures that can be",
            "   implemented by QUIC endpoints.  These mitigations can be employed",
            "   unilaterally by a QUIC implementation or deployment, without",
            "   potential targets for request forgery attacks taking action.",
            "   However, these countermeasures could be insufficient if UDP-based",
            "   services do not properly authorize requests.",
            "",
            "   Because the migration attack described in Section 21.5.4 is quite",
            "   powerful and does not have adequate countermeasures, QUIC server",
            "   implementations should assume that attackers can cause them to",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   generate arbitrary UDP payloads to arbitrary destinations.  "
              },
              {
                "annotation_ids": [
                  "f990ac5c67f836a7"
                ],
                "status_id": 14,
                "text": "QUIC"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "f990ac5c67f836a7"
                ],
                "status_id": 14,
                "text": "servers SHOULD NOT be deployed in networks that do not deploy ingress"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "f990ac5c67f836a7"
                ],
                "status_id": 14,
                "text": "filtering [BCP38] and also have inadequately secured UDP endpoints."
              }
            ],
            "",
            "   Although it is not generally possible to ensure that clients are not",
            "   co-located with vulnerable endpoints, this version of QUIC does not",
            "   allow servers to migrate, thus preventing spoofed migration attacks",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   on clients.  "
              },
              {
                "annotation_ids": [
                  "8780b6d6e501df3c"
                ],
                "status_id": 20,
                "text": "Any future extension that allows server migration MUST"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "8780b6d6e501df3c"
                ],
                "status_id": 20,
                "text": "also define countermeasures for forgery attacks."
              }
            ]
          ],
          "requirements": [
            "f990ac5c67f836a7",
            "f990ac5c67f836a7",
            "f990ac5c67f836a7",
            "8780b6d6e501df3c",
            "8780b6d6e501df3c"
          ],
          "title": "Request Forgery Attacks"
        },
        {
          "id": "section-21.5.1",
          "lines": [
            "   QUIC offers some opportunities for an attacker to influence or",
            "   control where its peer sends UDP datagrams:",
            "",
            "   *  initial connection establishment (Section 7), where a server is",
            "      able to choose where a client sends datagrams -- for example, by",
            "      populating DNS records;",
            "",
            "   *  preferred addresses (Section 9.6), where a server is able to",
            "      choose where a client sends datagrams;",
            "",
            "   *  spoofed connection migrations (Section 9.3.1), where a client is",
            "      able to use source address spoofing to select where a server sends",
            "      subsequent datagrams; and",
            "",
            "   *  spoofed packets that cause a server to send a Version Negotiation",
            "      packet (Section 21.5.5).",
            "",
            "   In all cases, the attacker can cause its peer to send datagrams to a",
            "   victim that might not understand QUIC.  That is, these packets are",
            "   sent by the peer prior to address validation; see Section 8.",
            "",
            "   Outside of the encrypted portion of packets, QUIC offers an endpoint",
            "   several options for controlling the content of UDP datagrams that its",
            "   peer sends.  The Destination Connection ID field offers direct",
            "   control over bytes that appear early in packets sent by the peer; see",
            "   Section 5.1.  The Token field in Initial packets offers a server",
            "   control over other bytes of Initial packets; see Section 17.2.2.",
            "",
            "   There are no measures in this version of QUIC to prevent indirect",
            "   control over the encrypted portions of packets.  It is necessary to",
            "   assume that endpoints are able to control the contents of frames that",
            "   a peer sends, especially those frames that convey application data,",
            "   such as STREAM frames.  Though this depends to some degree on details",
            "   of the application protocol, some control is possible in many",
            "   protocol usage contexts.  As the attacker has access to packet",
            "   protection keys, they are likely to be capable of predicting how a",
            "   peer will encrypt future packets.  Successful control over datagram",
            "   content then only requires that the attacker be able to predict the",
            "   packet number and placement of frames in packets with some amount of",
            "   reliability.",
            "",
            "   This section assumes that limiting control over datagram content is",
            "   not feasible.  The focus of the mitigations in subsequent sections is",
            "   on limiting the ways in which datagrams that are sent prior to",
            "   address validation can be used for request forgery."
          ],
          "title": "Control Options for Endpoints"
        },
        {
          "id": "section-21.5.2",
          "lines": [
            "   An attacker acting as a server can choose the IP address and port on",
            "   which it advertises its availability, so Initial packets from clients",
            "   are assumed to be available for use in this sort of attack.  The",
            "   address validation implicit in the handshake ensures that -- for a",
            "   new connection -- a client will not send other types of packets to a",
            "   destination that does not understand QUIC or is not willing to accept",
            "   a QUIC connection.",
            "",
            "   Initial packet protection (Section 5.2 of [QUIC-TLS]) makes it",
            "   difficult for servers to control the content of Initial packets sent",
            "   by clients.  A client choosing an unpredictable Destination",
            "   Connection ID ensures that servers are unable to control any of the",
            "   encrypted portion of Initial packets from clients.",
            "",
            "   However, the Token field is open to server control and does allow a",
            "   server to use clients to mount request forgery attacks.  The use of",
            "   tokens provided with the NEW_TOKEN frame (Section 8.1.3) offers the",
            "   only option for request forgery during connection establishment.",
            "",
            "   Clients, however, are not obligated to use the NEW_TOKEN frame.",
            "   Request forgery attacks that rely on the Token field can be avoided",
            "   if clients send an empty Token field when the server address has",
            "   changed from when the NEW_TOKEN frame was received.",
            "",
            "   Clients could avoid using NEW_TOKEN if the server address changes.",
            "   However, not including a Token field could adversely affect",
            "   performance.  Servers could rely on NEW_TOKEN to enable the sending",
            "   of data in excess of the three-times limit on sending data; see",
            "   Section 8.1.  In particular, this affects cases where clients use",
            "   0-RTT to request data from servers.",
            "",
            "   Sending a Retry packet (Section 17.2.5) offers a server the option to",
            "   change the Token field.  After sending a Retry, the server can also",
            "   control the Destination Connection ID field of subsequent Initial",
            "   packets from the client.  This also might allow indirect control over",
            "   the encrypted content of Initial packets.  However, the exchange of a",
            "   Retry packet validates the server's address, thereby preventing the",
            "   use of subsequent Initial packets for request forgery."
          ],
          "title": "Request Forgery with Client Initial Packets"
        },
        {
          "id": "section-21.5.3",
          "lines": [
            "   Servers can specify a preferred address, which clients then migrate",
            "   to after confirming the handshake; see Section 9.6.  The Destination",
            "   Connection ID field of packets that the client sends to a preferred",
            "   address can be used for request forgery.",
            "",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "04508122535bcaf1"
                ],
                "status_id": 20,
                "text": "A client MUST NOT send non-probing frames to a preferred address"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "04508122535bcaf1"
                ],
                "status_id": 20,
                "text": "prior to validating that address; see Section 8."
              },
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "  This greatly"
              }
            ],
            "   reduces the options that a server has to control the encrypted",
            "   portion of datagrams.",
            "",
            "   This document does not offer any additional countermeasures that are",
            "   specific to the use of preferred addresses and can be implemented by",
            "   endpoints.  The generic measures described in Section 21.5.6 could be",
            "   used as further mitigation."
          ],
          "requirements": [
            "04508122535bcaf1",
            "04508122535bcaf1"
          ],
          "title": "Request Forgery with Preferred Addresses"
        },
        {
          "id": "section-21.5.4",
          "lines": [
            "   Clients are able to present a spoofed source address as part of an",
            "   apparent connection migration to cause a server to send datagrams to",
            "   that address.",
            "",
            "   The Destination Connection ID field in any packets that a server",
            "   subsequently sends to this spoofed address can be used for request",
            "   forgery.  A client might also be able to influence the ciphertext.",
            "",
            "   A server that only sends probing packets (Section 9.1) to an address",
            "   prior to address validation provides an attacker with only limited",
            "   control over the encrypted portion of datagrams.  However,",
            "   particularly for NAT rebinding, this can adversely affect",
            "   performance.  If the server sends frames carrying application data,",
            "   an attacker might be able to control most of the content of",
            "   datagrams.",
            "",
            "   This document does not offer specific countermeasures that can be",
            "   implemented by endpoints, aside from the generic measures described",
            "   in Section 21.5.6.  However, countermeasures for address spoofing at",
            "   the network level -- in particular, ingress filtering [BCP38] -- are",
            "   especially effective against attacks that use spoofing and originate",
            "   from an external network."
          ],
          "title": "Request Forgery with Spoofed Migration"
        },
        {
          "id": "section-21.5.5",
          "lines": [
            "   Clients that are able to present a spoofed source address on a packet",
            "   can cause a server to send a Version Negotiation packet",
            "   (Section 17.2.1) to that address.",
            "",
            "   The absence of size restrictions on the connection ID fields for",
            "   packets of an unknown version increases the amount of data that the",
            "   client controls from the resulting datagram.  The first byte of this",
            "   packet is not under client control and the next four bytes are zero,",
            "   but the client is able to control up to 512 bytes starting from the",
            "   fifth byte.",
            "",
            "   No specific countermeasures are provided for this attack, though",
            "   generic protections (Section 21.5.6) could apply.  In this case,",
            "   ingress filtering [BCP38] is also effective."
          ],
          "title": "Request Forgery with Version Negotiation"
        },
        {
          "id": "section-21.5.6",
          "lines": [
            "   The most effective defense against request forgery attacks is to",
            "   modify vulnerable services to use strong authentication.  However,",
            "   this is not always something that is within the control of a QUIC",
            "   deployment.  This section outlines some other steps that QUIC",
            "   endpoints could take unilaterally.  These additional steps are all",
            "   discretionary because, depending on circumstances, they could",
            "   interfere with or prevent legitimate uses.",
            "",
            "   Services offered over loopback interfaces often lack proper",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   authentication.  "
              },
              {
                "annotation_ids": [
                  "894598ea0371342a",
                  "ed3820c5af6eb45a"
                ],
                "status_id": 21,
                "text": "Endpoints MAY prevent connection attempts or"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "894598ea0371342a",
                  "ed3820c5af6eb45a"
                ],
                "status_id": 21,
                "text": "migration to a loopback address."
              },
              {
                "annotation_ids": [
                  "894598ea0371342a"
                ],
                "status_id": 1,
                "text": "  "
              },
              {
                "annotation_ids": [
                  "894598ea0371342a",
                  "ee0e69f5e78af374"
                ],
                "status_id": 22,
                "text": "Endpoints SHOULD NOT allow"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "894598ea0371342a",
                  "ee0e69f5e78af374"
                ],
                "status_id": 22,
                "text": "connections or migration to a loopback address if the same service"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "894598ea0371342a",
                  "ee0e69f5e78af374"
                ],
                "status_id": 22,
                "text": "was previously available at a different interface or if the address"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "894598ea0371342a",
                  "ee0e69f5e78af374"
                ],
                "status_id": 22,
                "text": "was provided by a service at a non-loopback address."
              },
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "  Endpoints that"
              }
            ],
            "   depend on these capabilities could offer an option to disable these",
            "   protections.",
            "",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "cf2277569d4b82ce",
                  "5a509bbccfcf3a6c"
                ],
                "status_id": 1,
                "text": "Similarly, endpoints could regard a change in address to a link-local"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "cf2277569d4b82ce",
                  "5a509bbccfcf3a6c"
                ],
                "status_id": 1,
                "text": "address [RFC4291] or an address in a private-use range [RFC1918] from"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "cf2277569d4b82ce",
                  "5a509bbccfcf3a6c"
                ],
                "status_id": 1,
                "text": "a global, unique-local [RFC4193], or non-private address as a"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "cf2277569d4b82ce",
                  "5a509bbccfcf3a6c"
                ],
                "status_id": 1,
                "text": "potential attempt at request forgery."
              },
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "  Endpoints could refuse to use"
              }
            ],
            "   these addresses entirely, but that carries a significant risk of",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   interfering with legitimate uses.  "
              },
              {
                "annotation_ids": [
                  "89192a54330ac791"
                ],
                "status_id": 14,
                "text": "Endpoints SHOULD NOT refuse to use"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "89192a54330ac791"
                ],
                "status_id": 14,
                "text": "an address unless they have specific knowledge about the network"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "89192a54330ac791"
                ],
                "status_id": 14,
                "text": "indicating that sending datagrams to unvalidated addresses in a given"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "89192a54330ac791"
                ],
                "status_id": 14,
                "text": "range is not safe."
              }
            ],
            "",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "31fbf47356b6614f"
                ],
                "status_id": 19,
                "text": "Endpoints MAY choose to reduce the risk of request forgery by not"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "31fbf47356b6614f"
                ],
                "status_id": 19,
                "text": "including values from NEW_TOKEN frames in Initial packets or by only"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "31fbf47356b6614f"
                ],
                "status_id": 19,
                "text": "sending probing frames in packets prior to completing address"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "31fbf47356b6614f"
                ],
                "status_id": 19,
                "text": "validation."
              },
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "  Note that this does not prevent an attacker from using"
              }
            ],
            "   the Destination Connection ID field for an attack.",
            "",
            "   Endpoints are not expected to have specific information about the",
            "   location of servers that could be vulnerable targets of a request",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   forgery attack.  However, "
              },
              {
                "annotation_ids": [
                  "f62464c6ff930e0c"
                ],
                "status_id": 1,
                "text": "it might be possible over time to identify"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "f62464c6ff930e0c"
                ],
                "status_id": 1,
                "text": "specific UDP ports that are common targets of attacks or particular"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "f62464c6ff930e0c"
                ],
                "status_id": 1,
                "text": "patterns in datagrams that are used for attacks.  "
              },
              {
                "annotation_ids": [
                  "f62464c6ff930e0c",
                  "103ace4872ab593d"
                ],
                "status_id": 21,
                "text": "Endpoints MAY"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "f62464c6ff930e0c",
                  "103ace4872ab593d"
                ],
                "status_id": 21,
                "text": "choose to avoid sending datagrams to these ports or not send"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "f62464c6ff930e0c",
                  "103ace4872ab593d"
                ],
                "status_id": 21,
                "text": "datagrams that match these patterns prior to validating the"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "f62464c6ff930e0c",
                  "103ace4872ab593d"
                ],
                "status_id": 21,
                "text": "destination address."
              },
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "  "
              },
              {
                "annotation_ids": [
                  "da1e4cb13727028f"
                ],
                "status_id": 19,
                "text": "Endpoints MAY retire connection IDs containing"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "da1e4cb13727028f"
                ],
                "status_id": 19,
                "text": "patterns known to be problematic without using them."
              }
            ],
            "",
            "      |  Note: Modifying endpoints to apply these protections is more",
            "      |  efficient than deploying network-based protections, as",
            "      |  endpoints do not need to perform any additional processing when",
            "      |  sending to an address that has been validated."
          ],
          "requirements": [
            "ed3820c5af6eb45a",
            "ed3820c5af6eb45a",
            "ee0e69f5e78af374",
            "ee0e69f5e78af374",
            "ee0e69f5e78af374",
            "ee0e69f5e78af374",
            "89192a54330ac791",
            "89192a54330ac791",
            "89192a54330ac791",
            "89192a54330ac791",
            "31fbf47356b6614f",
            "31fbf47356b6614f",
            "31fbf47356b6614f",
            "31fbf47356b6614f",
            "103ace4872ab593d",
            "103ace4872ab593d",
            "103ace4872ab593d",
            "103ace4872ab593d",
            "da1e4cb13727028f",
            "da1e4cb13727028f"
          ],
          "title": "Generic Request Forgery Countermeasures"
        },
        {
          "id": "section-21.6",
          "lines": [
            "   The attacks commonly known as Slowloris [SLOWLORIS] try to keep many",
            "   connections to the target endpoint open and hold them open as long as",
            "   possible.  These attacks can be executed against a QUIC endpoint by",
            "   generating the minimum amount of activity necessary to avoid being",
            "   closed for inactivity.  This might involve sending small amounts of",
            "   data, gradually opening flow control windows in order to control the",
            "   sender rate, or manufacturing ACK frames that simulate a high loss",
            "   rate.",
            "",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "133c69789d5e024d",
                  "7589d399cacdef66"
                ],
                "status_id": 22,
                "text": "QUIC deployments SHOULD provide mitigations for the Slowloris"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "133c69789d5e024d",
                  "7589d399cacdef66"
                ],
                "status_id": 22,
                "text": "attacks, such as increasing the maximum number of clients the server"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "133c69789d5e024d",
                  "7589d399cacdef66"
                ],
                "status_id": 22,
                "text": "will allow, limiting the number of connections a single IP address is"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "133c69789d5e024d",
                  "7589d399cacdef66"
                ],
                "status_id": 22,
                "text": "allowed to make, imposing restrictions on the minimum transfer speed"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "133c69789d5e024d",
                  "7589d399cacdef66"
                ],
                "status_id": 22,
                "text": "a connection is allowed to have, and restricting the length of time"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "133c69789d5e024d",
                  "7589d399cacdef66"
                ],
                "status_id": 22,
                "text": "an endpoint is allowed to stay connected."
              }
            ]
          ],
          "requirements": [
            "7589d399cacdef66",
            "7589d399cacdef66",
            "7589d399cacdef66",
            "7589d399cacdef66",
            "7589d399cacdef66",
            "7589d399cacdef66"
          ],
          "title": "Slowloris Attacks"
        },
        {
          "id": "section-21.7",
          "lines": [
            "   An adversarial sender might intentionally not send portions of the",
            "   stream data, causing the receiver to commit resources for the unsent",
            "   data.  This could cause a disproportionate receive buffer memory",
            "   commitment and/or the creation of a large and inefficient data",
            "   structure at the receiver.",
            "",
            "   An adversarial receiver might intentionally not acknowledge packets",
            "   containing stream data in an attempt to force the sender to store the",
            "   unacknowledged stream data for retransmission.",
            "",
            "   The attack on receivers is mitigated if flow control windows",
            "   correspond to available memory.  However, some receivers will",
            "   overcommit memory and advertise flow control offsets in the aggregate",
            "   that exceed actual available memory.  The overcommitment strategy can",
            "   lead to better performance when endpoints are well behaved, but",
            "   renders endpoints vulnerable to the stream fragmentation attack.",
            "",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "bd2260a8f7d68d16"
                ],
                "status_id": 14,
                "text": "QUIC deployments SHOULD provide mitigations for stream fragmentation"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "bd2260a8f7d68d16"
                ],
                "status_id": 14,
                "text": "attacks."
              },
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "  Mitigations could consist of avoiding overcommitting"
              }
            ],
            "   memory, limiting the size of tracking data structures, delaying",
            "   reassembly of STREAM frames, implementing heuristics based on the age",
            "   and duration of reassembly holes, or some combination of these."
          ],
          "requirements": [
            "bd2260a8f7d68d16",
            "bd2260a8f7d68d16"
          ],
          "title": "Stream Fragmentation and Reassembly Attacks"
        },
        {
          "id": "section-21.8",
          "lines": [
            "   An adversarial endpoint can open a large number of streams,",
            "   exhausting state on an endpoint.  The adversarial endpoint could",
            "   repeat the process on a large number of connections, in a manner",
            "   similar to SYN flooding attacks in TCP.",
            "",
            "   Normally, clients will open streams sequentially, as explained in",
            "   Section 2.1.  However, when several streams are initiated at short",
            "   intervals, loss or reordering can cause STREAM frames that open",
            "   streams to be received out of sequence.  On receiving a higher-",
            "   numbered stream ID, a receiver is required to open all intervening",
            "   streams of the same type; see Section 3.2.  Thus, on a new",
            "   connection, opening stream 4000000 opens 1 million and 1 client-",
            "   initiated bidirectional streams.",
            "",
            "   The number of active streams is limited by the",
            "   initial_max_streams_bidi and initial_max_streams_uni transport",
            "   parameters as updated by any received MAX_STREAMS frames, as",
            "   explained in Section 4.6.  If chosen judiciously, these limits",
            "   mitigate the effect of the stream commitment attack.  However,",
            "   setting the limit too low could affect performance when applications",
            "   expect to open a large number of streams."
          ],
          "title": "Stream Commitment Attack"
        },
        {
          "id": "section-21.9",
          "lines": [
            "   QUIC and TLS both contain frames or messages that have legitimate",
            "   uses in some contexts, but these frames or messages can be abused to",
            "   cause a peer to expend processing resources without having any",
            "   observable impact on the state of the connection.",
            "",
            "   Messages can also be used to change and revert state in small or",
            "   inconsequential ways, such as by sending small increments to flow",
            "   control limits.",
            "",
            "   If processing costs are disproportionately large in comparison to",
            "   bandwidth consumption or effect on state, then this could allow a",
            "   malicious peer to exhaust processing capacity.",
            "",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "98a152466fb0d029",
                  "a3ab765581b8aca4"
                ],
                "status_id": 22,
                "text": "While there are legitimate uses for all messages, implementations"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "98a152466fb0d029",
                  "a3ab765581b8aca4"
                ],
                "status_id": 22,
                "text": "SHOULD track cost of processing relative to progress and treat"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "98a152466fb0d029",
                  "a3ab765581b8aca4"
                ],
                "status_id": 22,
                "text": "excessive quantities of any non-productive packets as indicative of"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "98a152466fb0d029",
                  "a3ab765581b8aca4"
                ],
                "status_id": 22,
                "text": "an attack."
              },
              {
                "annotation_ids": [
                  "98a152466fb0d029"
                ],
                "status_id": 1,
                "text": "  "
              },
              {
                "annotation_ids": [
                  "98a152466fb0d029",
                  "b924522dbd9b7178"
                ],
                "status_id": 21,
                "text": "Endpoints MAY respond to this condition with a connection"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "98a152466fb0d029",
                  "b924522dbd9b7178"
                ],
                "status_id": 21,
                "text": "error or by dropping packets."
              }
            ]
          ],
          "requirements": [
            "a3ab765581b8aca4",
            "a3ab765581b8aca4",
            "a3ab765581b8aca4",
            "a3ab765581b8aca4",
            "b924522dbd9b7178",
            "b924522dbd9b7178"
          ],
          "title": "Peer Denial of Service"
        },
        {
          "id": "section-21.10",
          "lines": [
            "   An on-path attacker could manipulate the value of ECN fields in the",
            "   IP header to influence the sender's rate.  [RFC3168] discusses",
            "   manipulations and their effects in more detail.",
            "",
            "   A limited on-path attacker can duplicate and send packets with",
            "   modified ECN fields to affect the sender's rate.  If duplicate",
            "   packets are discarded by a receiver, an attacker will need to race",
            "   the duplicate packet against the original to be successful in this",
            "   attack.  Therefore, QUIC endpoints ignore the ECN field in an IP",
            "   packet unless at least one QUIC packet in that IP packet is",
            "   successfully processed; see Section 13.4."
          ],
          "title": "Explicit Congestion Notification Attacks"
        },
        {
          "id": "section-21.11",
          "lines": [
            "   Stateless resets create a possible denial-of-service attack analogous",
            "   to a TCP reset injection.  This attack is possible if an attacker is",
            "   able to cause a stateless reset token to be generated for a",
            "   connection with a selected connection ID.  An attacker that can cause",
            "   this token to be generated can reset an active connection with the",
            "   same connection ID.",
            "",
            "   If a packet can be routed to different instances that share a static",
            "   key -- for example, by changing an IP address or port -- then an",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   attacker can cause the server to send a stateless reset.  "
              },
              {
                "annotation_ids": [
                  "29029dd7158cc9d3"
                ],
                "status_id": 20,
                "text": "To defend"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "29029dd7158cc9d3"
                ],
                "status_id": 20,
                "text": "against this style of denial of service, endpoints that share a"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "29029dd7158cc9d3"
                ],
                "status_id": 20,
                "text": "static key for stateless resets (see Section 10.3.2) MUST be arranged"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "29029dd7158cc9d3"
                ],
                "status_id": 20,
                "text": "so that packets with a given connection ID always arrive at an"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "29029dd7158cc9d3"
                ],
                "status_id": 20,
                "text": "instance that has connection state, unless that connection is no"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "29029dd7158cc9d3"
                ],
                "status_id": 20,
                "text": "longer active."
              }
            ],
            "",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "525437d8c697fc6d"
                ],
                "status_id": 20,
                "text": "More generally, servers MUST NOT generate a stateless reset if a"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "525437d8c697fc6d"
                ],
                "status_id": 20,
                "text": "connection with the corresponding connection ID could be active on"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "525437d8c697fc6d"
                ],
                "status_id": 20,
                "text": "any endpoint using the same static key."
              }
            ],
            "",
            "   In the case of a cluster that uses dynamic load balancing, it is",
            "   possible that a change in load-balancer configuration could occur",
            "   while an active instance retains connection state.  Even if an",
            "   instance retains connection state, the change in routing and",
            "   resulting stateless reset will result in the connection being",
            "   terminated.  If there is no chance of the packet being routed to the",
            "   correct instance, it is better to send a stateless reset than wait",
            "   for the connection to time out.  However, this is acceptable only if",
            "   the routing cannot be influenced by an attacker."
          ],
          "requirements": [
            "29029dd7158cc9d3",
            "29029dd7158cc9d3",
            "29029dd7158cc9d3",
            "29029dd7158cc9d3",
            "29029dd7158cc9d3",
            "29029dd7158cc9d3",
            "525437d8c697fc6d",
            "525437d8c697fc6d",
            "525437d8c697fc6d"
          ],
          "title": "Stateless Reset Oracle"
        },
        {
          "id": "section-21.12",
          "lines": [
            "   This document defines QUIC Version Negotiation packets (Section 6),",
            "   which can be used to negotiate the QUIC version used between two",
            "   endpoints.  However, this document does not specify how this",
            "   negotiation will be performed between this version and subsequent",
            "   future versions.  In particular, Version Negotiation packets do not",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   contain any mechanism to prevent version downgrade attacks.  "
              },
              {
                "annotation_ids": [
                  "9931f61b1565ceef"
                ],
                "status_id": 20,
                "text": "Future"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "9931f61b1565ceef"
                ],
                "status_id": 20,
                "text": "versions of QUIC that use Version Negotiation packets MUST define a"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "9931f61b1565ceef"
                ],
                "status_id": 20,
                "text": "mechanism that is robust against version downgrade attacks."
              }
            ]
          ],
          "requirements": [
            "9931f61b1565ceef",
            "9931f61b1565ceef",
            "9931f61b1565ceef"
          ],
          "title": "Version Downgrade"
        },
        {
          "id": "section-21.13",
          "lines": [
            "   Deployments should limit the ability of an attacker to target a new",
            "   connection to a particular server instance.  Ideally, routing",
            "   decisions are made independently of client-selected values, including",
            "   addresses.  Once an instance is selected, a connection ID can be",
            "   selected so that later packets are routed to the same instance."
          ],
          "title": "Targeted Attacks by Routing"
        },
        {
          "id": "section-21.14",
          "lines": [
            "   The length of QUIC packets can reveal information about the length of",
            "   the content of those packets.  The PADDING frame is provided so that",
            "   endpoints have some ability to obscure the length of packet content;",
            "   see Section 19.1.",
            "",
            "   Defeating traffic analysis is challenging and the subject of active",
            "   research.  Length is not the only way that information might leak.",
            "   Endpoints might also reveal sensitive information through other side",
            "   channels, such as the timing of packets."
          ],
          "title": "Traffic Analysis"
        },
        {
          "id": "section-22",
          "lines": [
            "   This document establishes several registries for the management of",
            "   codepoints in QUIC.  These registries operate on a common set of",
            "   policies as defined in Section 22.1."
          ],
          "title": "IANA Considerations"
        },
        {
          "id": "section-22.1",
          "lines": [
            "   All QUIC registries allow for both provisional and permanent",
            "   registration of codepoints.  This section documents policies that are",
            "   common to these registries."
          ],
          "title": "Registration Policies for QUIC Registries"
        },
        {
          "id": "section-22.1.1",
          "lines": [
            "   Provisional registrations of codepoints are intended to allow for",
            "   private use and experimentation with extensions to QUIC.  Provisional",
            "   registrations only require the inclusion of the codepoint value and",
            "   contact information.  However, provisional registrations could be",
            "   reclaimed and reassigned for another purpose.",
            "",
            "   Provisional registrations require Expert Review, as defined in",
            "   Section 4.5 of [RFC8126].  The designated expert or experts are",
            "   advised that only registrations for an excessive proportion of",
            "   remaining codepoint space or the very first unassigned value (see",
            "   Section 22.1.2) can be rejected.",
            "",
            "   Provisional registrations will include a Date field that indicates",
            "   when the registration was last updated.  A request to update the date",
            "   on any provisional registration can be made without review from the",
            "   designated expert(s).",
            "",
            "   All QUIC registries include the following fields to support",
            "   provisional registration:",
            "",
            "   Value:  The assigned codepoint.",
            "   Status:  \"permanent\" or \"provisional\".",
            "   Specification:  A reference to a publicly available specification for",
            "      the value.",
            "   Date:  The date of the last update to the registration.",
            "   Change Controller:  The entity that is responsible for the definition",
            "      of the registration.",
            "   Contact:  Contact details for the registrant.",
            "   Notes:  Supplementary notes about the registration.",
            "",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "9d49661b577b0eb3"
                ],
                "status_id": 19,
                "text": "Provisional registrations MAY omit the Specification and Notes"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "9d49661b577b0eb3"
                ],
                "status_id": 19,
                "text": "fields, plus any additional fields that might be required for a"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "9d49661b577b0eb3"
                ],
                "status_id": 19,
                "text": "permanent registration."
              },
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "  The Date field is not required as part of"
              }
            ],
            "   requesting a registration, as it is set to the date the registration",
            "   is created or updated."
          ],
          "requirements": [
            "9d49661b577b0eb3",
            "9d49661b577b0eb3",
            "9d49661b577b0eb3"
          ],
          "title": "Provisional Registrations"
        },
        {
          "id": "section-22.1.2",
          "lines": [
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "ada749584fbd42d8"
                ],
                "status_id": 14,
                "text": "New requests for codepoints from QUIC registries SHOULD use a"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "ada749584fbd42d8"
                ],
                "status_id": 14,
                "text": "randomly selected codepoint that excludes both existing allocations"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "ada749584fbd42d8"
                ],
                "status_id": 14,
                "text": "and the first unallocated codepoint in the selected space."
              },
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "  "
              },
              {
                "annotation_ids": [
                  "114bc9d02e309cfd"
                ],
                "status_id": 19,
                "text": "Requests"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "114bc9d02e309cfd"
                ],
                "status_id": 19,
                "text": "for multiple codepoints MAY use a contiguous range."
              },
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "  This minimizes"
              }
            ],
            "   the risk that differing semantics are attributed to the same",
            "   codepoint by different implementations.",
            "",
            "   The use of the first unassigned codepoint is reserved for allocation",
            "   using the Standards Action policy; see Section 4.9 of [RFC8126].  The",
            "   early codepoint assignment process [EARLY-ASSIGN] can be used for",
            "   these values.",
            "",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "9f200d95e11f81db"
                ],
                "status_id": 14,
                "text": "For codepoints that are encoded in variable-length integers"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "9f200d95e11f81db"
                ],
                "status_id": 14,
                "text": "(Section 16), such as frame types, codepoints that encode to four or"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "9f200d95e11f81db"
                ],
                "status_id": 14,
                "text": "eight bytes (that is, values 2^14 and above) SHOULD be used unless"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "9f200d95e11f81db"
                ],
                "status_id": 14,
                "text": "the usage is especially sensitive to having a longer encoding."
              }
            ],
            "",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "74fe40bdb796e06f"
                ],
                "status_id": 19,
                "text": "Applications to register codepoints in QUIC registries MAY include a"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "74fe40bdb796e06f"
                ],
                "status_id": 19,
                "text": "requested codepoint as part of the registration."
              },
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "  "
              },
              {
                "annotation_ids": [
                  "b0620f9f3938c982"
                ],
                "status_id": 20,
                "text": "IANA MUST allocate"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "b0620f9f3938c982"
                ],
                "status_id": 20,
                "text": "the selected codepoint if the codepoint is unassigned and the"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "b0620f9f3938c982"
                ],
                "status_id": 20,
                "text": "requirements of the registration policy are met."
              }
            ]
          ],
          "requirements": [
            "ada749584fbd42d8",
            "ada749584fbd42d8",
            "ada749584fbd42d8",
            "114bc9d02e309cfd",
            "114bc9d02e309cfd",
            "9f200d95e11f81db",
            "9f200d95e11f81db",
            "9f200d95e11f81db",
            "9f200d95e11f81db",
            "74fe40bdb796e06f",
            "74fe40bdb796e06f",
            "b0620f9f3938c982",
            "b0620f9f3938c982",
            "b0620f9f3938c982"
          ],
          "title": "Selecting Codepoints"
        },
        {
          "id": "section-22.1.3",
          "lines": [
            "   A request might be made to remove an unused provisional registration",
            "   from the registry to reclaim space in a registry, or a portion of the",
            "   registry (such as the 64-16383 range for codepoints that use",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   variable-length encodings).  "
              },
              {
                "annotation_ids": [
                  "227b064788dfee47",
                  "6b434ffb869392d8"
                ],
                "status_id": 14,
                "text": "This SHOULD be done only for the"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "227b064788dfee47",
                  "6b434ffb869392d8"
                ],
                "status_id": 14,
                "text": "codepoints with the earliest recorded date, and entries that have"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "227b064788dfee47",
                  "6b434ffb869392d8"
                ],
                "status_id": 14,
                "text": "been updated less than a year prior SHOULD NOT be reclaimed."
              }
            ],
            "",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "ec069554546ae279"
                ],
                "status_id": 20,
                "text": "A request to remove a codepoint MUST be reviewed by the designated"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "ec069554546ae279"
                ],
                "status_id": 20,
                "text": "experts."
              },
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "  "
              },
              {
                "annotation_ids": [
                  "a25ab39e3b4204ea"
                ],
                "status_id": 20,
                "text": "The experts MUST attempt to determine whether the codepoint"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "a25ab39e3b4204ea"
                ],
                "status_id": 20,
                "text": "is still in use."
              },
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "  Experts are advised to contact the listed contacts"
              }
            ],
            "   for the registration, plus as wide a set of protocol implementers as",
            "   possible in order to determine whether any use of the codepoint is",
            "   known.  The experts are also advised to allow at least four weeks for",
            "   responses.",
            "",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "8cd25006cde42c2c"
                ],
                "status_id": 20,
                "text": "If any use of the codepoints is identified by this search or a"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "8cd25006cde42c2c"
                ],
                "status_id": 20,
                "text": "request to update the registration is made, the codepoint MUST NOT be"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "8cd25006cde42c2c"
                ],
                "status_id": 20,
                "text": "reclaimed."
              },
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "  Instead, the date on the registration is updated.  A note"
              }
            ],
            "   might be added for the registration recording relevant information",
            "   that was learned.",
            "",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "e6e18dfd21f8f555"
                ],
                "status_id": 19,
                "text": "If no use of the codepoint was identified and no request was made to"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "e6e18dfd21f8f555"
                ],
                "status_id": 19,
                "text": "update the registration, the codepoint MAY be removed from the"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "e6e18dfd21f8f555"
                ],
                "status_id": 19,
                "text": "registry."
              }
            ],
            "",
            "   This review and consultation process also applies to requests to",
            "   change a provisional registration into a permanent registration,",
            "   except that the goal is not to determine whether there is no use of",
            "   the codepoint but to determine that the registration is an accurate",
            "   representation of any deployed usage."
          ],
          "requirements": [
            "227b064788dfee47",
            "227b064788dfee47",
            "227b064788dfee47",
            "6b434ffb869392d8",
            "6b434ffb869392d8",
            "6b434ffb869392d8",
            "ec069554546ae279",
            "ec069554546ae279",
            "a25ab39e3b4204ea",
            "a25ab39e3b4204ea",
            "8cd25006cde42c2c",
            "8cd25006cde42c2c",
            "8cd25006cde42c2c",
            "e6e18dfd21f8f555",
            "e6e18dfd21f8f555",
            "e6e18dfd21f8f555"
          ],
          "title": "Reclaiming Provisional Codepoints"
        },
        {
          "id": "section-22.1.4",
          "lines": [
            "   Permanent registrations in QUIC registries use the Specification",
            "   Required policy (Section 4.6 of [RFC8126]), unless otherwise",
            "   specified.  The designated expert or experts verify that a",
            "   specification exists and is readily accessible.  Experts are",
            "   encouraged to be biased towards approving registrations unless they",
            "   are abusive, frivolous, or actively harmful (not merely aesthetically",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   displeasing or architecturally dubious).  "
              },
              {
                "annotation_ids": [
                  "db2ed77c21ad5f9e"
                ],
                "status_id": 19,
                "text": "The creation of a registry"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "db2ed77c21ad5f9e"
                ],
                "status_id": 19,
                "text": "MAY specify additional constraints on permanent registrations."
              }
            ],
            "",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "3af4389a5a62e401"
                ],
                "status_id": 19,
                "text": "The creation of a registry MAY identify a range of codepoints where"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "3af4389a5a62e401"
                ],
                "status_id": 19,
                "text": "registrations are governed by a different registration policy."
              },
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "  For"
              }
            ],
            "   instance, the \"QUIC Frame Types\" registry (Section 22.4) has a",
            "   stricter policy for codepoints in the range from 0 to 63.",
            "",
            "   Any stricter requirements for permanent registrations do not prevent",
            "   provisional registrations for affected codepoints.  For instance, a",
            "   provisional registration for a frame type of 61 could be requested.",
            "",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "aeda192bdd8e1b6f"
                ],
                "status_id": 20,
                "text": "All registrations made by Standards Track publications MUST be"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "aeda192bdd8e1b6f"
                ],
                "status_id": 20,
                "text": "permanent."
              }
            ],
            "",
            "   All registrations in this document are assigned a permanent status",
            "   and list a change controller of the IETF and a contact of the QUIC",
            "   Working Group (quic@ietf.org)."
          ],
          "requirements": [
            "db2ed77c21ad5f9e",
            "db2ed77c21ad5f9e",
            "3af4389a5a62e401",
            "3af4389a5a62e401",
            "aeda192bdd8e1b6f",
            "aeda192bdd8e1b6f"
          ],
          "title": "Permanent Registrations"
        },
        {
          "id": "section-22.2",
          "lines": [
            "   IANA has added a registry for \"QUIC Versions\" under a \"QUIC\" heading.",
            "",
            "   The \"QUIC Versions\" registry governs a 32-bit space; see Section 15.",
            "   This registry follows the registration policy from Section 22.1.",
            "   Permanent registrations in this registry are assigned using the",
            "   Specification Required policy (Section 4.6 of [RFC8126]).",
            "",
            "   The codepoint of 0x00000001 for the protocol is assigned with",
            "   permanent status to the protocol defined in this document.  The",
            "   codepoint of 0x00000000 is permanently reserved; the note for this",
            "   codepoint indicates that this version is reserved for version",
            "   negotiation.",
            "",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "3ebb0db94cebfb82",
                  "ffb51e436599aaf7"
                ],
                "status_id": 20,
                "text": "All codepoints that follow the pattern 0x?a?a?a?a are reserved, MUST"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "3ebb0db94cebfb82",
                  "ffb51e436599aaf7"
                ],
                "status_id": 20,
                "text": "NOT be assigned by IANA, and MUST NOT appear in the listing of"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "3ebb0db94cebfb82",
                  "ffb51e436599aaf7"
                ],
                "status_id": 20,
                "text": "assigned values."
              }
            ]
          ],
          "requirements": [
            "3ebb0db94cebfb82",
            "3ebb0db94cebfb82",
            "3ebb0db94cebfb82",
            "ffb51e436599aaf7",
            "ffb51e436599aaf7",
            "ffb51e436599aaf7"
          ],
          "title": "QUIC Versions Registry"
        },
        {
          "id": "section-22.3",
          "lines": [
            "   IANA has added a registry for \"QUIC Transport Parameters\" under a",
            "   \"QUIC\" heading.",
            "",
            "   The \"QUIC Transport Parameters\" registry governs a 62-bit space.",
            "   This registry follows the registration policy from Section 22.1.",
            "   Permanent registrations in this registry are assigned using the",
            "   Specification Required policy (Section 4.6 of [RFC8126]), except for",
            "   values between 0x00 and 0x3f (in hexadecimal), inclusive, which are",
            "   assigned using Standards Action or IESG Approval as defined in",
            "   Sections 4.9 and 4.10 of [RFC8126].",
            "",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "a429a3c174e6ee72"
                ],
                "status_id": 20,
                "text": "In addition to the fields listed in Section 22.1.1, permanent"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "a429a3c174e6ee72"
                ],
                "status_id": 20,
                "text": "registrations in this registry MUST include the following field:"
              }
            ],
            "",
            "   Parameter Name:  A short mnemonic for the parameter.",
            "",
            "   The initial contents of this registry are shown in Table 6.",
            "",
            "      +=======+=====================================+===============+",
            "      | Value | Parameter Name                      | Specification |",
            "      +=======+=====================================+===============+",
            "      | 0x00  | original_destination_connection_id  | Section 18.2  |",
            "      +-------+-------------------------------------+---------------+",
            "      | 0x01  | max_idle_timeout                    | Section 18.2  |",
            "      +-------+-------------------------------------+---------------+",
            "      | 0x02  | stateless_reset_token               | Section 18.2  |",
            "      +-------+-------------------------------------+---------------+",
            "      | 0x03  | max_udp_payload_size                | Section 18.2  |",
            "      +-------+-------------------------------------+---------------+",
            "      | 0x04  | initial_max_data                    | Section 18.2  |",
            "      +-------+-------------------------------------+---------------+",
            "      | 0x05  | initial_max_stream_data_bidi_local  | Section 18.2  |",
            "      +-------+-------------------------------------+---------------+",
            "      | 0x06  | initial_max_stream_data_bidi_remote | Section 18.2  |",
            "      +-------+-------------------------------------+---------------+",
            "      | 0x07  | initial_max_stream_data_uni         | Section 18.2  |",
            "      +-------+-------------------------------------+---------------+",
            "      | 0x08  | initial_max_streams_bidi            | Section 18.2  |",
            "      +-------+-------------------------------------+---------------+",
            "      | 0x09  | initial_max_streams_uni             | Section 18.2  |",
            "      +-------+-------------------------------------+---------------+",
            "      | 0x0a  | ack_delay_exponent                  | Section 18.2  |",
            "      +-------+-------------------------------------+---------------+",
            "      | 0x0b  | max_ack_delay                       | Section 18.2  |",
            "      +-------+-------------------------------------+---------------+",
            "      | 0x0c  | disable_active_migration            | Section 18.2  |",
            "      +-------+-------------------------------------+---------------+",
            "      | 0x0d  | preferred_address                   | Section 18.2  |",
            "      +-------+-------------------------------------+---------------+",
            "      | 0x0e  | active_connection_id_limit          | Section 18.2  |",
            "      +-------+-------------------------------------+---------------+",
            "      | 0x0f  | initial_source_connection_id        | Section 18.2  |",
            "      +-------+-------------------------------------+---------------+",
            "      | 0x10  | retry_source_connection_id          | Section 18.2  |",
            "      +-------+-------------------------------------+---------------+",
            "",
            "        Table 6: Initial QUIC Transport Parameters Registry Entries",
            "",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "e46baf014d21fabe",
                  "728592f750827071"
                ],
                "status_id": 20,
                "text": "Each value of the form \"31 * N + 27\" for integer values of N (that"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "e46baf014d21fabe",
                  "728592f750827071"
                ],
                "status_id": 20,
                "text": "is, 27, 58, 89, ...) are reserved; these values MUST NOT be assigned"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "e46baf014d21fabe",
                  "728592f750827071"
                ],
                "status_id": 20,
                "text": "by IANA and MUST NOT appear in the listing of assigned values."
              }
            ]
          ],
          "requirements": [
            "a429a3c174e6ee72",
            "a429a3c174e6ee72",
            "e46baf014d21fabe",
            "e46baf014d21fabe",
            "e46baf014d21fabe",
            "728592f750827071",
            "728592f750827071",
            "728592f750827071"
          ],
          "title": "QUIC Transport Parameters Registry"
        },
        {
          "id": "section-22.4",
          "lines": [
            "   IANA has added a registry for \"QUIC Frame Types\" under a \"QUIC\"",
            "   heading.",
            "",
            "   The \"QUIC Frame Types\" registry governs a 62-bit space.  This",
            "   registry follows the registration policy from Section 22.1.",
            "   Permanent registrations in this registry are assigned using the",
            "   Specification Required policy (Section 4.6 of [RFC8126]), except for",
            "   values between 0x00 and 0x3f (in hexadecimal), inclusive, which are",
            "   assigned using Standards Action or IESG Approval as defined in",
            "   Sections 4.9 and 4.10 of [RFC8126].",
            "",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "b0aa7dd0848f35c6"
                ],
                "status_id": 20,
                "text": "In addition to the fields listed in Section 22.1.1, permanent"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "b0aa7dd0848f35c6"
                ],
                "status_id": 20,
                "text": "registrations in this registry MUST include the following field:"
              }
            ],
            "",
            "   Frame Type Name:  A short mnemonic for the frame type.",
            "",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "ccff55d143903824"
                ],
                "status_id": 14,
                "text": "In addition to the advice in Section 22.1, specifications for new"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "ccff55d143903824"
                ],
                "status_id": 14,
                "text": "permanent registrations SHOULD describe the means by which an"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "ccff55d143903824"
                ],
                "status_id": 14,
                "text": "endpoint might determine that it can send the identified type of"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "ccff55d143903824"
                ],
                "status_id": 14,
                "text": "frame."
              },
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "  An accompanying transport parameter registration is expected"
              }
            ],
            "   for most registrations; see Section 22.3.  Specifications for",
            "   permanent registrations also need to describe the format and assigned",
            "   semantics of any fields in the frame.",
            "",
            "   The initial contents of this registry are tabulated in Table 3.  Note",
            "   that the registry does not include the \"Pkts\" and \"Spec\" columns from",
            "   Table 3."
          ],
          "requirements": [
            "b0aa7dd0848f35c6",
            "b0aa7dd0848f35c6",
            "ccff55d143903824",
            "ccff55d143903824",
            "ccff55d143903824",
            "ccff55d143903824"
          ],
          "title": "QUIC Frame Types Registry"
        },
        {
          "id": "section-22.5",
          "lines": [
            "   IANA has added a registry for \"QUIC Transport Error Codes\" under a",
            "   \"QUIC\" heading.",
            "",
            "   The \"QUIC Transport Error Codes\" registry governs a 62-bit space.",
            "   This space is split into three ranges that are governed by different",
            "   policies.  Permanent registrations in this registry are assigned",
            "   using the Specification Required policy (Section 4.6 of [RFC8126]),",
            "   except for values between 0x00 and 0x3f (in hexadecimal), inclusive,",
            "   which are assigned using Standards Action or IESG Approval as defined",
            "   in Sections 4.9 and 4.10 of [RFC8126].",
            "",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "25ca8a0e478da5d8"
                ],
                "status_id": 20,
                "text": "In addition to the fields listed in Section 22.1.1, permanent"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "25ca8a0e478da5d8"
                ],
                "status_id": 20,
                "text": "registrations in this registry MUST include the following fields:"
              }
            ],
            "",
            "   Code:  A short mnemonic for the parameter.",
            "",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "   "
              },
              {
                "annotation_ids": [
                  "f5942c9258ebe823"
                ],
                "status_id": 19,
                "text": "Description:  A brief description of the error code semantics, which"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "      "
              },
              {
                "annotation_ids": [
                  "f5942c9258ebe823"
                ],
                "status_id": 19,
                "text": "MAY be a summary if a specification reference is provided."
              }
            ],
            "",
            "   The initial contents of this registry are shown in Table 7.",
            "",
            "   +=======+===========================+================+==============+",
            "   |Value  | Code                      |Description     |Specification |",
            "   +=======+===========================+================+==============+",
            "   |0x00   | NO_ERROR                  |No error        |Section 20    |",
            "   +-------+---------------------------+----------------+--------------+",
            "   |0x01   | INTERNAL_ERROR            |Implementation  |Section 20    |",
            "   |       |                           |error           |              |",
            "   +-------+---------------------------+----------------+--------------+",
            "   |0x02   | CONNECTION_REFUSED        |Server refuses a|Section 20    |",
            "   |       |                           |connection      |              |",
            "   +-------+---------------------------+----------------+--------------+",
            "   |0x03   | FLOW_CONTROL_ERROR        |Flow control    |Section 20    |",
            "   |       |                           |error           |              |",
            "   +-------+---------------------------+----------------+--------------+",
            "   |0x04   | STREAM_LIMIT_ERROR        |Too many streams|Section 20    |",
            "   |       |                           |opened          |              |",
            "   +-------+---------------------------+----------------+--------------+",
            "   |0x05   | STREAM_STATE_ERROR        |Frame received  |Section 20    |",
            "   |       |                           |in invalid      |              |",
            "   |       |                           |stream state    |              |",
            "   +-------+---------------------------+----------------+--------------+",
            "   |0x06   | FINAL_SIZE_ERROR          |Change to final |Section 20    |",
            "   |       |                           |size            |              |",
            "   +-------+---------------------------+----------------+--------------+",
            "   |0x07   | FRAME_ENCODING_ERROR      |Frame encoding  |Section 20    |",
            "   |       |                           |error           |              |",
            "   +-------+---------------------------+----------------+--------------+",
            "   |0x08   | TRANSPORT_PARAMETER_ERROR |Error in        |Section 20    |",
            "   |       |                           |transport       |              |",
            "   |       |                           |parameters      |              |",
            "   +-------+---------------------------+----------------+--------------+",
            "   |0x09   | CONNECTION_ID_LIMIT_ERROR |Too many        |Section 20    |",
            "   |       |                           |connection IDs  |              |",
            "   |       |                           |received        |              |",
            "   +-------+---------------------------+----------------+--------------+",
            "   |0x0a   | PROTOCOL_VIOLATION        |Generic protocol|Section 20    |",
            "   |       |                           |violation       |              |",
            "   +-------+---------------------------+----------------+--------------+",
            "   |0x0b   | INVALID_TOKEN             |Invalid Token   |Section 20    |",
            "   |       |                           |received        |              |",
            "   +-------+---------------------------+----------------+--------------+",
            "   |0x0c   | APPLICATION_ERROR         |Application     |Section 20    |",
            "   |       |                           |error           |              |",
            "   +-------+---------------------------+----------------+--------------+",
            "   |0x0d   | CRYPTO_BUFFER_EXCEEDED    |CRYPTO data     |Section 20    |",
            "   |       |                           |buffer          |              |",
            "   |       |                           |overflowed      |              |",
            "   +-------+---------------------------+----------------+--------------+",
            "   |0x0e   | KEY_UPDATE_ERROR          |Invalid packet  |Section 20    |",
            "   |       |                           |protection      |              |",
            "   |       |                           |update          |              |",
            "   +-------+---------------------------+----------------+--------------+",
            "   |0x0f   | AEAD_LIMIT_REACHED        |Excessive use of|Section 20    |",
            "   |       |                           |packet          |              |",
            "   |       |                           |protection keys |              |",
            "   +-------+---------------------------+----------------+--------------+",
            "   |0x10   | NO_VIABLE_PATH            |No viable       |Section 20    |",
            "   |       |                           |network path    |              |",
            "   |       |                           |exists          |              |",
            "   +-------+---------------------------+----------------+--------------+",
            "   |0x0100-| CRYPTO_ERROR              |TLS alert code  |Section 20    |",
            "   |0x01ff |                           |                |              |",
            "   +-------+---------------------------+----------------+--------------+",
            "",
            "        Table 7: Initial QUIC Transport Error Codes Registry Entries"
          ],
          "requirements": [
            "25ca8a0e478da5d8",
            "25ca8a0e478da5d8",
            "f5942c9258ebe823",
            "f5942c9258ebe823"
          ],
          "title": "QUIC Transport Error Codes Registry"
        },
