    },
    {
      "id": "00b9c8c9a5c60229",
      "level": "Auto",
      "line": 591,
      "quote": "*  MUST NOT subtract the acknowledgement delay from the RTT sample if the resulting value is smaller than the min_rtt.",
      "source": "quic/s2n-quic-core/src/recovery/rtt_estimator.rs",
      "target_path": "https://www.rfc-editor.org/rfc/rfc9002",
      "target_section": "section-5.3",
      "type": "TEST"
    },
    {
      "id": "dbe52249c8c602b8",
      "level": "Auto",
      "line": 622,
      "quote": "Therefore, prior to handshake confirmation, an endpoint MAY ignore RTT samples if adjusting the RTT sample for acknowledgement delay causes the sample to be less than the min_rtt.",
      "source": "quic/s2n-quic-core/src/recovery/rtt_estimator.rs",
      "target_path": "https://www.rfc-editor.org/rfc/rfc9002",
      "target_section": "section-5.3",
