    },
    {
      "id": "ff506722e4c89e85",
      "level": "Auto",
      "line": 298,
      "quote": "Endpoints MUST send Stateless Resets formatted as a packet with a short header.",
      "source": "quic/s2n-quic-core/src/packet/stateless_reset.rs",
      "target_path": "https://www.rfc-editor.org/rfc/rfc9000",
