        },
        {
          "id": "section-9.2",
          "lines": [
            "   [draft-cheng-iccrg-delivery-rate-estimation]",
            "              Cheng, Y., Cardwell, N., Hassas Yeganeh, S., and V.",
            "              Jacobson, \"Delivery Rate Estimation\", Work in Progress,",
            "              Internet-Draft, draft-cheng-iccrg-delivery-rate-",
