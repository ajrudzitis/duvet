      "target_section": "section-4.6.2",
      "type": "TODO"
    },
    {
      "feature": "0-RTT",
      "id": "1d3eadc03f7eb43c",
      "level": "Auto",
      "line": 3,
      "quote": "Additionally, a server MAY discard 0-RTT keys as soon as it receives a 1-RTT packet.",
      "source": "specs/todos/tls/4.9.3.toml",
      "target_path": "https://www.rfc-editor.org/rfc/rfc9001",
      "target_section": "section-4.9.3",
      "tracking_issue": "305",
