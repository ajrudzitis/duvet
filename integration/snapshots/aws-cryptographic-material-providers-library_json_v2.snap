    },
    {
      "id": "f5aa943655f2e053",
      "level": "Auto",
      "line": 16,
      "quote": "The CMM Interface MUST support the following behaviors:",
      "source": "AwsCryptographicMaterialProviders/dafny/AwsCryptographicMaterialProviders/Model/cmms.smithy",
      "target_path": "aws-encryption-sdk-specification/framework/cmm-interface.md",
