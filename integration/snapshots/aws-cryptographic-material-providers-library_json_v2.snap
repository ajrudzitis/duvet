    },
    {
      "id": "3b7a6d93d287d1f3",
      "level": "Auto",
      "line": 340,
      "quote": "If the Generate Data Key call succeeds, OnEncrypt MUST verify that the response `Plaintext` length matches the specification of the [algorithm suite](../algorithm-suites.md)'s Key Derivation Input Length field.",
      "source": "AwsCryptographicMaterialProviders/dafny/AwsCryptographicMaterialProviders/src/Keyrings/AwsKms/AwsKmsMrkKeyring.dfy",
