    },
    {
      "comment": "ECC Private Key MUST be a [PEM encoded PKCS #8 PrivateKeyInfo structures](https://tools.ietf.org/html/rfc5958#section-2)\nas private key.\n",
      "id": "39988ca48e121591",
      "level": "Must",
