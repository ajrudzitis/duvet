    {
      "id": "763d774296d6d055",
      "level": "Auto",
      "line": 98,
      "quote": "If the keyring cannot serialize the encryption context, OnDecrypt MUST fail.",
      "source": "AwsCryptographicMaterialProviders/dafny/AwsCryptographicMaterialProviders/src/KeyWrapping/EcdhEdkWrapping.dfy",
      "target_path": "aws-encryption-sdk-specification/framework/raw-ecdh-keyring.md",
