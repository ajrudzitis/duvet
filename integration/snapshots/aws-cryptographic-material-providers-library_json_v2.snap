    },
    {
      "id": "4cba3234acd2f34c",
      "level": "Auto",
      "line": 336,
      "quote": "- For each encrypted data key, a [symmetric signing key](./structures.md#symmetric-signing-key) MUST be derived from the `intermediate key` using the key derivation algorithm in the algorithm suite, with the following specifics:",
      "source": "AwsCryptographicMaterialProviders/dafny/AwsCryptographicMaterialProviders/src/KeyWrapping/IntermediateKeyWrapping.dfy",
      "target_path": "aws-encryption-sdk-specification/framework/algorithm-suites.md",
