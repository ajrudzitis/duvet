            "8dd01344b98b4b5c",
            "82fc7573cb6f23cb"
          ],
          "title": "AWS KMS Multi-Keyring"
        },
        {
          "id": "aws-kms-discovery-multi-keyring",
          "lines": [
            [
              {
                "annotation_ids": [
                  "6c91cdbe56bf3aa7",
                  "570575af9689de7c"
                ],
                "status_id": 1,
                "text": "The caller MUST provide:"
              }
            ],
            "",
            [
              {
                "annotation_ids": [
                  "6c91cdbe56bf3aa7"
                ],
                "status_id": 2,
                "text": "- A set of Region strings"
              }
            ],
            [
              {
                "annotation_ids": [
                  "6c91cdbe56bf3aa7"
                ],
                "status_id": 2,
                "text": "- An optional discovery filter that is an AWS partition and a set of AWS accounts"
              }
            ],
            [
              {
                "annotation_ids": [
                  "6c91cdbe56bf3aa7"
                ],
                "status_id": 2,
                "text": "- An optional method that can take a region string and return an AWS KMS client e.g. a regional client supplier"
              }
            ],
            [
              {
                "annotation_ids": [
                  "6c91cdbe56bf3aa7"
                ],
                "status_id": 2,
                "text": "- An optional list of AWS KMS grant tokens"
              }
            ],
            "",
            [
              {
                "annotation_ids": [
                  "b5b3a790ed538517",
                  "bea62dc06bc90333"
                ],
                "status_id": 1,
                "text": "If an empty set of Region is provided this function MUST fail."
              }
            ],
            [
              {
                "annotation_ids": [
                  "687dfbc03421a5d3",
                  "262595d40313fead"
                ],
                "status_id": 1,
                "text": "If any element of the set of regions is null or an empty string this function MUST fail."
              }
            ],
            [
              {
                "annotation_ids": [
                  "d4e4ec8f8bb09c66",
                  "51b3615f7dccdec4"
                ],
                "status_id": 5,
                "text": "If a regional client supplier is not passed, then a default MUST be created that takes a region string and generates a default AWS SDK client for the given region."
              }
            ],
            "",
            [
              {
                "annotation_ids": [
                  "82c620676188abe3",
                  "c1c1cb6d85f17e57"
                ],
                "status_id": 5,
                "text": "A set of AWS KMS clients MUST be created by calling regional client supplier for each region in the input set of regions."
              }
            ],
            "",
            [
              {
                "annotation_ids": [
                  "b8f0029bfdce0e2c",
                  "4c139847d63866f5"
                ],
                "status_id": 1,
                "text": "Then a set of [AWS KMS Discovery Keyring](aws-kms-discovery-keyring.md) MUST be created for each AWS KMS client by initializing each keyring with"
              }
            ],
            "",
            [
              {
                "annotation_ids": [
                  "b8f0029bfdce0e2c"
                ],
                "status_id": 2,
                "text": "- The AWS KMS client"
              }
            ],
            [
              {
                "annotation_ids": [
                  "b8f0029bfdce0e2c"
                ],
                "status_id": 2,
                "text": "- The input discovery filter"
              }
            ],
            [
              {
                "annotation_ids": [
                  "b8f0029bfdce0e2c"
                ],
                "status_id": 2,
                "text": "- The input AWS KMS grant tokens"
              }
            ],
            "",
            [
              {
                "annotation_ids": [
                  "bbf58258f5364e4b",
                  "47db70b7aa7d9e24"
                ],
                "status_id": 1,
                "text": "Then a [Multi-Keyring](../multi-keyring.md#inputs) MUST be initialize by using this set of discovery keyrings as the [child keyrings](../multi-keyring.md#child-keyrings)."
              }
            ],
            [
              {
                "annotation_ids": [
                  "bbf58258f5364e4b",
                  "32036da560a1f05a"
                ],
                "status_id": 1,
                "text": "This Multi-Keyring MUST be this functions output."
              }
            ]
          ],
          "requirements": [
            "570575af9689de7c",
            "bea62dc06bc90333",
            "262595d40313fead",
            "51b3615f7dccdec4",
            "c1c1cb6d85f17e57",
            "4c139847d63866f5",
            "47db70b7aa7d9e24",
            "32036da560a1f05a"
          ],
          "title": "AWS KMS Discovery Multi-Keyring"
        }
      ],
      "title": "AWS KMS Multi Keyrings"
    },
    "aws-encryption-sdk-specification/framework/aws-kms/aws-kms-rsa-keyring.md": {
      "format": "markdown",
      "sections": [
        {
          "id": "aws-kms-rsa-keyring",
          "lines": [],
          "title": "AWS KMS RSA Keyring"
        },
        {
          "id": "version",
          "lines": [
            "0.1.0-preview"
          ],
          "title": "Version"
        },
        {
          "id": "changelog",
          "lines": [
            "- 0.1.0-preview",
            "",
            "  - Initial record"
          ],
          "title": "Changelog"
        },
        {
          "id": "implementations",
          "lines": [
            "| Language | Confirmed Compatible with Spec Version | Minimum Version Confirmed | Implementation |",
            "| ---------- | -------------------------------------- | ------------------------- | ------------------------------------------------------------------------------------------------------------------------------------------------------------------- | |"
          ],
          "title": "Implementations"
        },
        {
          "id": "overview",
          "lines": [
            "A keyring which uses AWS KMS RSA asymmetric keys",
            "to protect messages with envelop encryption.",
            "A hash of the Encryption Context is stored",
            "in the encrypted data key",
            "to bind the encryption context to the data key.",
            "",
            "For decryption of data keys the keyring always calls KMS",
            "and compares the encryption context",
            "to the hashed value stored in the encrypted data key."
          ],
          "title": "Overview"
        },
        {
          "id": "definitions",
          "lines": [],
          "title": "Definitions"
        },
        {
          "id": "conventions-used-in-this-document",
          "lines": [
            "The key words \"MUST\", \"MUST NOT\", \"REQUIRED\", \"SHALL\", \"SHALL NOT\", \"SHOULD\", \"SHOULD NOT\", \"RECOMMENDED\", \"MAY\", and \"OPTIONAL\"",
            "in this document are to be interpreted as described in [RFC 2119](https://tools.ietf.org/html/rfc2119)."
          ],
          "title": "Conventions used in this document"
        },
        {
          "id": "initialization",
          "lines": [
            "On initialized the caller can provide:",
            "",
            [
              {
                "annotation_ids": [
                  "1f429cd249122096",
                  "dac7bf4a5caeab92"
                ],
                "status_id": 1,
                "text": "- MUST provide an AWS KMS key identifier"
              }
            ],
            [
              {
                "annotation_ids": [
                  "50fe5402989c18e9",
                  "627e46c004ec0438"
                ],
                "status_id": 1,
                "text": "- MUST provide an [AWS KMS Encryption Algorithm](#supported-padding-schemes)"
              }
            ],
            [
              {
                "annotation_ids": [
                  "5bbf0ddae7932fd7",
                  "c8b9fd949b8eeae5"
                ],
                "status_id": 4,
                "text": "- MAY provide a PEM encoded Public Key"
              }
            ],
            [
              {
                "annotation_ids": [
                  "73f098439e5df4f7",
                  "cc002b9219cc8e62"
                ],
                "status_id": 4,
                "text": "- MAY provide an AWS KMS SDK client"
              }
            ],
            [
              {
                "annotation_ids": [
                  "045dc186b846d69f",
                  "91fd00f86ed0cbd4"
                ],
                "status_id": 4,
                "text": "- MAY provide a list of Grant Tokens"
              }
            ],
            "",
            [
              {
                "annotation_ids": [
                  "21ef61094dd8a2f9",
                  "1460e26a4de23975"
                ],
                "status_id": 1,
                "text": "The AWS KMS key identifier MUST NOT be null or empty."
              }
            ],
            [
              {
                "annotation_ids": [
                  "a9a74eda7b1ae0d6",
                  "f45176970f367cd3"
                ],
                "status_id": 1,
                "text": "The AWS KMS key identifier MUST be [a valid identifier](../../framework/aws-kms/aws-kms-key-arn.md#a-valid-aws-kms-identifier)."
              }
            ],
            [
              {
                "annotation_ids": [
                  "16d1c7c30d15dd52",
                  "c9d68e36d8eb9778"
                ],
                "status_id": 1,
                "text": "The AWS KMS key identifier MUST NOT be an AWS KMS alias."
              }
            ],
            "",
            [
              {
                "annotation_ids": [
                  "ec7bf149d5f284b4",
                  "5f0152d3a38c9b5d"
                ],
                "status_id": 1,
                "text": "If provided the Public Key"
              }
            ],
            [
              {
                "annotation_ids": [
                  "ec7bf149d5f284b4",
                  "5f0152d3a38c9b5d"
                ],
                "status_id": 1,
                "text": "MUST have an RSA modulus bit length greater than or equal to 2048."
              }
            ],
            "The configured AWS KMS key identifier",
            "must match the public key provided.",
            "There should not be a synchronous check to verify this."
          ],
          "requirements": [
            "dac7bf4a5caeab92",
            "627e46c004ec0438",
            "c8b9fd949b8eeae5",
            "cc002b9219cc8e62",
            "91fd00f86ed0cbd4",
            "1460e26a4de23975",
            "f45176970f367cd3",
            "c9d68e36d8eb9778",
            "5f0152d3a38c9b5d",
            "5f0152d3a38c9b5d"
          ],
          "title": "Initialization"
        },
        {
          "id": "aws-kms-encryption-algorithm",
          "lines": [
            "The RSA padding scheme to use with this keyring.",
            "",
            [
              {
                "annotation_ids": [
                  "278cbfad63eb0ac9"
                ],
                "status_id": 3,
                "text": "This value MUST correspond with one of the [supported padding schemes](#supported-padding-schemes)."
              }
            ]
          ],
          "requirements": [
            "278cbfad63eb0ac9"
          ],
          "title": "AWS KMS Encryption Algorithm"
        },
        {
          "id": "supported-padding-schemes",
          "lines": [
            "The following padding schemes are currently defined by AWS KMS:",
            "",
            "- RSAES_OAEP_SHA_1",
            "  - This is equivalent to [OAEP with SHA-1 and MGF1 with SHA-1 Padding](https://tools.ietf.org/html/rfc8017#section-7.1)",
            "- RSAES_OAEP_SHA_256",
            "  - This is equivalent to [OAEP with SHA-256 and MGF1 with SHA-256 Padding](https://tools.ietf.org/html/rfc8017#section-7.1)",
            "",
            [
              {
                "annotation_ids": [
                  "9f1c23b2566e1e69"
                ],
                "status_id": 3,
                "text": "This keyring MUST NOT use a padding scheme outside those defined above."
              }
            ],
            "These values must match the supported values",
            "for [AWS KMS RSA key specs](https://docs.aws.amazon.com/kms/latest/developerguide/asymmetric-key-specs.html#key-spec-rsa)."
          ],
          "requirements": [
            "9f1c23b2566e1e69"
          ],
          "title": "Supported Padding Schemes"
        },
        {
          "id": "operation",
          "lines": [],
          "title": "Operation"
        },
        {
          "id": "onencrypt",
          "lines": [
            [
              {
                "annotation_ids": [
                  "935e0a6e9ae7175e"
                ],
                "status_id": 3,
                "text": "OnEncrypt MUST fail if this keyring does not have a specified Public Key."
              }
            ],
            "",
            [
              {
                "annotation_ids": [
                  "01f80e4a3f0b8ba0",
                  "cf246b59cfd07c2d"
                ],
                "status_id": 1,
                "text": "OnEncrypt MUST fail if the input [encryption materials](../structures.md#encryption-materials)"
              }
            ],
            [
              {
                "annotation_ids": [
                  "01f80e4a3f0b8ba0",
                  "cf246b59cfd07c2d"
                ],
                "status_id": 1,
                "text": "contains an [algorithm suite](../algorithm-suites.md) containing an"
              }
            ],
            [
              {
                "annotation_ids": [
                  "01f80e4a3f0b8ba0",
                  "cf246b59cfd07c2d"
                ],
                "status_id": 1,
                "text": "[asymmetric signature](../algorithm-suites.md#asymmetric-signature-algorithm)."
              }
            ],
            "See [Security Considerations](#security-considerations).",
            "",
            [
              {
                "annotation_ids": [
                  "e1771072d63cc675"
                ],
                "status_id": 3,
                "text": "OnEncrypt MUST take [encryption materials](../structures.md#encryption-materials) as input."
              }
            ],
            "",
            [
              {
                "annotation_ids": [
                  "879e47cc02a48b64"
                ],
                "status_id": 3,
                "text": "If the [encryption materials](structures.md#encryption-materials) do not contain a plaintext data key,"
              }
            ],
            [
              {
                "annotation_ids": [
                  "879e47cc02a48b64"
                ],
                "status_id": 3,
                "text": "OnEncrypt MUST generate a random plaintext data key and set it on the [encryption materials](structures.md#encryption-materials)."
              }
            ],
            "",
            [
              {
                "annotation_ids": [
                  "7dcaad5f157e8a31",
                  "14f07428d8a9592c"
                ],
                "status_id": 5,
                "text": "OnEncrypt MUST calculate a Encryption Context Digest by:"
              }
            ],
            "",
            "1. Serializing The [encryption context](structures.md#encryption-context-1) from the input",
            "   [encryption materials](../structures.md#encryption-materials) according to the [encryption context serialization specification](../structures.md#serialization).",
            "2. Taking the SHA-384 Digest of this concatenation.",
            "",
            [
              {
                "annotation_ids": [
                  "73f328d9cec2e99a"
                ],
                "status_id": 3,
                "text": "The keyring MUST determine the [Padding Scheme](#padding-scheme)"
              }
            ],
            [
              {
                "annotation_ids": [
                  "73f328d9cec2e99a"
                ],
                "status_id": 3,
                "text": "using the configured [AWS KMS Encryption Algorithm]((https://docs.aws.amazon.com/kms/latest/APIReference/API_Decrypt.html#KMS-Decrypt-request-EncryptionAlgorithm)."
              }
            ],
            "in the following manner:",
            "",
            [
              {
                "annotation_ids": [
                  "b26fc77c5453592a"
                ],
                "status_id": 3,
                "text": "If `RSAES_OAEP_SHA_256` the keyring"
              }
            ],
            [
              {
                "annotation_ids": [
                  "b26fc77c5453592a"
                ],
                "status_id": 3,
                "text": "MUST use [OAEP with SHA-256 and MGF1 with SHA-256 Padding](https://tools.ietf.org/html/rfc8017#section-7.1)."
              }
            ],
            "",
            [
              {
                "annotation_ids": [
                  "a77fc54f6134f48b"
                ],
                "status_id": 3,
                "text": "If `RSAES_OAEP_SHA_1` the keyring"
              }
            ],
            [
              {
                "annotation_ids": [
                  "a77fc54f6134f48b"
                ],
                "status_id": 3,
                "text": "MUST use [OAEP with SHA-1 and MGF1 with SHA-1 Padding](https://tools.ietf.org/html/rfc8017#section-7.1)"
              }
            ],
            "",
            [
              {
                "annotation_ids": [
                  "abb065c9fd77a72c"
                ],
                "status_id": 3,
                "text": "The keyring MUST attempt to encrypt the plaintext data key in the"
              }
            ],
            [
              {
                "annotation_ids": [
                  "abb065c9fd77a72c"
                ],
                "status_id": 3,
                "text": "[encryption materials](structures.md#encryption-materials) using RSA."
              }
            ],
            "",
            "The keyring performs [RSA encryption](#rsa) with the following specifics:",
            "",
            "- This keyring's [padding scheme](#supported-padding-schemes) calculated above.",
            "- The Encryption Context Digest concatenated with the plaintext data key is the plaintext input to RSA encryption.",
            "- This [public key](kms-rsa-public-key-provider-interface.md##public-key)",
            "  is the configured RSA public key.",
            "",
            [
              {
                "annotation_ids": [
                  "908f01e8bfdc4b16"
                ],
                "status_id": 3,
                "text": "If RSA encryption was successful, OnEncrypt MUST return the input"
              }
            ],
            [
              {
                "annotation_ids": [
                  "908f01e8bfdc4b16"
                ],
                "status_id": 3,
                "text": "[encryption materials](structures.md#encryption-materials), modified in the following ways:"
              }
            ],
            "",
            "- The encrypted data key list has a new encrypted data key added, constructed as follows:",
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "  "
              },
              {
                "annotation_ids": [
                  "e299e7b999554a5c"
                ],
                "status_id": 3,
                "text": "- The [ciphertext](../structures.md#ciphertext) MUST field is the ciphertext output by the RSA encryption."
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "  "
              },
              {
                "annotation_ids": [
                  "4072f697fd4e81d6"
                ],
                "status_id": 3,
                "text": "- The [key provider id](../structures.md#key-provider-id) MUST be \"aws-kms-rsa\"."
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "  "
              },
              {
                "annotation_ids": [
                  "75aa269d2f11011f"
                ],
                "status_id": 3,
                "text": "- The [key provider information](../structures.md#key-provider-information) MUST be"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "    "
              },
              {
                "annotation_ids": [
                  "75aa269d2f11011f"
                ],
                "status_id": 3,
                "text": "the configured `AWS KMS key identifier`."
              }
            ],
            "",
            [
              {
                "annotation_ids": [
                  "8592f637b29fbdcf"
                ],
                "status_id": 3,
                "text": "If RSA encryption was NOT successful, OnEncrypt MUST fail."
              }
            ]
          ],
          "requirements": [
            "935e0a6e9ae7175e",
            "cf246b59cfd07c2d",
            "cf246b59cfd07c2d",
            "cf246b59cfd07c2d",
            "e1771072d63cc675",
            "879e47cc02a48b64",
            "879e47cc02a48b64",
            "14f07428d8a9592c",
            "73f328d9cec2e99a",
            "73f328d9cec2e99a",
            "b26fc77c5453592a",
            "b26fc77c5453592a",
            "a77fc54f6134f48b",
            "a77fc54f6134f48b",
            "abb065c9fd77a72c",
            "abb065c9fd77a72c",
            "908f01e8bfdc4b16",
            "908f01e8bfdc4b16",
            "e299e7b999554a5c",
            "4072f697fd4e81d6",
            "75aa269d2f11011f",
            "75aa269d2f11011f",
            "8592f637b29fbdcf"
          ],
          "title": "OnEncrypt"
        },
        {
          "id": "ondecrypt",
          "lines": [
            [
              {
                "annotation_ids": [
                  "0085abf1166e4d4d"
                ],
                "status_id": 3,
                "text": "OnDecrypt MUST fail if this keyring does not have a specified AWS KMS SDK client."
              }
            ],
            "",
            [
              {
                "annotation_ids": [
                  "5264e4d88a16268a",
                  "f1cd97862b79ea46"
                ],
                "status_id": 1,
                "text": "OnDecrypt MUST fail if the input [decryption materials](../structures.md#decryption-materials)"
              }
            ],
            [
              {
                "annotation_ids": [
                  "5264e4d88a16268a",
                  "f1cd97862b79ea46"
                ],
                "status_id": 1,
                "text": "contains an [algorithm suite](../algorithm-suites.md) containing an"
              }
            ],
            [
              {
                "annotation_ids": [
                  "5264e4d88a16268a",
                  "f1cd97862b79ea46"
                ],
                "status_id": 1,
                "text": "[asymmetric signature](../algorithm-suites.md#asymmetric-signature-algorithm)."
              }
            ],
            "See [Security Considerations](#security-considerations).",
            "",
            [
              {
                "annotation_ids": [
                  "11124fb148b5fc95"
                ],
                "status_id": 3,
                "text": "OnDecrypt MUST take [decryption materials](../structures.md#decryption-materials) and"
              }
            ],
            [
              {
                "annotation_ids": [
                  "11124fb148b5fc95"
                ],
                "status_id": 3,
                "text": "a list of [encrypted data keys](../structures.md#encrypted-data-key) as input."
              }
            ],
            "",
            [
              {
                "annotation_ids": [
                  "7766ff3e3d5857ce"
                ],
                "status_id": 3,
                "text": "If the [decryption materials](../structures.md#decryption-materials) already contained a valid plaintext data key"
              }
            ],
            [
              {
                "annotation_ids": [
                  "7766ff3e3d5857ce"
                ],
                "status_id": 3,
                "text": "OnDecrypt MUST return an error."
              }
            ],
            "",
            [
              {
                "annotation_ids": [
                  "ead1b0793afd6e4f"
                ],
                "status_id": 3,
                "text": "The set of encrypted data keys MUST first be filtered to match this keyring’s configuration."
              },
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": " For the encrypted data key to match:"
              }
            ],
            "",
            [
              {
                "annotation_ids": [
                  "04821a984b400a9a"
                ],
                "status_id": 3,
                "text": "- Its provider ID MUST exactly match the value “aws-kms-rsa”."
              }
            ],
            [
              {
                "annotation_ids": [
                  "a57f65e755267a2c"
                ],
                "status_id": 3,
                "text": "- The provider info MUST be a [valid AWS KMS ARN](aws-kms-key-arn.md#a-valid-aws-kms-arn)"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "  "
              },
              {
                "annotation_ids": [
                  "a57f65e755267a2c"
                ],
                "status_id": 3,
                "text": "with a resource type of `key` or OnDecrypt MUST fail."
              }
            ],
            [
              {
                "annotation_ids": [
                  "386cdf1161865992"
                ],
                "status_id": 3,
                "text": "- The function [AWS KMS MRK Match for Decrypt](aws-kms-mrk-match-for-decrypt.md#implementation)"
              }
            ],
            [
              {
                "annotation_ids": [],
                "status_id": 0,
                "text": "  "
              },
              {
                "annotation_ids": [
                  "386cdf1161865992"
                ],
                "status_id": 3,
                "text": "called with the configured AWS KMS key identifier and the provider info MUST return `true`."
              }
            ],
            "",
            [
              {
                "annotation_ids": [
                  "a78f1fe36a11b3b4"
                ],
                "status_id": 3,
                "text": "OnDecrypt MUST calculate a Encryption Context Digest Prime by:"
              }
            ],
            "",
            "1. Serializing The [encryption context](structures.md#encryption-context-2) from the input",
            "   [decryption materials](../structures.md#decryption-materials) according to the [encryption context serialization specification](../structures.md#serialization).",
            "2. Taking the SHA-384 Digest of this concatenation.",
            "",
            [
              {
                "annotation_ids": [
                  "1cade9542cf97bc2"
                ],
                "status_id": 3,
                "text": "For each encrypted data key in the filtered set,"
              }
            ],
            [
              {
                "annotation_ids": [
                  "1cade9542cf97bc2"
                ],
                "status_id": 3,
                "text": "one at a time,"
              }
            ],
            [
              {
                "annotation_ids": [
                  "1cade9542cf97bc2"
                ],
                "status_id": 3,
                "text": "the OnDecrypt MUST attempt to decrypt the data key."
              }
            ],
            [
              {
                "annotation_ids": [
                  "6835cefa51dde6db"
                ],
                "status_id": 3,
                "text": "If this attempt results in an error,"
              }
            ],
            [
              {
                "annotation_ids": [
                  "6835cefa51dde6db"
                ],
                "status_id": 3,
                "text": "then these errors MUST be collected."
              }
            ],
            "",
            [
              {
                "annotation_ids": [
                  "7b172215b2b06fd3"
                ],
                "status_id": 3,
                "text": "To attempt to decrypt a particular [encrypted data key](../structures.md#encrypted-data-key),"
              }
            ],
            [
              {
                "annotation_ids": [
                  "7b172215b2b06fd3"
                ],
                "status_id": 3,
                "text": "OnDecrypt MUST call [AWS KMS Decrypt](https://docs.aws.amazon.com/kms/latest/APIReference/API_Decrypt.html)"
              }
            ],
            [
              {
                "annotation_ids": [
                  "7b172215b2b06fd3"
                ],
                "status_id": 3,
                "text": "with the configured AWS KMS client."
              }
            ],
            "",
            [
              {
                "annotation_ids": [
                  "991260741a912d1a"
                ],
                "status_id": 3,
                "text": "When calling [AWS KMS Decrypt](https://docs.aws.amazon.com/kms/latest/APIReference/API_Decrypt.html),"
              }
            ],
            [
              {
                "annotation_ids": [
                  "991260741a912d1a"
                ],
                "status_id": 3,
                "text": "the keyring MUST call with a request constructed as follows:"
              }
            ],
            "",
            [
              {
                "annotation_ids": [
                  "80e949d1a1afbcc3"
                ],
                "status_id": 3,
                "text": "- `KeyId` MUST be the configured AWS KMS key identifier."
              }
            ],
            [
              {
                "annotation_ids": [
                  "8f2b9f769beb248a"
                ],
                "status_id": 3,
                "text": "- `CiphertextBlob` MUST be the [encrypted data key ciphertext](../structures.md#ciphertext)."
              }
            ],
            [
              {
                "annotation_ids": [
                  "c63c59d1768d5920"
                ],
                "status_id": 3,
                "text": "- `GrantTokens` MUST be this keyring's [grant tokens](https://docs.aws.amazon.com/kms/latest/developerguide/concepts.html#grant_token)."
              }
            ],
            [
              {
                "annotation_ids": [
                  "1ebeb56cdc6c0307"
                ],
                "status_id": 3,
                "text": "- `EncryptionAlgorithm` MUST be configured value."
              }
            ],
            "",
            "If the call to [AWS KMS Decrypt](https://docs.aws.amazon.com/kms/latest/APIReference/API_Decrypt.html) succeeds,",
            "OnDecrypt verifies:",
            "",
            [
              {
                "annotation_ids": [
                  "a9ed197101fde072"
                ],
                "status_id": 3,
                "text": "- The `KeyId` field in the response MUST equal the configured AWS KMS key identifier."
              }
            ],
            "",
            [
              {
                "annotation_ids": [
                  "d5de0b1ded1513e4"
                ],
                "status_id": 3,
                "text": "If any decryption succeeds,"
              }
            ],
            [
              {
                "annotation_ids": [
                  "d5de0b1ded1513e4"
                ],
                "status_id": 3,
                "text": "the result of this decryption MUST be split into"
              }
            ],
            [
              {
                "annotation_ids": [
                  "d5de0b1ded1513e4"
                ],
                "status_id": 3,
                "text": "the encryption context digest and plaintext data key by:"
              }
            ],
            "",
            "- the first 48 bytes is the encryption context digest",
            "- all bytes after that are the plain text data key.",
            "",
            [
              {
                "annotation_ids": [
                  "eae8fd7596a6f182"
                ],
                "status_id": 3,
                "text": "The keyring MUST compare the decrypted encryption context digest"
              }
            ],
            [
              {
                "annotation_ids": [
                  "eae8fd7596a6f182"
                ],
                "status_id": 3,
                "text": "to the encryption context digest prime;"
              }
            ],
            [
              {
                "annotation_ids": [
                  "eae8fd7596a6f182"
                ],
                "status_id": 3,
                "text": "if the two are not equal,"
              }
            ],
            [
              {
                "annotation_ids": [
                  "eae8fd7596a6f182"
                ],
                "status_id": 3,
                "text": "the keyring MUST fail and"
              }
            ],
            [
              {
                "annotation_ids": [
                  "eae8fd7596a6f182"
                ],
                "status_id": 3,
                "text": "MUST NOT modify the [decryption materials](structures.md#decryption-materials)."
              }
            ],
            "",
            [
              {
                "annotation_ids": [
                  "06e4e65b79c49ef3"
                ],
                "status_id": 3,
                "text": "Otherwise, this keyring MUST immediately return the input"
              }
            ],
            [
              {
                "annotation_ids": [
                  "06e4e65b79c49ef3"
                ],
                "status_id": 3,
                "text": "[decryption materials](structures.md#decryption-materials), modified in the following ways:"
              }
            ],
            "",
            "- The plaintext data key is set as the decryption material's plaintext data key.",
            "",
            [
              {
                "annotation_ids": [
                  "d83f4420b48a5201"
                ],
                "status_id": 3,
                "text": "If no decryption and keyring digest check succeeds,"
              }
            ],
            [
              {
                "annotation_ids": [
                  "d83f4420b48a5201"
                ],
                "status_id": 3,
                "text": "the keyring MUST fail"
              }
            ],
            [
              {
                "annotation_ids": [
                  "d83f4420b48a5201"
                ],
                "status_id": 3,
                "text": "and MUST NOT modify the [decryption materials](structures.md#decryption-materials)."
              }
            ]
          ],
          "requirements": [
            "0085abf1166e4d4d",
            "f1cd97862b79ea46",
            "f1cd97862b79ea46",
            "f1cd97862b79ea46",
            "11124fb148b5fc95",
            "11124fb148b5fc95",
