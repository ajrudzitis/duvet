      "type": "SPEC"
    },
    {
      "comment": "The Keystore MAY use the KMS Key ARNs already\npersisted to the backing DynamoDB table,\nprovided they are in records created\nwith an identical Logical Keystore Name.\n",
      "id": "d144e3c58e7af1d3",
      "level": "May",
