    },
    {
      "id": "df6a89cbcfd31b50",
      "level": "Auto",
      "line": 495,
      "quote": "For each encrypted data key in the filtered set, one at a time, the OnDecrypt MUST attempt to decrypt the data key. If this attempt results in an error, then these errors MUST be collected.",
      "source": "AwsCryptographicMaterialProviders/dafny/AwsCryptographicMaterialProviders/src/Keyrings/AwsKms/AwsKmsMrkKeyring.dfy",
