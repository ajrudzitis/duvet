      "target_path": "aws-encryption-sdk-specification/framework/algorithm-suites.md",
      "target_section": "overview",
      "type": "IMPLICATION"
    },
    {
      "id": "4d9fa4d98a7615b6",
      "level": "Auto",
      "line": 89,
      "quote": "The fields described below are REQUIRED to be specified by algorithm suites, unless otherwise specified.",
      "source": "AwsCryptographicMaterialProviders/dafny/AwsCryptographicMaterialProviders/Model/suites.smithy",
      "target_path": "aws-encryption-sdk-specification/framework/algorithm-suites.md",
