      "target_path": "aws-encryption-sdk-specification/framework/raw-aes-keyring.md",
      "target_section": "wrapping-key",
      "type": "SPEC"
    },
    {
      "comment": "The length of the wrapping key MUST be 128, 192, or 256.\n",
