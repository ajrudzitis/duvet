    },
    {
      "id": "a2d33c8e984b8501",
      "level": "Auto",
      "line": 481,
      "quote": "The set of encrypted data keys MUST first be filtered to match this keyring’s configuration.",
      "source": "AwsCryptographicMaterialProviders/dafny/AwsCryptographicMaterialProviders/src/Keyrings/AwsKms/AwsKmsMrkKeyring.dfy",
