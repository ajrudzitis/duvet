    },
    {
      "id": "839ed431f6d6d274",
      "level": "Auto",
      "line": 299,
      "quote": "The keyring MUST attempt to serialize the [encryption materials'](structures.md#encryption-materials) [encryption context](structures.md#encryption-context-1) according to the [encryption context serialization specification](structures.md#serialization).",
      "source": "AwsCryptographicMaterialProviders/dafny/AwsCryptographicMaterialProviders/test/Keyrings/TestRawAESKeyring.dfy",
      "target_path": "aws-encryption-sdk-specification/framework/raw-aes-keyring.md",
