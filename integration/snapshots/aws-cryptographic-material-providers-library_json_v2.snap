      "target_section": "initialization",
      "type": "SPEC"
    },
    {
      "comment": "For implementations that support [master key providers](master-key-provider-interface.md),\nthe default CMM MUST support generating, encrypting, and decrypting data keys\nusing master key providers.\n",
      "id": "5993ffc432712fb8",
      "level": "Must",
      "line": 9,
      "quote": "For implementations that support [master key providers](master-key-provider-interface.md), the default CMM MUST support generating, encrypting, and decrypting data keys using master key providers.",
      "source": "compliance/aws-encryption-sdk-specification/framework/default-cmm/legacy-behavior-master-key-providers.toml",
      "target_path": "aws-encryption-sdk-specification/framework/default-cmm.md",
      "target_section": "legacy-behavior-master-key-providers",
      "type": "SPEC"
    },
    {
      "comment": "Master key providers SHOULD NOT be included in any additional implementations.\n",
      "id": "3e7c602283f04016",
      "level": "Should",
      "line": 8,
      "quote": "Master key providers SHOULD NOT be included in any additional implementations.",
      "source": "compliance/aws-encryption-sdk-specification/framework/default-cmm/legacy.toml",
      "target_path": "aws-encryption-sdk-specification/framework/default-cmm.md",
      "target_section": "legacy",
      "type": "SPEC"
    },
    {
      "comment": "- MUST provide the recipient's public key\n",
      "id": "c9659e3994b25493",
      "level": "Must",
      "line": 31,
      "quote": "- MUST provide the recipient's public key",
      "source": "compliance/aws-encryption-sdk-specification/framework/key-agreement-schemas/ephemeralprivatekeytostaticpublickey.toml",
