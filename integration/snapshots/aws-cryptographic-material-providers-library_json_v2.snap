      "target_path": "aws-encryption-sdk-specification/framework/aws-kms/aws-kms-keyring.md",
      "target_section": "ondecrypt",
      "type": "SPEC"
    },
    {
      "comment": "The set of encrypted data keys MUST first be filtered to match this keyring’s configuration.\n",
      "id": "234f2b82e0c58830",
      "level": "Must",
      "line": 61,
      "quote": "The set of encrypted data keys MUST first be filtered to match this keyring’s configuration.",
