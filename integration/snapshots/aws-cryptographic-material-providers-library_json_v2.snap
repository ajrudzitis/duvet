    },
    {
      "id": "360b7dfbac18ef18",
      "level": "Auto",
      "line": 357,
      "quote": "The CMM MUST ensure that the decryption materials returned are valid. - The decryption materials returned MUST follow the specification for [decryption-materials](structures.md#decryption-materials). - The value of the plaintext data key MUST be non-NULL.",
      "source": "AwsCryptographicMaterialProviders/dafny/AwsCryptographicMaterialProviders/src/CMMs/DefaultCMM.dfy",
      "target_path": "aws-encryption-sdk-specification/framework/cmm-interface.md",
