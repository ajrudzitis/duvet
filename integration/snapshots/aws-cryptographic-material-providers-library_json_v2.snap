      "type": "IMPLICATION"
    },
    {
      "id": "e7f52322644c80ea",
      "level": "Auto",
      "line": 377,
      "quote": "- All key-value pairs that exist in [Reproduced Encryption Context](structures.md#encryption-context) but do not exist in encryption context on the [decrypt materials request](#decrypt-materials-request) SHOULD be appended to the decryption materials.",
      "source": "AwsCryptographicMaterialProviders/dafny/AwsCryptographicMaterialProviders/src/CMMs/DefaultCMM.dfy",
