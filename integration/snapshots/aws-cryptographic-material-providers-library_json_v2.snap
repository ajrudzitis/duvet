      "target_path": "aws-encryption-sdk-specification/framework/synchronized-local-cryptographic-materials-cache.md",
      "target_section": "initialization",
      "type": "SPEC"
    },
    {
      "comment": "If specified to use ECDSA, the AWS Encryption SDK MUST use ECDSA with the following specifics:\n",
      "id": "90d86ede7ef8a862",
      "level": "Must",
      "line": 30,
      "quote": "If specified to use ECDSA, the AWS Encryption SDK MUST use ECDSA with the following specifics:",
