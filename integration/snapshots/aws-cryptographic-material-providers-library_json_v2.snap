    {
      "id": "40e3b41a0d9c4966",
      "level": "Auto",
      "line": 198,
      "quote": "The wrapped plaintext data key MUST be the result of the following AES GCM 256 Encrypt operation:",
      "source": "AwsCryptographicMaterialProviders/dafny/AwsCryptographicMaterialProviders/src/KeyWrapping/IntermediateKeyWrapping.dfy",
      "target_path": "aws-encryption-sdk-specification/framework/algorithm-suites.md",
