      "source": "AwsCryptographicMaterialProviders/dafny/AwsCryptographicMaterialProviders/src/CMMs/DefaultCMM.dfy",
      "target_path": "aws-encryption-sdk-specification/framework/cmm-interface.md",
      "target_section": "decrypt-materials",
      "type": "EXCEPTION"
    },
    {
      "id": "e8e83ca8c4ace76a",
      "level": "Auto",
      "line": 324,
