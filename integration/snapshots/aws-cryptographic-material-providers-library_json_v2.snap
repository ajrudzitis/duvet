      "type": "SPEC"
    },
    {
      "comment": "If the AWS KMS Configuration is KMS Key ARN or KMS MRKey ARN,\nand no DynamoDb Client is provided,\na new DynamoDb Client MUST be created\nwith the region of the supplied KMS ARN.\n",
      "id": "fdd959bad4ccd7f3",
