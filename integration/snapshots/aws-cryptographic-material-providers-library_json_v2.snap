      "target_section": "onencrypt",
      "type": "SPEC"
    },
    {
      "comment": "If the keyring is unable to wrap a plaintext data key, OnEncrypt MUST fail\nand MUST NOT modify the [decryption materials](structures.md#decryption-materials).\n",
      "id": "115447b2957d2c44",
      "level": "Must",
