      "target_section": "ondecrypt",
      "type": "SPEC"
    },
    {
      "comment": "- `KeyId` MUST be the configured AWS KMS key identifier.\n",
      "id": "b1065f43933da635",
      "level": "Must",
      "line": 110,
      "quote": "- `KeyId` MUST be the configured AWS KMS key identifier.",
      "source": "compliance/aws-encryption-sdk-specification/framework/aws-kms/aws-kms-keyring/ondecrypt.toml",
      "target_path": "aws-encryption-sdk-specification/framework/aws-kms/aws-kms-keyring.md",
      "target_section": "ondecrypt",
      "type": "SPEC"
    },
    {
      "comment": "- `CiphertextBlob` MUST be the [encrypted data key ciphertext](../structures.md#ciphertext).\n",
      "id": "86591d546de8b593",
      "level": "Must",
      "line": 116,
      "quote": "- `CiphertextBlob` MUST be the [encrypted data key ciphertext](../structures.md#ciphertext).",
