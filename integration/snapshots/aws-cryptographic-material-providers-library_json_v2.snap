      "target_section": "ondecrypt",
      "type": "SPEC"
    },
    {
      "comment": "For each encrypted data key in the filtered set,\none at a time,\nthe OnDecrypt MUST attempt to decrypt the data key.\n",
      "id": "1cade9542cf97bc2",
      "level": "Must",
      "line": 137,
      "quote": "For each encrypted data key in the filtered set, one at a time, the OnDecrypt MUST attempt to decrypt the data key.",
