      "target_section": "ephemeralprivatekeytostaticpublickey",
      "type": "SPEC"
    },
    {
      "comment": "- Public key MUST be DER-encoded [X.509 SubjectPublicKeyInfo](https://datatracker.ietf.org/doc/html/rfc5280#section-4.1)\n",
      "id": "843815912e71d27d",
      "level": "Must",
      "line": 37,
      "quote": "- Public key MUST be DER-encoded [X.509 SubjectPublicKeyInfo](https://datatracker.ietf.org/doc/html/rfc5280#section-4.1)",
      "source": "compliance/aws-encryption-sdk-specification/framework/key-agreement-schemas/ephemeralprivatekeytostaticpublickey.toml",
