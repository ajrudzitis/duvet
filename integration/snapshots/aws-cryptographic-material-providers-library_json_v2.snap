    {
      "comment": "To avoid name collisions each added attribute from the custom [encryption context](./structures.md#encryption-context-3)\nMUST be prefixed with `aws-crypto-ec:`.\n",
      "id": "c8ecb3ef3863ae03",
      "level": "Must",
