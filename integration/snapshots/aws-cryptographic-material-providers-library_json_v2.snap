      "target_path": "aws-encryption-sdk-specification/framework/aws-kms/aws-kms-rsa-keyring.md",
      "target_section": "ondecrypt",
      "type": "SPEC"
    },
    {
      "comment": "If no decryption and keyring digest check succeeds,\nthe keyring MUST fail\nand MUST NOT modify the [decryption materials](structures.md#decryption-materials).\n",
      "id": "d83f4420b48a5201",
      "level": "Must",
