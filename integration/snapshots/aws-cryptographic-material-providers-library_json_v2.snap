      "target_section": "ondecrypt",
      "type": "SPEC"
    },
    {
      "comment": "- `EncryptionContext` MUST be the [encryption context](../structures.md#encryption-context) included in the input [decryption materials](../structures.md#decryption-materials).\n",
      "id": "54d5dd0f801d2030",
      "level": "Must",
      "line": 122,
      "quote": "- `EncryptionContext` MUST be the [encryption context](../structures.md#encryption-context) included in the input [decryption materials](../structures.md#decryption-materials).",
