      "target_path": "aws-encryption-sdk-specification/framework/aws-kms/aws-kms-keyring.md",
      "target_section": "ondecrypt",
      "type": "SPEC"
    },
    {
      "comment": "- The `KeyId` field in the response MUST equal the configured AWS KMS key identifier.\n",
      "id": "afe603996577becb",
      "level": "Must",
      "line": 134,
      "quote": "- The `KeyId` field in the response MUST equal the configured AWS KMS key identifier.",
