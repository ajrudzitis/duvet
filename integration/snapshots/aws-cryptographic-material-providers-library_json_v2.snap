      "target_section": "ondecrypt",
      "type": "SPEC"
    },
    {
      "comment": "- The [IV length](#iv-length) obtained from the encrypted data key's key provider information MUST have a value equal to the length specified by this keyring's [wrapping algorithm](#wrapping-algorithm).\n",
      "id": "7d7062488445ba12",
      "level": "Must",
      "line": 111,
      "quote": "- The [IV length](#iv-length) obtained from the encrypted data key's key provider information MUST have a value equal to the length specified by this keyring's [wrapping algorithm](#wrapping-algorithm).",
