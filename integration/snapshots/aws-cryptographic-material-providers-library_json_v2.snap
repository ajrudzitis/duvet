      "target_section": "ondecrypt",
      "type": "SPEC"
    },
    {
      "comment": "- `GrantTokens` MUST be this keyring's [grant tokens](https://docs.aws.amazon.com/kms/latest/developerguide/concepts.html#grant_token).\n",
      "id": "c63c59d1768d5920",
      "level": "Must",
      "line": 179,
      "quote": "- `GrantTokens` MUST be this keyring's [grant tokens](https://docs.aws.amazon.com/kms/latest/developerguide/concepts.html#grant_token).",
