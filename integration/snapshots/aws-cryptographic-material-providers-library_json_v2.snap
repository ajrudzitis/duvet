      "target_section": "wrapping-algorithm",
      "type": "SPEC"
    },
    {
      "comment": "Initialization MUST fail if the length of the [wrapping key](#wrapping-key) does not match the length specified by the wrapping algorithm.\n",
      "id": "98d022866ab6cd64",
      "level": "Must",
