      "target_section": "cache-limit-ttl",
      "type": "SPEC"
    },
    {
      "comment": "If the [algorithm suite](algorithm-suites.md) requested contains a [Identity KDF](algorithm-suites.md#identity-kdf),\nthe caching CMM MUST obtain the decryption materials by making a call to the underlying CMM's [Decrypt Materials](cmm-interface.md#decrypt-materials) function.\n",
      "id": "5faa77a5e6d62672",
      "level": "Must",
