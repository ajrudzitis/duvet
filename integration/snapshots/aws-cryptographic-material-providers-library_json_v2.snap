    {
      "comment": "The Material Providers Library also MUST provide\na union ENUM for all distinct commitment policy ENUMs\ncalled the Commitment Policy ENUM.\n",
      "id": "1df5c11eb51ac098",
      "level": "Must",
      "line": 22,
      "quote": "The Material Providers Library also MUST provide a union ENUM for all distinct commitment policy ENUMs called the Commitment Policy ENUM.",
      "source": "compliance/aws-encryption-sdk-specification/framework/commitment-policy/supported-commitment-policy-enum.toml",
      "target_path": "aws-encryption-sdk-specification/framework/commitment-policy.md",
      "target_section": "supported-commitment-policy-enum",
      "type": "SPEC"
    },
    {
      "comment": "This means that different formats MAY have duplicate Format Commitment Policy ENUM.\n",
      "id": "ab2d812def19ea77",
      "level": "May",
      "line": 30,
      "quote": "This means that different formats MAY have duplicate Format Commitment Policy ENUM.",
      "source": "compliance/aws-encryption-sdk-specification/framework/commitment-policy/supported-commitment-policy-enum.toml",
      "target_path": "aws-encryption-sdk-specification/framework/commitment-policy.md",
      "target_section": "supported-commitment-policy-enum",
      "type": "SPEC"
    },
    {
      "comment": "The Material Providers Library MUST provide\na distinct commitment policy ENUM for each format.\n",
      "id": "acda9537fe58cec4",
