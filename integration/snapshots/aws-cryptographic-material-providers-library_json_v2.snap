    {
      "comment": "MUST implement the [AWS Encryption SDK Keyring interface](../keyring-interface.md#interface)\n",
      "id": "8789fbc839feeaeb",
      "level": "Must",
      "line": 7,
      "quote": "MUST implement the [AWS Encryption SDK Keyring interface](../keyring-interface.md#interface)",
