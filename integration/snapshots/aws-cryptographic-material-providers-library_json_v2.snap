      "target_section": "ondecrypt",
      "type": "SPEC"
    },
    {
      "comment": "If the [decryption materials](../structures.md#decryption-materials) already contained a valid plaintext data key\nOnDecrypt MUST return an error.\n",
      "id": "4485b3945664d5a8",
      "level": "Must",
      "line": 54,
      "quote": "If the [decryption materials](../structures.md#decryption-materials) already contained a valid plaintext data key OnDecrypt MUST return an error.",
