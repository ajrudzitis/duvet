      "target_path": "aws-encryption-sdk-specification/framework/aws-kms/aws-kms-keyring.md",
      "target_section": "ondecrypt",
      "type": "SPEC"
    },
    {
      "comment": "- Its provider ID MUST exactly match the value “aws-kms”.\n",
      "id": "fd5ead4c702c742a",
      "level": "Must",
      "line": 67,
      "quote": "- Its provider ID MUST exactly match the value “aws-kms”.",
      "source": "compliance/aws-encryption-sdk-specification/framework/aws-kms/aws-kms-keyring/ondecrypt.toml",
      "target_path": "aws-encryption-sdk-specification/framework/aws-kms/aws-kms-keyring.md",
      "target_section": "ondecrypt",
      "type": "SPEC"
    },
    {
      "comment": "- The provider info MUST be a [valid AWS KMS ARN](aws-kms-key-arn.md#a-valid-aws-kms-arn) with a resource type of `key` or OnDecrypt MUST fail.\n",
      "id": "5d32f0e76c8f4837",
      "level": "Must",
      "line": 73,
      "quote": "- The provider info MUST be a [valid AWS KMS ARN](aws-kms-key-arn.md#a-valid-aws-kms-arn) with a resource type of `key` or OnDecrypt MUST fail.",
      "source": "compliance/aws-encryption-sdk-specification/framework/aws-kms/aws-kms-keyring/ondecrypt.toml",
      "target_path": "aws-encryption-sdk-specification/framework/aws-kms/aws-kms-keyring.md",
      "target_section": "ondecrypt",
      "type": "SPEC"
    },
    {
      "comment": "- The provider info MUST match the configured AWS KMS key identifier.\n",
      "id": "b14f3ea367a01c45",
      "level": "Must",
      "line": 79,
      "quote": "- The provider info MUST match the configured AWS KMS key identifier.",
