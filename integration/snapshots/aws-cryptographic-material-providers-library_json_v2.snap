      "type": "IMPLICATION"
    },
    {
      "id": "81261e4dee6e6695",
      "level": "Auto",
      "line": 463,
      "quote": "- The `KeyId` field in the response MUST equal the configured AWS KMS key identifier.",
      "source": "AwsCryptographicMaterialProviders/dafny/AwsCryptographicMaterialProviders/src/Keyrings/AwsKms/AwsKmsMrkKeyring.dfy",
