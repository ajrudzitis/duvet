    },
    {
      "id": "1c801319698b7692",
      "level": "Auto",
      "line": 143,
      "quote": "The keyring MUST encrypt the plaintext data key in the [encryption materials](structures.md#encryption-materials) using AES-GCM.",
      "source": "AwsCryptographicMaterialProviders/dafny/AwsCryptographicMaterialProviders/test/Keyrings/TestRawAESKeyring.dfy",
