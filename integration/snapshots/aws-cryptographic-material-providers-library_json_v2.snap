    },
    {
      "id": "b1ca7e5dfe3672a0",
      "level": "Auto",
      "line": 9,
      "quote": "This specification defines the common behavior between the two implementations that determine the REQUIRED functionality. Other specifics of behavior and API vary between the two implementations.",
      "source": "AwsCryptographicMaterialProviders/compliance_exceptions/master-key-interface.txt",
      "target_path": "aws-encryption-sdk-specification/framework/master-key-interface.md",
      "target_section": "consistency",
