      "target_section": "wrapping-algorithm",
      "type": "SPEC"
    },
    {
      "comment": "The wrapping key MUST be a secret value consisting of cryptographically secure pseudo-random bytes.\n",
      "id": "bc932032d368bef9",
      "level": "Must",
      "line": 11,
      "quote": "The wrapping key MUST be a secret value consisting of cryptographically secure pseudo-random bytes.",
      "source": "compliance/aws-encryption-sdk-specification/framework/raw-aes-keyring/wrapping-key.toml",
      "target_path": "aws-encryption-sdk-specification/framework/raw-aes-keyring.md",
      "target_section": "wrapping-key",
      "type": "SPEC"
    },
    {
