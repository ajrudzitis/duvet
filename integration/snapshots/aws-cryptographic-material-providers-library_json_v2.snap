    },
    {
      "id": "fe991ae9ca7afafe",
      "level": "Auto",
      "line": 156,
      "quote": "The keyring MUST check that the calculated Commitment Key from the key derivation step is equal to the deserialized commitment key found in the encrypted data key.",
      "source": "AwsCryptographicMaterialProviders/dafny/AwsCryptographicMaterialProviders/src/KeyWrapping/EcdhEdkWrapping.dfy",
      "target_path": "aws-encryption-sdk-specification/framework/raw-ecdh-keyring.md",
