    },
    {
      "id": "cbf3c84636edca01",
      "level": "Auto",
      "line": 423,
      "quote": "- The length of the response’s `Plaintext` MUST equal the [key derivation input length](../algorithm-suites.md#key-derivation- input-length) specified by the [algorithm suite](../algorithm- suites.md) included in the input [decryption materials] (../structures.md#decryption-materials).",
      "source": "AwsCryptographicMaterialProviders/dafny/AwsCryptographicMaterialProviders/src/Keyrings/AwsKms/AwsKmsMrkKeyring.dfy",
